@@ -0,0 +1,78 @@
+import { AccountErrorCode, type AccountErrorFragment } from "@dashboard/graphql";
+import Wrapper from "@test/wrapper";
+import { fireEvent, render, screen } from "@testing-library/react";
+import type * as React from "react";
+
+import CustomerInfo from "./CustomerInfo";
+
+const wrapper = ({ children }: { children: React.ReactNode }) => <Wrapper>{children}</Wrapper>;
+
+describe("CustomerInfo", () => {
+  const defaultProps = {
+    data: {
+      firstName: "Tom",
+      lastName: "Cooper",
+      email: "tom@example.com",
+      note: "",
+      birthday: "1990-05-17",
+    },
+    disabled: false,
+    errors: [] as AccountErrorFragment[],
+    onChange: jest.fn(),
+  };
+
+  it("renders the customer birthday as a date input", () => {
+    // Arrange & Act
+    render(<CustomerInfo {...defaultProps} showBirthday />, { wrapper });
+
+    // Assert
+    const input = screen.getByTestId("customer-birthday");
+
+    expect(input).toHaveAttribute("type", "date");
+    expect(input).toHaveValue("1990-05-17");
+  });
+
+  it("hides the birthday from viewers who can't access it", () => {
+    // Arrange & Act
+    render(<CustomerInfo {...defaultProps} />, { wrapper });
+
+    // Assert
+    expect(screen.queryByTestId("customer-birthday")).not.toBeInTheDocument();
+    expect(screen.queryByDisplayValue("1990-05-17")).not.toBeInTheDocument();
+  });
+
+  it("calls onChange when the birthday is edited", () => {
+    // Arrange
+    const onChange = jest.fn();
+
+    render(<CustomerInfo {...defaultProps} showBirthday onChange={onChange} />, { wrapper });
+
+    // Act
+    const input = screen.getByTestId("customer-birthday");
+
+    fireEvent.change(input, { target: { name: "birthday", value: "1985-01-02" } });
+
+    // Assert
+    expect(onChange).toHaveBeenCalled();
+  });
+
+  it("shows the birthday error returned by the API", () => {
+    // Arrange
+    const errors: AccountErrorFragment[] = [
+      {
+        __typename: "AccountError",
+        code: AccountErrorCode.INVALID,
+        field: "birthday",
+        message: null,
+        addressType: null,
+        attributes: null,
+      },
+    ];
+
+    // Act
+    render(<CustomerInfo {...defaultProps} showBirthday errors={errors} />, { wrapper });
+
+    // Assert
+    expect(screen.getByText(/invalid/i)).toBeInTheDocument();
+  });
+});
