+++ b/src/customers/utils/birthday.test.ts
@@ -0,0 +1,41 @@
+import { getCustomerBirthdayInput } from "./birthday";
+
+describe("getCustomerBirthdayInput", () => {
+  it("never sends the birthday when the viewer can't access it", () => {
+    // Arrange
+    const customer = { birthday: null, canAccessBirthday: false };
+
+    // Act & Assert
+    expect(getCustomerBirthdayInput(customer, "")).toEqual({});
+    expect(getCustomerBirthdayInput(customer, "1990-05-17")).toEqual({});
+  });
+
+  it("does not send an unchanged birthday", () => {
+    // Arrange
+    const customer = { birthday: "1990-05-17", canAccessBirthday: true };
+
+    // Act & Assert
+    expect(getCustomerBirthdayInput(customer, "1990-05-17")).toEqual({});
+    expect(getCustomerBirthdayInput({ birthday: null, canAccessBirthday: true }, "")).toEqual({});
+  });
+
+  it("sends a changed birthday", () => {
+    // Arrange
+    const customer = { birthday: "1990-05-17", canAccessBirthday: true };
+
+    // Act & Assert
+    expect(getCustomerBirthdayInput(customer, "1985-01-02")).toEqual({ birthday: "1985-01-02" });
+  });
+
+  it("sends null to remove the birthday", () => {
+    // Arrange
+    const customer = { birthday: "1990-05-17", canAccessBirthday: true };
+
+    // Act & Assert
+    expect(getCustomerBirthdayInput(customer, "")).toEqual({ birthday: null });
+  });
+
+  it("sends nothing without a customer", () => {
+    expect(getCustomerBirthdayInput(null, "1990-05-17")).toEqual({});
+  });
+});
diff --git a/src/customers/utils/birthday.ts b/src/customers/utils/birthday.ts
new file mode 100644
index 0000000..0054ff1
--- /dev/null
+++ b/src/customers/utils/birthday.ts
@@ -0,0 +1,25 @@
+interface BirthdayCustomer {
+  birthday?: string | null;
+  canAccessBirthday?: boolean;
+}
+
+/**
+ * The birthday is personal data: the API only returns it, and only accepts changes,
+ * for super-admins and the customer. Everybody else gets `null`, so sending the
+ * empty form value back would be rejected (or look like a request to remove it).
+ * Send the birthday only when the viewer can access it and the value changed.
+ */
+export function getCustomerBirthdayInput(
+  customer: BirthdayCustomer | null | undefined,
+  birthday: string,
+): { birthday: string | null } | Record<string, never> {
+  if (!customer?.canAccessBirthday) {
+    return {};
+  }
+
+  if (birthday === (customer.birthday ?? "")) {
+    return {};
+  }
+
+  return { birthday: birthday || null };
+}
