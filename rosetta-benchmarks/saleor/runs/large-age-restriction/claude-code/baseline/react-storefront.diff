+import { describe, expect, it } from "vitest";
+import { hasAgeRestriction } from "./age-restriction";
+
+describe("hasAgeRestriction", () => {
+	it("is true for a positive minimum age", () => {
+		expect(hasAgeRestriction(18)).toBe(true);
+		expect(hasAgeRestriction(1)).toBe(true);
+	});
+
+	it("is false when there is no restriction", () => {
+		expect(hasAgeRestriction(null)).toBe(false);
+		expect(hasAgeRestriction(undefined)).toBe(false);
+		expect(hasAgeRestriction(0)).toBe(false);
+	});
+});
