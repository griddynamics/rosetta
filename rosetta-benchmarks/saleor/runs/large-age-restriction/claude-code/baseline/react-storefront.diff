+import { describe, expect, it } from "vitest";
+import { getAddToCartError } from "./cart-add-line-result";
+
+describe("getAddToCartError", () => {
+	it("returns null when there are no errors", () => {
+		expect(getAddToCartError([])).toBeNull();
+		expect(getAddToCartError(undefined)).toBeNull();
+		expect(getAddToCartError(null)).toBeNull();
+	});
+
+	it("returns ageRestricted for the AGE_RESTRICTED code", () => {
+		expect(getAddToCartError([{ code: "AGE_RESTRICTED", message: "Too young" }])).toBe("ageRestricted");
+	});
+
+	it("returns ageRestricted when it is one of several errors", () => {
+		expect(getAddToCartError([{ code: "INVALID" }, { code: "AGE_RESTRICTED" }])).toBe("ageRestricted");
+	});
+
+	it("returns failed for any other error", () => {
+		expect(getAddToCartError([{ code: "INSUFFICIENT_STOCK", message: "No stock" }])).toBe("failed");
+	});
+});
diff --git a/src/lib/cart-add-line-result.ts b/src/lib/cart-add-line-result.ts
new file mode 100644
index 0000000..a494e48
--- /dev/null
+++ b/src/lib/cart-add-line-result.ts
@@ -0,0 +1,16 @@
+export type AddToCartState = { error: "ageRestricted" | "failed" | null };
+
+export const ADD_TO_CART_INITIAL_STATE: AddToCartState = { error: null };
+
+type AddLineError = { code?: string | null; message?: string | null };
+
+/** Maps `checkoutLinesAdd` errors to the reason shown to the shopper. */
+export function getAddToCartError(
+	errors: readonly AddLineError[] | null | undefined,
+): AddToCartState["error"] {
+	if (!errors?.length) {
+		return null;
+	}
+
+	return errors.some((error) => error.code === "AGE_RESTRICTED") ? "ageRestricted" : "failed";
+}
