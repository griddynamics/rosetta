+/** Birthday is optional: an empty form value clears it on the API side. */
+export function parseBirthdayInput(value: string): string | null {
+	const trimmed = value.trim();
+	return trimmed === "" ? null : trimmed;
+}
+
+/** `<input type="date">` max value, so shoppers can't pick a future date. */
+export function getTodayDateInputValue(now: Date = new Date()): string {
+	return now.toISOString().slice(0, 10);
+}
