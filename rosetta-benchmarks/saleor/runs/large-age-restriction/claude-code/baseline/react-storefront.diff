+"use client";
+
+import { useActionState } from "react";
+import { useTranslations } from "next-intl";
+import { ADD_TO_CART_INITIAL_STATE, type AddToCartState } from "@/lib/cart-add-line-result";
+
+interface AddToCartFormProps {
+	action: (previousState: AddToCartState, formData: FormData) => Promise<AddToCartState>;
+	className?: string;
+	children: React.ReactNode;
+}
+
+/** Wraps the add-to-cart server action so the shopper sees why a product couldn't be added. */
+export function AddToCartForm({ action, className, children }: AddToCartFormProps) {
+	const t = useTranslations("pdp");
+	const [state, formAction] = useActionState(action, ADD_TO_CART_INITIAL_STATE);
+
+	return (
+		<form action={formAction} className={className}>
+			{children}
+			{state.error ? (
+				<p role="alert" className="text-sm text-destructive">
+					{state.error === "ageRestricted" ? t("ageRestricted") : t("addToBagFailed")}
+				</p>
+			) : null}
+		</form>
+	);
+}
