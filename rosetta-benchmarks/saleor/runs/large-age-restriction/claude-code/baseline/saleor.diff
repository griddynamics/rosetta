diff --git a/saleor/graphql/product/tests/mutations/test_product_minimum_age.py b/saleor/graphql/product/tests/mutations/test_product_minimum_age.py
new file mode 100644
index 0000000..a5d064a
--- /dev/null
+++ b/saleor/graphql/product/tests/mutations/test_product_minimum_age.py
@@ -0,0 +1,273 @@
+import graphene
+import pytest
+
+from .....product.error_codes import ProductErrorCode
+from .....product.models import Product
+from ....tests.utils import get_graphql_content
+
+PRODUCT_CREATE_MUTATION = """
+mutation createProduct($input: ProductCreateInput!) {
+  productCreate(input: $input) {
+    product {
+      id
+      minimumAge
+    }
+    errors {
+      field
+      code
+    }
+  }
+}
+"""
+
+PRODUCT_UPDATE_MUTATION = """
+mutation updateProduct($id: ID!, $input: ProductInput!) {
+  productUpdate(id: $id, input: $input) {
+    product {
+      id
+      minimumAge
+    }
+    errors {
+      field
+      code
+    }
+  }
+}
+"""
+
+PRODUCT_BULK_CREATE_MUTATION = """
+mutation productBulkCreate($products: [ProductBulkCreateInput!]!) {
+  productBulkCreate(products: $products) {
+    count
+    results {
+      product {
+        minimumAge
+      }
+      errors {
+        path
+        code
+      }
+    }
+  }
+}
+"""
+
+
+def _create_input(product_type, category, **kwargs):
+    return {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "category": graphene.Node.to_global_id("Category", category.pk),
+            "name": "Age restricted product",
+            "slug": "age-restricted-product",
+            **kwargs,
+        }
+    }
+
+
+def test_product_create_with_minimum_age(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    variables = _create_input(product_type, category, minimumAge=18)
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_CREATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["minimumAge"] == 18
+    assert Product.objects.get(slug="age-restricted-product").minimum_age == 18
+
+
+def test_product_create_without_minimum_age(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    variables = _create_input(product_type, category)
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_CREATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["minimumAge"] is None
+
+
+def test_product_create_with_negative_minimum_age(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    variables = _create_input(product_type, category, minimumAge=-1)
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_CREATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert data["product"] is None
+    assert data["errors"] == [
+        {"field": "minimumAge", "code": ProductErrorCode.INVALID.name}
+    ]
+    assert not Product.objects.filter(slug="age-restricted-product").exists()
+
+
+def test_product_update_sets_minimum_age(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    assert product.minimum_age is None
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"minimumAge": 21},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_UPDATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert not data["errors"]
+    assert data["product"]["minimumAge"] == 21
+    product.refresh_from_db()
+    assert product.minimum_age == 21
+
+
+def test_product_update_removes_minimum_age(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    product.minimum_age = 18
+    product.save(update_fields=["minimum_age"])
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"minimumAge": None},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_UPDATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert not data["errors"]
+    assert data["product"]["minimumAge"] is None
+    product.refresh_from_db()
+    assert product.minimum_age is None
+
+
+def test_product_update_without_minimum_age_keeps_value(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    product.minimum_age = 18
+    product.save(update_fields=["minimum_age"])
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"name": "New name"},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_UPDATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert not data["errors"]
+    assert data["product"]["minimumAge"] == 18
+
+
+def test_product_update_with_negative_minimum_age(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"minimumAge": -5},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_UPDATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert data["errors"] == [
+        {"field": "minimumAge", "code": ProductErrorCode.INVALID.name}
+    ]
+    product.refresh_from_db()
+    assert product.minimum_age is None
+
+
+def test_product_update_minimum_age_requires_permission(staff_api_client, product):
+    # given
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"minimumAge": 18},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(PRODUCT_UPDATE_MUTATION, variables)
+
+    # then
+    assert response.status_code == 200
+    assert get_graphql_content(response, ignore_errors=True)["errors"]
+    product.refresh_from_db()
+    assert product.minimum_age is None
+
+
+@pytest.mark.parametrize(("minimum_age", "valid"), [(18, True), (-1, False)])
+def test_product_bulk_create_minimum_age(
+    minimum_age,
+    valid,
+    staff_api_client,
+    product_type,
+    category,
+    permission_manage_products,
+):
+    # given
+    variables = {
+        "products": [
+            {
+                "name": "Bulk age restricted",
+                "slug": "bulk-age-restricted",
+                "productType": graphene.Node.to_global_id(
+                    "ProductType", product_type.pk
+                ),
+                "category": graphene.Node.to_global_id("Category", category.pk),
+                "minimumAge": minimum_age,
+            }
+        ]
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_BULK_CREATE_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productBulkCreate"]
+    result = data["results"][0]
+    if valid:
+        assert not result["errors"]
+        assert result["product"]["minimumAge"] == minimum_age
+        assert Product.objects.get(slug="bulk-age-restricted").minimum_age == 18
+    else:
+        assert data["count"] == 0
+        assert result["errors"] == [{"path": "minimumAge", "code": "INVALID"}]
+        assert not Product.objects.filter(slug="bulk-age-restricted").exists()
