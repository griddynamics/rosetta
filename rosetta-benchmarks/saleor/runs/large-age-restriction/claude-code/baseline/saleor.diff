diff --git a/saleor/checkout/age_restriction.py b/saleor/checkout/age_restriction.py
new file mode 100644
index 0000000..a0cd7e4
--- /dev/null
+++ b/saleor/checkout/age_restriction.py
@@ -0,0 +1,61 @@
+from collections.abc import Iterable
+from typing import TYPE_CHECKING, Optional
+
+import graphene
+from django.core.exceptions import ValidationError
+
+from ..core.utils.age import is_old_enough
+
+if TYPE_CHECKING:
+    from ..account.models import User
+    from ..product.models import ProductVariant
+    from .fetch import CheckoutLineInfo
+
+
+def get_age_restricted_variants(
+    variants: Iterable["ProductVariant"], user: Optional["User"]
+) -> list["ProductVariant"]:
+    """Return the variants the user is not old enough to buy.
+
+    Anonymous users and users without a birthday can't be verified, so they are
+    not allowed to buy age-restricted variants.
+    """
+    birthday = user.birthday if user else None
+    return [
+        variant
+        for variant in variants
+        if not is_old_enough(birthday, variant.product.minimum_age)
+    ]
+
+
+def get_age_restricted_lines(
+    lines: Iterable["CheckoutLineInfo"], user: Optional["User"]
+) -> list["CheckoutLineInfo"]:
+    birthday = user.birthday if user else None
+    return [
+        line for line in lines if not is_old_enough(birthday, line.product.minimum_age)
+    ]
+
+
+def validate_lines_age_restriction(
+    lines: Iterable["CheckoutLineInfo"], user: Optional["User"], error_code: str
+):
+    """Raise a validation error when the user can't buy some of the lines."""
+    if restricted_lines := get_age_restricted_lines(lines, user):
+        raise ValidationError(
+            {
+                "lines": ValidationError(
+                    "Customer doesn't meet the minimum age required to buy "
+                    "some of the products.",
+                    code=error_code,
+                    params={
+                        "variants": {
+                            graphene.Node.to_global_id(
+                                "ProductVariant", line.variant.pk
+                            )
+                            for line in restricted_lines
+                        }
+                    },
+                )
+            }
+        )
