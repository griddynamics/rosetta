@@ -0,0 +1,64 @@
+"""Audit trail for customer birthdays.
+
+The birthday is personal data: every change and every read by someone other than
+the customer is recorded. The value itself is never written to the log.
+"""
+
+from typing import TYPE_CHECKING
+
+from . import BirthdayAuditActions
+from .models import BirthdayAuditLog
+
+if TYPE_CHECKING:
+    from ..app.models import App
+    from .models import User
+
+
+def _log(
+    action: str,
+    subject: "User",
+    actor_user: "User | None",
+    actor_app: "App | None",
+    parameters: dict | None = None,
+) -> BirthdayAuditLog:
+    from ..core.db.connection import allow_writer
+
+    # Reads (GraphQL queries) may run on a replica, the audit write must not.
+    with allow_writer():
+        return BirthdayAuditLog.objects.create(
+            action=action,
+            subject=subject,
+            subject_uuid=subject.uuid,
+            actor_user=actor_user,
+            actor_user_uuid=actor_user.uuid if actor_user else None,
+            actor_app=actor_app,
+            parameters=parameters or {},
+        )
+
+
+def log_birthday_changed(
+    subject: "User", *, actor_user: "User | None", actor_app: "App | None" = None
+) -> BirthdayAuditLog:
+    return _log(BirthdayAuditActions.CHANGED, subject, actor_user, actor_app)
+
+
+def log_birthday_viewed(
+    subject: "User", *, actor_user: "User | None", actor_app: "App | None" = None
+) -> BirthdayAuditLog:
+    return _log(BirthdayAuditActions.VIEWED, subject, actor_user, actor_app)
+
+
+def log_age_eligibility_checked(
+    subject: "User",
+    *,
+    minimum_age: int,
+    actor_user: "User | None",
+    actor_app: "App | None" = None,
+) -> BirthdayAuditLog:
+    return _log(
+        BirthdayAuditActions.ELIGIBILITY_CHECKED,
+        subject,
+        actor_user,
+        actor_app,
+        {"minimum_age": minimum_age},
+    )
