@@ -0,0 +1,574 @@
+"""Birthday is personal data: who can read it, who can change it, what is logged."""
+
+import datetime
+
+import graphene
+import pytest
+
+from ....account import BirthdayAuditActions
+from ....account.models import BirthdayAuditLog
+from ....webhook.payloads import generate_customer_payload
+from ...tests.utils import assert_no_permission, get_graphql_content
+
+BIRTHDAY = datetime.date(1990, 5, 17)
+
+USER_BIRTHDAY_QUERY = """
+query user($id: ID!) {
+  user(id: $id) {
+    birthday
+  }
+}
+"""
+
+TWO_READS_QUERY = """
+query user($id: ID!) {
+  first: user(id: $id) {
+    birthday
+  }
+  second: user(id: $id) {
+    birthday
+  }
+}
+"""
+
+ME_QUERY = """
+query {
+  me {
+    birthday
+  }
+}
+"""
+
+AGE_ELIGIBLE_QUERY = """
+query user($id: ID!, $minimumAge: Int!) {
+  user(id: $id) {
+    ageEligible(minimumAge: $minimumAge)
+  }
+}
+"""
+
+CUSTOMER_UPDATE_MUTATION = """
+mutation updateCustomer($id: ID!, $input: CustomerInput!) {
+  customerUpdate(id: $id, input: $input) {
+    errors {
+      field
+      code
+    }
+    user {
+      birthday
+    }
+  }
+}
+"""
+
+CUSTOMER_CREATE_MUTATION = """
+mutation createCustomer($input: UserCreateInput!) {
+  customerCreate(input: $input) {
+    errors {
+      field
+      code
+    }
+  }
+}
+"""
+
+ACCOUNT_UPDATE_MUTATION = """
+mutation accountUpdate($input: AccountInput!, $customerId: ID) {
+  accountUpdate(input: $input, customerId: $customerId) {
+    errors {
+      field
+      code
+    }
+    user {
+      birthday
+    }
+  }
+}
+"""
+
+
+@pytest.fixture
+def customer_with_birthday(customer_user):
+    customer_user.birthday = BIRTHDAY
+    customer_user.save(update_fields=["birthday"])
+    return customer_user
+
+
+def _user_id(user):
+    return graphene.Node.to_global_id("User", user.pk)
+
+
+def _logs(action=None):
+    logs = BirthdayAuditLog.objects.all()
+    return logs.filter(action=action) if action else logs
+
+
+# Reading the birthday
+
+
+def test_customer_reads_own_birthday_without_an_audit_entry(
+    user_api_client, customer_with_birthday
+):
+    # when
+    response = user_api_client.post_graphql(ME_QUERY)
+
+    # then
+    data = get_graphql_content(response)["data"]["me"]
+    assert data["birthday"] == BIRTHDAY.isoformat()
+    assert not _logs().exists()
+
+
+def test_super_admin_reads_birthday_and_the_read_is_logged(
+    superuser_api_client, superuser, customer_with_birthday
+):
+    # when
+    response = superuser_api_client.post_graphql(
+        USER_BIRTHDAY_QUERY, {"id": _user_id(customer_with_birthday)}
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["user"]
+    assert data["birthday"] == BIRTHDAY.isoformat()
+    log = _logs(BirthdayAuditActions.VIEWED).get()
+    assert log.subject == customer_with_birthday
+    assert log.subject_uuid == customer_with_birthday.uuid
+    assert log.actor_user == superuser
+    assert log.actor_user_uuid == superuser.uuid
+    assert log.actor_app is None
+    # the log never contains the birthday itself
+    assert BIRTHDAY.isoformat() not in str(log.parameters)
+
+
+def test_repeated_reads_in_one_request_are_logged_once(
+    superuser_api_client, customer_with_birthday
