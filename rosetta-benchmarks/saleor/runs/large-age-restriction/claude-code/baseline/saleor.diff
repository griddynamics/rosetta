+++ b/saleor/core/utils/tests/test_age.py
@@ -0,0 +1,88 @@
+from datetime import date
+
+import pytest
+from django.test import override_settings
+from freezegun import freeze_time
+
+from ..age import calculate_age, is_old_enough
+
+
+@pytest.mark.parametrize(
+    ("birthday", "today", "expected"),
+    [
+        (date(2000, 6, 15), date(2018, 6, 15), 18),
+        (date(2000, 6, 15), date(2018, 6, 14), 17),
+        (date(2000, 6, 15), date(2018, 6, 16), 18),
+        (date(2000, 12, 31), date(2018, 1, 1), 17),
+        (date(2004, 2, 29), date(2022, 2, 28), 17),
+        (date(2004, 2, 29), date(2022, 3, 1), 18),
+        (date(2020, 1, 1), date(2020, 1, 1), 0),
+    ],
+)
+def test_calculate_age(birthday, today, expected):
+    assert calculate_age(birthday, today) == expected
+
+
+@freeze_time("2024-05-10")
+@pytest.mark.parametrize(
+    ("birthday", "minimum_age", "expected"),
+    [
+        (date(2006, 5, 10), 18, True),
+        (date(2006, 5, 11), 18, False),
+        (date(1990, 1, 1), 21, True),
+        (date(2010, 1, 1), 0, True),
+        (date(2010, 1, 1), None, True),
+        (None, None, True),
+        (None, 18, False),
+        (None, 0, False),
+    ],
+)
+def test_is_old_enough(birthday, minimum_age, expected):
+    assert is_old_enough(birthday, minimum_age) is expected
+
+
+@pytest.mark.parametrize(
+    ("time_zone", "expected"),
+    [
+        # 2024-05-09 23:30 UTC is already 10 May in Auckland (UTC+12).
+        ("Pacific/Auckland", True),
+        ("UTC", False),
+        # and still 9 May in Los Angeles (UTC-7).
+        ("America/Los_Angeles", False),
+    ],
+)
+@freeze_time("2024-05-09 23:30:00")
+def test_is_old_enough_uses_the_shop_time_zone_date(time_zone, expected):
+    # given a customer turning 18 on 10 May 2024
+    birthday = date(2006, 5, 10)
+
+    # when
+    with override_settings(TIME_ZONE=time_zone):
+        result = is_old_enough(birthday, 18)
+
+    # then
+    assert result is expected
+
+
+@freeze_time("2024-05-10 00:00:01")
+def test_is_old_enough_ignores_the_time_of_day():
+    # the customer turns 18 today, even right after midnight
+    assert is_old_enough(date(2006, 5, 10), 18) is True
+
+
+@pytest.mark.parametrize(
+    ("today", "expected"),
+    [
+        (date(2024, 2, 28), False),
+        (date(2024, 2, 29), True),  # leap year: the real birthday
+        (date(2025, 2, 28), False),
+        (date(2025, 3, 1), True),  # non-leap year: eligible on 1 March
+    ],
+)
+def test_is_old_enough_born_on_29_february(today, expected):
+    # given someone born on 29 February 2004 who must be 20 (2024) / 21 (2025)
+    birthday = date(2004, 2, 29)
+    minimum_age = 20 if today.year == 2024 else 21
+
+    # then
+    assert (calculate_age(birthday, today) >= minimum_age) is expected
