diff --git a/saleor/core/utils/age.py b/saleor/core/utils/age.py
new file mode 100644
index 0000000..bd30679
--- /dev/null
+++ b/saleor/core/utils/age.py
@@ -0,0 +1,28 @@
+from datetime import date
+
+from django.utils import timezone
+
+
+def calculate_age(birthday: date, today: date | None = None) -> int:
+    """Return the full years that passed between the birthday and today.
+
+    Only dates are compared, never times. "Today" is the current date in the
+    shop's time zone (`settings.TIME_ZONE`). A person born on 29 February
+    reaches the next age on 1 March in non-leap years.
+    """
+    today = today or timezone.localdate()
+    had_birthday_this_year = (today.month, today.day) >= (birthday.month, birthday.day)
+    return today.year - birthday.year - (0 if had_birthday_this_year else 1)
+
+
+def is_old_enough(birthday: date | None, minimum_age: int | None) -> bool:
+    """Check if a person with the given birthday meets the minimum age.
+
+    No minimum age means no restriction. When a minimum age is required but
+    the birthday is unknown, the age can't be verified, so the check fails.
+    """
+    if minimum_age is None:
+        return True
+    if birthday is None:
+        return False
+    return calculate_age(birthday) >= minimum_age
