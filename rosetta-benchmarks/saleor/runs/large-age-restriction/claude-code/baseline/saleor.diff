+from datetime import timedelta
+
+from django.utils import timezone
+
+from ......account import BirthdayAuditActions
+from ......account.error_codes import AccountErrorCode
+from ......account.models import BirthdayAuditLog, User
+from .....tests.utils import get_graphql_content
+
+ACCOUNT_UPDATE_BIRTHDAY_MUTATION = """
+mutation accountUpdate($input: AccountInput!) {
+  accountUpdate(input: $input) {
+    errors {
+      field
+      code
+    }
+    user {
+      birthday
+    }
+  }
+}
+"""
+
+ACCOUNT_REGISTER_BIRTHDAY_MUTATION = """
+mutation registerAccount($input: AccountRegisterInput!) {
+  accountRegister(input: $input) {
+    errors {
+      field
+      code
+    }
+    user {
+      birthday
+    }
+  }
+}
+"""
+
+ME_BIRTHDAY_QUERY = """
+query {
+  me {
+    birthday
+  }
+}
+"""
+
+
+def test_account_update_sets_birthday(user_api_client):
+    # given
+    user = user_api_client.user
+    assert user.birthday is None
+    variables = {"input": {"birthday": "1990-05-17"}}
+
+    # when
+    response = user_api_client.post_graphql(ACCOUNT_UPDATE_BIRTHDAY_MUTATION, variables)
+
+    # then
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+    assert not data["errors"]
+    assert data["user"]["birthday"] == "1990-05-17"
+    user.refresh_from_db()
+    assert user.birthday.isoformat() == "1990-05-17"
+
+
+def test_account_update_birthday_in_the_future(user_api_client):
+    # given
+    user = user_api_client.user
+    tomorrow = timezone.localdate() + timedelta(days=1)
+    variables = {"input": {"birthday": tomorrow.isoformat()}}
+
+    # when
+    response = user_api_client.post_graphql(ACCOUNT_UPDATE_BIRTHDAY_MUTATION, variables)
+
+    # then
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+    assert data["errors"] == [
+        {"field": "birthday", "code": AccountErrorCode.INVALID.name}
+    ]
+    user.refresh_from_db()
+    assert user.birthday is None
+
+
+def test_account_update_birthday_today_is_allowed(user_api_client):
+    # given
+    today = timezone.localdate()
+    variables = {"input": {"birthday": today.isoformat()}}
+
+    # when
+    response = user_api_client.post_graphql(ACCOUNT_UPDATE_BIRTHDAY_MUTATION, variables)
+
+    # then
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+    assert not data["errors"]
+
+
+def test_account_update_other_field_keeps_birthday(user_api_client):
+    # given
+    user = user_api_client.user
+    user.birthday = timezone.localdate() - timedelta(days=365 * 30)
+    user.save(update_fields=["birthday"])
+    expected = user.birthday
+    variables = {"input": {"firstName": "Changed"}}
+
+    # when
+    response = user_api_client.post_graphql(ACCOUNT_UPDATE_BIRTHDAY_MUTATION, variables)
+
+    # then
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+    assert not data["errors"]
+    assert data["user"]["birthday"] == expected.isoformat()
+
+
+def test_me_returns_birthday(user_api_client):
+    # given
+    user = user_api_client.user
+    user.birthday = timezone.localdate() - timedelta(days=365 * 30)
+    user.save(update_fields=["birthday"])
+
+    # when
+    response = user_api_client.post_graphql(ME_BIRTHDAY_QUERY)
+
+    # then
+    data = get_graphql_content(response)["data"]["me"]
+    assert data["birthday"] == user.birthday.isoformat()
+
+
+def test_account_register_with_birthday(api_client, channel_PLN, site_settings):
+    # given
+    site_settings.enable_account_confirmation_by_email = False
+    site_settings.save(update_fields=["enable_account_confirmation_by_email"])
+    email = "birthday@example.com"
+    variables = {
+        "input": {
+            "email": email,
+            "password": "Password",
+            "birthday": "1985-01-02",
+            "channel": channel_PLN.slug,
+        }
+    }
+
+    # when
+    response = api_client.post_graphql(ACCOUNT_REGISTER_BIRTHDAY_MUTATION, variables)
+
+    # then
+    data = get_graphql_content(response)["data"]["accountRegister"]
+    assert not data["errors"]
+    # the unauthenticated response never returns the birthday
+    assert data["user"]["birthday"] is None
+    user = User.objects.get(email=email)
+    assert user.birthday.isoformat() == "1985-01-02"
+    log = BirthdayAuditLog.objects.get()
+    assert log.action == BirthdayAuditActions.CHANGED
+    assert log.subject == user
+    assert log.actor_user == user
+
+
+def test_account_register_birthday_in_the_future(
+    api_client, channel_PLN, site_settings
+):
+    # given
+    site_settings.enable_account_confirmation_by_email = False
+    site_settings.save(update_fields=["enable_account_confirmation_by_email"])
+    tomorrow = timezone.localdate() + timedelta(days=1)
+    variables = {
+        "input": {
+            "email": "future@example.com",
+            "password": "Password",
+            "birthday": tomorrow.isoformat(),
+            "channel": channel_PLN.slug,
+        }
+    }
+
+    # when
+    response = api_client.post_graphql(ACCOUNT_REGISTER_BIRTHDAY_MUTATION, variables)
+
+    # then
+    data = get_graphql_content(response)["data"]["accountRegister"]
+    assert data["errors"] == [
+        {"field": "birthday", "code": AccountErrorCode.INVALID.name}
+    ]
+    assert not User.objects.filter(email="future@example.com").exists()
