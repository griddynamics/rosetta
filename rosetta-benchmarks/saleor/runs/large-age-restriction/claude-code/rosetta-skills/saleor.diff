+def test_create_order_from_checkout_defaults_to_generic_reason(
+    checkout_with_prices, customer_user
+):
+    """`first_party` is fail-closed: omitting it never discloses age facts."""
+    checkout = checkout_with_prices
+    _restrict_all(checkout)
+    _buyer(checkout, customer_user, MINOR)
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+
+    with pytest.raises(ValidationError) as error:
+        create_order_from_checkout(
+            checkout_info=checkout_info, manager=manager, user=customer_user, app=None
+        )
+
+    err = error.value.error_dict["lines"][0]
+    assert err.code == CheckoutErrorCode.AGE_RESTRICTED_NOT_ELIGIBLE.value
+    assert not any(fact in err.message for fact in AGE_FACTS)
+
