+def cascade_except_retained_events(collector, field, sub_objs, using):
+    """Delete user's events, except the age audit events that must be retained.
+
+    Retained events (`CustomerEvents.RETAINED_TYPES`) are detached from the deleted
+    user (`user` set to NULL); they keep only pseudonymous ids in `parameters`.
+    All other event types are cascaded as usual.
+    """
