+    # the celery task logger does not propagate to the root logger
+    task_logger = logging.getLogger("saleor.checkout.tasks")
+    task_logger.addHandler(caplog.handler)
+    caplog.set_level(logging.DEBUG, logger=task_logger.name)
+
+    try:
+        with django_capture_on_commit_callbacks(execute=True):
+            automatic_checkout_completion_task(checkout.pk)
+    finally:
+        task_logger.removeHandler(caplog.handler)
+
+    failed = [r for r in caplog.records if "completion failed" in r.getMessage()]
+    assert failed
+    logged = " ".join(f"{r.getMessage()} {getattr(r, 'error', '')}" for r in failed)
+    assert "not eligible" in logged
+    assert not any(fact in caplog.text for fact in AGE_FACTS)
+
+
+def _prime_site_and_raise_minimum_age(new_minimum_age):
+    """Cache the Site (with its settings), then change `minimum_age` in the DB."""
+    site = Site.objects.get_current()
+    stale = site.settings
+    SiteSettings.objects.filter(pk=stale.pk).update(minimum_age=new_minimum_age)
+    assert site.settings.minimum_age != new_minimum_age
+    assert Site.objects.get_current().settings.minimum_age != new_minimum_age
+    return stale
+
+
+@pytest.mark.parametrize("pass_stale_settings", [False, True])
+@pytest.mark.parametrize("flow", ["transaction", "payment"])
+def test_completion_uses_fresh_minimum_age_not_cached_site(
+    flow,
+    pass_stale_settings,
+    request,
+    payment_dummy,
+    transaction_item_generator,
+    customer_user,
+    site_settings,
+):
+    checkout = request.getfixturevalue(
+        "checkout_ready_to_complete" if flow == "payment" else "checkout_with_prices"
+    )
+    SiteSettings.objects.filter(pk=site_settings.pk).update(minimum_age=18)
+    _restrict_all(checkout)
+    _buyer(checkout, customer_user, AGE_19)
+    if flow == "payment":
+        checkout.gift_cards.clear()
+        checkout.payments.add(payment_dummy)
+    else:
+        transaction_item_generator(
+            checkout_id=checkout.pk, charged_value=checkout.total.gross.amount
+        )
+    Site.objects.clear_cache()
+    stale = _prime_site_and_raise_minimum_age(21)
+    assert stale.minimum_age == 18
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+
+    with pytest.raises(ValidationError) as error:
+        complete_checkout(
+            manager=manager,
+            checkout_info=checkout_info,
+            lines=lines,
+            payment_data={},
+            store_source=False,
+            user=customer_user,
+            app=None,
