+"""Age restriction inside `complete_checkout`: in-lock re-check, retry, settings."""
+
+import logging
+from contextlib import contextmanager
+from datetime import date
+from unittest.mock import patch
+
+import graphene
+import pytest
+from django.contrib.sites.models import Site
+from django.core.exceptions import ValidationError
+
+from ...account.age import today_in_shop_tz
+from ...order.models import Order
+from ...plugins.manager import get_plugins_manager
+from ...site.models import SiteSettings
+from ..complete_checkout import (
+    _validate_checkout_age_restriction as real_validate_age_restriction,
+)
+from ..complete_checkout import complete_checkout
+from ..error_codes import CheckoutErrorCode
+from ..fetch import fetch_checkout_info, fetch_checkout_lines
+from ..fetch import fetch_checkout_lines as real_fetch_checkout_lines
+from ..models import Checkout
+from ..tasks import automatic_checkout_completion_task, task_logger
+
+FETCH_LINES = "saleor.checkout.complete_checkout.fetch_checkout_lines"
+VALIDATE = "saleor.checkout.complete_checkout._validate_checkout_age_restriction"
+PAYMENT_ENTRY_POINTS = [
+    "saleor.checkout.complete_checkout._process_payment",
+    "saleor.payment.gateway.process_payment",
+    "saleor.payment.gateway.confirm",
+]
+
+
+def _birthday_for_age(site_settings, years):
+    today = today_in_shop_tz(site_settings.time_zone)
+    return date(today.year - years, today.month, 1)
+
+
+def _set_birthday(user, birthday):
+    user.birthday = birthday
+    user.save(update_fields=["birthday"])
+
+
+def _restrict(checkout, value=True):
+    for line in checkout.lines.all():
+        product = line.variant.product
+        product.is_age_restricted = value
+        product.save(update_fields=["is_age_restricted"])
+
+
+@pytest.fixture
+def payment_checkout(checkout_ready_to_complete, payment_dummy, customer_user):
+    """Checkout in the payment flow, owned by the customer, with restricted lines."""
+    checkout = checkout_ready_to_complete
+    checkout.gift_cards.clear()
+    checkout.payments.add(payment_dummy)
+    checkout.user = customer_user
+    checkout.save(update_fields=["user"])
+    _restrict(checkout)
+    return checkout
+
+
+def _complete(checkout, user=None):
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+    return complete_checkout(
+        manager=manager,
+        checkout_info=checkout_info,
+        lines=lines,
+        payment_data={},
+        store_source=False,
+        user=user,
+        app=None,
+    )
+
+
+@contextmanager
+def _changing_between_checks(action):
+    """Run `action` after the outer age check, before the checkout is locked."""
+    state = {"armed": False, "done": False}
+
+    def validate(*args, **kwargs):
+        state["armed"] = True
+        return real_validate_age_restriction(*args, **kwargs)
+
+    def fetch_lines(*args, **kwargs):
+        if state["armed"] and not state["done"]:
+            state["done"] = True
+            action()
+        return real_fetch_checkout_lines(*args, **kwargs)
+
+    with (
+        patch(VALIDATE, side_effect=validate),
+        patch(FETCH_LINES, side_effect=fetch_lines),
+    ):
+        yield state
+    assert state["done"]
+
+
+def _error_code(exc_info):
+    return (
+        exc_info.value.message_dict["lines"]
+        and exc_info.value.error_dict["lines"][0].code
+    )
+
+
+def test_blocked_completion_does_not_lock_checkout_and_retry_succeeds(
+    payment_checkout, customer_user, site_settings
+):
+    # given
+    _set_birthday(customer_user, None)
+
+    # when
+    with pytest.raises(ValidationError) as exc:
+        _complete(payment_checkout)
+
+    # then
+    assert _error_code(exc) == CheckoutErrorCode.AGE_RESTRICTION_BIRTHDAY_REQUIRED.value
+    payment_checkout.refresh_from_db()
+    assert payment_checkout.completing_started_at is None
+    assert not Order.objects.filter(checkout_token=payment_checkout.pk).exists()
+
+    # when: the customer fixes the birthday and retries immediately
+    _set_birthday(customer_user, _birthday_for_age(site_settings, 30))
+    order, _, _ = _complete(payment_checkout)
+
+    # then
+    assert order
+    assert Order.objects.filter(checkout_token=payment_checkout.pk).count() == 1
+
+
+def test_in_lock_recheck_failure_does_not_lock_checkout(
+    payment_checkout, customer_user, site_settings
+):
+    # given
+    _set_birthday(customer_user, _birthday_for_age(site_settings, 30))
+
+    # when: the birthday disappears after the outer check, before the lock step
+    with _changing_between_checks(lambda: _set_birthday(customer_user, None)):
+        with pytest.raises(ValidationError) as exc:
+            _complete(payment_checkout)
+
+    # then
+    assert _error_code(exc) == CheckoutErrorCode.AGE_RESTRICTION_BIRTHDAY_REQUIRED.value
+    payment_checkout.refresh_from_db()
+    assert payment_checkout.completing_started_at is None
+
+    # when
+    _set_birthday(customer_user, _birthday_for_age(site_settings, 30))
+    order, _, _ = _complete(payment_checkout)
+
+    # then
+    assert order
+
+
+@pytest.mark.parametrize("race", ["birthday_removed", "line_became_restricted"])
+def test_in_lock_race_is_blocked(race, payment_checkout, customer_user, site_settings):
+    # given
+    if race == "birthday_removed":
+        _set_birthday(customer_user, _birthday_for_age(site_settings, 30))
+        action = lambda: _set_birthday(customer_user, None)  # noqa: E731
+        code = CheckoutErrorCode.AGE_RESTRICTION_BIRTHDAY_REQUIRED
+    else:
+        _set_birthday(customer_user, None)
+        _restrict(payment_checkout, False)
+        action = lambda: _restrict(payment_checkout, True)  # noqa: E731
+        code = CheckoutErrorCode.AGE_RESTRICTION_BIRTHDAY_REQUIRED
+    patches = [patch(t) for t in PAYMENT_ENTRY_POINTS]
+    mocks = [p.start() for p in patches]
+
+    # when
+    try:
+        with _changing_between_checks(action):
+            with pytest.raises(ValidationError) as exc:
+                _complete(payment_checkout)
+    finally:
+        for p in patches:
+            p.stop()
+
+    # then
+    assert _error_code(exc) == code.value
+    assert not Order.objects.filter(checkout_token=payment_checkout.pk).exists()
+    assert Checkout.objects.filter(pk=payment_checkout.pk).exists()
+    for mock in mocks:
+        mock.assert_not_called()
+
+
+def test_in_lock_recheck_reads_fresh_settings_without_site_settings(
+    payment_checkout, customer_user, site_settings
+):
+    """The cached Site settings must not be used by the in-lock re-check."""
+    # given
+    _set_birthday(customer_user, _birthday_for_age(site_settings, 20))
+    Site.objects.clear_cache()
+    assert Site.objects.get_current().settings.minimum_age == site_settings.minimum_age
+
+    def raise_minimum_age():
+        SiteSettings.objects.filter(pk=site_settings.pk).update(minimum_age=25)
+
+    # when
+    with _changing_between_checks(raise_minimum_age):
+        with pytest.raises(ValidationError) as exc:
+            _complete(payment_checkout)
+
+    # then
+    assert _error_code(exc) == CheckoutErrorCode.AGE_RESTRICTION_UNDERAGE.value
+    assert not Order.objects.filter(checkout_token=payment_checkout.pk).exists()
+
+
+def test_in_lock_recheck_uses_caller_site_settings(
+    payment_checkout, customer_user, site_settings
+):
+    # given
+    _set_birthday(customer_user, _birthday_for_age(site_settings, 20))
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(payment_checkout)
+    checkout_info = fetch_checkout_info(payment_checkout, lines, manager)
+
+    # when
+    with patch(VALIDATE, wraps=real_validate_age_restriction) as validate:
+        # the lines were already fetched, nothing else to arm
+        complete_checkout(
+            manager=manager,
+            checkout_info=checkout_info,
+            lines=lines,
+            payment_data={},
+            store_source=False,
+            user=None,
+            app=None,
+            site_settings=site_settings,
+        )
+
+    # then
+    assert [call.args[2] for call in validate.call_args_list] == [
+        site_settings,
+        site_settings,
+    ]
+
+
+# ------------------------------------------------- automatic completion task
+
+
+def test_automatic_completion_blocked_for_ineligible_customer(
+    payment_checkout, customer_user, caplog, monkeypatch
+):
+    # given
+    _set_birthday(customer_user, None)
+    monkeypatch.setattr(task_logger.parent, "propagate", True)
+    checkout_pk = payment_checkout.pk
+    payments_mock = patch("saleor.checkout.complete_checkout._process_payment")
+
+    # when
+    with payments_mock as process_payment, caplog.at_level(logging.WARNING):
+        automatic_checkout_completion_task(checkout_pk)
+
+    # then
+    checkout_id = graphene.Node.to_global_id("Checkout", checkout_pk)
+    assert Checkout.objects.filter(pk=checkout_pk).exists()
+    assert not Order.objects.filter(checkout_token=payment_checkout.pk).exists()
+    process_payment.assert_not_called()
+    # The same record can be captured more than once, depending on how logging
+    # handlers are attached in the runtime, so the count is not asserted.
+    failed = [r for r in caplog.records if r.levelno == logging.WARNING]
+    assert {r.message for r in failed} == {
+        f"Automatic checkout completion failed for checkout: {checkout_id}."
+    }
+    assert all("age-restricted" in r.error for r in failed)
+    payment_checkout.refresh_from_db()
+    assert payment_checkout.completing_started_at is None
+
+
+def test_automatic_completion_completes_for_eligible_customer(
+    payment_checkout, customer_user, site_settings, django_capture_on_commit_callbacks
+):
+    # given
+    _set_birthday(customer_user, _birthday_for_age(site_settings, 30))
+    checkout_pk = payment_checkout.pk
+
+    # when
+    with django_capture_on_commit_callbacks(execute=True):
+        automatic_checkout_completion_task(checkout_pk)
+
+    # then
+    assert not Checkout.objects.filter(pk=checkout_pk).exists()
+    assert Order.objects.filter(checkout_token=checkout_pk).exists()
