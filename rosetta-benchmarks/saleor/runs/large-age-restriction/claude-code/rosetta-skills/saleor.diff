index 0000000..d27cfe9
--- /dev/null
+++ b/saleor/checkout/age_restriction.py
@@ -0,0 +1,68 @@
+from collections.abc import Iterable
+from datetime import date
+
+from ..account.age import is_age_eligible, today_in_shop_tz
+from ..account.models import User
+from ..product.models import Product
+from ..site.models import SiteSettings
+from .error_codes import CheckoutErrorCode
+from .fetch import CheckoutLineInfo
+
+ERROR_MESSAGES = {
+    CheckoutErrorCode.AGE_RESTRICTION_LOGIN_REQUIRED: (
+        "Sign in to buy age-restricted products."
+    ),
+    CheckoutErrorCode.AGE_RESTRICTION_BIRTHDAY_REQUIRED: (
+        "Add your birthday to your account to buy age-restricted products."
+    ),
+    CheckoutErrorCode.AGE_RESTRICTION_UNDERAGE: "You are too young to buy this product.",
+}
+
+
+class AgeRestrictionError(Exception):
+    """Raised when the checkout owner cannot buy age-restricted products.
+
+    The message never contains personal data.
+    """
+
+    def __init__(self, code: CheckoutErrorCode):
+        self.code = code
+        self.message = ERROR_MESSAGES[code]
+        super().__init__(self.message)
+
+
+def validate_age_restriction(
+    lines: Iterable[CheckoutLineInfo],
+    user: User | None,
+    site_settings: SiteSettings,
+    *,
+    today: date | None = None,
+) -> None:
+    """Ensure `user` may buy the age-restricted products among `lines`.
+
+    `user` must be the user assigned to the checkout, not a user matched by email.
+    `today` overrides the current shop-time-zone date (for tests).
+    """
+    validate_age_restriction_for_products(
+        (line_info.product for line_info in lines), user, site_settings, today=today
+    )
+
+
+def validate_age_restriction_for_products(
+    products: Iterable[Product],
+    user: User | None,
+    site_settings: SiteSettings,
+    *,
+    today: date | None = None,
+) -> None:
+    """Apply the `validate_age_restriction` rules to already resolved products."""
+    if not any(product.is_age_restricted for product in products):
+        return
+    if user is None:
+        raise AgeRestrictionError(CheckoutErrorCode.AGE_RESTRICTION_LOGIN_REQUIRED)
+    if user.birthday is None:
+        raise AgeRestrictionError(CheckoutErrorCode.AGE_RESTRICTION_BIRTHDAY_REQUIRED)
+    if today is None:
+        today = today_in_shop_tz(site_settings.time_zone)
+    if not is_age_eligible(user.birthday, site_settings.minimum_age, today):
+        raise AgeRestrictionError(CheckoutErrorCode.AGE_RESTRICTION_UNDERAGE)
