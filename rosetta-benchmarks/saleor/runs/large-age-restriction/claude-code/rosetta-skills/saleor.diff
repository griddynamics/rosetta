index 0000000..3e644a8
--- /dev/null
+++ b/saleor/account/tests/test_age.py
@@ -0,0 +1,97 @@
+from datetime import UTC, date, datetime
+from zoneinfo import ZoneInfoNotFoundError
+
+import pytest
+
+from ..age import (
+    is_age_eligible,
+    minimum_age_date,
+    today_in_shop_tz,
+    validate_birthday,
+)
+
+
+@pytest.mark.parametrize(
+    ("birthday", "minimum_age", "today", "expected"),
+    [
+        (date(2008, 6, 15), 18, date(2026, 6, 15), True),
+        (date(2008, 6, 15), 18, date(2026, 6, 14), False),
+        (date(2008, 6, 15), 18, date(2026, 6, 16), True),
+        (date(2008, 2, 29), 18, date(2026, 2, 28), False),
+        (date(2008, 2, 29), 18, date(2026, 3, 1), True),
+        (date(2004, 2, 29), 4, date(2008, 2, 29), True),
+        (date(2004, 2, 29), 4, date(2008, 2, 28), False),
+        (None, 18, date(2026, 6, 15), False),
+    ],
+)
+def test_is_age_eligible(birthday, minimum_age, today, expected):
+    assert is_age_eligible(birthday, minimum_age, today) is expected
+
+
+def test_minimum_age_date_leap_birthday_non_leap_year():
+    assert minimum_age_date(date(2008, 2, 29), 18) == date(2026, 3, 1)
+
+
+def test_minimum_age_date_leap_birthday_leap_year():
+    assert minimum_age_date(date(2004, 2, 29), 4) == date(2008, 2, 29)
+
+
+def test_today_in_shop_tz_boundary_ahead_of_utc():
+    now = datetime(2026, 6, 14, 23, 30, tzinfo=UTC)
+
+    assert today_in_shop_tz("Pacific/Kiritimati", now) == date(2026, 6, 15)
+    assert today_in_shop_tz("UTC", now) == date(2026, 6, 14)
+
+
+def test_today_in_shop_tz_boundary_behind_utc():
+    now = datetime(2026, 6, 15, 3, 0, tzinfo=UTC)
+
+    assert today_in_shop_tz("America/Los_Angeles", now) == date(2026, 6, 14)
+
+
+def test_today_in_shop_tz_eligibility_depends_on_zone():
+    birthday = date(2008, 6, 15)
+    now = datetime(2026, 6, 14, 23, 30, tzinfo=UTC)
+
+    assert is_age_eligible(birthday, 18, today_in_shop_tz("Pacific/Kiritimati", now))
+    assert not is_age_eligible(birthday, 18, today_in_shop_tz("UTC", now))
+
+
+def test_today_in_shop_tz_naive_now_is_utc():
+    naive_now = datetime(2026, 6, 14, 23, 30)  # noqa: DTZ001
+
+    assert today_in_shop_tz("UTC", naive_now) == date(2026, 6, 14)
+
+
+def test_today_in_shop_tz_default_now():
+    assert isinstance(today_in_shop_tz("UTC"), date)
+
+
+def test_today_in_shop_tz_unknown_zone():
+    with pytest.raises(ZoneInfoNotFoundError):
+        today_in_shop_tz("Mars/Phobos")
+
+
+def test_validate_birthday_future():
+    with pytest.raises(ValueError, match="future"):
+        validate_birthday(date(2026, 6, 16), date(2026, 6, 15))
+
+
+def test_validate_birthday_today_ok():
+    validate_birthday(date(2026, 6, 15), date(2026, 6, 15))
+
+
+def test_validate_birthday_too_old():
+    with pytest.raises(ValueError, match="past"):
+        validate_birthday(date(1899, 12, 31), date(2026, 6, 15))
+
+
+def test_validate_birthday_lower_bound_ok():
+    validate_birthday(date(1900, 1, 1), date(2026, 6, 15))
+
+
+def test_validate_birthday_error_message_has_no_date():
+    with pytest.raises(ValueError) as exc:  # noqa: PT011
+        validate_birthday(date(1899, 12, 31), date(2026, 6, 15))
+
+    assert "1899" not in str(exc.value)
