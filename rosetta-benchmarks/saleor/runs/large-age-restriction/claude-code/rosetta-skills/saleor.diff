+import datetime
+from unittest.mock import patch
+
+import graphene
+import pytest
+from freezegun import freeze_time
+
+from ......account import CustomerEvents
+from ......account.error_codes import AccountErrorCode
+from ......account.models import CustomerEvent
+from .....tests.utils import assert_no_permission, get_graphql_content
+
+NOW = "2026-10-22T12:00:00Z"
+
+ACCOUNT_UPDATE_BIRTHDAY = """
+    mutation accountUpdate($input: AccountInput!, $customerId: ID) {
+        accountUpdate(input: $input, customerId: $customerId) {
+            errors { field code message }
+            user { birthday }
+        }
+    }
+"""
+
+
+def _birthday_events():
+    return CustomerEvent.objects.filter(type=CustomerEvents.BIRTHDAY_UPDATED)
+
+
+@freeze_time(NOW)
+def test_account_update_sets_changes_and_clears_birthday(
+    user_api_client, customer_user
+):
+    def update(value):
+        response = user_api_client.post_graphql(
+            ACCOUNT_UPDATE_BIRTHDAY, {"input": {"birthday": value}}
+        )
+        return get_graphql_content(response)["data"]["accountUpdate"]
+
+    data = update("2008-10-22")
+    assert data["errors"] == []
+    assert data["user"]["birthday"] == "2008-10-22"
+    customer_user.refresh_from_db()
+    assert customer_user.birthday == datetime.date(2008, 10, 22)
+    assert _birthday_events().count() == 1
+
+    # unchanged value writes no event
+    update("2008-10-22")
+    assert _birthday_events().count() == 1
+
+    assert update("1990-01-02")["user"]["birthday"] == "1990-01-02"
+    assert _birthday_events().count() == 2
+
+    data = update(None)
+    assert data["user"]["birthday"] is None
+    customer_user.refresh_from_db()
+    assert customer_user.birthday is None
+
+    events = list(_birthday_events().order_by("pk"))
+    assert len(events) == 3
+    assert [e.parameters["cleared"] for e in events] == [False, False, True]
+    for event in events:
+        assert event.user_id == customer_user.pk
+        assert set(event.parameters) == {"account_id", "actor_id", "cleared"}
+        assert event.parameters["account_id"] == customer_user.pk
+        assert event.parameters["actor_id"] == customer_user.pk
+        assert "birthday" not in event.parameters
+
+
+@freeze_time(NOW)
+def test_account_update_omitted_birthday_keeps_value(user_api_client, customer_user):
+    customer_user.birthday = datetime.date(2000, 1, 1)
+    customer_user.save(update_fields=["birthday"])
+
+    response = user_api_client.post_graphql(
+        ACCOUNT_UPDATE_BIRTHDAY, {"input": {"firstName": "Changed"}}
+    )
+
+    assert get_graphql_content(response)["data"]["accountUpdate"]["errors"] == []
+    customer_user.refresh_from_db()
+    assert customer_user.birthday == datetime.date(2000, 1, 1)
+    assert not _birthday_events().exists()
+
+
+@freeze_time(NOW)
+def test_account_update_rejects_invalid_birthday(user_api_client, customer_user):
+    for value in ("2026-10-23", "1906-10-21"):
+        response = user_api_client.post_graphql(
+            ACCOUNT_UPDATE_BIRTHDAY, {"input": {"birthday": value}}
+        )
+        errors = get_graphql_content(response)["data"]["accountUpdate"]["errors"]
+        assert errors[0]["field"] == "birthday"
+        assert errors[0]["code"] == AccountErrorCode.INVALID.name
+        assert value[:4] not in errors[0]["message"]
+    customer_user.refresh_from_db()
+    assert customer_user.birthday is None
+    assert not _birthday_events().exists()
