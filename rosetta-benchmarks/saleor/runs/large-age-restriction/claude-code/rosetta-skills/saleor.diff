+def customer_age_eligibility_viewed_event(
+    *, actor: User, subject_id: int
+) -> CustomerEvent:
+    return CustomerEvent.objects.create(
+        user=actor,
+        type=CustomerEvents.AGE_ELIGIBILITY_VIEWED,
+        parameters={"account_id": subject_id, "actor_id": actor.pk},
+    )
