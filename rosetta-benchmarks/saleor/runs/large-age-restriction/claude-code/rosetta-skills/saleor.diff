+
+def test_sentry_pii_denylist_contains_birthday():
+    source = (
+        pathlib.Path(settings.PROJECT_ROOT) / "saleor" / "settings.py"
+    ).read_text()
+    start = source.index("SALEOR_PII_DENYLIST = DEFAULT_PII_DENYLIST + [")
+    block = source[start : source.index("]", start)]
+    assert '"birthday"' in block
