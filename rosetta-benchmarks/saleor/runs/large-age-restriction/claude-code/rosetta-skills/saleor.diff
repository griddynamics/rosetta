+def test_create_order_from_checkout_age_rejection_keeps_voucher_usage(
+    checkout_with_voucher, voucher, customer_user
+):
+    voucher.usage_limit = 10
+    voucher.save(update_fields=["usage_limit"])
+    checkout = checkout_with_voucher
+    _restrict_all(checkout)
+    _buyer(checkout, customer_user, MINOR)
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+    assert checkout_info.voucher is not None
+    used_before = list(voucher.codes.values_list("used", flat=True))
+
+    with pytest.raises(ValidationError) as error:
+        create_order_from_checkout(
+            checkout_info=checkout_info,
+            manager=manager,
+            user=customer_user,
+            app=None,
+            first_party=True,
+        )
+
+    err = error.value.error_dict["lines"][0]
+    assert err.code == CheckoutErrorCode.AGE_RESTRICTED_UNDERAGE.value
+    assert list(voucher.codes.values_list("used", flat=True)) == used_before
+    checkout.refresh_from_db()
+    assert checkout.is_voucher_usage_increased is False
+
