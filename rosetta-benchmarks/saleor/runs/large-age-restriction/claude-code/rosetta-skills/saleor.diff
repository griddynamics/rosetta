+def _create_customers(count, offset=0):
+    users = User.objects.bulk_create(
+        [
+            User(
+                email=f"age-bench-{offset + i}@example.com",
+                is_active=True,
+                birthday=BIRTHDAY,
+            )
+            for i in range(count)
+        ]
+    )
