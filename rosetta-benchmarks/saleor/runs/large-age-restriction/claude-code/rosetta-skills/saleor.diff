+    staff_api_client.user.user_permissions.add(permission_manage_users)
+    _create_customers(2)
+    _, small_queries = _count_site_settings_queries(staff_api_client)
+
+    _create_customers(8, offset=2)
+
+    # when
+    content, large_queries = _count_site_settings_queries(staff_api_client)
+
+    # then
+    nodes = [e["node"] for e in content["data"]["customers"]["edges"]]
+    assert len(nodes) >= 10
+    assert all(node["isAgeEligible"] is True for node in nodes)
+    # site settings are loaded once per request, regardless of list size
+    assert len(large_queries) == len(small_queries) == 1
+    # ACCEPTED RISK: a non-owner list read costs one audit INSERT per customer
+    # (and kind); this write amplification is intentional and documented, as the
+    # audit trail must be complete (fail closed). It is linear in the page size.
+    assert (
+        CustomerEvent.objects.filter(type=CustomerEvents.AGE_ELIGIBILITY_VIEWED).count()
+        >= 10
+    )
+
