+
+CREATE_MUTATION = """
+    mutation ($input: ProductCreateInput!) {
+        productCreate(input: $input) {
+            errors { field code message }
+            product { id isAgeRestricted ageLabel }
+        }
+    }
+"""
+
+UPDATE_MUTATION = """
+    mutation ($id: ID!, $input: ProductInput!) {
+        productUpdate(id: $id, input: $input) {
+            errors { field code message }
+            product { isAgeRestricted ageLabel }
+        }
+    }
+"""
+
+BULK_MUTATION = """
+    mutation ($products: [ProductBulkCreateInput!]!) {
+        productBulkCreate(products: $products) {
+            results {
+                errors { path code message }
+                product { id isAgeRestricted }
+            }
+        }
+    }
+"""
+
+
+def _create_input(product_type, category, **extra):
+    return {
+        "name": "Age product",
+        "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+        "category": graphene.Node.to_global_id("Category", category.pk),
+        **extra,
+    }
+
+
+def test_product_create_age_restricted_flag(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # restricted
+    variables = {"input": _create_input(product_type, category, isAgeRestricted=True)}
+    response = staff_api_client.post_graphql(
+        CREATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert data["errors"] == []
+    assert data["product"]["isAgeRestricted"] is True
+    assert data["product"]["ageLabel"] == "18+"
+    assert Product.objects.get(name="Age product").is_age_restricted is True
+
+
+def test_product_create_age_restricted_defaults_to_false(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    variables = {"input": _create_input(product_type, category)}
+    response = staff_api_client.post_graphql(
+        CREATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert data["errors"] == []
+    assert data["product"]["isAgeRestricted"] is False
+    assert data["product"]["ageLabel"] is None
+
+
+def test_product_update_sets_and_clears_flag(
+    staff_api_client, product, permission_manage_products
+):
+    assert product.is_age_restricted is False
+    product_id = graphene.Node.to_global_id("Product", product.pk)
+
+    response = staff_api_client.post_graphql(
+        UPDATE_MUTATION,
+        {"id": product_id, "input": {"isAgeRestricted": True}},
+        permissions=[permission_manage_products],
+    )
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert data["errors"] == []
+    assert data["product"]["isAgeRestricted"] is True
+    product.refresh_from_db()
+    assert product.is_age_restricted is True
+
+    # omitted: unchanged
+    staff_api_client.post_graphql(
+        UPDATE_MUTATION, {"id": product_id, "input": {"name": "Renamed"}}
+    )
+    product.refresh_from_db()
+    assert product.is_age_restricted is True
+
+    response = staff_api_client.post_graphql(
+        UPDATE_MUTATION, {"id": product_id, "input": {"isAgeRestricted": False}}
+    )
+    assert get_graphql_content(response)["data"]["productUpdate"]["errors"] == []
+    product.refresh_from_db()
+    assert product.is_age_restricted is False
+
+
+def test_product_update_flag_requires_manage_products(user_api_client, product):
+    product_id = graphene.Node.to_global_id("Product", product.pk)
+    response = user_api_client.post_graphql(
+        UPDATE_MUTATION, {"id": product_id, "input": {"isAgeRestricted": True}}
+    )
+    assert response.json()["errors"][0]["extensions"]["exception"]["code"] == (
+        "PermissionDenied"
+    )
+    product.refresh_from_db()
+    assert product.is_age_restricted is False
+
+
+def test_product_bulk_create_age_restricted_flag(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    products = [
+        {
+            **_create_input(product_type, category, isAgeRestricted=True),
+            "name": "bulk restricted",
+            "slug": "bulk-restricted",
+        },
+        {
+            **_create_input(product_type, category),
+            "name": "bulk plain",
+            "slug": "bulk-plain",
+        },
+    ]
+    response = staff_api_client.post_graphql(
+        BULK_MUTATION, {"products": products}, permissions=[permission_manage_products]
+    )
+    results = get_graphql_content(response)["data"]["productBulkCreate"]["results"]
+    assert [r["errors"] for r in results] == [[], []]
+    assert [r["product"]["isAgeRestricted"] for r in results] == [True, False]
+    assert Product.objects.get(slug="bulk-restricted").is_age_restricted is True
+    assert Product.objects.get(slug="bulk-plain").is_age_restricted is False
