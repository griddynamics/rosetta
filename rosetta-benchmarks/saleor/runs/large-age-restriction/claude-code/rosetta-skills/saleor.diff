+@freeze_time(NOW)
+@pytest.mark.parametrize(
+    ("birthday", "code"),
+    [
+        (None, "AGE_RESTRICTED_BIRTHDAY_REQUIRED"),
+        (B_TMRW, "AGE_RESTRICTED_UNDERAGE"),
+        (B_EXACT, None),
+        (datetime.date(2008, 10, 21), None),
+    ],
+)
+def test_lines_add_for_logged_in_customer(
+    birthday, code, user_api_client, customer_user, checkout, restricted_variant
+):
+    _set_birthday(customer_user, birthday)
+    checkout.user = customer_user
+    checkout.save(update_fields=["user"])
+
+    errors = _add(user_api_client, checkout, restricted_variant)
+
+    if code is None:
+        assert errors == []
+        assert checkout.lines.filter(variant=restricted_variant).exists()
+    else:
+        assert [e["code"] for e in errors] == [code]
+        assert errors[0]["field"] == "lines"
+        assert restricted_variant.product.name in errors[0]["message"]
+        assert errors[0]["variants"] == [_variant_id(restricted_variant)]
+        assert not checkout.lines.exists()
+
