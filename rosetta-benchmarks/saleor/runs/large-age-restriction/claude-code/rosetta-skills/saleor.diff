+def validate_age_restricted_variants(
+    info: ResolveInfo,
+    variants: Iterable[product_models.ProductVariant],
+    get_buyer,
+    existing_line_ids: dict[int, str] | None = None,
+) -> None:
+    """Block restricted variants for a buyer that is not an eligible customer.
+
+    `variants` must have `product` loaded. `get_buyer` is called only when at least
+    one variant is age-restricted. `existing_line_ids` maps variant id to the
+    global id of the existing checkout line.
+    """
+    existing_line_ids = existing_line_ids or {}
+    items = [
+        AgeRestrictionItem(
+            variant_id=variant.id,
+            product=variant.product,
+            line_id=existing_line_ids.get(variant.id),
+        )
+        for variant in variants
+        if variant.product.is_age_restricted
+    ]
+    if not items:
+        return
+    site = get_site_promise(info.context).get()
+    requestor, first_party = get_requestor_for_age_check(info.context)
+    validate_age_restriction(
+        items=items,
+        buyer=get_buyer(),
+        requestor=requestor,
+        site_settings=site.settings,
+        error_codes=CheckoutErrorCode,
+        field="lines",
+        first_party=first_party,
+    )
+
