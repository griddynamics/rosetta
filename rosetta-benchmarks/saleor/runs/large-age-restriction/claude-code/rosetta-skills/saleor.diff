@@ -0,0 +1,127 @@
+from datetime import UTC, date, datetime
+
+import pytest
+
+from ...account.age import today_in_shop_tz
+from ..age_restriction import OrderAgeRestrictionError, validate_order_age_restriction
+from ..error_codes import OrderErrorCode
+
+
+@pytest.fixture
+def restricted_order_line(order_line):
+    product = order_line.variant.product
+    product.is_age_restricted = True
+    product.save(update_fields=["is_age_restricted"])
+    return order_line
+
+
+def _birthday_years_ago(site_settings, years):
+    today = today_in_shop_tz(site_settings.time_zone)
+    return date(today.year - years, today.month, 1)
+
+
+def test_no_explicit_user_passes(restricted_order_line, site_settings):
+    validate_order_age_restriction([restricted_order_line], None, site_settings)
+
+
+def test_no_restricted_line_passes(order_line, customer_user, site_settings):
+    customer_user.birthday = None
+
+    validate_order_age_restriction([order_line], customer_user, site_settings)
+
+
+def test_line_without_variant_is_skipped(
+    restricted_order_line, customer_user, site_settings
+):
+    customer_user.birthday = None
+    restricted_order_line.variant = None
+
+    validate_order_age_restriction(
+        [restricted_order_line], customer_user, site_settings
+    )
+
+
+def test_empty_lines_pass(customer_user, site_settings):
+    validate_order_age_restriction([], customer_user, site_settings)
+
+
+def test_birthday_required(restricted_order_line, customer_user, site_settings):
+    customer_user.birthday = None
+
+    with pytest.raises(OrderAgeRestrictionError) as exc:
+        validate_order_age_restriction(
+            [restricted_order_line], customer_user, site_settings
+        )
+
+    assert exc.value.code == OrderErrorCode.AGE_RESTRICTION_BIRTHDAY_REQUIRED
+
+
+def test_underage(restricted_order_line, customer_user, site_settings):
+    customer_user.birthday = _birthday_years_ago(site_settings, 10)
+
+    with pytest.raises(OrderAgeRestrictionError) as exc:
+        validate_order_age_restriction(
+            [restricted_order_line], customer_user, site_settings
+        )
+
+    assert exc.value.code == OrderErrorCode.AGE_RESTRICTION_UNDERAGE
+    assert str(customer_user.birthday.year) not in str(exc.value)
+
+
+def test_eligible(restricted_order_line, customer_user, site_settings):
+    customer_user.birthday = _birthday_years_ago(site_settings, 30)
+
+    validate_order_age_restriction(
+        [restricted_order_line], customer_user, site_settings
+    )
+
+
+def test_turning_minimum_age_today_is_eligible(
+    restricted_order_line, customer_user, site_settings
+):
+    site_settings.minimum_age = 20
+    customer_user.birthday = date(2006, 6, 15)
+
+    validate_order_age_restriction(
+        [restricted_order_line],
+        customer_user,
+        site_settings,
+        today=date(2026, 6, 15),
+    )
+
+
+def test_day_before_minimum_age_is_underage(
+    restricted_order_line, customer_user, site_settings
+):
+    site_settings.minimum_age = 20
+    customer_user.birthday = date(2006, 6, 15)
+
+    with pytest.raises(OrderAgeRestrictionError) as exc:
+        validate_order_age_restriction(
+            [restricted_order_line],
+            customer_user,
+            site_settings,
+            today=date(2026, 6, 14),
+        )
+
+    assert exc.value.code == OrderErrorCode.AGE_RESTRICTION_UNDERAGE
+
+
+def test_shop_time_zone_is_used(restricted_order_line, customer_user, site_settings):
+    now = datetime(2026, 6, 14, 23, 30, tzinfo=UTC)
+    site_settings.minimum_age = 18
+    # UTC date is 2026-06-14, Pacific/Kiritimati date is 2026-06-15.
+    customer_user.birthday = date(2008, 6, 15)
+
+    utc_today = today_in_shop_tz("UTC", now)
+    kiritimati_today = today_in_shop_tz("Pacific/Kiritimati", now)
+    assert (utc_today, kiritimati_today) == (date(2026, 6, 14), date(2026, 6, 15))
+
+    with pytest.raises(OrderAgeRestrictionError) as exc:
+        validate_order_age_restriction(
+            [restricted_order_line], customer_user, site_settings, today=utc_today
+        )
+    assert exc.value.code == OrderErrorCode.AGE_RESTRICTION_UNDERAGE
+    validate_order_age_restriction(
+        [restricted_order_line], customer_user, site_settings, today=kiritimati_today
+    )
