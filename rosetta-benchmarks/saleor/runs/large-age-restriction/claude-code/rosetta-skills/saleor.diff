@@ -0,0 +1,227 @@
+"""Age audit events survive deletion of actor and subject (D6-C3)."""
+
+import graphene
+import pytest
+
+from ....account import CustomerEvents
+from ....account.models import CustomerEvent, User
+from ....graphql.account.mutations.account.account_delete import (
+    account_delete_token_generator,
+)  # noqa: E501
+from ...tests.utils import get_graphql_content
+
+RETAINED = [
+    CustomerEvents.BIRTHDAY_UPDATED,
+    CustomerEvents.BIRTHDAY_VIEWED,
+    CustomerEvents.AGE_ELIGIBILITY_VIEWED,
+]
+
+
+def _create_events(user, subject_id=None):
+    subject_id = subject_id or user.pk
+    params = {"account_id": subject_id, "actor_id": user.pk}
+    for event_type in RETAINED:
+        CustomerEvent.objects.create(user=user, type=event_type, parameters=params)
+    CustomerEvent.objects.create(user=user, type=CustomerEvents.PASSWORD_CHANGED)
+    CustomerEvent.objects.create(user=user, type=CustomerEvents.PLACED_ORDER)
+
+
+def _assert_retained_only(user_pk):
+    remaining = CustomerEvent.objects.all()
+    assert sorted(e.type for e in remaining) == sorted(RETAINED)
+    for event in remaining:
+        assert event.user_id is None
+        assert event.parameters["account_id"] == user_pk
+        assert event.parameters["actor_id"] == user_pk
+
+
+def test_model_delete_keeps_retained_events(customer_user):
+    pk = customer_user.pk
+    _create_events(customer_user)
+
+    customer_user.delete()
+
+    _assert_retained_only(pk)
+
+
+def test_queryset_delete_keeps_retained_events(customer_user):
+    pk = customer_user.pk
+    _create_events(customer_user)
+
+    User.objects.filter(pk=pk).delete()
+
+    _assert_retained_only(pk)
+
+
+def test_deleting_actor_keeps_view_events_of_other_subject(superuser, customer_user):
+    CustomerEvent.objects.create(
+        user=superuser,
+        type=CustomerEvents.BIRTHDAY_VIEWED,
+        parameters={"account_id": customer_user.pk, "actor_id": superuser.pk},
+    )
+    superuser_pk = superuser.pk
+
+    superuser.delete()
