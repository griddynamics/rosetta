+from .test_checkout_complete_with_transactions import (
+    prepare_checkout_for_test,
+)
+from .test_checkout_lines_add import MUTATION_CHECKOUT_LINES_ADD
+
+NOW = "2026-10-22T12:00:00Z"
+B_EXACT = datetime.date(2008, 10, 22)  # 18 today
+B_TMRW = datetime.date(2008, 10, 23)  # 17 today
+
+pytestmark = pytest.mark.django_db
+
+LINES_UPDATE = """
+    mutation ($id: ID, $lines: [CheckoutLineUpdateInput!]!) {
+        checkoutLinesUpdate(id: $id, lines: $lines) {
+            errors { field code message variants lines }
+        }
+    }
+"""
+LINES_DELETE = """
+    mutation ($id: ID, $linesIds: [ID!]!) {
+        checkoutLinesDelete(id: $id, linesIds: $linesIds) {
+            errors { field code }
+        }
+    }
+"""
+CHECKOUT_CREATE = """
+    mutation ($input: CheckoutCreateInput!) {
+        checkoutCreate(input: $input) {
+            checkout { id }
+            errors { field code message variants lines }
+        }
+    }
+"""
+ADD_ERRORS_QUERY = MUTATION_CHECKOUT_LINES_ADD  # re-used: selects errors
+
+
+def _restrict(product):
+    product.is_age_restricted = True
+    product.save(update_fields=["is_age_restricted"])
+
+
+def _set_birthday(user, birthday):
+    user.birthday = birthday
+    user.save(update_fields=["birthday"])
+
+
+def _variant_id(variant):
+    return graphene.Node.to_global_id("ProductVariant", variant.pk)
+
+
+def _add(client, checkout, variant, quantity=1):
+    variables = {
+        "id": to_global_id_or_none(checkout),
+        "lines": [{"variantId": _variant_id(variant), "quantity": quantity}],
+    }
+    response = client.post_graphql(MUTATION_CHECKOUT_LINES_ADD, variables)
+    return get_graphql_content(response)["data"]["checkoutLinesAdd"]["errors"]
+
+
+@pytest.fixture
+def restricted_variant(product):
+    _restrict(product)
+    return product.variants.first()
+
+
+@pytest.fixture
+def checkout_for_age(checkout, stock):
+    """Empty checkout of the default channel with stock for `stock.variant`."""
