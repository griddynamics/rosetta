+CHECKOUTS_PROBLEMS_QUERY = """
+    query {
+        checkouts(first: 20) {
+            edges { node {
+                problems { __typename }
+                lines { problems { __typename ... on CheckoutLineProblemAgeRestricted { reason } } }
+            } }
+        }
+    }
+"""
+
+
+def _make_checkouts_with_restricted_lines(count, channel, variant):
+    from .....account.models import User
+    from .....checkout.models import Checkout, CheckoutLine
+
+    for i in range(count):
+        buyer = User.objects.create(
+            email=f"age-buyer-{count}-{i}@example.com", birthday=B_TMRW
+        )
+        checkout = Checkout.objects.create(
+            currency=channel.currency_code, channel=channel, user=buyer
+        )
+        CheckoutLine.objects.create(
+            checkout=checkout,
+            variant=variant,
+            quantity=1,
+            currency=channel.currency_code,
+        )
+
+
+@freeze_time(NOW)
+def test_checkout_problems_age_check_does_not_query_user_per_checkout(
+    staff_api_client, permission_manage_checkouts, channel_USD, restricted_variant
+):
+    from django.db import connection
+    from django.test.utils import CaptureQueriesContext
+
+    staff_api_client.user.user_permissions.add(permission_manage_checkouts)
+
+    def run():
+        with CaptureQueriesContext(connection) as queries:
+            response = staff_api_client.post_graphql(CHECKOUTS_PROBLEMS_QUERY)
+        edges = get_graphql_content(response)["data"]["checkouts"]["edges"]
+        user_queries = [q for q in queries if 'FROM "account_user"' in q["sql"]]
+        return edges, len(user_queries)
+
+    _make_checkouts_with_restricted_lines(2, channel_USD, restricted_variant)
+    run()  # warm up caches
+    edges_few, few = run()
+    _make_checkouts_with_restricted_lines(6, channel_USD, restricted_variant)
+    edges_many, many = run()
+
+    assert len(edges_few) == 2
+    assert len(edges_many) == 8
+    reasons = {
+        p["reason"]
+        for edge in edges_many
+        for line in edge["node"]["lines"]
+        for p in line["problems"]
+        if p["__typename"] == "CheckoutLineProblemAgeRestricted"
+    }
+    assert reasons == {"NOT_ELIGIBLE"}
+    # buyers come from the batch-loaded checkout info, not a per-checkout FK read
+    assert many == few
