+from io import StringIO
+
+from django.core.management import call_command
+
+
+def test_account_0106_sql_is_only_add_column():
+    out = StringIO()
+
+    call_command("sqlmigrate", "account", "0106", stdout=out)
+
+    statements = [
+        line.strip()
+        for line in out.getvalue().splitlines()
+        if line.strip() and not line.strip().startswith("--")
+    ]
+    statements = [s for s in statements if s not in ("BEGIN;", "COMMIT;")]
+    assert len(statements) == 1
+    assert 'ADD COLUMN "birthday" date NULL' in statements[0]
+
+
+def test_new_columns_are_metadata_only_constant_defaults():
+    out = StringIO()
+
+    call_command("sqlmigrate", "site", "0053", stdout=out)
+    call_command("sqlmigrate", "product", "0211", stdout=out)
+
+    sql = out.getvalue()
+    assert "DEFAULT 18" in sql
+    assert "DEFAULT 'UTC'" in sql
+    assert "default false" in sql.lower()
+
+
+def _column_default(table, column):
+    from django.db import connection
+
+    with connection.cursor() as cursor:
+        cursor.execute(
+            "SELECT column_default, is_nullable FROM information_schema.columns "
+            "WHERE table_name = %s AND column_name = %s",
+            [table, column],
+        )
+        return cursor.fetchone()
+
+
+def test_db_defaults_give_existing_rows_the_safe_values(db):
+    """Rows that exist before (or are inserted without) the new columns get defaults."""
+    assert _column_default("product_product", "is_age_restricted") == ("false", "NO")
+    assert _column_default("site_sitesettings", "minimum_age") == ("18", "NO")
+    default, nullable = _column_default("site_sitesettings", "time_zone")
+    assert default.startswith("'UTC'")
+    assert nullable == "NO"
+    assert _column_default("account_user", "birthday") == (None, "YES")
+
+
+def test_product_inserted_without_the_flag_is_not_restricted(db, product_type):
+    from django.db import connection
+
+    with connection.cursor() as cursor:
+        cursor.execute(
+            "INSERT INTO product_product (name, slug, product_type_id, "
+            "description_plaintext, search_document, search_index_dirty, created_at, "
+            "updated_at, metadata, private_metadata, seo_title, seo_description) "
+            "VALUES ('legacy', 'legacy', %s, '', '', false, now(), now(), '{}', '{}', "
+            "'', '') RETURNING is_age_restricted",
+            [product_type.pk],
+        )
+        assert cursor.fetchone() == (False,)
