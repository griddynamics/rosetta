diff --git a/saleor/payment/gateways/stripe/tests/test_webhooks_age_restriction.py b/saleor/payment/gateways/stripe/tests/test_webhooks_age_restriction.py
new file mode 100644
index 0000000..a691164
--- /dev/null
+++ b/saleor/payment/gateways/stripe/tests/test_webhooks_age_restriction.py
@@ -0,0 +1,94 @@
+"""Age restriction on the Stripe webhook checkout finalization path."""
+
+import logging
+from contextlib import nullcontext
+from datetime import date
+from unittest.mock import patch
+
+import pytest
+from stripe.stripe_object import StripeObject
+
+from .....account.age import today_in_shop_tz
+from .....checkout.models import Checkout
+from .....order.models import Order
+from ....utils import price_to_minor_unit
+from .. import webhooks
+from ..consts import SUCCESS_STATUS
+from ..webhooks import handle_successful_payment_intent
+
+
+def _restrict_checkout_products(checkout):
+    for line in checkout.lines.all():
+        product = line.variant.product
+        product.is_age_restricted = True
+        product.save(update_fields=["is_age_restricted"])
+
+
+def _send_success(payment, plugin, channel_slug):
+    payment.to_confirm = True
+    payment.save()
+    payment.transactions.create(
+        is_success=True,
+        action_required=True,
+        kind="action_to_confirm",
+        amount=payment.total,
+        currency=payment.currency,
+        token="ABC",
+        gateway_response={},
+    )
+    payment_intent = StripeObject(id="ABC", last_response={})
+    payment_intent["amount_received"] = price_to_minor_unit(
+        payment.total, payment.currency
+    )
+    payment_intent["setup_future_usage"] = None
+    payment_intent["currency"] = payment.currency
+    payment_intent["status"] = SUCCESS_STATUS
+    payment_intent["payment_method"] = StripeObject()
+    handle_successful_payment_intent(payment_intent, plugin.config, channel_slug)
+
+
+@pytest.mark.parametrize("has_birthday", [False, True])
+@patch("saleor.payment.gateways.stripe.webhooks.update_payment_method")
+def test_webhook_checkout_completion_age_restriction(
+    _update_payment_method,
+    has_birthday,
+    payment_stripe_for_checkout,
+    checkout_with_items,
+    customer_user,
+    site_settings,
+    stripe_plugin,
+    channel_USD,
+    caplog,
+):
+    # given
+    checkout = checkout_with_items
+    _restrict_checkout_products(checkout)
+    checkout.user = customer_user
+    checkout.save(update_fields=["user"])
+    today = today_in_shop_tz(site_settings.time_zone)
+    customer_user.birthday = (
+        date(today.year - 30, today.month, 1) if has_birthday else None
+    )
+    customer_user.save(update_fields=["birthday"])
+    process_payment_patch = (
+        patch("saleor.checkout.complete_checkout._process_payment")
+        if not has_birthday
+        else nullcontext()
+    )
+
+    # when
+    with (
+        caplog.at_level(logging.INFO, logger=webhooks.logger.name),
+        process_payment_patch as process_payment,
+    ):
+        _send_success(payment_stripe_for_checkout, stripe_plugin(), channel_USD.slug)
+
+    # then
+    if has_birthday:
+        assert Order.objects.filter(checkout_token=str(checkout.token)).exists()
+    else:
+        assert not Order.objects.filter(checkout_token=str(checkout.token)).exists()
+        assert Checkout.objects.filter(pk=checkout.pk).exists()
+        process_payment.assert_not_called()
+        record = next(r for r in caplog.records if "Failed to complete" in r.message)
+        assert "age-restricted" in record.error
