+def record_access_event(info, event_type: str, subject: User) -> None:
+    """Write an audit event for a disclosed age-related read.
+
+    Deduplicated per request by `(event_type, subject.pk)`. Call only after the
+    access predicate granted access. The event stores no PII.
+    """
+    seen = getattr(info.context, "_age_access_events", None)
+    if seen is None:
+        seen = set()
+        info.context._age_access_events = seen
+    key = (event_type, subject.pk)
+    if key in seen:
+        return
+    seen.add(key)
+    actor = info.context.user
+    with allow_writer():
+        if event_type == CustomerEvents.BIRTHDAY_VIEWED:
+            account_events.customer_birthday_viewed_event(
+                actor=actor, subject_id=subject.pk
+            )
+        elif event_type == CustomerEvents.AGE_ELIGIBILITY_VIEWED:
+            account_events.customer_age_eligibility_viewed_event(
+                actor=actor, subject_id=subject.pk
+            )
+        else:
+            raise ValueError(f"Unsupported access event type: {event_type}")
