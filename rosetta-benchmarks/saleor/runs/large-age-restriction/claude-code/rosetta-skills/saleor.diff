+def _count_add_queries(client, checkout, variant, patch_validator):
+    from unittest import mock
+
+    from django.db import connection
+    from django.test.utils import CaptureQueriesContext
+
+    target = (
+        "saleor.graphql.checkout.mutations.checkout_lines_add."
+        "validate_age_restricted_variants"
+    )
+    patcher = (
+        mock.patch(target, return_value=None)
+        if patch_validator
+        else mock.patch(target, new=_real_validator())
+    )
+    with patcher:
+        with CaptureQueriesContext(connection) as queries:
+            assert _add(client, checkout, variant) == []
+        checkout.lines.all().delete()
+    return len(queries)
+
+
+def _real_validator():
+    from .....graphql.checkout.mutations.utils import validate_age_restricted_variants
+
+    return validate_age_restricted_variants
+
