+    data = get_graphql_content(response)["data"]["customerBirthdayUpdate"]
+    assert data["errors"] == []
+    assert data["user"]["birthday"] == "2008-10-22"
+    customer_user.refresh_from_db()
+    assert customer_user.birthday == datetime.date(2008, 10, 22)
+
+    event = CustomerEvent.objects.get(type=CustomerEvents.BIRTHDAY_UPDATED)
+    assert event.user_id == superuser.pk
+    assert event.parameters == {
+        "account_id": customer_user.pk,
+        "actor_id": superuser.pk,
+        "cleared": False,
+    }
