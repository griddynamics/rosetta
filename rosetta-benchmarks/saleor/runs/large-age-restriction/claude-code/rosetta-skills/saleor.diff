index 0000000..fa97b8a
--- /dev/null
+++ b/saleor/account/age_restriction.py
@@ -0,0 +1,331 @@
+"""Domain rules for age-restricted products.
+
+Pure functions: shop "today", age math, buyer check, the shared validator and the
+access predicates for `User.birthday`. No GraphQL here.
+
+The birthday is PII: access is decided only by the predicates in this module.
+Nothing in this module may log or put a birthday into an error message.
+"""
+
+import base64
+import datetime
+import logging
+import re
+from collections.abc import Iterable, Sequence
+from dataclasses import dataclass
+from enum import Enum, StrEnum
+from typing import TYPE_CHECKING
+from zoneinfo import ZoneInfo
+
+from django.core.exceptions import ValidationError
+from django.utils import timezone
+
+from ..permission.enums import AccountPermissions
+from ..site.validators import validate_time_zone  # noqa: F401  (public API)
+from .error_codes import AccountErrorCode
+
+if TYPE_CHECKING:
+    from ..app.models import App
+    from ..graphql.core import SaleorContext
+    from ..product.models import Product
+    from ..site.models import SiteSettings
+    from .models import User
+
+logger = logging.getLogger(__name__)
+
+
+def to_global_id(type_name: str, pk: int) -> str:
+    # same encoding as `graphene.Node.to_global_id` (kept free of GraphQL imports)
+    return base64.b64encode(f"{type_name}:{pk}".encode()).decode()
+
+
+MAX_AGE_YEARS = 120
+MAX_NAMED_PRODUCTS = 3
+THIRDPARTY_TOKEN_TYPE = "thirdparty"
+
+
+class AgeCheckResult(StrEnum):
+    OK = "ok"
+    LOGIN_REQUIRED = "login_required"
+    BIRTHDAY_REQUIRED = "birthday_required"
+    UNDERAGE = "underage"
+    # public-only value, never returned by `check_buyer`
+    NOT_ELIGIBLE = "not_eligible"
+
+
+def get_shop_today(
+    site_settings: "SiteSettings", now: datetime.datetime | None = None
+) -> datetime.date:
+    """Return the current date in the shop's time zone (not Django's TIME_ZONE)."""
+    tz: datetime.tzinfo
+    try:
+        tz = ZoneInfo(site_settings.time_zone)
+    except Exception:  # unknown key, tzdata removed, bad data
+        logger.warning("Invalid shop time zone configured; falling back to UTC.")
+        tz = datetime.UTC
+    return timezone.localdate(now or timezone.now(), timezone=tz)
+
+
+def _shift_years(value: datetime.date, years: int) -> datetime.date:
+    """Move `value` by `years`; Feb 29 in a non-leap target year becomes Mar 1."""
+    try:
+        return value.replace(year=value.year + years)
+    except ValueError:
+        return datetime.date(value.year + years, 3, 1)
+
+
+def calculate_age(birthday: datetime.date, today: datetime.date) -> int:
+    return (
+        today.year
+        - birthday.year
+        - ((today.month, today.day) < (birthday.month, birthday.day))
+    )
+
+
+_STRICT_ISO_DATE = re.compile(r"\d{4}-\d{2}-\d{2}")
+
+
+def normalize_birthday_input(value: datetime.date | None) -> datetime.date | None:
+    """Accept only the strict `YYYY-MM-DD` form for a birthday input.
+
+    The GraphQL `Date` scalar also parses partial and compact ISO 8601 forms
+    (e.g. "2008-10", "20081022"). Those are rejected here, not in the scalar.
+    Returns a plain `date`.
+    """
+    if value is None:
+        return None
+    raw = getattr(value, "raw_value", None)
+    if raw is not None and not _STRICT_ISO_DATE.fullmatch(raw):
+        raise ValidationError(
+            "Date of birth must be a full date in the YYYY-MM-DD format.",
+            code=AccountErrorCode.INVALID.value,
+        )
+    return datetime.date(value.year, value.month, value.day)
+
+
+def validate_birthday(value: datetime.date | None, today: datetime.date) -> None:
+    """Raise ValidationError (code INVALID) for an unacceptable birthday.
+
+    Messages never echo the value.
+    """
+    if value is None:
+        return
+    if value > today:
+        raise ValidationError(
+            "Date of birth cannot be in the future.",
+            code=AccountErrorCode.INVALID.value,
+        )
+    if value < _shift_years(today, -MAX_AGE_YEARS):
+        raise ValidationError(
+            "Date of birth is too far in the past.",
+            code=AccountErrorCode.INVALID.value,
+        )
+
+
+def is_age_eligible(user: "User", minimum_age: int, today: datetime.date) -> bool:
+    birthday = user.birthday
+    return birthday is not None and calculate_age(birthday, today) >= minimum_age
+
+
+def check_buyer(
+    buyer: "User | None",
+    *,
+    minimum_age: int,
+    today: datetime.date,
+    guest_allowed: bool = False,
+) -> AgeCheckResult:
+    if buyer is None:
+        return AgeCheckResult.OK if guest_allowed else AgeCheckResult.LOGIN_REQUIRED
+    if buyer.birthday is None:
+        return AgeCheckResult.BIRTHDAY_REQUIRED
+    if not is_age_eligible(buyer, minimum_age, today):
+        return AgeCheckResult.UNDERAGE
+    return AgeCheckResult.OK
+
+
+def is_first_party_user(context: "SaleorContext") -> bool:
+    """First-party user requestor: no app, active user, not a thirdparty token."""
+    if getattr(context, "app", None) is not None:
+        return False
+    user = getattr(context, "user", None)
+    if user is None or not getattr(user, "is_authenticated", False):
+        return False
+    if not user.is_active:
+        return False
+    token = getattr(context, "decoded_auth_token", None)
+    return not (token and token.get("type") == THIRDPARTY_TOKEN_TYPE)
+
+
+def get_requestor_for_age_check(
+    context: "SaleorContext",
+) -> tuple["User | App | None", bool]:
+    """Return `(requestor, first_party)` for `validate_age_restriction`."""
+    app = getattr(context, "app", None)
+    if app is not None:
+        return app, False
+    user = getattr(context, "user", None)
+    if user is None or not getattr(user, "is_authenticated", False):
+        return None, False
+    return user, is_first_party_user(context)
+
+
+def can_read_birthday(context: "SaleorContext", subject: "User") -> bool:
+    if not is_first_party_user(context):
+        return False
+    user = context.user
+    assert user is not None
+    return user.pk == subject.pk or bool(user.is_superuser)
+
+
+def is_first_party_superuser(context: "SaleorContext") -> bool:
+    """Return True for an active superuser on a first-party (non-app) token."""
+    return is_first_party_user(context) and bool(context.user.is_superuser)  # type: ignore[union-attr]
+
+
+def can_write_birthday(context: "SaleorContext", subject: "User") -> bool:
+    return can_read_birthday(context, subject)
+
+
+def can_read_age_eligibility(context: "SaleorContext", subject: "User") -> bool:
+    if not is_first_party_user(context):
+        return False
+    user = context.user
+    assert user is not None
+    return user.pk == subject.pk or user.has_perm(AccountPermissions.MANAGE_USERS)
+
+
+def _user_model():
+    from .models import User
+
+    return User
+
+
+def public_reason(
+    result: AgeCheckResult,
+    *,
+    requestor: "User | App | None",
+    buyer: "User | None",
+    first_party: bool,
+) -> AgeCheckResult:
+    """Return the reason that may be disclosed to the requestor.
+
+    BIRTHDAY_REQUIRED / UNDERAGE are disclosed only to the buyer themselves
+    (a first-party user requestor). Others get NOT_ELIGIBLE.
+    `first_party=False` marks token-only holders (thirdparty tokens).
+    """
+    if result in (AgeCheckResult.BIRTHDAY_REQUIRED, AgeCheckResult.UNDERAGE):
+        if (
+            first_party
+            and buyer is not None
+            and isinstance(requestor, _user_model())
+            and requestor.is_active
+            and requestor.pk == buyer.pk
+        ):
+            return result
+        return AgeCheckResult.NOT_ELIGIBLE
+    return result
+
+
+@dataclass(frozen=True)
+class AgeRestrictionItem:
+    variant_id: int
+    product: "Product"
+    line_id: str | None = None
+
+
+def format_product_names(names: Sequence[str]) -> str:
+    unique = sorted(set(names))
+    shown = ", ".join(f'"{name}"' for name in unique[:MAX_NAMED_PRODUCTS])
+    rest = len(unique) - MAX_NAMED_PRODUCTS
+    if rest > 0:
+        shown += f" and {rest} more"
+    return shown
+
+
+MESSAGES = {
+    AgeCheckResult.LOGIN_REQUIRED: "Sign in to buy age-restricted products: {products}.",
+    AgeCheckResult.BIRTHDAY_REQUIRED: (
+        "Add your date of birth to your account to buy: {products}."
+    ),
+    AgeCheckResult.UNDERAGE: (
+        "You must be at least {minimum_age} years old to buy: {products}."
+    ),
+    AgeCheckResult.NOT_ELIGIBLE: (
+        "The customer is not eligible to buy age-restricted products: {products}."
+    ),
+}
+
+
+def get_error_message(
+    reason: AgeCheckResult, *, products: str, minimum_age: int
+) -> str:
+    return MESSAGES[reason].format(products=products, minimum_age=minimum_age)
+
+
+def get_error_code(error_codes: type[Enum], reason: AgeCheckResult) -> str:
+    """Return the error code value of `error_codes` for the reason.
+
+    Enums that define only AGE_RESTRICTED_NOT_ELIGIBLE (orders) always use it.
+    """
+    name = f"AGE_RESTRICTED_{reason.name}"
+    member = getattr(error_codes, name, None) or getattr(
+        error_codes, "AGE_RESTRICTED_NOT_ELIGIBLE"
+    )
+    return member.value
+
+
+def validate_age_restriction(
+    *,
+    items: Iterable[AgeRestrictionItem],
+    buyer: "User | None",
+    requestor: "User | App | None",
+    site_settings: "SiteSettings",
+    error_codes: type[Enum],
+    field: str,
+    first_party: bool,
+    guest_allowed: bool = False,
+    disclose_reason: bool = True,
+    lines_param: str = "lines",
+) -> None:
+    """Single shared validator for every age-restriction write path.
+
+    No-op when no item is restricted. Raises ValidationError keyed by `field`,
+    naming the blocking products, with `variants` / `lines` params.
+    """
+    restricted = [item for item in items if item.product.is_age_restricted]
+    if not restricted:
+        return
+    minimum_age = site_settings.minimum_age
+    result = check_buyer(
+        buyer,
+        minimum_age=minimum_age,
+        today=get_shop_today(site_settings),
+        guest_allowed=guest_allowed,
+    )
+    if result == AgeCheckResult.OK:
+        return
+    if not disclose_reason:
+        # drafts expose a single, non-disclosing reason
+        reason = AgeCheckResult.NOT_ELIGIBLE
+    else:
+        reason = public_reason(
+            result, requestor=requestor, buyer=buyer, first_party=first_party
+        )
+    variants = sorted(
+        {to_global_id("ProductVariant", i.variant_id) for i in restricted}
+    )
+    lines = sorted({i.line_id for i in restricted if i.line_id})
+    message = get_error_message(
+        reason,
+        products=format_product_names([i.product.name for i in restricted]),
+        minimum_age=minimum_age,
+    )
+    raise ValidationError(
+        {
+            field: ValidationError(
+                message,
+                code=get_error_code(error_codes, reason),
+                params={"variants": variants, lines_param: lines},
+            )
+        }
+    )
