+def test_access_predicates_matrix(
+    customer_user,
+    staff_user,
+    superuser,
+    app,
+    permission_manage_users,
+    permission_manage_staff,
+    staff_users,
+):
+    other_customer = staff_users[2]
+    staff_with_perm = staff_users[1]
+    staff_with_perm.user_permissions.add(permission_manage_users)
+    staff_manage_staff = staff_users[3] if len(staff_users) > 3 else staff_users[2]
+    staff_manage_staff.user_permissions.add(permission_manage_staff)
+
+    def flags(context, subject=customer_user):
+        return (
+            can_read_birthday(context, subject),
+            can_write_birthday(context, subject),
+            can_read_age_eligibility(context, subject),
+        )
+
+    assert flags(_context(customer_user, token_type="access")) == (True, True, True)
+    assert flags(_context(superuser, token_type="access")) == (True, True, True)
+    assert flags(_context(staff_with_perm)) == (False, False, True)
+    assert flags(_context(staff_user)) == (False, False, False)
+    assert flags(_context(staff_manage_staff)) == (False, False, False)
+    assert flags(_context(other_customer)) == (False, False, False)
+    assert flags(_context(None)) == (False, False, False)
+    assert flags(_context(customer_user, app=app)) == (False, False, False)
+    assert flags(_context(None, app=app)) == (False, False, False)
+    # thirdparty (app extension) token of a superuser and of the owner
+    assert flags(_context(superuser, token_type="thirdparty")) == (False,) * 3
+    assert flags(_context(customer_user, token_type="thirdparty")) == (False,) * 3
+    # inactive superuser
+    superuser.is_active = False
+    assert flags(_context(superuser)) == (False, False, False)
+    assert not is_first_party_superuser(_context(superuser))
