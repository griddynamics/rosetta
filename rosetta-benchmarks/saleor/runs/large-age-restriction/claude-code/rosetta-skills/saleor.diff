+    for reason in (AgeCheckResult.BIRTHDAY_REQUIRED, AgeCheckResult.UNDERAGE):
+        assert public_reason(reason, first_party=True, **owner_kwargs) == reason
+        assert (
+            public_reason(
+                reason, requestor=staff_user, buyer=customer_user, first_party=True
+            )
+            == AgeCheckResult.NOT_ELIGIBLE
+        )
+        assert (
+            public_reason(reason, requestor=app, buyer=customer_user, first_party=False)
+            == AgeCheckResult.NOT_ELIGIBLE
+        )
+        assert (
+            public_reason(
+                reason, requestor=None, buyer=customer_user, first_party=False
+            )
+            == AgeCheckResult.NOT_ELIGIBLE
+        )
+        assert (
+            public_reason(reason, first_party=False, **owner_kwargs)
