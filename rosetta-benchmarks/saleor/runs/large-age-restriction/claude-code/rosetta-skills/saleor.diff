+    assert len(lines) > 1
+    for line_info in lines:
+        _restrict(line_info.product)
+    variant_ids = [line_info.variant.pk for line_info in lines]
+    checkout = Checkout.objects.get(pk=checkout.pk)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout.user  # noqa: B018 - warm the relation as the mutations have it loaded
+
+    # when
+    e2_one = _count(
+        lambda: _validate_checkout_age_restriction(checkout, lines[:1], site_settings)
+    )
+    e2_all = _count(
+        lambda: _validate_checkout_age_restriction(checkout, lines, site_settings)
+    )
+    e1_one = _count(
+        lambda: validate_age_restriction_for_variant_ids(
+            variant_ids[:1], lambda: checkout.user, site_settings
+        )
+    )
+    e1_all = _count(
+        lambda: validate_age_restriction_for_variant_ids(
+            variant_ids, lambda: checkout.user, site_settings
+        )
+    )
+
+    # then
+    assert e2_one == e2_all == 0
+    assert e1_one == e1_all == 1
