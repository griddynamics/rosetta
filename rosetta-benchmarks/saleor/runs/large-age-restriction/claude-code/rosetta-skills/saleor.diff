+def get_age_checked_customer(order: models.Order) -> "User | None":
+    """Return the customer to age-check: only an explicit link, never email-derived."""
+    if order.user_linked_by_email:
+        return None
+    return order.user
+
+
+def apply_email_user_link(
+    data: dict, current_user_id: int | None = None
+) -> bool | None:
+    """Link the account matching `user_email` (overriding `user`) in draft input.
+
+    Returns the new `user_linked_by_email` value, or None when neither `user` nor
+    `user_email` is in the input (flag stays unchanged). The link is explicit
+    only if staff passed a non-null `user` resolving to the same account, or
+    passed `user` without a matching email. An email resolving to the account
+    already linked on the order (`current_user_id`) leaves the flag unchanged, so
+    re-sending the same email never weakens an explicit link.
+    """
+    explicit_id = data.get("user")
+    if email := data.get("user_email", None):
+        try:
+            user = User.objects.get(email=email, is_active=True)
+        except User.DoesNotExist:
+            data["user"] = None
+            return False
+        data["user"] = graphene.Node.to_global_id("User", user.id)
+        if explicit_id is None and user.id == current_user_id:
+            return None
+        return explicit_id != data["user"]
+    if "user" in data:
+        return False
+    return None
+
+
+def validate_order_lines_age_restriction(
+    variant_ids: Iterable[int],
+    get_explicit_user: Callable[[], "User | None"],
+    site_settings: "SiteSettings",
+    field: str = "lines",
+) -> None:
+    """Early (UX) age check of the touched lines of an order or draft.
+
+    Runs a single query for all variants. `get_explicit_user` must return the
+    customer stored on the order (never a user matched by email) and is called
+    only when a restricted product is present.
+    """
+    variant_ids = list(variant_ids)
+    if not variant_ids:
+        return
+    restricted_products = list(
+        product_models.Product.objects.filter(
+            variants__id__in=variant_ids, is_age_restricted=True
+        ).distinct()
+    )
+    if not restricted_products:
+        return
+    try:
+        validate_order_age_restriction_for_products(
+            restricted_products, get_explicit_user(), site_settings
+        )
+    except OrderAgeRestrictionError as e:
+        raise ValidationError(
+            {field: ValidationError(e.message, code=e.code.value)}
+        ) from e
+
+
+def validate_order_completion_age_restriction(
+    order: models.Order, site_settings: "SiteSettings"
+) -> None:
+    """Authoritative age check of all draft lines, run before the email auto-link.
+
+    Uses the customer stored on the draft; `order.lines` must have
+    `variant__product` loaded to avoid per-line queries.
+    """
+    try:
+        validate_order_age_restriction(
+            order.lines.all(), get_age_checked_customer(order), site_settings
+        )
+    except OrderAgeRestrictionError as e:
+        raise ValidationError(
+            {"lines": ValidationError(e.message, code=e.code.value)}
+        ) from e
