@@ -0,0 +1,139 @@
+import pytest
+
+from .....core.error_codes import ShopErrorCode
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+SHOP_SETTINGS_UPDATE_MUTATION = """
+    mutation updateSettings($input: ShopSettingsInput!) {
+        shopSettingsUpdate(input: $input) {
+            shop {
+                minimumAge
+                timeZone
+            }
+            errors {
+                field
+                message
+                code
+            }
+        }
+    }
+"""
+
+SHOP_QUERY = """
+    query {
+        shop {
+            minimumAge
+            timeZone
+        }
+    }
+"""
+
+
+def test_shop_age_settings_default_values_are_public(api_client, site_settings):
+    # when
+    response = api_client.post_graphql(SHOP_QUERY)
+
+    # then
+    shop = get_graphql_content(response)["data"]["shop"]
+    assert shop == {"minimumAge": 18, "timeZone": "UTC"}
+
+
+def test_shop_settings_update_minimum_age_and_time_zone(
+    staff_api_client, site_settings, permission_manage_settings, api_client
+):
+    # given
+    variables = {"input": {"minimumAge": 21, "timeZone": "Europe/Warsaw"}}
+
+    # when
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_UPDATE_MUTATION,
+        variables,
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert not data["errors"]
+    assert data["shop"] == {"minimumAge": 21, "timeZone": "Europe/Warsaw"}
+    site_settings.refresh_from_db()
+    assert site_settings.minimum_age == 21
+    assert site_settings.time_zone == "Europe/Warsaw"
+    public = get_graphql_content(api_client.post_graphql(SHOP_QUERY))["data"]["shop"]
+    assert public == {"minimumAge": 21, "timeZone": "Europe/Warsaw"}
+
+
+@pytest.mark.parametrize("age", [1, 120])
+def test_shop_settings_update_minimum_age_boundaries(
+    age, staff_api_client, site_settings, permission_manage_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_UPDATE_MUTATION,
+        {"input": {"minimumAge": age}},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert not data["errors"]
+    assert data["shop"]["minimumAge"] == age
+
+
+@pytest.mark.parametrize("age", [0, -1, 121, None])
+def test_shop_settings_update_invalid_minimum_age(
+    age, staff_api_client, site_settings, permission_manage_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_UPDATE_MUTATION,
+        {"input": {"minimumAge": age}},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert data["errors"] == [
+        {
+            "field": "minimumAge",
+            "message": "Minimum age must be between 1 and 120.",
+            "code": ShopErrorCode.INVALID.name,
+        }
+    ]
+    site_settings.refresh_from_db()
+    assert site_settings.minimum_age == 18
+
+
+@pytest.mark.parametrize(
+    "time_zone", ["Mars/Phobos", "", "../etc/passwd", "UTC\x00", "A" * 64]
+)
+def test_shop_settings_update_invalid_time_zone(
+    time_zone, staff_api_client, site_settings, permission_manage_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_UPDATE_MUTATION,
+        {"input": {"timeZone": time_zone}},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert [(e["field"], e["code"]) for e in data["errors"]] == [
+        ("timeZone", ShopErrorCode.INVALID.name)
+    ]
+    site_settings.refresh_from_db()
+    assert site_settings.time_zone == "UTC"
+
+
+def test_shop_settings_update_age_settings_requires_manage_settings(
+    staff_api_client, site_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_UPDATE_MUTATION, {"input": {"minimumAge": 21}}
+    )
+
+    # then
+    assert_no_permission(response)
+    site_settings.refresh_from_db()
+    assert site_settings.minimum_age == 18
