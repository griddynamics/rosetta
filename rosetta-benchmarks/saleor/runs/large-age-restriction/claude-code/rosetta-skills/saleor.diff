@@ -0,0 +1,281 @@
+"""Age restriction on draft / unconfirmed orders (spec C10-C13, D5, R6)."""
+
+import datetime
+
+import graphene
+import pytest
+from freezegun import freeze_time
+
+from .....order import OrderStatus
+from .....order.models import Order
+from ....tests.utils import get_graphql_content
+from .test_draft_order_complete import DRAFT_ORDER_COMPLETE_MUTATION
+from .test_draft_order_create import DRAFT_ORDER_CREATE_MUTATION
+from .test_order_line_update import ORDER_LINE_UPDATE_MUTATION
+from .test_order_lines_create import ORDER_LINES_CREATE_MUTATION
+
+NOW = "2026-10-22T12:00:00Z"
+B_EXACT = datetime.date(2008, 10, 22)
+B_TMRW = datetime.date(2008, 10, 23)
+
+ORDER_ERRORS_QUERY = """
+    query ($id: ID!) {
+        order(id: $id) { errors { field code orderLines } canFinalize }
+    }
+"""
+
+
+def _restrict(variant):
+    variant.product.is_age_restricted = True
+    variant.product.save(update_fields=["is_age_restricted"])
+
+
+def _birthday(user, value):
+    user.birthday = value
+    user.save(update_fields=["birthday"])
+
+
+def _vid(variant):
+    return graphene.Node.to_global_id("ProductVariant", variant.pk)
+
+
+def _create(client, channel, variant, user=None, user_email=None, quantity=1):
+    order_input = {
+        "channelId": graphene.Node.to_global_id("Channel", channel.pk),
+        "lines": [{"variantId": _vid(variant), "quantity": quantity}],
+    }
+    if user:
+        order_input["user"] = graphene.Node.to_global_id("User", user.pk)
+    if user_email:
+        order_input["userEmail"] = user_email
+    response = client.post_graphql(DRAFT_ORDER_CREATE_MUTATION, {"input": order_input})
+    return get_graphql_content(response)["data"]["draftOrderCreate"]
+
+
+@pytest.fixture
+def orders_staff(staff_api_client, permission_group_manage_orders):
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    return staff_api_client
+
+
+@freeze_time(NOW)
+def test_draft_create_without_customer_is_allowed_and_completes(
+    orders_staff, channel_USD, variant, shipping_method, graphql_address_data
+):
+    _restrict(variant)
+
+    data = _create(orders_staff, channel_USD, variant)
+
+    assert data["errors"] == []
+    order = Order.objects.get()
+    assert order.user_id is None
+    # completing needs no customer eligibility
+    order.billing_address = order.billing_address or None
+    response = orders_staff.post_graphql(
+        ORDER_ERRORS_QUERY, {"id": graphene.Node.to_global_id("Order", order.pk)}
+    )
+    errors = get_graphql_content(response)["data"]["order"]["errors"]
+    assert not [e for e in errors if e["code"] == "AGE_RESTRICTED_NOT_ELIGIBLE"]
+
+
+@freeze_time(NOW)
+@pytest.mark.parametrize("birthday", [None, B_TMRW])
+def test_draft_create_with_ineligible_user_is_rejected(
+    birthday, orders_staff, channel_USD, variant, customer_user
+):
+    _restrict(variant)
+    _birthday(customer_user, birthday)
+
+    data = _create(orders_staff, channel_USD, variant, user=customer_user)
+
+    assert [e["code"] for e in data["errors"]] == ["AGE_RESTRICTED_NOT_ELIGIBLE"]
+    assert data["errors"][0]["field"] == "lines"
+    assert variant.product.name in data["errors"][0]["message"]
+    assert data["errors"][0]["variants"] == [_vid(variant)]
+    assert not Order.objects.exists()
+
+
+@freeze_time(NOW)
+def test_draft_create_with_eligible_user_is_allowed(
+    orders_staff, channel_USD, variant, customer_user
+):
+    _restrict(variant)
+    _birthday(customer_user, B_EXACT)
+
+    data = _create(orders_staff, channel_USD, variant, user=customer_user)
+
+    assert data["errors"] == []
+
+
+@freeze_time(NOW)
+def test_draft_create_by_email_of_active_underage_account_links_and_blocks(
+    orders_staff, channel_USD, variant, customer_user
+):
+    """Core auto-links the active account by e-mail: that explicit link is checked."""
+    _restrict(variant)
+    _birthday(customer_user, B_TMRW)
+
+    data = _create(orders_staff, channel_USD, variant, user_email=customer_user.email)
+
+    assert [e["code"] for e in data["errors"]] == ["AGE_RESTRICTED_NOT_ELIGIBLE"]
+
+
+@freeze_time(NOW)
+def test_draft_with_only_email_of_inactive_underage_account_is_allowed(
+    orders_staff, channel_USD, variant, customer_user
+):
+    _restrict(variant)
+    _birthday(customer_user, B_TMRW)
+    customer_user.is_active = False
+    customer_user.save(update_fields=["is_active"])
+
+    data = _create(orders_staff, channel_USD, variant, user_email=customer_user.email)
+
+    assert data["errors"] == []
+    assert Order.objects.get().user_id is None
+
+
+@freeze_time(NOW)
+@pytest.mark.parametrize("status", [OrderStatus.DRAFT, OrderStatus.UNCONFIRMED])
+def test_order_lines_create_rejects_ineligible_linked_user(
+    status, orders_staff, draft_order, customer_user, variant
+):
+    _restrict(variant)
+    _birthday(customer_user, None)
+    draft_order.user = customer_user
+    draft_order.status = status
+    draft_order.save(update_fields=["user", "status"])
+    variables = {
+        "orderId": graphene.Node.to_global_id("Order", draft_order.pk),
+        "variantId": _vid(variant),
+        "quantity": 1,
+        "forceNewLine": True,
+    }
+
+    response = orders_staff.post_graphql(ORDER_LINES_CREATE_MUTATION, variables)
+
+    errors = get_graphql_content(response)["data"]["orderLinesCreate"]["errors"]
+    assert [e["code"] for e in errors] == ["AGE_RESTRICTED_NOT_ELIGIBLE"]
+    assert errors[0]["field"] == "variantId"
+    assert variant.product.name in errors[0]["message"]
+
+
+@freeze_time(NOW)
+def test_order_lines_create_allowed_without_user_and_for_eligible_user(
+    orders_staff, draft_order, customer_user, variant
+):
+    _restrict(variant)
+    draft_order.user = None
+    draft_order.save(update_fields=["user"])
+    variables = {
+        "orderId": graphene.Node.to_global_id("Order", draft_order.pk),
+        "variantId": _vid(variant),
+        "quantity": 1,
+        "forceNewLine": True,
+    }
+    response = orders_staff.post_graphql(ORDER_LINES_CREATE_MUTATION, variables)
+    assert get_graphql_content(response)["data"]["orderLinesCreate"]["errors"] == []
+
+    _birthday(customer_user, B_EXACT)
+    draft_order.user = customer_user
+    draft_order.save(update_fields=["user"])
+    response = orders_staff.post_graphql(ORDER_LINES_CREATE_MUTATION, variables)
+    assert get_graphql_content(response)["data"]["orderLinesCreate"]["errors"] == []
+
+
+@freeze_time(NOW)
+@pytest.mark.parametrize("status", [OrderStatus.DRAFT, OrderStatus.UNCONFIRMED])
+def test_order_line_update_increase_blocked_decrease_allowed(
+    status, orders_staff, order_with_lines, customer_user
+):
+    order = order_with_lines
+    line = order.lines.first()
+    _restrict(line.variant)
+    _birthday(customer_user, B_TMRW)
+    order.user = customer_user
+    order.status = status
+    order.save(update_fields=["user", "status"])
+    line_id = graphene.Node.to_global_id("OrderLine", line.pk)
+
+    response = orders_staff.post_graphql(
+        ORDER_LINE_UPDATE_MUTATION, {"lineId": line_id, "quantity": line.quantity + 1}
+    )
+    errors = get_graphql_content(response)["data"]["orderLineUpdate"]["errors"]
+    assert [e["code"] for e in errors] == ["AGE_RESTRICTED_NOT_ELIGIBLE"]
+
+    response = orders_staff.post_graphql(
+        ORDER_LINE_UPDATE_MUTATION, {"lineId": line_id, "quantity": line.quantity - 1}
+    )
+    assert get_graphql_content(response)["data"]["orderLineUpdate"]["errors"] == []
+
+
+@freeze_time(NOW)
+def test_draft_complete_checks_explicit_link_and_reports_in_order_errors(
+    orders_staff, draft_order, customer_user, superuser, order_line
+):
+    # given a restricted line was added while no customer was linked
+    line = draft_order.lines.first()
+    _restrict(line.variant)
+    _birthday(customer_user, B_TMRW)
+    draft_order.user = customer_user
+    draft_order.save(update_fields=["user"])
+    order_id = graphene.Node.to_global_id("Order", draft_order.pk)
+
+    # then Order.errors lists it and canFinalize is false
+    response = orders_staff.post_graphql(ORDER_ERRORS_QUERY, {"id": order_id})
+    data = get_graphql_content(response)["data"]["order"]
+    codes = [e["code"] for e in data["errors"]]
+    assert "AGE_RESTRICTED_NOT_ELIGIBLE" in codes
+    assert data["canFinalize"] is False
+    restricted = next(
+        e for e in data["errors"] if e["code"] == "AGE_RESTRICTED_NOT_ELIGIBLE"
+    )
+    assert restricted["orderLines"] == [
+        graphene.Node.to_global_id("OrderLine", line.pk)
+    ]
+
+    # completing is rejected
+    response = orders_staff.post_graphql(
+        DRAFT_ORDER_COMPLETE_MUTATION, {"id": order_id}
+    )
+    errors = get_graphql_content(response)["data"]["draftOrderComplete"]["errors"]
+    assert "AGE_RESTRICTED_NOT_ELIGIBLE" in [e["code"] for e in errors]
+    draft_order.refresh_from_db()
+    assert draft_order.status == OrderStatus.DRAFT
+
+    # unlinking the customer makes it completable again (checks that part only)
+    draft_order.user = None
+    draft_order.save(update_fields=["user"])
+    response = orders_staff.post_graphql(ORDER_ERRORS_QUERY, {"id": order_id})
+    errors = get_graphql_content(response)["data"]["order"]["errors"]
+    assert "AGE_RESTRICTED_NOT_ELIGIBLE" not in [e["code"] for e in errors]
+
+    # and so does a birthday set later by the owner
+    draft_order.user = customer_user
+    draft_order.save(update_fields=["user"])
+    _birthday(customer_user, B_EXACT)
+    response = orders_staff.post_graphql(ORDER_ERRORS_QUERY, {"id": order_id})
+    errors = get_graphql_content(response)["data"]["order"]["errors"]
+    assert "AGE_RESTRICTED_NOT_ELIGIBLE" not in [e["code"] for e in errors]
+
+
+@freeze_time(NOW)
+def test_placed_order_operations_are_not_revalidated(
+    orders_staff, order_with_lines, customer_user, site_settings
+):
+    """R6: flag / minimum age / birthday changes never touch placed orders."""
+    order = order_with_lines
+    order.user = customer_user
+    order.save(update_fields=["user"])
+    for line in order.lines.all():
+        _restrict(line.variant)
+    _birthday(customer_user, None)
+    site_settings.minimum_age = 99
+    site_settings.save(update_fields=["minimum_age"])
+
+    response = orders_staff.post_graphql(
+        ORDER_ERRORS_QUERY, {"id": graphene.Node.to_global_id("Order", order.pk)}
+    )
+
+    data = get_graphql_content(response)["data"]["order"]
+    assert data["errors"] == []
