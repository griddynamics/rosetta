index 0000000..55e9672
--- /dev/null
+++ b/saleor/account/age.py
@@ -0,0 +1,52 @@
+"""Pure age calculation helpers. No I/O, "today" is always passed or injected."""
+
+from datetime import UTC, date, datetime
+from zoneinfo import ZoneInfo
+
+MIN_BIRTHDAY = date(1900, 1, 1)
+
+
+def today_in_shop_tz(time_zone: str, now: datetime | None = None) -> date:
+    """Return the current date in the given IANA time zone.
+
+    `now` allows injecting the clock; naive values are treated as UTC.
+    """
+    if now is None:
+        now = datetime.now(UTC)
+    elif now.tzinfo is None:
+        now = now.replace(tzinfo=UTC)
+    return now.astimezone(ZoneInfo(time_zone)).date()
+
+
+def minimum_age_date(birthday: date, years: int) -> date:
+    """Return the first date on which a person born on `birthday` is `years` old.
+
+    A Feb 29 birthday falls on Mar 1 when the target year is not a leap year.
+    """
+    try:
+        return birthday.replace(year=birthday.year + years)
+    except ValueError:
+        if birthday.month != 2 or birthday.day != 29:
+            raise
+        return date(birthday.year + years, 3, 1)
+
+
+def is_age_eligible(birthday: date | None, minimum_age: int, today: date) -> bool:
+    """Return True when the person has reached `minimum_age` on `today`.
+
+    Unknown birthday is never eligible.
+    """
+    if birthday is None:
+        return False
+    return today >= minimum_age_date(birthday, minimum_age)
+
+
+def validate_birthday(birthday: date, today: date) -> None:
+    """Raise ValueError when the birthday is in the future or before 1900-01-01.
+
+    The error message intentionally does not contain the date.
+    """
+    if birthday > today:
+        raise ValueError("Birthday cannot be in the future.")
+    if birthday < MIN_BIRTHDAY:
+        raise ValueError("Birthday is too far in the past.")
