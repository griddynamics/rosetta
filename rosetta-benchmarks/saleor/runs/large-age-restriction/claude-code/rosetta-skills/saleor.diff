+def _prepare_complete(
+    checkout_with_item,
+    customer_user,
+    address,
+    address_usa,
+    checkout_delivery,
+    transaction_item_generator,
+    transaction_events_generator,
+    birthday,
+    restricted=True,
+    attach_user=True,
+):
+    if restricted:
+        _restrict(checkout_with_item.lines.first().variant.product)
+    _set_birthday(customer_user, birthday)
+    checkout = prepare_checkout_for_test(
+        checkout_with_item,
+        address,
+        address_usa,
+        checkout_delivery(checkout_with_item),
+        transaction_item_generator,
+        transaction_events_generator,
+        user=customer_user if attach_user else None,
+    )
+    return checkout
+
