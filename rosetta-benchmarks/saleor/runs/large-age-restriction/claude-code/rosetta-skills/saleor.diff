+from datetime import date
+
+import pytest
+
+from ...account import CustomerEvents
+from ..age_audit import log_birthday_changed, log_birthday_read
+
+pytestmark = pytest.mark.django_db
+
+
+def _assert_clean(event):
+    assert "message" not in event.parameters
+    assert event.app is None
+    assert event.order is None
+
+
+def test_log_birthday_changed_by_customer(customer_user):
+    event = log_birthday_changed(customer=customer_user, actor=customer_user)
+
+    event.refresh_from_db()
+    assert event.type == CustomerEvents.BIRTHDAY_CHANGED
+    assert event.user == customer_user
+    assert event.parameters == {
+        "actor_type": "customer",
+        "actor_id": customer_user.pk,
+        "action": "change",
+    }
+    _assert_clean(event)
+
+
+def test_log_birthday_changed_by_staff(customer_user, staff_user):
+    event = log_birthday_changed(customer=customer_user, actor=staff_user)
+
+    assert event.user == customer_user
+    assert event.parameters["actor_type"] == "staff"
+    assert event.parameters["actor_id"] == staff_user.pk
+    _assert_clean(event)
+
+
+def test_log_birthday_changed_by_app(customer_user, app):
+    event = log_birthday_changed(customer=customer_user, actor=app)
+
+    assert event.user == customer_user
+    assert event.parameters == {
+        "actor_type": "app",
+        "actor_id": app.pk,
+        "action": "change",
+    }
+    _assert_clean(event)
+
+
+def test_log_birthday_read_birthday(customer_user, staff_user):
+    event = log_birthday_read(customer=customer_user, actor=staff_user, kind="birthday")
+
+    event.refresh_from_db()
+    assert event.type == CustomerEvents.BIRTHDAY_VIEWED
+    assert event.user == customer_user
+    assert event.parameters == {
+        "actor_type": "staff",
+        "actor_id": staff_user.pk,
+        "action": "read",
+        "kind": "birthday",
+    }
+    _assert_clean(event)
+
+
+def test_log_birthday_read_eligibility(customer_user, staff_user):
+    event = log_birthday_read(
+        customer=customer_user, actor=staff_user, kind="eligibility"
+    )
+
+    assert event.type == CustomerEvents.AGE_ELIGIBILITY_VIEWED
+    assert event.parameters["kind"] == "eligibility"
+    _assert_clean(event)
+
+
+def test_events_do_not_store_birthday_value(customer_user, staff_user):
+    # given
+    customer_user.birthday = date(2001, 2, 3)
+    customer_user.save(update_fields=["birthday"])
+
+    # when
+    events = [
+        log_birthday_changed(customer=customer_user, actor=staff_user),
+        log_birthday_read(customer=customer_user, actor=staff_user, kind="birthday"),
+        log_birthday_read(customer=customer_user, actor=staff_user, kind="eligibility"),
+    ]
+
+    # then
+    for event in events:
+        event.refresh_from_db()
+        assert "2001" not in str(event.parameters)
+        assert "birthday" not in event.parameters
