new file mode 100644
index 0000000..edbd427
--- /dev/null
+++ b/saleor/site/validators.py
@@ -0,0 +1,18 @@
+from functools import lru_cache
+from zoneinfo import available_timezones
+
+from django.core.exceptions import ValidationError
+
+
+@lru_cache(maxsize=1)
+def _available_time_zones() -> frozenset[str]:
+    return frozenset(available_timezones())
+
+
+def validate_time_zone(name: str) -> None:
+    """Raise ValidationError unless `name` is an exact IANA time zone key."""
+    if not name or name not in _available_time_zones():
+        raise ValidationError(
+            "Unknown time zone. Use an IANA time zone name, e.g. 'Europe/Warsaw'.",
+            code="invalid",
+        )
