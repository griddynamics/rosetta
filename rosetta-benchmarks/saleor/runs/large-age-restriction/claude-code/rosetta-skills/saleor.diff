diff --git a/saleor/order/age_restriction.py b/saleor/order/age_restriction.py
new file mode 100644
index 0000000..420be77
--- /dev/null
+++ b/saleor/order/age_restriction.py
@@ -0,0 +1,71 @@
+from collections.abc import Iterable
+from datetime import date
+
+from ..account.age import is_age_eligible, today_in_shop_tz
+from ..account.models import User
+from ..product.models import Product
+from ..site.models import SiteSettings
+from .error_codes import OrderErrorCode
+from .models import OrderLine
+
+ERROR_MESSAGES = {
+    OrderErrorCode.AGE_RESTRICTION_BIRTHDAY_REQUIRED: (
+        "Add your birthday to your account to buy age-restricted products."
+    ),
+    OrderErrorCode.AGE_RESTRICTION_UNDERAGE: "You are too young to buy this product.",
+}
+
+
+class OrderAgeRestrictionError(Exception):
+    """Raised when the order customer cannot buy age-restricted products.
+
+    The message never contains personal data.
+    """
+
+    def __init__(self, code: OrderErrorCode):
+        self.code = code
+        self.message = ERROR_MESSAGES[code]
+        super().__init__(self.message)
+
+
+def validate_order_age_restriction(
+    lines: Iterable[OrderLine],
+    explicit_user: User | None,
+    site_settings: SiteSettings,
+    *,
+    today: date | None = None,
+) -> None:
+    """Ensure the customer linked to the order may buy its age-restricted lines.
+
+    `explicit_user` must be the user stored on the order, not a user matched by
+    email. An order without a linked customer is always allowed. Lines without
+    a variant are skipped. Callers must load lines with
+    `select_related("variant__product")` to avoid per-line queries.
+    `today` overrides the current shop-time-zone date (for tests).
+    """
+    validate_order_age_restriction_for_products(
+        (line.variant.product for line in lines if line.variant is not None),
+        explicit_user,
+        site_settings,
+        today=today,
+    )
+
+
+def validate_order_age_restriction_for_products(
+    products: Iterable[Product],
+    explicit_user: User | None,
+    site_settings: SiteSettings,
+    *,
+    today: date | None = None,
+) -> None:
+    """Apply the `validate_order_age_restriction` rules to resolved products."""
+    if explicit_user is None:
+        return
+    if not any(product.is_age_restricted for product in products):
+        return
+    if explicit_user.birthday is None:
+        raise OrderAgeRestrictionError(OrderErrorCode.AGE_RESTRICTION_BIRTHDAY_REQUIRED)
+    if today is None:
+        today = today_in_shop_tz(site_settings.time_zone)
+    if not is_age_eligible(explicit_user.birthday, site_settings.minimum_age, today):
+        raise OrderAgeRestrictionError(OrderErrorCode.AGE_RESTRICTION_UNDERAGE)
