+
+@freeze_time(NOW)
+def test_account_update_accepts_birthday_today(user_api_client, customer_user):
+    response = user_api_client.post_graphql(
+        ACCOUNT_UPDATE_BIRTHDAY, {"input": {"birthday": "2026-10-22"}}
