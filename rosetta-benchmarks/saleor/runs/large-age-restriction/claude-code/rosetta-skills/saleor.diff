+import graphene
+import pytest
+
+from .....product.search import update_products_search_vector
+from ....tests.utils import get_graphql_content
+
+QUERY_SINGLE = """
+    query ($slug: String!, $channel: String!) {
+        product(slug: $slug, channel: $channel) { isAgeRestricted ageLabel }
+    }
+"""
+
+QUERY_LIST = """
+    query ($channel: String!) {
+        products(first: 50, channel: $channel) {
+            edges { node { slug isAgeRestricted ageLabel } }
+        }
+    }
+"""
+
+QUERY_SEARCH = """
+    query ($channel: String!, $search: String!) {
+        products(first: 50, channel: $channel, search: $search) {
+            edges { node { slug } }
+        }
+    }
+"""
+
+QUERY_WHERE = """
+    query ($channel: String!, $slug: String!) {
+        products(first: 50, channel: $channel, where: {slug: {eq: $slug}}) {
+            edges { node { slug } }
+        }
+    }
+"""
+
+QUERY_VARIANT = """
+    query ($id: ID!, $channel: String!) {
+        productVariant(id: $id, channel: $channel) {
+            product { isAgeRestricted ageLabel }
+        }
+    }
+"""
+
+QUERY_CATEGORY = """
+    query ($id: ID!, $channel: String!) {
+        category(id: $id) {
+            products(first: 50, channel: $channel) {
+                edges { node { slug ageLabel } }
+            }
+        }
+    }
+"""
+
+
+@pytest.fixture
+def restricted_product(product):
+    product.is_age_restricted = True
+    product.save(update_fields=["is_age_restricted"])
+    update_products_search_vector([product.pk])
+    return product
+
+
+@pytest.fixture(params=["anonymous", "customer"])
+def client(request, api_client, user_api_client):
+    return api_client if request.param == "anonymous" else user_api_client
+
+
+def test_restricted_product_visible_with_label(client, restricted_product, channel_USD):
+    variables = {"slug": restricted_product.slug, "channel": channel_USD.slug}
+
+    data = get_graphql_content(client.post_graphql(QUERY_SINGLE, variables))["data"]
+
+    assert data["product"] == {"isAgeRestricted": True, "ageLabel": "18+"}
+
+
+def test_restricted_product_in_listing_and_search(
+    client, restricted_product, channel_USD
+):
+    variables = {"channel": channel_USD.slug}
+    nodes = get_graphql_content(client.post_graphql(QUERY_LIST, variables))["data"][
+        "products"
+    ]["edges"]
+    assert restricted_product.slug in [n["node"]["slug"] for n in nodes]
+    node = next(
+        n["node"] for n in nodes if n["node"]["slug"] == restricted_product.slug
+    )
+    assert node["ageLabel"] == "18+"
+
+    searched = get_graphql_content(
+        client.post_graphql(
+            QUERY_SEARCH, {**variables, "search": restricted_product.name}
+        )
+    )["data"]["products"]["edges"]
+    assert restricted_product.slug in [n["node"]["slug"] for n in searched]
+
+    filtered = get_graphql_content(
+        client.post_graphql(QUERY_WHERE, {**variables, "slug": restricted_product.slug})
+    )["data"]["products"]["edges"]
+    assert len(filtered) == 1
+
+
+def test_restricted_product_in_variant_and_category(
+    client, restricted_product, channel_USD
+):
+    variant = restricted_product.variants.first()
+    data = get_graphql_content(
+        client.post_graphql(
+            QUERY_VARIANT,
+            {
+                "id": graphene.Node.to_global_id("ProductVariant", variant.pk),
+                "channel": channel_USD.slug,
+            },
+        )
+    )["data"]
+    assert data["productVariant"]["product"]["ageLabel"] == "18+"
+
+    data = get_graphql_content(
+        client.post_graphql(
+            QUERY_CATEGORY,
+            {
+                "id": graphene.Node.to_global_id(
+                    "Category", restricted_product.category_id
+                ),
+                "channel": channel_USD.slug,
+            },
+        )
+    )["data"]
+    slugs = [n["node"]["slug"] for n in data["category"]["products"]["edges"]]
+    assert restricted_product.slug in slugs
+
+
+def test_unrestricted_product_has_no_label(client, product, channel_USD):
+    variables = {"slug": product.slug, "channel": channel_USD.slug}
+    data = get_graphql_content(client.post_graphql(QUERY_SINGLE, variables))["data"]
+    assert data["product"] == {"isAgeRestricted": False, "ageLabel": None}
+
+
+def test_age_label_follows_minimum_age(
+    api_client, restricted_product, channel_USD, site_settings
+):
+    site_settings.minimum_age = 21
+    site_settings.save(update_fields=["minimum_age"])
+    variables = {"slug": restricted_product.slug, "channel": channel_USD.slug}
+
+    data = get_graphql_content(api_client.post_graphql(QUERY_SINGLE, variables))["data"]
+
+    assert data["product"]["ageLabel"] == "21+"
+
+
+QUERY_COLLECTION = """
+    query ($id: ID!, $channel: String!) {
+        collection(id: $id, channel: $channel) {
+            products(first: 50) { edges { node { slug ageLabel } } }
+        }
+    }
+"""
+
+
+def test_restricted_product_in_collection(
+    client, restricted_product, published_collection, channel_USD
+):
+    from .....product.models import CollectionProduct
+
+    CollectionProduct.objects.get_or_create(
+        collection=published_collection, product=restricted_product
+    )
+    variables = {
+        "id": graphene.Node.to_global_id("Collection", published_collection.pk),
+        "channel": channel_USD.slug,
+    }
+
+    data = get_graphql_content(client.post_graphql(QUERY_COLLECTION, variables))["data"]
+
+    nodes = [e["node"] for e in data["collection"]["products"]["edges"]]
+    assert {"slug": restricted_product.slug, "ageLabel": "18+"} in nodes
