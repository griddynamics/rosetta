+from .....core.error_codes import ShopErrorCode
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+MUTATION = """
+    mutation ($input: ShopSettingsInput!) {
+        shopSettingsUpdate(input: $input) {
+            shop { minimumAge timeZone }
+            errors { field code message }
+        }
+    }
+"""
+
+SHOP_QUERY = """
+    query { shop { minimumAge timeZone } }
+"""
+
+
+def test_shop_defaults_are_public(api_client):
+    content = get_graphql_content(api_client.post_graphql(SHOP_QUERY))
+    assert content["data"]["shop"] == {"minimumAge": 18, "timeZone": "UTC"}
+
+
+def test_update_minimum_age_and_time_zone(
+    staff_api_client, site_settings, permission_manage_settings
+):
+    variables = {"input": {"minimumAge": 21, "timeZone": "Europe/Warsaw"}}
+
+    response = staff_api_client.post_graphql(
+        MUTATION, variables, permissions=[permission_manage_settings]
+    )
+
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert data["errors"] == []
+    assert data["shop"] == {"minimumAge": 21, "timeZone": "Europe/Warsaw"}
+    site_settings.refresh_from_db()
+    assert site_settings.minimum_age == 21
+    assert site_settings.time_zone == "Europe/Warsaw"
+
+
+def test_boundaries_of_minimum_age(
+    staff_api_client, site_settings, permission_manage_settings
+):
+    staff_api_client.user.user_permissions.add(permission_manage_settings)
+    for value in (1, 120):
+        response = staff_api_client.post_graphql(
+            MUTATION, {"input": {"minimumAge": value}}
+        )
+        assert (
+            get_graphql_content(response)["data"]["shopSettingsUpdate"]["errors"] == []
+        )
+    for value in (0, 121, -5):
+        response = staff_api_client.post_graphql(
+            MUTATION, {"input": {"minimumAge": value}}
+        )
+        errors = get_graphql_content(response)["data"]["shopSettingsUpdate"]["errors"]
+        assert errors == [
+            {
+                "field": "minimumAge",
+                "code": ShopErrorCode.INVALID.name,
+                "message": "Minimum age must be between 1 and 120.",
+            }
+        ]
+    site_settings.refresh_from_db()
+    assert site_settings.minimum_age == 120
+
+
+def test_invalid_time_zone(staff_api_client, site_settings, permission_manage_settings):
+    staff_api_client.user.user_permissions.add(permission_manage_settings)
+    for value in ("Nope/Zone", "", "utc"):
+        response = staff_api_client.post_graphql(
+            MUTATION, {"input": {"timeZone": value}}
+        )
+        errors = get_graphql_content(response)["data"]["shopSettingsUpdate"]["errors"]
+        assert [(e["field"], e["code"]) for e in errors] == [
+            ("timeZone", ShopErrorCode.INVALID.name)
+        ]
+    site_settings.refresh_from_db()
+    assert site_settings.time_zone == "UTC"
+
+
+def test_null_leaves_values_unchanged(
+    staff_api_client, site_settings, permission_manage_settings
+):
+    site_settings.minimum_age = 25
+    site_settings.time_zone = "Asia/Tokyo"
+    site_settings.save(update_fields=["minimum_age", "time_zone"])
+    staff_api_client.user.user_permissions.add(permission_manage_settings)
+
+    response = staff_api_client.post_graphql(
+        MUTATION, {"input": {"minimumAge": None, "timeZone": None}}
+    )
+
+    assert get_graphql_content(response)["data"]["shopSettingsUpdate"]["errors"] == []
+    site_settings.refresh_from_db()
+    assert (site_settings.minimum_age, site_settings.time_zone) == (25, "Asia/Tokyo")
+
+
+def test_requires_manage_settings(staff_api_client, permission_manage_settings):
+    response = staff_api_client.post_graphql(MUTATION, {"input": {"minimumAge": 21}})
+    assert_no_permission(response)
+
+
+def test_time_zone_is_case_sensitive(
+    staff_api_client, site_settings, permission_manage_settings
+):
+    staff_api_client.user.user_permissions.add(permission_manage_settings)
+
+    response = staff_api_client.post_graphql(MUTATION, {"input": {"timeZone": "utc"}})
+    errors = get_graphql_content(response)["data"]["shopSettingsUpdate"]["errors"]
+    assert [(e["field"], e["code"]) for e in errors] == [
+        ("timeZone", ShopErrorCode.INVALID.name)
+    ]
+
+    response = staff_api_client.post_graphql(MUTATION, {"input": {"timeZone": "UTC"}})
+    assert get_graphql_content(response)["data"]["shopSettingsUpdate"]["errors"] == []
