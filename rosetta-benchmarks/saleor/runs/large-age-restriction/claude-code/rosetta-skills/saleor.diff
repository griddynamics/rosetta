+    data = get_graphql_content(response)["data"]["productBulkCreate"]
+    assert data["count"] == 3
+    assert all(not result["errors"] for result in data["results"])
+    flags = {
+        result["product"]["id"]: result["product"]["isAgeRestricted"]
+        for result in data["results"]
+    }
+    assert list(flags.values()) == [True, False, False]
+    assert Product.objects.get(name="restricted").is_age_restricted is True
+    assert Product.objects.get(name="plain").is_age_restricted is False
+    assert Product.objects.get(name="explicit false").is_age_restricted is False
