+PARTIAL_OR_NON_ISO_DATES = ["2008", "2008-10", "20081022", "2008-W43-3", "2008-295"]
+
+
+@freeze_time(NOW)
+@pytest.mark.parametrize("value", PARTIAL_OR_NON_ISO_DATES)
+def test_account_update_rejects_partial_and_non_iso_dates(
+    value, user_api_client, customer_user
+):
+    response = user_api_client.post_graphql(
+        ACCOUNT_UPDATE_BIRTHDAY, {"input": {"birthday": value}}
+    )
+
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+    assert [(e["field"], e["code"]) for e in data["errors"]] == [
