+    mocked_task, api_client, customer_user, registration_without_confirmation
+):
+    # given
+    def register(email, birthday):
+        input_data = {"email": email, "password": "Password"}
+        if birthday:
+            input_data["birthday"] = BIRTHDAY.isoformat()
+        with CaptureQueriesContext(connection) as ctx:
+            response = api_client.post_graphql(
+                ACCOUNT_REGISTER_MUTATION, {"input": input_data}
+            )
+        assert not get_graphql_content(response)["data"]["accountRegister"]["errors"]
+        return ctx.captured_queries
+
+    def event_inserts(queries):
+        return [
+            q
+            for q in queries
+            if q["sql"].startswith('INSERT INTO "account_customerevent"')
+        ]
+
+    # when
+    new_plain = register("age-enum-plain@example.com", birthday=False)
+    existing_plain = register(customer_user.email, birthday=False)
+    new_birthday = register("age-enum-new@example.com", birthday=True)
+    existing_birthday = register(customer_user.email, birthday=True)
+
+    # then
+    # both paths perform exactly one audit-table INSERT when a birthday is given
+    assert len(event_inserts(new_plain)) == len(event_inserts(existing_plain)) == 0
+    assert len(event_inserts(new_birthday)) == 1
+    assert len(event_inserts(existing_birthday)) == 1
+    # the gap between the paths does not grow compared to the no-birthday case
+    gap_plain = len(new_plain) - len(existing_plain)
+    gap_birthday = len(new_birthday) - len(existing_birthday)
+    assert abs(gap_birthday) <= abs(gap_plain)
+    # no audit row leaks to the existing user or is left behind by the probe
+    assert not CustomerEvent.objects.filter(
+        type=CustomerEvents.BIRTHDAY_CHANGED, user=None
+    ).exists()
+    assert not _birthday_events(customer_user)
