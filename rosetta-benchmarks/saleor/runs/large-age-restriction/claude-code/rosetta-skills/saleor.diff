+# Completion tests cannot freeze time (checkout price expiration depends on it),
+# so the birthdays are relative to the real current date in UTC.
+_TODAY = datetime.datetime.now(tz=datetime.UTC).date()
+C_EXACT = (
+    _TODAY.replace(year=_TODAY.year - 18)
+    if (_TODAY.month, _TODAY.day) != (2, 29)
+    else datetime.date(_TODAY.year - 18, 2, 28)
+)
+C_TMRW = C_EXACT + datetime.timedelta(days=1)
