+from typing import cast
+
+import graphene
+from django.core.exceptions import ValidationError
+
+from .....account import events as account_events
+from .....account import models
+from .....account.age_restriction import (
+    get_shop_today,
+    is_first_party_superuser,
+    normalize_birthday_input,
+    validate_birthday,
+)
+from .....core.tracing import traced_atomic_transaction
+from .....permission.auth_filters import AuthorizationFilters
+from ....core import ResolveInfo
+from ....core.descriptions import ADDED_IN_323
+from ....core.doc_category import DOC_CATEGORY_USERS
+from ....core.mutations import BaseMutation
+from ....core.scalars import Date
+from ....core.types import AccountError
+from ....site.dataloaders import get_site_promise
+from ...types import User
+
+
+class CustomerBirthdayUpdate(BaseMutation):
+    user = graphene.Field(User, description="A user instance with the new birthday.")
+
+    class Arguments:
+        id = graphene.ID(
+            required=True, description="ID of the user whose birthday is updated."
+        )
+        birthday = Date(
+            required=False,
+            description="New date of birth. Pass `null` to clear the birthday.",
+        )
+
+    class Meta:
+        description = (
+            "Sets, changes or clears the date of birth of any user. Only a "
+            "superuser can use this mutation. Every change is recorded in the "
+            "audit log." + ADDED_IN_323 + "\n\nRequires a superuser."
+        )
+        auto_permission_message = False
+        doc_category = DOC_CATEGORY_USERS
+        permissions = (AuthorizationFilters.AUTHENTICATED_STAFF_USER,)
+        error_type_class = AccountError
+        error_type_field = "account_errors"
+
+    @classmethod
+    def check_permissions(
+        cls, context, permissions=None, require_all_permissions=False, **data
+    ):
+        # Apps, thirdparty tokens and non-superusers are denied.
+        return is_first_party_superuser(context)
+
+    @classmethod
+    def perform_mutation(  # type: ignore[override]
+        cls, _root, info: ResolveInfo, /, *, id, birthday=None
+    ):
+        subject = cls.get_node_or_error(info, id, only_type=User, field="id")
+        site = get_site_promise(info.context).get()
+        try:
+            birthday = normalize_birthday_input(birthday)
+            validate_birthday(birthday, get_shop_today(site.settings))
+        except ValidationError as e:
+            raise ValidationError({"birthday": e}) from e
+
+        with traced_atomic_transaction():
+            subject = models.User.objects.select_for_update().get(pk=subject.pk)
+            if subject.birthday != birthday:
+                subject.birthday = birthday
+                subject.save(update_fields=["birthday", "updated_at"])
+                account_events.customer_birthday_updated_event(
+                    actor=cast(models.User, info.context.user),
+                    subject_id=subject.pk,
+                    cleared=birthday is None,
+                )
+        return cls(user=subject)
