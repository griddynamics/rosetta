+"""Completion authority and auto-complete for age-restricted checkouts."""
+
+import datetime
+import logging
+from unittest import mock
+
+import pytest
+from django.contrib.sites.models import Site
+from django.core.exceptions import ValidationError
+
+from ...account.age_restriction import AgeCheckResult
+from ...account.models import User
+from ...checkout.error_codes import CheckoutErrorCode
+from ...checkout.fetch import fetch_checkout_info, fetch_checkout_lines
+from ...checkout.models import Checkout
+from ...checkout.tasks import automatic_checkout_completion_task
+from ...order.models import Order
+from ...plugins.manager import get_plugins_manager
+from ...site.models import SiteSettings
+from ..complete_checkout import complete_checkout, create_order_from_checkout
+from ..problems import CheckoutLineProblemAgeRestricted, get_checkout_lines_problems
+
+_TODAY = datetime.datetime.now(tz=datetime.UTC).date()
+ADULT = datetime.date(_TODAY.year - 30, 1, 1)
+MINOR = datetime.date(_TODAY.year - 10, 1, 1)
+AGE_19 = datetime.date(_TODAY.year - 19, 1, 1)
+# age facts that must never reach a log line or a non-owner-visible text
+AGE_FACTS = ("UNDERAGE", "BIRTHDAY_REQUIRED", "years old", "date of birth")
+
+
+def _restrict_all(checkout):
+    for line in checkout.lines.select_related("variant__product"):
+        line.variant.product.is_age_restricted = True
+        line.variant.product.save(update_fields=["is_age_restricted"])
+
+
+def _buyer(checkout, user, birthday):
+    user.birthday = birthday
+    user.save(update_fields=["birthday"])
+    checkout.user = user
+    checkout.save(update_fields=["user"])
+
+
+def test_auto_complete_transaction_flow_keeps_checkout_for_ineligible_buyer(
+    checkout_with_prices,
+    transaction_item_generator,
+    customer_user,
+    django_capture_on_commit_callbacks,
+    warehouse_for_cc,
+):
+    checkout = checkout_with_prices
+    _restrict_all(checkout)
+    _buyer(checkout, customer_user, MINOR)
+    transaction_item_generator(
+        checkout_id=checkout.pk, charged_value=checkout.total.gross.amount
+    )
+
+    with django_capture_on_commit_callbacks(execute=True):
+        automatic_checkout_completion_task(checkout.pk)
+
+    assert Checkout.objects.filter(pk=checkout.pk).exists()
+    assert not Order.objects.filter(checkout_token=checkout.pk).exists()
+
+
+def test_auto_complete_transaction_flow_completes_for_eligible_buyer(
+    checkout_with_prices,
+    transaction_item_generator,
+    customer_user,
+    django_capture_on_commit_callbacks,
+    warehouse_for_cc,
+):
+    checkout = checkout_with_prices
+    _restrict_all(checkout)
+    _buyer(checkout, customer_user, ADULT)
+    transaction_item_generator(
+        checkout_id=checkout.pk, charged_value=checkout.total.gross.amount
+    )
+
+    with django_capture_on_commit_callbacks(execute=True):
+        automatic_checkout_completion_task(checkout.pk)
+
+    assert Order.objects.filter(checkout_token=checkout.pk).exists()
+
+
+@pytest.mark.parametrize("requestor", ["automatic", "user"])
+@mock.patch("saleor.payment.gateway.payment_refund_or_void")
+@mock.patch("saleor.checkout.complete_checkout._process_payment")
+def test_payment_flow_rejects_before_charging(
+    mocked_process_payment,
+    mocked_refund_or_void,
+    requestor,
+    checkout_ready_to_complete,
+    payment_dummy,
+    customer_user,
+    django_capture_on_commit_callbacks,
+):
+    checkout = checkout_ready_to_complete
+    checkout.gift_cards.clear()
+    checkout.payments.add(payment_dummy)
+    _restrict_all(checkout)
+    _buyer(checkout, customer_user, MINOR)
+
+    with django_capture_on_commit_callbacks(execute=True):
+        if requestor == "automatic":
+            automatic_checkout_completion_task(checkout.pk)
+        else:
+            manager = get_plugins_manager(allow_replica=False)
+            lines, _ = fetch_checkout_lines(checkout)
+            checkout_info = fetch_checkout_info(checkout, lines, manager)
+            with pytest.raises(ValidationError) as error:
+                complete_checkout(
+                    manager=manager,
+                    checkout_info=checkout_info,
+                    lines=lines,
+                    payment_data={},
+                    store_source=False,
+                    user=customer_user,
+                    app=None,
+                    first_party=True,
+                )
+            err = error.value.error_dict["lines"][0]
+            assert err.code == CheckoutErrorCode.AGE_RESTRICTED_UNDERAGE.value
+
+    # the payment is never charged and the existing fail handler voids/refunds it
+    mocked_process_payment.assert_not_called()
+    mocked_refund_or_void.assert_called_once()
+    assert mocked_refund_or_void.call_args.args[0].pk == payment_dummy.pk
+    assert Checkout.objects.filter(pk=checkout.pk).exists()
+    assert not Order.objects.filter(checkout_token=checkout.pk).exists()
+
+
+@pytest.mark.parametrize("change", ["birthday_changed", "customer_swapped"])
+def test_create_order_from_checkout_rechecks_persisted_user_under_lock(
+    change, checkout_with_prices, customer_user
+):
+    """The authority reads the persisted checkout user under the row lock.
+
+    `checkout_info` is built while the buyer is eligible; the DB row changes
+    afterwards (birthday edited / checkout re-assigned to a minor). The stale
+    in-memory user must not be trusted.
+    """
+    checkout = checkout_with_prices
+    _restrict_all(checkout)
+    _buyer(checkout, customer_user, ADULT)
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+    assert checkout_info.user.birthday == ADULT
+    assert checkout_info.checkout.user.birthday == ADULT
+
+    if change == "birthday_changed":
+        User.objects.filter(pk=customer_user.pk).update(birthday=MINOR)
+    else:
+        minor = User.objects.create(email="minor@example.com", birthday=MINOR)
+        Checkout.objects.filter(pk=checkout.pk).update(user=minor)
+    # the in-memory objects are still eligible
+    assert checkout_info.checkout.user.birthday == ADULT
+
+    with pytest.raises(ValidationError) as error:
+        create_order_from_checkout(
+            checkout_info=checkout_info,
+            manager=manager,
+            user=customer_user,
+            app=None,
+            first_party=True,
+        )
+
+    # the owner of the persisted checkout is now someone else: generic reason
+    expected = (
+        CheckoutErrorCode.AGE_RESTRICTED_UNDERAGE
+        if change == "birthday_changed"
+        else CheckoutErrorCode.AGE_RESTRICTED_NOT_ELIGIBLE
+    )
+    err = error.value.error_dict["lines"][0]
+    assert err.code == expected.value
+    assert not Order.objects.exists()
+    assert Checkout.objects.filter(pk=checkout.pk).exists()
+
