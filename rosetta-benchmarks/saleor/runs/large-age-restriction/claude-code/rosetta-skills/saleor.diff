+        (WebhookEventAsyncType.CUSTOMER_UPDATED, "CustomerUpdated"),
+        (WebhookEventAsyncType.CUSTOMER_CREATED, "CustomerCreated"),
+    ],
+)
+def test_subscription_payload_resolves_age_fields_to_null_for_app(
+    event_type, type_name, customer_with_birthday, subscription_webhook
+):
+    # given
+    webhook = subscription_webhook(
+        CUSTOMER_SUBSCRIPTION_TEMPLATE % type_name, event_type
+    )
+
+    # when
+    deliveries = create_deliveries_for_subscriptions(
+        event_type, customer_with_birthday, [webhook]
+    )
+
+    # then
+    raw_payload = deliveries[0].payload.get_payload()
+    user = json.loads(raw_payload)["user"]
+    assert user == {
+        "email": customer_with_birthday.email,
+        "birthday": None,
+        "isAgeEligible": None,
+        "isSuperuser": None,
+    }
+    assert BIRTHDAY.isoformat() not in raw_payload
+    assert not CustomerEvent.objects.filter(
+        type__in=[
+            CustomerEvents.BIRTHDAY_VIEWED,
+            CustomerEvents.AGE_ELIGIBILITY_VIEWED,
+        ]
+    ).exists()
+
+
+def test_search_vector_value_is_independent_of_birthday(customer_user):
+    # given
+    before = [str(v) for v in generate_user_search_vector_value(customer_user)]
+
+    # when
+    customer_user.birthday = BIRTHDAY
+    after = [str(v) for v in generate_user_search_vector_value(customer_user)]
+
+    # then
+    assert before == after
+    assert BIRTHDAY.isoformat() not in " ".join(after)
+
+
+def test_birthday_is_not_filterable_or_sortable():
+    # given
+    type_map = schema.get_type_map()
+    checked = [
+        "CustomerFilterInput",
+        "CustomerWhereInput",
+        "StaffUserInput",
+        "UserSortField",
+        "UserSortingInput",
+    ]
+
+    # then
+    for name in checked:
+        graphql_type = type_map[name]
+        if hasattr(graphql_type, "values"):
+            members = [value.name for value in graphql_type.values]
+        else:
+            members = list(graphql_type.fields)
+        assert members, name
+        assert not any("birthday" in member.lower() for member in members), name
