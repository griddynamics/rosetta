+def test_product_bulk_create_persists_age_restricted_flag(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    products = [
+        _create_input(product_type, category, name="restricted", isAgeRestricted=True),
+        _create_input(product_type, category, name="plain"),
+        _create_input(
+            product_type, category, name="explicit false", isAgeRestricted=False
