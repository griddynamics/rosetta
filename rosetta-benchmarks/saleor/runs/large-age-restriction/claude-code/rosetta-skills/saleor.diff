+
+def test_calculate_age_boundaries():
+    assert calculate_age(B_EXACT, TODAY) == 18
+    assert calculate_age(B_YDAY, TODAY) == 18
+    assert calculate_age(B_TMRW, TODAY) == 17
+
+
+def test_calculate_age_leap_day_birthday():
+    born = datetime.date(2008, 2, 29)
+    assert calculate_age(born, datetime.date(2026, 2, 28)) == 17
+    assert calculate_age(born, datetime.date(2026, 3, 1)) == 18
+    assert calculate_age(datetime.date(2004, 2, 29), datetime.date(2024, 2, 29)) == 20
