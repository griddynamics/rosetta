+def validate_age_restriction_or_raise(
+    products: Iterable[Product],
+    get_user: Callable[[], User | None],
+    site_settings: SiteSettings,
+) -> None:
+    """Check `products` against the checkout owner's age, as a GraphQL error.
+
+    `get_user` is called only when a restricted product is present, to avoid
+    fetching the user otherwise. It must return the user assigned to the
+    checkout (never a user matched by email).
+    """
+    products = list(products)
+    if not any(product.is_age_restricted for product in products):
+        return
+    try:
+        validate_age_restriction_for_products(products, get_user(), site_settings)
+    except AgeRestrictionError as e:
+        raise ValidationError(
+            {"lines": ValidationError(e.message, code=e.code.value)}
+        ) from e
+
+
+def validate_age_restriction_for_variant_ids(
+    variant_ids: Iterable[int],
+    get_user: Callable[[], User | None],
+    site_settings: SiteSettings,
+) -> None:
+    """Single-query age check for the products of the given variants."""
+    variant_ids = list(variant_ids)
+    if not variant_ids:
+        return
+    products = Product.objects.filter(
+        variants__id__in=variant_ids, is_age_restricted=True
+    ).distinct()
+    validate_age_restriction_or_raise(products, get_user, site_settings)
