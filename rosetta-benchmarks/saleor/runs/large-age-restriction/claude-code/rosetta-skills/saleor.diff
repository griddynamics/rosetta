+
+
+def test_subscription_payload_returns_null_birthday(
+    user_with_birthday, subscription_webhook
+):
+    query = """
+        subscription {
+            event {
+                ... on CustomerUpdated {
+                    user {
+                        id
+                        email
+                        birthday
+                        isAgeEligible
+                    }
+                }
+            }
+        }
+    """
+    webhook = subscription_webhook(query, WebhookEventAsyncType.CUSTOMER_UPDATED)
+
+    deliveries = create_deliveries_for_subscriptions(
+        WebhookEventAsyncType.CUSTOMER_UPDATED, user_with_birthday, [webhook]
+    )
+
+    payload = json.loads(deliveries[0].payload.get_payload())
+    assert payload["user"]["birthday"] is None
+    assert payload["user"]["isAgeEligible"] is None
+    assert BIRTHDAY not in deliveries[0].payload.get_payload()
+    assert not CustomerEvent.objects.filter(
