+PROBLEMS_QUERY = """
+    query ($id: ID) {
+        checkout(id: $id) {
+            problems {
+                __typename
+                ... on CheckoutLineProblemAgeRestricted { reason line { id } }
+            }
+            lines {
+                problems {
+                    __typename
+                    ... on CheckoutLineProblemAgeRestricted { reason }
+                }
+            }
+        }
+    }
+"""
+
+
+def _age_problems(client, checkout):
+    response = client.post_graphql(
+        PROBLEMS_QUERY, {"id": to_global_id_or_none(checkout)}
+    )
+    data = get_graphql_content(response)["data"]["checkout"]
+    top = [
+        p["reason"]
+        for p in data["problems"]
+        if p["__typename"] == "CheckoutLineProblemAgeRestricted"
+    ]
+    per_line = [
+        p["reason"]
+        for line in data["lines"]
+        for p in line["problems"]
+        if p["__typename"] == "CheckoutLineProblemAgeRestricted"
+    ]
+    return top, per_line
