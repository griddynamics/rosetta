+def test_error_messages_contain_no_date():
+    for reason in MESSAGES:
+        message = get_error_message(reason, products='"Wine"', minimum_age=18)
+        assert not ISO_DATE.search(message)
+        assert "birthday" not in message.lower()
+    for code in CheckoutErrorCode:
+        assert not ISO_DATE.search(code.value)
