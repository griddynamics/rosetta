+def test_account_update_birthday_by_app_with_impersonation_denied(
+    app_api_client, customer_user, permission_manage_users, permission_impersonate_user
+):
+    app_api_client.app.permissions.add(
+        permission_manage_users, permission_impersonate_user
+    )
