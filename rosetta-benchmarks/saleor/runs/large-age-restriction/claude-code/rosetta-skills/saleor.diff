+        "input": {"birthday": "2008-10-22"},
+        "customerId": graphene.Node.to_global_id("User", customer_user.pk),
+    }
+
+    response = app_api_client.post_graphql(ACCOUNT_UPDATE_BIRTHDAY, variables)
+
+    assert_no_permission(response)
+    customer_user.refresh_from_db()
+    assert customer_user.birthday is None
