+from datetime import UTC, date, datetime
+
+import pytest
+
+from ...account.age import today_in_shop_tz
+from ..age_restriction import AgeRestrictionError, validate_age_restriction
+from ..error_codes import CheckoutErrorCode
+from ..fetch import fetch_checkout_lines
+
+
+def _birthday_for_age(site_settings, years):
+    """Return the 1st of the current month `years` ago, in the shop time zone."""
+    today = today_in_shop_tz(site_settings.time_zone)
+    return date(today.year - years, today.month, 1)
+
+
+@pytest.fixture
+def restricted_lines(checkout_with_item):
+    product = checkout_with_item.lines.first().variant.product
+    product.is_age_restricted = True
+    product.save(update_fields=["is_age_restricted"])
+    lines, _ = fetch_checkout_lines(checkout_with_item)
+    return lines
+
+
+@pytest.fixture
+def plain_lines(checkout_with_item):
+    lines, _ = fetch_checkout_lines(checkout_with_item)
+    return lines
+
+
+def test_no_restricted_line_guest_passes(plain_lines, site_settings):
+    validate_age_restriction(plain_lines, None, site_settings)
+
+
+def test_no_restricted_line_without_birthday_passes(
+    plain_lines, customer_user, site_settings
+):
+    customer_user.birthday = None
+
+    validate_age_restriction(plain_lines, customer_user, site_settings)
+
+
+def test_empty_lines_pass(site_settings):
+    validate_age_restriction([], None, site_settings)
+
+
+def test_guest_login_required(restricted_lines, site_settings):
+    with pytest.raises(AgeRestrictionError) as exc:
+        validate_age_restriction(restricted_lines, None, site_settings)
+
+    assert exc.value.code == CheckoutErrorCode.AGE_RESTRICTION_LOGIN_REQUIRED
+    assert str(exc.value) == "Sign in to buy age-restricted products."
+
+
+def test_birthday_required(restricted_lines, customer_user, site_settings):
+    customer_user.birthday = None
+
+    with pytest.raises(AgeRestrictionError) as exc:
+        validate_age_restriction(restricted_lines, customer_user, site_settings)
+
+    assert exc.value.code == CheckoutErrorCode.AGE_RESTRICTION_BIRTHDAY_REQUIRED
+
+
+def test_underage(restricted_lines, customer_user, site_settings):
+    customer_user.birthday = _birthday_for_age(site_settings, 10)
+
+    with pytest.raises(AgeRestrictionError) as exc:
+        validate_age_restriction(restricted_lines, customer_user, site_settings)
+
+    assert exc.value.code == CheckoutErrorCode.AGE_RESTRICTION_UNDERAGE
+    assert str(customer_user.birthday.year) not in str(exc.value)
+
+
+def test_eligible(restricted_lines, customer_user, site_settings):
+    customer_user.birthday = _birthday_for_age(site_settings, 30)
+
+    validate_age_restriction(restricted_lines, customer_user, site_settings)
+
+
+def test_turning_minimum_age_today_is_eligible(
+    restricted_lines, customer_user, site_settings
+):
+    today = date(2026, 6, 15)
+    site_settings.minimum_age = 20
+    customer_user.birthday = date(2006, 6, 15)
+
+    validate_age_restriction(
+        restricted_lines, customer_user, site_settings, today=today
+    )
+
+
+def test_day_before_minimum_age_is_underage(
+    restricted_lines, customer_user, site_settings
+):
+    today = date(2026, 6, 14)
+    site_settings.minimum_age = 20
+    customer_user.birthday = date(2006, 6, 15)
+
+    with pytest.raises(AgeRestrictionError) as exc:
+        validate_age_restriction(
+            restricted_lines, customer_user, site_settings, today=today
+        )
+
+    assert exc.value.code == CheckoutErrorCode.AGE_RESTRICTION_UNDERAGE
+
+
+def test_minimum_age_raised_makes_user_underage(
+    restricted_lines, customer_user, site_settings
+):
+    customer_user.birthday = _birthday_for_age(site_settings, 20)
+    site_settings.minimum_age = 21
+
+    with pytest.raises(AgeRestrictionError) as exc:
+        validate_age_restriction(restricted_lines, customer_user, site_settings)
+
+    assert exc.value.code == CheckoutErrorCode.AGE_RESTRICTION_UNDERAGE
+
+
+def test_shop_time_zone_is_used(restricted_lines, customer_user, site_settings):
+    now = datetime(2026, 6, 14, 23, 30, tzinfo=UTC)
+    site_settings.minimum_age = 18
+    # UTC date is 2026-06-14, Pacific/Kiritimati date is 2026-06-15.
+    customer_user.birthday = date(2008, 6, 15)
+
+    utc_today = today_in_shop_tz("UTC", now)
+    kiritimati_today = today_in_shop_tz("Pacific/Kiritimati", now)
+    assert (utc_today, kiritimati_today) == (date(2026, 6, 14), date(2026, 6, 15))
+
+    with pytest.raises(AgeRestrictionError) as exc:
+        validate_age_restriction(
+            restricted_lines, customer_user, site_settings, today=utc_today
+        )
+    assert exc.value.code == CheckoutErrorCode.AGE_RESTRICTION_UNDERAGE
+    validate_age_restriction(
+        restricted_lines, customer_user, site_settings, today=kiritimati_today
+    )
