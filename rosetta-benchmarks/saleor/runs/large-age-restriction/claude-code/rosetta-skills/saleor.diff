+
+def customer_birthday_viewed_event(*, actor: User, subject_id: int) -> CustomerEvent:
+    return CustomerEvent.objects.create(
+        user=actor,
+        type=CustomerEvents.BIRTHDAY_VIEWED,
+        parameters={"account_id": subject_id, "actor_id": actor.pk},
+    )
+
