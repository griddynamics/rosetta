index 0000000..59424f7
--- /dev/null
+++ b/saleor/graphql/account/tests/mutations/account/test_account_birthday.py
@@ -0,0 +1,464 @@
+from datetime import date, timedelta
+from unittest.mock import patch
+
+import graphene
+import pytest
+from django.db import connection
+from django.test.utils import CaptureQueriesContext
+from django.utils import timezone
+from freezegun import freeze_time
+
+from ......account import CustomerEvents
+from ......account.age import today_in_shop_tz
+from ......account.models import CustomerEvent, User
+from .....tests.utils import get_graphql_content, get_graphql_content_from_response
+
+BIRTHDAY = date(1990, 5, 17)
+
+ACCOUNT_UPDATE_MUTATION = """
+mutation accountUpdate($input: AccountInput!, $customerId: ID) {
+  accountUpdate(input: $input, customerId: $customerId) {
+    errors {
+      field
+      code
+      message
+    }
+    user {
+      birthday
+    }
+  }
+}
+"""
+
+ACCOUNT_REGISTER_MUTATION = """
+mutation RegisterAccount($input: AccountRegisterInput!) {
+  accountRegister(input: $input) {
+    errors {
+      field
+      code
+      message
+    }
+  }
+}
+"""
+
+
+def _birthday_events(user):
+    return list(
+        CustomerEvent.objects.filter(
+            user=user, type=CustomerEvents.BIRTHDAY_CHANGED
+        ).order_by("pk")
+    )
+
+
+def _assert_event_has_no_value(event, actor_pk, actor_type):
+    assert event.parameters == {
+        "actor_type": actor_type,
+        "actor_id": actor_pk,
+        "action": "change",
+    }
+    assert "message" not in event.parameters
+    assert event.app is None
+    assert event.order is None
+    assert event.date <= timezone.now()
+
+
+def _update(api_client, birthday, **kwargs):
+    return api_client.post_graphql(
+        ACCOUNT_UPDATE_MUTATION, {"input": {"birthday": birthday}, **kwargs}
+    )
+
+
+# --- accountUpdate ---------------------------------------------------------
+
+
+def test_account_update_sets_birthday_and_logs_event(user_api_client, customer_user):
+    # given
+    assert customer_user.birthday is None
+
+    # when
+    response = _update(user_api_client, BIRTHDAY.isoformat())
+
+    # then
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+    assert not data["errors"]
+    assert data["user"]["birthday"] == BIRTHDAY.isoformat()
+    customer_user.refresh_from_db()
+    assert customer_user.birthday == BIRTHDAY
+    events = _birthday_events(customer_user)
+    assert len(events) == 1
+    _assert_event_has_no_value(events[0], customer_user.pk, "customer")
+
+
+def test_account_update_changes_and_clears_birthday(user_api_client, customer_user):
+    # given
+    customer_user.birthday = BIRTHDAY
+    customer_user.save(update_fields=["birthday"])
+
+    # when
+    changed = _update(user_api_client, date(1991, 1, 2).isoformat())
+    cleared = _update(user_api_client, None)
+
+    # then
+    assert not get_graphql_content(changed)["data"]["accountUpdate"]["errors"]
+    data = get_graphql_content(cleared)["data"]["accountUpdate"]
+    assert not data["errors"]
+    assert data["user"]["birthday"] is None
+    customer_user.refresh_from_db()
+    assert customer_user.birthday is None
+    assert len(_birthday_events(customer_user)) == 2
+
+
+def test_account_update_unchanged_birthday_logs_nothing(user_api_client, customer_user):
+    # given
+    customer_user.birthday = BIRTHDAY
+    customer_user.save(update_fields=["birthday"])
+
+    # when
+    response = _update(user_api_client, BIRTHDAY.isoformat())
+
+    # then
+    assert not get_graphql_content(response)["data"]["accountUpdate"]["errors"]
+    assert not _birthday_events(customer_user)
+
+
+def test_account_update_clearing_empty_birthday_logs_nothing(
+    user_api_client, customer_user
+):
+    # when
+    response = _update(user_api_client, None)
+
+    # then
+    assert not get_graphql_content(response)["data"]["accountUpdate"]["errors"]
+    assert not _birthday_events(customer_user)
+
+
+def test_account_update_without_birthday_key_keeps_value(
+    user_api_client, customer_user
+):
+    # given
+    customer_user.birthday = BIRTHDAY
+    customer_user.save(update_fields=["birthday"])
+
+    # when
+    response = user_api_client.post_graphql(
+        ACCOUNT_UPDATE_MUTATION, {"input": {"firstName": "Renamed"}}
+    )
+
+    # then
+    assert not get_graphql_content(response)["data"]["accountUpdate"]["errors"]
+    customer_user.refresh_from_db()
+    assert customer_user.birthday == BIRTHDAY
+    assert not _birthday_events(customer_user)
+
+
+def test_account_update_birthday_triggers_customer_updated_webhook(
+    user_api_client, customer_user
+):
+    # when
+    with patch("saleor.plugins.manager.PluginsManager.customer_updated") as mocked:
+        response = _update(user_api_client, BIRTHDAY.isoformat())
+
+    # then
+    assert not get_graphql_content(response)["data"]["accountUpdate"]["errors"]
+    mocked.assert_called_once()
+
+
+@pytest.mark.parametrize(
+    "offset_days",
+    [1, 365],
+)
+def test_account_update_future_birthday_is_invalid(
+    offset_days, user_api_client, customer_user, site_settings
+):
+    # given
+    future = today_in_shop_tz(site_settings.time_zone) + timedelta(days=offset_days)
+
+    # when
+    response = _update(user_api_client, future.isoformat())
+
+    # then
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+    assert [(e["field"], e["code"]) for e in data["errors"]] == [
+        ("birthday", "INVALID")
+    ]
+    assert future.isoformat() not in data["errors"][0]["message"]
+    customer_user.refresh_from_db()
+    assert customer_user.birthday is None
+    assert not _birthday_events(customer_user)
+
+
+def test_account_update_today_birthday_is_valid(
+    user_api_client, customer_user, site_settings
+):
+    # given
+    today = today_in_shop_tz(site_settings.time_zone)
+
+    # when
+    response = _update(user_api_client, today.isoformat())
+
+    # then
+    assert not get_graphql_content(response)["data"]["accountUpdate"]["errors"]
+
+
+@pytest.mark.parametrize(
+    ("value", "valid"),
+    [("1899-12-31", False), ("1900-01-01", True)],
+)
+def test_account_update_lower_birthday_bound(
+    value, valid, user_api_client, customer_user
+):
+    # when
+    response = _update(user_api_client, value)
+
+    # then
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+    if valid:
+        assert not data["errors"]
+    else:
+        assert [e["code"] for e in data["errors"]] == ["INVALID"]
+        assert value not in data["errors"][0]["message"]
+
+
+@pytest.mark.parametrize(
+    ("time_zone", "valid"), [("Pacific/Kiritimati", True), ("UTC", False)]
+)
+def test_account_update_uses_shop_time_zone_for_today(
+    time_zone, valid, user_api_client, customer_user, site_settings
+):
+    # given - 23:30 UTC on June 14 is already June 15 in Kiritimati (UTC+14)
+    site_settings.time_zone = time_zone
+    site_settings.save(update_fields=["time_zone"])
+
+    # when
+    with freeze_time("2026-06-14T23:30:00+00:00"):
+        response = _update(user_api_client, "2026-06-15")
+
+    # then
+    errors = get_graphql_content(response)["data"]["accountUpdate"]["errors"]
+    assert (not errors) is valid
+
+
+def test_account_update_app_impersonation_with_birthday_is_denied(
+    app_api_client, customer_user, permission_impersonate_user
+):
+    # given
+    customer_id = graphene.Node.to_global_id("User", customer_user.pk)
+
+    # when
+    response = app_api_client.post_graphql(
+        ACCOUNT_UPDATE_MUTATION,
+        {"input": {"birthday": BIRTHDAY.isoformat()}, "customerId": customer_id},
+        permissions=[permission_impersonate_user],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+    assert [(e["field"], e["code"]) for e in data["errors"]] == [
+        ("birthday", "PERMISSION_DENIED")
+    ]
+    customer_user.refresh_from_db()
+    assert customer_user.birthday is None
+    assert not _birthday_events(customer_user)
+
+
+def test_account_update_app_impersonation_with_null_birthday_is_denied(
+    app_api_client, customer_user, permission_impersonate_user
+):
