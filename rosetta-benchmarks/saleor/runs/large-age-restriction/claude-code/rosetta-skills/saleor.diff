+"""Shared helpers for the customer birthday (personal data) in the GraphQL API.
+
+The birthday value is never logged, echoed in errors or stored in events.
+"""
+
+from collections.abc import Callable
+from datetime import date
+from typing import TYPE_CHECKING, Literal
+
+from django.core.exceptions import ValidationError
+
+from ...account import models
+from ...account.age import today_in_shop_tz, validate_birthday
+from ...account.age_audit import log_birthday_changed, log_birthday_read
+from ...account.error_codes import AccountErrorCode
+from ...app.models import App
+from ..site.dataloaders import get_site_promise
+from ..utils import get_user_or_app_from_context, requestor_is_superuser
+
+if TYPE_CHECKING:
+    from ..core import ResolveInfo
+
+BIRTHDAY_FIELD = "birthday"
+AUDIT_DEDUP_ATTR = "_age_audit_logged"
+
+
+def clean_birthday_input(
+    info: "ResolveInfo", data: dict, *, superuser_only: bool
+) -> None:
+    """Check permission to write the birthday and validate its value.
+
+    `superuser_only=True` is used by staff mutations, otherwise only the owner
+    (never an app, not even an impersonating one) can write the value.
+    """
+    if BIRTHDAY_FIELD not in data:
+        return
+    requestor = get_user_or_app_from_context(info.context)
+    if (
+        isinstance(requestor, App)
+        or requestor is None
+        or (superuser_only and not requestor_is_superuser(requestor))
+    ):
+        raise ValidationError(
+            {
+                BIRTHDAY_FIELD: ValidationError(
+                    "You do not have permission to change the birthday.",
+                    code=AccountErrorCode.PERMISSION_DENIED.value,
+                )
+            }
+        )
+    birthday = data[BIRTHDAY_FIELD]
+    if birthday is None:
+        return
+    validate_birthday_for_shop(info, birthday)
+
+
+def validate_birthday_for_shop(info: "ResolveInfo", birthday: date) -> None:
+    site = get_site_promise(info.context).get()
+    today = today_in_shop_tz(site.settings.time_zone)
+    try:
+        validate_birthday(birthday, today)
+    except ValueError:
+        # the message intentionally does not contain the value
+        raise ValidationError(
+            {
+                BIRTHDAY_FIELD: ValidationError(
+                    "Invalid birthday.", code=AccountErrorCode.INVALID.value
+                )
+            }
+        ) from None
+
+
+def log_birthday_change_if_modified(
+    info: "ResolveInfo",
+    customer: models.User,
+    previous_value: date | None,
+    actor_type: Literal["customer", "staff"] | None = None,
+) -> None:
+    """Write the audit event when the birthday differs from `previous_value`."""
+    if customer.birthday == previous_value:
+        return
+    actor = get_user_or_app_from_context(info.context)
+    if actor is None:
+        return
+    log_birthday_changed(customer=customer, actor=actor, actor_type=actor_type)
+
+
+def log_non_owner_read_once(
+    info: "ResolveInfo",
+    customer: models.User,
+    actor: models.User,
+    kind: Literal["birthday", "eligibility"],
+) -> None:
+    """Write at most one read event per (customer, kind) for the request.
+
+    Any failure propagates, so the caller does not return the value (fail closed).
+    """
+    logged: set = getattr(info.context, AUDIT_DEDUP_ATTR, None) or set()
+    key = (customer.pk, kind)
+    if key in logged:
+        return
+    log_birthday_read(customer=customer, actor=actor, kind=kind)
+    logged.add(key)
+    setattr(info.context, AUDIT_DEDUP_ATTR, logged)
+
+
+def resolve_with_audit(
+    info: "ResolveInfo",
+    customer: models.User,
+    kind: Literal["birthday", "eligibility"],
+    allowed: Callable[[models.User], bool],
+):
+    """Return True when the requestor may read the value, logging non-owner reads."""
+    if getattr(customer, "NEWLY_CREATED_USER", False):
+        return False
+    requestor = get_user_or_app_from_context(info.context)
+    if not isinstance(requestor, models.User) or not requestor.pk:
+        return False
+    if requestor.pk == customer.pk:
+        return True
+    if not allowed(requestor):
+        return False
+    log_non_owner_read_once(info, customer, requestor, kind)
+    return True
