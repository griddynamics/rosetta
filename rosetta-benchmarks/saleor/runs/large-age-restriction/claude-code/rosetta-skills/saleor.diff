+"""Audit writers for birthday related events.
+
+Events never store the birthday value nor a free-text message.
+"""
+
+from typing import Literal
+
+from ..app.models import App
+from ..core.db.connection import allow_writer
+from . import CustomerEvents
+from .models import CustomerEvent, User
+
+ActorType = Literal["customer", "staff", "app"]
+
+
+def _actor_parameters(
+    customer: User, actor: User | App, actor_type: ActorType | None = None
+) -> dict:
+    if isinstance(actor, App):
+        return {"actor_type": "app", "actor_id": actor.pk}
+    if actor_type is None:
+        actor_type = "customer" if actor.pk == customer.pk else "staff"
+    return {"actor_type": actor_type, "actor_id": actor.pk}
+
+
+def log_birthday_changed(
+    *,
+    customer: User,
+    actor: User | App,
+    actor_type: ActorType | None = None,
+) -> CustomerEvent:
+    """Log a birthday change.
+
+    `actor_type` is inferred (owner -> customer, otherwise staff) when omitted;
+    callers that know the context should pass it explicitly.
+    """
+    with allow_writer():
+        return CustomerEvent.objects.create(
+            user=customer,
+            app=None,
+            order=None,
+            type=CustomerEvents.BIRTHDAY_CHANGED,
+            parameters={
+                **_actor_parameters(customer, actor, actor_type),
+                "action": "change",
+            },
+        )
+
+
+def log_birthday_read(
+    *, customer: User, actor: User, kind: Literal["birthday", "eligibility"]
+) -> CustomerEvent:
+    event_type = (
+        CustomerEvents.BIRTHDAY_VIEWED
+        if kind == "birthday"
+        else CustomerEvents.AGE_ELIGIBILITY_VIEWED
+    )
+    with allow_writer():
+        return CustomerEvent.objects.create(
+            user=customer,
+            app=None,
+            order=None,
+            type=event_type,
+            parameters={
+                **_actor_parameters(customer, actor),
+                "action": "read",
+                "kind": kind,
+            },
+        )
