+def test_access_token_claims_have_no_birthday(user_with_birthday):
+    token = create_access_token(user_with_birthday)
+
+    claims = jwt_decode(token)
+
+    assert "birthday" not in claims
+    assert BIRTHDAY not in json.dumps(claims, default=str)
