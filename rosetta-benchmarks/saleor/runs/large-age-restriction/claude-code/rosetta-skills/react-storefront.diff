+import { describe, expect, it } from "vitest";
+
+import {
+	ageRestrictionAction,
+	ageRestrictionMessageKey,
+	buildAgeRestrictionMessage,
+	findAgeRestrictionCode,
+	formatProductNames,
+	isAgeRestrictionCode,
+	type AgeMessageTranslate,
+} from "./age-restriction-errors";
+
+/** Echoes key and values so assertions see exactly what the copy would interpolate. */
+const translate: AgeMessageTranslate = (key, values) =>
+	`${key}${
+		values
+			? `|${Object.entries(values)
+					.map(([k, v]) => `${k}=${v}`)
+					.join("|")}`
+			: ""
+	}`;
+
+describe("code classification", () => {
+	it("recognizes only the four age codes", () => {
+		expect(isAgeRestrictionCode("AGE_RESTRICTED_UNDERAGE")).toBe(true);
+		expect(isAgeRestrictionCode("INSUFFICIENT_STOCK")).toBe(false);
+		expect(isAgeRestrictionCode(undefined)).toBe(false);
+	});
+
+	it("maps each code to its message key", () => {
+		expect(ageRestrictionMessageKey("AGE_RESTRICTED_LOGIN_REQUIRED")).toBe("ageLoginRequired");
+		expect(ageRestrictionMessageKey("AGE_RESTRICTED_BIRTHDAY_REQUIRED")).toBe("ageBirthdayRequired");
+		expect(ageRestrictionMessageKey("AGE_RESTRICTED_UNDERAGE")).toBe("ageUnderage");
+		expect(ageRestrictionMessageKey("AGE_RESTRICTED_NOT_ELIGIBLE")).toBe("ageNotEligible");
+		expect(ageRestrictionMessageKey("INVALID")).toBeNull();
+	});
+
+	it("offers sign-in for guests and account settings for a missing birthday only", () => {
+		expect(ageRestrictionAction("AGE_RESTRICTED_LOGIN_REQUIRED")).toBe("sign-in");
+		expect(ageRestrictionAction("AGE_RESTRICTED_BIRTHDAY_REQUIRED")).toBe("account-settings");
+		expect(ageRestrictionAction("AGE_RESTRICTED_UNDERAGE")).toBeNull();
+		expect(ageRestrictionAction("AGE_RESTRICTED_NOT_ELIGIBLE")).toBeNull();
+	});
+
+	it("finds the first age code among field errors", () => {
+		expect(findAgeRestrictionCode([{ code: "INVALID" }, { code: "AGE_RESTRICTED_NOT_ELIGIBLE" }])).toBe(
+			"AGE_RESTRICTED_NOT_ELIGIBLE",
+		);
+		expect(findAgeRestrictionCode([{ code: "INVALID" }])).toBeNull();
+		expect(findAgeRestrictionCode(undefined)).toBeNull();
+	});
+});
+
+describe("formatProductNames", () => {
+	it("sorts, dedupes and quotes names", () => {
+		expect(formatProductNames(["Whisky", "Cider", "Whisky"], translate)).toBe("“Cider”, “Whisky”");
+	});
+
+	it("collapses beyond three names into a count", () => {
+		const out = formatProductNames(["E", "D", "C", "B", "A"], translate);
+		expect(out).toContain("ageProductsMore");
+		expect(out).toContain("count=2");
+		expect(out).toContain("“A”");
+		expect(out).not.toContain("“D”");
+	});
+
+	it("returns an empty string for no names", () => {
+		expect(formatProductNames([], translate)).toBe("");
+	});
+});
+
+describe("buildAgeRestrictionMessage", () => {
+	const lines = [
+		{ id: "l1", productName: "Whisky", ageLabel: "18+" },
+		{ id: "l2", productName: "T-shirt", ageLabel: null },
+		{ id: "l3", productName: "Cider", ageLabel: "18+" },
+	];
+
+	it("names only the lines listed on the error", () => {
+		const out = buildAgeRestrictionMessage({
+			code: "AGE_RESTRICTED_LOGIN_REQUIRED",
+			errorLineIds: ["l1"],
+			lines,
+			translate,
+		});
+		expect(out).toContain("ageLoginRequired");
+		expect(out).toContain("Whisky");
+		expect(out).not.toContain("Cider");
+		expect(out).not.toContain("T-shirt");
+	});
+
+	it("falls back to every age-labelled line when the error lists none", () => {
+		const out = buildAgeRestrictionMessage({
+			code: "AGE_RESTRICTED_BIRTHDAY_REQUIRED",
+			errorLineIds: [],
+			lines,
+			translate,
+		});
+		expect(out).toContain("Cider");
+		expect(out).toContain("Whisky");
+		expect(out).not.toContain("T-shirt");
+	});
+
+	it("includes the minimum age for UNDERAGE but never a birthday", () => {
+		const out = buildAgeRestrictionMessage({
+			code: "AGE_RESTRICTED_UNDERAGE",
+			errorLineIds: ["l1"],
+			lines,
+			translate,
+		});
+		expect(out).toContain("ageUnderage|");
+		expect(out).toContain("minimumAge=18");
+		expect(out).not.toMatch(/\d{4}-\d{2}-\d{2}/);
+	});
+
+	it("uses the no-age copy when no label is available", () => {
+		const out = buildAgeRestrictionMessage({
+			code: "AGE_RESTRICTED_UNDERAGE",
+			errorLineIds: ["l2"],
+			lines,
+			translate,
+		});
+		expect(out).toContain("ageUnderageNoAge");
+	});
+
+	it("uses the generic NOT_ELIGIBLE copy and a fallback when no product can be named", () => {
+		const out = buildAgeRestrictionMessage({
+			code: "AGE_RESTRICTED_NOT_ELIGIBLE",
+			errorLineIds: ["missing"],
+			lines: [],
+			translate,
+		});
+		expect(out).toContain("ageNotEligible");
+		expect(out).toContain("products=ageProductsFallback");
+	});
+});
diff --git a/src/checkout/lib/age-restriction-errors.ts b/src/checkout/lib/age-restriction-errors.ts
new file mode 100644
index 0000000..f0d9744
--- /dev/null
+++ b/src/checkout/lib/age-restriction-errors.ts
@@ -0,0 +1,133 @@
+/**
+ * Checkout-side mapping for age-restriction errors (MIN-AGE).
+ *
+ * Framework-free. Code classification is shared with the storefront through
+ * `@/lib/age-restriction` (checkout may import `@/lib`; the reverse is banned by
+ * `paper/surface-boundary`). The API stays the authority; these helpers only pick copy and links.
+ */
+import { mapAgeRestrictionError, parseAgeLabel } from "@/lib/age-restriction";
+
+export type AgeRestrictionCode =
+	| "AGE_RESTRICTED_LOGIN_REQUIRED"
+	| "AGE_RESTRICTED_BIRTHDAY_REQUIRED"
+	| "AGE_RESTRICTED_UNDERAGE"
+	| "AGE_RESTRICTED_NOT_ELIGIBLE";
+
+/** Keys under `checkout.server` (server-built messages naming the products). */
+export type AgeRestrictionMessageKey =
+	| "ageLoginRequired"
+	| "ageBirthdayRequired"
+	| "ageUnderage"
+	| "ageNotEligible";
+
+const MESSAGE_KEY_BY_CODE: Record<AgeRestrictionCode, AgeRestrictionMessageKey> = {
+	AGE_RESTRICTED_LOGIN_REQUIRED: "ageLoginRequired",
+	AGE_RESTRICTED_BIRTHDAY_REQUIRED: "ageBirthdayRequired",
+	AGE_RESTRICTED_UNDERAGE: "ageUnderage",
+	AGE_RESTRICTED_NOT_ELIGIBLE: "ageNotEligible",
+};
+
+export function isAgeRestrictionCode(code: string | null | undefined): code is AgeRestrictionCode {
+	return mapAgeRestrictionError(code) !== null;
+}
+
+/** i18n key for a checkout error code; null when the code is not age-related. */
+export function ageRestrictionMessageKey(code: string | null | undefined): AgeRestrictionMessageKey | null {
+	return isAgeRestrictionCode(code) ? MESSAGE_KEY_BY_CODE[code] : null;
+}
+
+/** Where the shopper can fix the problem; null when only a message applies. */
+export type AgeRestrictionAction = "sign-in" | "account-settings";
+
+export function ageRestrictionAction(code: string | null | undefined): AgeRestrictionAction | null {
+	switch (code) {
+		case "AGE_RESTRICTED_LOGIN_REQUIRED":
+			return "sign-in";
+		case "AGE_RESTRICTED_BIRTHDAY_REQUIRED":
+			return "account-settings";
+		default:
+			return null;
+	}
+}
+
+/** First age-restriction code among checkout field errors, if any. */
+export function findAgeRestrictionCode(
+	errors: ReadonlyArray<{ code?: string | null }> | null | undefined,
+): AgeRestrictionCode | null {
+	for (const error of errors ?? []) {
+		if (isAgeRestrictionCode(error.code)) return error.code;
+	}
+	return null;
+}
+
+const MAX_NAMED_PRODUCTS = 3;
+
+/**
+ * Distinct, sorted product names; beyond three the rest collapse into a count.
+ * `translate` is injected so this stays free of i18n runtimes.
+ */
+export function formatProductNames(names: ReadonlyArray<string>, translate: AgeMessageTranslate): string {
+	const unique = [...new Set(names.map((name) => name.trim()).filter(Boolean))].sort((a, b) =>
+		a.localeCompare(b),
+	);
+	const quoted = unique.slice(0, MAX_NAMED_PRODUCTS).map((name) => `“${name}”`);
+	const joined = quoted.join(", ");
+	const rest = unique.length - quoted.length;
+	return rest > 0 ? translate("ageProductsMore", { names: joined, count: rest }) : joined;
+}
+
+/** Numeric minimum age from a public `ageLabel` such as "18+". */
+export const minimumAgeFromLabel = parseAgeLabel;
+
+export type AgeServerMessageKey =
+	| AgeRestrictionMessageKey
+	| "ageUnderageNoAge"
+	| "ageProductsMore"
+	| "ageProductsFallback";
+
+export type AgeMessageTranslate = (
+	key: AgeServerMessageKey,
+	values?: Record<string, string | number>,
+) => string;
+
+export type AgeRestrictedLineInfo = {
+	id: string;
+	/** Display name of the product on the line (translated when available). */
+	productName: string;
+	ageLabel?: string | null;
+};
+
+/**
+ * Shopper-facing sentence for a completion error: names the blocking products and never
+ * contains a birthday or age. When the error lists line ids, only those lines are named;
+ * otherwise every age-labelled line is.
+ */
+export function buildAgeRestrictionMessage({
+	code,
+	errorLineIds,
+	lines,
+	translate,
+}: {
+	code: AgeRestrictionCode;
+	errorLineIds?: ReadonlyArray<string> | null;
+	lines: ReadonlyArray<AgeRestrictedLineInfo>;
+	translate: AgeMessageTranslate;
+}): string {
+	const ids = new Set(errorLineIds ?? []);
+	const blocking =
+		ids.size > 0 ? lines.filter((line) => ids.has(line.id)) : lines.filter((line) => line.ageLabel);
+	const named = formatProductNames(
+		blocking.map((line) => line.productName),
+		translate,
+	);
+	const products = named || translate("ageProductsFallback");
+
+	if (code === "AGE_RESTRICTED_UNDERAGE") {
+		const minimumAge = blocking.map((line) => minimumAgeFromLabel(line.ageLabel)).find((age) => age !== null);
+		return minimumAge
+			? translate("ageUnderage", { products, minimumAge })
+			: translate("ageUnderageNoAge", { products });
+	}
+
+	return translate(MESSAGE_KEY_BY_CODE[code], { products });
+}
