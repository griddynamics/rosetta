@@ -0,0 +1,90 @@
+import { readdirSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+
+const MESSAGES_DIR = join(import.meta.dirname, "../../messages");
+
+/** Every string introduced by the MIN-AGE feature; each shipped locale must define all of them. */
+const AGE_KEYS = [
+	"account.fields.birthday",
+	"account.settings.birthdayHelp",
+	"account.settings.birthdayClear",
+	"account.errors.updateBirthdayFailed",
+	"account.errors.birthdayInvalid",
+	"account.errors.loadBirthdayFailed",
+	"pdp.badges.ageRestricted",
+	"pdp.ageRestrictedHint",
+	"pdp.ageLoginRequired",
+	"pdp.ageSignInLink",
+	"pdp.ageBirthdayRequired",
+	"pdp.ageBirthdayLink",
+	"pdp.ageUnderage",
+	"pdp.ageUnderageNoAge",
+	"pdp.ageNotEligible",
+	"pdp.addToCartFailed",
+	"checkout.summary.ageRestricted",
+	"checkout.errors.ageErrorTitle",
+	"checkout.errors.ageSignInLink",
+	"checkout.errors.ageBirthdayLink",
+	"checkout.server.ageLoginRequired",
+	"checkout.server.ageBirthdayRequired",
+	"checkout.server.ageUnderage",
+	"checkout.server.ageUnderageNoAge",
+	"checkout.server.ageNotEligible",
+	"checkout.server.ageProductsMore",
+	"checkout.server.ageProductsFallback",
+];
+
+type Tree = { [key: string]: string | Tree };
+
+function load(locale: string): Tree {
+	return JSON.parse(readFileSync(join(MESSAGES_DIR, `${locale}.json`), "utf8")) as Tree;
+}
+
+function lookup(tree: Tree, path: string): string | undefined {
+	let node: string | Tree | undefined = tree;
+	for (const part of path.split(".")) {
+		if (typeof node !== "object" || node === null) return undefined;
+		node = node[part];
+	}
+	return typeof node === "string" ? node : undefined;
+}
+
+function placeholders(message: string): string[] {
+	return [...message.matchAll(/\{(\w+)\}/g)].map((match) => match[1]!).sort();
+}
+
+const locales = readdirSync(MESSAGES_DIR)
+	.filter((file) => file.endsWith(".json"))
+	.map((file) => file.replace(/\.json$/, ""));
+
+describe("age-restriction messages", () => {
+	it("ships every locale the repo has", () => {
+		expect(locales.sort()).toEqual(["de", "en", "fi", "fr", "ja", "ko", "nb", "pl"]);
+	});
+
+	const en = load("en");
+
+	describe.each(locales)("%s", (locale) => {
+		const messages = load(locale);
+
+		it("defines every age-restriction key", () => {
+			const missing = AGE_KEYS.filter((key) => !lookup(messages, key)?.trim());
+			expect(missing).toEqual([]);
+		});
+
+		it("uses the same placeholders as English", () => {
+			for (const key of AGE_KEYS) {
+				expect(placeholders(lookup(messages, key) ?? ""), `${locale}:${key}`).toEqual(
+					placeholders(lookup(en, key) ?? ""),
+				);
+			}
+		});
+
+		it("never embeds a date in copy", () => {
+			for (const key of AGE_KEYS.filter((k) => !k.endsWith("birthdayInvalid"))) {
+				expect(lookup(messages, key) ?? "", `${locale}:${key}`).not.toMatch(/\d{4}-\d{2}-\d{2}/);
+			}
+		});
+	});
+});
