+"use client";
+
+import { type FC } from "react";
+import { useTranslations } from "next-intl";
+import { ageRestrictionAction } from "@/checkout/lib/age-restriction-errors";
+import { useCheckoutBrowseLocale } from "@/checkout/providers/checkout-browse";
+import { buildStorefrontPath } from "@/lib/storefront-path";
+
+type AgeRestrictionActionProps = {
+	code: string;
+	channel: string;
+};
+
+/**
+ * Link that fixes an age-restriction refusal: sign in (guest) or add a birthday in account
+ * settings. Built as a plain URL — checkout does not import storefront modules.
+ */
+export const AgeRestrictionAction: FC<AgeRestrictionActionProps> = ({ code, channel }) => {
+	const t = useTranslations("checkout.errors");
+	const locale = useCheckoutBrowseLocale();
+	const action = ageRestrictionAction(code);
+
+	if (!action) {
+		return null;
+	}
+
+	const href =
+		action === "sign-in"
+			? buildStorefrontPath(locale, channel, "/login")
+			: buildStorefrontPath(locale, channel, "/account/settings");
+
+	return (
+		<a
+			href={href}
+			className="mt-2 inline-block text-sm font-medium underline"
+			data-testid="age-restriction-action"
+		>
+			{action === "sign-in" ? t("ageSignInLink") : t("ageBirthdayLink")}
+		</a>
+	);
+};
