+import { formatVariablesForLog } from "./client";
+
+describe("formatVariablesForLog", () => {
+	it("formats short variables as before", () => {
+		expect(formatVariablesForLog({ id: "abc", first: 3, skip: undefined, none: null })).toBe(
+			"(id=abc, first=3)",
+		);
+		expect(formatVariablesForLog({})).toBe("");
+	});
+
+	it("redacts a top-level birthday", () => {
+		const out = formatVariablesForLog({ birthday: "2008-10-22" });
+		expect(out).toBe("(birthday=[redacted])");
+		expect(out).not.toContain("2008");
+	});
+
+	it("redacts a nested birthday at any depth, case-insensitively", () => {
+		const out = formatVariablesForLog({ input: { birthday: "2008-10-22" } });
+		expect(out).not.toContain("2008");
+		expect(out).toContain("[redacted]");
+
+		const deep = formatVariablesForLog({ a: [{ b: { Birthday: "1990-01-02" } }] });
+		expect(deep).not.toContain("1990");
+		expect(deep).toContain("[redacted]");
+	});
+
+	it("redacts a cleared (null) nested birthday too", () => {
+		expect(formatVariablesForLog({ b: { birthday: null } })).toContain("[redacted]");
+	});
+
+	it("leaves non-birthday keys readable", () => {
+		expect(formatVariablesForLog({ input: { firstName: "Ann" } })).toContain("Ann");
+	});
+});
