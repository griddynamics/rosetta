+import { describe, expect, it } from "vitest";
+
+import { buildCheckoutCompleteFailure } from "./checkout-complete-errors";
+
+const copy = {
+	fallback: "Failed to complete order",
+	ageMessage: (key: string) => `localized:${key}`,
+};
+
+describe("buildCheckoutCompleteFailure", () => {
+	it.each([
+		["AGE_RESTRICTION_LOGIN_REQUIRED", "ageLoginRequired"],
+		["AGE_RESTRICTION_BIRTHDAY_REQUIRED", "ageBirthdayRequired"],
+		["AGE_RESTRICTION_UNDERAGE", "ageUnderage"],
+	])("replaces the backend message for %s with localized copy", (code, key) => {
+		const failure = buildCheckoutCompleteFailure(
+			[{ field: "lines", message: "RAW BACKEND TEXT", code }],
+			copy,
+		);
+
+		expect(failure.error).toBe(`localized:${key}`);
+		expect(failure.ageRestriction).toBe(key);
+		expect(failure.fieldErrors).toEqual([{ field: "lines", message: "", code }]);
+		expect(JSON.stringify(failure)).not.toContain("RAW");
+		expect(failure.error).not.toContain("RAW");
+	});
+
+	it("keeps the backend message and no age key for other errors", () => {
+		const failure = buildCheckoutCompleteFailure(
+			[{ field: null, message: "Payment not covered", code: "CHECKOUT_NOT_FULLY_PAID" }],
+			copy,
+		);
+		expect(failure.error).toBe("Payment not covered");
+		expect(failure).not.toHaveProperty("ageRestriction");
+	});
+
+	it("falls back when the backend sends no message", () => {
+		const failure = buildCheckoutCompleteFailure([{ field: null, message: null, code: "INVALID" }], copy);
+		expect(failure.error).toBe("Failed to complete order");
+		expect(failure.fieldErrors[0]?.message).toBe("Failed to complete order");
+	});
+});
diff --git a/src/checkout/lib/payment/checkout-complete-errors.ts b/src/checkout/lib/payment/checkout-complete-errors.ts
new file mode 100644
index 0000000..3ace02d
--- /dev/null
+++ b/src/checkout/lib/payment/checkout-complete-errors.ts
@@ -0,0 +1,37 @@
+import {
+	ageRestrictionErrorKey,
+	firstAgeRestrictionErrorKey,
+	type AgeRestrictionErrorKey,
+} from "@/lib/age-restriction";
+import type { CheckoutFieldError } from "@/checkout/lib/checkout-action-types";
+
+export type CheckoutCompleteFailure = {
+	ok: false;
+	error: string;
+	fieldErrors: CheckoutFieldError[];
+	/** Set when Saleor blocked completion for an age-restriction reason. */
+	ageRestriction?: AgeRestrictionErrorKey;
+};
+
+/**
+ * Failure payload for `checkoutComplete` errors. For age-restriction codes the shopper
+ * message is the localized copy, never the backend `message`.
+ */
+export function buildCheckoutCompleteFailure(
+	errors: ReadonlyArray<{ field?: string | null; message?: string | null; code?: string | null }>,
+	copy: { fallback: string; ageMessage: (key: AgeRestrictionErrorKey) => string },
+): CheckoutCompleteFailure {
+	const ageRestriction = firstAgeRestrictionErrorKey(errors);
+
+	return {
+		ok: false,
+		error: ageRestriction ? copy.ageMessage(ageRestriction) : (errors[0]?.message ?? copy.fallback),
+		fieldErrors: errors.map((error) => ({
+			field: error.field,
+			// Age codes never carry the backend text, so no consumer can leak it.
+			message: ageRestrictionErrorKey(error.code) ? "" : (error.message ?? copy.fallback),
+			code: error.code,
+		})) as CheckoutFieldError[],
+		...(ageRestriction ? { ageRestriction } : {}),
+	};
+}
