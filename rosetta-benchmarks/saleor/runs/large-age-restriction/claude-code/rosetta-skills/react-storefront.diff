+/** Birthday helpers for the account settings form. A birthday is a calendar date (no time zone). */
+
+/** Today's date as `YYYY-MM-DD` in the shopper's local time zone (the `max` of the date input). */
+export function formatDateInputValue(date: Date): string {
+	const year = String(date.getFullYear()).padStart(4, "0");
+	const month = String(date.getMonth() + 1).padStart(2, "0");
+	const day = String(date.getDate()).padStart(2, "0");
+	return `${year}-${month}-${day}`;
+}
+
+/** Display a `YYYY-MM-DD` birthday in the shopper's locale without a time-zone shift. */
+export function formatBirthdayForDisplay(value: string, intlLocale: string): string {
+	const date = new Date(`${value}T00:00:00Z`);
+	if (Number.isNaN(date.getTime())) return value;
+	return date.toLocaleDateString(intlLocale, { dateStyle: "long", timeZone: "UTC" });
+}
+
+const BIRTHDAY_FORMAT = /^\d{4}-\d{2}-\d{2}$/;
+
+/**
+ * Strict calendar check for a `YYYY-MM-DD` birthday: the date must exist (no roll-over such
+ * as 2023-02-31) and must not be after `today` (local calendar date).
+ */
+export function isValidBirthday(value: string, today: Date = new Date()): boolean {
+	if (!BIRTHDAY_FORMAT.test(value)) return false;
+	const [year, month, day] = value.split("-").map(Number) as [number, number, number];
+	const date = new Date(Date.UTC(year, month - 1, day));
+	if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
+		return false;
+	}
+	return value <= formatDateInputValue(today);
+}
