+"use client";
+
+import { useActionState, type ReactNode } from "react";
+import type { CartActionResult } from "@/lib/age-restriction";
+import { AgeRestrictionNotice } from "@/ui/components/age-restriction-notice";
+
+type AddToCartFormProps = {
+	/** Server action: resolves to a result instead of throwing so errors can be shown. */
+	action: (previous: CartActionResult | null) => Promise<CartActionResult>;
+	className?: string;
+	children: ReactNode;
+};
+
+/**
+ * PDP add-to-cart form. Age-restriction failures (sign in / birthday / underage) surface as a
+ * localized message with the follow-up link; other failures stay silent as before.
+ */
+export function AddToCartForm({ action, className, children }: AddToCartFormProps) {
+	const [result, formAction] = useActionState(action, null);
+	const errorKey = result && !result.ok ? result.errorKey : null;
+
+	return (
+		<form action={formAction} className={className}>
+			{children}
+			{errorKey ? <AgeRestrictionNotice errorKey={errorKey} className="space-y-1" /> : null}
+		</form>
+	);
+}
