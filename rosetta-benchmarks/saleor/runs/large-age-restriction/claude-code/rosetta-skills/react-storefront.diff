+/**
+ * Age-restriction helpers shared by the storefront surface (MIN-AGE).
+ *
+ * Pure and framework-free so server actions, client components and tests can all use it.
+ * The API is the authority; this module only classifies its error codes for display.
+ */
+
+/** Why an add-to-cart attempt was refused (storefront-facing vocabulary). */
+export type AddToCartFailureReason =
+	| "AGE_LOGIN_REQUIRED"
+	| "AGE_BIRTHDAY_REQUIRED"
+	| "AGE_UNDERAGE"
+	| "AGE_NOT_ELIGIBLE"
+	| "GENERIC";
+
+export type AgeFailureReason = Exclude<AddToCartFailureReason, "GENERIC">;
+
+export type AddToCartResult = { ok: true } | { ok: false; reason: AddToCartFailureReason; message?: string };
+
+const AGE_REASON_BY_CODE: Record<string, AgeFailureReason> = {
+	AGE_RESTRICTED_LOGIN_REQUIRED: "AGE_LOGIN_REQUIRED",
+	AGE_RESTRICTED_BIRTHDAY_REQUIRED: "AGE_BIRTHDAY_REQUIRED",
+	AGE_RESTRICTED_UNDERAGE: "AGE_UNDERAGE",
+	AGE_RESTRICTED_NOT_ELIGIBLE: "AGE_NOT_ELIGIBLE",
+};
+
+/** Map a Saleor checkout error code to an age-restriction reason; null for unrelated codes. */
+export function mapAgeRestrictionError(code: string | null | undefined): AgeFailureReason | null {
+	if (!code || !Object.hasOwn(AGE_REASON_BY_CODE, code)) return null;
+	return AGE_REASON_BY_CODE[code] ?? null;
+}
+
+/** Read the numeric age from the public `ageLabel` ("18+" -> 18); null when absent or malformed. */
+export function parseAgeLabel(label: string | null | undefined): number | null {
+	if (!label) return null;
+	const match = /^(\d{1,3})\+$/.exec(label.trim());
+	if (!match) return null;
+	const age = Number(match[1]);
+	return age > 0 ? age : null;
+}
+
+/** Public label to display for a product ("18+"); null when unrestricted. Never used to hide anything. */
+export function productAgeLabel(product: { ageLabel?: string | null } | null | undefined): string | null {
+	const label = product?.ageLabel?.trim();
+	return label ? label : null;
+}
+
+const BIRTHDAY_PATTERN = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+export type BirthdayInput = { ok: true; value: string | null } | { ok: false };
+
+/**
+ * Strict `YYYY-MM-DD` parser for the account birthday form.
+ * Empty input means "clear". Impossible calendar dates and future dates are rejected;
+ * the API stays the authority for the upper age bound.
+ */
+export function parseBirthdayInput(raw: string, today: Date = new Date()): BirthdayInput {
+	const trimmed = raw.trim();
+	if (trimmed === "") {
+		return { ok: true, value: null };
+	}
+
+	const match = BIRTHDAY_PATTERN.exec(trimmed);
+	if (!match) return { ok: false };
+
+	const year = Number(match[1]);
+	const month = Number(match[2]);
+	const day = Number(match[3]);
+	const date = new Date(Date.UTC(year, month - 1, day));
+	if (date.getUTCFullYear() !== year || date.getUTCMonth() !== month - 1 || date.getUTCDate() !== day) {
+		return { ok: false };
+	}
+
+	// ISO dates compare lexically. Allow one day of slack for time zones ahead of UTC;
+	// the API applies the exact shop-time-zone check.
+	const latestAllowed = new Date(today.getTime() + 24 * 60 * 60 * 1000).toISOString().slice(0, 10);
+	if (trimmed > latestAllowed) return { ok: false };
+
+	return { ok: true, value: trimmed };
+}
