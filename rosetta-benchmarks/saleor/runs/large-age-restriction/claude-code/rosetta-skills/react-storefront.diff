@@ -0,0 +1,78 @@
+"use client";
+
+import Link from "next/link";
+import { useParams } from "next/navigation";
+import { useTranslations } from "next-intl";
+import { ageRestrictionAction, type AgeRestrictionErrorKey } from "@/lib/age-restriction";
+import { buildStorefrontPath } from "@/lib/storefront-path";
+import { accountRoutes } from "@/ui/components/account/routes";
+
+export type AgeRestrictionNoticeMessages = {
+	message: string;
+	signInLabel: string;
+	accountSettingsLabel: string;
+};
+
+/**
+ * Presentational notice: localized message plus the follow-up link the error calls for
+ * (sign in / account settings / none). Shared by the storefront and the checkout surface,
+ * each of which supplies its own translations and hrefs.
+ */
+export function AgeRestrictionNoticeView({
+	errorKey,
+	messages,
+	signInHref,
+	accountSettingsHref,
+	className,
+}: {
+	errorKey: AgeRestrictionErrorKey;
+	messages: AgeRestrictionNoticeMessages;
+	signInHref: string;
+	accountSettingsHref: string;
+	className?: string;
+}) {
+	const action = ageRestrictionAction(errorKey);
+
+	return (
+		<div role="alert" className={className} data-testid="age-restriction-notice" data-error-key={errorKey}>
+			<p className="text-sm text-destructive">{messages.message}</p>
+			{action === "signIn" ? (
+				<Link href={signInHref} className="text-sm font-medium underline underline-offset-2">
+					{messages.signInLabel}
+				</Link>
+			) : null}
+			{action === "accountSettings" ? (
+				<Link href={accountSettingsHref} className="text-sm font-medium underline underline-offset-2">
+					{messages.accountSettingsLabel}
+				</Link>
+			) : null}
+		</div>
+	);
+}
+
+/** Storefront wrapper: `ageRestriction.*` messages, locale/channel-prefixed links. */
+export function AgeRestrictionNotice({
+	errorKey,
+	className,
+}: {
+	errorKey: AgeRestrictionErrorKey;
+	className?: string;
+}) {
+	const t = useTranslations("ageRestriction");
+	const { locale, channel } = useParams<{ locale?: string; channel?: string }>();
+	const href = (path: string) => (locale && channel ? buildStorefrontPath(locale, channel, path) : path);
+
+	return (
+		<AgeRestrictionNoticeView
+			errorKey={errorKey}
+			messages={{
+				message: t(errorKey),
+				signInLabel: t("signIn"),
+				accountSettingsLabel: t("accountSettings"),
+			}}
+			signInHref={href("/login")}
+			accountSettingsHref={href(accountRoutes.settings)}
+			className={className}
+		/>
+	);
+}
