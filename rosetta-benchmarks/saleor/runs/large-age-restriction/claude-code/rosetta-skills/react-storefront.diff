+/**
+ * "18+" chip for age-restricted products. The age comes from the shop-wide policy
+ * (`AgePolicyProvider`), not from the product. Never hides the product, label only.
+ */
+export function AgeBadge({ className }: { className?: string }) {
+	const t = useTranslations("pdp.badges");
+	const minimumAge = useMinimumAge();
+
+	if (minimumAge === null) return null;
+
+	return (
+		<AgeBadgeView
+			minimumAge={minimumAge}
+			ariaLabel={t("ageRestricted", { minimumAge })}
+			className={className}
+		/>
+	);
+}
