@@ -0,0 +1,68 @@
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+import { setCheckoutTransport, type CheckoutTransport } from "@/checkout/lib/checkout-transport";
+import {
+	ageRestrictionKeyForMessage,
+	getAgeRestrictionEntry,
+	getAgeRestrictionError,
+	setAgeRestrictionError,
+} from "./age-restriction-error";
+import { completeCheckoutOrder } from "./complete-order";
+import { buildPaymentFailureErrors } from "./payment-failure-errors";
+
+vi.mock("@/checkout/lib/payment/navigate-to-order", () => ({ navigateToOrderConfirmation: vi.fn() }));
+
+const completeCheckout = vi.fn<CheckoutTransport["completeCheckout"]>();
+
+beforeEach(() => {
+	completeCheckout.mockReset();
+	setAgeRestrictionError(null);
+	setCheckoutTransport({ completeCheckout } as unknown as CheckoutTransport);
+});
+
+afterEach(() => setAgeRestrictionError(null));
+
+describe("checkoutComplete age restriction propagation", () => {
+	it("carries the localized message and the age key to the payment step errors", async () => {
+		completeCheckout.mockResolvedValue({
+			ok: false,
+			error: "Localized: sign in",
+			ageRestriction: "ageLoginRequired",
+			fieldErrors: [{ field: "lines", message: "raw", code: "AGE_RESTRICTION_LOGIN_REQUIRED" }],
+		});
+
+		const result = await completeCheckoutOrder("checkout-1");
+
+		expect(result).toMatchObject({
+			ok: false,
+			error: "Localized: sign in",
+			errorKey: "payment",
+			ageRestriction: "ageLoginRequired",
+		});
+		expect(getAgeRestrictionError()).toBe("ageLoginRequired");
+		if (result.ok) throw new Error("expected failure");
+		expect(buildPaymentFailureErrors(result)).toEqual({ payment: "Localized: sign in" });
+	});
+
+	it("clears the key for a non-age failure", async () => {
+		setAgeRestrictionError("ageUnderage");
+		completeCheckout.mockResolvedValue({ ok: false, error: "Other" });
+
+		const result = await completeCheckoutOrder("checkout-1");
+
+		expect(result).toEqual({ ok: false, error: "Other", errorKey: "payment" });
+		expect(getAgeRestrictionError()).toBeNull();
+	});
+});
+
+describe("stale age key", () => {
+	it("is shown only for the message it was recorded with", () => {
+		setAgeRestrictionError("ageLoginRequired", "Localized: sign in");
+		const entry = getAgeRestrictionEntry();
+
+		expect(ageRestrictionKeyForMessage(entry, "Localized: sign in")).toBe("ageLoginRequired");
+		expect(ageRestrictionKeyForMessage(entry, "Card declined")).toBeNull();
+		expect(ageRestrictionKeyForMessage(entry, undefined)).toBeNull();
+		expect(ageRestrictionKeyForMessage(null, "Localized: sign in")).toBeNull();
+	});
+});
diff --git a/src/checkout/lib/payment/age-restriction-error.ts b/src/checkout/lib/payment/age-restriction-error.ts
new file mode 100644
index 0000000..ca96d4e
--- /dev/null
+++ b/src/checkout/lib/payment/age-restriction-error.ts
@@ -0,0 +1,52 @@
+import type { AgeRestrictionErrorKey } from "@/lib/age-restriction";
+
+/**
+ * Last checkout-completion failure caused by an age restriction.
+ *
+ * Several completion paths (card, Stripe redirect return, authorized-payment recovery,
+ * free orders) report only a message string to the payment step. The key travels through
+ * this tiny store, together with the exact localized message it belongs to, so the step
+ * renders the notice only while that very message is displayed: a leftover entry can never
+ * decorate a later, unrelated payment error. Module state, like `checkout-payment-completion`;
+ * it holds a key and a localized message, never a backend message.
+ */
+export type AgeRestrictionEntry = { key: AgeRestrictionErrorKey; message: string };
+
+let current: AgeRestrictionEntry | null = null;
+const listeners = new Set<() => void>();
+
+function notify() {
+	for (const listener of listeners) listener();
+}
+
+/** Record the key with the message it explains; `null` clears. */
+export function setAgeRestrictionError(key: AgeRestrictionErrorKey | null, message?: string): void {
+	const next = key ? { key, message: message ?? "" } : null;
+	if (current?.key === next?.key && current?.message === next?.message) return;
+	current = next;
+	notify();
+}
+
+export function getAgeRestrictionError(): AgeRestrictionErrorKey | null {
+	return current?.key ?? null;
+}
+
+/** Stable snapshot for `useSyncExternalStore`. */
+export function getAgeRestrictionEntry(): AgeRestrictionEntry | null {
+	return current;
+}
+
+/** The key, only when it was recorded for exactly this displayed message. */
+export function ageRestrictionKeyForMessage(
+	entry: AgeRestrictionEntry | null,
+	message: string | null | undefined,
+): AgeRestrictionErrorKey | null {
+	return entry && message && entry.message === message ? entry.key : null;
+}
+
+export function subscribeAgeRestrictionError(listener: () => void): () => void {
+	listeners.add(listener);
+	return () => {
+		listeners.delete(listener);
+	};
+}
