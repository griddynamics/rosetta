diff --git a/src/ui/components/pdp/add-to-cart-form.tsx b/src/ui/components/pdp/add-to-cart-form.tsx
new file mode 100644
index 0000000..51150cc
--- /dev/null
+++ b/src/ui/components/pdp/add-to-cart-form.tsx
@@ -0,0 +1,101 @@
+"use client";
+
+import { useActionState, type ReactNode } from "react";
+import { useTranslations } from "next-intl";
+import { AlertCircle } from "lucide-react";
+import { LinkWithChannel } from "@/ui/atoms/link-with-channel";
+import { accountRoutes } from "@/ui/components/account/routes";
+import { parseAgeLabel, type AddToCartResult } from "@/lib/age-restriction";
+
+interface AddToCartFormProps {
+	/** Server action; receives the previous result and returns the new one. */
+	action: (previous: AddToCartResult | null) => Promise<AddToCartResult>;
+	productName: string;
+	/** Public "N+" label of the product; null when unrestricted. */
+	ageLabel?: string | null;
+	className?: string;
+	children: ReactNode;
+}
+
+/**
+ * Wraps the PDP buy box so the add-to-cart outcome reaches the shopper.
+ * Age-restriction refusals name the product and point at the fix (sign in / add birthday).
+ */
+export function AddToCartForm({ action, productName, ageLabel, className, children }: AddToCartFormProps) {
+	const t = useTranslations("pdp");
+	const [result, formAction] = useActionState(action, null);
+
+	return (
+		<form action={formAction} className={className}>
+			{children}
+			{ageLabel ? (
+				<p className="text-sm text-muted-foreground" data-testid="age-restricted-hint">
+					{t("ageRestrictedHint")}
+				</p>
+			) : null}
+			{result && !result.ok ? (
+				<div
+					role="alert"
+					className="flex items-start gap-3 rounded-lg border border-destructive/50 bg-destructive/10 p-4"
+					data-testid="add-to-cart-error"
+				>
+					<AlertCircle className="mt-0.5 h-5 w-5 flex-shrink-0 text-destructive" />
+					<div className="space-y-1 text-sm">
+						<AddToCartFailureMessage result={result} productName={productName} ageLabel={ageLabel} />
+					</div>
+				</div>
+			) : null}
+		</form>
+	);
+}
+
+function AddToCartFailureMessage({
+	result,
+	productName,
+	ageLabel,
+}: {
+	result: Extract<AddToCartResult, { ok: false }>;
+	productName: string;
+	ageLabel?: string | null;
+}) {
+	const t = useTranslations("pdp");
+
+	switch (result.reason) {
+		case "AGE_LOGIN_REQUIRED":
+			return (
+				<>
+					<p className="font-medium text-destructive">{t("ageLoginRequired", { product: productName })}</p>
+					<LinkWithChannel href="/login" className="font-medium underline">
+						{t("ageSignInLink")}
+					</LinkWithChannel>
+				</>
+			);
+		case "AGE_BIRTHDAY_REQUIRED":
+			return (
+				<>
+					<p className="font-medium text-destructive">{t("ageBirthdayRequired", { product: productName })}</p>
+					<LinkWithChannel href={accountRoutes.settings} className="font-medium underline">
+						{t("ageBirthdayLink")}
+					</LinkWithChannel>
+				</>
+			);
+		case "AGE_UNDERAGE": {
+			const minimumAge = parseAgeLabel(ageLabel);
+			return (
+				<p className="font-medium text-destructive">
+					{minimumAge === null
+						? t("ageUnderageNoAge", { product: productName })
+						: t("ageUnderage", { product: productName, minimumAge })}
+				</p>
+			);
+		}
+		case "AGE_NOT_ELIGIBLE":
+			return <p className="font-medium text-destructive">{t("ageNotEligible", { product: productName })}</p>;
+		default:
+			return (
+				<p className="font-medium text-destructive">
+					{result.message ?? t("addToCartFailed", { product: productName })}
+				</p>
+			);
+	}
+}
