+"use client";
+
+import { useSyncExternalStore } from "react";
+import { AlertCircle } from "lucide-react";
+import { useTranslations } from "next-intl";
+import { DefaultChannelSlug } from "@/app/config";
+import {
+	ageRestrictionKeyForMessage,
+	getAgeRestrictionEntry,
+	subscribeAgeRestrictionError,
+} from "@/checkout/lib/payment/age-restriction-error";
+import { useCheckoutBrowseLocale } from "@/checkout/providers/checkout-browse";
+import { useCheckoutData } from "@/checkout/providers/checkout-data";
+import type { AgeRestrictionErrorKey } from "@/lib/age-restriction";
+import { buildStorefrontPath } from "@/lib/storefront-path";
+import { accountRoutes } from "@/ui/components/account/routes";
+import { AgeRestrictionNoticeView } from "@/ui/components/age-restriction-notice";
+
+/** The age-restriction key recorded for exactly this displayed message, or `null`. */
+export function useAgeRestrictionError(message: string | null | undefined): AgeRestrictionErrorKey | null {
+	const entry = useSyncExternalStore(subscribeAgeRestrictionError, getAgeRestrictionEntry, () => null);
+	return ageRestrictionKeyForMessage(entry, message);
+}
+
+/** Checkout payment-step notice: localized message plus sign-in / account-settings link. */
+export function CheckoutAgeRestrictionNotice({ errorKey }: { errorKey: AgeRestrictionErrorKey }) {
+	const t = useTranslations("checkout.ageRestriction");
+	const locale = useCheckoutBrowseLocale();
+	const { checkout } = useCheckoutData();
+	const channel = checkout?.channel.slug ?? DefaultChannelSlug ?? "default-channel";
+
+	return (
+		<div className="flex items-start gap-3 rounded-lg border border-destructive/50 bg-destructive/10 p-4">
+			<AlertCircle className="h-5 w-5 flex-shrink-0 text-destructive" />
+			<AgeRestrictionNoticeView
+				errorKey={errorKey}
+				messages={{
+					message: t(errorKey),
+					signInLabel: t("signIn"),
+					accountSettingsLabel: t("accountSettings"),
+				}}
+				signInHref={buildStorefrontPath(locale, channel, "/login")}
+				accountSettingsHref={buildStorefrontPath(locale, channel, accountRoutes.settings)}
+				className="space-y-1"
+			/>
+		</div>
+	);
+}
