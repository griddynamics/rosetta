new file mode 100644
index 0000000..b4f8616
--- /dev/null
+++ b/src/checkout/lib/payment/payment-failure-errors.ts
@@ -0,0 +1,35 @@
+import type { PaymentResult } from "./types";
+
+type FailedPayment = Extract<PaymentResult, { ok: false }>;
+
+/**
+ * Form-state errors for a failed payment attempt.
+ *
+ * `fieldErrors` may arrive as a record (billing fields) or as a `checkoutComplete` error
+ * list (`{ field, message }[]`). `Object.assign`-ing a list into the record produced
+ * numeric keys and dropped the messages, so a list is flattened by `field` first.
+ */
+export function buildPaymentFailureErrors(payResult: FailedPayment): Record<string, string> {
+	const nextErrors: Record<string, string> = {};
+
+	if (payResult.errorKey) {
+		nextErrors[payResult.errorKey] = payResult.error;
+	}
+
+	const fieldErrors: unknown = payResult.fieldErrors;
+	if (Array.isArray(fieldErrors)) {
+		for (const entry of fieldErrors as ReadonlyArray<{ field?: string | null; message?: string | null }>) {
+			if (entry?.field && entry.message && !(entry.field in nextErrors)) {
+				nextErrors[entry.field] = entry.message;
+			}
+		}
+	} else if (fieldErrors && typeof fieldErrors === "object") {
+		Object.assign(nextErrors, fieldErrors);
+	}
+
+	if (!payResult.errorKey && !payResult.fieldErrors) {
+		nextErrors.payment = payResult.error;
+	}
+
+	return nextErrors;
+}
