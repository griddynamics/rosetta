index 0000000..1ce6ab0
--- /dev/null
+++ b/src/lib/age-restriction.ts
@@ -0,0 +1,51 @@
+/**
+ * Age-restriction purchase errors (Saleor `CheckoutErrorCode` AGE_RESTRICTION_*).
+ *
+ * The backend message is never shown to shoppers for these codes: each code maps to a
+ * localized message key plus, where the shopper can fix it, a follow-up link.
+ * Pure module, safe on the server, the storefront client, and the checkout client.
+ */
+
+export type AgeRestrictionErrorKey = "ageLoginRequired" | "ageBirthdayRequired" | "ageUnderage";
+
+/** Where the shopper can resolve the error. `null` means message only. */
+export type AgeRestrictionAction = "signIn" | "accountSettings" | null;
+
+const CODE_TO_KEY: Readonly<Record<string, AgeRestrictionErrorKey>> = {
+	AGE_RESTRICTION_LOGIN_REQUIRED: "ageLoginRequired",
+	AGE_RESTRICTION_BIRTHDAY_REQUIRED: "ageBirthdayRequired",
+	AGE_RESTRICTION_UNDERAGE: "ageUnderage",
+};
+
+const KEY_TO_ACTION: Readonly<Record<AgeRestrictionErrorKey, AgeRestrictionAction>> = {
+	ageLoginRequired: "signIn",
+	ageBirthdayRequired: "accountSettings",
+	ageUnderage: null,
+};
+
+/** Map a Saleor error code to its localized key, or `null` for any other code. */
+export function ageRestrictionErrorKey(code: string | null | undefined): AgeRestrictionErrorKey | null {
+	if (!code) return null;
+	return CODE_TO_KEY[code] ?? null;
+}
+
+/** First age-restriction key among a mutation's `errors`, or `null`. */
+export function firstAgeRestrictionErrorKey(
+	errors: ReadonlyArray<{ code?: string | null }> | null | undefined,
+): AgeRestrictionErrorKey | null {
+	for (const error of errors ?? []) {
+		const key = ageRestrictionErrorKey(error.code);
+		if (key) return key;
+	}
+	return null;
+}
+
+export function ageRestrictionAction(key: AgeRestrictionErrorKey): AgeRestrictionAction {
+	return KEY_TO_ACTION[key];
+}
+
+/** Result of a cart mutation server action (`addVariantToCart`, `updateCartLineQuantity`). */
+export type CartActionResult =
+	| { ok: true }
+	/** `errorKey` is `null` for failures the shopper cannot act on (logged server-side). */
+	| { ok: false; errorKey: AgeRestrictionErrorKey | null };
