+import { createElement } from "react";
+import { describe, expect, it } from "vitest";
+
+import { renderWithAgePolicy } from "@/ui/components/__test-utils__/render-with-age-policy";
+import { AgeBadge } from "@/ui/components/ui/product-badges";
+
+describe("AgeBadge", () => {
+	it('renders "{minimumAge}+" from the shop policy', () => {
+		const html = renderWithAgePolicy(createElement(AgeBadge), 18);
+		expect(html).toContain("18+");
+		expect(html).toContain('aria-label="Age restricted: 18+"');
+	});
+
+	it("follows a different shop-wide minimum age", () => {
+		expect(renderWithAgePolicy(createElement(AgeBadge), 21)).toContain("21+");
+	});
+
+	it("renders nothing without a policy provider", () => {
+		expect(renderWithAgePolicy(createElement(AgeBadge), null)).toBe("");
+	});
+});
