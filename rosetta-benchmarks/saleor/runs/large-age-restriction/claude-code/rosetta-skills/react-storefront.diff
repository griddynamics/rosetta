+/**
+ * Set, change or clear (empty value) the signed-in customer's date of birth.
+ * The date travels only as a GraphQL variable and is never logged or cached.
+ */
+export async function updateBirthday(formData: FormData): Promise<AccountActionResult> {
+	const parsed = parseBirthdayInput(getFormString(formData, "birthday"));
+	if (!parsed.ok) {
+		return { success: false, errorKey: "birthdayInvalid" };
+	}
+
+	const result = await mutate(AccountUpdateDocument, {
+		variables: { input: { birthday: parsed.value } },
+	});
+
+	if (!result.ok) {
+		return { success: false, error: result.error.message };
+	}
+
+	const errors = result.data.accountUpdate?.errors;
+	if (errors?.length) {
+		return errors.some((error) => error.code === "INVALID" && error.field === "birthday")
+			? { success: false, errorKey: "birthdayInvalid" }
+			: { success: false, errorKey: "updateBirthdayFailed" };
+	}
+
+	revalidateAccountLayout();
+	return { success: true };
+}
