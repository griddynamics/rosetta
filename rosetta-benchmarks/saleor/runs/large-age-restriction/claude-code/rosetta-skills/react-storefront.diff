+import "server-only";
+
+import { ShopAgePolicyDocument } from "@/gql/graphql";
+import { minimumAgeOrNull } from "@/lib/custom/minimum-age-or-null";
+import { CACHE_PROFILES, cachedQuery } from "@/lib/saleor";
+
+/**
+ * Shop-wide minimum purchase age (public `Shop.minimumAge`), used for the "{minimumAge}+"
+ * label on age-restricted products. Not personal data; cached globally.
+ *
+ * Reuses the `channels` profile (global tag `channels`, revalidate 1 day): no Saleor webhook
+ * covers site settings, and a new profile would change the cache-manifest handshake with the
+ * paper-app. After changing the minimum age, purge the `channels` tag to refresh sooner.
+ * A Saleor failure throws so the outage is not cached.
+ */
+export async function getShopMinimumAge(): Promise<number> {
+	"use cache";
+
+	const data = await cachedQuery(ShopAgePolicyDocument, { profile: CACHE_PROFILES.channels });
+
+	return data.shop.minimumAge;
+}
+
+/** Resilient variant for layouts/loaders: `null` (label omitted) when Saleor is unavailable. */
+export function getShopMinimumAgeOrNull(): Promise<number | null> {
+	return minimumAgeOrNull(getShopMinimumAge);
+}
