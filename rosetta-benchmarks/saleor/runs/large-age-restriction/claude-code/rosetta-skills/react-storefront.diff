+import { createElement } from "react";
+import { describe, expect, it, vi } from "vitest";
+
+import { renderWithAgePolicy } from "@/ui/components/__test-utils__/render-with-age-policy";
+import type { ProductCardData } from "./product-card-data";
+import { ProductCardBase } from "./product-card-base";
+
+vi.mock("next/image", () => ({
+	default: (props: { alt?: string }) => createElement("img", { alt: props.alt }),
+}));
+vi.mock("next/link", () => ({
+	default: (props: { href: string; children?: unknown; className?: string }) =>
+		createElement("a", { href: props.href, className: props.className }, props.children as never),
+	useLinkStatus: () => ({ pending: false }),
+}));
+
+const product: ProductCardData = {
+	id: "p1",
+	name: "Whisky",
+	slug: "whisky",
+	price: 30,
+	currency: "USD",
+	image: "/img/1.jpg",
+	href: "/products/whisky",
+};
+
+function render(data: ProductCardData) {
+	return renderWithAgePolicy(createElement(ProductCardBase, { product: data }), 18);
+}
+
+describe("ProductCardBase age label", () => {
+	it('shows "18+" on an age-restricted card and keeps it visible and linked', () => {
+		const html = render({ ...product, isAgeRestricted: true });
+		expect(html).toContain("18+");
+		expect(html).toContain('href="/products/whisky"');
+		expect(html).toContain("Whisky");
+	});
+
+	it("shows no age label on an unrestricted card", () => {
+		expect(render(product)).not.toContain("18+");
+		expect(render({ ...product, isAgeRestricted: false })).not.toContain("age-badge");
+	});
+
+	it("shows the age label together with sale and bestseller chips", () => {
+		const html = render({ ...product, isAgeRestricted: true, badge: "Sale", isBestseller: true });
+		expect(html).toContain("18+");
+		expect(html).toMatch(/role="img"[^>]*aria-label=|aria-label=[^>]*role="img"/);
+		expect(html).toContain("Sale");
+		expect(html).toContain("Bestseller");
+	});
+});
