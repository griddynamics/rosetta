+/**
+ * Set or clear (empty value) the signed-in customer's birthday.
+ * Personal data: the value is sent only to Saleor, is masked in request logs, and the
+ * mutation response does not select it back. Backend messages are never shown; failures
+ * map to localized keys.
+ */
+export async function updateBirthday(formData: FormData): Promise<AccountActionResult> {
+	const raw = getFormStringOptional(formData, "birthday");
+
+	if (raw !== undefined && !isValidBirthday(raw)) {
+		return { success: false, errorKey: "invalidBirthday" };
+	}
+
+	const result = await mutate(AccountUpdateDocument, {
+		variables: { input: { birthday: raw ?? null } },
+	});
+
+	if (!result.ok) {
+		return { success: false, errorKey: "updateBirthdayFailed" };
+	}
+
+	const errors = result.data.accountUpdate?.errors;
+	if (errors?.length) {
+		return {
+			success: false,
+			errorKey: errors.some((error) => error.field === "birthday" || error.code === "INVALID")
+				? "invalidBirthday"
+				: "updateBirthdayFailed",
+		};
+	}
+
+	revalidateAccountLayout();
+	return { success: true };
+}
