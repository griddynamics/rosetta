+import { getTranslations } from "next-intl/server";
+import { getCurrentUserBirthday } from "@/lib/account/get-birthday";
+import { hasAuthSession } from "@/lib/auth/has-auth-session";
+import { BirthdayForm } from "@/ui/components/account/birthday-form";
+
+/** Server island: reads the owner's birthday per request (never cached) and renders the form. */
+export async function BirthdaySection({ localeSlug }: { localeSlug: string }) {
+	if (!(await hasAuthSession())) {
+		return null;
+	}
+
+	const result = await getCurrentUserBirthday();
+	if (!result.ok) {
+		const t = await getTranslations({ locale: localeSlug, namespace: "account.errors" });
