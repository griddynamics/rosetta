+import { describe, expect, it } from "vitest";
+
+import { mapAgeRestrictionError, parseAgeLabel, parseBirthdayInput, productAgeLabel } from "./age-restriction";
+
+describe("mapAgeRestrictionError", () => {
+	it.each([
+		["AGE_RESTRICTED_LOGIN_REQUIRED", "AGE_LOGIN_REQUIRED"],
+		["AGE_RESTRICTED_BIRTHDAY_REQUIRED", "AGE_BIRTHDAY_REQUIRED"],
+		["AGE_RESTRICTED_UNDERAGE", "AGE_UNDERAGE"],
+		["AGE_RESTRICTED_NOT_ELIGIBLE", "AGE_NOT_ELIGIBLE"],
+	])("maps %s to %s", (code, reason) => {
+		expect(mapAgeRestrictionError(code)).toBe(reason);
+	});
+
+	it("returns null for unrelated, empty and inherited-key codes", () => {
+		expect(mapAgeRestrictionError("INSUFFICIENT_STOCK")).toBeNull();
+		expect(mapAgeRestrictionError("")).toBeNull();
+		expect(mapAgeRestrictionError(null)).toBeNull();
+		expect(mapAgeRestrictionError(undefined)).toBeNull();
+		expect(mapAgeRestrictionError("toString")).toBeNull();
+	});
+});
+
+describe("parseAgeLabel", () => {
+	it("reads the number from an N+ label", () => {
+		expect(parseAgeLabel("18+")).toBe(18);
+		expect(parseAgeLabel(" 21+ ")).toBe(21);
+	});
+
+	it("rejects anything else", () => {
+		expect(parseAgeLabel(null)).toBeNull();
+		expect(parseAgeLabel("")).toBeNull();
+		expect(parseAgeLabel("18")).toBeNull();
+		expect(parseAgeLabel("0+")).toBeNull();
+		expect(parseAgeLabel("adult+")).toBeNull();
+	});
+});
+
+describe("parseBirthdayInput", () => {
+	const today = new Date("2026-10-22T12:00:00Z");
+
+	it("accepts strict YYYY-MM-DD", () => {
+		expect(parseBirthdayInput("2008-10-22", today)).toEqual({ ok: true, value: "2008-10-22" });
+		expect(parseBirthdayInput("2008-02-29", today)).toEqual({ ok: true, value: "2008-02-29" });
+	});
+
+	it("treats empty input as clear", () => {
+		expect(parseBirthdayInput("", today)).toEqual({ ok: true, value: null });
+		expect(parseBirthdayInput("   ", today)).toEqual({ ok: true, value: null });
+	});
+
+	it.each([
+		"22/10/2008",
+		"2008-1-5",
+		"2008-10",
+		"2008-10-22T00:00:00Z",
+		"abc",
+		"2009-02-29",
+		"2008-13-01",
+		"2008-00-10",
+	])("rejects malformed or impossible date %s", (raw) => {
+		expect(parseBirthdayInput(raw, today)).toEqual({ ok: false });
+	});
+
+	it("rejects dates in the future beyond one day of time-zone slack", () => {
+		expect(parseBirthdayInput("2026-10-23", today)).toEqual({ ok: true, value: "2026-10-23" });
+		expect(parseBirthdayInput("2026-10-24", today)).toEqual({ ok: false });
+		expect(parseBirthdayInput("2030-01-01", today)).toEqual({ ok: false });
+	});
+});
+
+describe("productAgeLabel", () => {
+	it("returns the label for restricted products", () => {
+		expect(productAgeLabel({ ageLabel: "18+" })).toBe("18+");
+		expect(productAgeLabel({ ageLabel: " 16+ " })).toBe("16+");
+	});
+
+	it("returns null (no badge) for unrestricted or missing products", () => {
+		expect(productAgeLabel({ ageLabel: null })).toBeNull();
+		expect(productAgeLabel({ ageLabel: "  " })).toBeNull();
+		expect(productAgeLabel({})).toBeNull();
+		expect(productAgeLabel(null)).toBeNull();
+		expect(productAgeLabel(undefined)).toBeNull();
+	});
+});
