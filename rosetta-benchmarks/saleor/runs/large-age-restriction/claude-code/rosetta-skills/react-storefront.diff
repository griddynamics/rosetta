diff --git a/src/ui/components/ui/age-policy.tsx b/src/ui/components/ui/age-policy.tsx
new file mode 100644
index 0000000..0c84da3
--- /dev/null
+++ b/src/ui/components/ui/age-policy.tsx
@@ -0,0 +1,25 @@
+"use client";
+
+import { createContext, useContext, type ReactNode } from "react";
+
+/**
+ * Shop-wide minimum purchase age (`Shop.minimumAge`), fetched once on the server by
+ * `getShopMinimumAge()` and provided to every surface that can render the age label
+ * (storefront layout and checkout shell). Public, non-personal policy value.
+ */
+const AgePolicyContext = createContext<number | null>(null);
+
+export function AgePolicyProvider({
+	minimumAge,
+	children,
+}: {
+	minimumAge: number | null;
+	children: ReactNode;
+}) {
+	return <AgePolicyContext.Provider value={minimumAge}>{children}</AgePolicyContext.Provider>;
+}
+
+/** Minimum age, or `null` when no provider is mounted (the label is then omitted). */
+export function useMinimumAge(): number | null {
+	return useContext(AgePolicyContext);
+}
