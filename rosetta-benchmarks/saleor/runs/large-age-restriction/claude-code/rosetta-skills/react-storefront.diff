@@ -0,0 +1,108 @@
+"use client";
+
+import { useCallback, useState, useTransition } from "react";
+import { useRouter } from "next/navigation";
+import { useTranslations } from "next-intl";
+import { Button } from "@/ui/components/ui/button";
+import { Input } from "@/ui/components/ui/input";
+import { Label } from "@/ui/components/ui/label";
+import { updateBirthday } from "@/app/(storefront)/[locale]/[channel]/(main)/account/actions";
+import { resolveAccountActionError } from "@/ui/components/account/account-action-result";
+
+type Props = {
+	/** Saved birthday as `YYYY-MM-DD`, or null when not set. Owner-only value. */
+	birthday: string | null;
+};
+
+function localTodayIso(): string {
+	const now = new Date();
+	const month = String(now.getMonth() + 1).padStart(2, "0");
+	const day = String(now.getDate()).padStart(2, "0");
+	return `${now.getFullYear()}-${month}-${day}`;
+}
+
+export function BirthdayForm({ birthday }: Props) {
+	const t = useTranslations("account");
+	const router = useRouter();
+	const [isPending, startTransition] = useTransition();
+	const [value, setValue] = useState(birthday ?? "");
+	const [saved, setSaved] = useState(birthday ?? "");
+	const [error, setError] = useState("");
+	const [success, setSuccess] = useState(false);
+
+	const submit = useCallback(
+		(next: string) => {
+			setError("");
+			setSuccess(false);
+
+			const formData = new FormData();
+			formData.set("birthday", next);
+
+			startTransition(async () => {
+				const result = await updateBirthday(formData);
+				if (!result.success) {
+					setError(resolveAccountActionError(t, result));
+					return;
+				}
+				setSaved(next);
+				setValue(next);
+				setSuccess(true);
+				router.refresh();
+			});
+		},
+		[router, t],
+	);
+
+	return (
+		<form
+			onSubmit={(event) => {
+				event.preventDefault();
+				submit(value);
+			}}
+			className="space-y-3"
+			aria-describedby="birthday-help"
+			data-testid="birthday-form"
+		>
+			<div className="space-y-1.5">
+				<Label htmlFor="birthday">{t("fields.birthday")}</Label>
+				<Input
+					id="birthday"
+					name="birthday"
+					type="date"
+					autoComplete="bday"
+					max={localTodayIso()}
+					value={value}
+					onChange={(event) => {
+						setValue(event.target.value);
+						setSuccess(false);
+					}}
+				/>
+				<p id="birthday-help" className="text-sm text-muted-foreground">
+					{t("settings.birthdayHelp")}
+				</p>
+			</div>
+
+			{error && (
+				<p role="alert" className="text-sm text-destructive">
+					{error}
+				</p>
+			)}
+			{success && (
+				<p aria-live="polite" className="text-sm text-green-600">
+					{t("common.updated")}
+				</p>
+			)}
+
+			<div className="flex gap-2">
+				<Button type="submit" size="sm" disabled={isPending || value === saved}>
+					{isPending ? t("common.saving") : t("common.save")}
+				</Button>
+				{saved && (
+					<Button type="button" variant="ghost" size="sm" disabled={isPending} onClick={() => submit("")}>
+						{t("settings.birthdayClear")}
+					</Button>
+				)}
+			</div>
+		</form>
+	);
+}
