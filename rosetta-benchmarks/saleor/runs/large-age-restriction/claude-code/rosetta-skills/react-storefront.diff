+import { describe, expect, it } from "vitest";
+
+import {
+	ageRestrictionAction,
+	ageRestrictionErrorKey,
+	firstAgeRestrictionErrorKey,
+	type AgeRestrictionErrorKey,
+} from "@/lib/age-restriction";
+
+describe("ageRestrictionErrorKey", () => {
+	it.each([
+		["AGE_RESTRICTION_LOGIN_REQUIRED", "ageLoginRequired"],
+		["AGE_RESTRICTION_BIRTHDAY_REQUIRED", "ageBirthdayRequired"],
+		["AGE_RESTRICTION_UNDERAGE", "ageUnderage"],
+	])("maps %s to %s", (code, key) => {
+		expect(ageRestrictionErrorKey(code)).toBe(key);
+	});
+
+	it("returns null for other codes and empty input", () => {
+		expect(ageRestrictionErrorKey("INSUFFICIENT_STOCK")).toBeNull();
+		expect(ageRestrictionErrorKey("")).toBeNull();
+		expect(ageRestrictionErrorKey(null)).toBeNull();
+		expect(ageRestrictionErrorKey(undefined)).toBeNull();
+	});
+});
+
+describe("firstAgeRestrictionErrorKey", () => {
+	it("picks the first age-restriction error among mixed errors", () => {
+		expect(
+			firstAgeRestrictionErrorKey([
+				{ code: "INSUFFICIENT_STOCK" },
+				{ code: "AGE_RESTRICTION_UNDERAGE" },
+				{ code: "AGE_RESTRICTION_LOGIN_REQUIRED" },
+			]),
+		).toBe("ageUnderage");
+	});
+
+	it("returns null without age errors", () => {
+		expect(firstAgeRestrictionErrorKey([{ code: "INVALID" }])).toBeNull();
+		expect(firstAgeRestrictionErrorKey(null)).toBeNull();
+		expect(firstAgeRestrictionErrorKey([])).toBeNull();
+	});
+});
+
+describe("ageRestrictionAction", () => {
+	it("links sign-in, links account settings, or shows the message only", () => {
+		const actions: Record<AgeRestrictionErrorKey, ReturnType<typeof ageRestrictionAction>> = {
+			ageLoginRequired: ageRestrictionAction("ageLoginRequired"),
+			ageBirthdayRequired: ageRestrictionAction("ageBirthdayRequired"),
+			ageUnderage: ageRestrictionAction("ageUnderage"),
+		};
+		expect(actions).toEqual({
+			ageLoginRequired: "signIn",
+			ageBirthdayRequired: "accountSettings",
+			ageUnderage: null,
+		});
+	});
+});
diff --git a/src/lib/age-restriction.ts b/src/lib/age-restriction.ts
