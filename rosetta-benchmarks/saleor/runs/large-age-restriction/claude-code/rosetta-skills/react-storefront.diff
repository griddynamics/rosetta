+import { renderToStaticMarkup } from "react-dom/server";
+import { NextIntlClientProvider } from "next-intl";
+
+import en from "../../../../messages/en.json";
+import { AgePolicyProvider } from "@/ui/components/ui/age-policy";
+
+type IntlProps = { locale: string; messages: typeof en; timeZone: string; children?: ReactNode };
+
+const Policy = AgePolicyProvider as unknown as ComponentType<{ minimumAge: number; children?: ReactNode }>;
+const Intl = NextIntlClientProvider as unknown as ComponentType<IntlProps>;
+
+/** Server-render `node` with English messages and, when given, the shop-wide minimum age policy. */
+export function renderWithAgePolicy(node: ReactNode, minimumAge: number | null): string {
+	const content = minimumAge === null ? node : createElement(Policy, { minimumAge }, node);
+	return renderToStaticMarkup(createElement(Intl, { locale: "en", messages: en, timeZone: "UTC" }, content));
+}
