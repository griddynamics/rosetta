+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const mutate = vi.fn();
+const refresh = vi.fn();
+
+vi.mock("@/lib/saleor", () => ({
+	mutate: (...args: unknown[]) => mutate(...args),
+}));
+vi.mock("next/cache", () => ({ refresh: () => refresh() }));
+
+import { updateBirthday } from "./actions";
+
+function form(value: string): FormData {
+	const data = new FormData();
+	data.set("birthday", value);
+	return data;
+}
+
+describe("updateBirthday", () => {
+	beforeEach(() => {
+		mutate.mockReset();
+		refresh.mockReset();
+	});
+
+	it("sends the date only as an accountUpdate variable", async () => {
+		mutate.mockResolvedValue({ ok: true, data: { accountUpdate: { user: { id: "u1" }, errors: [] } } });
+
+		await expect(updateBirthday(form("2008-10-22"))).resolves.toEqual({ success: true });
+
+		expect(mutate).toHaveBeenCalledTimes(1);
+		expect(mutate.mock.calls[0]![1]).toEqual({ variables: { input: { birthday: "2008-10-22" } } });
+		expect(refresh).toHaveBeenCalled();
+	});
+
+	it("clears the birthday with null when the field is empty", async () => {
+		mutate.mockResolvedValue({ ok: true, data: { accountUpdate: { user: { id: "u1" }, errors: [] } } });
+
+		await expect(updateBirthday(form(""))).resolves.toEqual({ success: true });
+		expect(mutate.mock.calls[0]![1]).toEqual({ variables: { input: { birthday: null } } });
+	});
+
+	it("rejects a malformed date without calling the API", async () => {
+		await expect(updateBirthday(form("22/10/2008"))).resolves.toEqual({
+			success: false,
+			errorKey: "birthdayInvalid",
+		});
+		await expect(updateBirthday(form("2009-02-29"))).resolves.toEqual({
+			success: false,
+			errorKey: "birthdayInvalid",
+		});
+		expect(mutate).not.toHaveBeenCalled();
+	});
+
+	it("maps an INVALID error on birthday to birthdayInvalid", async () => {
+		mutate.mockResolvedValue({
+			ok: true,
+			data: {
+				accountUpdate: {
+					user: null,
+					errors: [{ field: "birthday", code: "INVALID", message: "Date of birth cannot be in the future." }],
+				},
+			},
+		});
+
+		await expect(updateBirthday(form("2008-10-22"))).resolves.toEqual({
+			success: false,
+			errorKey: "birthdayInvalid",
+		});
+		expect(refresh).not.toHaveBeenCalled();
+	});
+
+	it("maps other API errors to a generic key", async () => {
+		mutate.mockResolvedValue({
+			ok: true,
+			data: { accountUpdate: { user: null, errors: [{ field: null, code: "REQUIRED", message: "x" }] } },
+		});
+
+		await expect(updateBirthday(form("2008-10-22"))).resolves.toEqual({
+			success: false,
+			errorKey: "updateBirthdayFailed",
+		});
+	});
+
+	it("surfaces transport failures", async () => {
+		mutate.mockResolvedValue({ ok: false, error: { message: "network down" } });
+
+		await expect(updateBirthday(form("2008-10-22"))).resolves.toEqual({
+			success: false,
+			error: "network down",
+		});
+	});
+});
