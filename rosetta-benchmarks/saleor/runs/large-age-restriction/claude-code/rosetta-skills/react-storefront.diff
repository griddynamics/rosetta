+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+
+import { AgeRestrictionNoticeView } from "@/ui/components/age-restriction-notice";
+
+const messages = { message: "MSG", signInLabel: "Sign in", accountSettingsLabel: "Settings" };
+
+function render(errorKey: "ageLoginRequired" | "ageBirthdayRequired" | "ageUnderage") {
+	return renderToStaticMarkup(
+		createElement(AgeRestrictionNoticeView, {
+			errorKey,
+			messages,
+			signInHref: "/en/default-channel/login",
+			accountSettingsHref: "/en/default-channel/account/settings",
+		}),
+	);
+}
+
+describe("AgeRestrictionNoticeView", () => {
+	it("links to sign-in for LOGIN_REQUIRED", () => {
+		const html = render("ageLoginRequired");
+		expect(html).toContain("MSG");
+		expect(html).toContain('href="/en/default-channel/login"');
+		expect(html).not.toContain("account/settings");
+	});
+
+	it("links to account settings for BIRTHDAY_REQUIRED", () => {
+		const html = render("ageBirthdayRequired");
+		expect(html).toContain('href="/en/default-channel/account/settings"');
+		expect(html).not.toContain("/login");
+	});
+
+	it("shows the message only for UNDERAGE", () => {
+		const html = render("ageUnderage");
+		expect(html).toContain("MSG");
+		expect(html).not.toContain("<a");
+	});
+});
diff --git a/src/ui/components/age-restriction-notice.tsx b/src/ui/components/age-restriction-notice.tsx
