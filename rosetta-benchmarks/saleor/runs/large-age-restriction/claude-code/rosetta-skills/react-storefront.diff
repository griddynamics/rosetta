+
+import { updateBirthday } from "./actions";
+
+function form(birthday?: string): FormData {
+	const data = new FormData();
+	if (birthday !== undefined) data.set("birthday", birthday);
+	return data;
+}
+
+const ok = { ok: true, data: { accountUpdate: { user: { id: "u1" }, errors: [] } } };
+
+beforeEach(() => {
+	mutate.mockReset();
+	refresh.mockReset();
+});
+
+describe("updateBirthday", () => {
+	it("sends the date and refreshes the account layout", async () => {
+		mutate.mockResolvedValue(ok);
+
+		await expect(updateBirthday(form("1990-05-17"))).resolves.toEqual({ success: true });
+		expect(mutate.mock.calls[0]?.[1]).toEqual({ variables: { input: { birthday: "1990-05-17" } } });
+		expect(refresh).toHaveBeenCalledTimes(1);
+	});
+
+	it("clears the birthday with null when the value is empty or missing", async () => {
+		mutate.mockResolvedValue(ok);
+
+		await expect(updateBirthday(form(""))).resolves.toEqual({ success: true });
+		await expect(updateBirthday(form())).resolves.toEqual({ success: true });
+		for (const call of mutate.mock.calls) {
+			expect(call[1]).toEqual({ variables: { input: { birthday: null } } });
+		}
+	});
+
+	it.each(["1990-5-17", "17/05/1990", "1990-13-45", "abc", "2023-02-31", "2023-02-29"])(
+		"rejects the malformed value %s without calling Saleor",
+		async (value) => {
+			await expect(updateBirthday(form(value))).resolves.toEqual({
+				success: false,
+				errorKey: "invalidBirthday",
+			});
+			expect(mutate).not.toHaveBeenCalled();
+		},
+	);
+
+	it("maps an INVALID API error to invalidBirthday and never exposes the backend message", async () => {
+		mutate.mockResolvedValue({
+			ok: true,
+			data: {
+				accountUpdate: {
+					user: null,
+					errors: [{ field: "birthday", code: "INVALID", message: "RAW BACKEND TEXT" }],
+				},
+			},
+		});
+
+		const result = await updateBirthday(form("2999-01-01"));
+
+		expect(result).toEqual({ success: false, errorKey: "invalidBirthday" });
+		expect(JSON.stringify(result)).not.toContain("RAW");
+		expect(refresh).not.toHaveBeenCalled();
