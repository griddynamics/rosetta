+/**
+ * Resolve the optional "{minimumAge}+" label value: a Saleor failure degrades to `null`
+ * (label omitted) instead of breaking the render. Logs a short warning, never variables
+ * or the error payload. The failure is not cached here (the cached loader throws).
+ */
+export async function minimumAgeOrNull(load: () => Promise<number>): Promise<number | null> {
+	try {
+		return await load();
+	} catch {
+		console.warn("[age-policy] minimum age unavailable; omitting the age label");
+		return null;
+	}
+}
