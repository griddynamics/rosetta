@@ -0,0 +1,68 @@
+import { describe, expect, it } from "vitest";
+
+import de from "../../messages/de.json";
+import en from "../../messages/en.json";
+import fi from "../../messages/fi.json";
+import fr from "../../messages/fr.json";
+import ja from "../../messages/ja.json";
+import ko from "../../messages/ko.json";
+import nb from "../../messages/nb.json";
+import pl from "../../messages/pl.json";
+
+const LOCALES = { en, de, fi, fr, ja, ko, nb, pl } as const;
+
+/** Every message the age-restriction feature reads, as dotted paths. */
+const AGE_KEYS = [
+	"pdp.badges.ageRestricted",
+	"ageRestriction.ageLoginRequired",
+	"ageRestriction.ageBirthdayRequired",
+	"ageRestriction.ageUnderage",
+	"ageRestriction.signIn",
+	"ageRestriction.accountSettings",
+	"checkout.ageRestriction.ageLoginRequired",
+	"checkout.ageRestriction.ageBirthdayRequired",
+	"checkout.ageRestriction.ageUnderage",
+	"checkout.ageRestriction.signIn",
+	"checkout.ageRestriction.accountSettings",
+	"checkout.summary.ageRestricted",
+	"account.fields.birthday",
+	"account.settings.birthdayHint",
+	"account.errors.invalidBirthday",
+	"account.errors.updateBirthdayFailed",
+] as const;
+
+function read(messages: unknown, path: string): unknown {
+	return path
+		.split(".")
+		.reduce<unknown>((node, part) => (node as Record<string, unknown> | undefined)?.[part], messages);
+}
+
+describe("age-restriction messages", () => {
+	it("ships the same checkout and storefront copy so each surface can render it", () => {
+		for (const [locale, messages] of Object.entries(LOCALES)) {
+			expect(read(messages, "ageRestriction"), locale).toEqual(read(messages, "checkout.ageRestriction"));
+		}
+	});
+
+	describe.each(Object.entries(LOCALES))("%s", (locale, messages) => {
+		it.each(AGE_KEYS)("has %s", (path) => {
+			const value = read(messages, path);
+			expect(typeof value, `${locale}:${path}`).toBe("string");
+			expect((value as string).trim().length).toBeGreaterThan(0);
+		});
+
+		it("keeps the {minimumAge} placeholder in the badge labels", () => {
+			expect(read(messages, "pdp.badges.ageRestricted")).toContain("{minimumAge}");
+			expect(read(messages, "checkout.summary.ageRestricted")).toContain("{minimumAge}");
+		});
+	});
+
+	it("translates the long messages (not an English copy) in every non-English locale", () => {
+		for (const [locale, messages] of Object.entries(LOCALES)) {
+			if (locale === "en") continue;
+			expect(read(messages, "ageRestriction.ageUnderage"), locale).not.toBe(
+				read(en, "ageRestriction.ageUnderage"),
+			);
+		}
+	});
+});
diff --git a/src/lib/age-restriction.test.ts b/src/lib/age-restriction.test.ts
