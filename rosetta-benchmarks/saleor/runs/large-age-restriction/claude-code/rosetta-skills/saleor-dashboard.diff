+import Wrapper from "@test/wrapper";
+import { render, screen } from "@testing-library/react";
+
+import OrderFulfillLine from "./OrderFulfillLine";
+
+const buildLine = (ageLabel: string | null): OrderFulfillLineFragment => {
+  const line = fulfillOrderLine("https://example.com/image.png");
+
+  return {
+    ...line,
+    variant: { ...line.variant!, product: { ...line.variant!.product, ageLabel } },
+  };
+};
+
+const renderLine = (line: OrderFulfillLineFragment) =>
+  render(
+    <Wrapper>
+      <ResponsiveTable>
+        <TableBody>
+          <OrderFulfillLine
+            line={line}
+            lineIndex={0}
+            formsetData={[]}
+            formsetChange={jest.fn()}
+            onWarehouseChange={jest.fn()}
+          />
+        </TableBody>
+      </ResponsiveTable>
+    </Wrapper>,
+  );
+
+describe("OrderFulfillLine", () => {
+  it("shows the age label for a restricted product and keeps the row", () => {
+    // Arrange
+    const line = buildLine("18+");
+
+    // Act
+    renderLine(line);
+
+    // Assert
+    expect(screen.getByText(line.productName)).toBeInTheDocument();
+    expect(screen.getByTestId("product-age-label")).toHaveTextContent("18+");
+  });
+
+  it("shows no age label for an unrestricted product", () => {
+    // Arrange
+    const line = buildLine(null);
+
+    // Act
+    renderLine(line);
+
+    // Assert
+    expect(screen.getByText(line.productName)).toBeInTheDocument();
+    expect(screen.queryByTestId("product-age-label")).not.toBeInTheDocument();
+  });
+});
