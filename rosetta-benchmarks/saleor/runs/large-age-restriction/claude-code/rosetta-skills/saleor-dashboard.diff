@@ -0,0 +1,27 @@
+import { type ShopSettingsInput } from "@dashboard/graphql";
+
+import { type SiteSettingsPageFormData } from "./components/SiteSettingsPage/SiteSettingsPage";
+
+type AgeRestrictionFormData = Pick<SiteSettingsPageFormData, "minimumAge" | "timeZone">;
+
+/**
+ * `shopSettingsUpdate` fields for the age rules. Values are passed through as typed: the API is
+ * the only validator (1..120, IANA name) and answers with `INVALID` on the matching field.
+ * An empty age input is sent as 0 so the API rejects it with `INVALID` instead of the save
+ * silently ignoring it. Nothing is sent when the shop did not return the fields (staging schema).
+ */
+export const getAgeRestrictionInput = (
+  data: AgeRestrictionFormData,
+  isSupported: boolean,
+): Pick<ShopSettingsInput, "minimumAge" | "timeZone"> => {
+  if (!isSupported) {
+    return {};
+  }
+
+  const minimumAge = Number(data.minimumAge);
+
+  return {
+    minimumAge: Number.isNaN(minimumAge) ? 0 : minimumAge,
+    timeZone: data.timeZone,
+  };
+};
