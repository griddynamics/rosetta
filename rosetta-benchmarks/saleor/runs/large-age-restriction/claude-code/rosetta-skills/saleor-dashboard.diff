@@ -0,0 +1,70 @@
+const FALLBACK_TIME_ZONES = [
+  "UTC",
+  "Africa/Cairo",
+  "Africa/Johannesburg",
+  "Africa/Lagos",
+  "America/Anchorage",
+  "America/Argentina/Buenos_Aires",
+  "America/Bogota",
+  "America/Chicago",
+  "America/Denver",
+  "America/Halifax",
+  "America/Los_Angeles",
+  "America/Mexico_City",
+  "America/New_York",
+  "America/Sao_Paulo",
+  "America/Toronto",
+  "Asia/Dubai",
+  "Asia/Hong_Kong",
+  "Asia/Jakarta",
+  "Asia/Kolkata",
+  "Asia/Seoul",
+  "Asia/Shanghai",
+  "Asia/Singapore",
+  "Asia/Tokyo",
+  "Australia/Sydney",
+  "Europe/Berlin",
+  "Europe/Istanbul",
+  "Europe/London",
+  "Europe/Madrid",
+  "Europe/Moscow",
+  "Europe/Paris",
+  "Europe/Warsaw",
+  "Pacific/Auckland",
+  "Pacific/Honolulu",
+];
+
+type IntlWithSupportedValues = typeof Intl & {
+  supportedValuesOf?: (key: "timeZone") => string[];
+};
+
+/**
+ * IANA time zone names for the picker. Uses the runtime's list when available and
+ * falls back to a short static list. Always includes UTC and the current value.
+ */
+export const getTimeZoneOptions = (currentValue?: string | null): string[] => {
+  let zones: string[] = [];
+
+  try {
+    zones = (Intl as IntlWithSupportedValues).supportedValuesOf?.("timeZone") ?? [];
+  } catch {
+    zones = [];
+  }
+
+  const unique = new Set<string>(zones.length > 0 ? zones : FALLBACK_TIME_ZONES);
+
+  unique.add("UTC");
+
+  if (currentValue) {
+    unique.add(currentValue);
+  }
+
+  return Array.from(unique).sort((a, b) => {
+    // Keep UTC first, the rest alphabetical.
+    if (a === "UTC") return -1;
+
+    if (b === "UTC") return 1;
+
+    return a.localeCompare(b);
+  });
+};
