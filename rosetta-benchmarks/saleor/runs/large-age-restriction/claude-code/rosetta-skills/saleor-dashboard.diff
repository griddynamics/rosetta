new file mode 100644
index 0000000..41deafa
--- /dev/null
+++ b/src/siteSettings/components/SiteAgeRestrictionCard/timeZones.ts
@@ -0,0 +1,25 @@
+const FALLBACK_TIME_ZONE = "UTC";
+
+/**
+ * IANA names offered in the picker. Browsers may omit "UTC" from `Intl.supportedValuesOf`, but it
+ * is the API default, so it is always first. The list only guides the user; the API validates.
+ */
+export const getTimeZoneOptions = (
+  supported: readonly string[] = getSupportedTimeZones(),
+  current?: string | null,
+): string[] =>
+  Array.from(new Set([FALLBACK_TIME_ZONE, ...(current ? [current] : []), ...supported])).sort(
+    (a, b) => {
+      if (a === FALLBACK_TIME_ZONE || b === FALLBACK_TIME_ZONE) {
+        return a === FALLBACK_TIME_ZONE ? -1 : 1;
+      }
+
+      return a.localeCompare(b);
+    },
+  );
+
+function getSupportedTimeZones(): string[] {
+  const intl = Intl as typeof Intl & { supportedValuesOf?: (key: "timeZone") => string[] };
+
+  return intl.supportedValuesOf?.("timeZone") ?? [];
+}
