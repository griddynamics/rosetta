+import { getTimeZoneOptions } from "./timeZones";
+
+type IntlWithSupportedValues = { supportedValuesOf?: (key: string) => string[] };
+
+describe("getTimeZoneOptions", () => {
+  const intl = Intl as unknown as IntlWithSupportedValues;
+  const original = intl.supportedValuesOf;
+
+  afterEach(() => {
+    intl.supportedValuesOf = original;
+  });
+
+  it("uses the runtime list and always includes UTC first", () => {
+    // Arrange
+    intl.supportedValuesOf = () => ["Europe/Warsaw", "Asia/Tokyo"];
+
+    // Act
+    const result = getTimeZoneOptions();
+
+    // Assert
+    expect(result).toEqual(["UTC", "Asia/Tokyo", "Europe/Warsaw"]);
+  });
+
+  it("falls back to a static list including UTC when Intl.supportedValuesOf is missing", () => {
+    // Arrange
+    intl.supportedValuesOf = undefined;
+
+    // Act
+    const result = getTimeZoneOptions();
+
+    // Assert
+    expect(result[0]).toBe("UTC");
+    expect(result).toContain("Europe/London");
+  });
+
+  it("falls back when Intl.supportedValuesOf throws", () => {
+    // Arrange
+    intl.supportedValuesOf = () => {
+      throw new RangeError("unsupported");
+    };
+
+    // Act & Assert
+    expect(getTimeZoneOptions()).toContain("UTC");
+  });
+
+  it("keeps the current value as an option even if the runtime does not list it", () => {
+    // Arrange
+    intl.supportedValuesOf = () => ["Europe/Warsaw"];
+
+    // Act
+    const result = getTimeZoneOptions("Etc/Custom");
+
+    // Assert
+    expect(result).toContain("Etc/Custom");
+  });
+});
