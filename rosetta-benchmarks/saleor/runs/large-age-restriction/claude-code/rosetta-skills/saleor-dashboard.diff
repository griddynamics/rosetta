@@ -0,0 +1,69 @@
+import Wrapper from "@test/wrapper";
+import { render, screen, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+
+import { ProductDetailsForm } from "./ProductDetailsForm";
+
+jest.mock("@dashboard/utils/richText/context", () => ({
+  useRichTextContext: () => ({
+    editorRef: { current: null },
+    defaultValue: undefined,
+    isReadyForMount: false,
+    handleChange: jest.fn(),
+  }),
+}));
+
+const data = { description: { blocks: [] }, name: "Wine", rating: null };
+
+const renderForm = (props: Partial<React.ComponentProps<typeof ProductDetailsForm>> = {}) => {
+  const onChange = jest.fn();
+
+  render(
+    <Wrapper>
+      <ProductDetailsForm data={data} errors={[]} onChange={onChange} {...props} />
+    </Wrapper>,
+  );
+
+  return { onChange };
+};
+
+// macaw's Checkbox puts data-test-id on its wrapper, so drill down to the Radix control.
+const getCheckbox = () =>
+  within(screen.getByTestId("product-age-restricted")).getByRole("checkbox");
+
+describe("ProductDetailsForm age restriction", () => {
+  it("does not render the checkbox when ageRestriction is not provided (create page)", () => {
+    // Arrange & Act
+    renderForm();
+
+    // Assert
+    expect(screen.queryByTestId("product-age-restricted")).not.toBeInTheDocument();
+  });
+
+  it.each([true, false])("reflects the current value %s", value => {
+    // Arrange & Act
+    renderForm({ ageRestriction: { value } });
+
+    // Assert
+    expect(getCheckbox()).toHaveAttribute("aria-checked", String(value));
+  });
+
+  it("emits a change event with the toggled boolean", async () => {
+    // Arrange
+    const { onChange } = renderForm({ ageRestriction: { value: false } });
+
+    // Act
+    await userEvent.click(getCheckbox());
+
+    // Assert
+    expect(onChange).toHaveBeenCalledWith({ target: { name: "isAgeRestricted", value: true } });
+  });
+
+  it("disables the checkbox when the form is disabled", () => {
+    // Arrange & Act
+    renderForm({ ageRestriction: { value: false }, disabled: true });
+
+    // Assert
+    expect(getCheckbox()).toBeDisabled();
+  });
+});
