+
+import {
+  type FormsetLineReasonData,
+  type FormsetQuantityData,
+  type FormsetReplacementData,
+  type LineItemData,
+} from "../form";
+import ItemsCard from "./ReturnItemsCard";
+
+const order = orderFixture("https://example.com/image.png");
+
+const withAgeLabel = (line: OrderLineFragment, ageLabel: string | null): OrderLineFragment => ({
+  ...line,
+  variant: { ...line.variant!, product: { ...line.variant!.product, ageLabel } },
+});
+
+const renderCard = (lines: OrderLineFragment[]) => {
+  const lineData = (id: string): LineItemData => ({
+    isFulfillment: false,
+    isRefunded: false,
+    orderLineId: id,
+  });
+  const itemsQuantities: FormsetQuantityData = lines.map(line => ({
+    id: line.id,
+    label: line.productName,
+    data: lineData(line.id),
+    value: 0,
+  }));
+  const itemsSelections: FormsetReplacementData = lines.map(line => ({
+    id: line.id,
+    label: line.productName,
+    data: lineData(line.id),
+    value: false,
+  }));
+  const lineReasons: FormsetLineReasonData = lines.map(line => ({
+    id: line.id,
+    label: line.productName,
+    data: lineData(line.id),
+    value: { reason: "", reasonReference: "" },
+  }));
+
+  return render(
+    <MemoryRouter>
+      <Wrapper>
+        <ItemsCard
+          lines={lines}
+          order={order}
+          errors={[]}
+          itemsQuantities={itemsQuantities}
+          itemsSelections={itemsSelections}
+          lineReasons={lineReasons}
+          reasonReferenceTypeId=""
+          onChangeQuantity={jest.fn()}
+          onChangeSelected={jest.fn()}
+          onChangeLineReason={jest.fn()}
+          onSetMaxQuantity={jest.fn()}
+        />
+      </Wrapper>
+    </MemoryRouter>,
+  );
+};
+
+describe("ReturnItemsCard", () => {
+  it("labels only the restricted line and keeps every line listed", () => {
+    // Arrange
+    const [first, second] = order.lines;
+    const lines = [withAgeLabel(first, "18+"), withAgeLabel(second, null)];
+
+    // Act
+    renderCard(lines);
+
+    // Assert
+    expect(screen.getByText(first.productName)).toBeInTheDocument();
+    expect(screen.getByText(second.productName)).toBeInTheDocument();
+    expect(screen.getAllByTestId("product-age-label")).toHaveLength(1);
+    expect(screen.getByTestId("product-age-label")).toHaveTextContent("18+");
+  });
+});
