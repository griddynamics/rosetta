@@ -0,0 +1,31 @@
+import { Box, Text } from "@saleor/macaw-ui-next";
+
+interface AgeLabelChipProps {
+  /** Verbatim `Product.ageLabel` from the API (e.g. "18+"); nothing renders when empty. */
+  label?: string | null;
+}
+
+export const AgeLabelChip = ({ label }: AgeLabelChipProps) => {
+  if (!label) {
+    return null;
+  }
+
+  return (
+    <Box
+      as="span"
+      data-test-id="product-age-label"
+      display="inline-flex"
+      alignItems="center"
+      paddingX={2}
+      backgroundColor="warning1"
+      borderColor="warning1"
+      borderWidth={1}
+      borderStyle="solid"
+      borderRadius={2}
+    >
+      <Text size={2} fontWeight="medium" color="warning1">
+        {label}
+      </Text>
+    </Box>
+  );
+};
diff --git a/src/products/components/ProductAgeRestrictionCard/ProductAgeRestrictionCard.test.tsx b/src/products/components/ProductAgeRestrictionCard/ProductAgeRestrictionCard.test.tsx
new file mode 100644
index 0000000..344aa71
--- /dev/null
+++ b/src/products/components/ProductAgeRestrictionCard/ProductAgeRestrictionCard.test.tsx
@@ -0,0 +1,57 @@
+import Wrapper from "@test/wrapper";
+import { fireEvent, render, screen } from "@testing-library/react";
+import type * as React from "react";
+
+import { ProductAgeRestrictionCard } from "./ProductAgeRestrictionCard";
+
+const wrapper = ({ children }: { children: React.ReactNode }) => <Wrapper>{children}</Wrapper>;
+
+describe("ProductAgeRestrictionCard", () => {
+  it("reflects the current flag value", () => {
+    // Arrange & Act
+    render(<ProductAgeRestrictionCard isAgeRestricted disabled={false} onChange={jest.fn()} />, {
+      wrapper,
+    });
+
+    // Assert
+    expect(screen.getByRole("checkbox")).toBeChecked();
+  });
+
+  it.each([
+    [false, true],
+    [true, false],
+  ])("emits isAgeRestricted change when toggled from %s", (initial, expected) => {
+    // Arrange
+    const onChange = jest.fn();
+
+    render(
+      <ProductAgeRestrictionCard isAgeRestricted={initial} disabled={false} onChange={onChange} />,
+      {
+        wrapper,
+      },
+    );
+
+    // Act
+    fireEvent.click(screen.getByTestId("product-age-restricted"));
+
+    // Assert
+    expect(onChange).toHaveBeenCalledWith({
+      target: { name: "isAgeRestricted", value: expected },
+    });
+  });
+
+  it("does not emit changes while disabled", () => {
+    // Arrange
+    const onChange = jest.fn();
+
+    render(<ProductAgeRestrictionCard isAgeRestricted={false} disabled onChange={onChange} />, {
+      wrapper,
+    });
+
+    // Act
+    fireEvent.click(screen.getByTestId("product-age-restricted"));
+
+    // Assert
+    expect(onChange).not.toHaveBeenCalled();
+  });
+});
