diff --git a/src/siteSettings/components/SiteAgeRestrictionCard/SiteAgeRestrictionCard.tsx b/src/siteSettings/components/SiteAgeRestrictionCard/SiteAgeRestrictionCard.tsx
new file mode 100644
index 0000000..c6a7e52
--- /dev/null
+++ b/src/siteSettings/components/SiteAgeRestrictionCard/SiteAgeRestrictionCard.tsx
@@ -0,0 +1,68 @@
+import { type ShopErrorFragment } from "@dashboard/graphql";
+import { type FormChange } from "@dashboard/hooks/useForm";
+import { getFormErrors } from "@dashboard/utils/errors";
+import getShopErrorMessage from "@dashboard/utils/errors/shop";
+import { Box, Combobox, Input, type Option } from "@saleor/macaw-ui-next";
+import { useMemo } from "react";
+import { useIntl } from "react-intl";
+
+import { type SiteSettingsPageFormData } from "../SiteSettingsPage/SiteSettingsPage";
+import { messages } from "./messages";
+import { getTimeZoneOptions } from "./timeZones";
+
+interface SiteAgeRestrictionFieldsProps {
+  data: Pick<SiteSettingsPageFormData, "minimumAge" | "timeZone">;
+  errors: ShopErrorFragment[];
+  disabled: boolean;
+  onChange: FormChange;
+}
+
+/** Form fields for the store-wide minimum age and shop time zone, used inside SettingsSection. */
+export const SiteAgeRestrictionFields = ({
+  data,
+  disabled,
+  errors,
+  onChange,
+}: SiteAgeRestrictionFieldsProps): React.ReactNode => {
+  const intl = useIntl();
+  const formErrors = getFormErrors(["minimumAge", "timeZone"], errors);
+  const options = useMemo<Option[]>(
+    () => getTimeZoneOptions(undefined, data.timeZone).map(zone => ({ label: zone, value: zone })),
+    [data.timeZone],
+  );
+  const selectedTimeZone = options.find(option => option.value === data.timeZone) ?? null;
+
+  return (
+    <Box display="flex" flexDirection="column" gap={5}>
+      <Input
+        data-test-id="minimum-age-input"
+        type="number"
+        min={1}
+        max={120}
+        name="minimumAge"
+        label={intl.formatMessage(messages.minimumAgeLabel)}
+        value={data.minimumAge}
+        disabled={disabled}
+        error={!!formErrors.minimumAge}
+        helperText={
+          getShopErrorMessage(formErrors.minimumAge, intl) ??
+          intl.formatMessage(messages.minimumAgeHelper)
+        }
+        onChange={onChange}
+      />
+      <Combobox
+        data-test-id="shop-time-zone-select"
+        label={intl.formatMessage(messages.timeZoneLabel)}
+        options={options}
+        value={selectedTimeZone}
+        disabled={disabled}
+        error={!!formErrors.timeZone}
+        helperText={
+          getShopErrorMessage(formErrors.timeZone, intl) ??
+          intl.formatMessage(messages.timeZoneHelper)
+        }
+        onChange={option => onChange({ target: { name: "timeZone", value: option?.value ?? "" } })}
+      />
+    </Box>
+  );
+};
