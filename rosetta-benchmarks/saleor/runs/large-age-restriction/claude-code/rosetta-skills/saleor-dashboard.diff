@@ -0,0 +1,46 @@
+import { DashboardCard } from "@dashboard/components/Card";
+import { type ChangeEvent } from "@dashboard/hooks/useForm";
+import { Box, Checkbox, Text } from "@saleor/macaw-ui-next";
+import { FormattedMessage } from "react-intl";
+
+import { messages } from "./messages";
+
+interface ProductAgeRestrictionCardProps {
+  isAgeRestricted: boolean;
+  disabled: boolean;
+  onChange: (event: ChangeEvent) => void;
+}
+
+export const ProductAgeRestrictionCard = ({
+  isAgeRestricted,
+  disabled,
+  onChange,
+}: ProductAgeRestrictionCardProps) => (
+  <DashboardCard>
+    <DashboardCard.Header>
+      <DashboardCard.Title>
+        <FormattedMessage {...messages.title} />
+      </DashboardCard.Title>
+    </DashboardCard.Header>
+    <DashboardCard.Content>
+      <Box>
+        <Checkbox
+          data-test-id="product-age-restricted"
+          name="isAgeRestricted"
+          checked={isAgeRestricted}
+          disabled={disabled}
+          onCheckedChange={value => onChange({ target: { name: "isAgeRestricted", value } })}
+        >
+          <Text>
+            <FormattedMessage {...messages.ageRestricted} />
+          </Text>
+        </Checkbox>
+        <Text marginLeft={5} size={2} color="default2">
+          <FormattedMessage {...messages.ageRestrictedDescription} />
+        </Text>
+      </Box>
+    </DashboardCard.Content>
+  </DashboardCard>
+);
+
+ProductAgeRestrictionCard.displayName = "ProductAgeRestrictionCard";
