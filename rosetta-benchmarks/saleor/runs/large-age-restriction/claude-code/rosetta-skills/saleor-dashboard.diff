@@ -0,0 +1,52 @@
+import { getBirthdaySubmitPatch, isCompleteIsoDate } from "./birthdaySubmit";
+
+// Fake, non-personal values.
+const INITIAL = "2001-02-03";
+const base = { canViewBirthday: true, cleared: false, initial: INITIAL, value: INITIAL };
+
+describe("getBirthdaySubmitPatch", () => {
+  it("omits the key for an empty (partially typed) value", () => {
+    expect(getBirthdaySubmitPatch({ ...base, value: "" })).toEqual({});
+  });
+
+  it("omits the key for an incomplete value", () => {
+    expect(getBirthdaySubmitPatch({ ...base, value: "2002-03" })).toEqual({});
+  });
+
+  it("omits the key when the date is unchanged", () => {
+    expect(getBirthdaySubmitPatch(base)).toEqual({});
+  });
+
+  it("sends null only for an explicit clear", () => {
+    expect(getBirthdaySubmitPatch({ ...base, cleared: true, value: "" })).toEqual({
+      birthday: null,
+    });
+  });
+
+  it("sends a valid changed date", () => {
+    expect(getBirthdaySubmitPatch({ ...base, value: "2002-03-04" })).toEqual({
+      birthday: "2002-03-04",
+    });
+  });
+
+  it("never sends anything for a non-superuser", () => {
+    expect(
+      getBirthdaySubmitPatch({
+        ...base,
+        canViewBirthday: false,
+        cleared: true,
+        value: "2002-03-04",
+      }),
+    ).toEqual({});
+  });
+});
+
+describe("isCompleteIsoDate", () => {
+  it.each(["2002-03-04", "2024-02-29"])("accepts %s", value => {
+    expect(isCompleteIsoDate(value)).toBe(true);
+  });
+
+  it.each(["", "2002-03", "2002-13-01", "2023-02-29", "02-03-2002"])("rejects %p", value => {
+    expect(isCompleteIsoDate(value)).toBe(false);
+  });
+});
diff --git a/src/customers/components/CustomerDetailsPage/birthdaySubmit.ts b/src/customers/components/CustomerDetailsPage/birthdaySubmit.ts
new file mode 100644
index 0000000..5393cec
--- /dev/null
+++ b/src/customers/components/CustomerDetailsPage/birthdaySubmit.ts
@@ -0,0 +1,50 @@
+const ISO_DATE = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+/** True only for a complete, real calendar date in YYYY-MM-DD form. */
+export const isCompleteIsoDate = (value: string): boolean => {
+  const match = ISO_DATE.exec(value);
+
+  if (!match) {
+    return false;
+  }
+
+  const [year, month, day] = [Number(match[1]), Number(match[2]), Number(match[3])];
+  const date = new Date(Date.UTC(year, month - 1, day));
+
+  return (
+    date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day
+  );
+};
+
+/**
+ * Builds the optional `birthday` part of the submit payload.
+ * - non-superuser: never sent (the API rejects the field even when unchanged)
+ * - explicit clear: `null`
+ * - complete valid date that differs from the stored one: the date
+ * - anything else (including an empty, partially typed input): key omitted
+ */
+export const getBirthdaySubmitPatch = ({
+  canViewBirthday,
+  cleared,
+  initial,
+  value,
+}: {
+  canViewBirthday: boolean;
+  cleared: boolean;
+  initial: string;
+  value: string;
+}): { birthday?: string | null } => {
+  if (!canViewBirthday) {
+    return {};
+  }
+
+  if (cleared && initial) {
+    return { birthday: null };
+  }
+
+  if (isCompleteIsoDate(value) && value !== initial) {
+    return { birthday: value };
+  }
+
+  return {};
+};
