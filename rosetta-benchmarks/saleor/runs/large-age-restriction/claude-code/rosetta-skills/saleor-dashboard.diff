+import { useUserPermissions } from "@dashboard/auth/hooks/useUserPermissions";
+import { AccountErrorCode, PermissionEnum } from "@dashboard/graphql";
+import Wrapper from "@test/wrapper";
+import { fireEvent, render, screen } from "@testing-library/react";
+
+import CustomerInfo from "./CustomerInfo";
+
+jest.mock("@dashboard/auth/hooks/useUserPermissions");
+
+const mockUseUserPermissions = useUserPermissions as jest.Mock;
+const permission = (code: PermissionEnum) => ({
+  __typename: "UserPermission" as const,
+  code,
+  name: code,
+});
+const data = { firstName: "Tom", lastName: "Cooper", email: "tom@example.com", note: "" };
+
+const renderInfo = (
+  props: Partial<React.ComponentProps<typeof CustomerInfo>> = {},
+  birthday = "",
+) => {
+  const onChange = jest.fn();
+
+  render(
+    <CustomerInfo
+      data={{ ...data, birthday }}
+      disabled={false}
+      errors={[]}
+      onChange={onChange}
+      {...props}
+    />,
+    { wrapper: Wrapper },
+  );
+
+  return { onChange };
+};
+
+describe("CustomerInfo age fields", () => {
+  beforeEach(() => {
+    mockUseUserPermissions.mockReturnValue([permission(PermissionEnum.MANAGE_USERS)]);
+  });
+
+  it("shows an editable date of birth when the viewer can manage birthdays", () => {
+    // Arrange & Act
+    renderInfo({ canManageBirthday: true, isAgeEligible: true }, "2000-02-29");
+
+    // Assert
+    expect(screen.getByTestId("customer-birthday")).toHaveValue("2000-02-29");
+    expect(screen.getByTestId("customer-birthday")).toHaveAttribute("type", "date");
+    expect(screen.queryByTestId("customer-age-eligible")).not.toBeInTheDocument();
+  });
+
+  it("reports date edits and clearing through onChange", () => {
+    // Arrange
+    const { onChange } = renderInfo({ canManageBirthday: true }, "2000-02-29");
+
+    // Act
+    fireEvent.change(screen.getByTestId("customer-birthday"), { target: { value: "1999-12-31" } });
+    fireEvent.click(screen.getByTestId("customer-birthday-clear"));
+
+    // Assert
+    expect(onChange).toHaveBeenCalledTimes(2);
+    expect(onChange).toHaveBeenLastCalledWith({ target: { name: "birthday", value: "" } });
+  });
+
+  it("offers no clear button while the birthday is empty", () => {
+    // Arrange & Act
+    renderInfo({ canManageBirthday: true });
+
+    // Assert
+    expect(screen.queryByTestId("customer-birthday-clear")).not.toBeInTheDocument();
+  });
+
+  it.each([
+    [true, "Age eligible: Yes"],
+    [false, "Age eligible: No"],
+  ])("shows %s as '%s' to MANAGE_USERS staff without the date", (isAgeEligible, text) => {
+    // Arrange & Act
+    renderInfo({ canManageBirthday: false, isAgeEligible });
+
+    // Assert
+    expect(screen.getByTestId("customer-age-eligible")).toHaveTextContent(text);
+    expect(screen.queryByTestId("customer-birthday")).not.toBeInTheDocument();
+  });
+
+  it("hides the indicator when eligibility is not disclosed (null)", () => {
+    // Arrange & Act
+    renderInfo({ canManageBirthday: false, isAgeEligible: null });
+
+    // Assert
+    expect(screen.queryByTestId("customer-age-eligible")).not.toBeInTheDocument();
+    expect(screen.queryByTestId("customer-birthday")).not.toBeInTheDocument();
+  });
+
+  it("hides the indicator without MANAGE_USERS even if a value is present", () => {
+    // Arrange
+    mockUseUserPermissions.mockReturnValue([permission(PermissionEnum.MANAGE_ORDERS)]);
+
+    // Act
+    renderInfo({ canManageBirthday: false, isAgeEligible: true });
+
+    // Assert
+    expect(screen.queryByTestId("customer-age-eligible")).not.toBeInTheDocument();
+  });
+
+  it("shows the INVALID birthday error under the date input", () => {
+    // Arrange & Act
+    renderInfo({
+      canManageBirthday: true,
+      errors: [
+        {
+          __typename: "AccountError",
+          code: AccountErrorCode.INVALID,
+          field: "birthday",
+          message: null,
+          addressType: null,
+          attributes: null,
+        },
+      ],
+    });
+
+    // Assert
+    expect(
+      screen.getByText("Enter a valid date of birth that is not in the future"),
+    ).toBeInTheDocument();
+  });
+});
