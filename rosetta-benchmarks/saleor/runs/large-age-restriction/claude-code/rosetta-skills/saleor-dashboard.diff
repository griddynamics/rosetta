diff --git a/src/customers/queries.test.ts b/src/customers/queries.test.ts
new file mode 100644
index 0000000..f06e842
--- /dev/null
+++ b/src/customers/queries.test.ts
@@ -0,0 +1,60 @@
+import {
+  CreateCustomerDocument,
+  CustomerAddressesDocument,
+  CustomerBirthdayDocument,
+  CustomerBirthdayUpdateDocument,
+  CustomerDetailsDocument,
+  ListCustomersDocument,
+  UpdateCustomerDocument,
+} from "@dashboard/graphql";
+import { resolveLockedSchemaFields } from "@dashboard/graphql/lockSchema";
+import { type DocumentNode, print } from "graphql";
+
+// Birthday is PII: P13 allows requesting it only in the capability-gated queries below.
+const BIRTHDAY_FIELD = /\bbirthday\b/;
+const printMain = (document: DocumentNode) => print(resolveLockedSchemaFields(document, "main"));
+
+describe("customer documents and the birthday field", () => {
+  it.each([
+    ["CustomerDetails", CustomerDetailsDocument],
+    ["ListCustomers", ListCustomersDocument],
+    ["CustomerAddresses", CustomerAddressesDocument],
+    ["UpdateCustomer", UpdateCustomerDocument],
+    ["CreateCustomer", CreateCustomerDocument],
+  ])("%s never selects birthday", (_name, document) => {
+    // Arrange & Act
+    const query = printMain(document);
+
+    // Assert
+    expect(query).not.toMatch(BIRTHDAY_FIELD);
+  });
+
+  it("exposes the capability flags without the date in the details query", () => {
+    // Arrange & Act
+    const query = printMain(CustomerDetailsDocument);
+
+    // Assert
+    expect(query).toContain("canManageBirthday");
+    expect(query).toContain("isAgeEligible");
+  });
+
+  it("selects birthday only in the dedicated query and its mutation", () => {
+    // Arrange & Act
+    const query = printMain(CustomerBirthdayDocument);
+    const mutation = printMain(CustomerBirthdayUpdateDocument);
+
+    // Assert
+    expect(query).toMatch(BIRTHDAY_FIELD);
+    expect(mutation).toContain("customerBirthdayUpdate");
+    expect(mutation).toContain("$birthday: Date");
+  });
+
+  it("drops the main-only fields from shared documents when the staging schema is active", () => {
+    // Arrange & Act
+    const query = print(resolveLockedSchemaFields(CustomerDetailsDocument, "staging"));
+
+    // Assert
+    expect(query).not.toContain("canManageBirthday");
+    expect(query).not.toContain("isAgeEligible");
+  });
+});
