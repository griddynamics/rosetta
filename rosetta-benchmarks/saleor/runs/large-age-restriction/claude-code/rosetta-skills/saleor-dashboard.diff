diff --git a/src/siteSettings/components/SiteAgeRestrictionCard/timeZones.test.ts b/src/siteSettings/components/SiteAgeRestrictionCard/timeZones.test.ts
new file mode 100644
index 0000000..77aabab
--- /dev/null
+++ b/src/siteSettings/components/SiteAgeRestrictionCard/timeZones.test.ts
@@ -0,0 +1,36 @@
+import { getTimeZoneOptions } from "./timeZones";
+
+describe("getTimeZoneOptions", () => {
+  it("puts UTC first even when the browser list omits it", () => {
+    // Arrange & Act
+    const result = getTimeZoneOptions(["Europe/Warsaw", "America/New_York"]);
+
+    // Assert
+    expect(result).toEqual(["UTC", "America/New_York", "Europe/Warsaw"]);
+  });
+
+  it("does not duplicate UTC or the current zone", () => {
+    // Arrange & Act
+    const result = getTimeZoneOptions(["UTC", "Europe/Warsaw"], "Europe/Warsaw");
+
+    // Assert
+    expect(result).toEqual(["UTC", "Europe/Warsaw"]);
+  });
+
+  it("keeps a stored zone the browser does not know", () => {
+    // Arrange & Act
+    const result = getTimeZoneOptions(["Europe/Warsaw"], "Etc/Custom");
+
+    // Assert
+    expect(result).toEqual(["UTC", "Etc/Custom", "Europe/Warsaw"]);
+  });
+
+  it("falls back to the runtime list with UTC included", () => {
+    // Arrange & Act
+    const result = getTimeZoneOptions();
+
+    // Assert
+    expect(result[0]).toBe("UTC");
+    expect(result.length).toBeGreaterThan(1);
+  });
+});
