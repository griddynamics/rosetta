+export const MINIMUM_AGE_MIN = 1;
+export const MINIMUM_AGE_MAX = 120;
+
+export const isMinimumAgeValid = (value: string): boolean => {
+  if (!/^\d+$/.test(value)) {
+    return false;
+  }
+
+  const age = Number(value);
+
+  return age >= MINIMUM_AGE_MIN && age <= MINIMUM_AGE_MAX;
+};
