+import { type ShopErrorFragment } from "@dashboard/graphql";
+import { type FormChange } from "@dashboard/hooks/useForm";
+import { getFormErrors } from "@dashboard/utils/errors";
+import getShopErrorMessage from "@dashboard/utils/errors/shop";
+import { Box, Input, type Option, Select } from "@saleor/macaw-ui-next";
+import { useMemo } from "react";
+import { useIntl } from "react-intl";
+
+import { type SiteSettingsPageFormData } from "../SiteSettingsPage";
+import { messages } from "./messages";
+import { isMinimumAgeValid, MINIMUM_AGE_MAX, MINIMUM_AGE_MIN } from "./minimumAge";
+import { getTimeZoneOptions } from "./timeZones";
+
+interface AgeRestrictionFieldsProps {
+  data: Pick<SiteSettingsPageFormData, "minimumAge" | "timeZone">;
+  errors: ShopErrorFragment[];
+  disabled: boolean;
+  onChange: FormChange;
+}
+
+/** Minimum age and time zone used to evaluate customer age eligibility. */
+export const AgeRestrictionFields = ({
+  data,
+  disabled,
+  errors,
+  onChange,
+}: AgeRestrictionFieldsProps): React.ReactNode => {
+  const intl = useIntl();
+  const formErrors = getFormErrors(["minimumAge", "timeZone"], errors);
+  const options = useMemo(
+    () => getTimeZoneOptions(data.timeZone).map(zone => ({ label: zone, value: zone })),
+    [data.timeZone],
+  );
+  const isAgeInvalid = !isMinimumAgeValid(data.minimumAge);
+
+  return (
+    <Box display="flex" flexDirection="column" gap={5}>
+      <Input
+        data-test-id="minimum-age-input"
+        name="minimumAge"
+        type="number"
+        min={MINIMUM_AGE_MIN}
+        max={MINIMUM_AGE_MAX}
+        step={1}
+        label={intl.formatMessage(messages.minimumAgeLabel)}
+        value={data.minimumAge}
+        disabled={disabled}
+        error={isAgeInvalid || !!formErrors.minimumAge}
+        helperText={
+          getShopErrorMessage(formErrors.minimumAge, intl) ||
+          intl.formatMessage(messages.minimumAgeHelper, {
+            min: MINIMUM_AGE_MIN,
+            max: MINIMUM_AGE_MAX,
+          })
+        }
+        onChange={onChange}
+      />
+      <Select
+        data-test-id="time-zone-select"
+        label={intl.formatMessage(messages.timeZoneLabel)}
+        options={options}
+        value={data.timeZone}
+        disabled={disabled}
+        error={!!formErrors.timeZone}
+        helperText={
+          getShopErrorMessage(formErrors.timeZone, intl) ||
+          intl.formatMessage(messages.timeZoneHelper)
+        }
+        onChange={(selected: string | Option | null) => {
+          const value = typeof selected === "string" ? selected : selected?.value;
+
+          if (value) {
+            onChange({ target: { name: "timeZone", value } });
+          }
+        }}
+      />
+    </Box>
+  );
+};
