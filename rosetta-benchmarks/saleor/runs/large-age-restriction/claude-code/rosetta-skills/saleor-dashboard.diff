@@ -0,0 +1,63 @@
+import { GridTable } from "@dashboard/components/GridTable";
+import { DndContext } from "@dnd-kit/core";
+import { SortableContext } from "@dnd-kit/sortable";
+import Wrapper from "@test/wrapper";
+import { render, screen } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+
+import { ProductTableItem } from "./ProductTableItem";
+import { type Product } from "./types";
+
+const buildProduct = (ageLabel: string | null): Product => ({
+  __typename: "Product",
+  id: "UHJvZHVjdDox",
+  name: "Apple Juice",
+  ageLabel,
+  productType: { __typename: "ProductType", id: "pt-1", name: "Beverages" },
+  thumbnail: null,
+  channelListings: [],
+});
+
+const renderItem = (product: Product) =>
+  render(
+    <MemoryRouter>
+      <Wrapper>
+        <DndContext>
+          <SortableContext items={[product.id]}>
+            <GridTable>
+              <GridTable.Body>
+                <ProductTableItem
+                  product={product}
+                  isSelected={false}
+                  draggable
+                  toggle={jest.fn()}
+                  onProductUnassign={jest.fn()}
+                />
+              </GridTable.Body>
+            </GridTable>
+          </SortableContext>
+        </DndContext>
+      </Wrapper>
+    </MemoryRouter>,
+  );
+
+describe("ProductTableItem", () => {
+  it("shows the age label next to a restricted product and still renders the row", () => {
+    // Arrange & Act
+    renderItem(buildProduct("18+"));
+
+    // Assert
+    expect(screen.getByTestId("assign-product-table-row")).toBeInTheDocument();
+    expect(screen.getByText("Apple Juice")).toBeInTheDocument();
+    expect(screen.getByTestId("product-age-label")).toHaveTextContent("18+");
+  });
+
+  it("shows no age label for an unrestricted product", () => {
+    // Arrange & Act
+    renderItem(buildProduct(null));
+
+    // Assert
+    expect(screen.getByText("Apple Juice")).toBeInTheDocument();
+    expect(screen.queryByTestId("product-age-label")).not.toBeInTheDocument();
+  });
+});
