+import Wrapper from "@test/wrapper";
+import { render, screen, within } from "@testing-library/react";
+
+import { AssignProductPickerList } from "./AssignProductPickerList";
+import { searchProducts } from "./fixtures";
+import { type AssignProductPicker } from "./useAssignProductPicker";
+
+const noop = jest.fn();
+
+const buildPicker = (displayedProducts: AssignProductPicker["displayedProducts"]) =>
+  ({
+    confirmButtonState: "default",
+    displayedProducts,
+    handleChange: noop,
+    handleClose: noop,
+    handleSubmit: noop,
+    handleToggleSelectAllVisible: noop,
+    hasMore: false,
+    hasSelectionChanged: false,
+    isProductAvailable: () => true,
+    loading: false,
+    onFetchMore: noop,
+    onQueryChange: noop,
+    productUnavailableText: undefined,
+    productsDict: {},
+    query: "",
+    resumeBackfill: noop,
+    selectAllCheckboxState: { checked: false, indeterminate: false },
+    selectedCount: 0,
+    showBackfillExhausted: false,
+    showEmptyState: false,
+    showListLoading: false,
+    showSelectAll: false,
+    showSelectAllScrollHint: false,
+  }) as AssignProductPicker;
+
+const renderList = (products: AssignProductPicker["displayedProducts"]) =>
+  render(
+    <Wrapper>
+      <div id="scroll-target">
+        <AssignProductPickerList
+          picker={buildPicker(products)}
+          scrollableTargetId="scroll-target"
+        />
+      </div>
+    </Wrapper>,
+  );
+
+describe("AssignProductPickerList", () => {
+  it("shows the age label on a restricted product row and keeps unrestricted rows without one", () => {
+    // Arrange
+    const [first, second] = searchProducts;
+    const products = [
+      { ...first, ageLabel: "18+" },
+      { ...second, ageLabel: null },
+    ];
+
+    // Act
+    renderList(products);
+
+    // Assert
+    const rows = screen.getAllByTestId("assign-product-table-row");
+
+    expect(rows).toHaveLength(2);
+    expect(within(rows[0]).getByTestId("product-age-label")).toHaveTextContent("18+");
+    expect(within(rows[1]).queryByTestId("product-age-label")).not.toBeInTheDocument();
+  });
+
+  it("does not filter out restricted products", () => {
+    // Arrange
+    const products = searchProducts.map(product => ({ ...product, ageLabel: "21+" }));
+
+    // Act
+    renderList(products);
+
+    // Assert
+    expect(screen.getAllByTestId("assign-product-table-row")).toHaveLength(products.length);
+    expect(screen.getAllByTestId("product-age-label")).toHaveLength(products.length);
+  });
+});
