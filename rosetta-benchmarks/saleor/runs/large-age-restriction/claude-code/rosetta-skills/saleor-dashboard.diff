+import { type GetCellContentOpts } from "@dashboard/components/Datagrid/Datagrid";
+import { Locale } from "@dashboard/components/Locale/Locale";
+import { type OrderLineFragment } from "@dashboard/graphql";
+import { OrderFixture } from "@dashboard/orders/fixtures/OrderFixture";
+import { type IntlShape } from "react-intl";
+
+import { createGetCellContent } from "./datagrid";
+
+const intl = {
+  formatMessage: (descriptor: { defaultMessage: string }) => descriptor.defaultMessage,
+} as unknown as IntlShape;
+const columns = [
+  { id: "empty", title: "", width: 10 },
+  { id: "product", title: "Product", width: 300 },
+];
+const cellOpts: GetCellContentOpts = {
+  changes: { current: [] },
+  added: [],
+  removed: [],
+  getChangeIndex: () => -1,
+};
+
+const lineWithAgeLabel = (ageLabel: string | null): OrderLineFragment => {
+  const [line] = OrderFixture.fulfilled().build().lines;
+
+  return {
+    ...line,
+    variant: { ...line.variant!, product: { ...line.variant!.product, ageLabel } },
+  };
+};
+
+const getProductCellName = (lines: OrderLineFragment[], row = 0) => {
+  const getCellContent = createGetCellContent({
+    columns,
+    data: lines,
+    loading: false,
+    intl,
+    locale: Locale.EN,
+    onOrderLineShowMetadata: jest.fn(),
+  });
+  const cell = getCellContent([1, row], cellOpts) as unknown as { data: { name: string } };
+
+  return cell.data.name;
+};
+
+describe("OrderDetailsDatagrid createGetCellContent product column", () => {
+  it("shows the age label next to the product name", () => {
+    // Arrange
+    const line = lineWithAgeLabel("18+");
+
+    // Act
+    const name = getProductCellName([line]);
+
+    // Assert
+    expect(name).toBe(`${line.productName} (18+)`);
+  });
+
+  it("shows only the product name when the product is unrestricted", () => {
+    // Arrange
+    const line = lineWithAgeLabel(null);
+
+    // Act
+    const name = getProductCellName([line]);
+
+    // Assert
+    expect(name).toBe(line.productName);
+  });
+
+  it("keeps restricted lines in the grid next to unrestricted ones", () => {
+    // Arrange
+    const lines = [lineWithAgeLabel("18+"), lineWithAgeLabel(null)];
+
+    // Act
+    const names = [getProductCellName(lines, 0), getProductCellName(lines, 1)];
+
+    // Assert
+    expect(names).toEqual([`${lines[0].productName} (18+)`, lines[1].productName]);
+  });
+});
