@@ -0,0 +1,59 @@
+import Wrapper from "@test/wrapper";
+import { render, screen, within } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+
+import { ProductAgeRestricted } from "./ProductAgeRestricted";
+
+const checkbox = () => within(screen.getByTestId("age-restricted-checkbox")).getByRole("checkbox");
+
+describe("ProductAgeRestricted", () => {
+  it("reflects the current value and explains the restriction", () => {
+    // Arrange & Act
+    render(
+      <ProductAgeRestricted
+        data={{ isAgeRestricted: true }}
+        disabled={false}
+        onChange={jest.fn()}
+      />,
+      { wrapper: Wrapper },
+    );
+
+    // Assert
+    expect(checkbox()).toBeChecked();
+    expect(screen.getByText("Age restricted")).toBeInTheDocument();
+    expect(
+      screen.getByText(/Only customers who reached the store's minimum age can see and buy/),
+    ).toBeInTheDocument();
+  });
+
+  it("reports the new value through the form change handler", async () => {
+    // Arrange
+    const onChange = jest.fn();
+
+    render(
+      <ProductAgeRestricted
+        data={{ isAgeRestricted: false }}
+        disabled={false}
+        onChange={onChange}
+      />,
+      { wrapper: Wrapper },
+    );
+
+    // Act
+    await userEvent.click(checkbox());
+
+    // Assert
+    expect(onChange).toHaveBeenCalledWith({ target: { name: "isAgeRestricted", value: true } });
+  });
+
+  it("cannot be toggled while disabled", () => {
+    // Arrange & Act
+    render(
+      <ProductAgeRestricted data={{ isAgeRestricted: false }} disabled onChange={jest.fn()} />,
+      { wrapper: Wrapper },
+    );
+
+    // Assert
+    expect(checkbox()).toBeDisabled();
+  });
+});
