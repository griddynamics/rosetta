diff --git a/src/customers/components/CustomerInfo/CustomerInfo.test.tsx b/src/customers/components/CustomerInfo/CustomerInfo.test.tsx
new file mode 100644
index 0000000..d34f321
--- /dev/null
+++ b/src/customers/components/CustomerInfo/CustomerInfo.test.tsx
@@ -0,0 +1,64 @@
+import Wrapper from "@test/wrapper";
+import { render, screen } from "@testing-library/react";
+
+import CustomerInfo from "./CustomerInfo";
+
+const data = {
+  firstName: "Ada",
+  lastName: "Lovelace",
+  email: "ada@example.com",
+  note: "",
+};
+
+const renderInfo = (props: { ageEligible?: boolean | null; birthday?: string | null }) =>
+  render(
+    <CustomerInfo data={data} disabled={false} errors={[]} onChange={jest.fn()} {...props} />,
+    {
+      wrapper: Wrapper,
+    },
+  );
+
+describe("CustomerInfo age details", () => {
+  it("shows eligibility and birthday when the API returned them", () => {
+    // Arrange & Act
+    renderInfo({ ageEligible: true, birthday: "1990-05-17" });
+
+    // Assert
+    expect(screen.getByTestId("customer-age-eligible")).toHaveTextContent("Age eligible: Yes");
+    expect(screen.getByTestId("customer-birthday")).toHaveTextContent("Birthday: 1990-05-17");
+  });
+
+  it("shows No when the customer is not old enough", () => {
+    // Arrange & Act
+    renderInfo({ ageEligible: false, birthday: null });
+
+    // Assert
+    expect(screen.getByTestId("customer-age-eligible")).toHaveTextContent("Age eligible: No");
+    expect(screen.queryByTestId("customer-birthday")).not.toBeInTheDocument();
+  });
+
+  it("hides everything when the API withheld both values", () => {
+    // Arrange & Act
+    renderInfo({ ageEligible: null, birthday: null });
+
+    // Assert
+    expect(screen.queryByTestId("customer-age-info")).not.toBeInTheDocument();
+  });
+
+  it("hides the age section when the values are absent", () => {
+    // Arrange & Act
+    renderInfo({});
+
+    // Assert
+    expect(screen.queryByTestId("customer-age-info")).not.toBeInTheDocument();
+  });
+
+  it("offers no birthday input", () => {
+    // Arrange & Act
+    renderInfo({ ageEligible: true, birthday: "1990-05-17" });
+
+    // Assert
+    expect(screen.queryByDisplayValue("1990-05-17")).not.toBeInTheDocument();
+    expect(screen.queryByLabelText(/birthday/i)).not.toBeInTheDocument();
+  });
+});
