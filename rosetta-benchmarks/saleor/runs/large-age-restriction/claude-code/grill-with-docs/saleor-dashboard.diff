diff --git a/schema-unreleased.graphql b/schema-unreleased.graphql
new file mode 100644
index 0000000..8d7835d
--- /dev/null
+++ b/schema-unreleased.graphql
@@ -0,0 +1,34 @@
+# Fields that exist in the staging schema (Saleor `main`) but not yet in the release that
+# schema-main.graphql is pinned to (config.saleor.schemaVersion). Only codegen-main and the main
+# graphql-config project load this file, so shared documents can select these fields behind
+# `@lockSchema(schema: "staging")` and still be validated and typed.
+#
+# Nothing here reaches the API on a main build: selections are stripped by `@lockSchema` and input
+# values are omitted by callers behind `isStagingSchema()`. Delete each extension once the field is
+# part of the pinned release schema, together with its `@lockSchema` and `isStagingSchema()` guards.
+
+# Age-restricted products (Saleor 3.24)
+extend type Product {
+  isAgeRestricted: Boolean!
+}
+
+extend input ProductCreateInput {
+  isAgeRestricted: Boolean
+}
+
+extend input ProductInput {
+  isAgeRestricted: Boolean
+}
+
+extend type Shop {
+  minimumAge: Int!
+}
+
+extend input ShopSettingsInput {
+  minimumAge: Int
+}
+
+extend type User {
+  ageEligible: Boolean
+  birthday: Date
+}
