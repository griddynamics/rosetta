diff --git a/src/siteSettings/utils.test.ts b/src/siteSettings/utils.test.ts
new file mode 100644
index 0000000..62c02e2
--- /dev/null
+++ b/src/siteSettings/utils.test.ts
@@ -0,0 +1,77 @@
+import { PasswordLoginModeEnum } from "@dashboard/graphql";
+import { isStagingSchema } from "@dashboard/graphql/schemaVersion";
+
+import { type SiteSettingsPageFormData } from "./components/SiteSettingsPage/SiteSettingsPage";
+import { getShopSettingsInput, isValidMinimumAge } from "./utils";
+
+jest.mock("@dashboard/graphql/schemaVersion", () => ({
+  isMainSchema: jest.fn(() => true),
+  isStagingSchema: jest.fn(() => false),
+}));
+
+const formData: SiteSettingsPageFormData = {
+  city: "",
+  companyName: "",
+  country: "",
+  countryArea: "",
+  phone: "",
+  postalCode: "",
+  streetAddress1: "",
+  streetAddress2: "",
+  name: "Store",
+  description: "",
+  emailConfirmation: false,
+  useLegacyUpdateWebhookEmission: true,
+  useLegacyShippingZoneStockAvailability: true,
+  preserveAllAddressFields: false,
+  passwordLoginMode: PasswordLoginModeEnum.ENABLED,
+  allowStorefrontTraffic: true,
+  minimumAge: "21",
+};
+
+describe("getShopSettingsInput", () => {
+  afterEach(() => {
+    (isStagingSchema as jest.Mock).mockReturnValue(false);
+  });
+
+  it("sends minimumAge as a number on the staging schema", () => {
+    // Arrange
+    (isStagingSchema as jest.Mock).mockReturnValue(true);
+
+    // Act
+    const input = getShopSettingsInput(formData);
+
+    // Assert
+    expect(input.minimumAge).toBe(21);
+  });
+
+  it("sends 0, a valid minimum age, rather than dropping it", () => {
+    // Arrange
+    (isStagingSchema as jest.Mock).mockReturnValue(true);
+
+    // Act
+    const input = getShopSettingsInput({ ...formData, minimumAge: "0" });
+
+    // Assert
+    expect(input.minimumAge).toBe(0);
+  });
+
+  it("never sends minimumAge on the main schema, whose API does not know the field", () => {
+    // Arrange & Act
+    const input = getShopSettingsInput(formData);
+
+    // Assert
+    expect(input).not.toHaveProperty("minimumAge");
+    expect(input.name).toBe("Store");
+  });
+});
+
+describe("isValidMinimumAge", () => {
+  it.each(["0", "18", "150"])("accepts %s", value => {
+    expect(isValidMinimumAge(value)).toBe(true);
+  });
+
+  it.each(["", " ", "-1", "151", "18.5", "abc"])("rejects %j", value => {
+    expect(isValidMinimumAge(value)).toBe(false);
+  });
+});
diff --git a/src/siteSettings/utils.ts b/src/siteSettings/utils.ts
new file mode 100644
index 0000000..e4410fa
--- /dev/null
+++ b/src/siteSettings/utils.ts
@@ -0,0 +1,30 @@
+import { type ShopSettingsInput } from "@dashboard/graphql";
+import { isStagingSchema } from "@dashboard/graphql/schemaVersion";
+
+import { type SiteSettingsPageFormData } from "./components/SiteSettingsPage/SiteSettingsPage";
+
+export const DEFAULT_MINIMUM_AGE = 18;
+export const MINIMUM_AGE_MIN = 0;
+export const MINIMUM_AGE_MAX = 150;
+
+/** The API accepts whole years from 0 to 150. */
+export function isValidMinimumAge(value: string): boolean {
+  const age = Number(value);
+
+  return (
+    value.trim() !== "" && Number.isInteger(age) && age >= MINIMUM_AGE_MIN && age <= MINIMUM_AGE_MAX
+  );
+}
+
+export const getShopSettingsInput = (data: SiteSettingsPageFormData): ShopSettingsInput => ({
+  name: data.name,
+  description: data.description,
+  enableAccountConfirmationByEmail: data.emailConfirmation,
+  useLegacyUpdateWebhookEmission: data.useLegacyUpdateWebhookEmission,
+  useLegacyShippingZoneStockAvailability: data.useLegacyShippingZoneStockAvailability,
+  preserveAllAddressFields: data.preserveAllAddressFields,
+  passwordLoginMode: data.passwordLoginMode,
+  allowStorefrontTraffic: data.allowStorefrontTraffic,
+  // The API only knows the field since Saleor 3.24, so a main (3.23) build must not send it.
+  ...(isStagingSchema() ? { minimumAge: Number(data.minimumAge) } : {}),
+});
