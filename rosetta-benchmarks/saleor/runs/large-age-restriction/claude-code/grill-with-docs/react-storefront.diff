+import { readdirSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+
+const DIR = join(import.meta.dirname, "../../messages");
+
+const KEYS = [
+	"cart.errors.ageRestricted",
+	"cart.errors.ageRestrictedSignIn",
+	"cart.errors.signIn",
+	"pdp.ageGate.underage",
+	"pdp.ageGate.signInRequired",
+	"pdp.ageGate.signInAction",
+	"pdp.ageGate.birthdayRequired",
+	"pdp.ageGate.birthdayAction",
+	"pdp.ageGate.metaTitle",
+	"pdp.ageGate.placeholderLabel",
+	"account.fields.birthday",
+	"account.settings.birthdayHint",
+	"checkout.server.ageRestricted",
+	"checkout.server.ageRestrictedSignIn",
+];
+
+function read(messages: unknown, path: string): unknown {
+	return path
+		.split(".")
+		.reduce<unknown>((node, key) => (node as Record<string, unknown> | undefined)?.[key], messages);
+}
+
+describe("age-gate messages", () => {
+	const locales = readdirSync(DIR).filter((file) => file.endsWith(".json"));
+
+	it("ships the exact underage sentence in English", () => {
+		const en = JSON.parse(readFileSync(join(DIR, "en.json"), "utf8"));
+		expect(read(en, "pdp.ageGate.underage")).toBe(
+			"You are under age; we cannot display this product to you.",
+		);
+	});
+
+	for (const file of locales) {
+		it(`has every key in ${file}`, () => {
+			const messages = JSON.parse(readFileSync(join(DIR, file), "utf8"));
+			for (const key of KEYS) {
+				expect(typeof read(messages, key), `${file}: ${key}`).toBe("string");
+			}
+		});
+	}
+});
