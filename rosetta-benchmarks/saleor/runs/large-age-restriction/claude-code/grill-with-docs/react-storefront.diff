+import { readdirSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+
+const ROOT = join(import.meta.dirname, "../../..");
+
+/** The birthday is personal data: only the account profile query may select it. */
+const BIRTHDAY_READERS = new Set(["src/graphql/CurrentUserProfile.graphql"]);
+
+describe("birthday privacy", () => {
+	it("is selected only by the account profile query", () => {
+		const offenders: string[] = [];
+		for (const dir of ["src/graphql", "src/checkout/graphql"]) {
+			for (const file of readdirSync(join(ROOT, dir), { recursive: true })) {
+				if (typeof file !== "string" || !file.endsWith(".graphql")) continue;
+				const path = `${dir}/${file}`;
+				const text = readFileSync(join(ROOT, path), "utf8").replace(/#.*$/gm, "");
+				if (/\bbirthday\b/.test(text) && !BIRTHDAY_READERS.has(path)) offenders.push(path);
+			}
+		}
+		expect(offenders).toEqual([]);
+	});
+});
