index 0000000..01a1982
--- /dev/null
+++ b/src/ui/components/pdp/age-gated-product.test.ts
@@ -0,0 +1,46 @@
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it, vi } from "vitest";
+import enMessages from "../../../../messages/en.json";
+
+vi.mock("next/navigation", () => ({ useParams: () => ({ locale: "en", channel: "default-channel" }) }));
+
+const { AgeGatedProduct } = await import("./age-gated-product");
+
+const messages = {
+	...enMessages.pdp.ageGate,
+};
+
+function render(reason: "UNDERAGE" | "SIGN_IN_REQUIRED" | "BIRTHDAY_REQUIRED") {
+	return renderToStaticMarkup(
+		createElement(AgeGatedProduct, { reason, loginHref: "/en/default-channel/login", messages }),
+	);
+}
+
+describe("AgeGatedProduct", () => {
+	it("tells an underage viewer exactly why, with no link", () => {
+		const html = render("UNDERAGE");
+		expect(html).toContain("You are under age; we cannot display this product to you.");
+		expect(html).not.toContain("<a ");
+	});
+
+	it("asks a guest to sign in and links to the login flow", () => {
+		const html = render("SIGN_IN_REQUIRED");
+		expect(html).toContain(enMessages.pdp.ageGate.signInRequired);
+		expect(html).toContain('href="/en/default-channel/login"');
+	});
+
+	it("asks a customer without a birthday to add it in account settings", () => {
+		const html = render("BIRTHDAY_REQUIRED");
+		expect(html).toContain(enMessages.pdp.ageGate.birthdayRequired);
+		expect(html).toContain("/en/default-channel/account/settings");
+	});
+
+	it("blurs a placeholder and offers no buy controls", () => {
+		const html = render("UNDERAGE");
+		expect(html).toContain("blur-xl");
+		expect(html).toContain('aria-hidden="true"');
+		expect(html).not.toContain("<button");
+		expect(html).not.toContain("<form");
+	});
+});
diff --git a/src/ui/components/pdp/age-gated-product.tsx b/src/ui/components/pdp/age-gated-product.tsx
new file mode 100644
index 0000000..0ea1733
--- /dev/null
+++ b/src/ui/components/pdp/age-gated-product.tsx
@@ -0,0 +1,87 @@
+import { cn } from "@/lib/utils";
+import { LinkWithChannel } from "@/ui/atoms/link-with-channel";
+import { StorefrontHardLink } from "@/ui/atoms/storefront-hard-link";
+import { PDP_GALLERY_LAYOUT, PDP_LAYOUT_CLASSES } from "./gallery-layout";
+
+export type AgeGateReason = "UNDERAGE" | "SIGN_IN_REQUIRED" | "BIRTHDAY_REQUIRED";
+
+type AgeGatedProductProps = {
+	reason: AgeGateReason;
+	/** Prebuilt login URL (`/{locale}/{channel}/login`). */
+	loginHref: string;
+	messages: {
+		underage: string;
+		signInRequired: string;
+		signInAction: string;
+		birthdayRequired: string;
+		birthdayAction: string;
+		placeholderLabel: string;
+	};
+};
+
+/**
+ * Blurred PDP for a viewer who may not see an age-restricted product.
+ * The API returns no product data for this viewer, so this renders a generic placeholder
+ * (never real name, media or price) under an overlay that says why and what to do.
+ * There are no add-to-cart controls here.
+ */
+export function AgeGatedProduct({ reason, loginHref, messages }: AgeGatedProductProps) {
+	const layout = PDP_LAYOUT_CLASSES[PDP_GALLERY_LAYOUT];
+
+	const text =
+		reason === "UNDERAGE"
+			? messages.underage
+			: reason === "SIGN_IN_REQUIRED"
+				? messages.signInRequired
+				: messages.birthdayRequired;
+
+	return (
+		<div className={cn("relative", layout.main)} data-age-gate={reason}>
+			<div
+				aria-hidden="true"
+				inert
+				className="pointer-events-none select-none blur-xl"
+				data-testid="age-gate-placeholder"
+			>
+				<div className={layout.grid}>
+					<div className={layout.galleryColumn}>
+						<div className="aspect-square w-full rounded bg-muted" />
+					</div>
+					<div className={layout.infoColumn}>
+						<div className="order-2 h-10 w-3/4 max-w-md rounded bg-muted" />
+						<div className="order-3 mt-4 space-y-3">
+							<div className="h-6 w-24 rounded bg-muted" />
+							<div className="h-14 w-full rounded bg-muted" />
+						</div>
+					</div>
+				</div>
+			</div>
+
+			<div className="absolute inset-0 flex items-start justify-center px-4 pt-16 sm:items-center sm:pt-0">
+				<div
+					role="alert"
+					aria-label={messages.placeholderLabel}
+					className="max-w-md space-y-4 rounded-lg border border-border bg-background/95 p-6 text-center shadow-lg"
+				>
+					<p className="text-balance text-base font-medium">{text}</p>
+					{reason === "SIGN_IN_REQUIRED" && (
+						<StorefrontHardLink
+							href={loginHref}
+							className="inline-block font-medium underline underline-offset-2"
+						>
+							{messages.signInAction}
+						</StorefrontHardLink>
+					)}
+					{reason === "BIRTHDAY_REQUIRED" && (
+						<LinkWithChannel
+							href="/account/settings"
+							className="inline-block font-medium underline underline-offset-2"
+						>
+							{messages.birthdayAction}
+						</LinkWithChannel>
+					)}
+				</div>
+			</div>
+		</div>
+	);
+}
