new file mode 100644
index 0000000..dd0c82a
--- /dev/null
+++ b/src/ui/components/pdp/add-to-cart-form.tsx
@@ -0,0 +1,28 @@
+"use client";
+
+import { useActionState, type ReactNode } from "react";
+import type { CartActionError } from "@/lib/age/age-restricted-error";
+import { CartActionErrorMessage } from "@/ui/components/cart/cart-action-error";
+
+/**
+ * Add-to-cart `<form>` that can show why the API refused the line (age-restricted product).
+ * The server action returns the error to show, or `null` on success.
+ */
+export function AddToCartForm({
+	action,
+	className,
+	children,
+}: {
+	action: (previous: CartActionError | null) => Promise<CartActionError | null>;
+	className?: string;
+	children: ReactNode;
+}) {
+	const [error, formAction] = useActionState(action, null);
+
+	return (
+		<form action={formAction} className={className}>
+			{children}
+			<CartActionErrorMessage error={error} />
+		</form>
+	);
+}
diff --git a/src/ui/components/pdp/age-gated-product.test.ts b/src/ui/components/pdp/age-gated-product.test.ts
