+		expect(isAgeGatedStub({ isAgeRestricted: true, ageAccess: "UNDERAGE" } as never)).toBe(true);
+		expect(isAgeGatedStub({ isAgeRestricted: true, ageAccess: "SIGN_IN_REQUIRED" } as never)).toBe(true);
+		expect(isAgeGatedStub({ isAgeRestricted: true, ageAccess: "BIRTHDAY_REQUIRED" } as never)).toBe(true);
+		expect(isAgeGatedStub({ isAgeRestricted: true, ageAccess: "ALLOWED" } as never)).toBe(false);
+		expect(isAgeGatedStub({ isAgeRestricted: false, ageAccess: "ALLOWED" } as never)).toBe(false);
+	});
+});
