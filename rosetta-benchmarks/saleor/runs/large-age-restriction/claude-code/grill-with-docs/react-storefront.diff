+describe("getViewerProductData", () => {
+	beforeEach(() => {
+		viewerQuery.mockReset();
+		cachedQuery.mockReset();
+	});
+
+	it("reads with the customer token and never through the shared cache", async () => {
+		viewerQuery.mockResolvedValue({ ok: true, data: { product: stub } });
+		const product = await getViewerProductData("whisky", "default-channel", "en");
+		expect(product).toMatchObject({ slug: "whisky", ageAccess: "UNDERAGE" });
+		expect(viewerQuery).toHaveBeenCalledTimes(1);
+		expect(cachedQuery).not.toHaveBeenCalled();
