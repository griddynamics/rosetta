+import { buildStorefrontPath } from "@/lib/storefront-path";
+import { StorefrontHardLink } from "@/ui/atoms/storefront-hard-link";
+
+/**
+ * Why the API refused a cart change. Only AGE_RESTRICTED has its own copy: the API
+ * message names the product(s); without one we show a translated generic line. Guests
+ * are told to sign in, because only a signed-in customer with a birthday can pass the gate.
+ */
+export function CartActionErrorMessage({ error }: { error: CartActionError | null }) {
+	const t = useTranslations("cart.errors");
+	const params = useParams<{ locale?: string; channel?: string }>();
+
+	if (!error || error.code !== "AGE_RESTRICTED") return null;
+
+	const loginHref =
+		params.locale && params.channel ? buildStorefrontPath(params.locale, params.channel, "/login") : "/login";
+
+	return (
+		<div role="alert" className="space-y-1 text-sm text-destructive">
+			<p>{error.message || t("ageRestricted")}</p>
+			{!error.signedIn && (
+				<p>
+					{t("ageRestrictedSignIn")}{" "}
+					<StorefrontHardLink href={loginHref} className="font-medium underline underline-offset-2">
+						{t("signIn")}
+					</StorefrontHardLink>
+				</p>
+			)}
+		</div>
+	);
+}
