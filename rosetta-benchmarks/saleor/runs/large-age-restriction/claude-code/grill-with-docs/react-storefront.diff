@@ -0,0 +1,24 @@
+/** Saleor error code for buying an age-restricted product the customer may not buy. */
+export const AGE_RESTRICTED_CODE = "AGE_RESTRICTED";
+
+type AgeRestrictedError = {
+	code: typeof AGE_RESTRICTED_CODE;
+	/** API message; names the product(s). Empty when the API sent none. */
+	message: string;
+	/** Whether a customer session was present. Guests are told to sign in. */
+	signedIn: boolean;
+};
+
+export type CartActionError = AgeRestrictedError | { code: "FAILED" };
+
+type ApiError = { code?: string | null; message?: string | null };
+
+/** The AGE_RESTRICTED error in a mutation's `errors`, mapped for the UI. `null` when there is none. */
+export function pickAgeRestrictedError(
+	errors: readonly ApiError[] | null | undefined,
+	signedIn: boolean,
+): AgeRestrictedError | null {
+	const hit = errors?.find((error) => error.code === AGE_RESTRICTED_CODE);
+	if (!hit) return null;
+	return { code: AGE_RESTRICTED_CODE, message: hit.message?.trim() ?? "", signedIn };
+}
