+import datetime
+
+import graphene
+import pytest
+from django.utils import timezone
+
+from ...tests.utils import get_graphql_content
+
+PRODUCTS_QUERY = """
+    query products($channel: String) {
+        products(first: 10, channel: $channel) {
+            edges {
+                node {
+                    id
+                    name
+                }
+            }
+        }
+    }
+"""
+
+PRODUCT_QUERY = """
+    query product($id: ID, $channel: String) {
+        product(id: $id, channel: $channel) {
+            id
+            slug
+            name
+            description
+            seoTitle
+            isAgeRestricted
+            ageAccess
+            thumbnail {
+                url
+            }
+            media {
+                id
+            }
+            variants {
+                id
+            }
+            defaultVariant {
+                id
+            }
+            category {
+                id
+            }
+            collections {
+                id
+            }
+            pricing {
+                displayGrossPrices
+            }
+            attributes {
+                attribute {
+                    slug
+                }
+            }
+        }
+    }
+"""
+
+VARIANTS_QUERY = """
+    query variants($channel: String) {
+        productVariants(first: 10, channel: $channel) {
+            edges {
+                node {
+                    id
+                }
+            }
+        }
+    }
+"""
+
+COLLECTION_PRODUCTS_QUERY = """
+    query collection($id: ID, $channel: String) {
+        collection(id: $id, channel: $channel) {
+            products(first: 10) {
+                edges {
+                    node {
+                        id
+                    }
+                }
+            }
+        }
+    }
+"""
+
+
+@pytest.fixture
+def restricted_product(product):
+    product.is_age_restricted = True
+    product.save(update_fields=["is_age_restricted"])
+    return product
+
+
+def _set_birthday(user, birthday):
+    user.birthday = birthday
+    user.save(update_fields=["birthday"])
+
+
+def _product_ids(response):
+    edges = get_graphql_content(response)["data"]["products"]["edges"]
+    return {edge["node"]["id"] for edge in edges}
+
+
+def _id(product):
+    return graphene.Node.to_global_id("Product", product.pk)
+
+
+def test_restricted_product_is_hidden_from_guest_in_lists(
+    api_client, restricted_product, channel_USD
+):
+    # when
+    response = api_client.post_graphql(PRODUCTS_QUERY, {"channel": channel_USD.slug})
+
+    # then
+    assert _id(restricted_product) not in _product_ids(response)
+
+
+def test_unrestricted_product_is_listed_for_guest(api_client, product, channel_USD):
+    # when
+    response = api_client.post_graphql(PRODUCTS_QUERY, {"channel": channel_USD.slug})
+
+    # then
+    assert _id(product) in _product_ids(response)
+
+
+def test_restricted_product_is_hidden_from_customer_without_birthday(
+    user_api_client, restricted_product, channel_USD
+):
+    # when
+    response = user_api_client.post_graphql(
+        PRODUCTS_QUERY, {"channel": channel_USD.slug}
+    )
+
+    # then
+    assert _id(restricted_product) not in _product_ids(response)
+
+
+def test_restricted_product_is_hidden_from_underage_customer(
+    user_api_client, customer_user, restricted_product, channel_USD
+):
+    # given: turns 18 tomorrow
+    tomorrow = timezone.localdate() + datetime.timedelta(days=1)
+    _set_birthday(customer_user, tomorrow.replace(year=tomorrow.year - 18))
+
+    # when
+    response = user_api_client.post_graphql(
+        PRODUCTS_QUERY, {"channel": channel_USD.slug}
+    )
+
+    # then
+    assert _id(restricted_product) not in _product_ids(response)
+
+
+def test_restricted_product_is_listed_for_customer_turning_eighteen_today(
+    user_api_client, customer_user, restricted_product, channel_USD
+):
+    # given
+    today = timezone.localdate()
+    _set_birthday(customer_user, today.replace(year=today.year - 18))
+
+    # when
+    response = user_api_client.post_graphql(
+        PRODUCTS_QUERY, {"channel": channel_USD.slug}
+    )
+
+    # then
+    assert _id(restricted_product) in _product_ids(response)
+
+
+def test_restricted_product_is_listed_for_adult_customer(
+    user_api_client, customer_user, restricted_product, channel_USD
+):
+    # given
+    _set_birthday(customer_user, datetime.date(1990, 1, 1))
+
+    # when
+    response = user_api_client.post_graphql(
+        PRODUCTS_QUERY, {"channel": channel_USD.slug}
+    )
+
+    # then
+    assert _id(restricted_product) in _product_ids(response)
+
+
+def test_minimum_age_from_site_settings_is_used(
+    user_api_client, customer_user, restricted_product, channel_USD, site_settings
+):
+    # given: a 30-year-old customer, minimum age raised to 40
+    today = timezone.localdate()
+    _set_birthday(customer_user, datetime.date(today.year - 30, 1, 1))
+    site_settings.minimum_age = 40
+    site_settings.save(update_fields=["minimum_age"])
+
+    # when
+    response = user_api_client.post_graphql(
+        PRODUCTS_QUERY, {"channel": channel_USD.slug}
+    )
+
+    # then
+    assert _id(restricted_product) not in _product_ids(response)
+
+
+def test_staff_with_product_permission_sees_restricted_product(
+    staff_api_client, permission_manage_products, restricted_product, channel_USD
+):
+    # given
+    staff_api_client.user.user_permissions.add(permission_manage_products)
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCTS_QUERY, {"channel": channel_USD.slug}
+    )
+
+    # then
+    assert _id(restricted_product) in _product_ids(response)
+
+
+def test_app_with_product_permission_sees_restricted_product(
+    app_api_client, permission_manage_products, restricted_product, channel_USD
+):
+    # given
+    app_api_client.app.permissions.add(permission_manage_products)
+
+    # when
+    response = app_api_client.post_graphql(
+        PRODUCTS_QUERY, {"channel": channel_USD.slug}
+    )
+
+    # then
+    assert _id(restricted_product) in _product_ids(response)
+
+
+@pytest.mark.parametrize(
+    ("client_name", "birthday", "expected_access"),
+    [
+        ("api_client", None, "SIGN_IN_REQUIRED"),
+        ("user_api_client", None, "BIRTHDAY_REQUIRED"),
+        ("user_api_client", timezone.localdate(), "UNDERAGE"),
+    ],
+)
+def test_direct_lookup_returns_masked_product(
+    client_name,
+    birthday,
+    expected_access,
+    request,
+    customer_user,
+    restricted_product,
+    channel_USD,
+):
+    # given
+    client = request.getfixturevalue(client_name)
+    _set_birthday(customer_user, birthday)
+    variables = {"id": _id(restricted_product), "channel": channel_USD.slug}
+
+    # when
+    response = client.post_graphql(PRODUCT_QUERY, variables)
+
+    # then: only the minimum to render a blurred page is exposed
+    data = get_graphql_content(response)["data"]["product"]
+    assert data["id"] == _id(restricted_product)
+    assert data["slug"] == restricted_product.slug
+    assert data["isAgeRestricted"] is True
+    assert data["ageAccess"] == expected_access
+    assert data["name"] == ""
+    assert data["description"] is None
+    assert data["seoTitle"] is None
+    assert data["thumbnail"] is None
+    assert data["media"] == []
+    assert data["variants"] == []
+    assert data["defaultVariant"] is None
+    assert data["category"] is None
+    assert data["collections"] == []
+    assert data["pricing"] is None
+    assert data["attributes"] == []
+
+
+def test_direct_lookup_returns_full_product_to_adult(
+    user_api_client, customer_user, restricted_product, channel_USD
+):
+    # given
+    _set_birthday(customer_user, datetime.date(1990, 1, 1))
+    variables = {"id": _id(restricted_product), "channel": channel_USD.slug}
+
+    # when
+    response = user_api_client.post_graphql(PRODUCT_QUERY, variables)
+
+    # then
+    data = get_graphql_content(response)["data"]["product"]
+    assert data["ageAccess"] == "ALLOWED"
+    assert data["name"] == restricted_product.name
+    assert data["variants"]
+    assert data["pricing"] is not None
+
+
+def test_direct_lookup_of_unrestricted_product_is_allowed(
+    api_client, product, channel_USD
+):
+    # given
+    variables = {"id": _id(product), "channel": channel_USD.slug}
+
+    # when
+    response = api_client.post_graphql(PRODUCT_QUERY, variables)
+
+    # then
+    data = get_graphql_content(response)["data"]["product"]
+    assert data["isAgeRestricted"] is False
+    assert data["ageAccess"] == "ALLOWED"
+    assert data["name"] == product.name
+
+
+def test_direct_lookup_returns_full_product_to_staff(
+    staff_api_client, permission_manage_products, restricted_product, channel_USD
+):
+    # given
+    staff_api_client.user.user_permissions.add(permission_manage_products)
+    variables = {"id": _id(restricted_product), "channel": channel_USD.slug}
+
+    # when
+    response = staff_api_client.post_graphql(PRODUCT_QUERY, variables)
+
+    # then
+    data = get_graphql_content(response)["data"]["product"]
+    assert data["ageAccess"] == "ALLOWED"
+    assert data["name"] == restricted_product.name
+
+
+def test_variants_of_restricted_product_are_hidden_from_guest(
+    api_client, restricted_product, channel_USD
+):
+    # when
+    response = api_client.post_graphql(VARIANTS_QUERY, {"channel": channel_USD.slug})
+
+    # then
+    edges = get_graphql_content(response)["data"]["productVariants"]["edges"]
+    variant_ids = {edge["node"]["id"] for edge in edges}
+    for variant in restricted_product.variants.all():
+        assert (
+            graphene.Node.to_global_id("ProductVariant", variant.pk) not in variant_ids
+        )
+
+
+def test_variants_of_restricted_product_are_listed_for_adult(
+    user_api_client, customer_user, restricted_product, channel_USD
+):
+    # given
+    _set_birthday(customer_user, datetime.date(1990, 1, 1))
+
+    # when
+    response = user_api_client.post_graphql(
+        VARIANTS_QUERY, {"channel": channel_USD.slug}
+    )
+
+    # then
+    edges = get_graphql_content(response)["data"]["productVariants"]["edges"]
+    assert len(edges) == restricted_product.variants.count()
+
+
+def test_restricted_product_is_hidden_in_collection_for_guest(
+    api_client, restricted_product, published_collection, channel_USD
+):
+    # given
+    collection = published_collection
+    collection.products.add(restricted_product)
+    variables = {
+        "id": graphene.Node.to_global_id("Collection", collection.pk),
+        "channel": channel_USD.slug,
+    }
+
+    # when
+    response = api_client.post_graphql(COLLECTION_PRODUCTS_QUERY, variables)
+
+    # then
+    edges = get_graphql_content(response)["data"]["collection"]["products"]["edges"]
+    assert _id(restricted_product) not in {edge["node"]["id"] for edge in edges}
