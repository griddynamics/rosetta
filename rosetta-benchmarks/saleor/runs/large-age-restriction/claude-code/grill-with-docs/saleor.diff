+class BirthdayAuditEvent(graphene.ObjectType):
+    id = graphene.ID(required=True, description="The ID of the audit event.")
+    date = DateTime(required=True, description="When the event happened.")
+    type = CustomerEventsEnum(
+        required=True, description="Either a birthday change or a birthday read."
+    )
+    actor_user_id = graphene.ID(description="ID of the user who performed the action.")
+    actor_app_id = graphene.ID(description="ID of the app that performed the action.")
+
+    class Meta:
+        description = (
+            "Audit record of a change or staff read of a customer's birthday. "
+            "It never contains the birthday itself."
+        )
+        doc_category = DOC_CATEGORY_USERS
+
+    @staticmethod
+    def resolve_id(root: models.CustomerEvent, _info: ResolveInfo):
+        return graphene.Node.to_global_id("CustomerEvent", root.pk)
+
+    @staticmethod
+    def resolve_actor_user_id(root: models.CustomerEvent, _info: ResolveInfo):
+        user_id = root.parameters.get("actor_user_id")
+        return graphene.Node.to_global_id("User", user_id) if user_id else None
+
+    @staticmethod
+    def resolve_actor_app_id(root: models.CustomerEvent, _info: ResolveInfo):
+        app_id = root.parameters.get("actor_app_id")
+        return graphene.Node.to_global_id("App", app_id) if app_id else None
+
+
+def _is_owner(requestor, user: models.User) -> bool:
+    return isinstance(requestor, models.User) and requestor.pk == user.pk
+
+
+def _is_superuser(requestor) -> bool:
+    return (
+        isinstance(requestor, models.User)
+        and requestor.is_active
+        and requestor.is_superuser
+    )
+
+
+def _log_birthday_read(info: ResolveInfo, requestor, user: models.User):
+    """Audit a staff read, once per customer and request."""
+    logged = info.context.__dict__.setdefault("_birthday_reads_logged", set())
+    if user.pk in logged:
+        return
+    logged.add(user.pk)
+    is_user = isinstance(requestor, models.User)
+    create_birthday_event(
+        event_type=CustomerEvents.BIRTHDAY_READ,
+        customer_id=user.pk,
+        actor_user_id=requestor.pk if is_user else None,
+        actor_app_id=None if is_user else requestor.pk,
+    )
+
