diff --git a/saleor/account/tests/test_age.py b/saleor/account/tests/test_age.py
new file mode 100644
index 0000000..26361dd
--- /dev/null
+++ b/saleor/account/tests/test_age.py
@@ -0,0 +1,126 @@
+import datetime
+
+import pytest
+from django.core.exceptions import ValidationError
+from django.utils import timezone
+
+from ...checkout.error_codes import CheckoutErrorCode
+from ..age import (
+    create_birthday_event,
+    get_minimum_age_date,
+    is_old_enough,
+    is_user_old_enough,
+    requestor_can_view_age_restricted,
+    validate_buyer_old_enough,
+)
+from ..models import CustomerEvent
+
+D = datetime.date
+
+
+@pytest.mark.parametrize(
+    ("birthday", "today", "expected"),
+    [
+        # turns 18 today: eligible today
+        (D(2008, 6, 15), D(2026, 6, 15), True),
+        # turns 18 tomorrow: not yet
+        (D(2008, 6, 16), D(2026, 6, 15), False),
+        (D(2000, 1, 1), D(2026, 6, 15), True),
+        (D(2020, 1, 1), D(2026, 6, 15), False),
+        # 29 February becomes eligible on 1 March in non-leap years
+        (D(2008, 2, 29), D(2026, 2, 28), False),
+        (D(2008, 2, 29), D(2026, 3, 1), True),
+        # no birthday: never old enough
+        (None, D(2026, 6, 15), False),
+    ],
+)
+def test_is_old_enough(birthday, today, expected):
+    assert is_old_enough(birthday, 18, today) is expected
+
+
+def test_get_minimum_age_date_leap_day():
+    assert get_minimum_age_date(D(2008, 2, 29), 18) == D(2026, 3, 1)
+    assert get_minimum_age_date(D(2008, 2, 29), 16) == D(2024, 2, 29)
+
+
+def test_is_old_enough_uses_the_current_date_in_shop_time_zone(settings):
+    from freezegun import freeze_time
+
+    settings.TIME_ZONE = "Pacific/Auckland"
+    # 2026-06-14 23:00 UTC is already 2026-06-15 in Auckland
+    with freeze_time("2026-06-14 23:00:00"):
+        assert is_old_enough(D(2008, 6, 15), 18) is True
+    with freeze_time("2026-06-14 10:00:00"):
+        assert is_old_enough(D(2008, 6, 15), 18) is False
+
+
+def test_guest_and_user_without_birthday_are_not_old_enough(customer_user):
+    assert is_user_old_enough(None, 18) is False
+    customer_user.birthday = None
+    assert is_user_old_enough(customer_user, 18) is False
+
+
+def test_requestor_can_view_age_restricted(customer_user, app, db):
+    customer_user.birthday = D(2000, 1, 1)
+    assert requestor_can_view_age_restricted(customer_user) is True
+    customer_user.birthday = timezone.localdate()
+    assert requestor_can_view_age_restricted(customer_user) is False
+    customer_user.birthday = None
+    assert requestor_can_view_age_restricted(customer_user) is False
+    assert requestor_can_view_age_restricted(None) is False
+    assert requestor_can_view_age_restricted(app) is False
+
+
+def test_validate_buyer_old_enough(customer_user, product):
+    # given
+    product.is_age_restricted = True
+    code = CheckoutErrorCode.AGE_RESTRICTED.value
+
+    # guest
+    with pytest.raises(ValidationError) as error:
+        validate_buyer_old_enough([product], None, code)
+    assert product.name in str(error.value)
+    assert error.value.error_dict["lines"][0].code == code
+
+    # customer who is old enough
+    customer_user.birthday = D(2000, 1, 1)
+    validate_buyer_old_enough([product], customer_user, code)
+
+    # unrestricted products are never checked
+    product.is_age_restricted = False
+    validate_buyer_old_enough([product], None, code)
+
+
+def test_create_birthday_event_stores_ids_only(customer_user, staff_user):
+    # when
+    event = create_birthday_event(
+        event_type="birthday_read",
+        customer_id=customer_user.pk,
+        actor_user_id=staff_user.pk,
+        actor_app_id=None,
+    )
+
+    # then
+    assert event.user_id is None
+    assert event.parameters == {
+        "customer_id": customer_user.pk,
+        "actor_user_id": staff_user.pk,
+        "actor_app_id": None,
+    }
+
+
+def test_birthday_events_survive_customer_and_actor_deletion(customer_user, staff_user):
+    # given
+    create_birthday_event(
+        event_type="birthday_changed",
+        customer_id=customer_user.pk,
+        actor_user_id=staff_user.pk,
+        actor_app_id=None,
+    )
+
+    # when
+    customer_user.delete()
+    staff_user.delete()
+
+    # then
+    assert CustomerEvent.objects.filter(type="birthday_changed").count() == 1
