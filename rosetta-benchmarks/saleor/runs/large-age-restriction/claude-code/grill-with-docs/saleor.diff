diff --git a/saleor/graphql/shop/tests/mutations/test_shop_minimum_age.py b/saleor/graphql/shop/tests/mutations/test_shop_minimum_age.py
new file mode 100644
index 0000000..68467c1
--- /dev/null
+++ b/saleor/graphql/shop/tests/mutations/test_shop_minimum_age.py
@@ -0,0 +1,81 @@
+import pytest
+
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+SHOP_SETTINGS_UPDATE = """
+    mutation updateSettings($input: ShopSettingsInput!) {
+        shopSettingsUpdate(input: $input) {
+            shop {
+                minimumAge
+            }
+            errors {
+                field
+                code
+            }
+        }
+    }
+"""
+
+SHOP_MINIMUM_AGE = """
+    query {
+        shop {
+            minimumAge
+        }
+    }
+"""
+
+
+def test_minimum_age_defaults_to_18(api_client, site_settings):
+    # when
+    response = api_client.post_graphql(SHOP_MINIMUM_AGE)
+
+    # then
+    assert get_graphql_content(response)["data"]["shop"]["minimumAge"] == 18
+
+
+def test_staff_updates_minimum_age(
+    staff_api_client, site_settings, permission_manage_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_UPDATE,
+        {"input": {"minimumAge": 21}},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert not data["errors"]
+    assert data["shop"]["minimumAge"] == 21
+    site_settings.refresh_from_db()
+    assert site_settings.minimum_age == 21
+
+
+@pytest.mark.parametrize("value", [-1, 151, None])
+def test_invalid_minimum_age_is_rejected(
+    value, staff_api_client, site_settings, permission_manage_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_UPDATE,
+        {"input": {"minimumAge": value}},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert data["errors"] == [{"field": "minimumAge", "code": "INVALID"}]
+    site_settings.refresh_from_db()
+    assert site_settings.minimum_age == 18
+
+
+def test_minimum_age_update_requires_settings_permission(
+    staff_api_client, site_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_UPDATE, {"input": {"minimumAge": 21}}
+    )
+
+    # then
+    assert_no_permission(response)
