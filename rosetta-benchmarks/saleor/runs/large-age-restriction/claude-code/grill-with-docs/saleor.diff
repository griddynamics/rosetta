@@ -0,0 +1,135 @@
+import graphene
+
+from ....tests.utils import get_graphql_content
+
+PRODUCT_CREATE = """
+    mutation createProduct($input: ProductCreateInput!) {
+        productCreate(input: $input) {
+            product {
+                isAgeRestricted
+            }
+            errors {
+                field
+                code
+            }
+        }
+    }
+"""
+
+PRODUCT_UPDATE = """
+    mutation updateProduct($id: ID!, $input: ProductInput!) {
+        productUpdate(id: $id, input: $input) {
+            product {
+                isAgeRestricted
+            }
+            errors {
+                field
+                code
+            }
+        }
+    }
+"""
+
+
+def test_product_create_is_unrestricted_by_default(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    variables = {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "category": graphene.Node.to_global_id("Category", category.pk),
+            "name": "Plain product",
+        }
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_CREATE, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["isAgeRestricted"] is False
+
+
+def test_staff_marks_new_product_as_age_restricted(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    variables = {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "category": graphene.Node.to_global_id("Category", category.pk),
+            "name": "Whisky",
+            "isAgeRestricted": True,
+        }
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_CREATE, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["isAgeRestricted"] is True
+
+
+def test_staff_marks_and_unmarks_existing_product(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    product_id = graphene.Node.to_global_id("Product", product.pk)
+    assert product.is_age_restricted is False
+
+    # when
+    mark = staff_api_client.post_graphql(
+        PRODUCT_UPDATE,
+        {"id": product_id, "input": {"isAgeRestricted": True}},
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    assert get_graphql_content(mark)["data"]["productUpdate"]["product"] == {
+        "isAgeRestricted": True
+    }
+    product.refresh_from_db()
+    assert product.is_age_restricted is True
+
+    # when
+    unmark = staff_api_client.post_graphql(
+        PRODUCT_UPDATE, {"id": product_id, "input": {"isAgeRestricted": False}}
+    )
+
+    # then
+    assert get_graphql_content(unmark)["data"]["productUpdate"]["product"] == {
+        "isAgeRestricted": False
+    }
+    product.refresh_from_db()
+    assert product.is_age_restricted is False
+
+
+def test_update_without_the_flag_keeps_it(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    product.is_age_restricted = True
+    product.save(update_fields=["is_age_restricted"])
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_UPDATE,
+        {
+            "id": graphene.Node.to_global_id("Product", product.pk),
+            "input": {"name": "Renamed"},
+        },
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    assert not get_graphql_content(response)["data"]["productUpdate"]["errors"]
+    product.refresh_from_db()
+    assert product.is_age_restricted is True
