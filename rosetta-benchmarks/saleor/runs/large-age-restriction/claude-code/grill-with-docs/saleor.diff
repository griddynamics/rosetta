+import datetime
+
+import graphene
+import pytest
+from django.utils import timezone
+
+from .....order import OrderStatus
+from ....tests.utils import get_graphql_content
+from .test_draft_order_complete import DRAFT_ORDER_COMPLETE_MUTATION
+
+
+@pytest.fixture
+def restricted_draft_order(draft_order):
+    for line in draft_order.lines.all():
+        line.variant.product.is_age_restricted = True
+        line.variant.product.save(update_fields=["is_age_restricted"])
+    return draft_order
+
+
+def _complete(staff_api_client, permission_group_manage_orders, order):
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    return staff_api_client.post_graphql(
+        DRAFT_ORDER_COMPLETE_MUTATION,
+        {"id": graphene.Node.to_global_id("Order", order.id)},
+    )
+
+
+@pytest.mark.parametrize("birthday", [None, "tomorrow"])
+def test_draft_with_restricted_product_and_customer_not_old_enough_is_rejected(
+    birthday,
+    staff_api_client,
+    permission_group_manage_orders,
+    restricted_draft_order,
+    customer_user,
+):
+    # given
+    if birthday == "tomorrow":
+        tomorrow = timezone.localdate() + datetime.timedelta(days=1)
+        customer_user.birthday = tomorrow.replace(year=tomorrow.year - 18)
+        customer_user.save(update_fields=["birthday"])
+    order = restricted_draft_order
+    order.user = customer_user
+    order.save(update_fields=["user"])
+
+    # when
+    response = _complete(staff_api_client, permission_group_manage_orders, order)
+
+    # then
+    data = get_graphql_content(response)["data"]["draftOrderComplete"]
+    assert data["errors"][0]["code"] == "AGE_RESTRICTED"
+    assert data["errors"][0]["field"] == "lines"
+    order.refresh_from_db()
+    assert order.status == OrderStatus.DRAFT
+
+
+def test_draft_with_restricted_product_and_adult_customer_completes(
+    staff_api_client,
+    permission_group_manage_orders,
+    restricted_draft_order,
+    customer_user,
+):
+    # given
+    customer_user.birthday = datetime.date(1990, 1, 1)
+    customer_user.save(update_fields=["birthday"])
+    order = restricted_draft_order
+    order.user = customer_user
+    order.save(update_fields=["user"])
+
+    # when
+    response = _complete(staff_api_client, permission_group_manage_orders, order)
+
+    # then
+    data = get_graphql_content(response)["data"]["draftOrderComplete"]
+    assert not data["errors"]
+    order.refresh_from_db()
+    assert order.status != OrderStatus.DRAFT
+
+
+def test_draft_with_restricted_product_and_no_customer_completes(
+    staff_api_client, permission_group_manage_orders, restricted_draft_order
+):
+    # given
+    order = restricted_draft_order
+    order.user = None
+    order.save(update_fields=["user"])
+
+    # when
+    response = _complete(staff_api_client, permission_group_manage_orders, order)
+
+    # then
+    data = get_graphql_content(response)["data"]["draftOrderComplete"]
+    assert not data["errors"]
+    order.refresh_from_db()
+    assert order.status != OrderStatus.DRAFT
