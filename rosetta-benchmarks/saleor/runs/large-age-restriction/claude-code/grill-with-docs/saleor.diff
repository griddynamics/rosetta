diff --git a/saleor/account/age.py b/saleor/account/age.py
new file mode 100644
index 0000000..8ed09d3
--- /dev/null
+++ b/saleor/account/age.py
@@ -0,0 +1,122 @@
+import datetime
+from collections.abc import Iterable
+
+import graphene
+from django.core.exceptions import ValidationError
+from django.utils import timezone
+
+from ..account import CustomerEvents
+from .models import CustomerEvent, User
+
+
+def get_minimum_age_date(birthday: datetime.date, minimum_age: int) -> datetime.date:
+    """Return the first date on which a person born on `birthday` is old enough.
+
+    A 29 February birthday reaches the age on 1 March in non-leap years.
+    """
+    year = birthday.year + minimum_age
+    try:
+        return birthday.replace(year=year)
+    except ValueError:
+        return datetime.date(year, 3, 1)
+
+
+def is_old_enough(
+    birthday: datetime.date | None,
+    minimum_age: int,
+    today: datetime.date | None = None,
+) -> bool:
+    """Compare dates in the shop's time zone; no birthday means not old enough."""
+    if birthday is None:
+        return False
+    if today is None:
+        today = timezone.localdate()
+    return today >= get_minimum_age_date(birthday, minimum_age)
+
+
+def is_user_old_enough(user: User | None, minimum_age: int) -> bool:
+    """Guests (no user) and users without a birthday are never old enough."""
+    return user is not None and is_old_enough(user.birthday, minimum_age)
+
+
+def create_birthday_event(
+    *,
+    event_type: str,
+    customer_id: int,
+    actor_user_id: int | None,
+    actor_app_id: int | None,
+) -> CustomerEvent:
+    """Write an audit event without any foreign key and without birthday values.
+
+    Ids are stored as plain values so the event outlives the customer and the actor.
+    """
+    from ..core.db.connection import allow_writer  # circular import
+
+    assert event_type in (CustomerEvents.BIRTHDAY_CHANGED, CustomerEvents.BIRTHDAY_READ)
+    # Reads of the birthday are audited from query resolvers, which run on a
+    # replica-only context.
+    with allow_writer():
+        return CustomerEvent.objects.create(
+            type=event_type,
+            parameters={
+                "customer_id": customer_id,
+                "actor_user_id": actor_user_id,
+                "actor_app_id": actor_app_id,
+            },
+        )
+
+
+def get_minimum_age(using: str | None = None) -> int:
+    from django.conf import settings
+
+    from ..site.models import SiteSettings
+
+    qs = SiteSettings.objects.using(using) if using else SiteSettings.objects
+    if settings.SITE_ID:
+        qs = qs.filter(site_id=settings.SITE_ID)
+    minimum_age = qs.values_list("minimum_age", flat=True).first()
+    return 18 if minimum_age is None else minimum_age
+
+
+def requestor_can_view_age_restricted(requestor, using: str | None = None) -> bool:
+    """Tell if a requestor without product permissions may see restricted products.
+
+    Only a customer who is old enough may. Guests, customers without a birthday and
+    apps may not.
+    """
+    if not isinstance(requestor, User) or requestor.birthday is None:
+        return False
+    return is_user_old_enough(requestor, get_minimum_age(using))
+
+
+def validate_buyer_old_enough(
+    products: Iterable,
+    buyer: User | None,
+    error_code: str,
+    field: str = "lines",
+) -> None:
+    """Raise a ValidationError naming the age-restricted products the buyer can't buy.
+
+    Guests (no buyer) and buyers without a birthday can't be shown to be old enough.
+    """
+    restricted = {p.pk: p for p in products if p.is_age_restricted}
+    if not restricted:
+        return
+    minimum_age = get_minimum_age()
+    if is_user_old_enough(buyer, minimum_age):
+        return
+    names = ", ".join(sorted(p.name for p in restricted.values()))
+    raise ValidationError(
+        {
+            field: ValidationError(
+                f"Only customers aged {minimum_age} or older who have set their "
+                f"birthday can buy: {names}.",
+                code=error_code,
+                params={
+                    "products": [
+                        graphene.Node.to_global_id("Product", pk) for pk in restricted
+                    ]
+                },
+            )
+        }
+    )
