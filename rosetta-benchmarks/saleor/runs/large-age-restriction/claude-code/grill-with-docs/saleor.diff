@@ -0,0 +1,378 @@
+import datetime
+
+import graphene
+import pytest
+
+from ....account import CustomerEvents
+from ....account.age import create_birthday_event
+from ....account.models import CustomerEvent
+from ...tests.utils import get_graphql_content
+
+BIRTHDAY = datetime.date(2000, 5, 17)
+
+ACCOUNT_UPDATE_BIRTHDAY = """
+    mutation accountUpdate($input: AccountInput!, $customerId: ID) {
+        accountUpdate(input: $input, customerId: $customerId) {
+            errors {
+                field
+                code
+            }
+            user {
+                birthday
+                ageEligible
+            }
+        }
+    }
+"""
+
+USER_BIRTHDAY = """
+    query user($id: ID!) {
+        user(id: $id) {
+            birthday
+            ageEligible
+        }
+    }
+"""
+
+ME_BIRTHDAY = """
+    query {
+        me {
+            birthday
+            ageEligible
+        }
+    }
+"""
+
+USER_EVENTS = """
+    query user($id: ID!) {
+        user(id: $id) {
+            events {
+                type
+            }
+        }
+    }
+"""
+
+AUDIT_EVENTS = """
+    query user($id: ID!) {
+        user(id: $id) {
+            birthdayAuditEvents {
+                type
+                actorUserId
+                actorAppId
+            }
+        }
+    }
+"""
+
+
+@pytest.fixture
+def customer_with_birthday(customer_user):
+    customer_user.birthday = BIRTHDAY
+    customer_user.save(update_fields=["birthday"])
+    return customer_user
+
+
+def _birthday_events(event_type=None):
+    qs = CustomerEvent.objects.filter(
+        type__in=[CustomerEvents.BIRTHDAY_CHANGED, CustomerEvents.BIRTHDAY_READ]
+    )
+    return qs.filter(type=event_type) if event_type else qs
+
+
+def test_customer_sets_own_birthday(user_api_client, customer_user):
+    # given
+    variables = {"input": {"birthday": "2000-05-17"}}
+
+    # when
+    response = user_api_client.post_graphql(ACCOUNT_UPDATE_BIRTHDAY, variables)
+
+    # then
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+    assert not data["errors"]
+    assert data["user"]["birthday"] == "2000-05-17"
+    assert data["user"]["ageEligible"] is True
+    customer_user.refresh_from_db()
+    assert customer_user.birthday == BIRTHDAY
