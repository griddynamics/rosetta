+import { describe, expect, it, vi } from "vitest";
+import { addLineAttachingCustomer } from "./add-line-attaching-customer";
+
+const ok = { ok: true } as const;
+const guestRefused = { ok: false, ageRestriction: "loginRequired" } as const;
+
+describe("addLineAttachingCustomer", () => {
+	it("adds the line once and never attaches when it works", async () => {
+		const add = vi.fn().mockResolvedValue(ok);
+		const attach = vi.fn();
+
+		const result = await addLineAttachingCustomer(add, attach);
+
+		expect(result).toEqual(ok);
+		expect(add).toHaveBeenCalledTimes(1);
+		expect(attach).not.toHaveBeenCalled();
+	});
+
+	it("attaches the signed-in customer and retries when the cart still belongs to a guest", async () => {
+		const add = vi.fn().mockResolvedValueOnce(guestRefused).mockResolvedValueOnce(ok);
+		const attach = vi.fn().mockResolvedValue(true);
+
+		const result = await addLineAttachingCustomer(add, attach);
+
+		expect(result).toEqual(ok);
+		expect(attach).toHaveBeenCalledTimes(1);
+		expect(add).toHaveBeenCalledTimes(2);
+	});
+
+	it("keeps the refusal for a real guest, whose attach attempt fails", async () => {
+		const add = vi.fn().mockResolvedValue(guestRefused);
+		const attach = vi.fn().mockResolvedValue(false);
+
+		const result = await addLineAttachingCustomer(add, attach);
+
+		expect(result).toEqual(guestRefused);
+		expect(add).toHaveBeenCalledTimes(1);
+	});
+
+	it("reports the second refusal when the attached customer is still not eligible", async () => {
+		const notMet = { ok: false, ageRestriction: "notMet" } as const;
+		const add = vi.fn().mockResolvedValueOnce(guestRefused).mockResolvedValueOnce(notMet);
+		const attach = vi.fn().mockResolvedValue(true);
+
+		const result = await addLineAttachingCustomer(add, attach);
+
+		expect(result).toEqual(notMet);
+		expect(add).toHaveBeenCalledTimes(2);
+	});
+
+	it.each([
+		["a customer who is too young", { ok: false, ageRestriction: "notMet" } as const],
+		["an unrelated failure", { ok: false, ageRestriction: null } as const],
+	])("does not attach for %s", async (_name, refusal) => {
+		const add = vi.fn().mockResolvedValue(refusal);
+		const attach = vi.fn();
+
+		const result = await addLineAttachingCustomer(add, attach);
+
+		expect(result).toEqual(refusal);
+		expect(attach).not.toHaveBeenCalled();
+	});
+});
