+import { formatAgeLabel } from "@/lib/age-label";
+import { cn } from "@/lib/utils";
+
+type AgeLabelProps = {
+	minimumAge: number | null | undefined;
+	className?: string;
+};
+
+/** Small "18+" pill for age-restricted products. Renders nothing for unrestricted products. */
+export function AgeLabel({ minimumAge, className }: AgeLabelProps) {
+	const label = formatAgeLabel(minimumAge);
+
+	if (!label) {
+		return null;
+	}
+
+	return (
+		<span
+			className={cn(
+				"inline-flex items-center rounded-full border border-border px-1.5 py-0.5 text-[10px] font-semibold text-foreground/80",
+				className,
+			)}
+			data-test-id="age-label"
+		>
+			{label}
+		</span>
+	);
+}
