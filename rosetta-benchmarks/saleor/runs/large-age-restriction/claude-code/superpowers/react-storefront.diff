@@ -0,0 +1,29 @@
+import { describe, expect, it } from "vitest";
+import { getFormDateOrNull } from "./form-utils";
+
+function formWith(entries: Record<string, string>): FormData {
+	const formData = new FormData();
+	for (const [key, value] of Object.entries(entries)) {
+		formData.set(key, value);
+	}
+	return formData;
+}
+
+describe("getFormDateOrNull", () => {
+	it("returns the ISO date typed into a date input", () => {
+		expect(getFormDateOrNull(formWith({ dateOfBirth: "1990-05-17" }), "dateOfBirth")).toBe("1990-05-17");
+	});
+
+	it("returns null when the input was cleared, so the API removes the value", () => {
+		expect(getFormDateOrNull(formWith({ dateOfBirth: "" }), "dateOfBirth")).toBeNull();
+	});
+
+	it("returns null when the field is missing", () => {
+		expect(getFormDateOrNull(formWith({}), "dateOfBirth")).toBeNull();
+	});
+
+	it("rejects values that are not an ISO calendar date", () => {
+		expect(getFormDateOrNull(formWith({ dateOfBirth: "17/05/1990" }), "dateOfBirth")).toBeNull();
+		expect(getFormDateOrNull(formWith({ dateOfBirth: "1990-13-45" }), "dateOfBirth")).toBeNull();
+	});
+});
