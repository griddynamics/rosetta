+import type { AgeRestrictionKind } from "@/lib/age-restriction";
+
+type AddLineResult = { ok: true } | { ok: false; ageRestriction: AgeRestrictionKind | null };
+
+/**
+ * Saleor judges age restrictions against the customer attached to the checkout. A cart that was
+ * started as a guest and then continued after sign-in has no customer yet, so the first add is
+ * refused as a guest. Attach the signed-in customer once and retry. A real guest cannot be
+ * attached, so the original refusal stands.
+ */
+export async function addLineAttachingCustomer(
+	addLine: () => Promise<AddLineResult>,
+	attachCustomer: () => Promise<boolean>,
+): Promise<AddLineResult> {
+	const result = await addLine();
+
+	if (result.ok || result.ageRestriction !== "loginRequired") {
+		return result;
+	}
+
+	return (await attachCustomer()) ? addLine() : result;
+}
