index 37c7d7a..ae337b5 100644
--- a/src/ui/components/account/form-utils.ts
+++ b/src/ui/components/account/form-utils.ts
@@ -19,3 +19,15 @@ export function getFormStringOptional(fd: FormData, key: string): string | undef
 	if (typeof val !== "string" || val === "") return undefined;
 	return val;
 }
+
+/**
+ * Extract an ISO calendar date (`YYYY-MM-DD`, what `<input type="date">` submits) from FormData.
+ * Returns null if the field is empty, missing or not a real date, which clears the value in Saleor.
+ */
+export function getFormDateOrNull(fd: FormData, key: string): string | null {
+	const val = fd.get(key);
+	if (typeof val !== "string" || !/^\d{4}-\d{2}-\d{2}$/.test(val)) return null;
+
+	const date = new Date(`${val}T00:00:00Z`);
+	return Number.isNaN(date.getTime()) || date.toISOString().slice(0, 10) !== val ? null : val;
+}
