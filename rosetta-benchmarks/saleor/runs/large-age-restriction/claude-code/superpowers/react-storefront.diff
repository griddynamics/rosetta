+import { describe, expect, it } from "vitest";
+import {
+	ageRestrictionRedirectPath,
+	getAgeRestrictionKind,
+	parseAgeRestrictionParam,
+} from "./age-restriction";
+
+describe("getAgeRestrictionKind", () => {
+	it("asks guests to sign in", () => {
+		expect(getAgeRestrictionKind("AGE_RESTRICTED_LOGIN_REQUIRED")).toBe("loginRequired");
+	});
+
+	it("reports customers who are too young or have no date of birth", () => {
+		expect(getAgeRestrictionKind("AGE_RESTRICTION_NOT_MET")).toBe("notMet");
+	});
+
+	it.each(["INSUFFICIENT_STOCK", "INVALID", "", null, undefined])("ignores other error code %s", (code) => {
+		expect(getAgeRestrictionKind(code)).toBeNull();
+	});
+
+	it("finds the age restriction among several errors", () => {
+		expect(
+			getAgeRestrictionKind([{ code: "INVALID" }, { code: "AGE_RESTRICTION_NOT_MET" }, { code: null }]),
+		).toBe("notMet");
+	});
+
+	it("returns null for an empty error list", () => {
+		expect(getAgeRestrictionKind([])).toBeNull();
+	});
+});
+
+describe("parseAgeRestrictionParam", () => {
+	it.each(["loginRequired", "notMet"] as const)("accepts %s", (kind) => {
+		expect(parseAgeRestrictionParam(kind)).toBe(kind);
+	});
+
+	it.each(["", "other", "LOGINREQUIRED", null, undefined])("rejects %s", (value) => {
+		expect(parseAgeRestrictionParam(value)).toBeNull();
+	});
+});
+
+describe("ageRestrictionRedirectPath", () => {
+	it("sends guests to the sign-in page of the account area", () => {
+		expect(ageRestrictionRedirectPath("loginRequired", "/en/default-channel")).toBe(
+			"/en/default-channel/account?ageRestriction=loginRequired",
+		);
+	});
+
+	it("sends customers who do not meet the age to their settings", () => {
+		expect(ageRestrictionRedirectPath("notMet", "/en/default-channel")).toBe(
+			"/en/default-channel/account/settings?ageRestriction=notMet",
+		);
+	});
+});
diff --git a/src/lib/age-restriction.ts b/src/lib/age-restriction.ts
new file mode 100644
index 0000000..7353dc7
--- /dev/null
+++ b/src/lib/age-restriction.ts
@@ -0,0 +1,47 @@
+/**
+ * Saleor refuses age-restricted products to guests (`AGE_RESTRICTED_LOGIN_REQUIRED`) and to
+ * customers whose date of birth is missing or too recent (`AGE_RESTRICTION_NOT_MET`).
+ */
+export type AgeRestrictionKind = "loginRequired" | "notMet";
+
+const KIND_BY_ERROR_CODE: Record<string, AgeRestrictionKind> = {
+	AGE_RESTRICTED_LOGIN_REQUIRED: "loginRequired",
+	AGE_RESTRICTION_NOT_MET: "notMet",
+};
+
+type ErrorCode = string | null | undefined;
+
+/** Returns the age restriction behind a Saleor error code, or the first one in a list of errors. */
+export function getAgeRestrictionKind(
+	codeOrErrors: ErrorCode | ReadonlyArray<{ code?: ErrorCode }>,
+): AgeRestrictionKind | null {
+	if (typeof codeOrErrors === "string" || codeOrErrors == null) {
+		return (codeOrErrors && KIND_BY_ERROR_CODE[codeOrErrors]) || null;
+	}
+
+	for (const error of codeOrErrors) {
+		const kind = getAgeRestrictionKind(error.code);
+		if (kind) {
+			return kind;
+		}
+	}
+
+	return null;
+}
+
+/** Query parameter that tells the account pages why the shopper was sent there. */
+export const AGE_RESTRICTION_PARAM = "ageRestriction";
+
+/** Validates the `ageRestriction` query parameter value. */
+export function parseAgeRestrictionParam(value: string | null | undefined): AgeRestrictionKind | null {
+	return value === "loginRequired" || value === "notMet" ? value : null;
+}
+
+/**
+ * Where to send a shopper whose add-to-cart was refused: guests to sign in (`/account` shows the login
+ * form), everyone else to the account settings where the date of birth lives.
+ */
+export function ageRestrictionRedirectPath(kind: AgeRestrictionKind, storefrontPath: string): string {
+	const suffix = kind === "loginRequired" ? "/account" : "/account/settings";
+	return `${storefrontPath}${suffix}?${AGE_RESTRICTION_PARAM}=${kind}`;
+}
