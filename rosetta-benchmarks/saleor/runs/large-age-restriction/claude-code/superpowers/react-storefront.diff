+/**
+ * Label for an age-restricted product, for example `18+`. Returns null when the product has no
+ * (valid) minimum age. Visibility is never restricted by it: it only tells shoppers up front.
+ */
+export function formatAgeLabel(minimumAge: number | null | undefined): string | null {
+	return typeof minimumAge === "number" && Number.isInteger(minimumAge) && minimumAge > 0
+		? `${minimumAge}+`
+		: null;
+}
