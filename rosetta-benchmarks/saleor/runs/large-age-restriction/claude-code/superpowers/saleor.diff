+
+    # when
+    violation = get_age_restriction_violation([restricted], customer_user)
+
+    # then
+    assert violation is None
+
+
+@freeze_time("2026-10-20 23:30:00+00:00")
+def test_customer_is_not_eligible_on_the_shop_day_before_the_birthday(
+    site_settings, product_list, customer_user
+):
+    # given - in Los Angeles it is still 20 October
+    site_settings.time_zone = "America/Los_Angeles"
+    site_settings.save(update_fields=["time_zone"])
+    restricted = _restrict(product_list[0], 18)
+    customer_user.date_of_birth = datetime.date(2008, 10, 21)
+
+    # when
+    violation = get_age_restriction_violation([restricted], customer_user)
+
+    # then
+    assert violation == AgeRestrictionViolation(
+        code=CheckoutErrorCode.AGE_RESTRICTION_NOT_MET, variants=[restricted]
+    )
+
+
+@pytest.mark.parametrize(
+    ("date_of_birth", "today", "expected"),
+    [
+        (None, datetime.date(2026, 10, 20), False),
+        (datetime.date(2008, 10, 20), datetime.date(2026, 10, 20), True),
+        (datetime.date(2008, 10, 21), datetime.date(2026, 10, 20), False),
+        (datetime.date(2000, 2, 29), datetime.date(2018, 2, 28), False),
+        (datetime.date(2000, 2, 29), datetime.date(2018, 3, 1), True),
+    ],
+)
+def test_is_age_eligible(date_of_birth, today, expected):
+    assert is_age_eligible(date_of_birth, 18, today) is expected
