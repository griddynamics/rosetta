@@ -0,0 +1,135 @@
+from collections.abc import Iterable
+from dataclasses import dataclass
+from datetime import date
+from typing import TYPE_CHECKING
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+import graphene
+from django.conf import settings
+from django.core.exceptions import ValidationError
+from django.db.models import prefetch_related_objects
+from django.utils import timezone
+
+from ..site.models import SiteSettings
+from .error_codes import CheckoutErrorCode
+
+if TYPE_CHECKING:
+    from ..account.models import User
+    from ..product.models import ProductVariant
+
+
+@dataclass
+class AgeRestrictionViolation:
+    code: CheckoutErrorCode
+    variants: "list[ProductVariant]"
+
+
+def calculate_age(date_of_birth: date, today: date) -> int:
+    """Return the number of full years between `date_of_birth` and `today`.
+
+    A Feb 29 birthday is reached on Mar 1 in non-leap years.
+    """
+    years = today.year - date_of_birth.year
+    if (today.month, today.day) < (date_of_birth.month, date_of_birth.day):
+        years -= 1
+    return years
+
+
+def get_shop_today() -> date:
+    """Return the current calendar date in the shop's time zone."""
+    # Read straight from the database: `Site.objects.get_current()` caches the site
+    # together with its settings, which would keep a changed time zone stale.
+    time_zone = (
+        SiteSettings.objects.using(settings.DATABASE_CONNECTION_REPLICA_NAME)
+        .filter(site_id=settings.SITE_ID)
+        .values_list("time_zone", flat=True)
+        .first()
+    ) or "UTC"
+    try:
+        zone = ZoneInfo(time_zone)
+    except (ZoneInfoNotFoundError, ValueError):
+        zone = ZoneInfo("UTC")
+    return timezone.now().astimezone(zone).date()
+
+
+def is_age_eligible(date_of_birth: date | None, minimum_age: int, today: date) -> bool:
+    """Tell whether someone born on `date_of_birth` is at least `minimum_age`."""
+    return (
+        date_of_birth is not None and calculate_age(date_of_birth, today) >= minimum_age
+    )
+
+
+def get_age_restriction_violation(
+    variants: "Iterable[ProductVariant]",
+    user: "User | None",
+    today: date | None = None,
+) -> AgeRestrictionViolation | None:
+    """Check whether `user` may buy the given variants.
+
+    Guests cannot buy age-restricted products, and customers need a birthday on
+    their profile that satisfies the product's minimum age. Returns `None` when
+    the purchase is allowed.
+    """
+    restricted = [
+        variant for variant in variants if variant.product.minimum_age is not None
+    ]
+    if not restricted:
+        return None
+
+    if user is None:
+        return AgeRestrictionViolation(
+            CheckoutErrorCode.AGE_RESTRICTED_LOGIN_REQUIRED, restricted
+        )
+
+    if user.date_of_birth is None:
+        return AgeRestrictionViolation(
+            CheckoutErrorCode.AGE_RESTRICTION_NOT_MET, restricted
+        )
+
+    age = calculate_age(user.date_of_birth, today or get_shop_today())
+    too_young = [
+        variant
+        for variant in restricted
+        if (minimum_age := variant.product.minimum_age) is not None
+        and age < minimum_age
+    ]
+    if too_young:
+        return AgeRestrictionViolation(
+            CheckoutErrorCode.AGE_RESTRICTION_NOT_MET, too_young
+        )
+    return None
+
+
+AGE_RESTRICTION_MESSAGES = {
+    CheckoutErrorCode.AGE_RESTRICTED_LOGIN_REQUIRED: (
+        "Age-restricted products can only be bought by logged-in customers."
+    ),
+    CheckoutErrorCode.AGE_RESTRICTION_NOT_MET: (
+        "The customer does not meet the minimum age of the products."
+    ),
+}
+
+
+def raise_if_age_restricted(
+    variants: "Iterable[ProductVariant]", user: "User | None"
+) -> None:
+    """Raise a ValidationError when `user` cannot buy some of the `variants`."""
+    variants = list(variants)
+    prefetch_related_objects(variants, "product")
+    violation = get_age_restriction_violation(variants, user)
+    if violation is None:
+        return
+    raise ValidationError(
+        {
+            "lines": ValidationError(
+                AGE_RESTRICTION_MESSAGES[violation.code],
+                code=violation.code.value,
+                params={
+                    "variants": [
+                        graphene.Node.to_global_id("ProductVariant", variant.pk)
+                        for variant in violation.variants
+                    ]
+                },
+            )
+        }
+    )
