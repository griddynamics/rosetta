+
+@freeze_time("2026-10-20 23:30:00+00:00")
+@pytest.mark.parametrize(
+    ("time_zone", "expected"),
+    [
+        ("UTC", datetime.date(2026, 10, 20)),
+        ("Pacific/Auckland", datetime.date(2026, 10, 21)),
+        ("America/Los_Angeles", datetime.date(2026, 10, 20)),
+    ],
+)
+def test_get_shop_today_uses_shop_time_zone(site_settings, time_zone, expected):
+    # given
+    site_settings.time_zone = time_zone
+    site_settings.save(update_fields=["time_zone"])
+
+    # when / then
+    assert get_shop_today() == expected
+
+
+@freeze_time("2026-10-20 23:30:00+00:00")
+def test_customer_born_on_shop_date_is_eligible_before_utc_midnight(
+    site_settings, product_list, customer_user
+):
