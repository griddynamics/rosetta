+def test_customer_subscription_never_exposes_the_date_of_birth(
+    customer_user, subscription_webhook, permission_manage_users
+):
+    # given - an app that may read customers still must not get the date of birth
+    customer_user.date_of_birth = datetime.date(1990, 5, 17)
+    customer_user.save(update_fields=["date_of_birth"])
+    webhook = subscription_webhook(
+        """
+        subscription {
+          event {
+            ... on CustomerCreated {
+              user {
+                id
+                dateOfBirth
+              }
+            }
+          }
+        }
+        """,
+        WebhookEventAsyncType.CUSTOMER_CREATED,
+    )
+    webhook.app.permissions.add(permission_manage_users)
+
+    # when
+    deliveries = create_deliveries_for_subscriptions(
+        WebhookEventAsyncType.CUSTOMER_CREATED, customer_user, [webhook]
+    )
+
+    # then
+    payload = deliveries[0].payload.get_payload()
+    assert "1990-05-17" not in payload
+    assert json.loads(payload)["user"]["dateOfBirth"] is None
+
