+import { afterEach, describe, expect, it } from "vitest";
+import {
+	clearAgeIssue,
+	getAgeIssueSnapshot,
+	subscribeAgeIssue,
+	withAgeIssueReporting,
+} from "./age-issue-store";
+import type { CheckoutTransport } from "./checkout-transport";
+
+function makeTransport(overrides: Partial<CheckoutTransport>): CheckoutTransport {
+	const unused = () => Promise.reject(new Error("unused"));
+	return {
+		fetchCheckout: unused,
+		updateBillingAddress: unused,
+		attachCustomer: unused,
+		initializePaymentGateways: unused,
+		initializeTransaction: unused,
+		processTransaction: unused,
+		completeCheckout: unused,
+		...overrides,
+	} as CheckoutTransport;
+}
+
+afterEach(() => clearAgeIssue());
+
+describe("withAgeIssueReporting (AC-80)", () => {
+	it("publishes the age code from completeCheckout field errors with variants", async () => {
+		const transport = withAgeIssueReporting(
+			makeTransport({
+				completeCheckout: async () => ({
+					ok: false,
+					error: "x",
+					fieldErrors: [{ field: "lines", message: "m", code: "CUSTOMER_TOO_YOUNG", variants: ["v1"] }],
+				}),
+			}),
+		);
+		await transport.completeCheckout("c1");
+		expect(getAgeIssueSnapshot()).toEqual({ code: "CUSTOMER_TOO_YOUNG", variantIds: ["v1"] });
+	});
+
+	it("publishes transactionInitialize / transactionProcess age codes", async () => {
+		const transport = withAgeIssueReporting(
+			makeTransport({
+				initializeTransaction: async () => ({ ok: false, error: "m", code: "CUSTOMER_AGE_UNKNOWN" }),
+				processTransaction: async () => ({ ok: false, error: "m", code: "CUSTOMER_TOO_YOUNG" }),
+			}),
+		);
+		await transport.initializeTransaction({} as never);
+		expect(getAgeIssueSnapshot()?.code).toBe("CUSTOMER_AGE_UNKNOWN");
+		await transport.processTransaction({} as never);
+		expect(getAgeIssueSnapshot()?.code).toBe("CUSTOMER_TOO_YOUNG");
+	});
+
+	it("ignores other errors and passes results through unchanged", async () => {
+		const failure = { ok: false as const, error: "boom", code: "INVALID" };
+		const transport = withAgeIssueReporting(makeTransport({ initializeTransaction: async () => failure }));
+		await expect(transport.initializeTransaction({} as never)).resolves.toBe(failure);
+		expect(getAgeIssueSnapshot()).toBeNull();
+	});
+
+	it("notifies subscribers on report and clear", async () => {
+		let calls = 0;
+		const unsubscribe = subscribeAgeIssue(() => {
+			calls += 1;
+		});
+		const transport = withAgeIssueReporting(
+			makeTransport({
+				initializeTransaction: async () => ({ ok: false, error: "m", code: "CUSTOMER_AGE_UNKNOWN" }),
+			}),
+		);
+		await transport.initializeTransaction({} as never);
+		clearAgeIssue();
+		unsubscribe();
+		expect(calls).toBe(2);
+	});
+});
