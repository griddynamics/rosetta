+import type { CheckoutUser, RawCheckoutUser } from "@/checkout/lib/checkout-types";
+
+/** Strip the raw date of birth, keeping only whether one is set. Run before any client hand-off. */
+export function toCheckoutUser(user: RawCheckoutUser): CheckoutUser {
+	const { dateOfBirth, ...rest } = user;
+	return { ...rest, hasDateOfBirth: Boolean(dateOfBirth) };
+}
