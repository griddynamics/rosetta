new file mode 100644
index 0000000..7548854
--- /dev/null
+++ b/src/app/cart-action-result.ts
@@ -0,0 +1,67 @@
+import { getRequiredAge, isAgeRestrictionErrorCode, type AgeErrorCode } from "@/lib/age-restriction";
+
+/**
+ * Typed result of the cart server actions (`addVariantToCart`, `updateCartLineQuantity`).
+ * Only age-restriction codes are surfaced; every other failure stays a generic
+ * `ERROR` so existing behavior (log, no UI) is unchanged.
+ */
+export type CartActionResult =
+	| { ok: true }
+	| {
+			ok: false;
+			code: AgeErrorCode;
+			/** Max minimumAge from client data; null when unknown. Core message is never parsed. */
+			requiredAge: number | null;
+			isAuthenticated: boolean;
+	  }
+	| { ok: false; code: "ERROR" };
+
+export type AgeCartActionFailure = Extract<CartActionResult, { code: AgeErrorCode }>;
+
+export type CartMutationError = {
+	code?: string | null;
+	variants?: ReadonlyArray<string> | null;
+};
+
+export function isAgeCartActionFailure(
+	result: CartActionResult | null | undefined,
+): result is AgeCartActionFailure {
+	return result != null && !result.ok && isAgeRestrictionErrorCode(result.code);
+}
+
+/** True when any error carries an age-restriction code (lets callers resolve the session lazily). */
+export function hasAgeError(errors: ReadonlyArray<CartMutationError> | null | undefined): boolean {
+	return (errors ?? []).some((error) => isAgeRestrictionErrorCode(error.code));
+}
+
+/**
+ * Pure mapper from `checkoutLinesAdd` / `checkoutLinesUpdate` errors to a typed result.
+ * `lines` are the client-known lines (or the single product) used to compute the
+ * required age; when `variants` are named by the error they narrow the lines.
+ */
+export function mapCartMutationErrors(
+	errors: ReadonlyArray<CartMutationError> | null | undefined,
+	context: {
+		isAuthenticated: boolean;
+		lines?: ReadonlyArray<{ minimumAge?: number | null; variantId?: string | null }>;
+	},
+): CartActionResult {
+	const list = errors ?? [];
+	if (list.length === 0) return { ok: true };
+
+	// Unknown age outranks too young only if no too-young error is present: too young is final.
+	const ageErrors = list.filter((error) => isAgeRestrictionErrorCode(error.code));
+	if (ageErrors.length === 0) return { ok: false, code: "ERROR" };
+
+	const chosen = ageErrors.find((error) => error.code === "CUSTOMER_TOO_YOUNG") ?? ageErrors[0];
+	const lines = context.lines ?? [];
+	const requiredAge =
+		getRequiredAge(lines, chosen.variants) ?? (chosen.variants?.length ? getRequiredAge(lines) : null);
+
+	return {
+		ok: false,
+		code: chosen.code as AgeErrorCode,
+		requiredAge,
+		isAuthenticated: context.isAuthenticated,
+	};
+}
