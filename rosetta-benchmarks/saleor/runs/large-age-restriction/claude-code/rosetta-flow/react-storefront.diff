+"use client";
+
+import { useState, useTransition, useCallback } from "react";
+import { useParams, useRouter } from "next/navigation";
+import { useTranslations } from "next-intl";
+import { Button } from "@/ui/components/ui/button";
+import { Input } from "@/ui/components/ui/input";
+import { Label } from "@/ui/components/ui/label";
+import { resolveLocaleFromSlug } from "@/config/locale";
+import { updateBirthday } from "@/app/(storefront)/[locale]/[channel]/(main)/account/actions";
+import { resolveAccountActionError } from "@/ui/components/account/account-action-result";
+import {
+	BIRTHDAY_FIELD,
+	formatBirthday,
+	parseBirthday,
+	toBirthdayInputValue,
+} from "@/ui/components/account/birthday-form-utils";
+
+type Props = {
+	dateOfBirth: string | null;
+};
+
+export function EditBirthdayForm({ dateOfBirth }: Props) {
+	const t = useTranslations("account");
+	const tAge = useTranslations("ageRestriction");
+	const router = useRouter();
+	const params = useParams<{ locale: string }>();
+	const [isEditing, setIsEditing] = useState(false);
+	const [isPending, startTransition] = useTransition();
+	const [error, setError] = useState("");
+	const [success, setSuccess] = useState(false);
+
+	const handleSubmit = useCallback(
+		(formData: FormData) => {
+			setError("");
+			setSuccess(false);
+
+			const raw = formData.get(BIRTHDAY_FIELD);
+			if (!parseBirthday(typeof raw === "string" ? raw : "").ok) {
+				setError(tAge("birthdayInvalid"));
+				return;
+			}
+
+			startTransition(async () => {
+				const result = await updateBirthday(formData);
+				if (result.success) {
+					setSuccess(true);
+					setIsEditing(false);
+					router.refresh();
+				} else if ("invalid" in result) {
+					setError(tAge("birthdayInvalid"));
+				} else {
+					setError(resolveAccountActionError(t, result));
+				}
+			});
+		},
+		[router, startTransition, t, tAge],
+	);
+
+	if (!isEditing) {
+		const display = dateOfBirth
+			? formatBirthday(dateOfBirth, resolveLocaleFromSlug(params.locale).bcp47)
+			: "";
+		return (
+			<div className="flex items-center justify-between">
+				<div>
+					<p className="text-sm text-muted-foreground">{tAge("birthdayLabel")}</p>
+					<p className="font-medium">{display || t("common.notSet")}</p>
+				</div>
+				<div className="flex items-center gap-2">
+					{success && (
+						<span aria-live="polite" className="text-sm text-green-600">
+							{tAge("birthdaySaved")}
+						</span>
+					)}
+					<Button variant="ghost" size="sm" onClick={() => setIsEditing(true)}>
+						{t("common.edit")}
+					</Button>
+				</div>
+			</div>
+		);
+	}
+
+	return (
+		<form action={handleSubmit} className="space-y-4">
+			{error && (
+				<p role="alert" className="text-sm text-destructive">
+					{error}
+				</p>
+			)}
+			<div className="space-y-1.5">
+				<Label htmlFor={BIRTHDAY_FIELD}>{tAge("birthdayLabel")}</Label>
+				<Input
+					id={BIRTHDAY_FIELD}
+					name={BIRTHDAY_FIELD}
+					type="date"
+					autoComplete="bday"
+					defaultValue={toBirthdayInputValue(dateOfBirth)}
+					aria-describedby={`${BIRTHDAY_FIELD}-help`}
+				/>
+				<p id={`${BIRTHDAY_FIELD}-help`} className="text-sm text-muted-foreground">
+					{tAge("birthdayHelp")}
+				</p>
+			</div>
+			<div className="flex gap-2">
+				<Button type="submit" size="sm" disabled={isPending}>
+					{isPending ? t("common.saving") : t("common.save")}
+				</Button>
+				<Button
+					type="button"
+					variant="ghost"
+					size="sm"
+					onClick={() => {
+						setIsEditing(false);
+						setError("");
+					}}
+				>
+					{t("common.cancel")}
+				</Button>
+			</div>
+		</form>
+	);
+}
