+/** Sends only `dateOfBirth` (null clears). The value is never logged or echoed in errors. */
+export async function updateBirthday(formData: FormData): Promise<BirthdayActionResult> {
+	const raw = formData.get(BIRTHDAY_FIELD);
+	const parsed = parseBirthday(typeof raw === "string" ? raw : "");
+	if (!parsed.ok) {
+		return { success: false, invalid: true };
+	}
+
+	const result = await mutate(AccountUpdateDocument, {
+		variables: { input: toBirthdayInput(parsed.value) },
+	});
+
+	if (!result.ok) {
+		return { success: false, error: result.error.message };
+	}
+
+	const errors = result.data.accountUpdate?.errors;
+	if (errors?.length) {
+		if (errors.some((e) => e.code === "INVALID")) {
+			return { success: false, invalid: true };
+		}
+		return { success: false, errorKey: "updateProfileFailed" };
+	}
+
+	revalidateAccountLayout();
+	return { success: true };
+}
