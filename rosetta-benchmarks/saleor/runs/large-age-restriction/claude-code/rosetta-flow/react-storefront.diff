+++ b/src/checkout/lib/age-issue-store.ts
@@ -0,0 +1,67 @@
+import { getAgeIssueFromErrors, type AgeIssue } from "@/checkout/lib/age-restriction-gate";
+import { isAgeRestrictionErrorCode } from "@/lib/age-restriction";
+import type { CheckoutTransport } from "@/checkout/lib/checkout-transport";
+
+/**
+ * Last age-restriction error core returned from checkoutComplete / transactionInitialize /
+ * transactionProcess. Payment code paths (dummy, Stripe, free order, finalize) only carry
+ * strings; this store lets the payment step show the banner without threading a new field
+ * through each of them. Observed at the transport boundary via `withAgeIssueReporting`.
+ */
+let currentIssue: AgeIssue | null = null;
+const listeners = new Set<() => void>();
+
+function emit() {
+	for (const listener of listeners) listener();
+}
+
+export function reportAgeIssue(issue: AgeIssue): void {
+	currentIssue = issue;
+	emit();
+}
+
+export function clearAgeIssue(): void {
+	if (currentIssue === null) return;
+	currentIssue = null;
+	emit();
+}
+
+export function getAgeIssueSnapshot(): AgeIssue | null {
+	return currentIssue;
+}
+
+export function subscribeAgeIssue(listener: () => void): () => void {
+	listeners.add(listener);
+	return () => {
+		listeners.delete(listener);
+	};
+}
+
+/** Wrap a transport so age errors from payment/completion calls are published to the store. */
+export function withAgeIssueReporting(transport: CheckoutTransport): CheckoutTransport {
+	return {
+		...transport,
+		initializeTransaction: async (variables) => {
+			const result = await transport.initializeTransaction(variables);
+			if (!result.ok && isAgeRestrictionErrorCode(result.code)) {
+				reportAgeIssue({ code: result.code, variantIds: [] });
+			}
+			return result;
+		},
+		processTransaction: async (variables) => {
+			const result = await transport.processTransaction(variables);
+			if (!result.ok && isAgeRestrictionErrorCode(result.code)) {
+				reportAgeIssue({ code: result.code, variantIds: [] });
+			}
+			return result;
+		},
+		completeCheckout: async (checkoutId) => {
+			const result = await transport.completeCheckout(checkoutId);
+			if (!result.ok) {
+				const issue = getAgeIssueFromErrors(result.fieldErrors);
+				if (issue) reportAgeIssue(issue);
+			}
+			return result;
+		},
+	};
+}
