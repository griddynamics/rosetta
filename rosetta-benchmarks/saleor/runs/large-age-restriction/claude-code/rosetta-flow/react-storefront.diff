+import { describe, expect, it } from "vitest";
+import {
+	formatBirthday,
+	parseBirthday,
+	toBirthdayInput,
+	toBirthdayInputValue,
+} from "@/ui/components/account/birthday-form-utils";
+
+const NOW = new Date("2026-11-02T12:00:00Z");
+
+describe("parseBirthday", () => {
+	it("accepts a valid past date", () => {
+		expect(parseBirthday("1990-05-17", NOW)).toEqual({ ok: true, value: "1990-05-17" });
+	});
+
+	it("treats empty and whitespace as clear", () => {
+		expect(parseBirthday("", NOW)).toEqual({ ok: true, value: null });
+		expect(parseBirthday("  ", NOW)).toEqual({ ok: true, value: null });
+		expect(parseBirthday(null, NOW)).toEqual({ ok: true, value: null });
+		expect(parseBirthday(undefined, NOW)).toEqual({ ok: true, value: null });
+	});
+
+	it("accepts today and rejects future dates", () => {
+		expect(parseBirthday("2026-11-02", NOW)).toEqual({ ok: true, value: "2026-11-02" });
+		expect(parseBirthday("2026-11-04", NOW)).toEqual({ ok: false });
+		expect(parseBirthday("2027-01-01", NOW)).toEqual({ ok: false });
+	});
+
+	it("allows a date that is already today in the furthest-ahead timezone", () => {
+		expect(parseBirthday("2026-11-03", NOW)).toEqual({ ok: true, value: "2026-11-03" });
+	});
+
+	it("rejects malformed values", () => {
+		for (const bad of ["abc", "1990-5-17", "17/05/1990", "1990-05-17T00:00", "19900517"]) {
+			expect(parseBirthday(bad, NOW)).toEqual({ ok: false });
+		}
+	});
+
+	it("rejects impossible calendar dates but accepts leap days", () => {
+		expect(parseBirthday("1990-02-30", NOW)).toEqual({ ok: false });
+		expect(parseBirthday("1990-13-01", NOW)).toEqual({ ok: false });
+		expect(parseBirthday("1990-00-10", NOW)).toEqual({ ok: false });
+		expect(parseBirthday("2001-02-29", NOW)).toEqual({ ok: false });
+		expect(parseBirthday("2000-02-29", NOW)).toEqual({ ok: true, value: "2000-02-29" });
+	});
+
+	it("rejects dates before 1900", () => {
+		expect(parseBirthday("1899-12-31", NOW)).toEqual({ ok: false });
+		expect(parseBirthday("1900-01-01", NOW)).toEqual({ ok: true, value: "1900-01-01" });
+	});
+});
+
+describe("toBirthdayInput", () => {
+	it("sends only dateOfBirth", () => {
+		expect(toBirthdayInput("1990-05-17")).toEqual({ dateOfBirth: "1990-05-17" });
+		expect(Object.keys(toBirthdayInput("1990-05-17"))).toEqual(["dateOfBirth"]);
+	});
+
+	it("serializes clear as explicit null", () => {
+		expect(toBirthdayInput(null)).toEqual({ dateOfBirth: null });
+	});
+});
+
+describe("toBirthdayInputValue / formatBirthday", () => {
+	it("prefills the input from a stored value", () => {
+		expect(toBirthdayInputValue("1990-05-17")).toBe("1990-05-17");
+		expect(toBirthdayInputValue(null)).toBe("");
+		expect(toBirthdayInputValue(undefined)).toBe("");
+		expect(toBirthdayInputValue("garbage")).toBe("");
+	});
+
+	it("formats without timezone shift", () => {
+		expect(formatBirthday("1990-05-17", "en-US")).toBe("May 17, 1990");
+		expect(formatBirthday("bad", "en-US")).toBe("");
+	});
+});
diff --git a/src/ui/components/account/birthday-form-utils.ts b/src/ui/components/account/birthday-form-utils.ts
