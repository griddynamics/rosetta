diff --git a/src/checkout/hooks/use-age-restriction.ts b/src/checkout/hooks/use-age-restriction.ts
new file mode 100644
index 0000000..22a0531
--- /dev/null
+++ b/src/checkout/hooks/use-age-restriction.ts
@@ -0,0 +1,112 @@
+"use client";
+
+import { useCallback, useEffect, useMemo, useRef, useState } from "react";
+import { removeCheckoutLine } from "@/app/(checkout)/actions";
+import type { CheckoutFragment } from "@/checkout/graphql";
+import { useAgeIssue } from "@/checkout/hooks/use-age-issue";
+import { useCheckout } from "@/checkout/hooks/use-checkout";
+import { useCheckoutBrowseLocale } from "@/checkout/providers/checkout-browse";
+import { useUser } from "@/checkout/hooks/use-user";
+import { clearAgeIssue } from "@/checkout/lib/age-issue-store";
+import {
+	buildAgeBannerModel,
+	decidePrePaymentGate,
+	toAgeGateLines,
+	type AgeBannerModel,
+} from "@/checkout/lib/age-restriction-gate";
+import { buildStorefrontPath } from "@/lib/storefront-path";
+
+type UseAgeRestrictionOptions = {
+	checkout: CheckoutFragment;
+	/** `useCustomerAttach().attachFailed` */
+	attachFailed: boolean;
+	/** Reopen the information step, where the shopper can sign in. */
+	onSignIn: () => void;
+	/** Shown when removing restricted lines fails. */
+	removeFailedMessage: string;
+};
+
+/**
+ * Age-restriction state for the payment step: the pre-payment gate (guest, no birthday,
+ * waiting for customer attach) merged with the last core age error from complete/transaction
+ * calls. `blocked`/`waiting` disable payment; core stays the authority.
+ */
+export function useAgeRestriction({
+	checkout,
+	attachFailed,
+	onSignIn,
+	removeFailedMessage,
+}: UseAgeRestrictionOptions) {
+	const { user, authenticated } = useUser();
+	const { setCheckout } = useCheckout();
+	const locale = useCheckoutBrowseLocale();
+	const issue = useAgeIssue();
+	const [isRemoving, setIsRemoving] = useState(false);
+	const [removeError, setRemoveError] = useState<string | null>(null);
+
+	const lines = useMemo(() => toAgeGateLines(checkout.lines), [checkout.lines]);
+	const hasDateOfBirth = user?.hasDateOfBirth ?? false;
+
+	const gate = decidePrePaymentGate({
+		lines,
+		authenticated,
+		hasDateOfBirth,
+		checkoutHasUser: Boolean(checkout.user?.id),
+		attachFailed,
+	});
+
+	// A stale core error no longer applies once lines or the customer's birthday change.
+	const contextKey = `${lines.map((line) => `${line.id}:${line.minimumAge ?? ""}`).join(",")}|${user?.id ?? ""}|${hasDateOfBirth}`;
+	const previousKey = useRef(contextKey);
+	useEffect(() => {
+		if (previousKey.current !== contextKey) {
+			previousKey.current = contextKey;
+			clearAgeIssue();
+		}
+	}, [contextKey]);
+
+	let model: AgeBannerModel | null = null;
+	if (issue) {
+		model = buildAgeBannerModel({
+			code: issue.code,
+			isAuthenticated: authenticated,
+			lines,
+			variantIds: issue.variantIds,
+		});
+	} else if (gate.status === "block") {
+		model = gate.model;
+	}
+
+	const removeRestricted = useCallback(async () => {
+		if (!model || isRemoving) return;
+		setIsRemoving(true);
+		setRemoveError(null);
+		try {
+			let latest: Awaited<ReturnType<typeof removeCheckoutLine>> | null = null;
+			for (const lineId of model.lineIds) {
+				latest = await removeCheckoutLine(checkout.id, lineId);
+				if (!latest.ok) {
+					setRemoveError(removeFailedMessage);
+					return;
+				}
+			}
+			if (latest?.ok) setCheckout(latest.checkout);
+			clearAgeIssue();
+		} catch {
+			setRemoveError(removeFailedMessage);
+		} finally {
+			setIsRemoving(false);
+		}
+	}, [checkout.id, isRemoving, model, removeFailedMessage, setCheckout]);
+
+	return {
+		model,
+		blocked: model !== null,
+		waiting: model === null && gate.status === "wait",
+		addBirthdayHref: buildStorefrontPath(locale, checkout.channel.slug, "/account/settings"),
+		onSignIn,
+		removeRestricted,
+		isRemoving,
+		removeError,
+	};
+}
