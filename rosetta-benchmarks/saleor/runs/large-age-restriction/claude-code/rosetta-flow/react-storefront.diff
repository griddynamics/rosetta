+import { describe, expect, it } from "vitest";
+import {
+	buildAgeBannerModel,
+	decidePrePaymentGate,
+	getAgeIssueFromErrors,
+	toAgeGateLines,
+	type AgeGateLine,
+} from "./age-restriction-gate";
+
+const restricted: AgeGateLine = { id: "l1", variantId: "v1", minimumAge: 18 };
+const stricter: AgeGateLine = { id: "l2", variantId: "v2", minimumAge: 21 };
+const free: AgeGateLine = { id: "l3", variantId: "v3", minimumAge: null };
+
+describe("toAgeGateLines", () => {
+	it("maps variant id and product minimum age", () => {
+		expect(
+			toAgeGateLines([
+				{ id: "a", variant: { id: "v", product: { minimumAge: 16 } } },
+				{ id: "b", variant: null },
+			]),
+		).toEqual([
+			{ id: "a", variantId: "v", minimumAge: 16 },
+			{ id: "b", variantId: null, minimumAge: null },
+		]);
+	});
+});
+
+describe("getAgeIssueFromErrors", () => {
+	it("finds the age error among other errors and keeps variants", () => {
+		expect(
+			getAgeIssueFromErrors([{ code: "INVALID" }, { code: "CUSTOMER_TOO_YOUNG", variants: ["v1"] }]),
+		).toEqual({ code: "CUSTOMER_TOO_YOUNG", variantIds: ["v1"] });
+	});
+
+	it("returns null without an age code", () => {
+		expect(getAgeIssueFromErrors([{ code: "INVALID" }])).toBeNull();
+		expect(getAgeIssueFromErrors(undefined)).toBeNull();
+	});
+});
+
+describe("buildAgeBannerModel (AC-80)", () => {
+	it("guest + unknown age: sign in and remove, required age from lines", () => {
+		const model = buildAgeBannerModel({
+			code: "CUSTOMER_AGE_UNKNOWN",
+			isAuthenticated: false,
+			lines: [restricted, stricter, free],
+		});
+		expect(model).toMatchObject({
+			code: "CUSTOMER_AGE_UNKNOWN",
+			messageKey: "ageUnknownGuest",
+			requiredAge: 21,
+			actions: ["sign-in", "remove-restricted"],
+			lineIds: ["l1", "l2"],
+		});
+	});
+
+	it("signed in + unknown age: add birthday and remove", () => {
+		const model = buildAgeBannerModel({
+			code: "CUSTOMER_AGE_UNKNOWN",
+			isAuthenticated: true,
+			lines: [restricted],
+		});
+		expect(model?.messageKey).toBe("ageUnknownNoBirthday");
+		expect(model?.actions).toEqual(["add-birthday", "remove-restricted"]);
+	});
+
+	it("too young: message and remove only", () => {
+		const model = buildAgeBannerModel({
+			code: "CUSTOMER_TOO_YOUNG",
+			isAuthenticated: true,
+			lines: [restricted, stricter],
+			variantIds: ["v1"],
+		});
+		expect(model).toMatchObject({
+			messageKey: "ageTooYoung",
+			requiredAge: 18,
+			actions: ["remove-restricted"],
+			lineIds: ["l1"],
+			variantIds: ["v1"],
+		});
+	});
+
+	it("falls back to all restricted lines when core variants are unknown to the client", () => {
+		const model = buildAgeBannerModel({
+			code: "CUSTOMER_TOO_YOUNG",
+			isAuthenticated: true,
+			lines: [restricted, free],
+			variantIds: ["other"],
+		});
+		expect(model?.lineIds).toEqual(["l1"]);
+	});
+
+	it("omits remove when no restricted line is known", () => {
+		const model = buildAgeBannerModel({
+			code: "CUSTOMER_TOO_YOUNG",
+			isAuthenticated: true,
+			lines: [free],
+		});
+		expect(model?.actions).toEqual([]);
+		expect(model?.requiredAge).toBeNull();
+	});
+
+	it("returns null for non-age codes", () => {
+		expect(buildAgeBannerModel({ code: "INVALID", isAuthenticated: true, lines: [restricted] })).toBeNull();
+	});
+});
+
+describe("decidePrePaymentGate (AC-81, E-21)", () => {
+	it("allows when nothing is restricted", () => {
+		expect(decidePrePaymentGate({ lines: [free], authenticated: false, checkoutHasUser: false })).toEqual({
+			status: "allow",
+		});
+	});
+
+	it("blocks guests with the sign-in banner", () => {
+		const decision = decidePrePaymentGate({
+			lines: [restricted],
+			authenticated: false,
+			checkoutHasUser: false,
+		});
+		expect(decision.status).toBe("block");
+		if (decision.status === "block") {
+			expect(decision.model.actions).toContain("sign-in");
+		}
+	});
+
+	it("blocks signed-in customers without a birthday with the add-birthday banner", () => {
+		const decision = decidePrePaymentGate({
+			lines: [restricted],
+			authenticated: true,
+			hasDateOfBirth: false,
+			checkoutHasUser: true,
+		});
+		expect(decision.status).toBe("block");
+		if (decision.status === "block") {
+			expect(decision.model.messageKey).toBe("ageUnknownNoBirthday");
+			expect(decision.model.actions).toContain("add-birthday");
+		}
+	});
+
+	it("waits when authenticated with a birthday but the customer is not attached yet (E-21)", () => {
+		expect(
+			decidePrePaymentGate({
+				lines: [restricted],
+				authenticated: true,
+				hasDateOfBirth: true,
+				checkoutHasUser: false,
+			}),
+		).toEqual({ status: "wait" });
+	});
+
+	it("stops waiting when attach failed (core stays the authority)", () => {
+		expect(
+			decidePrePaymentGate({
+				lines: [restricted],
+				authenticated: true,
+				hasDateOfBirth: true,
+				checkoutHasUser: false,
+				attachFailed: true,
+			}),
+		).toEqual({ status: "allow" });
+	});
+
+	it("allows an attached customer with a birthday (too-young is decided by core)", () => {
+		expect(
+			decidePrePaymentGate({
+				lines: [restricted],
+				authenticated: true,
+				hasDateOfBirth: true,
+				checkoutHasUser: true,
+			}),
+		).toEqual({ status: "allow" });
+	});
+});
diff --git a/src/checkout/lib/age-restriction-gate.ts b/src/checkout/lib/age-restriction-gate.ts
new file mode 100644
index 0000000..0350a9a
--- /dev/null
+++ b/src/checkout/lib/age-restriction-gate.ts
@@ -0,0 +1,156 @@
+import {
+	getAgeFeedback,
+	getRequiredAge,
+	hasAgeRestriction,
+	isAgeRestrictionErrorCode,
+	type AgeErrorCode,
+	type AgeFeedback,
+} from "@/lib/age-restriction";
+
+/**
+ * Pure checkout age-restriction rules: banner model for core age errors and the
+ * pre-payment UX gate. Core stays the authority; the gate only avoids a doomed payment
+ * attempt. No React, no next-intl: callers map `messageKey` / action labels to copy.
+ */
+
+export type AgeBannerAction = "sign-in" | "add-birthday" | "remove-restricted";
+
+/** Minimal line shape; build it from checkout lines with `toAgeGateLines`. */
+export type AgeGateLine = {
+	id: string;
+	variantId?: string | null;
+	minimumAge?: number | null;
+};
+
+/** Age error observed from checkoutComplete / transactionInitialize / transactionProcess. */
+export type AgeIssue = {
+	code: AgeErrorCode;
+	/** Variant ids named by core (`checkoutComplete` only); empty means "all restricted lines". */
+	variantIds: string[];
+};
+
+export type AgeBannerModel = {
+	code: AgeErrorCode;
+	messageKey: AgeFeedback["messageKey"];
+	/** Value for `{age}`; null when no restricted line is known client-side. */
+	requiredAge: number | null;
+	actions: AgeBannerAction[];
+	/** Checkout line ids the "remove restricted items" action deletes. */
+	lineIds: string[];
+	variantIds: string[];
+};
+
+type ErrorLike = { code?: string | null; variants?: ReadonlyArray<string> | null };
+
+/** Map checkout lines (`variant.product.minimumAge`) to gate lines. */
+export function toAgeGateLines(
+	lines: ReadonlyArray<{
+		id: string;
+		variant?: { id?: string | null; product?: { minimumAge?: number | null } | null } | null;
+	}>,
+): AgeGateLine[] {
+	return lines.map((line) => ({
+		id: line.id,
+		variantId: line.variant?.id ?? null,
+		minimumAge: line.variant?.product?.minimumAge ?? null,
+	}));
+}
+
+/** First age error in a core error list (completion `fieldErrors`, payload `errors`), else null. */
+export function getAgeIssueFromErrors(errors: ReadonlyArray<ErrorLike> | null | undefined): AgeIssue | null {
+	const match = errors?.find((error) => isAgeRestrictionErrorCode(error.code));
+	if (!match || !isAgeRestrictionErrorCode(match.code)) return null;
+	return { code: match.code, variantIds: [...(match.variants ?? [])] };
+}
+
+function restrictedLines(
+	lines: ReadonlyArray<AgeGateLine>,
+	variantIds: ReadonlyArray<string>,
+): AgeGateLine[] {
+	const restricted = lines.filter((line) => hasAgeRestriction(line.minimumAge));
+	if (variantIds.length === 0) return restricted;
+	const named = restricted.filter((line) => line.variantId && variantIds.includes(line.variantId));
+	// Core named variants we cannot map (stale client data): fall back to every restricted line.
+	return named.length > 0 ? named : restricted;
+}
+
+/** Banner model for an age error; null when the code is not an age code. */
+export function buildAgeBannerModel(input: {
+	code: string | null | undefined;
+	isAuthenticated: boolean;
+	lines: ReadonlyArray<AgeGateLine>;
+	variantIds?: ReadonlyArray<string> | null;
+}): AgeBannerModel | null {
+	const variantIds = input.variantIds ? [...input.variantIds] : [];
+	const affected = restrictedLines(input.lines, variantIds);
+	const requiredAge = getRequiredAge(affected);
+	const feedback = getAgeFeedback({
+		code: input.code,
+		isAuthenticated: input.isAuthenticated,
+		requiredAge,
+	});
+	if (!feedback) return null;
+
+	const actions: AgeBannerAction[] = [];
+	if (feedback.cta) actions.push(feedback.cta);
+	if (affected.length > 0) actions.push("remove-restricted");
+
+	return {
+		code: feedback.code,
+		messageKey: feedback.messageKey,
+		requiredAge: feedback.requiredAge,
+		actions,
+		lineIds: affected.map((line) => line.id),
+		variantIds,
+	};
+}
+
+export type PrePaymentGateDecision =
+	| { status: "allow" }
+	/** Authenticated, customer not attached to the checkout yet (E-21): hold payment briefly. */
+	| { status: "wait" }
+	| { status: "block"; model: AgeBannerModel };
+
+/**
+ * Decide whether payment may start.
+ * - no restricted line: allow
+ * - guest: block (sign in)
+ * - signed in without date of birth: block (add birthday)
+ * - signed in with birthday but `checkout.user` not attached yet: wait for `use-customer-attach`
+ *   (core checks the checkout's user, not the request user); `attachFailed` stops the wait
+ * - otherwise allow; core decides too-young at transaction/complete time
+ */
+export function decidePrePaymentGate(input: {
+	lines: ReadonlyArray<AgeGateLine>;
+	authenticated: boolean;
+	/** Whether the signed-in customer has a date of birth on file (the raw value is never needed). */
+	hasDateOfBirth?: boolean;
+	/** True when `checkout.user` is already set. */
+	checkoutHasUser: boolean;
+	/** True after `checkoutCustomerAttach` failed (stops waiting; core remains the authority). */
+	attachFailed?: boolean;
+}): PrePaymentGateDecision {
+	if (!input.lines.some((line) => hasAgeRestriction(line.minimumAge))) return { status: "allow" };
+
+	if (!input.authenticated) {
+		const model = buildAgeBannerModel({
+			code: "CUSTOMER_AGE_UNKNOWN",
+			isAuthenticated: false,
+			lines: input.lines,
+		});
+		return model ? { status: "block", model } : { status: "allow" };
+	}
+
+	if (!input.hasDateOfBirth) {
+		const model = buildAgeBannerModel({
+			code: "CUSTOMER_AGE_UNKNOWN",
+			isAuthenticated: true,
+			lines: input.lines,
+		});
+		return model ? { status: "block", model } : { status: "allow" };
+	}
+
+	if (!input.checkoutHasUser && !input.attachFailed) return { status: "wait" };
+
+	return { status: "allow" };
+}
