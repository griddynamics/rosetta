new file mode 100644
index 0000000..12f2f82
--- /dev/null
+++ b/src/checkout/lib/server/load-checkout-app-messages.ts
@@ -0,0 +1,27 @@
+import { getDefaultLocaleSlug, isStorefrontLocaleSlug, type LocaleSlug } from "@/config/locale";
+import { loadCheckoutMessages, type CheckoutMessages } from "@/i18n/load-messages";
+import { mergeMessagesWithDefault } from "@/i18n/merge-messages";
+import enMessages from "../../../../messages/en.json";
+
+type AgeRestrictionMessages = (typeof enMessages)["ageRestriction"];
+
+/**
+ * Checkout catalog plus the `ageRestriction` namespace (order-summary badge, age banner).
+ * `loadCheckoutMessages` only ships `checkout` + `account`, so the age strings are added here
+ * (same locale validation and fallback to English).
+ */
+export type CheckoutAppMessages = CheckoutMessages & { ageRestriction?: AgeRestrictionMessages };
+
+export async function loadCheckoutAppMessages(locale: LocaleSlug): Promise<CheckoutAppMessages> {
+	const safeLocale = isStorefrontLocaleSlug(locale) ? locale : getDefaultLocaleSlug();
+	const base = await loadCheckoutMessages(safeLocale);
+	if (safeLocale === "en") {
+		return { ...base, ageRestriction: enMessages.ageRestriction };
+	}
+
+	const localized = (
+		(await import(`../../../../messages/${safeLocale}.json`)) as { default: typeof enMessages }
+	).default;
+	const merged = mergeMessagesWithDefault(enMessages, localized);
+	return { ...base, ageRestriction: merged.ageRestriction };
+}
