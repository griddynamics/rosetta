new file mode 100644
index 0000000..c81fd93
--- /dev/null
+++ b/src/lib/age-restriction-privacy.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, it } from "vitest";
+import * as gql from "@/gql/graphql";
+// eslint-disable-next-line paper/saleor-access -- test-only read of the operation registry (the barrel does not export it)
+import { getOperation, operationNameFromDocument } from "@/lib/saleor/operations";
+
+type NamedDocument = { name: string; text: string };
+
+function collectDocuments(): NamedDocument[] {
+	const docs: NamedDocument[] = [];
+	for (const [exportName, value] of Object.entries(gql)) {
+		if (!exportName.endsWith("Document") || value == null) continue;
+		const text = String(value);
+		if (!/^\s*(query|mutation|subscription)\s+\w+/m.test(text)) continue;
+		docs.push({ name: operationNameFromDocument(text), text });
+	}
+	return docs;
+}
+
+describe("dateOfBirth stays session-only (P-8)", () => {
+	const docs = collectDocuments();
+
+	it("finds the generated operation documents", () => {
+		expect(docs.length).toBeGreaterThan(10);
+	});
+
+	it("CurrentUserProfile is a session operation that selects dateOfBirth", () => {
+		expect(getOperation("CurrentUserProfile")?.access).toBe("session");
+		const profile = docs.find((doc) => doc.name === "CurrentUserProfile");
+		expect(profile?.text).toContain("dateOfBirth");
+	});
+
+	it("no cached operation document (fragments included) selects dateOfBirth", () => {
+		const cached = docs.filter((doc) => getOperation(doc.name)?.access === "cached");
+		expect(cached.length).toBeGreaterThan(5);
+		for (const doc of cached) {
+			expect(doc.text, `${doc.name} must not select dateOfBirth`).not.toContain("dateOfBirth");
+		}
+	});
+
+	it("every operation selecting dateOfBirth is session or mutate access", () => {
