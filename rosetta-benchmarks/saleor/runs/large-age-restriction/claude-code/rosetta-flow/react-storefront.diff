+import { describe, expect, it } from "vitest";
+import * as ops from "@/checkout/graphql/generated/operations";
+import type { RawCheckoutUser } from "@/checkout/lib/checkout-types";
+import { toCheckoutUser } from "@/checkout/lib/to-checkout-user";
+
+const base = {
+	__typename: "User",
+	id: "VXNlcjox",
+	email: "a@example.com",
+	addresses: [],
+	defaultBillingAddress: null,
+	defaultShippingAddress: null,
+} as unknown as RawCheckoutUser;
+
+describe("toCheckoutUser (P-8: no raw birthday in the checkout client payload)", () => {
+	it("drops the raw date and flags a set birthday", () => {
+		const out = toCheckoutUser({ ...base, dateOfBirth: "1990-01-01" });
+		expect(out.hasDateOfBirth).toBe(true);
+		expect(out).not.toHaveProperty("dateOfBirth");
+		expect(JSON.stringify(out)).not.toContain("1990");
+	});
+
+	it.each([null, undefined, ""])("flags a missing birthday (%s)", (value) => {
+		const out = toCheckoutUser({ ...base, dateOfBirth: value } as RawCheckoutUser);
+		expect(out.hasDateOfBirth).toBe(false);
+		expect(out).not.toHaveProperty("dateOfBirth");
+	});
+
+	it("keeps the other profile fields", () => {
+		const out = toCheckoutUser({ ...base, dateOfBirth: "1990-01-01" });
+		expect(out.id).toBe("VXNlcjox");
+		expect(out.email).toBe("a@example.com");
+	});
+
+	it("only the server-side user query selects the birthday, not shared fragments or mutations", () => {
+		expect(JSON.stringify(ops.UserDocument)).toContain("dateOfBirth");
+		for (const doc of [
+			ops.UserAddressCreateDocument,
+			ops.UserAddressUpdateDocument,
+			ops.UserAddressDeleteDocument,
+			ops.UserSetDefaultAddressDocument,
+		]) {
+			expect(JSON.stringify(doc)).not.toContain("dateOfBirth");
+		}
+	});
+});
