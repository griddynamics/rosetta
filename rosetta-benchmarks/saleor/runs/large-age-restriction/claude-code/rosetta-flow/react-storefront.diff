+import { describe, expect, it } from "vitest";
+import {
+	formatAgeBadge,
+	getAgeFeedback,
+	getRequiredAge,
+	hasAgeRestriction,
+	isAgeRestrictionErrorCode,
+} from "@/lib/age-restriction";
+
+describe("formatAgeBadge / hasAgeRestriction", () => {
+	it("formats the badge as N+", () => {
+		expect(formatAgeBadge(18)).toBe("18+");
+		expect(formatAgeBadge(21)).toBe("21+");
+	});
+
+	it("treats only positive numbers as restrictions", () => {
+		expect(hasAgeRestriction(18)).toBe(true);
+		expect(hasAgeRestriction(null)).toBe(false);
+		expect(hasAgeRestriction(undefined)).toBe(false);
+		expect(hasAgeRestriction(0)).toBe(false);
+		expect(hasAgeRestriction(Number.NaN)).toBe(false);
+	});
+});
+
+describe("getRequiredAge", () => {
+	it("returns the max minimumAge of restricted lines", () => {
+		expect(getRequiredAge([{ minimumAge: null }, { minimumAge: 18 }, { minimumAge: 21 }])).toBe(21);
+	});
+
+	it("returns null when nothing is restricted or there are no lines", () => {
+		expect(getRequiredAge([])).toBeNull();
+		expect(getRequiredAge([{ minimumAge: null }, {}])).toBeNull();
+	});
+
+	it("narrows to the variants named by a core error", () => {
+		const lines = [
+			{ variantId: "v1", minimumAge: 21 },
+			{ variantId: "v2", minimumAge: 18 },
+			{ variantId: "v3", minimumAge: null },
+		];
+		expect(getRequiredAge(lines, ["v2", "v3"])).toBe(18);
+		expect(getRequiredAge(lines, ["v3"])).toBeNull();
+		expect(getRequiredAge(lines, [])).toBe(21);
+		expect(getRequiredAge(lines, null)).toBe(21);
+	});
+});
+
+describe("getAgeFeedback", () => {
+	it("recognises only the two age codes", () => {
+		expect(isAgeRestrictionErrorCode("CUSTOMER_AGE_UNKNOWN")).toBe(true);
+		expect(isAgeRestrictionErrorCode("CUSTOMER_TOO_YOUNG")).toBe(true);
+		expect(isAgeRestrictionErrorCode("INVALID")).toBe(false);
+		expect(isAgeRestrictionErrorCode(null)).toBe(false);
+		expect(getAgeFeedback({ code: "INVALID", isAuthenticated: true })).toBeNull();
+	});
+
+	it("guest with unknown age gets the sign-in CTA", () => {
+		expect(getAgeFeedback({ code: "CUSTOMER_AGE_UNKNOWN", isAuthenticated: false, requiredAge: 18 })).toEqual(
+			{
+				code: "CUSTOMER_AGE_UNKNOWN",
+				messageKey: "ageUnknownGuest",
+				cta: "sign-in",
+				ctaLabelKey: "signIn",
+				requiredAge: 18,
+			},
+		);
+	});
+
+	it("signed-in customer without birthday gets the add-birthday CTA", () => {
+		expect(getAgeFeedback({ code: "CUSTOMER_AGE_UNKNOWN", isAuthenticated: true, requiredAge: 21 })).toEqual({
+			code: "CUSTOMER_AGE_UNKNOWN",
+			messageKey: "ageUnknownNoBirthday",
+			cta: "add-birthday",
+			ctaLabelKey: "addBirthday",
+			requiredAge: 21,
+		});
+	});
+
+	it("too young is message only, for guests and signed-in customers", () => {
+		for (const isAuthenticated of [true, false]) {
+			expect(getAgeFeedback({ code: "CUSTOMER_TOO_YOUNG", isAuthenticated, requiredAge: 18 })).toEqual({
+				code: "CUSTOMER_TOO_YOUNG",
+				messageKey: "ageTooYoung",
+				cta: null,
+				ctaLabelKey: null,
+				requiredAge: 18,
+			});
+		}
+	});
+
+	it("normalises a missing required age to null", () => {
+		expect(getAgeFeedback({ code: "CUSTOMER_TOO_YOUNG", isAuthenticated: true })?.requiredAge).toBeNull();
+		expect(
+			getAgeFeedback({ code: "CUSTOMER_TOO_YOUNG", isAuthenticated: true, requiredAge: 0 })?.requiredAge,
+		).toBeNull();
+	});
+});
diff --git a/src/lib/age-restriction.ts b/src/lib/age-restriction.ts
new file mode 100644
index 0000000..b929c0c
--- /dev/null
+++ b/src/lib/age-restriction.ts
@@ -0,0 +1,111 @@
+/**
+ * Age-restriction helpers shared by cards, PDP, cart and checkout.
+ *
+ * Pure and dependency-free so they run in server, client and checkout surfaces.
+ * Restricted products are labelled, never hidden. Core stays the authority; these
+ * helpers only decide copy and calls to action from client data (the core error
+ * message is never parsed).
+ */
+
+export const AGE_ERROR_CODES = ["CUSTOMER_AGE_UNKNOWN", "CUSTOMER_TOO_YOUNG"] as const;
+
+export type AgeErrorCode = (typeof AGE_ERROR_CODES)[number];
+
+/** `messages/*.json` namespace holding every age-restriction string. */
+export const AGE_MESSAGES_NAMESPACE = "ageRestriction" as const;
+
+export const AGE_MESSAGE_KEYS = [
+	"ageBadge",
+	"ageBadgeAria",
+	"ageUnknownGuest",
+	"ageUnknownNoBirthday",
+	"ageTooYoung",
+	"signIn",
+	"addBirthday",
+	"removeRestricted",
+	"birthdayLabel",
+	"birthdayHelp",
+	"birthdaySaved",
+	"birthdayInvalid",
+] as const;
+
+export type AgeMessageKey = (typeof AGE_MESSAGE_KEYS)[number];
+
+export type AgeCta = "sign-in" | "add-birthday";
+
+export type AgeFeedback = {
+	code: AgeErrorCode;
+	messageKey: "ageUnknownGuest" | "ageUnknownNoBirthday" | "ageTooYoung";
+	/** Call to action; null means message only. */
+	cta: AgeCta | null;
+	ctaLabelKey: "signIn" | "addBirthday" | null;
+	/** Values for the `{age}` placeholder; null when the lines are unknown. */
+	requiredAge: number | null;
+};
+
+/** Plain-text badge, e.g. `18+`. */
+export function formatAgeBadge(minimumAge: number): string {
+	return `${minimumAge}+`;
+}
+
+/** True when a product carries a minimum age. `0` and negatives are not restrictions. */
+export function hasAgeRestriction(minimumAge: number | null | undefined): minimumAge is number {
+	return typeof minimumAge === "number" && Number.isFinite(minimumAge) && minimumAge > 0;
+}
+
+export type AgeRestrictedLine = {
+	minimumAge?: number | null;
+	/** Variant id, used to narrow to the variants named by a core error. */
+	variantId?: string | null;
+};
+
+/**
+ * Required age = max `minimumAge` over the restricted lines (optionally only the
+ * lines whose variant is in `variantIds`). Returns null when nothing is restricted.
+ */
+export function getRequiredAge(
+	lines: ReadonlyArray<AgeRestrictedLine>,
+	variantIds?: ReadonlyArray<string> | null,
+): number | null {
+	const only = variantIds && variantIds.length > 0 ? new Set(variantIds) : null;
+	let required: number | null = null;
+	for (const line of lines) {
+		if (only && !(line.variantId && only.has(line.variantId))) continue;
+		if (!hasAgeRestriction(line.minimumAge)) continue;
+		if (required === null || line.minimumAge > required) required = line.minimumAge;
+	}
+	return required;
+}
+
+export function isAgeRestrictionErrorCode(code: string | null | undefined): code is AgeErrorCode {
+	return code != null && (AGE_ERROR_CODES as readonly string[]).includes(code);
+}
+
+/**
+ * Map a core age error code to copy and CTA.
+ * - unknown age, no session: "Sign in"
+ * - unknown age, signed in (no birthday on file): "Add date of birth"
+ * - too young: message only
+ */
+export function getAgeFeedback(input: {
+	code: string | null | undefined;
+	isAuthenticated: boolean;
+	requiredAge?: number | null;
+}): AgeFeedback | null {
+	const { code } = input;
+	if (!isAgeRestrictionErrorCode(code)) return null;
+	const requiredAge = hasAgeRestriction(input.requiredAge) ? input.requiredAge : null;
+	if (code === "CUSTOMER_TOO_YOUNG") {
+		return { code, messageKey: "ageTooYoung", cta: null, ctaLabelKey: null, requiredAge };
+	}
+	if (!input.isAuthenticated) {
+		return { code, messageKey: "ageUnknownGuest", cta: "sign-in", ctaLabelKey: "signIn", requiredAge };
+	}
+	return {
+		code,
+		messageKey: "ageUnknownNoBirthday",
+		cta: "add-birthday",
+		ctaLabelKey: "addBirthday",
+		requiredAge,
+	};
+}
