@@ -0,0 +1,48 @@
+"use client";
+
+import { useTranslations } from "next-intl";
+import { LinkWithChannel } from "@/ui/atoms/link-with-channel";
+import { getAgeFeedback } from "@/lib/age-restriction";
+import type { AgeCartActionFailure } from "@/app/cart-action-result";
+import { accountRoutes } from "@/ui/components/account/routes";
+import { buttonClassName } from "@/ui/components/ui/button";
+
+const CTA_HREF = {
+	"sign-in": "/login",
+	"add-birthday": accountRoutes.settings,
+} as const;
+
+/** Age-restriction message plus its call to action (sign in / add date of birth). */
+export function AgeFeedbackNotice({
+	result,
+	onNavigate,
+	className,
+}: {
+	result: AgeCartActionFailure;
+	onNavigate?: () => void;
+	className?: string;
+}) {
+	const t = useTranslations("ageRestriction");
+	const feedback = getAgeFeedback({
+		code: result.code,
+		isAuthenticated: result.isAuthenticated,
+		requiredAge: result.requiredAge,
+	});
+
+	if (!feedback) return null;
+
+	return (
+		<div role="alert" className={className ?? "space-y-2 text-sm text-destructive"}>
+			<p>{t(feedback.messageKey, { age: feedback.requiredAge ?? "" })}</p>
+			{feedback.cta && feedback.ctaLabelKey ? (
+				<LinkWithChannel
+					href={CTA_HREF[feedback.cta]}
+					onClick={onNavigate}
+					className={buttonClassName({ asLink: true, variant: "outline-solid", size: "sm" })}
+				>
+					{t(feedback.ctaLabelKey)}
+				</LinkWithChannel>
+			) : null}
+		</div>
+	);
+}
