+import { describe, expect, it } from "vitest";
+import { hasAgeError, isAgeCartActionFailure, mapCartMutationErrors } from "./cart-action-result";
+
+const guest = { isAuthenticated: false };
+
+describe("mapCartMutationErrors", () => {
+	it("returns ok when there are no errors", () => {
+		expect(mapCartMutationErrors([], guest)).toEqual({ ok: true });
+		expect(mapCartMutationErrors(null, guest)).toEqual({ ok: true });
+	});
+
+	it("maps CUSTOMER_AGE_UNKNOWN with the required age from client lines", () => {
+		const result = mapCartMutationErrors([{ code: "CUSTOMER_AGE_UNKNOWN" }], {
+			...guest,
+			lines: [{ minimumAge: 18 }, { minimumAge: 21 }],
+		});
+		expect(result).toEqual({
+			ok: false,
+			code: "CUSTOMER_AGE_UNKNOWN",
+			requiredAge: 21,
+			isAuthenticated: false,
+		});
+		expect(isAgeCartActionFailure(result)).toBe(true);
+	});
+
+	it("narrows required age to the variants named by the error", () => {
+		const result = mapCartMutationErrors([{ code: "CUSTOMER_TOO_YOUNG", variants: ["v1"] }], {
+			isAuthenticated: true,
+			lines: [
+				{ variantId: "v1", minimumAge: 18 },
+				{ variantId: "v2", minimumAge: 21 },
+			],
+		});
+		expect(result).toEqual({ ok: false, code: "CUSTOMER_TOO_YOUNG", requiredAge: 18, isAuthenticated: true });
+	});
+
+	it("falls back to all lines when named variants are not in client data", () => {
+		const result = mapCartMutationErrors([{ code: "CUSTOMER_AGE_UNKNOWN", variants: ["zzz"] }], {
+			...guest,
+			lines: [{ variantId: "v1", minimumAge: 18 }],
+		});
+		expect(result).toMatchObject({ requiredAge: 18 });
+	});
+
+	it("has null requiredAge when client data has no restriction", () => {
+		expect(mapCartMutationErrors([{ code: "CUSTOMER_AGE_UNKNOWN" }], guest)).toMatchObject({
+			requiredAge: null,
+		});
+	});
+
+	it("prefers too young over unknown age", () => {
+		const result = mapCartMutationErrors(
+			[{ code: "CUSTOMER_AGE_UNKNOWN" }, { code: "CUSTOMER_TOO_YOUNG" }],
+			guest,
+		);
+		expect(result).toMatchObject({ code: "CUSTOMER_TOO_YOUNG" });
+	});
+
+	it("keeps non-age errors generic", () => {
+		const result = mapCartMutationErrors([{ code: "INSUFFICIENT_STOCK" }], guest);
+		expect(result).toEqual({ ok: false, code: "ERROR" });
+		expect(isAgeCartActionFailure(result)).toBe(false);
+	});
+});
+
+describe("hasAgeError", () => {
+	it("detects age codes only", () => {
+		expect(hasAgeError([{ code: "CUSTOMER_TOO_YOUNG" }])).toBe(true);
+		expect(hasAgeError([{ code: "INVALID" }])).toBe(false);
+		expect(hasAgeError(undefined)).toBe(false);
+	});
+});
