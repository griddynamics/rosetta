+import { getAgeIssueFromErrors } from "@/checkout/lib/age-restriction-gate";
+
+type CompleteFieldErrorLike = {
+	code?: string | null;
+	message?: string | null;
+	variants?: ReadonlyArray<string> | null;
+};
+
 /**
  * Maps Saleor checkoutComplete errors to shopper-friendly copy.
  *
  * Saleor completes checkout when authorizeStatus is FULL (authorized + charged
  * amounts cover the total). Capture at fulfillment is separate.
+ *
+ * Age-restriction codes (`CUSTOMER_AGE_UNKNOWN` / `CUSTOMER_TOO_YOUNG`) are matched by code from
+ * `fieldErrors`, so the core message is used even when another error is listed first. Without
+ * codes the string fallback below still applies.
  */
-export function formatCheckoutCompleteError(error: string): string {
+export function formatCheckoutCompleteError(
+	error: string,
+	fieldErrors?: ReadonlyArray<CompleteFieldErrorLike> | null,
+): string {
+	const ageIssue = getAgeIssueFromErrors(fieldErrors);
+	if (ageIssue) {
+		const ageError = fieldErrors?.find((item) => item.code === ageIssue.code);
+		return ageError?.message || error;
+	}
+
 	if (error.includes("CHECKOUT_NOT_FULLY_PAID")) {
 		return "Payment does not fully cover this order total yet. Refresh the page — if funds were authorized, use Complete order. Do not pay again until we confirm the status.";
 	}
