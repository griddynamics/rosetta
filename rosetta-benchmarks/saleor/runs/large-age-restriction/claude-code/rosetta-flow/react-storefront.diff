index 0000000..20bf72f
--- /dev/null
+++ b/src/ui/components/account/birthday-form-utils.ts
@@ -0,0 +1,74 @@
+/**
+ * Pure helpers for the account birthday form (`<input type="date">` <-> `accountUpdate.dateOfBirth`).
+ * The value is sensitive: never log it or put it in an error message. Core stays the authority.
+ */
+
+export const BIRTHDAY_FIELD = "dateOfBirth";
+
+/** Oldest accepted year; rejects obvious typos before a round trip. */
+const MIN_YEAR = 1900;
+/** UTC+14 is the furthest-ahead zone; a date later than "today" there is a future date everywhere. */
+const MAX_UTC_OFFSET_HOURS = 14;
+
+export type BirthdayParseResult = { ok: true; value: string | null } | { ok: false };
+
+export type BirthdayActionResult =
+	| { success: true }
+	| { success: false; invalid: true }
+	| { success: false; errorKey: "updateProfileFailed" }
+	| { success: false; error: string };
+
+const ISO_DATE = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+function toIsoDate(date: Date): string {
+	return date.toISOString().slice(0, 10);
+}
+
+/** Latest date any timezone can currently be on, as `YYYY-MM-DD`. */
+function latestAllowedDate(now: Date): string {
+	return toIsoDate(new Date(now.getTime() + MAX_UTC_OFFSET_HOURS * 60 * 60 * 1000));
+}
+
+/**
+ * Parse a form value. Empty/whitespace means "clear" (`value: null`).
+ * Otherwise it must be a real calendar date, not in the future and not before 1900.
+ */
+export function parseBirthday(raw: string | null | undefined, now: Date = new Date()): BirthdayParseResult {
+	const input = (raw ?? "").trim();
+	if (input === "") return { ok: true, value: null };
+
+	const match = ISO_DATE.exec(input);
+	if (!match) return { ok: false };
+
+	const year = Number(match[1]);
+	const month = Number(match[2]);
+	const day = Number(match[3]);
+	if (year < MIN_YEAR) return { ok: false };
+
+	const probe = new Date(Date.UTC(year, month - 1, day));
+	const isRealDate =
+		probe.getUTCFullYear() === year && probe.getUTCMonth() === month - 1 && probe.getUTCDate() === day;
+	if (!isRealDate) return { ok: false };
+
+	if (input > latestAllowedDate(now)) return { ok: false };
+
+	return { ok: true, value: input };
+}
+
+/** Value for `<input type="date" defaultValue>`; empty string when unset or malformed. */
+export function toBirthdayInputValue(dateOfBirth: string | null | undefined): string {
+	return dateOfBirth && ISO_DATE.test(dateOfBirth) ? dateOfBirth : "";
+}
+
+/** `accountUpdate` input carrying only `dateOfBirth`; `null` clears the stored value. */
+export function toBirthdayInput(value: string | null): { dateOfBirth: string | null } {
+	return { dateOfBirth: value };
+}
+
+/** Format a stored `YYYY-MM-DD` for display without timezone shifting. */
+export function formatBirthday(dateOfBirth: string, locale: string): string {
+	const match = ISO_DATE.exec(dateOfBirth);
+	if (!match) return "";
+	const date = new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])));
+	return date.toLocaleDateString(locale, { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
+}
