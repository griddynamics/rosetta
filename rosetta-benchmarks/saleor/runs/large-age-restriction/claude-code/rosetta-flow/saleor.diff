@@ -0,0 +1,213 @@
+import graphene
+import pytest
+
+from .....product.error_codes import ProductBulkCreateErrorCode, ProductErrorCode
+from .....product.models import Product
+from ....tests.utils import get_graphql_content
+
+PRODUCT_CREATE = """
+mutation ProductCreate($input: ProductCreateInput!) {
+  productCreate(input: $input) {
+    product { id minimumAge }
+    errors { field code }
+  }
+}
+"""
+
+PRODUCT_UPDATE = """
+mutation ProductUpdate($id: ID!, $input: ProductInput!) {
+  productUpdate(id: $id, input: $input) {
+    product { id minimumAge }
+    errors { field code }
+  }
+}
+"""
+
+PRODUCT_BULK_CREATE = """
+mutation ProductBulkCreate($products: [ProductBulkCreateInput!]!) {
+  productBulkCreate(products: $products, errorPolicy: REJECT_FAILED_ROWS) {
+    count
+    results {
+      errors { path code }
+      product { id minimumAge }
+    }
+  }
+}
+"""
+
+
+def _base_input(product_type, category, name="min age product"):
+    return {
+        "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+        "category": graphene.Node.to_global_id("Category", category.pk),
+        "name": name,
+    }
+
+
+@pytest.mark.parametrize(("value", "stored"), [(None, None), (1, 1), (120, 120)])
+def test_product_create_valid_minimum_age(
+    value,
+    stored,
+    staff_api_client,
+    product_type,
+    category,
+    permission_manage_products,
+):
+    # given
+    variables = {"input": {**_base_input(product_type, category), "minimumAge": value}}
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_CREATE, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["minimumAge"] == stored
+    assert Product.objects.get(name="min age product").minimum_age == stored
+
+
+@pytest.mark.parametrize("value", [0, 121, -1])
+def test_product_create_invalid_minimum_age(
+    value, staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    variables = {"input": {**_base_input(product_type, category), "minimumAge": value}}
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_CREATE, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert data["errors"] == [
+        {"field": "minimumAge", "code": ProductErrorCode.INVALID.name}
+    ]
+    assert not Product.objects.filter(name="min age product").exists()
+
+
+@pytest.mark.parametrize("value", [1, 120])
+def test_product_update_valid_minimum_age(
+    value, staff_api_client, product, permission_manage_products
+):
+    # given
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"minimumAge": value},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_UPDATE, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert not data["errors"]
+    product.refresh_from_db()
+    assert product.minimum_age == value
+
+
+def test_product_update_null_clears_minimum_age(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    product.minimum_age = 18
+    product.save(update_fields=["minimum_age"])
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"minimumAge": None},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_UPDATE, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert not data["errors"]
+    assert data["product"]["minimumAge"] is None
+    product.refresh_from_db()
+    assert product.minimum_age is None
+
+
+def test_product_update_without_key_keeps_minimum_age(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    product.minimum_age = 18
+    product.save(update_fields=["minimum_age"])
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"name": "renamed"},
+    }
+
+    # when
+    staff_api_client.post_graphql(
+        PRODUCT_UPDATE, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    product.refresh_from_db()
+    assert product.minimum_age == 18
+
+
+@pytest.mark.parametrize("value", [0, 121, -1])
+def test_product_update_invalid_minimum_age(
+    value, staff_api_client, product, permission_manage_products
+):
+    # given
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"minimumAge": value},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_UPDATE, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert data["errors"] == [
+        {"field": "minimumAge", "code": ProductErrorCode.INVALID.name}
+    ]
+    product.refresh_from_db()
+    assert product.minimum_age is None
+
+
+def test_product_bulk_create_minimum_age_per_row(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    products = [
+        {**_base_input(product_type, category, "ok null"), "minimumAge": None},
+        {**_base_input(product_type, category, "ok 1"), "minimumAge": 1},
+        {**_base_input(product_type, category, "ok 120"), "minimumAge": 120},
+        {**_base_input(product_type, category, "bad 0"), "minimumAge": 0},
+        {**_base_input(product_type, category, "bad 121"), "minimumAge": 121},
+        {**_base_input(product_type, category, "bad -1"), "minimumAge": -1},
+    ]
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_BULK_CREATE,
+        {"products": products},
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productBulkCreate"]
+    results = data["results"]
+    for row, expected in zip(results[:3], [None, 1, 120], strict=True):
+        assert not row["errors"]
+        assert row["product"]["minimumAge"] == expected
+    for row in results[3:]:
+        assert row["product"] is None
+        assert row["errors"] == [
+            {"path": "minimumAge", "code": ProductBulkCreateErrorCode.INVALID.name}
+        ]
+    assert data["count"] == 3
