+    variant_ids: Iterable[int | None], database_connection_name: str
+) -> dict[int, int]:
+    """Return `{variant_id: product.minimum_age}` for age-restricted variants."""
+    ids = {variant_id for variant_id in variant_ids if variant_id}
+    if not ids:
+        return {}
+    return dict(
+        ProductVariant.objects.using(database_connection_name)
+        .filter(id__in=ids, product__minimum_age__isnull=False)
+        .values_list("id", "product__minimum_age")
+    )
+
+
+def order_has_age_restricted_lines(
+    lines: Iterable["OrderLine"], database_connection_name: str
+) -> bool:
+    """Return True when any line's product has a minimum age set."""
+    return bool(
+        _get_restricted_variants(
+            (line.variant_id for line in lines), database_connection_name
+        )
+    )
+
+
+def link_customer_by_email(data: dict, variant_ids: Iterable[int | None]) -> None:
+    """Resolve `data["user"]` from `data["user_email"]` (draft create/update).
+
+    An active customer with that email is linked, unless some line is
+    age-restricted: only an explicit `user` input counts for the age check
+    (same rule as `draftOrderComplete`), so the email is just stored.
+    """
+    email = data.get("user_email")
+    if not email or _get_restricted_variants(
+        variant_ids, settings.DATABASE_CONNECTION_DEFAULT_NAME
+    ):
+        return
+    user = User.objects.filter(email=email, is_active=True).first()
+    data["user"] = graphene.Node.to_global_id("User", user.id) if user else None
+
+
+def _get_order_buyer(order: "Order", database_connection_name: str) -> Optional["User"]:
+    # The buyer is the FK customer only; never matched by email.
+    if order.user_id is None:
+        return None
+    return User.objects.using(database_connection_name).filter(pk=order.user_id).first()
+
+
+def _age_error(result: AgeCheckResult, required_age: int | None, restricted):
+    code, message = get_age_restriction_error(result, required_age, OrderErrorCode)
+    return ValidationError(
+        message,
+        code=code,
+        params={
+            "variants": [
+                graphene.Node.to_global_id("ProductVariant", pk)
+                for pk in sorted(restricted)
+            ]
+        },
+    )
+
+
+def validate_order_age_restriction(
+    order: "Order",
+    lines: Iterable["OrderLine"],
+    errors: T_ERRORS,
+    site_settings: "SiteSettings",
+    *,
+    database_connection_name: str,
+) -> None:
+    """Add an age error when the order's linked customer can't buy its lines.
+
+    Orders without a linked user (`order.user_id`) are not checked. Costs one query
+    for restricted variants, plus one for the customer only when some line is
+    restricted.
+    """
+    if not order.user_id:
+        return
+    restricted = _get_restricted_variants(
+        (line.variant_id for line in lines), database_connection_name
+    )
+    if not restricted:
+        return
+    required_age = get_required_age(restricted.values())
+    result = check_age(
+        required_age,
+        _get_order_buyer(order, database_connection_name),
+        shop_today(site_settings),
+    )
+    if result != AgeCheckResult.OK:
+        errors["lines"].append(_age_error(result, required_age, restricted))
+
+
+def validate_order_lines_age_restriction_on_edit(
+    variant_ids: Iterable[int | None],
+    user: Optional["User"],
+    site_settings: "SiteSettings",
+    *,
+    database_connection_name: str = settings.DATABASE_CONNECTION_DEFAULT_NAME,
+) -> None:
+    """Reject adding restricted variants for a customer known to be too young.
+
+    Unknown age (no birthday) is allowed here and blocked later at
+    `draftOrderComplete` / `orderConfirm`. No user means no check.
+    """
+    if user is None:
+        return
+    restricted = _get_restricted_variants(variant_ids, database_connection_name)
+    if not restricted:
+        return
+    required_age = get_required_age(restricted.values())
+    result = check_age(required_age, user, shop_today(site_settings))
+    if result == AgeCheckResult.TOO_YOUNG:
+        raise ValidationError({"lines": _age_error(result, required_age, restricted)})
+
+
