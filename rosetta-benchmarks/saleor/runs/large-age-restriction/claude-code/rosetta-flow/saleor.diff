+import datetime
+
+import graphene
+import pytest
+
+from .....core.postgres import FlatConcatSearchVector
+from .....product.models import Product
+from .....product.search import prepare_product_search_vector_value
+from ....tests.utils import get_graphql_content
+
+PRODUCT_QUERY = """
+query Product($id: ID!, $channel: String) {
+  product(id: $id, channel: $channel) {
+    id
+    minimumAge
+  }
+}
+"""
+
+PRODUCTS_QUERY = """
+query Products($channel: String, $search: String) {
+  products(first: 10, channel: $channel, search: $search) {
+    edges {
+      node {
+        id
+        name
+        minimumAge
+      }
+    }
+  }
+}
+"""
+
+
+@pytest.fixture
+def restricted_product(product):
+    product.minimum_age = 21
+    product.save(update_fields=["minimum_age"])
+    product.search_vector = FlatConcatSearchVector(
+        *prepare_product_search_vector_value(product)
+    )
+    Product.objects.filter(pk=product.pk).update(search_vector=product.search_vector)
+    return product
+
+
+@pytest.fixture
+def minor_api_client(user_api_client):
+    user = user_api_client.user
+    user.date_of_birth = datetime.date(2020, 1, 1)
+    user.save(update_fields=["date_of_birth"])
+    return user_api_client
+
+
+def test_product_minimum_age_readable_anonymously(
+    api_client, restricted_product, channel_USD
+):
+    # given
+    variables = {
+        "id": graphene.Node.to_global_id("Product", restricted_product.pk),
+        "channel": channel_USD.slug,
+    }
+
+    # when
+    content = get_graphql_content(api_client.post_graphql(PRODUCT_QUERY, variables))
+
+    # then
+    assert content["data"]["product"]["minimumAge"] == 21
+
+
+def test_product_minimum_age_null_when_unrestricted(api_client, product, channel_USD):
+    # given
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "channel": channel_USD.slug,
+    }
+
+    # when
+    content = get_graphql_content(api_client.post_graphql(PRODUCT_QUERY, variables))
+
+    # then
+    assert content["data"]["product"]["minimumAge"] is None
+
+
+@pytest.mark.parametrize("client_name", ["api_client", "minor_api_client"])
+def test_restricted_products_are_never_hidden(
+    client_name, request, restricted_product, channel_USD
+):
+    # given
+    client = request.getfixturevalue(client_name)
+    product_id = graphene.Node.to_global_id("Product", restricted_product.pk)
+
+    # when
+    single = get_graphql_content(
+        client.post_graphql(
+            PRODUCT_QUERY, {"id": product_id, "channel": channel_USD.slug}
+        )
+    )
+    listing = get_graphql_content(
+        client.post_graphql(PRODUCTS_QUERY, {"channel": channel_USD.slug})
+    )
+    searched = get_graphql_content(
+        client.post_graphql(
+            PRODUCTS_QUERY,
+            {"channel": channel_USD.slug, "search": restricted_product.name},
+        )
+    )
+
+    # then
+    assert single["data"]["product"]["id"] == product_id
+    for content in (listing, searched):
