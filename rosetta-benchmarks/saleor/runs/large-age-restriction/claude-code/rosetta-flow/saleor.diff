index 0000000..39b157d
--- /dev/null
+++ b/saleor/graphql/checkout/tests/mutations/test_checkout_complete_age_restriction.py
@@ -0,0 +1,422 @@
+import datetime
+from unittest.mock import patch
+
+import graphene
+import pytest
+from django.contrib.sites.models import Site
+from django.utils import timezone
+from freezegun import freeze_time
+
+from .....checkout import calculations
+from .....checkout.error_codes import CheckoutErrorCode
+from .....checkout.fetch import fetch_checkout_info, fetch_checkout_lines
+from .....checkout.models import Checkout
+from .....order.models import Order
+from .....payment import TransactionEventType
+from .....payment.transaction_item_calculations import recalculate_transaction_amounts
+from .....plugins.manager import get_plugins_manager
+from ....core.utils import to_global_id_or_none
+from ....tests.utils import get_graphql_content
+
+MUTATION_CHECKOUT_COMPLETE = """
+mutation checkoutComplete($id: ID) {
+  checkoutComplete(id: $id) {
+    order {
+      id
+    }
+    errors {
+      field
+      code
+      message
+      variants
+    }
+  }
+}
+"""
+
+
+FROZEN_NOW = "2026-03-01T12:00:00+00:00"
+FROZEN_TODAY = datetime.date(2026, 3, 1)
+
+
+@pytest.fixture
+def frozen_now():
+    return FROZEN_NOW
+
+
+@pytest.fixture(autouse=True)
+def _frozen_time(frozen_now):
+    with freeze_time(frozen_now):
+        yield
+
+
+def _years_ago(years):
+    """Calendar-exact: the date `years` before the frozen date (Mar 1)."""
+    return FROZEN_TODAY.replace(year=FROZEN_TODAY.year - years)
+
+
+ADULT_DOB = _years_ago(30)
+MINOR_DOB = _years_ago(10)
+
+
+def _set_dob(user, dob):
+    user.date_of_birth = dob
+    user.save(update_fields=["date_of_birth"])
+
+
+def _restrict(checkout, minimum_age=18):
+    product = checkout.lines.first().variant.product
+    product.minimum_age = minimum_age
+    product.save(update_fields=["minimum_age"])
+
+
+def _prepare_transactions_checkout(
+    checkout,
+    address,
+    checkout_delivery,
+    transaction_item_generator,
+    transaction_events_generator,
+    user=None,
+):
+    checkout.shipping_address = address
+    checkout.billing_address = address
+    checkout.assigned_delivery = checkout_delivery(checkout)
+    checkout.user = user
+    checkout.save()
+
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+    total = calculations.calculate_checkout_total_with_gift_cards(
+        manager, checkout_info, lines
+    )
+    transaction = transaction_item_generator(checkout_id=checkout.pk)
+    transaction_events_generator(
+        transaction=transaction,
+        psp_references=["1"],
+        types=[TransactionEventType.CHARGE_SUCCESS],
+        amounts=[total.gross.amount],
+    )
+    recalculate_transaction_amounts(transaction)
+    checkout.price_expiration = timezone.now()
+    checkout.save()
+    return checkout
+
+
+@pytest.fixture
+def transactions_checkout(
+    checkout_with_item,
+    address,
+    checkout_delivery,
+    transaction_item_generator,
+    transaction_events_generator,
+):
+    def _build(user=None, minimum_age=18):
+        _restrict(checkout_with_item, minimum_age)
+        return _prepare_transactions_checkout(
+            checkout_with_item,
+            address,
+            checkout_delivery,
+            transaction_item_generator,
+            transaction_events_generator,
+            user=user,
+        )
+
+    return _build
+
+
+def _complete(client, checkout):
+    response = client.post_graphql(
+        MUTATION_CHECKOUT_COMPLETE, {"id": to_global_id_or_none(checkout)}
+    )
+    return get_graphql_content(response)["data"]["checkoutComplete"]
+
+
+def _assert_blocked(data, checkout, code, orders_count=0):
+    assert data["order"] is None
+    error = data["errors"][0]
+    assert error["code"] == code.name
+    assert error["field"] == "lines"
+    line = checkout.lines.first()
+    assert error["variants"] == [
+        graphene.Node.to_global_id("ProductVariant", line.variant_id)
+    ]
+    assert Order.objects.count() == orders_count
+    assert Checkout.objects.filter(pk=checkout.pk).exists()
+
+
+def test_checkout_complete_transactions_guest_is_blocked(
+    api_client, transactions_checkout
+):
+    # given
+    checkout = transactions_checkout(user=None)
+
+    # when
+    data = _complete(api_client, checkout)
+
+    # then
+    _assert_blocked(data, checkout, CheckoutErrorCode.CUSTOMER_AGE_UNKNOWN)
+
+
+def test_checkout_complete_transactions_customer_without_dob_is_blocked(
+    user_api_client, customer_user, transactions_checkout
+):
+    # given
+    checkout = transactions_checkout(user=customer_user)
+
+    # when
+    data = _complete(user_api_client, checkout)
+
+    # then
+    _assert_blocked(data, checkout, CheckoutErrorCode.CUSTOMER_AGE_UNKNOWN)
+
+
+def test_checkout_complete_transactions_minor_attached_is_blocked(
+    user_api_client, customer_user, transactions_checkout
+):
+    # given
+    _set_dob(customer_user, MINOR_DOB)
+    checkout = transactions_checkout(user=customer_user)
+
+    # when
+    data = _complete(user_api_client, checkout)
+
+    # then
+    _assert_blocked(data, checkout, CheckoutErrorCode.CUSTOMER_TOO_YOUNG)
+    assert "18" in data["errors"][0]["message"]
+
+
+def test_checkout_complete_transactions_adult_succeeds(
+    user_api_client, customer_user, transactions_checkout
+):
+    # given
+    _set_dob(customer_user, ADULT_DOB)
+    checkout = transactions_checkout(user=customer_user)
+
+    # when
+    data = _complete(user_api_client, checkout)
+
+    # then
+    assert not data["errors"]
+    assert data["order"]["id"]
+    assert Order.objects.count() == 1
+
+
+def test_checkout_complete_transactions_customer_detached_after_lines_is_blocked(
+    api_client, customer_user, transactions_checkout
+):
+    # given
+    # the adult added the line, then the customer was detached
+    _set_dob(customer_user, ADULT_DOB)
+    checkout = transactions_checkout(user=None)
+
+    # when
+    data = _complete(api_client, checkout)
+
+    # then
+    _assert_blocked(data, checkout, CheckoutErrorCode.CUSTOMER_AGE_UNKNOWN)
+
+
+def test_checkout_complete_transactions_guest_with_adult_email_is_blocked(
+    api_client, customer_user, transactions_checkout
+):
+    # given
+    # the buyer is only the linked user; an email match never counts
+    _set_dob(customer_user, ADULT_DOB)
+    checkout = transactions_checkout(user=None)
+    checkout.email = customer_user.email
+    checkout.save(update_fields=["email"])
+
+    # when
+    data = _complete(api_client, checkout)
+
+    # then
+    _assert_blocked(data, checkout, CheckoutErrorCode.CUSTOMER_AGE_UNKNOWN)
+
+
+def test_checkout_complete_transactions_product_age_raised_after_line_add_is_blocked(
+    user_api_client, customer_user, transactions_checkout
+):
+    # given
+    _set_dob(customer_user, _years_ago(19))
+    checkout = transactions_checkout(user=customer_user, minimum_age=18)
+    product = checkout.lines.first().variant.product
+    product.minimum_age = 21
+    product.save(update_fields=["minimum_age"])
+
+    # when
+    data = _complete(user_api_client, checkout)
+
+    # then
+    _assert_blocked(data, checkout, CheckoutErrorCode.CUSTOMER_TOO_YOUNG)
+    assert "21" in data["errors"][0]["message"]
+
+
+def test_checkout_complete_transactions_unrestricted_guest_succeeds(
+    api_client, transactions_checkout, customer_user
+):
+    # given
+    checkout = transactions_checkout(user=None, minimum_age=None)
+
+    # when
+    data = _complete(api_client, checkout)
+
+    # then
+    assert not data["errors"]
+    assert Order.objects.count() == 1
+
+
+@pytest.fixture
+def payment_checkout(
+    checkout_with_item, address, checkout_delivery, payment_dummy, customer_user
+):
+    def _build(user=None):
+        _restrict(checkout_with_item)
+        checkout = checkout_with_item
+        checkout.shipping_address = address
+        checkout.billing_address = address
+        checkout.assigned_delivery = checkout_delivery(checkout)
+        checkout.user = user
+        checkout.save()
+
+        manager = get_plugins_manager(allow_replica=False)
+        lines, _ = fetch_checkout_lines(checkout)
+        checkout_info = fetch_checkout_info(checkout, lines, manager)
+        total = calculations.calculate_checkout_total_with_gift_cards(
+            manager, checkout_info, lines
+        )
+        payment = payment_dummy
+        payment.is_active = True
+        payment.order = None
+        payment.total = total.gross.amount
+        payment.currency = total.gross.currency
+        payment.checkout = checkout
+        payment.save()
+        return checkout
+
+    return _build
+
+
+@patch("saleor.payment.gateway.process_payment")
+@patch("saleor.payment.gateway.confirm")
+def test_checkout_complete_legacy_payment_blocked_before_gateway_processing(
+    mocked_confirm, mocked_process_payment, api_client, payment_checkout
+):
