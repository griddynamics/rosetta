+def validate_date_of_birth(date_of_birth, site_settings) -> None:
+    """Raise `ValidationError` when the date of birth is out of the allowed range.
+
+    The message must never contain the submitted value.
+    """
+    if date_of_birth is None:
+        return
+    if date_of_birth.year < MIN_DATE_OF_BIRTH_YEAR or date_of_birth > shop_today(
+        site_settings
+    ):
+        raise ValidationError(
+            {
+                "date_of_birth": ValidationError(
+                    "Date of birth is out of the allowed range.",
+                    code=AccountErrorCode.INVALID.value,
+                )
+            }
+        )
+
+
 def get_required_fields_camel_case(required_fields: set) -> set:
     """Return set of AddressValidationRules required fields in camel case."""
     return {validation_field_to_camel_case(field) for field in required_fields}
