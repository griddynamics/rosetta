+    *, customer: User, actor: User
+) -> CustomerEvent:
+    # Never store the date of birth value, only who changed it.
+    return CustomerEvent.objects.create(
+        user=customer,
+        app=None,
+        order=None,
+        type=CustomerEvents.DATE_OF_BIRTH_CHANGED,
+        parameters={"actor_user_id": actor.pk},
+    )
