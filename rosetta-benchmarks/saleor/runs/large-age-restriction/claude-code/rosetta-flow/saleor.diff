+
+TRANSACTION_INITIALIZE = """
+mutation TransactionInitialize(
+  $amount: PositiveDecimal,
+  $id: ID!,
+  $paymentGateway: PaymentGatewayToInitialize!
+) {
+  transactionInitialize(amount: $amount, id: $id, paymentGateway: $paymentGateway) {
+    transaction {
+      id
+    }
+    errors {
+      field
+      message
+      code
+    }
+  }
+}
+"""
+
+APP_IDENTIFIER = "webhook.app.identifier"
+
+
+FROZEN_NOW = "2026-03-01T12:00:00+00:00"
+FROZEN_TODAY = datetime.date(2026, 3, 1)
+
+
+@pytest.fixture(autouse=True)
+def _frozen_time():
+    with freeze_time(FROZEN_NOW):
+        yield
+
+
+def _years_ago(years):
+    """Calendar-exact: the date `years` before the frozen date (Mar 1)."""
+    return FROZEN_TODAY.replace(year=FROZEN_TODAY.year - years)
+
+
+def _restrict_checkout(checkout, minimum_age=18):
+    product = checkout.lines.first().variant.product
+    product.minimum_age = minimum_age
+    product.save(update_fields=["minimum_age"])
+
+
+@pytest.fixture
+def payment_app(webhook_app):
+    webhook_app.identifier = APP_IDENTIFIER
+    webhook_app.save()
+    return webhook_app
+
+
+def _variables(source):
+    return {
+        "amount": Decimal("10.00"),
+        "id": to_global_id_or_none(source),
+        "paymentGateway": {"id": APP_IDENTIFIER, "data": None},
+    }
+
+
+def _initialize(client, source):
+    response = client.post_graphql(TRANSACTION_INITIALIZE, _variables(source))
+    return get_graphql_content(response)["data"]["transactionInitialize"]
+
+
+@mock.patch("saleor.plugins.manager.PluginsManager.transaction_initialize_session")
+@pytest.mark.parametrize(
+    ("years", "code"),
+    [
+        (None, TransactionInitializeErrorCode.CUSTOMER_AGE_UNKNOWN),
+        (10, TransactionInitializeErrorCode.CUSTOMER_TOO_YOUNG),
+    ],
+)
+def test_transaction_initialize_restricted_checkout_is_rejected(
+    mocked_initialize,
+    years,
+    code,
+    user_api_client,
+    customer_user,
+    checkout_with_prices,
+    payment_app,
+):
+    # given
+    checkout = checkout_with_prices
+    _restrict_checkout(checkout)
+    if years is not None:
+        customer_user.date_of_birth = _years_ago(years)
+        customer_user.save(update_fields=["date_of_birth"])
+    checkout.user = customer_user
+    checkout.save(update_fields=["user"])
+    transactions_count = checkout.payment_transactions.count()
+
+    # when
+    data = _initialize(user_api_client, checkout)
+
+    # then
+    assert data["transaction"] is None
+    assert len(data["errors"]) == 1
+    error = data["errors"][0]
+    assert error["code"] == code.name
+    assert error["field"] == "id"
+    assert "18" in error["message"]
+    assert checkout.payment_transactions.count() == transactions_count
+    mocked_initialize.assert_not_called()
+
+
+@mock.patch("saleor.plugins.manager.PluginsManager.transaction_initialize_session")
+def test_transaction_initialize_guest_checkout_age_unknown_even_with_adult_email(
+    mocked_initialize,
+    api_client,
+    customer_user,
+    checkout_with_prices,
+    payment_app,
+):
+    # given
