+import json
+from datetime import date
+from unittest.mock import patch
+
+import graphene
+import pytest
+from django.contrib.sites.models import Site
+from freezegun import freeze_time
+
+from .....account.events import CustomerEvents
+from .....account.models import CustomerEvent, User
+from .....account.tests.fixtures.user import dangerously_create_test_user  # noqa: F401
+from ....query_cost_map import COST_MAP
+from ....tests.utils import get_graphql_content
+
+USER_QUERY = """
+    query User($id: ID!) {
+        user(id: $id) {
+            id
+            dateOfBirth
+            ageEligible
+            isSuperuser
+        }
+    }
+"""
+
+ALIASES_QUERY = """
+    query User($id: ID!) {
+        user(id: $id) {
+            id
+            dateOfBirth
+            again: dateOfBirth
+            ageEligible
+            eligible: ageEligible
+        }
+    }
+"""
+
+ME_QUERY = """
+    query {
+        me {
+            id
+            dateOfBirth
+            ageEligible
+            isSuperuser
+        }
+    }
+"""
+
+CUSTOMERS_QUERY = """
+    query {
+        customers(first: 100) {
+            edges {
+                node {
+                    id
+                    dateOfBirth
+                    ageEligible
+                }
+            }
+        }
+    }
+"""
+
+FROZEN_NOW = "2026-03-01T12:00:00+00:00"
+# 20 years old on the frozen date (and until 2027-01-01)
+ADULT_DOB = date(2006, 1, 1)
+
+
+@pytest.fixture(autouse=True)
+def _frozen_time():
+    with freeze_time(FROZEN_NOW):
+        yield
+
+
+@pytest.fixture
+def subject(customer_user):
+    customer_user.date_of_birth = ADULT_DOB
+    customer_user.save(update_fields=["date_of_birth"])
+    return customer_user
+
+
+def _global_id(user):
+    return graphene.Node.to_global_id("User", user.pk)
+
+
+def _viewed_events(user=None):
+    qs = CustomerEvent.objects.filter(type=CustomerEvents.DATE_OF_BIRTH_VIEWED)
+    return qs.filter(user=user) if user else qs
+
+
+def test_owner_reads_own_date_of_birth_and_eligibility(user_api_client, subject):
+    # when
+    response = user_api_client.post_graphql(ME_QUERY)
+
+    # then
+    data = get_graphql_content(response)["data"]["me"]
+    assert data["dateOfBirth"] == ADULT_DOB.isoformat()
+    assert data["ageEligible"] is True
+    assert data["isSuperuser"] is False
+    assert not _viewed_events().exists()
