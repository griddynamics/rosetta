+    assert len(data["errors"]) == 1
+    assert data["errors"][0]["code"] == OrderErrorCode.CUSTOMER_TOO_YOUNG.name
+    assert data["errors"][0]["field"] == "lines"
+    assert len(data["errors"][0]["variants"]) == 1
+    assert restricted_order.lines.count() == lines_count
+
+
+@pytest.mark.parametrize("status", EDITABLE_STATUSES)
