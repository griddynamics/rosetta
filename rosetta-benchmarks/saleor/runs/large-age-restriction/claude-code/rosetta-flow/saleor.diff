+
+CUSTOMER_BULK_UPDATE_DOB_MUTATION = """
+    mutation CustomerBulkUpdate(
+        $customers: [CustomerBulkUpdateInput!]!,
+        $errorPolicy: ErrorPolicyEnum
+    ){
+        customerBulkUpdate(customers: $customers, errorPolicy: $errorPolicy){
+            errors { code message }
+            results {
+                errors { path message code }
+                customer { id }
+            }
+            count
+        }
+    }
+"""
+
+DOB = date(1990, 5, 17)
+
+
+def _row(user, **input_data):
+    return {"id": graphene.Node.to_global_id("User", user.pk), "input": input_data}
+
+
+def _changed_events():
+    return CustomerEvent.objects.filter(type=CustomerEvents.DATE_OF_BIRTH_CHANGED)
