diff --git a/saleor/graphql/shop/tests/mutations/test_shop_settings_update_age.py b/saleor/graphql/shop/tests/mutations/test_shop_settings_update_age.py
new file mode 100644
index 0000000..2856fca
--- /dev/null
+++ b/saleor/graphql/shop/tests/mutations/test_shop_settings_update_age.py
@@ -0,0 +1,105 @@
+import pytest
+
+from .....core.error_codes import ShopErrorCode
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+MUTATION = """
+mutation ($input: ShopSettingsInput!) {
+  shopSettingsUpdate(input: $input) {
+    shop { timeZone minimumAge }
+    errors { field code }
+  }
+}
+"""
+
+
+@pytest.mark.parametrize("time_zone", ["Europe/Warsaw", "UTC", "Pacific/Auckland"])
+def test_shop_settings_update_valid_time_zone(
+    time_zone, staff_api_client, site_settings, permission_manage_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        MUTATION,
+        {"input": {"timeZone": time_zone}},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert not data["errors"]
+    assert data["shop"]["timeZone"] == time_zone
+    site_settings.refresh_from_db()
+    assert site_settings.time_zone == time_zone
+
+
+@pytest.mark.parametrize("time_zone", ["Not/AZone", "", "Mars/Olympus"])
+def test_shop_settings_update_invalid_time_zone(
+    time_zone, staff_api_client, site_settings, permission_manage_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        MUTATION,
+        {"input": {"timeZone": time_zone}},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert data["errors"] == [{"field": "timeZone", "code": ShopErrorCode.INVALID.name}]
+    site_settings.refresh_from_db()
+    assert site_settings.time_zone == "UTC"
+
+
+@pytest.mark.parametrize("minimum_age", [1, 21, 120])
+def test_shop_settings_update_valid_minimum_age(
+    minimum_age, staff_api_client, site_settings, permission_manage_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        MUTATION,
+        {"input": {"minimumAge": minimum_age}},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert not data["errors"]
+    assert data["shop"]["minimumAge"] == minimum_age
+    site_settings.refresh_from_db()
+    assert site_settings.minimum_age == minimum_age
+
+
+@pytest.mark.parametrize("minimum_age", [0, 121, -1, None])
+def test_shop_settings_update_invalid_minimum_age(
+    minimum_age, staff_api_client, site_settings, permission_manage_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        MUTATION,
+        {"input": {"minimumAge": minimum_age}},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert data["errors"] == [
+        {"field": "minimumAge", "code": ShopErrorCode.INVALID.name}
+    ]
+    site_settings.refresh_from_db()
+    assert site_settings.minimum_age == 18
+
+
+def test_shop_settings_update_age_requires_permission(
+    staff_api_client, site_settings, permission_manage_users
+):
+    # when
+    response = staff_api_client.post_graphql(
+        MUTATION,
+        {"input": {"timeZone": "Europe/Warsaw", "minimumAge": 21}},
+        permissions=[permission_manage_users],
+    )
+
+    # then
+    assert_no_permission(response)
+    site_settings.refresh_from_db()
+    assert (site_settings.time_zone, site_settings.minimum_age) == ("UTC", 18)
diff --git a/saleor/graphql/shop/tests/queries/test_shop_age_settings.py b/saleor/graphql/shop/tests/queries/test_shop_age_settings.py
new file mode 100644
index 0000000..d2cd3b9
--- /dev/null
+++ b/saleor/graphql/shop/tests/queries/test_shop_age_settings.py
@@ -0,0 +1,76 @@
+from ....tests.utils import (
+    assert_no_permission,
+    get_graphql_content,
+    get_graphql_content_from_response,
+)
+
+SHOP_AGE_QUERY = """
+query {
+  shop {
+    timeZone
+    minimumAge
+  }
+}
+"""
+
+
+def test_shop_age_settings_with_manage_settings(
+    staff_api_client, site_settings, permission_manage_settings
+):
+    # given
+    site_settings.time_zone = "Europe/Warsaw"
+    site_settings.minimum_age = 21
+    site_settings.save(update_fields=["time_zone", "minimum_age"])
+
+    # when
+    response = staff_api_client.post_graphql(
+        SHOP_AGE_QUERY, permissions=[permission_manage_settings]
+    )
+
+    # then
+    shop = get_graphql_content(response)["data"]["shop"]
+    assert shop == {"timeZone": "Europe/Warsaw", "minimumAge": 21}
+
+
+def test_shop_age_settings_defaults(
+    staff_api_client, site_settings, permission_manage_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        SHOP_AGE_QUERY, permissions=[permission_manage_settings]
+    )
+
+    # then
+    shop = get_graphql_content(response)["data"]["shop"]
+    assert shop == {"timeZone": "UTC", "minimumAge": 18}
+
+
+def test_shop_age_settings_denied_for_manage_users_only(
+    staff_api_client, permission_manage_users
+):
+    # when
+    response = staff_api_client.post_graphql(
+        SHOP_AGE_QUERY, permissions=[permission_manage_users]
+    )
+
+    # then
+    assert_no_permission(response)
+
+
+def test_shop_age_settings_denied_for_anonymous(api_client):
+    # when
+    response = api_client.post_graphql(SHOP_AGE_QUERY)
+
+    # then
+    content = get_graphql_content_from_response(response)
+    assert content["errors"][0]["extensions"]["exception"]["code"] == (
+        "PermissionDenied"
+    )
+
+
+def test_shop_age_settings_denied_for_customer(user_api_client):
+    # when
+    response = user_api_client.post_graphql(SHOP_AGE_QUERY)
+
+    # then
+    assert_no_permission(response)
