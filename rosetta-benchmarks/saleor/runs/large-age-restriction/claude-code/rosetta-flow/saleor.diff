@@ -0,0 +1,190 @@
+import datetime
+
+import graphene
+import pytest
+from freezegun import freeze_time
+
+from .....order.error_codes import OrderErrorCode
+from ....tests.utils import get_graphql_content
+
+ORDER_QUERY = """
+    query order($id: ID!) {
+        order(id: $id) {
+            canFinalize
+            errors {
+                field
+                code
+                variants
+            }
+        }
+    }
+"""
+
+
+FROZEN_NOW = "2026-03-01T12:00:00+00:00"
+FROZEN_TODAY = datetime.date(2026, 3, 1)
+
+
+@pytest.fixture(autouse=True)
+def _frozen_time():
+    with freeze_time(FROZEN_NOW):
+        yield
+
+
+def _years_ago(years):
+    """Calendar-exact: the date `years` before the frozen date (Mar 1)."""
+    return FROZEN_TODAY.replace(year=FROZEN_TODAY.year - years)
+
+
+ADULT_DOB = _years_ago(30)
+MINOR_DOB = _years_ago(17)  # 17: under 18
+
+
+@pytest.fixture
+def restricted_draft_order(draft_order):
+    for line in draft_order.lines.all():
+        product = line.variant.product
+        product.minimum_age = 18
+        product.save(update_fields=["minimum_age"])
+    return draft_order
+
+
+def _link_user(order, user, dob):
+    user.date_of_birth = dob
+    user.save(update_fields=["date_of_birth"])
+    order.user = user
+    order.save(update_fields=["user"])
+
+
+def _query(api_client, order):
+    variables = {"id": graphene.Node.to_global_id("Order", order.id)}
+    response = api_client.post_graphql(ORDER_QUERY, variables)
+    return get_graphql_content(response)["data"]["order"]
+
+
+def _age_errors(data):
+    return [
+        error
+        for error in data["errors"]
+        if error["code"]
+        in (
+            OrderErrorCode.CUSTOMER_AGE_UNKNOWN.name,
+            OrderErrorCode.CUSTOMER_TOO_YOUNG.name,
+        )
+    ]
+
+
+def test_order_errors_lists_age_unknown(
+    staff_api_client,
+    permission_group_manage_orders,
+    restricted_draft_order,
+    customer_user,
+):
+    # given
+    _link_user(restricted_draft_order, customer_user, None)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    # when
+    data = _query(staff_api_client, restricted_draft_order)
+
+    # then
+    errors = _age_errors(data)
+    assert [e["code"] for e in errors] == [OrderErrorCode.CUSTOMER_AGE_UNKNOWN.name]
+    assert errors[0]["field"] == "lines"
+    assert errors[0]["variants"]
+    assert data["canFinalize"] is False
+
+
+def test_order_errors_lists_too_young(
+    staff_api_client,
+    permission_group_manage_orders,
+    restricted_draft_order,
+    customer_user,
+):
+    # given
+    _link_user(restricted_draft_order, customer_user, MINOR_DOB)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    # when
+    data = _query(staff_api_client, restricted_draft_order)
+
+    # then
+    assert [e["code"] for e in _age_errors(data)] == [
+        OrderErrorCode.CUSTOMER_TOO_YOUNG.name
+    ]
+    assert data["canFinalize"] is False
+
+
+def test_order_errors_adult_has_no_age_error(
+    staff_api_client,
+    permission_group_manage_orders,
+    restricted_draft_order,
+    customer_user,
+):
+    # given
+    _link_user(restricted_draft_order, customer_user, ADULT_DOB)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    # when
+    data = _query(staff_api_client, restricted_draft_order)
+
+    # then
+    assert not _age_errors(data)
+    assert data["canFinalize"] is True
+
+
+def test_order_errors_no_linked_user_has_no_age_error(
+    staff_api_client, permission_group_manage_orders, restricted_draft_order
+):
+    # given
+    restricted_draft_order.user = None
+    restricted_draft_order.save(update_fields=["user"])
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    # when
+    data = _query(staff_api_client, restricted_draft_order)
+
+    # then
+    assert not _age_errors(data)
+    assert data["canFinalize"] is True
+
+
+def test_validate_order_age_restriction_query_budget(
+    django_assert_num_queries, restricted_draft_order, customer_user, site_settings
+):
+    # given: NFR-4, at most +2 SQL (restricted variants, then the buyer)
+    from collections import defaultdict
+
+    from ...utils import validate_order_age_restriction
+
+    order = restricted_draft_order
+    lines = list(order.lines.all())
+    db_name = "default"
+
+    # no linked user: no query at all
+    order.user = None
+    errors = defaultdict(list)
+    with django_assert_num_queries(0):
+        validate_order_age_restriction(
+            order, lines, errors, site_settings, database_connection_name=db_name
+        )
+    assert not errors
+
+    # linked user, restricted lines: variants + buyer
+    _link_user(order, customer_user, MINOR_DOB)
+    with django_assert_num_queries(2):
+        validate_order_age_restriction(
+            order, lines, errors, site_settings, database_connection_name=db_name
+        )
+    assert errors["lines"][0].code == OrderErrorCode.CUSTOMER_TOO_YOUNG.value
+
+    # linked user, nothing restricted: a single query
+    for line in lines:
+        line.variant.product.minimum_age = None
+        line.variant.product.save(update_fields=["minimum_age"])
+    errors = defaultdict(list)
+    with django_assert_num_queries(1):
+        validate_order_age_restriction(
+            order, lines, errors, site_settings, database_connection_name=db_name
+        )
+    assert not errors
