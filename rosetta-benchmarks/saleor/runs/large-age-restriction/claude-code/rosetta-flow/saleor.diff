+import datetime
+import logging
+
+import graphene
+import pytest
+from freezegun import freeze_time
+
+from .....order import OrderStatus
+from .....order.error_codes import OrderErrorCode
+from ....tests.utils import get_graphql_content
+
+ORDER_CONFIRM_MUTATION = """
+    mutation orderConfirm($id: ID!) {
+        orderConfirm(id: $id) {
+            errors {
+                field
+                code
+                message
+                variants
+            }
+            order {
+                status
+            }
+        }
+    }
+"""
+
+
+FROZEN_NOW = "2026-03-01T12:00:00+00:00"
+FROZEN_TODAY = datetime.date(2026, 3, 1)
+
+
+@pytest.fixture(autouse=True)
+def _frozen_time():
+    with freeze_time(FROZEN_NOW):
+        yield
+
+
+def _years_ago(years):
+    """Calendar-exact: the date `years` before the frozen date (Mar 1)."""
+    return FROZEN_TODAY.replace(year=FROZEN_TODAY.year - years)
+
+
+ADULT_DOB = _years_ago(30)
+MINOR_DOB = _years_ago(17)  # 17: under 18
+
+
+@pytest.fixture
+def restricted_unconfirmed_order(order_with_lines):
+    order_unconfirmed = order_with_lines
+    order_unconfirmed.status = OrderStatus.UNCONFIRMED
+    order_unconfirmed.save(update_fields=["status"])
+    for line in order_unconfirmed.lines.all():
+        product = line.variant.product
+        product.minimum_age = 18
+        product.save(update_fields=["minimum_age"])
+    return order_unconfirmed
+
+
+def _link_user(order, user, dob):
+    user.date_of_birth = dob
+    user.save(update_fields=["date_of_birth"])
+    order.user = user
+    order.save(update_fields=["user"])
+
+
+def _confirm(api_client, order):
+    variables = {"id": graphene.Node.to_global_id("Order", order.id)}
+    response = api_client.post_graphql(ORDER_CONFIRM_MUTATION, variables)
+    return get_graphql_content(response)["data"]["orderConfirm"]
+
+
+def test_order_confirm_linked_without_dob_is_rejected(
+    staff_api_client,
+    permission_group_manage_orders,
+    restricted_unconfirmed_order,
+    customer_user,
+):
+    # given
+    order = restricted_unconfirmed_order
+    _link_user(order, customer_user, None)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    # when
+    data = _confirm(staff_api_client, order)
+
+    # then
+    assert data["order"] is None
+    assert data["errors"][0]["code"] == OrderErrorCode.CUSTOMER_AGE_UNKNOWN.name
+    assert data["errors"][0]["field"] == "lines"
+    assert data["errors"][0]["variants"]
+    order.refresh_from_db()
+    assert order.status == OrderStatus.UNCONFIRMED
+
+
+def test_order_confirm_minor_is_rejected(
+    staff_api_client,
+    permission_group_manage_orders,
+    restricted_unconfirmed_order,
+    customer_user,
+):
+    # given
+    order = restricted_unconfirmed_order
+    _link_user(order, customer_user, MINOR_DOB)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    # when
+    data = _confirm(staff_api_client, order)
+
+    # then
+    assert data["errors"][0]["code"] == OrderErrorCode.CUSTOMER_TOO_YOUNG.name
+    order.refresh_from_db()
+    assert order.status == OrderStatus.UNCONFIRMED
+
+
+def test_order_confirm_adult_is_confirmed(
+    staff_api_client,
+    permission_group_manage_orders,
+    restricted_unconfirmed_order,
+    customer_user,
+):
+    # given
+    order = restricted_unconfirmed_order
+    _link_user(order, customer_user, ADULT_DOB)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    # when
+    data = _confirm(staff_api_client, order)
+
+    # then
+    assert not data["errors"]
+    assert data["order"]["status"] == OrderStatus.UNFULFILLED.upper()
+
+
+def test_order_confirm_no_linked_user_is_confirmed(
+    staff_api_client, permission_group_manage_orders, restricted_unconfirmed_order
+):
+    # given
+    order = restricted_unconfirmed_order
+    order.user = None
+    order.save(update_fields=["user"])
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    # when
+    data = _confirm(staff_api_client, order)
+
+    # then
+    assert not data["errors"]
+    assert data["order"]["status"] == OrderStatus.UNFULFILLED.upper()
+
+
+def test_order_confirm_unrestricted_for_linked_without_dob_is_confirmed(
+    staff_api_client, permission_group_manage_orders, order_with_lines, customer_user
+):
+    # given
+    order_with_lines.status = OrderStatus.UNCONFIRMED
+    order_with_lines.save(update_fields=["status"])
+    _link_user(order_with_lines, customer_user, None)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    # when
+    data = _confirm(staff_api_client, order_with_lines)
+
+    # then
+    assert not data["errors"]
+    assert data["order"]["status"] == OrderStatus.UNFULFILLED.upper()
+
+
+def test_order_confirm_superuser_is_not_exempt(
+    staff_api_client,
+    permission_group_manage_orders,
+    restricted_unconfirmed_order,
+    customer_user,
+):
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    staff_api_client.user.is_superuser = True
+    staff_api_client.user.save(update_fields=["is_superuser"])
+    order = restricted_unconfirmed_order
+    _link_user(order, customer_user, MINOR_DOB)
+
+    # when
+    data = _confirm(staff_api_client, order)
+
+    # then
+    assert data["errors"][0]["code"] == OrderErrorCode.CUSTOMER_TOO_YOUNG.name
+
+
+def test_order_confirm_app_is_not_exempt(
+    app_api_client,
+    permission_manage_orders,
+    restricted_unconfirmed_order,
+    customer_user,
+):
+    # given
+    order = restricted_unconfirmed_order
+    _link_user(order, customer_user, None)
+    app_api_client.app.permissions.add(permission_manage_orders)
+
+    # when
+    data = _confirm(app_api_client, order)
+
+    # then
+    assert data["errors"][0]["code"] == OrderErrorCode.CUSTOMER_AGE_UNKNOWN.name
+
+
+def test_order_confirm_age_rejection_does_not_log_date_of_birth(
+    staff_api_client,
+    permission_group_manage_orders,
+    restricted_unconfirmed_order,
+    customer_user,
+    caplog,
+):
+    # given
+    caplog.set_level(logging.DEBUG)
+    _link_user(restricted_unconfirmed_order, customer_user, MINOR_DOB)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    # when
+    data = _confirm(staff_api_client, restricted_unconfirmed_order)
+
+    # then
+    assert data["errors"]
+    for record in caplog.records:
+        assert MINOR_DOB.isoformat() not in record.getMessage()
+
+
+@pytest.mark.parametrize(
+    ("dob", "allowed"),
+    [
+        (datetime.date(2008, 3, 1), True),  # turns 18 today
+        (datetime.date(2008, 3, 2), False),  # turns 18 tomorrow
+    ],
+)
+def test_order_confirm_birthday_boundary(
+    dob,
+    allowed,
+    staff_api_client,
+    permission_group_manage_orders,
+    restricted_unconfirmed_order,
+    customer_user,
+):
+    # given
+    order = restricted_unconfirmed_order
+    _link_user(order, customer_user, dob)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+
+    # when
+    data = _confirm(staff_api_client, order)
+
+    # then
+    order.refresh_from_db()
+    if allowed:
+        assert not data["errors"]
+        assert order.status == OrderStatus.UNFULFILLED
+    else:
+        assert data["order"] is None
+        assert data["errors"][0]["code"] == OrderErrorCode.CUSTOMER_TOO_YOUNG.name
+        assert order.status == OrderStatus.UNCONFIRMED
