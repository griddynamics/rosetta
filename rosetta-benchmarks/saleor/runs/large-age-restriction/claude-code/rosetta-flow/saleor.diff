+    with_key, without_key = customer_users[:2]
+    variables = {
+        "customers": [
+            _row(with_key, dateOfBirth=DOB.isoformat(), firstName="A"),
+            _row(without_key, firstName="B"),
+        ],
+        "errorPolicy": ErrorPolicyEnum.REJECT_FAILED_ROWS.name,
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CUSTOMER_BULK_UPDATE_DOB_MUTATION, variables
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["customerBulkUpdate"]
+    assert data["count"] == 1
+    assert data["results"][0]["customer"] is None
+    assert [(e["path"], e["code"]) for e in data["results"][0]["errors"]] == [
+        (
+            "input.dateOfBirth",
+            CustomerBulkUpdateErrorCode.DATE_OF_BIRTH_EDIT_NOT_ALLOWED.name,
+        )
+    ]
+    assert data["results"][1]["customer"] is not None
+    with_key.refresh_from_db()
+    without_key.refresh_from_db()
+    assert with_key.date_of_birth is None
+    assert with_key.first_name != "A"
+    assert without_key.first_name == "B"
+    assert not _changed_events().exists()
