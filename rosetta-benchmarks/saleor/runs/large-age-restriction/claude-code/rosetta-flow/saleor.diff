+class DateOfBirthViewedEventLoader(DataLoader[int, bool]):
+    """Audit staff reads of customers' date of birth or eligibility.
+
+    The key is the ID of the subject customer. The loader runs once per request
+    and subject: it persists a single batch of `DATE_OF_BIRTH_VIEWED` events, with
+    the requestor as the actor. Values must be released by resolvers only after
+    the returned promise resolves, so a failed audit write fails the read.
+    """
+
+    context_key = "date_of_birth_viewed_events"
+
+    def batch_load(self, keys):
+        actor = getattr(self.context, "user", None)
+        if actor is None or not getattr(actor, "pk", None):
+            raise PermissionError("Audit actor is required.")
+        with allow_writer():
+            # The audit row is always written to the writer, also when the
+            # request is served from a replica.
+            events = bulk_customer_date_of_birth_viewed_events(
+                customer_ids=list(keys), actor=actor
+            )
+            if len(events) != len(keys):
+                raise RuntimeError("Audit events were not persisted.")
+        return [True for _ in keys]
+
