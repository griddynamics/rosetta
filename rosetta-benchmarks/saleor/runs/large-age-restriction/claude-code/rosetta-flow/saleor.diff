+import datetime
+
+import pytest
+from django.db import connection
+from django.test.utils import CaptureQueriesContext
+from freezegun import freeze_time
+
+from .....checkout import calculations
+from .....checkout.fetch import fetch_checkout_info, fetch_checkout_lines
+from .....payment.error_codes import PaymentErrorCode
+from .....payment.models import Payment
+from .....plugins.manager import get_plugins_manager
+from ....core.utils import to_global_id_or_none
+from ....tests.utils import get_graphql_content
+
+DUMMY_GATEWAY = "mirumee.payments.dummy"
+
+CREATE_PAYMENT_MUTATION = """
+    mutation CheckoutPaymentCreate($id: ID, $input: PaymentInput!) {
+        checkoutPaymentCreate(id: $id, input: $input) {
+            payment {
+                chargeStatus
+            }
+            errors {
+                code
+                field
+                message
+            }
+        }
+    }
+"""
+
+
+FROZEN_NOW = "2026-03-01T12:00:00+00:00"
+FROZEN_TODAY = datetime.date(2026, 3, 1)
+
+
+@pytest.fixture(autouse=True)
+def _frozen_time():
+    with freeze_time(FROZEN_NOW):
+        yield
+
+
+def _years_ago(years):
+    """Calendar-exact: the date `years` before the frozen date (Mar 1)."""
+    return FROZEN_TODAY.replace(year=FROZEN_TODAY.year - years)
+
+
+def _prepare(checkout, address, user=None, minimum_age=18):
+    checkout.billing_address = address
+    checkout.email = "buyer@example.com"
+    checkout.user = user
+    checkout.save(update_fields=["billing_address", "email", "user"])
+    if minimum_age is not None:
+        product = checkout.lines.first().variant.product
+        product.minimum_age = minimum_age
+        product.save(update_fields=["minimum_age"])
+
+
+def _create(client, checkout):
+    variables = {
+        "id": to_global_id_or_none(checkout),
+        "input": {
+            "gateway": DUMMY_GATEWAY,
+            "token": "sample-token",
+            "amount": checkout.total.gross.amount,
+        },
+    }
+    response = client.post_graphql(CREATE_PAYMENT_MUTATION, variables)
+    return get_graphql_content(response)["data"]["checkoutPaymentCreate"]
+
+
+def _set_total(checkout):
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    info = fetch_checkout_info(checkout, lines, manager)
+    checkout.total = calculations.calculate_checkout_total(
+        manager=manager, checkout_info=info, lines=lines
+    )
+
+
+@pytest.fixture
+def checkout_for_payment(checkout_without_shipping_required):
+    return checkout_without_shipping_required
+
+
+@pytest.mark.parametrize(
+    ("years", "code"),
+    [
+        (None, PaymentErrorCode.CUSTOMER_AGE_UNKNOWN),
+        (10, PaymentErrorCode.CUSTOMER_TOO_YOUNG),
+    ],
+)
+def test_checkout_payment_create_restricted_is_rejected(
+    years, code, user_api_client, customer_user, checkout_for_payment, address
+):
+    # given
+    checkout = checkout_for_payment
+    if years is not None:
+        customer_user.date_of_birth = _years_ago(years)
+        customer_user.save(update_fields=["date_of_birth"])
+    _prepare(checkout, address, user=customer_user)
+    _set_total(checkout)
+
+    # when
+    data = _create(user_api_client, checkout)
+
+    # then
+    assert data["payment"] is None
+    assert len(data["errors"]) == 1
+    error = data["errors"][0]
+    assert error["code"] == code.name
+    assert error["field"] == "id"
+    assert "18" in error["message"]
+    assert not Payment.objects.exists()
+
+
+def test_checkout_payment_create_guest_checkout_is_age_unknown(
+    api_client, customer_user, checkout_for_payment, address
+):
+    # given an adult customer exists with the same email, but is not linked
+    customer_user.date_of_birth = _years_ago(30)
+    customer_user.save(update_fields=["date_of_birth"])
+    checkout = checkout_for_payment
+    _prepare(checkout, address, user=None)
+    checkout.email = customer_user.email
+    checkout.save(update_fields=["email"])
+    _set_total(checkout)
+
+    # when
+    data = _create(api_client, checkout)
+
+    # then
+    assert data["errors"][0]["code"] == PaymentErrorCode.CUSTOMER_AGE_UNKNOWN.name
+    assert not Payment.objects.exists()
+
+
+def test_checkout_payment_create_restricted_adult_succeeds(
+    user_api_client, customer_user, checkout_for_payment, address
+):
+    # given
+    customer_user.date_of_birth = _years_ago(30)
+    customer_user.save(update_fields=["date_of_birth"])
+    checkout = checkout_for_payment
+    _prepare(checkout, address, user=customer_user)
+    _set_total(checkout)
+
+    # when
+    data = _create(user_api_client, checkout)
+
+    # then
+    assert not data["errors"]
+    assert Payment.objects.filter(checkout=checkout).count() == 1
+
+
+def test_checkout_payment_create_unrestricted_guest_succeeds(
+    api_client, checkout_for_payment, address
+):
+    # given
+    checkout = checkout_for_payment
+    _prepare(checkout, address, user=None, minimum_age=None)
+    _set_total(checkout)
+
+    # when
+    data = _create(api_client, checkout)
+
+    # then
+    assert not data["errors"]
+    assert Payment.objects.filter(checkout=checkout).count() == 1
+
+
+def test_checkout_payment_create_age_check_adds_one_query(
+    user_api_client,
+    customer_user,
+    checkout_for_payment,
+    address,
+):
+    # given a restricted checkout that is rejected: the check is a single lines query
+    checkout = checkout_for_payment
+    _prepare(checkout, address, user=customer_user)
+    _set_total(checkout)
+
+    # when / then: rejection happens early, before gateway/total calculation
+    with CaptureQueriesContext(connection) as ctx:
+        data = _create(user_api_client, checkout)
+    assert data["errors"][0]["code"] == PaymentErrorCode.CUSTOMER_AGE_UNKNOWN.name
+    age_queries = [
+        q
+        for q in ctx.captured_queries
+        if "checkout_checkoutline" in q["sql"]
+        and "minimum_age" in q["sql"]
+        and "site_sitesettings" not in q["sql"]
+    ]
+    assert len(age_queries) == 1
+
+
+@pytest.mark.parametrize(
+    ("dob", "allowed"),
+    [
+        (datetime.date(2008, 3, 1), True),  # turns 18 today
+        (datetime.date(2008, 3, 2), False),  # turns 18 tomorrow
+    ],
+)
+def test_checkout_payment_create_birthday_boundary(
+    dob, allowed, user_api_client, customer_user, checkout_for_payment, address
+):
+    # given
+    customer_user.date_of_birth = dob
+    customer_user.save(update_fields=["date_of_birth"])
+    checkout = checkout_for_payment
+    _prepare(checkout, address, user=customer_user)
+    _set_total(checkout)
+
+    # when
+    data = _create(user_api_client, checkout)
+
+    # then
+    if allowed:
+        assert not data["errors"]
+        assert Payment.objects.filter(checkout=checkout).count() == 1
+    else:
+        assert data["errors"][0]["code"] == PaymentErrorCode.CUSTOMER_TOO_YOUNG.name
+        assert not Payment.objects.exists()
