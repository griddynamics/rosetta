+def get_requestor_user(context) -> User | None:
+    """Return the authenticated user behind the request.
+
+    Returns None for apps (also when a user is present as well), anonymous requests
+    and contexts without a user, e.g. webhook subscription payloads. Apps never
+    pass date of birth read or write rules, whatever permissions they have.
+    """
+    if get_app_promise(context).get():
+        return None
+    user = getattr(context, "user", None)
+    if isinstance(user, User) and user.pk:
+        return user
+    return None
+
