+import json
+from datetime import date
+
+from ....account.events import CustomerEvents
+from ....account.models import CustomerEvent
+from ....webhook.event_types import WebhookEventAsyncType
+from ....webhook.payloads import generate_customer_payload
+from ...transport.asynchronous.transport import create_deliveries_for_subscriptions
+
+DOB = date(1990, 5, 17)
+
+CUSTOMER_UPDATED_WITH_DOB = """
+    subscription {
+      event {
+        ... on CustomerUpdated {
+          user {
+            id
+            email
+            dateOfBirth
+            ageEligible
+            isSuperuser
+          }
+        }
+      }
+    }
+"""
+
+
+def test_subscription_payload_resolves_date_of_birth_and_eligibility_as_null(
+    customer_user, subscription_webhook
+):
+    # given
+    customer_user.date_of_birth = DOB
+    customer_user.save(update_fields=["date_of_birth"])
+    webhook = subscription_webhook(
+        CUSTOMER_UPDATED_WITH_DOB, WebhookEventAsyncType.CUSTOMER_UPDATED
+    )
+
+    # when
+    deliveries = create_deliveries_for_subscriptions(
+        WebhookEventAsyncType.CUSTOMER_UPDATED, customer_user, [webhook]
+    )
+
+    # then
+    assert len(deliveries) == 1
+    raw_payload = deliveries[0].payload.get_payload()
+    payload = json.loads(raw_payload)
+    assert payload["user"]["email"] == customer_user.email
+    assert payload["user"]["dateOfBirth"] is None
+    assert payload["user"]["ageEligible"] is None
+    assert payload["user"]["isSuperuser"] is None
+    assert DOB.isoformat() not in raw_payload
+    assert not CustomerEvent.objects.filter(
+        type=CustomerEvents.DATE_OF_BIRTH_VIEWED
+    ).exists()
+
+
+def test_legacy_customer_payload_has_no_date_of_birth(customer_user):
+    # given
+    customer_user.date_of_birth = DOB
+    customer_user.save(update_fields=["date_of_birth"])
+
+    # when
+    payload = generate_customer_payload(customer_user)
+
+    # then
+    serialized = json.dumps(payload, default=str)
+    assert "date_of_birth" not in serialized
+    assert "dateOfBirth" not in serialized
+    assert DOB.isoformat() not in serialized
