+    order = order_with_lines
+    _restrict_and_link(order, customer_user, 30)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    variables = {"id": graphene.Node.to_global_id("Order", order.id)}
+
+    def confirm(patched_out):
+        order.status = OrderStatus.UNCONFIRMED
+        order.save(update_fields=["status"])
+        return _run_and_count(
+            staff_api_client,
+            ORDER_CONFIRM_MUTATION,
+            variables,
+            check_patched_out=(CONFIRM_VALIDATOR, patched_out),
+        )
+
+    confirm(True)  # warm up
+
+    # when
+    _, baseline = confirm(True)
+    data, with_check = confirm(False)
+
+    # then
+    assert data["orderConfirm"]["errors"] == []
+    assert data["orderConfirm"]["order"]["status"] == OrderStatus.UNFULFILLED.upper()
+    assert 1 <= with_check - baseline <= AGE_QUERY_BUDGET
