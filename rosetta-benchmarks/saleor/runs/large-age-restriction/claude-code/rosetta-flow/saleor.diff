+    assert not data["errors"]
+    assert data["user"]["dateOfBirth"] == DOB.isoformat()
+    customer_user.refresh_from_db()
+    assert customer_user.date_of_birth == DOB
+    event = _events(customer_user, CustomerEvents.DATE_OF_BIRTH_CHANGED).get()
+    assert event.user == customer_user
