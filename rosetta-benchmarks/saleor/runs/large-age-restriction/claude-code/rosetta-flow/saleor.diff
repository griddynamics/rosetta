+def bulk_customer_date_of_birth_changed_events(
+    *, customers: Iterable[User], actor: User
+) -> list[CustomerEvent]:
+    return CustomerEvent.objects.bulk_create(
+        [
+            CustomerEvent(
+                user=customer,
+                app=None,
+                order=None,
+                type=CustomerEvents.DATE_OF_BIRTH_CHANGED,
+                parameters={"actor_user_id": actor.pk},
+            )
+            for customer in customers
+        ]
+    )
+
+
+def bulk_customer_date_of_birth_viewed_events(
+    *, customer_ids: Iterable[int], actor: User
+) -> list[CustomerEvent]:
