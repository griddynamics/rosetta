+    variables = {
+        "customers": [_row(c, dateOfBirth=DOB.isoformat()) for c in customers],
+    }
+
+    # when
+    with capture_queries() as queries:
+        response = superuser_api_client.post_graphql(
+            CUSTOMER_BULK_UPDATE_DOB_MUTATION, variables
+        )
+
+    # then
+    assert get_graphql_content(response)["data"]["customerBulkUpdate"]["count"] == 3
+    event_inserts = [
+        q
+        for q in queries.captured_queries
+        if q["sql"].startswith('INSERT INTO "account_customerevent"')
+    ]
+    assert len(event_inserts) == 1
+    assert _changed_events().count() == 3
