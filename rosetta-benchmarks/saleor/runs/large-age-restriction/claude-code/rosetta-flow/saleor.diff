+    return checkout
+
+
+def _create(app_api_client, permission_handle_checkouts, checkout):
+    variables = {"id": graphene.Node.to_global_id("Checkout", checkout.pk)}
+    response = app_api_client.post_graphql(
+        MUTATION_ORDER_CREATE_FROM_CHECKOUT,
+        variables,
+        permissions=[permission_handle_checkouts],
+    )
+    return get_graphql_content(response)["data"]["orderCreateFromCheckout"]
+
+
+def test_order_create_from_checkout_guest_is_blocked(
+    app_api_client, permission_handle_checkouts, restricted_checkout
+):
+    # given
+    line = restricted_checkout.lines.first()
+
+    # when
+    data = _create(app_api_client, permission_handle_checkouts, restricted_checkout)
+
+    # then
+    assert data["order"] is None
+    error = data["errors"][0]
+    assert error["code"] == OrderCreateFromCheckoutErrorCode.CUSTOMER_AGE_UNKNOWN.name
+    assert error["field"] == "lines"
+    assert error["variants"] == [
+        graphene.Node.to_global_id("ProductVariant", line.variant_id)
+    ]
+    assert not Order.objects.exists()
+    assert Checkout.objects.filter(pk=restricted_checkout.pk).exists()
+
+
+def test_order_create_from_checkout_minor_is_blocked(
+    app_api_client, permission_handle_checkouts, restricted_checkout, customer_user
+):
+    # given
+    customer_user.date_of_birth = _years_ago(10)
+    customer_user.save(update_fields=["date_of_birth"])
+    restricted_checkout.user = customer_user
+    restricted_checkout.save(update_fields=["user"])
+
+    # when
+    data = _create(app_api_client, permission_handle_checkouts, restricted_checkout)
+
+    # then
+    assert data["order"] is None
+    error = data["errors"][0]
+    assert error["code"] == OrderCreateFromCheckoutErrorCode.CUSTOMER_TOO_YOUNG.name
+    assert "18" in error["message"]
+    assert not Order.objects.exists()
+
+
+def test_order_create_from_checkout_adult_succeeds(
+    app_api_client, permission_handle_checkouts, restricted_checkout, customer_user
+):
+    # given
+    customer_user.date_of_birth = _years_ago(30)
+    customer_user.save(update_fields=["date_of_birth"])
+    restricted_checkout.user = customer_user
+    restricted_checkout.save(update_fields=["user"])
+
+    # when
+    data = _create(app_api_client, permission_handle_checkouts, restricted_checkout)
+
+    # then
+    assert not data["errors"]
+    assert Order.objects.count() == 1
+
+
+@pytest.mark.parametrize(
+    ("dob", "allowed"),
+    [
+        (datetime.date(2008, 3, 1), True),  # turns 18 today
+        (datetime.date(2008, 3, 2), False),  # turns 18 tomorrow
+    ],
+)
+def test_order_create_from_checkout_birthday_boundary(
+    dob,
+    allowed,
+    app_api_client,
+    permission_handle_checkouts,
+    restricted_checkout,
+    customer_user,
+):
+    # given
+    customer_user.date_of_birth = dob
+    customer_user.save(update_fields=["date_of_birth"])
+    restricted_checkout.user = customer_user
+    restricted_checkout.save(update_fields=["user"])
+
+    # when
+    data = _create(app_api_client, permission_handle_checkouts, restricted_checkout)
+
+    # then
+    if allowed:
+        assert not data["errors"]
+        assert Order.objects.count() == 1
+    else:
+        assert data["order"] is None
+        error = data["errors"][0]
+        assert error["code"] == OrderCreateFromCheckoutErrorCode.CUSTOMER_TOO_YOUNG.name
+        assert not Order.objects.exists()
