+
+def test_customer_bulk_update_date_of_birth_by_superuser(
+    superuser_api_client, superuser, customer_users
+):
+    # given
+    customers = customer_users[:2]
+    variables = {
+        "customers": [_row(c, dateOfBirth=DOB.isoformat()) for c in customers],
+    }
+
+    # when
+    response = superuser_api_client.post_graphql(
+        CUSTOMER_BULK_UPDATE_DOB_MUTATION, variables
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["customerBulkUpdate"]
+    assert data["count"] == 2
+    for customer in customers:
+        customer.refresh_from_db()
+        assert customer.date_of_birth == DOB
+    events = list(_changed_events())
+    assert {e.user_id for e in events} == {c.pk for c in customers}
+    assert all(e.parameters == {"actor_user_id": superuser.pk} for e in events)
+
+
+def test_customer_bulk_update_date_of_birth_events_use_one_insert(
+    superuser_api_client, customer_users, capture_queries
