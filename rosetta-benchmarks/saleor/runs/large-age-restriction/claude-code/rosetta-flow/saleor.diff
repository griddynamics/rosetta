@@ -0,0 +1,227 @@
+import datetime
+import logging
+from types import SimpleNamespace
+
+import pytest
+from freezegun import freeze_time
+
+from ...account.models import User
+from ...site.models import SiteSettings
+from ..utils.age_restriction import (
+    AgeCheckResult,
+    calculate_age,
+    check_age,
+    get_required_age,
+    is_age_eligible,
+    shop_today,
+)
+
+TODAY = datetime.date(2026, 3, 1)
+
+
+def _buyer(dob):
+    return User(email="buyer@example.com", date_of_birth=dob)
+
+
+def test_turning_n_today_is_eligible():
+    # given
+    dob = datetime.date(2008, 3, 1)
+
+    # when
+    age = calculate_age(dob, TODAY)
+
+    # then
+    assert age == 18
+    assert check_age(18, _buyer(dob), TODAY) == AgeCheckResult.OK
+
+
+def test_day_before_birthday_is_too_young():
+    # given
+    dob = datetime.date(2008, 3, 2)
+
+    # when
+    age = calculate_age(dob, TODAY)
+
+    # then
+    assert age == 17
+    assert check_age(18, _buyer(dob), TODAY) == AgeCheckResult.TOO_YOUNG
+
+
+@pytest.mark.parametrize(
+    ("today", "expected"),
+    [
+        (datetime.date(2022, 2, 28), 17),
+        (datetime.date(2022, 3, 1), 18),
+        (datetime.date(2024, 2, 28), 19),  # leap year, Feb 29 not reached yet
+        (datetime.date(2024, 2, 29), 20),
+        (datetime.date(2024, 3, 1), 20),
+    ],
+)
+def test_calculate_age_feb_29_birthday(today, expected):
+    assert calculate_age(datetime.date(2004, 2, 29), today) == expected
+
+
+@pytest.mark.parametrize(
+    ("today", "expected", "result"),
+    [
+        (datetime.date(2022, 2, 28), 17, AgeCheckResult.TOO_YOUNG),
+        # Feb 29 birthdays are celebrated on Mar 1 in non-leap years
+        (datetime.date(2022, 3, 1), 18, AgeCheckResult.OK),
+    ],
+)
+def test_check_age_feb_29_birthday_in_non_leap_year(today, expected, result):
+    # given
+    buyer = _buyer(datetime.date(2004, 2, 29))
+
+    # then
+    assert calculate_age(buyer.date_of_birth, today) == expected
+    assert check_age(18, buyer, today) == result
+
+
+@pytest.mark.parametrize(
+    ("today", "expected"),
+    [
+        (datetime.date(2023, 2, 28), 17),
+        (datetime.date(2023, 3, 1), 18),
+        (datetime.date(2024, 2, 29), 18),  # leap day is still before Mar 1
+        (datetime.date(2024, 3, 1), 19),
+    ],
+)
+def test_calculate_age_mar_1_birthday_around_leap_day(today, expected):
+    assert calculate_age(datetime.date(2005, 3, 1), today) == expected
+
+
+@pytest.mark.parametrize(
+    ("frozen", "tz_name", "expected"),
+    [
+        ("2026-03-01T11:30:00+00:00", "Pacific/Auckland", datetime.date(2026, 3, 2)),
+        ("2026-03-01T11:30:00+00:00", "UTC", datetime.date(2026, 3, 1)),
+        (
+            "2026-03-02T05:00:00+00:00",
+            "America/Los_Angeles",
+            datetime.date(2026, 3, 1),
+        ),
+        ("2026-03-02T05:00:00+00:00", "UTC", datetime.date(2026, 3, 2)),
+        # the extreme offsets: +14 is ahead of the UTC date, -12 is behind it
+        ("2026-03-01T10:30:00+00:00", "Pacific/Kiritimati", datetime.date(2026, 3, 2)),
+        ("2026-03-01T11:30:00+00:00", "Etc/GMT+12", datetime.date(2026, 2, 28)),
+    ],
+)
+def test_shop_today_uses_shop_time_zone(frozen, tz_name, expected):
+    # given
+    settings = SiteSettings(time_zone=tz_name)
+
+    # when
+    with freeze_time(frozen):
+        result = shop_today(settings)
+
+    # then
+    assert result == expected
+
+
+@pytest.mark.parametrize("tz_name", ["Mars/Olympus", ""])
+def test_shop_today_invalid_time_zone_falls_back_to_utc(tz_name, caplog):
+    # given
+    settings = SiteSettings(time_zone=tz_name)
+
+    # when
+    with caplog.at_level(logging.WARNING):
+        with freeze_time("2026-03-01T23:30:00+00:00"):
+            result = shop_today(settings)
+
+    # then
+    assert result == datetime.date(2026, 3, 1)
+    records = [r for r in caplog.records if r.name.endswith("age_restriction")]
+    assert len(records) == 1
+    assert records[0].levelno == logging.WARNING
+    assert repr(tz_name) in records[0].getMessage()
+
+
+def test_get_required_age_takes_max_of_non_null():
+    assert get_required_age([None, 18, 21, None]) == 21
+
+
+@pytest.mark.parametrize("ages", [[], [None], [None, None]])
+def test_get_required_age_none_when_no_restriction(ages):
+    # when
+    required = get_required_age(ages)
+
+    # then
+    assert required is None
+    assert check_age(required, None, TODAY) == AgeCheckResult.OK
+
+
+def test_check_age_no_buyer_is_unknown():
+    assert check_age(18, None, TODAY) == AgeCheckResult.AGE_UNKNOWN
+
+
+def test_check_age_buyer_without_dob_is_unknown():
+    assert check_age(18, _buyer(None), TODAY) == AgeCheckResult.AGE_UNKNOWN
+
+
+def test_check_age_uses_highest_required_age():
+    # given
+    buyer = _buyer(datetime.date(2006, 1, 1))  # 20
+    required = get_required_age([18, 21])
+
+    # then
+    assert check_age(required, buyer, TODAY) == AgeCheckResult.TOO_YOUNG
+
+
+@freeze_time("2026-03-01T12:00:00+00:00")
+def test_is_age_eligible():
+    # given
+    settings = SiteSettings(time_zone="UTC", minimum_age=18)
+
+    # then
+    assert is_age_eligible(datetime.date(2008, 3, 1), settings) is True
+    assert is_age_eligible(datetime.date(2008, 3, 2), settings) is False
+    assert is_age_eligible(None, settings) is False
+
+
+@freeze_time("2026-03-01T12:00:00+00:00")
+def test_is_age_eligible_follows_shop_minimum_age():
+    # given
+    settings = SimpleNamespace(time_zone="UTC", minimum_age=21)
+
+    # then
+    assert is_age_eligible(datetime.date(2008, 3, 1), settings) is False
+
+
+# The spec stores `Product.minimum_age` as null (unrestricted) or 1..120 and the
+# API rejects 0, so a stored 0 is unspecified. These tests pin the CURRENT
+# behavior of the helper: 0 is a restriction (not "unrestricted"), so an unknown
+# buyer is blocked while any buyer with a birthday passes.
+def test_stored_zero_minimum_age_is_treated_as_a_restriction_for_unknown_buyers():
+    # given
+    required = get_required_age([0])
+
+    # then
+    assert required == 0
+    assert check_age(required, None, TODAY) == AgeCheckResult.AGE_UNKNOWN
+    assert check_age(required, _buyer(None), TODAY) == AgeCheckResult.AGE_UNKNOWN
+
+
+def test_stored_zero_minimum_age_passes_for_any_buyer_with_a_birthday():
+    # given
+    newborn = _buyer(TODAY)
+
+    # then
+    assert check_age(0, newborn, TODAY) == AgeCheckResult.OK
+
+
+def test_get_required_age_zero_does_not_hide_other_restrictions():
+    assert get_required_age([0, None, 18]) == 18
+    assert get_required_age([0, None]) == 0
+
+
+@freeze_time("2026-03-01T12:00:00+00:00")
+def test_shop_minimum_age_zero_makes_every_birthday_eligible():
+    # `SiteSettings.minimum_age` is non-null and validated to 1..120; 0 can only
+    # come from a bypassed validator and then means "no minimum".
+    # given
+    settings = SiteSettings(time_zone="UTC", minimum_age=0)
+
+    # then
+    assert is_age_eligible(TODAY, settings) is True
+    assert is_age_eligible(None, settings) is False
