diff --git a/saleor/account/tests/test_date_of_birth_events.py b/saleor/account/tests/test_date_of_birth_events.py
new file mode 100644
index 0000000..4cdcdca
--- /dev/null
+++ b/saleor/account/tests/test_date_of_birth_events.py
@@ -0,0 +1,76 @@
+import datetime
+
+from .. import CustomerEvents
+from ..events import (
+    bulk_customer_date_of_birth_changed_events,
+    bulk_customer_date_of_birth_viewed_events,
+    customer_date_of_birth_changed_event,
+)
+from ..models import CustomerEvent
+
+
+def test_changed_event_has_actor_and_no_value(customer_user, staff_user):
+    # given
+    customer_user.date_of_birth = datetime.date(1990, 5, 17)
+
+    # when
+    event = customer_date_of_birth_changed_event(
+        customer=customer_user, actor=staff_user
+    )
+
+    # then
+    event.refresh_from_db()
+    assert event.type == CustomerEvents.DATE_OF_BIRTH_CHANGED
+    assert event.user_id == customer_user.pk
+    assert event.app is None
+    assert event.order is None
+    assert event.parameters == {"actor_user_id": staff_user.pk}
+    assert "1990" not in str(event.parameters)
+
+
+def test_bulk_changed_events(customer_user, staff_user, admin_user):
+    # when
+    events = bulk_customer_date_of_birth_changed_events(
+        customers=[customer_user, staff_user], actor=admin_user
+    )
+
+    # then
+    assert len(events) == 2
+    stored = CustomerEvent.objects.filter(
+        type=CustomerEvents.DATE_OF_BIRTH_CHANGED
+    ).order_by("pk")
+    assert {e.user_id for e in stored} == {customer_user.pk, staff_user.pk}
+    assert all(e.parameters == {"actor_user_id": admin_user.pk} for e in stored)
+
+
+def test_bulk_viewed_events_single_insert(
+    customer_user, staff_user, admin_user, django_assert_num_queries
+):
+    # when
+    with django_assert_num_queries(1):
+        events = bulk_customer_date_of_birth_viewed_events(
+            customer_ids=[customer_user.pk, staff_user.pk], actor=admin_user
+        )
+
+    # then
+    assert len(events) == 2
+    stored = CustomerEvent.objects.filter(type=CustomerEvents.DATE_OF_BIRTH_VIEWED)
+    assert {e.user_id for e in stored} == {customer_user.pk, staff_user.pk}
+    assert all(e.parameters == {"actor_user_id": admin_user.pk} for e in stored)
+
+
+def test_bulk_events_empty_input(admin_user):
+    assert (
+        bulk_customer_date_of_birth_viewed_events(customer_ids=[], actor=admin_user)
+        == []
+    )
+    assert (
+        bulk_customer_date_of_birth_changed_events(customers=[], actor=admin_user) == []
+    )
+
+
+def test_digital_link_downloaded_choice_kept():
+    values = [value for value, _ in CustomerEvents.CHOICES]
+    assert CustomerEvents.DIGITAL_LINK_DOWNLOADED in values
+    assert CustomerEvents.DATE_OF_BIRTH_CHANGED in values
+    assert CustomerEvents.DATE_OF_BIRTH_VIEWED in values
