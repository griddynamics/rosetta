diff --git a/saleor/checkout/tests/test_checkout_complete_age_restriction.py b/saleor/checkout/tests/test_checkout_complete_age_restriction.py
new file mode 100644
index 0000000..5cdba9b
--- /dev/null
+++ b/saleor/checkout/tests/test_checkout_complete_age_restriction.py
@@ -0,0 +1,175 @@
+import datetime
+import logging
+from unittest import mock
+
+import graphene
+import pytest
+from django.core.exceptions import ValidationError
+from freezegun import freeze_time
+
+from ...order.models import Order
+from ...plugins.manager import get_plugins_manager
+from ...site.models import SiteSettings
+from ..checkout_cleaner import clean_checkout_age_restriction
+from ..complete_checkout import complete_checkout
+from ..error_codes import CheckoutErrorCode, OrderCreateFromCheckoutErrorCode
+from ..fetch import fetch_checkout_info, fetch_checkout_lines
+from ..models import Checkout
+from ..tasks import automatic_checkout_completion_task, task_logger
+
+FROZEN_NOW = "2026-03-01T12:00:00+00:00"
+FROZEN_TODAY = datetime.date(2026, 3, 1)
+
+
+@pytest.fixture(autouse=True)
+def _frozen_time():
+    with freeze_time(FROZEN_NOW):
+        yield
+
+
+def _years_ago(years):
+    """Calendar-exact: the date `years` before the frozen date (Mar 1)."""
+    return FROZEN_TODAY.replace(year=FROZEN_TODAY.year - years)
+
+
+def _restrict(checkout, minimum_age=18):
+    product = checkout.lines.first().variant.product
+    product.minimum_age = minimum_age
+    product.save(update_fields=["minimum_age"])
+
+
+def _fetch(checkout):
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    return fetch_checkout_info(checkout, lines, manager), lines
+
+
+def test_clean_checkout_age_restriction_runs_no_queries(
+    checkout_with_item, customer_user, site_settings, django_assert_num_queries
+):
+    # given
+    _restrict(checkout_with_item)
+    customer_user.date_of_birth = _years_ago(10)
+    customer_user.save(update_fields=["date_of_birth"])
+    checkout_with_item.user = customer_user
+    checkout_with_item.save(update_fields=["user"])
+    checkout_info, lines = _fetch(checkout_with_item)
+
+    # when
+    with django_assert_num_queries(0):
+        with pytest.raises(ValidationError) as error:
+            clean_checkout_age_restriction(
+                checkout_info, lines, CheckoutErrorCode, site_settings
+            )
+
+    # then
+    assert error.value.error_dict["lines"][0].code == (
+        CheckoutErrorCode.CUSTOMER_TOO_YOUNG.value
+    )
+
+
+def test_clean_checkout_age_restriction_unrestricted_lines_pass(
+    checkout_with_item, site_settings
+):
+    # given
+    checkout_info, lines = _fetch(checkout_with_item)
+
+    # when / then
+    clean_checkout_age_restriction(
+        checkout_info, lines, CheckoutErrorCode, site_settings
+    )
+
+
+def test_clean_checkout_age_restriction_ignores_email_match(
+    checkout_with_item, customer_user, site_settings
+):
+    # given
+    _restrict(checkout_with_item)
+    customer_user.date_of_birth = _years_ago(30)
+    customer_user.save(update_fields=["date_of_birth"])
+    checkout_with_item.user = None
+    checkout_with_item.email = customer_user.email
+    checkout_with_item.save(update_fields=["user", "email"])
+    checkout_info, lines = _fetch(checkout_with_item)
+    # the user fetched from the email must not be used as the buyer
+    checkout_info.user = customer_user
+
+    # when
+    with pytest.raises(ValidationError) as error:
+        clean_checkout_age_restriction(
+            checkout_info, lines, OrderCreateFromCheckoutErrorCode, site_settings
+        )
+
+    # then
+    error_item = error.value.error_dict["lines"][0]
+    assert (
+        error_item.code == OrderCreateFromCheckoutErrorCode.CUSTOMER_AGE_UNKNOWN.value
+    )
+    assert error_item.params["variants"] == {
+        graphene.Node.to_global_id("ProductVariant", lines[0].variant.pk)
+    }
+
+
+def test_automatic_checkout_completion_skips_age_failing_checkout(
+    checkout_with_prices,
+    transaction_item_generator,
+    app,
+    caplog,
+    django_capture_on_commit_callbacks,
+    warehouse_for_cc,
+):
+    # given
+    checkout = checkout_with_prices
+    checkout_pk = checkout.pk
+    _restrict(checkout)
+    transaction_item_generator(
+        checkout_id=checkout.pk, charged_value=checkout.total.gross.amount
+    )
+    parent_logger = task_logger.parent
+    parent_logger.propagate = True
+
+    # when
+    with django_capture_on_commit_callbacks(execute=True):
+        automatic_checkout_completion_task(checkout.pk)
+
+    # then
+    assert Checkout.objects.filter(pk=checkout_pk).exists()
+    assert not Order.objects.filter(checkout_token=checkout_pk).exists()
+    failed = [r for r in caplog.records if "completion failed" in r.getMessage()]
+    assert len(failed) == 1
+    assert failed[0].levelno == logging.WARNING
+
+
+def test_automatic_checkout_completion_passes_site_settings_once(
+    checkout_with_prices,
+    transaction_item_generator,
+    app,
+    django_capture_on_commit_callbacks,
+    warehouse_for_cc,
+    customer_user,
+):
+    # given
+    checkout = checkout_with_prices
+    _restrict(checkout)
+    customer_user.date_of_birth = _years_ago(30)
+    customer_user.save(update_fields=["date_of_birth"])
+    checkout.user = customer_user
+    checkout.save(update_fields=["user"])
+    transaction_item_generator(
+        checkout_id=checkout.pk, charged_value=checkout.total.gross.amount
+    )
+
+    # when
+    with (
+        mock.patch(
+            "saleor.checkout.tasks.complete_checkout",
+            wraps=complete_checkout,
+        ) as mocked_complete,
+        django_capture_on_commit_callbacks(execute=True),
+    ):
+        automatic_checkout_completion_task(checkout.pk)
+
+    # then
+    mocked_complete.assert_called_once()
+    assert isinstance(mocked_complete.call_args.kwargs["site_settings"], SiteSettings)
+    assert Order.objects.filter(checkout_token=checkout.pk).exists()
