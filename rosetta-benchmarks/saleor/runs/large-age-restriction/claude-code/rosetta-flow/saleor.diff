+import datetime
+from decimal import Decimal
+from unittest import mock
+
+import graphene
+import pytest
+from freezegun import freeze_time
+
+from .....payment import TransactionEventType
+from .....payment.error_codes import TransactionProcessErrorCode
+from .....payment.interface import TransactionSessionResult
+from .....payment.models import TransactionEvent
+from ....tests.utils import get_graphql_content
+
+TRANSACTION_PROCESS = """
+mutation TransactionProcess($id: ID) {
+  transactionProcess(id: $id) {
+    transaction {
+      id
+    }
+    errors {
+      field
+      message
+      code
+    }
+  }
+}
+"""
+
+
+FROZEN_NOW = "2026-03-01T12:00:00+00:00"
+FROZEN_TODAY = datetime.date(2026, 3, 1)
+
+
+@pytest.fixture(autouse=True)
+def _frozen_time():
+    with freeze_time(FROZEN_NOW):
+        yield
+
+
+def _years_ago(years):
+    """Calendar-exact: the date `years` before the frozen date (Mar 1)."""
+    return FROZEN_TODAY.replace(year=FROZEN_TODAY.year - years)
+
+
+@pytest.fixture
+def pending_transaction(checkout_with_prices, webhook_app, transaction_item_generator):
+    """Create a pending charge request transaction on a restricted checkout."""
+    webhook_app.identifier = "webhook.app.identifier"
+    webhook_app.save()
+    product = checkout_with_prices.lines.first().variant.product
+    product.minimum_age = 18
+    product.save(update_fields=["minimum_age"])
+    transaction_item = transaction_item_generator(
+        checkout_id=checkout_with_prices.pk, app=webhook_app
+    )
+    TransactionEvent.objects.create(
+        transaction=transaction_item,
+        amount_value=Decimal("10.00"),
+        currency=transaction_item.currency,
+        type=TransactionEventType.CHARGE_REQUEST,
+    )
+    return transaction_item
+
+
+def _process(client, transaction_item):
+    variables = {
+        "id": graphene.Node.to_global_id("TransactionItem", transaction_item.token)
+    }
+    response = client.post_graphql(TRANSACTION_PROCESS, variables)
+    return get_graphql_content(response)["data"]["transactionProcess"]
+
+
+@mock.patch("saleor.plugins.manager.PluginsManager.transaction_process_session")
+@pytest.mark.parametrize(
+    ("years", "code"),
+    [
+        (None, TransactionProcessErrorCode.CUSTOMER_AGE_UNKNOWN),
+        (10, TransactionProcessErrorCode.CUSTOMER_TOO_YOUNG),
+    ],
+)
+def test_transaction_process_restricted_checkout_is_rejected(
+    mocked_process,
+    years,
+    code,
+    user_api_client,
+    customer_user,
+    checkout_with_prices,
+    pending_transaction,
+):
+    # given
+    if years is not None:
+        customer_user.date_of_birth = _years_ago(years)
+        customer_user.save(update_fields=["date_of_birth"])
+    checkout_with_prices.user = customer_user
+    checkout_with_prices.save(update_fields=["user"])
+    events_count = pending_transaction.events.count()
+
+    # when
+    data = _process(user_api_client, pending_transaction)
+
+    # then
+    assert data["transaction"] is None
+    error = data["errors"][0]
+    assert error["code"] == code.name
+    assert error["field"] == "id"
+    assert "18" in error["message"]
+    assert pending_transaction.events.count() == events_count
+    mocked_process.assert_not_called()
+
+
+@mock.patch("saleor.plugins.manager.PluginsManager.transaction_process_session")
+def test_transaction_process_guest_checkout_is_rejected(
+    mocked_process, api_client, checkout_with_prices, pending_transaction
+):
+    # given
+    checkout_with_prices.user = None
+    checkout_with_prices.save(update_fields=["user"])
+
+    # when
+    data = _process(api_client, pending_transaction)
+
+    # then
+    assert (
+        data["errors"][0]["code"]
+        == TransactionProcessErrorCode.CUSTOMER_AGE_UNKNOWN.name
+    )
+    mocked_process.assert_not_called()
+
+
+@mock.patch("saleor.plugins.manager.PluginsManager.transaction_process_session")
+def test_transaction_process_restricted_checkout_adult_reaches_gateway(
+    mocked_process,
+    user_api_client,
+    customer_user,
+    checkout_with_prices,
+    pending_transaction,
+    transaction_session_response,
+):
+    # given
+    customer_user.date_of_birth = _years_ago(30)
+    customer_user.save(update_fields=["date_of_birth"])
+    checkout_with_prices.user = customer_user
+    checkout_with_prices.save(update_fields=["user"])
+    response = transaction_session_response.copy()
+    response["amount"] = Decimal("10.00")
+    response["result"] = TransactionEventType.CHARGE_SUCCESS.upper()
+    mocked_process.return_value = TransactionSessionResult(
+        app_identifier="webhook.app.identifier", response=response
+    )
+
+    # when
+    data = _process(user_api_client, pending_transaction)
+
+    # then
+    assert not data["errors"]
+    mocked_process.assert_called_once()
