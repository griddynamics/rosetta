+import graphene
+import pytest
+
+from .....account.events import (
+    CustomerEvents,
+    customer_account_created_event,
+    customer_date_of_birth_changed_event,
+)
+from .....account.models import CustomerEvent
+from ....tests.utils import get_graphql_content
+
+USER_EVENTS_QUERY = """
+    query User($id: ID!) {
+        user(id: $id) {
+            events {
+                type
+                message
+                user {
+                    id
+                    email
+                }
+            }
+        }
+    }
+"""
+
+DOB_TYPES = {"DATE_OF_BIRTH_CHANGED", "DATE_OF_BIRTH_VIEWED"}
+
+
+@pytest.fixture
+def subject_with_events(customer_user, staff_user):
+    customer_account_created_event(user=customer_user)
+    customer_date_of_birth_changed_event(customer=customer_user, actor=staff_user)
+    CustomerEvent.objects.create(
+        user=customer_user,
+        type=CustomerEvents.DATE_OF_BIRTH_VIEWED,
+        parameters={"actor_user_id": staff_user.pk},
+    )
+    return customer_user
+
+
+def _query(client, subject):
+    response = client.post_graphql(
+        USER_EVENTS_QUERY, {"id": graphene.Node.to_global_id("User", subject.pk)}
+    )
+    return get_graphql_content(response)["data"]["user"]["events"]
+
+
+def test_superuser_sees_date_of_birth_events_with_actor(
+    superuser_api_client, subject_with_events, staff_user
+):
+    # when
+    events = _query(superuser_api_client, subject_with_events)
+
+    # then
+    by_type = {event["type"]: event for event in events}
+    assert DOB_TYPES <= set(by_type)
+    for event_type in DOB_TYPES:
+        assert by_type[event_type]["user"]["email"] == staff_user.email
+        assert by_type[event_type]["message"] is None
+
+
+def test_staff_with_manage_users_does_not_see_date_of_birth_events(
+    staff_api_client, staff_user, permission_manage_users, subject_with_events
+):
+    # given
+    staff_user.user_permissions.add(permission_manage_users)
+
+    # when
+    events = _query(staff_api_client, subject_with_events)
+
+    # then
+    types = {event["type"] for event in events}
+    assert "ACCOUNT_CREATED" in types
+    assert not (types & DOB_TYPES)
+
+
+def test_app_with_manage_users_does_not_see_date_of_birth_events(
+    app_api_client, app, permission_manage_users, subject_with_events
+):
+    # given
+    app.permissions.add(permission_manage_users)
+    query = "query($id: ID!){ user(id: $id){ events { type } } }"
+    response = app_api_client.post_graphql(
+        query, {"id": graphene.Node.to_global_id("User", subject_with_events.pk)}
+    )
+
+    # then
+    events = get_graphql_content(response)["data"]["user"]["events"]
+    types = {event["type"] for event in events}
+    assert not (types & DOB_TYPES)
+
+
+def test_date_of_birth_events_store_only_actor_id(subject_with_events, staff_user):
+    # then
+    events = CustomerEvent.objects.filter(type__in=[t.lower() for t in DOB_TYPES])
+    assert events.count() == 2
+    for event in events:
+        assert event.parameters == {"actor_user_id": staff_user.pk}
+        assert event.app is None
+        assert event.order is None
+
+
+def test_deleted_actor_resolves_to_null_user(
+    superuser_api_client, subject_with_events, staff_user
+):
+    # given
+    staff_user.delete()
+
+    # when
+    events = _query(superuser_api_client, subject_with_events)
+
+    # then
+    dob_events = [event for event in events if event["type"] in DOB_TYPES]
+    assert len(dob_events) == 2
+    assert all(event["user"] is None for event in dob_events)
