+def validate_variants_age_restriction(
+    variants_ids: set[int],
+    checkout: models.Checkout,
+    requestor_user: "User | None",
+    site_settings: "SiteSettings",
+    error_code: type[CheckoutErrorCode] = CheckoutErrorCode,
+) -> None:
+    """Reject adding age-restricted variants when the buyer is not old enough.
+
+    The buyer is `checkout.user` when set, otherwise the requesting user (never an
+    app). Costs a single query; `checkout.user` is already loaded by the callers.
+    """
+    if not variants_ids:
+        return
+    restricted = dict(
+        ProductVariant.objects.filter(
+            id__in=variants_ids, product__minimum_age__isnull=False
+        ).values_list("id", "product__minimum_age")
+    )
+    if not restricted:
+        return
+    required_age = get_required_age(restricted.values())
+    buyer = checkout.user if checkout.user_id else requestor_user
+    result = check_age(required_age, buyer, shop_today(site_settings))
+    if result == AgeCheckResult.OK:
+        return
+    code, message = get_age_restriction_error(result, required_age, error_code)
+    raise ValidationError(
+        {
+            "lines": ValidationError(
+                message,
+                code=code,
+                params={
+                    "variants": {
+                        graphene.Node.to_global_id("ProductVariant", pk)
+                        for pk in restricted
+                    }
+                },
+            )
+        }
+    )
+
