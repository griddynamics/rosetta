+    # then
+    assert not get_graphql_content(response)["data"]["customerUpdate"]["errors"]
+    customer_user.refresh_from_db()
+    assert customer_user.date_of_birth is None
+    assert _changed_events(customer_user).count() == 1
+
+
+def test_customer_update_unchanged_date_of_birth_no_event(
+    superuser_api_client, customer_user
+):
+    # given
