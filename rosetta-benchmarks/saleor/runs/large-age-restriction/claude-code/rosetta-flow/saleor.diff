+"""Query-budget and replica-path coverage for the order age restriction (AC-36/41).
+
+NFR-4: `Order.errors` / `canFinalize` and `orderConfirm` add at most 2 SQL queries
+on top of what they cost without the age check.
+"""
+
+import datetime
+from contextlib import contextmanager
+from unittest import mock
+
+import graphene
+import pytest
+from django.conf import settings
+from django.db import connections
+from freezegun import freeze_time
+
+from .....order import OrderStatus
+from .....order.error_codes import OrderErrorCode
+from ....tests.utils import get_graphql_content
+
+ORDER_QUERY = """
+    query order($id: ID!) {
+        order(id: $id) {
+            canFinalize
+            errors {
+                field
+                code
+                variants
+            }
+        }
+    }
+"""
+
+ORDER_CONFIRM_MUTATION = """
+    mutation orderConfirm($id: ID!) {
+        orderConfirm(id: $id) {
+            errors {
+                field
+                code
+            }
+            order {
+                status
+            }
+        }
+    }
+"""
+
+QUERY_VALIDATOR = "saleor.graphql.order.utils.validate_order_age_restriction"
+CONFIRM_VALIDATOR = (
+    "saleor.graphql.order.mutations.order_confirm.validate_order_age_restriction"
+)
+AGE_QUERY_BUDGET = 2  # NFR-4: restricted variants + the buyer
+
+
+FROZEN_NOW = "2026-03-01T12:00:00+00:00"
+FROZEN_TODAY = datetime.date(2026, 3, 1)
+
+
+@pytest.fixture(autouse=True)
+def _frozen_time():
+    with freeze_time(FROZEN_NOW):
+        yield
+
+
+def _years_ago(years):
+    """Calendar-exact: the date `years` before the frozen date (Mar 1)."""
+    return FROZEN_TODAY.replace(year=FROZEN_TODAY.year - years)
+
+
+def _restrict_and_link(order, user, years_old):
+    for line in order.lines.all():
+        product = line.variant.product
+        product.minimum_age = 18
+        product.save(update_fields=["minimum_age"])
+    user.date_of_birth = _years_ago(years_old)
