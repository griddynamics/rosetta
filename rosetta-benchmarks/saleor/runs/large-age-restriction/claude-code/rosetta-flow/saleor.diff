+
+    # then
+    assert not data["errors"]
+
+
+def test_order_lines_create_superuser_is_not_exempt(
+    staff_api_client, permission_group_manage_orders, restricted_order, customer_user
+):
+    # given
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    staff_api_client.user.is_superuser = True
+    staff_api_client.user.save(update_fields=["is_superuser"])
