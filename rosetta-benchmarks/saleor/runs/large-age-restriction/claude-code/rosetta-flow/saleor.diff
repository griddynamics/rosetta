+ORDER_LINE_UPDATE_MUTATION = """
+    mutation OrderLineUpdate($lineId: ID!, $quantity: Int!) {
+        orderLineUpdate(id: $lineId, input: {quantity: $quantity}) {
+            errors {
+                field
+                code
+                variants
+            }
+            orderLine {
+                quantity
+            }
+        }
+    }
+"""
+
+DRAFT_ORDER_CREATE_MUTATION = """
+    mutation draftCreate($input: DraftOrderCreateInput!) {
+        draftOrderCreate(input: $input) {
+            errors {
+                field
+                code
+                variants
+            }
+            order {
+                id
+            }
+        }
+    }
+"""
+
+
+FROZEN_NOW = "2026-03-01T12:00:00+00:00"
+FROZEN_TODAY = datetime.date(2026, 3, 1)
+
+
+@pytest.fixture(autouse=True)
+def _frozen_time():
+    with freeze_time(FROZEN_NOW):
+        yield
+
+
+def _years_ago(years):
+    """Calendar-exact: the date `years` before the frozen date (Mar 1)."""
+    return FROZEN_TODAY.replace(year=FROZEN_TODAY.year - years)
+
+
+ADULT_DOB = _years_ago(30)
+MINOR_DOB = _years_ago(17)  # 17: under 18
+
+EDITABLE_STATUSES = [OrderStatus.DRAFT, OrderStatus.UNCONFIRMED]
+
+
+@pytest.fixture
+def restricted_order(order_with_lines):
+    """Order whose existing lines are all 18+."""
+    for line in order_with_lines.lines.all():
+        product = line.variant.product
+        product.minimum_age = 18
+        product.save(update_fields=["minimum_age"])
+    Stock.objects.update(quantity=100)
+    return order_with_lines
+
+
+def _set_status_and_user(order, status, user, dob):
+    if user is not None:
+        user.date_of_birth = dob
+        user.save(update_fields=["date_of_birth"])
+    order.status = status
+    order.user = user
+    order.save(update_fields=["status", "user"])
+
+
+def _create_variables(order, line=None):
+    line = line or order.lines.first()
+    return {
+        "orderId": graphene.Node.to_global_id("Order", order.id),
+        "variantId": graphene.Node.to_global_id("ProductVariant", line.variant_id),
+        "quantity": 1,
+    }
+
+
+def _post(api_client, query, variables, field):
+    response = api_client.post_graphql(query, variables)
+    return get_graphql_content(response)["data"][field]
+
+
+# --- orderLinesCreate ---
+
+
+@pytest.mark.parametrize("status", EDITABLE_STATUSES)
+def test_order_lines_create_minor_is_rejected(
