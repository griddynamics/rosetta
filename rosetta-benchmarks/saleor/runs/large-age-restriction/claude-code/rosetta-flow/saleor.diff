+def get_age_restriction_error(
+    result: AgeCheckResult,
+    required_age: int | None,
+    error_code: Any,
+) -> tuple[str, str]:
+    """Return the error code and message for a failed age check.
+
+    Messages contain the required age only, never the date of birth or the
+    customer's age.
+    """
+    if result == AgeCheckResult.AGE_UNKNOWN:
+        return (
+            error_code.CUSTOMER_AGE_UNKNOWN.value,
+            "Customer's date of birth is required to buy products with a "
+            f"minimum age of {required_age}.",
+        )
+    return (
+        error_code.CUSTOMER_TOO_YOUNG.value,
+        f"Customer must be at least {required_age} years old to buy some "
+        "of the products.",
+    )
+
+
+def clean_checkout_age_restriction(
+    checkout_info: "CheckoutInfo",
+    lines: list["CheckoutLineInfo"],
+    error_code: type[CheckoutErrorCode] | type[OrderCreateFromCheckoutErrorCode],
+    site_settings: "SiteSettings",
+):
+    """Block completion when the buyer is not old enough for restricted lines.
+
+    The buyer is the checkout's linked user only (never matched by email). The
+    check uses `CheckoutLineInfo.product`, so it does not run any extra query.
+    """
+    restricted_lines = [
+        line_info for line_info in lines if line_info.product.minimum_age is not None
+    ]
+    if not restricted_lines:
+        return
+    required_age = get_required_age(
+        line_info.product.minimum_age for line_info in restricted_lines
+    )
+    result = check_age(
+        required_age,
+        checkout_info.checkout.user,
+        shop_today(site_settings),
+    )
+    if result == AgeCheckResult.OK:
+        return
+    code, message = get_age_restriction_error(result, required_age, error_code)
+    variant_ids = {
+        graphene.Node.to_global_id("ProductVariant", line_info.variant.pk)
+        for line_info in restricted_lines
+    }
+    raise ValidationError(
+        {
+            "lines": ValidationError(
+                message,
+                code=code,
+                params={"variants": variant_ids},
+            )
+        }
+    )
+
+
+def clean_checkout_payment_age_restriction(
+    checkout: Checkout,
+    site_settings: "SiteSettings",
+    error_code: type,
+):
+    """Block payment initialization/processing for a checkout the buyer can't buy.
+
+    Runs a single query for the restricted lines. The buyer is `checkout.user` only.
+    """
+    minimum_ages = list(
+        checkout.lines.filter(variant__product__minimum_age__isnull=False).values_list(
+            "variant__product__minimum_age", flat=True
+        )
+    )
+    if not minimum_ages:
+        return
+    required_age = get_required_age(minimum_ages)
+    result = check_age(required_age, checkout.user, shop_today(site_settings))
+    if result == AgeCheckResult.OK:
+        return
+    code, message = get_age_restriction_error(result, required_age, error_code)
+    raise ValidationError({"id": ValidationError(message, code=code)})
+
+
