+        ("dateOfBirth", AccountErrorCode.DATE_OF_BIRTH_EDIT_NOT_ALLOWED.name)
+    ]
+    customer_user.refresh_from_db()
+    assert customer_user.date_of_birth is None
+    assert not _changed_events(customer_user).exists()
+
+
+def test_customer_update_does_not_log_date_of_birth(
+    superuser_api_client, staff_api_client, customer_user, caplog
+):
+    # given
+    caplog.set_level(logging.DEBUG)
+    value = "1987-03-21"
+
+    # when
+    superuser_api_client.post_graphql(
+        CUSTOMER_UPDATE_DOB_MUTATION, _variables(customer_user, dateOfBirth=value)
+    )
+    staff_api_client.post_graphql(
+        CUSTOMER_UPDATE_DOB_MUTATION, _variables(customer_user, dateOfBirth=value)
+    )
+
+    # then
+    for record in caplog.records:
+        assert value not in record.getMessage()
+
+
+def _set_shop_time_zone(time_zone):
+    settings = Site.objects.get_current().settings
+    settings.time_zone = time_zone
+    settings.save(update_fields=["time_zone"])
+
+
+# 11:30 UTC on 2026-03-01 is 2026-03-02 00:30 in Auckland (+13, summer time)
+# and 2026-02-28 23:30 in Etc/GMT+12 (-12).
+@pytest.mark.parametrize(
+    ("time_zone", "value", "is_valid"),
+    [
+        ("Pacific/Auckland", "2026-03-02", True),  # shop today, UTC tomorrow
+        ("Pacific/Auckland", "2026-03-03", False),  # shop tomorrow
+        ("UTC", "2026-03-02", False),  # same value, rejected without the shop tz
+        ("Etc/GMT+12", "2026-02-28", True),  # shop today, UTC yesterday
+        ("Etc/GMT+12", "2026-03-01", False),  # UTC today, shop tomorrow
+    ],
+)
+def test_customer_update_date_of_birth_uses_shop_time_zone(
+    time_zone, value, is_valid, superuser_api_client, customer_user
+):
+    # given
+    _set_shop_time_zone(time_zone)
+
+    # when
+    with freeze_time("2026-03-01T11:30:00+00:00"):
+        response = superuser_api_client.post_graphql(
+            CUSTOMER_UPDATE_DOB_MUTATION, _variables(customer_user, dateOfBirth=value)
+        )
+
+    # then
+    errors = get_graphql_content(response)["data"]["customerUpdate"]["errors"]
+    customer_user.refresh_from_db()
+    if is_valid:
+        assert not errors
+        assert customer_user.date_of_birth == date.fromisoformat(value)
+    else:
+        assert [(e["field"], e["code"]) for e in errors] == [
+            ("dateOfBirth", AccountErrorCode.INVALID.name)
+        ]
+        assert customer_user.date_of_birth is None
+
+
+@patch(
+    "saleor.account.events.customer_date_of_birth_changed_event",
+    side_effect=RuntimeError("event store down"),
+)
+def test_customer_update_fails_closed_when_changed_event_cannot_be_written(
+    mocked_event, superuser_api_client, customer_user
+):
+    # given
+    customer_user.date_of_birth = DOB
+    customer_user.save(update_fields=["date_of_birth"])
+    new_value = date(1985, 1, 2)
+
+    # when
+    response = superuser_api_client.post_graphql(
+        CUSTOMER_UPDATE_DOB_MUTATION,
+        _variables(customer_user, dateOfBirth=new_value.isoformat(), firstName="New"),
+    )
+
+    # then
+    content = json.loads(response.content)
+    assert content["errors"]
+    mocked_event.assert_called_once()
+    old_first_name = customer_user.first_name
+    customer_user.refresh_from_db()
+    assert customer_user.date_of_birth == DOB
+    assert customer_user.first_name == old_first_name
+    assert not _changed_events(customer_user).exists()
