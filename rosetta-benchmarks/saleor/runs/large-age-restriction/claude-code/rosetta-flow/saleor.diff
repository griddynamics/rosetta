+class _QueryLog:
+    """SQL statements seen by an execute wrapper, tagged with connection alias.
+
+    In tests the replica is a fake wrapper around the writer connection, so Django's
+    `CaptureQueriesContext` would count every statement twice. A single execute
+    wrapper sees each statement once, with the alias of the connection that issued
+    it (`default` or `replica`), exactly like `restrict_writer_middleware` does.
+    """
+
+    def __init__(self):
+        self.records: list[tuple[str, str]] = []
+
+    def __call__(self, execute, sql, params, many, context):
+        self.records.append((context["connection"].alias, sql))
+        return execute(sql, params, many, context)
+
+    def __len__(self):
+        return len(self.records)
+
+    def sql_on(self, alias):
+        return [sql for conn_alias, sql in self.records if conn_alias == alias]
+
+
+@contextmanager
+def _capture():
+    log = _QueryLog()
+    with connections[settings.DATABASE_CONNECTION_DEFAULT_NAME].execute_wrapper(log):
+        yield log
+
+
+def _run_and_count(api_client, query, variables, *, check_patched_out):
+    validator, noop = check_patched_out
+    with _capture() as log:
+        if noop:
+            with mock.patch(validator):
+                response = api_client.post_graphql(query, variables)
+        else:
+            response = api_client.post_graphql(query, variables)
+    content = get_graphql_content(response)
+    return content["data"], len(log)
+
+
+@pytest.mark.parametrize("field", ["canFinalize", "errors"])
+def test_order_errors_and_can_finalize_add_at_most_two_queries(
+    field,
+    staff_api_client,
+    permission_group_manage_orders,
+    draft_order,
+    customer_user,
+):
+    # given: restricted draft order linked to an adult, so the full check runs
+    _restrict_and_link(draft_order, customer_user, 30)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    query = (
+        "query order($id: ID!) { order(id: $id) { "
+        + ("canFinalize" if field == "canFinalize" else "errors { field code }")
+        + " } }"
+    )
+    variables = {"id": graphene.Node.to_global_id("Order", draft_order.id)}
+    # warm up caches (content types, permissions, site) outside the measurement
+    _run_and_count(
+        staff_api_client, query, variables, check_patched_out=(QUERY_VALIDATOR, True)
+    )
+
+    # when
+    _, baseline = _run_and_count(
+        staff_api_client, query, variables, check_patched_out=(QUERY_VALIDATOR, True)
+    )
+    data, with_check = _run_and_count(
+        staff_api_client, query, variables, check_patched_out=(QUERY_VALIDATOR, False)
+    )
+
+    # then
+    assert with_check - baseline <= AGE_QUERY_BUDGET
+    assert with_check - baseline >= 1  # the check really ran
+    order = data["order"]
+    if field == "canFinalize":
+        assert order["canFinalize"] is True
+    else:
+        assert not [e for e in order["errors"] if e["code"].startswith("CUSTOMER_")]
+
