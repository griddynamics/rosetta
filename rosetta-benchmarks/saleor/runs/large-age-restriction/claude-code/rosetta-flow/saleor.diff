+        data, checkout, CheckoutErrorCode.CUSTOMER_AGE_UNKNOWN, orders_count
+    )
+    mocked_process_payment.assert_not_called()
+    mocked_confirm.assert_not_called()
+
+
+@patch("saleor.payment.gateway.process_payment")
+def test_checkout_complete_legacy_payment_minor_is_blocked(
+    mocked_process_payment, user_api_client, customer_user, payment_checkout
+):
+    # given
+    _set_dob(customer_user, MINOR_DOB)
+    checkout = payment_checkout(user=customer_user)
+    orders_count = Order.objects.count()
+
+    # when
+    data = _complete(user_api_client, checkout)
+
+    # then
+    _assert_blocked(data, checkout, CheckoutErrorCode.CUSTOMER_TOO_YOUNG, orders_count)
+    mocked_process_payment.assert_not_called()
