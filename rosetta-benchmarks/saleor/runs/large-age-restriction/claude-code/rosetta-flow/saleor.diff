+def test_order_errors_and_can_finalize_use_replica_without_writer_errors(
+    staff_api_client,
+    permission_group_manage_orders,
+    draft_order,
+    customer_user,
+):
+    # given: test settings install `restrict_writer_middleware`, so any query on
+    # the writer connection outside `allow_writer` raises UnsafeWriterAccessError
+    _restrict_and_link(draft_order, customer_user, 17)
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    variables = {"id": graphene.Node.to_global_id("Order", draft_order.id)}
+
+    # when
+    with _capture() as log:
+        response = staff_api_client.post_graphql(ORDER_QUERY, variables)
+
+    # then
+    content = get_graphql_content(response)  # fails on any GraphQL/writer error
+    order = content["data"]["order"]
+    assert OrderErrorCode.CUSTOMER_TOO_YOUNG.name in [
+        e["code"] for e in order["errors"]
+    ]
+    assert order["canFinalize"] is False
+    # the age lookups (variants + buyer) were served by the replica connection
+    replica_sql = log.sql_on(settings.DATABASE_CONNECTION_REPLICA_NAME)
+    assert any('FROM "account_user"' in sql for sql in replica_sql)
+    assert any("minimum_age" in sql for sql in replica_sql)
+    assert not any(
+        "minimum_age" in sql
+        for sql in log.sql_on(settings.DATABASE_CONNECTION_DEFAULT_NAME)
+    )
