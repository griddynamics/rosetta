+
+CUSTOMER_UPDATE_DOB_MUTATION = """
+    mutation UpdateCustomer($id: ID!, $input: CustomerInput!) {
+        customerUpdate(id: $id, input: $input) {
+            errors {
+                field
+                code
+                message
+            }
+            user {
+                id
+                firstName
+            }
+        }
+    }
+"""
+
+DOB = date(1990, 5, 17)
+
+FROZEN_NOW = "2026-03-01T12:00:00+00:00"
+FROZEN_TODAY = date(2026, 3, 1)
+
+
+@pytest.fixture(autouse=True)
+def _frozen_time():
+    with freeze_time(FROZEN_NOW):
+        yield
+
+
+def _variables(user, **input_data):
+    return {
+        "id": graphene.Node.to_global_id("User", user.pk),
+        "input": input_data,
+    }
+
+
+def _changed_events(user):
+    return CustomerEvent.objects.filter(
+        user=user, type=CustomerEvents.DATE_OF_BIRTH_CHANGED
+    )
+
+
+def test_customer_update_date_of_birth_by_superuser(
+    superuser_api_client, superuser, customer_user
+):
+    # when
+    response = superuser_api_client.post_graphql(
+        CUSTOMER_UPDATE_DOB_MUTATION,
+        _variables(customer_user, dateOfBirth=DOB.isoformat()),
+    )
+
+    # then
+    assert not get_graphql_content(response)["data"]["customerUpdate"]["errors"]
+    customer_user.refresh_from_db()
+    assert customer_user.date_of_birth == DOB
+    event = _changed_events(customer_user).get()
+    assert event.parameters == {"actor_user_id": superuser.pk}
+
+
+def test_customer_update_clear_date_of_birth_by_superuser(
+    superuser_api_client, customer_user
+):
+    # given
+    customer_user.date_of_birth = DOB
