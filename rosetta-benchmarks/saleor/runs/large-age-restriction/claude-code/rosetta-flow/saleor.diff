@@ -0,0 +1,66 @@
+import logging
+from collections.abc import Iterable
+from datetime import date
+from enum import Enum
+from typing import TYPE_CHECKING
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+from django.utils import timezone
+
+if TYPE_CHECKING:
+    from ...account.models import User
+    from ...site.models import SiteSettings
+
+logger = logging.getLogger(__name__)
+
+
+class AgeCheckResult(Enum):
+    OK = "ok"
+    AGE_UNKNOWN = "age_unknown"
+    TOO_YOUNG = "too_young"
+
+
+def shop_today(site_settings: "SiteSettings") -> date:
+    """Return the current date in the shop time zone (UTC when it is invalid)."""
+    tz_name = site_settings.time_zone
+    try:
+        tz = ZoneInfo(tz_name)
+    except (ZoneInfoNotFoundError, ValueError, OSError, TypeError):
+        # Only the time zone name is logged; never any customer data.
+        logger.warning("Invalid shop time zone %r, falling back to UTC.", tz_name)
+        tz = ZoneInfo("UTC")
+    return timezone.now().astimezone(tz).date()
+
+
+def calculate_age(date_of_birth: date, today: date) -> int:
+    return (
+        today.year
+        - date_of_birth.year
+        - ((today.month, today.day) < (date_of_birth.month, date_of_birth.day))
+    )
+
+
+def get_required_age(minimum_ages: Iterable[int | None]) -> int | None:
+    ages = [age for age in minimum_ages if age is not None]
+    return max(ages) if ages else None
+
+
+def check_age(
+    required_age: int | None, buyer: "User | None", today: date
+) -> AgeCheckResult:
+    if required_age is None:
+        return AgeCheckResult.OK
+    if buyer is None or buyer.date_of_birth is None:
+        return AgeCheckResult.AGE_UNKNOWN
+    if calculate_age(buyer.date_of_birth, today) < required_age:
+        return AgeCheckResult.TOO_YOUNG
+    return AgeCheckResult.OK
+
+
+def is_age_eligible(date_of_birth: date | None, site_settings: "SiteSettings") -> bool:
+    if date_of_birth is None:
+        return False
+    return (
+        calculate_age(date_of_birth, shop_today(site_settings))
+        >= site_settings.minimum_age
+    )
