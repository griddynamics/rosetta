@@ -0,0 +1,175 @@
+import { ApolloProvider } from "@apollo/client";
+import { CustomerDetailsDocument } from "@dashboard/graphql";
+import { apolloClient } from "@dashboard/graphql/client";
+import { act, renderHook, waitFor } from "@testing-library/react";
+import { type ReactNode } from "react";
+
+import { resetAuditedSendBudget } from "../hooks/useCustomerAuditedDetails";
+import { useCustomerDetails } from "../hooks/useCustomerDetails";
+import { FakeServer, USER_ID } from "../testUtils/FakeCustomerServer";
+import { CustomerDetailsProvider } from "./CustomerDetailsProvider";
+
+// Only environment edges are mocked: auth, app state, notifier, entity-refresh registry.
+// The provider, the generated hooks, the dashboard's real Apollo client cache (typePolicies,
+// possibleTypes, @lockSchema transform) and the real documents are NOT mocked.
+const mockUser = {
+  user: { isSuperuser: true, userPermissions: [{ code: "MANAGE_ORDERS" }] },
+  logout: jest.fn(),
+};
+const mockPermissions = [{ code: "MANAGE_ORDERS" }];
+const mockAppState = [{}, jest.fn()];
+const mockNotify = jest.fn();
+
+jest.mock("@dashboard/auth/useUser", () => ({ useUser: () => mockUser }));
+jest.mock("@dashboard/auth/hooks/useUserPermissions", () => ({
+  useUserPermissions: () => mockPermissions,
+}));
+jest.mock("@dashboard/hooks/useAppState", () => ({
+  __esModule: true,
+  default: () => mockAppState,
+}));
+jest.mock("@dashboard/hooks/useNotifier/useNotifier", () => ({
+  useNotifier: () => mockNotify,
+}));
+jest.mock("@dashboard/extensions/entity-refresh", () => ({
+  useRegisterEntityRefresh: jest.fn(),
+}));
+
+/** Runs the (faked) clock forward in small steps, letting promise callbacks settle in between. */
+const advance = async (ms: number) => {
+  // One act() per step: React flushes effects and state updates when each act scope closes.
+  for (let elapsed = 0; elapsed < ms; elapsed += 50) {
+    await act(async () => {
+      jest.advanceTimersByTime(50);
+      await Promise.resolve();
+    });
+  }
+};
+
+describe("CustomerDetailsProvider request loop (real Apollo cache, in-memory server)", () => {
+  let server: FakeServer;
+
+  beforeEach(async () => {
+    server = new FakeServer();
+    resetAuditedSendBudget();
+    apolloClient.setLink(server.link);
+    await apolloClient.clearStore();
+    jest.useFakeTimers();
+  });
+
+  afterEach(() => {
+    jest.useRealTimers();
+  });
+
+  const wrapper = ({ children }: { children: ReactNode }) => (
+    <ApolloProvider client={apolloClient}>
+      <CustomerDetailsProvider id={USER_ID}>{children}</CustomerDetailsProvider>
+    </ApolloProvider>
+  );
+
+  it("keeps the number of requests bounded after the page opens (no refetch loop)", async () => {
+    // Arrange & Act
+    const { result } = renderHook(() => useCustomerDetails(), { wrapper });
+
+    await waitFor(() => expect(result.current?.customer?.user?.id).toBe(USER_ID));
+    await waitFor(() => expect(result.current?.audited).toBeDefined());
+    await advance(2000);
+
+    // Assert
+    const main = server.requests.filter(r => r.name === "CustomerDetails");
+    const audited = server.requests.filter(r => r.name === "CustomerAuditedDetails");
+
+    // bootstrap + scoped only
+    expect(main.length).toBeLessThanOrEqual(2);
+    expect(main.some(r => r.selectsAuditedFields)).toBe(false);
+    expect(audited).toHaveLength(1);
+    expect(server.requests.filter(r => r.selectsAuditedFields)).toHaveLength(1);
+  });
+
+  describe("nextFetchPolicy cache-first on the main queries", () => {
+    const mainRequests = () => server.requests.filter(r => r.name === "CustomerDetails");
+    const scopedRequests = () => mainRequests().filter(r => r.variables.includeKpiOrderCount);
+
+    const open = async () => {
+      const hook = renderHook(() => useCustomerDetails(), { wrapper });
+
+      await advance(300);
+      await waitFor(() => expect(scopedRequests()).toHaveLength(1));
+      await advance(500);
+
+      return hook;
+    };
+
+    it("explicit refetch() still hits the API for bootstrap and scoped, and never the audited query", async () => {
+      // Arrange
+      const { result } = await open();
+      const mainBefore = mainRequests().length;
+
+      // Act
+      await act(async () => {
+        const refetching = result.current.refetch();
+
+        await advance(100);
+        await refetching;
+      });
+
+      // Assert
+      expect(mainRequests().length - mainBefore).toBe(2);
+      expect(server.requests.filter(r => r.name === "CustomerAuditedDetails")).toHaveLength(1);
+    });
+
+    it("refetchQueries by document (metadata dialog) still hits the API", async () => {
+      // Arrange
+      await open();
+
+      const mainBefore = mainRequests().length;
+
+      // Act
+      await act(async () => {
+        const refetching = apolloClient.refetchQueries({ include: [CustomerDetailsDocument] });
+
+        await advance(100);
+        await refetching.queries.length;
+      });
+
+      // Assert
+      expect(mainRequests().length).toBeGreaterThan(mainBefore);
+      expect(server.requests.filter(r => r.name === "CustomerAuditedDetails")).toHaveLength(1);
+    });
+
+    it("cache writes on the customer entity do not refetch the main queries", async () => {
+      // Arrange
+      await open();
+
+      const mainBefore = mainRequests().length;
+
+      // Act
+      await act(async () => {
+        apolloClient.cache.modify({ id: `User:${USER_ID}`, fields: { note: () => "changed" } });
+      });
+      await advance(500);
+
+      // Assert
+      expect(mainRequests().length).toBe(mainBefore);
+    });
+
+    it("switching the KPI channel and back sends one scoped request per switch, bounded", async () => {
+      // Arrange
+      const { result } = await open();
+      const original = result.current.effectiveKpiChannelId as string;
+
+      // Act
+      act(() => result.current.setKpiChannelId("other-channel"));
+      await advance(500);
+
+      const afterFirstSwitch = scopedRequests().length;
+
+      act(() => result.current.setKpiChannelId(original));
+      await advance(500);
+
+      // Assert
+      expect([afterFirstSwitch, scopedRequests().length]).toEqual([2, 3]);
+      expect(server.requests.filter(r => r.name === "CustomerAuditedDetails")).toHaveLength(1);
+    });
+  });
+});
