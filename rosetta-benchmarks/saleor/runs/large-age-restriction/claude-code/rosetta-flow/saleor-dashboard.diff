index 0000000..8e05b80
--- /dev/null
+++ b/src/customers/hooks/useCustomerAuditedDetails.guard.test.ts
@@ -0,0 +1,49 @@
+import fs from "fs";
+import path from "path";
+
+const SRC = path.resolve(__dirname, "../..");
+const FORBIDDEN_ANYWHERE = /useCustomerAuditedDetails(Lazy)?Query\b/;
+const DOCUMENT = /\bCustomerAuditedDetailsDocument\b/;
+
+const walk = (dir: string): string[] =>
+  fs.readdirSync(dir, { withFileTypes: true }).flatMap(entry => {
+    const full = path.join(dir, entry.name);
+
+    if (entry.isDirectory()) {
+      return walk(full);
+    }
+
+    return /\.(ts|tsx)$/.test(entry.name) ? [full] : [];
+  });
+
+// The audited fields write an audit row on every read, so only the guarded, imperative hook may
+// send the CustomerAuditedDetails operation. Codegen emits observer hooks that must stay unused.
+describe("CustomerAuditedDetails usage guard", () => {
+  const files = walk(SRC).filter(
+    file =>
+      !file.includes(`${path.sep}graphql${path.sep}`) &&
+      !file.endsWith("useCustomerAuditedDetails.guard.test.ts"),
+  );
+
+  it("scans a meaningful number of source files", () => {
+    expect(files.length).toBeGreaterThan(500);
+  });
+
+  it("no src file imports the generated observer/lazy hooks", () => {
+    // Arrange / Act
+    const offenders = files.filter(file => FORBIDDEN_ANYWHERE.test(fs.readFileSync(file, "utf8")));
+
+    // Assert
+    expect(offenders.map(file => path.relative(SRC, file))).toEqual([]);
+  });
+
+  it("only the guarded hook references the generated document", () => {
+    // Arrange / Act
+    const offenders = files
+      .filter(file => DOCUMENT.test(fs.readFileSync(file, "utf8")))
+      .map(file => path.relative(SRC, file));
+
+    // Assert
+    expect(offenders).toEqual(["customers/hooks/useCustomerAuditedDetails.ts"]);
+  });
+});
