new file mode 100644
index 0000000..cb4dca1
--- /dev/null
+++ b/src/customers/testUtils/FakeCustomerServer.ts
@@ -0,0 +1,246 @@
+import { ApolloLink, Observable } from "@apollo/client";
+import {
+  type DocumentNode,
+  type FieldNode,
+  type FragmentDefinitionNode,
+  type SelectionSetNode,
+} from "graphql";
+
+import { customer as customerFixture } from "../fixtures";
+
+export interface Recorded {
+  name: string;
+  variables: Record<string, unknown>;
+  selectsAuditedFields: boolean;
+}
+
+export const USER_ID = "VXNlcjox";
+
+const channel = (id: string) => ({
+  __typename: "Channel",
+  id,
+  name: id,
+  slug: id,
+  isActive: true,
+  currencyCode: "USD",
+});
+const order = (id: string) => ({
+  __typename: "Order",
+  id,
+  created: "2024-01-01T00:00:00+00:00",
+  number: id,
+  status: "UNFULFILLED",
+  channel: channel("Q2hhbm5lbDox"),
+  total: { __typename: "TaxedMoney", gross: { __typename: "Money", currency: "USD", amount: 1 } },
+  subtotal: { __typename: "TaxedMoney", net: { __typename: "Money", currency: "USD", amount: 1 } },
+  shippingPrice: {
+    __typename: "TaxedMoney",
+    gross: { __typename: "Money", currency: "USD", amount: 1 },
+  },
+  totalRefunded: { __typename: "Money", currency: "USD", amount: 0 },
+});
+
+/** Faithful server stand-in: honours @include/@skip, serves one user, audits birthday reads. */
+export class FakeServer {
+  readonly requests: Recorded[] = [];
+
+  private events: Array<Record<string, unknown>> = [];
+
+  private seq = 0;
+
+  noOrders = false;
+
+  /** Network failure for the CustomerAuditedDetails operation (the request is still counted). */
+  failAudited = false;
+
+  private userFixture(id: string) {
+    return {
+      ...customerFixture,
+      __typename: "User",
+      id,
+      email: "customer@example.com",
+      firstName: "A",
+      lastName: "B",
+      isActive: true,
+      note: "",
+      dateJoined: "2020-01-01T00:00:00+00:00",
+      lastLogin: null,
+      defaultShippingAddress: null,
+      defaultBillingAddress: null,
+      addresses: [],
+      externalReference: null,
+      customerType: null,
+      metadata: [],
+      privateMetadata: [],
+      dateOfBirth: "2000-01-01",
+      ageEligible: true,
+      events: this.events,
+      orders: {
+        __typename: "OrderCountableConnection",
+        totalCount: 1,
+        edges: [{ __typename: "OrderCountableEdge", node: order("T3JkZXI6MQ==") }],
+      },
+      kpiOrderChannels: {
+        __typename: "OrderCountableConnection",
+        totalCount: 1,
+        edges: this.noOrders
+          ? []
+          : [{ __typename: "OrderCountableEdge", node: order("T3JkZXI6MQ==") }],
+      },
+      kpiOrders: {
+        __typename: "OrderCountableConnection",
+        totalCount: 1,
+        edges: [{ __typename: "OrderCountableEdge", node: order("T3JkZXI6MQ==") }],
+      },
+      kpiNonCancelledOrderCount: { __typename: "OrderCountableConnection", totalCount: 1 },
+    };
+  }
+
+  private included(node: { directives?: readonly any[] }, vars: Record<string, unknown>) {
+    for (const d of node.directives ?? []) {
+      if (d.name.value !== "include" && d.name.value !== "skip") continue;
+
+      const arg = d.arguments[0].value;
+      const value = arg.kind === "Variable" ? Boolean(vars[arg.name.value]) : arg.value;
+
+      if (d.name.value === "include" && !value) return false;
+
+      if (d.name.value === "skip" && value) return false;
+    }
+
+    return true;
+  }
+
+  private resolve(
+    set: SelectionSetNode,
+    src: any,
+    doc: DocumentNode,
+    vars: Record<string, unknown>,
+    out: Record<string, unknown>,
+    audited: { hit: boolean },
+    isUser: boolean,
+  ) {
+    for (const sel of set.selections) {
+      if (!this.included(sel as any, vars)) continue;
+
+      if (sel.kind === "FragmentSpread") {
+        const frag = doc.definitions.find(
+          d => d.kind === "FragmentDefinition" && d.name.value === sel.name.value,
+        ) as FragmentDefinitionNode;
+
+        this.resolve(frag.selectionSet, src, doc, vars, out, audited, isUser);
+      } else if (sel.kind === "InlineFragment") {
+        this.resolve(sel.selectionSet, src, doc, vars, out, audited, isUser);
+      } else {
+        const field = sel as FieldNode;
+        const key = field.alias?.value ?? field.name.value;
+        const name = field.name.value;
+
+        if (isUser && (name === "dateOfBirth" || name === "ageEligible")) audited.hit = true;
+
+        out.__typename = src.__typename;
+
+        const raw = name === "__typename" ? src.__typename : src[key];
+
+        out[key] = this.build(field, raw, doc, vars, audited);
+      }
+    }
+  }
+
+  private build(
+    field: FieldNode,
+    raw: any,
+    doc: DocumentNode,
+    vars: Record<string, unknown>,
+    audited: { hit: boolean },
+  ): unknown {
+    if (raw === undefined || raw === null || !field.selectionSet) return raw ?? null;
+
+    if (Array.isArray(raw)) {
+      return raw.map(item => this.build(field, item, doc, vars, audited));
+    }
+
+    const out: Record<string, unknown> = {};
+
+    this.resolve(field.selectionSet, raw, doc, vars, out, audited, false);
+
+    return out;
+  }
+
+  link = new ApolloLink(operation => {
+    return new Observable(observer => {
+      const timer = setTimeout(() => {
+        if (this.failAudited && operation.operationName === "CustomerAuditedDetails") {
+          this.requests.push({
+            name: operation.operationName,
+            variables: operation.variables,
+            selectsAuditedFields: false,
+          });
+          observer.error(new Error("network down"));
+
+          return;
+        }
+
+        const audited = { hit: false };
+        const data: Record<string, unknown> = {};
+        const root = {
+          __typename: "Query",
+          user: this.userFixture(String(operation.variables.id ?? USER_ID)),
+          // Mutation payload: no errors, the same user. Mutation results never audit.
+          customerUpdate: {
+            __typename: "CustomerUpdate",
+            errors: [],
+            user: this.userFixture(String(operation.variables.id ?? USER_ID)),
+          },
+        };
+        const query = operation.query;
+        const op = query.definitions.find(d => d.kind === "OperationDefinition") as any;
+
+        for (const sel of op.selectionSet.selections as FieldNode[]) {
+          if (!this.included(sel, operation.variables)) continue;
+
+          const key = sel.alias?.value ?? sel.name.value;
+          const userOut: Record<string, unknown> = {};
+
+          // Walk the user selection; mark audited reads on the User object itself.
+          this.resolve(
+            sel.selectionSet!,
+            (root as any)[sel.name.value],
+            query,
+            operation.variables,
+            userOut,
+            audited,
+            true,
+          );
+          data[key] = userOut;
+        }
+
+        this.requests.push({
+          name: operation.operationName,
+          variables: operation.variables,
+          selectsAuditedFields: audited.hit,
+        });
+
+        // Side effect AFTER building the response: every audited read appends a new event.
+        if (audited.hit) {
+          this.seq += 1;
+          this.events = [
+            ...this.events,
+            {
+              __typename: "CustomerEvent",
+              id: `evt-${this.seq}`,
+              type: "DATE_OF_BIRTH_VIEWED",
+              date: new Date(2024, 0, 1, 0, 0, this.seq).toISOString(),
+              user: { __typename: "User", id: "staff", email: "admin@example.com" },
+            },
+          ];
+        }
+
+        observer.next({ data });
+        observer.complete();
+      }, 5);
+
+      return () => clearTimeout(timer);
+    });
+  });
+}
