+      await Promise.resolve();
+    });
+  }
+};
+
+describe("customer details view, bounded audited requests (AC-90)", () => {
+  let server: FakeServer;
+
+  beforeEach(async () => {
+    server = new FakeServer();
+    mockPermissions = [{ code: "MANAGE_ORDERS" }, { code: "MANAGE_USERS" }];
+    mockUser.user = { isSuperuser: true, userPermissions: mockPermissions };
+    mockAppState = [{}, jest.fn()];
+    resetAuditedSendBudget();
+    apolloClient.setLink(server.link);
+    await apolloClient.clearStore();
+    jest.useFakeTimers();
+  });
+
+  afterEach(() => {
+    jest.useRealTimers();
+  });
+
+  const tree = (id = USER_ID) => (
+    <Wrapper>
+      <ApolloProvider client={apolloClient}>
+        <MemoryRouter>
+          <CustomerDetailsView id={id} params={{}} />
+        </MemoryRouter>
+      </ApolloProvider>
+    </Wrapper>
+  );
+  const count = (name: string, id = USER_ID) =>
+    server.requests.filter(r => r.name === name && r.variables.id === id).length;
+  const auditedFieldReads = () => server.requests.filter(r => r.selectsAuditedFields).length;
+  const setViewer = (isSuperuser: boolean, permissionCodes: string[]) => {
+    mockPermissions = permissionCodes.map(code => ({ code }));
+    mockUser.user = { isSuperuser, userPermissions: mockPermissions };
+  };
+
+  /** Everything that could plausibly re-trigger a query, without any user action. */
+  const churn = async (rerender: (ui: JSX.Element) => void, id = USER_ID) => {
+    for (let i = 0; i < 5; i++) {
+      // forced re-render of the whole tree, with a fresh app state object each time
+      mockAppState = [{ loading: i % 2 === 0 }, jest.fn()];
+      rerender(tree(id));
+      await act(async () => {
+        // explicit cache writes on the customer entity (what a mutation result or another query does)
+        apolloClient.cache.modify({
+          id: `User:${id}`,
+          fields: { note: () => `cache write ${i}`, lastLogin: () => `2024-01-0${i + 1}` },
+        });
+      });
+      await advance(30);
+    }
+  };
+
+  it("sends the audited query exactly once per customer id, even under re-renders and cache writes", async () => {
+    // Arrange
+    const { rerender } = render(tree());
+
+    // Act
+    await waitFor(() => expect(screen.getByTestId("customer-birthday-audit")).toBeInTheDocument());
+    // The first response predates its own audit side effect: the card is loaded and empty.
+    await waitFor(() =>
+      expect(screen.getByTestId("customer-birthday-audit-empty")).toBeInTheDocument(),
+    );
+    await advance(2000);
+    await churn(rerender);
+    await advance(300);
+
+    // Assert
+    expect(count(AUDITED)).toBe(1);
+    expect(auditedFieldReads()).toBe(1);
+    expect(count(MAIN)).toBeLessThanOrEqual(2);
+    expect(server.requests.filter(r => r.name === MAIN).some(r => r.selectsAuditedFields)).toBe(
+      false,
+    );
+    expect(screen.getByTestId("customer-birthday-audit-empty")).toBeInTheDocument();
+  });
+
+  it("sends the audited query once under StrictMode at view level", async () => {
+    // Arrange / Act
+    const { rerender } = render(<StrictMode>{tree()}</StrictMode>);
+
+    await waitFor(() =>
+      expect(screen.getByTestId("customer-birthday-audit-empty")).toBeInTheDocument(),
+    );
+    await advance(500);
+    await churn(ui => rerender(<StrictMode>{ui}</StrictMode>));
+    await advance(500);
+
+    // Assert
+    expect(count(AUDITED)).toBe(1);
+    expect(auditedFieldReads()).toBe(1);
+  });
+
+  it("sends it exactly once more after one explicit refetch (saving a birthday), single-flight", async () => {
+    // Arrange
+    const { rerender } = render(tree());
+
+    await waitFor(() =>
+      expect(screen.getByTestId("customer-birthday-audit-empty")).toBeInTheDocument(),
+    );
+
+    await waitFor(() => expect(count(MAIN)).toBe(2));
+    await advance(100);
+
+    // Act - superuser saves a new birthday; the view calls the explicit refetch once
+    fireEvent.change(screen.getByTestId("customer-date-of-birth"), {
+      target: { value: "1991-01-01" },
+    });
+    fireEvent.click(screen.getByRole("button", { name: /save/i }));
+    await waitFor(() => expect(count(AUDITED)).toBe(2));
+    await waitFor(() =>
+      expect(screen.getAllByTestId("customer-birthday-audit-event")).toHaveLength(1),
+    );
+    await advance(1500);
+    await churn(rerender);
+
+    // Assert
+    expect(count("UpdateCustomer")).toBe(1);
+    expect(count(AUDITED)).toBe(2);
+    expect(auditedFieldReads()).toBe(2);
+    expect(count(MAIN)).toBeLessThanOrEqual(2);
+  });
+
+  it("sends it once per customer id when the customer changes, never again for the old id", async () => {
+    // Arrange
+    const { rerender } = render(tree());
+
+    await waitFor(() => expect(count(AUDITED)).toBe(1));
+
+    // Act
+    rerender(tree(OTHER_ID));
+    await waitFor(() => expect(count(AUDITED, OTHER_ID)).toBe(1));
+    await churn(rerender, OTHER_ID);
+    await advance(500);
+
+    // Assert
+    expect(count(AUDITED, USER_ID)).toBe(1);
+    expect(count(AUDITED, OTHER_ID)).toBe(1);
+  });
+
+  it("A -> B -> A: key={id} remounts per customer, each open sends once and the form is never stuck disabled", async () => {
+    // Arrange
+    const { rerender } = render(tree());
+
+    await waitFor(() =>
+      expect(screen.getByTestId("customer-birthday-audit-empty")).toBeInTheDocument(),
+    );
+
+    // Act
+    rerender(tree(OTHER_ID));
+    await waitFor(() => expect(count(AUDITED, OTHER_ID)).toBe(1));
+    rerender(tree());
+    await waitFor(() => expect(count(AUDITED, USER_ID)).toBe(2));
+    await advance(500);
+
+    // Assert
+    expect(count(AUDITED, USER_ID)).toBe(2);
+    expect(count(AUDITED, OTHER_ID)).toBe(1);
+    expect(screen.queryByTestId("customer-birthday-audit-loading")).not.toBeInTheDocument();
+    // two audit rows exist for A now: the second open sees the first open's VIEWED row
+    expect(screen.getAllByTestId("customer-birthday-audit-event").length).toBeGreaterThanOrEqual(1);
+    expect(screen.getByTestId("customer-date-of-birth")).not.toBeDisabled();
+  });
+
+  it("selects only ageEligible, once, for MANAGE_USERS staff who are not superusers", async () => {
+    // Arrange
+    setViewer(false, ["MANAGE_ORDERS", "MANAGE_USERS"]);
+
+    const { rerender } = render(tree());
+
+    // Act
+    await waitFor(() =>
+      expect(screen.getByTestId("customer-age-eligible-value")).toBeInTheDocument(),
+    );
+    await churn(rerender);
+
+    // Assert
+    const audited = server.requests.filter(r => r.name === AUDITED);
+
+    expect(audited).toHaveLength(1);
+    expect(audited[0].variables).toMatchObject({ isSuperuser: false, includeAgeEligible: true });
+    expect(screen.queryByTestId("customer-birthday-audit")).not.toBeInTheDocument();
+    expect(count(MAIN)).toBeLessThanOrEqual(2);
+  });
+
+  it("never sends the audited query for a user who is neither superuser nor allowed ageEligible", async () => {
+    // Arrange
+    setViewer(false, ["MANAGE_ORDERS"]);
+
+    const { rerender } = render(tree());
+
+    // Act
+    await waitFor(() => expect(count(MAIN)).toBeGreaterThan(0));
+    await advance(1000);
+    await churn(rerender);
+
+    // Assert
+    expect(count(AUDITED)).toBe(0);
+    expect(auditedFieldReads()).toBe(0);
+    expect(count(MAIN)).toBeLessThanOrEqual(2);
+  });
+
+  describe("viewer flips mid-mount", () => {
+    it("MANAGE_USERS staff -> superuser sends at most one extra audited request", async () => {
+      // Arrange
+      setViewer(false, ["MANAGE_ORDERS", "MANAGE_USERS"]);
+
+      const { rerender } = render(tree());
+
+      await waitFor(() => expect(count(AUDITED)).toBe(1));
+
+      // Act
+      setViewer(true, ["MANAGE_ORDERS", "MANAGE_USERS"]);
+      rerender(tree());
+      await advance(1000);
+
+      // Assert
+      expect(count(AUDITED)).toBe(2);
+      expect(screen.getByTestId("customer-birthday-audit")).toBeInTheDocument();
+    });
+
+    it("false -> true -> false -> true quickly stays bounded", async () => {
+      // Arrange
+      setViewer(false, ["MANAGE_ORDERS"]);
+
+      const { rerender } = render(tree());
+
+      // Act
+      for (const isSuperuser of [true, false, true]) {
+        setViewer(isSuperuser, isSuperuser ? ["MANAGE_ORDERS", "MANAGE_USERS"] : ["MANAGE_ORDERS"]);
+        rerender(tree());
+        await advance(10);
+      }
+
+      await advance(1000);
+
+      // Assert
+      expect(count(AUDITED)).toBe(1);
+      expect(auditedFieldReads()).toBe(1);
+    });
+
+    it("oscillating 20 times never exceeds the per-id send cap", async () => {
+      // Arrange
+      setViewer(false, ["MANAGE_ORDERS", "MANAGE_USERS"]);
+
+      const { rerender } = render(tree());
+
+      // Act
+      for (let i = 0; i < 20; i++) {
+        setViewer(i % 2 === 0, ["MANAGE_ORDERS", "MANAGE_USERS"]);
+        rerender(tree());
+        await advance(10);
+      }
+
+      await advance(1000);
+
+      // Assert
+      expect(count(AUDITED)).toBeLessThanOrEqual(3);
+      expect(count(AUDITED)).toBe(2);
+    });
+  });
+
+  describe("failed audited request", () => {
+    it("shows an unavailable state, keeps the birthday read-only and never sends dateOfBirth on save", async () => {
+      // Arrange
+      server.failAudited = true;
+
+      render(tree());
+
+      // Act
+      await waitFor(() =>
+        expect(screen.getByTestId("customer-birthday-audit-unavailable")).toBeInTheDocument(),
+      );
+      await advance(1000);
+      fireEvent.change(screen.getByTestId("customer-first-name"), { target: { value: "Changed" } });
+      fireEvent.click(screen.getByRole("button", { name: /save/i }));
+      await waitFor(() => expect(count("UpdateCustomer")).toBe(1));
+
+      // Assert
+      expect(screen.queryByTestId("customer-birthday-audit-empty")).not.toBeInTheDocument();
+      expect(screen.getByTestId("customer-date-of-birth")).toBeDisabled();
+      expect(count(AUDITED)).toBe(1);
+      expect(server.requests.find(r => r.name === "UpdateCustomer")?.variables).toMatchObject({
+        input: expect.not.objectContaining({ dateOfBirth: expect.anything() }),
+      });
+    });
+  });
+
+  it("real time, bounded: a viewer without audited access stays at zero audited sends for 300 ms", async () => {
+    // Arrange
+    jest.useRealTimers();
+    setViewer(false, ["MANAGE_ORDERS"]);
+
+    // Act
+    render(tree());
+    await waitFor(() => expect(count(MAIN)).toBeGreaterThan(0));
+    await act(async () => {
+      await new Promise(resolve => setTimeout(resolve, 300));
+    });
+
+    // Assert
+    expect(count(AUDITED)).toBe(0);
+  });
+});
