+import { AccountErrorCode } from "@dashboard/graphql";
+import Wrapper from "@test/wrapper";
+import { render, screen } from "@testing-library/react";
+
+import CustomerInfo from "./CustomerInfo";
+
+const baseData = {
+  firstName: "Ada",
+  lastName: "Lovelace",
+  email: "ada@example.com",
+  note: "",
+  dateOfBirth: "1990-05-17",
+};
+
+const renderInfo = (props: Partial<React.ComponentProps<typeof CustomerInfo>> = {}) =>
+  render(
+    <Wrapper>
+      <CustomerInfo data={baseData} disabled={false} errors={[]} onChange={jest.fn()} {...props} />
+    </Wrapper>,
+  );
+
+describe("CustomerInfo", () => {
+  describe("superuser", () => {
+    it("renders the editable date of birth input with the current value", () => {
+      // Arrange / Act
+      renderInfo({ isSuperuser: true });
+
+      // Assert
+      const input = screen.getByTestId("customer-date-of-birth") as HTMLInputElement;
+
+      expect(input).toHaveAttribute("type", "date");
+      expect(input.value).toBe("1990-05-17");
+      expect(input).not.toBeDisabled();
+    });
+
+    it("keeps the date of birth input read-only and explains why when the audited read failed", () => {
+      // Arrange / Act
+      renderInfo({ isSuperuser: true, auditedError: true, data: { ...baseData, dateOfBirth: "" } });
+
+      // Assert
+      expect(screen.getByTestId("customer-date-of-birth")).toBeDisabled();
+      expect(screen.getByText(/Date of birth could not be loaded/)).toBeInTheDocument();
+    });
+
+    it("does not render the read-only eligibility label", () => {
+      // Arrange / Act
+      renderInfo({ isSuperuser: true, ageEligible: true });
+
+      // Assert
+      expect(screen.queryByTestId("customer-age-eligible")).not.toBeInTheDocument();
+    });
+
+    it("shows the account error on the date of birth field", () => {
+      // Arrange / Act
+      renderInfo({
+        isSuperuser: true,
+        errors: [
+          {
+            __typename: "AccountError",
+            code: AccountErrorCode.INVALID,
+            field: "dateOfBirth",
+            message: "raw",
+            addressType: null,
+            attributes: null,
+          },
+        ],
+      });
+
+      // Assert
+      expect(screen.getByText("Enter a valid date of birth")).toBeInTheDocument();
+    });
+  });
+
+  describe("non-superuser", () => {
+    it.each([
+      [true, "Yes"],
+      [false, "No or no birthday on file"],
+      [null, "Not available"],
+      [undefined, "Not available"],
+    ])("shows the eligibility label for ageEligible=%s", (ageEligible, expected) => {
+      // Arrange / Act
+      renderInfo({ isSuperuser: false, ageEligible });
+
+      // Assert
+      expect(screen.getByText("Meets shop minimum age")).toBeInTheDocument();
+      expect(screen.getByTestId("customer-age-eligible-value")).toHaveTextContent(expected);
+    });
+
+    it("shows a skeleton instead of a label while the flag is loading", () => {
+      // Arrange / Act
+      renderInfo({ isSuperuser: false, ageEligible: undefined, ageEligibleLoading: true });
+
+      // Assert
+      expect(screen.getByTestId("customer-age-eligible-loading")).toBeInTheDocument();
+      expect(screen.queryByTestId("customer-age-eligible-value")).not.toBeInTheDocument();
+    });
+
+    it("does not render the date of birth input or value", () => {
+      // Arrange / Act
+      renderInfo({ ageEligible: true });
+
+      // Assert
+      expect(screen.queryByTestId("customer-date-of-birth")).not.toBeInTheDocument();
+      expect(screen.queryByDisplayValue("1990-05-17")).not.toBeInTheDocument();
+    });
+  });
+});
