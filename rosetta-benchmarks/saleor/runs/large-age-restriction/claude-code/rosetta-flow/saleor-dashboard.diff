+import { SettingsFieldStack } from "@dashboard/components/Settings/SettingsFieldStack";
+import { SettingsSection } from "@dashboard/components/Settings/SettingsSection";
+import { type ShopErrorFragment } from "@dashboard/graphql";
+import { type FormChange } from "@dashboard/hooks/useForm";
+import { getFormErrors } from "@dashboard/utils/errors";
+import getShopErrorMessage from "@dashboard/utils/errors/shop";
+import { Box, Combobox, Input, type Option } from "@saleor/macaw-ui-next";
+import { useMemo } from "react";
+import { useIntl } from "react-intl";
+
+import { messages } from "./messages";
+import {
+  getTimeZoneNames,
+  isMinimumAgeValid,
+  isTimeZoneValid,
+  MINIMUM_AGE_MAX,
+  MINIMUM_AGE_MIN,
+} from "./utils";
+
+export interface AgeRestrictionFormData {
+  timeZone: string;
+  minimumAge: string;
+}
+
+interface AgeRestrictionCardProps {
+  data: AgeRestrictionFormData;
+  errors: ShopErrorFragment[];
+  disabled: boolean;
+  onChange: FormChange;
+  /** Settings hub anchor id. */
+  id?: string;
+}
+
+/** Shop time zone + minimum age (requires MANAGE_SETTINGS, like the whole page). */
+export const AgeRestrictionCard = ({
+  data,
+  errors,
+  disabled,
+  onChange,
+  id,
+}: AgeRestrictionCardProps): React.ReactNode => {
+  const intl = useIntl();
+  const formErrors = getFormErrors(["timeZone", "minimumAge"], errors);
+  const options: Option[] = useMemo(
+    () => getTimeZoneNames(data.timeZone).map(name => ({ value: name, label: name })),
+    [data.timeZone],
+  );
+  const selected: Option | null = data.timeZone
+    ? { value: data.timeZone, label: data.timeZone }
+    : null;
+  const clientTimeZoneError = !isTimeZoneValid(data.timeZone);
+  const timeZoneError = clientTimeZoneError
+    ? intl.formatMessage(messages.timeZoneInvalid)
+    : getShopErrorMessage(formErrors.timeZone, intl);
+  const clientAgeError = !isMinimumAgeValid(data.minimumAge);
+  const ageError = clientAgeError
+    ? intl.formatMessage(messages.minimumAgeInvalid)
+    : getShopErrorMessage(formErrors.minimumAge, intl);
+
+  return (
+    <SettingsSection
+      id={id}
+      data-test-id="age-restriction-settings"
+      ownership="shop"
+      title={intl.formatMessage(messages.sectionTitle)}
+      description={intl.formatMessage(messages.sectionDescription)}
+    >
+      <SettingsFieldStack>
+        <Box display="flex" flexDirection="column" gap={5}>
+          <Combobox
+            data-test-id="age-restriction-time-zone"
+            name="timeZone"
+            label={intl.formatMessage(messages.timeZoneLabel)}
+            options={options}
+            value={selected}
+            disabled={disabled}
+            error={clientTimeZoneError || !!formErrors.timeZone}
+            helperText={timeZoneError}
+            onChange={option =>
+              onChange({ target: { name: "timeZone", value: option?.value ?? "" } })
+            }
+          />
+          <Input
+            data-test-id="age-restriction-minimum-age"
+            name="minimumAge"
+            type="number"
+            min={MINIMUM_AGE_MIN}
+            max={MINIMUM_AGE_MAX}
+            label={intl.formatMessage(messages.minimumAgeLabel)}
+            value={data.minimumAge}
+            disabled={disabled}
+            error={clientAgeError || !!formErrors.minimumAge}
+            helperText={ageError}
+            onChange={onChange}
+          />
+        </Box>
+      </SettingsFieldStack>
+    </SettingsSection>
+  );
+};
+
+AgeRestrictionCard.displayName = "AgeRestrictionCard";
