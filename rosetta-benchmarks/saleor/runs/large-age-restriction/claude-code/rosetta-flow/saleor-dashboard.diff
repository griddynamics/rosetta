+      .fn()
+      .mockResolvedValueOnce({ data })
+      .mockRejectedValueOnce(new Error("boom"));
+    const { result } = renderHook(
+      () => useCustomerAuditedDetails({ id: "u1", isSuperuser: true, includeAgeEligible: true }),
+      { wrapper: clientWrapper({ query } as never) },
