+        renderHook(
+          () =>
+            useCustomerAuditedDetails({ id: `u${n}`, isSuperuser: true, includeAgeEligible: true }),
+          { wrapper: clientWrapper(client) },
+        ),
+      );
+
+      // Act: each customer tries 3 times (4 x 3 = 12 attempts)
+      for (const hook of hooks) {
+        for (let i = 0; i < 2; i++) {
