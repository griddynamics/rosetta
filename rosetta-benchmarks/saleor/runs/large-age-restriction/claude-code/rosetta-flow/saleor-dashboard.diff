diff --git a/src/orders/views/OrderDetails/OrderDetails.confirmRender.test.tsx b/src/orders/views/OrderDetails/OrderDetails.confirmRender.test.tsx
new file mode 100644
index 0000000..bcf7644
--- /dev/null
+++ b/src/orders/views/OrderDetails/OrderDetails.confirmRender.test.tsx
@@ -0,0 +1,116 @@
+import { type MockedResponse } from "@apollo/client/testing";
+import { MockedProvider } from "@apollo/client/testing";
+import { Toast, type ToastProps } from "@dashboard/components/notifications/Toast";
+import { OrderConfirmDocument, OrderErrorCode } from "@dashboard/graphql";
+import { OrderFixture } from "@dashboard/orders/fixtures/OrderFixture";
+import { ThemeProvider } from "@saleor/macaw-ui-next";
+import { render, screen, waitFor } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { IntlProvider } from "react-intl";
+
+import OrderDetails from "./OrderDetails";
+
+const enqueueToast = jest.fn();
+const unconfirmedOrder = OrderFixture.unconfirmed().build();
+
+// The real useNotifier runs; only the toast queue / sonner (portal + animation) are replaced,
+// and the captured toast is rendered with the real Toast component to assert visible text.
+jest.mock("@dashboard/components/notifications/notificationQueue", () => ({
+  enqueueToast: (input: unknown) => enqueueToast(input),
+}));
+jest.mock("sonner", () => ({ toast: { dismiss: jest.fn(), custom: jest.fn() } }));
+jest.mock("@dashboard/hooks/useNavigator", () => ({ __esModule: true, default: () => jest.fn() }));
+jest.mock("@dashboard/hooks/useBackgroundTask", () => ({
+  __esModule: true,
+  default: () => ({ queue: jest.fn() }),
+}));
+jest.mock("../../hooks/useOrderDetailsUrlCanonicalization", () => ({
+  useOrderDetailsUrlCanonicalization: jest.fn(),
+}));
+jest.mock("./useOrderDetails", () => ({
+  useOrderDetails: () => ({ data: { order: unconfirmedOrder }, loading: false }),
+}));
+jest.mock("../../containers/OrderOperations", () => ({
+  __esModule: true,
+  default: ({ children }: { children: (ops: object) => React.ReactNode }) => <>{children({})}</>,
+}));
+jest.mock("./OrderNormalDetails", () => ({ OrderNormalDetails: () => null }));
+jest.mock("./OrderDraftDetails", () => ({ OrderDraftDetails: () => null }));
+// Real confirm flow lives in OrderDetails (useOrderConfirmMutation + handleSubmit);
+// the page UI is replaced by a single "Confirm order" button that triggers handleSubmit.
+jest.mock("./OrderUnconfirmedDetails", () => ({
+  OrderUnconfirmedDetails: ({
+    handleSubmit,
+  }: {
+    handleSubmit: (data: Record<string, unknown>) => Promise<unknown>;
+  }) => <button onClick={() => handleSubmit({})}>Confirm order</button>,
+}));
+
+const confirmErrorMock = (code: OrderErrorCode): MockedResponse => ({
+  request: { query: OrderConfirmDocument, variables: { id: unconfirmedOrder.id } },
+  result: {
+    data: {
+      orderConfirm: {
+        __typename: "OrderConfirm",
+        errors: [
+          {
+            __typename: "OrderError",
+            code,
+            field: "lines",
+            message: "raw api message",
+            addressType: null,
+            orderLines: null,
+          },
+        ],
+        order: null,
+      },
+    },
+  },
+});
+
+describe("OrderDetails confirm flow (rendered)", () => {
+  beforeEach(() => enqueueToast.mockClear());
+
+  it.each([
+    [OrderErrorCode.CUSTOMER_AGE_UNKNOWN, /date of birth/i],
+    [OrderErrorCode.CUSTOMER_TOO_YOUNG, /minimum age/i],
+  ])("shows a mapped error notification for %s when confirming", async (code, expected) => {
+    // Arrange
+    render(
+      <MockedProvider mocks={[confirmErrorMock(code)]} addTypename>
+        <IntlProvider locale="en" messages={{}}>
+          <OrderDetails id={unconfirmedOrder.id} params={{}} />
+        </IntlProvider>
+      </MockedProvider>,
+    );
+
+    // Act
+    await userEvent.click(screen.getByRole("button", { name: "Confirm order" }));
+
+    // Assert
+    // makeMutation's generic handler also emits a raw-API-message toast; the
+    // order-specific onCompleted handler must emit the mapped, human-readable one.
+    await waitFor(() =>
+      expect(enqueueToast).toHaveBeenCalledWith(
+        expect.objectContaining({
+          type: "error",
+          description: expect.stringMatching(expected),
+        }),
+      ),
+    );
+
+    const mapped: Omit<ToastProps, "id"> = enqueueToast.mock.calls
+      .map(([input]) => input)
+      .find(input => typeof input.description === "string" && expected.test(input.description));
+
+    render(
+      <IntlProvider locale="en" messages={{}}>
+        <ThemeProvider>
+          <Toast id="t" {...mapped} />
+        </ThemeProvider>
+      </IntlProvider>,
+    );
+
+    expect(screen.getByText(expected)).toBeInTheDocument();
+  });
+});
