@@ -0,0 +1,64 @@
+import { OrderErrorCode, type OrderErrorFragment } from "@dashboard/graphql";
+import { createIntl } from "react-intl";
+
+import getOrderErrorMessage from "./order";
+
+const intl = createIntl({ locale: "en", messages: {} });
+const createError = (code: OrderErrorCode, message: string | null = "API"): OrderErrorFragment => ({
+  __typename: "OrderError",
+  code,
+  field: "lines",
+  message,
+  addressType: null,
+  orderLines: null,
+});
+
+describe("getOrderErrorMessage", () => {
+  it("returns a dedicated message for CUSTOMER_AGE_UNKNOWN", () => {
+    // Arrange
+    const error = createError(OrderErrorCode.CUSTOMER_AGE_UNKNOWN);
+
+    // Act
+    const message = getOrderErrorMessage(error, intl);
+
+    // Assert
+    expect(message).toBe(
+      "Customer's date of birth is not set. Add it to the customer profile or change the customer to continue.",
+    );
+  });
+
+  it("returns a dedicated message for CUSTOMER_TOO_YOUNG", () => {
+    // Arrange
+    const error = createError(OrderErrorCode.CUSTOMER_TOO_YOUNG);
+
+    // Act
+    const message = getOrderErrorMessage(error, intl);
+
+    // Assert
+    expect(message).toBe(
+      "Customer does not meet the minimum age required for age-restricted products in this order. Change the customer or remove the products.",
+    );
+  });
+
+  it("does not leak the API message for age codes", () => {
+    // Arrange
+    const error = createError(OrderErrorCode.CUSTOMER_TOO_YOUNG, "dob 2015-01-01");
+
+    // Act
+    const message = getOrderErrorMessage(error, intl);
+
+    // Assert
+    expect(message).not.toContain("2015");
+  });
+
+  it("keeps existing mapping for other codes", () => {
+    // Arrange
+    const error = createError(OrderErrorCode.NOT_EDITABLE);
+
+    // Act
+    const message = getOrderErrorMessage(error, intl);
+
+    // Assert
+    expect(message).toBe("Only draft orders can be edited");
+  });
+});
