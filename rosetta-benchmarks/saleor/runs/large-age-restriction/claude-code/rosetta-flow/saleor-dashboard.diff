@@ -0,0 +1,93 @@
+import { CustomerEventsEnum } from "@dashboard/graphql";
+import Wrapper from "@test/wrapper";
+import { render, screen } from "@testing-library/react";
+
+import { CustomerBirthdayAuditCard } from "./CustomerBirthdayAuditCard";
+
+const events = [
+  {
+    id: "e1",
+    type: CustomerEventsEnum.DATE_OF_BIRTH_CHANGED,
+    date: "2026-01-02T10:00:00+00:00",
+    user: { email: "admin@example.com" },
+  },
+  {
+    id: "e2",
+    type: CustomerEventsEnum.DATE_OF_BIRTH_VIEWED,
+    date: "2026-01-03T10:00:00+00:00",
+    user: null,
+  },
+  {
+    id: "e3",
+    type: CustomerEventsEnum.NAME_ASSIGNED,
+    date: "2026-01-04T10:00:00+00:00",
+    user: { email: "other@example.com" },
+  },
+];
+
+const renderCard = (props: React.ComponentProps<typeof CustomerBirthdayAuditCard>) =>
+  render(
+    <Wrapper>
+      <CustomerBirthdayAuditCard {...props} />
+    </Wrapper>,
+  );
+
+describe("CustomerBirthdayAuditCard", () => {
+  it("lists only DATE_OF_BIRTH_* events for superusers", () => {
+    // Arrange / Act
+    renderCard({ isSuperuser: true, events });
+
+    // Assert
+    expect(screen.getByText("Birthday audit")).toBeInTheDocument();
+    expect(screen.getAllByTestId("customer-birthday-audit-event")).toHaveLength(2);
+    expect(screen.getByText("Date of birth changed")).toBeInTheDocument();
+    expect(screen.getByText("Date of birth viewed")).toBeInTheDocument();
+    expect(screen.getByText("By admin@example.com")).toBeInTheDocument();
+    expect(screen.getByText("Unknown actor")).toBeInTheDocument();
+    expect(screen.queryByText(/other@example.com/)).not.toBeInTheDocument();
+  });
+
+  it("shows an empty state for superusers without birthday events", () => {
+    // Arrange / Act
+    renderCard({ isSuperuser: true, events: [events[2]] });
+
+    // Assert
+    expect(screen.getByTestId("customer-birthday-audit-empty")).toBeInTheDocument();
+  });
+
+  it("shows a skeleton, not the empty state, while loading", () => {
+    // Arrange / Act
+    renderCard({ isSuperuser: true, events: undefined, loading: true });
+
+    // Assert
+    expect(screen.getByTestId("customer-birthday-audit-loading")).toBeInTheDocument();
+    expect(screen.queryByTestId("customer-birthday-audit-empty")).not.toBeInTheDocument();
+  });
+
+  it("does not crash when events are undefined after loading", () => {
+    // Arrange / Act
+    renderCard({ isSuperuser: true, events: undefined });
+
+    // Assert
+    expect(screen.getByTestId("customer-birthday-audit-empty")).toBeInTheDocument();
+  });
+
+  it("shows an unavailable message, not the empty copy, when the audited read failed", () => {
+    // Arrange / Act
+    renderCard({ isSuperuser: true, events: undefined, error: true });
+
+    // Assert
+    expect(screen.getByTestId("customer-birthday-audit-unavailable")).toBeInTheDocument();
+    expect(screen.queryByTestId("customer-birthday-audit-empty")).not.toBeInTheDocument();
+  });
+
+  it("renders nothing for non-superusers even when events are present", () => {
+    // Arrange / Act
+    renderCard({ isSuperuser: false, events });
+
+    // Assert
+    expect(screen.queryByTestId("customer-birthday-audit")).not.toBeInTheDocument();
+    expect(screen.queryByTestId("customer-birthday-audit-event")).not.toBeInTheDocument();
+    expect(screen.queryByText("Birthday audit")).not.toBeInTheDocument();
+  });
+});
diff --git a/src/customers/components/CustomerBirthdayAuditCard/CustomerBirthdayAuditCard.tsx b/src/customers/components/CustomerBirthdayAuditCard/CustomerBirthdayAuditCard.tsx
new file mode 100644
index 0000000..eb5a709
--- /dev/null
+++ b/src/customers/components/CustomerBirthdayAuditCard/CustomerBirthdayAuditCard.tsx
@@ -0,0 +1,88 @@
+import { DateTime } from "@dashboard/components/Date/DateTime";
+import { DetailSettingsCard } from "@dashboard/components/DetailSettingsCard/DetailSettingsCard";
+import { Skeleton } from "@dashboard/components/Skeleton/Skeleton";
+import { CustomerEventsEnum } from "@dashboard/graphql";
+import { Box, Text } from "@saleor/macaw-ui-next";
+import { useIntl } from "react-intl";
+
+import { messages } from "./messages";
+
+export interface CustomerBirthdayAuditEvent {
+  id: string;
+  type: CustomerEventsEnum | null;
+  date: string | null;
+  user: { email: string } | null;
+}
+
+interface CustomerBirthdayAuditCardProps {
+  /** Card is rendered for superusers only; anyone else gets nothing. */
+  isSuperuser: boolean;
+  events: CustomerBirthdayAuditEvent[] | null | undefined;
+  /** True while the audited request is in flight: shows a skeleton instead of the empty copy. */
+  loading?: boolean;
+  /** The audited request failed or was blocked: say so instead of showing the empty copy. */
+  error?: boolean;
+}
+
+const BIRTHDAY_EVENT_TYPES: Array<CustomerEventsEnum | null> = [
+  CustomerEventsEnum.DATE_OF_BIRTH_CHANGED,
+  CustomerEventsEnum.DATE_OF_BIRTH_VIEWED,
+];
+
+export const CustomerBirthdayAuditCard = ({
+  isSuperuser,
+  events,
+  loading = false,
+  error = false,
+}: CustomerBirthdayAuditCardProps): JSX.Element | null => {
+  const intl = useIntl();
+
+  if (!isSuperuser) {
+    return null;
+  }
+
+  const birthdayEvents = (events ?? []).filter(event => BIRTHDAY_EVENT_TYPES.includes(event.type));
+
+  return (
+    <DetailSettingsCard
+      data-test-id="customer-birthday-audit"
+      title={intl.formatMessage(messages.title)}
+    >
+      {loading ? (
+        <Skeleton data-test-id="customer-birthday-audit-loading" />
+      ) : error ? (
+        <Text size={2} color="critical1" data-test-id="customer-birthday-audit-unavailable">
+          {intl.formatMessage(messages.unavailable)}
+        </Text>
+      ) : birthdayEvents.length === 0 ? (
+        <Text size={2} color="default2" data-test-id="customer-birthday-audit-empty">
+          {intl.formatMessage(messages.empty)}
+        </Text>
+      ) : (
+        <Box display="flex" flexDirection="column" gap={3} as="ul" margin={0} padding={0}>
+          {birthdayEvents.map(event => (
+            <Box as="li" key={event.id} data-test-id="customer-birthday-audit-event">
+              <Text display="block">
+                {intl.formatMessage(
+                  event.type === CustomerEventsEnum.DATE_OF_BIRTH_CHANGED
+                    ? messages.changed
+                    : messages.viewed,
+                )}
+              </Text>
+              <Text size={2} color="default2" display="block">
+                {event.date ? <DateTime date={event.date} plain /> : null}
+              </Text>
+              <Text size={2} color="default2" display="block">
+                {event.user
+                  ? intl.formatMessage(messages.actor, { email: event.user.email })
+                  : intl.formatMessage(messages.unknownActor)}
+              </Text>
+            </Box>
+          ))}
+        </Box>
+      )}
+    </DetailSettingsCard>
+  );
+};
+
+CustomerBirthdayAuditCard.displayName = "CustomerBirthdayAuditCard";
