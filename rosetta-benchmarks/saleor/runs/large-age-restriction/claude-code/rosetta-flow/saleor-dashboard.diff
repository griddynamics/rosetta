@@ -0,0 +1,37 @@
+export const MINIMUM_AGE_MIN = 1;
+export const MINIMUM_AGE_MAX = 120;
+
+const FALLBACK_TIME_ZONES = ["UTC"];
+
+export function isMinimumAgeValid(value: string): boolean {
+  if (!/^\d+$/.test(value.trim())) {
+    return false;
+  }
+
+  const age = Number(value);
+
+  return age >= MINIMUM_AGE_MIN && age <= MINIMUM_AGE_MAX;
+}
+
+export function isTimeZoneValid(value: string): boolean {
+  return value.trim().length > 0;
+}
+
+/** IANA time zone names; `Intl.supportedValuesOf` is missing in older runtimes (SPECS A-3). */
+export function getTimeZoneNames(current?: string): string[] {
+  let names: string[] = [];
+
+  try {
+    names = typeof Intl.supportedValuesOf === "function" ? Intl.supportedValuesOf("timeZone") : [];
+  } catch {
+    names = [];
+  }
+
+  const all = new Set([...FALLBACK_TIME_ZONES, ...names]);
+
+  if (current) {
+    all.add(current);
+  }
+
+  return Array.from(all).sort();
+}
