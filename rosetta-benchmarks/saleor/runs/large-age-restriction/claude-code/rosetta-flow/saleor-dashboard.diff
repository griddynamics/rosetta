new file mode 100644
index 0000000..80b55fd
--- /dev/null
+++ b/src/products/components/ProductDetailsForm/ProductDetailsForm.test.tsx
@@ -0,0 +1,125 @@
+import { ProductErrorCode, type ProductErrorFragment } from "@dashboard/graphql";
+import { RichTextContext, type RichTextContextValues } from "@dashboard/utils/richText/context";
+import { ThemeProvider } from "@saleor/macaw-ui-next";
+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { useState } from "react";
+import { IntlProvider } from "react-intl";
+
+import { ProductDetailsForm } from "./ProductDetailsForm";
+
+// EditorJS is irrelevant here and noisy in jsdom; the description editor is out of scope.
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditorLoading", () => ({
+  RichTextEditorLoading: () => null,
+}));
+
+const richText: RichTextContextValues = {
+  editorRef: { current: null },
+  defaultValue: undefined,
+  getValue: async () => ({ blocks: [] }),
+  handleChange: jest.fn(),
+  isReadyForMount: false,
+  isDirty: false,
+};
+
+const minimumAgeError = (): ProductErrorFragment => ({
+  __typename: "ProductError",
+  code: ProductErrorCode.INVALID,
+  field: "minimumAge",
+  message: "raw api message",
+});
+
+const Harness = ({
+  initialMinimumAge = null,
+  errors = [],
+  onChange,
+}: {
+  initialMinimumAge?: number | null;
+  errors?: ProductErrorFragment[];
+  onChange: (event: { target: { name: string; value: string } }) => void;
+}) => {
+  const [minimumAge, setMinimumAge] = useState<number | null>(initialMinimumAge);
+
+  return (
+    <IntlProvider locale="en" messages={{}}>
+      <ThemeProvider>
+        <RichTextContext.Provider value={richText}>
+          <ProductDetailsForm
+            data={{
+              description: { blocks: [] },
+              name: "Beer",
+              rating: null,
+              minimumAge,
+            }}
+            errors={errors}
+            onChange={event => {
+              onChange(event);
+              setMinimumAge(event.target.value === "" ? null : Number(event.target.value));
+            }}
+          />
+        </RichTextContext.Provider>
+      </ThemeProvider>
+    </IntlProvider>
+  );
+};
+
+describe("ProductDetailsForm minimum age", () => {
+  it("shows no value and the hint when minimumAge is empty", () => {
+    // Arrange & Act
+    render(<Harness onChange={jest.fn()} />);
+
+    // Assert
+    expect(screen.getByLabelText("Minimum age")).toHaveValue(null);
+    expect(screen.getByText("Leave empty for no age restriction.")).toBeInTheDocument();
+  });
+
+  it("shows the current value when minimumAge is set", () => {
+    // Arrange & Act
+    render(<Harness initialMinimumAge={18} onChange={jest.fn()} />);
+
+    // Assert
+    expect(screen.getByLabelText("Minimum age")).toHaveValue(18);
+  });
+
+  it("calls onChange with the typed value", async () => {
+    // Arrange
+    const onChange = jest.fn();
+
+    render(<Harness onChange={onChange} />);
+
+    // Act
+    await userEvent.type(screen.getByLabelText("Minimum age"), "21");
+
+    // Assert
+    const lastEvent = onChange.mock.calls.at(-1)?.[0];
+
+    expect(lastEvent.target).toMatchObject({ name: "minimumAge", value: "21" });
+    expect(screen.getByLabelText("Minimum age")).toHaveValue(21);
+  });
+
+  it("calls onChange with an empty value when the field is cleared", async () => {
+    // Arrange
+    const onChange = jest.fn();
+
+    render(<Harness initialMinimumAge={21} onChange={onChange} />);
+
+    // Act
+    await userEvent.clear(screen.getByLabelText("Minimum age"));
+
+    // Assert
+    expect(onChange.mock.calls.at(-1)?.[0].target).toMatchObject({
+      name: "minimumAge",
+      value: "",
+    });
+    expect(screen.getByLabelText("Minimum age")).toHaveValue(null);
+  });
+
+  it("displays the INVALID error next to the field instead of the hint", () => {
+    // Arrange & Act
+    render(<Harness initialMinimumAge={0} errors={[minimumAgeError()]} onChange={jest.fn()} />);
+
+    // Assert
+    expect(screen.getByText("Invalid value")).toBeInTheDocument();
+    expect(screen.queryByText("Leave empty for no age restriction.")).not.toBeInTheDocument();
+  });
+});
