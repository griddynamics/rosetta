+      const { rerender } = renderHook(props => useCustomerAuditedDetails(props), {
+        wrapper: clientWrapper(client),
+        initialProps: { id: "u1", isSuperuser: false, includeAgeEligible: true },
+      });
+
+      await act(async () => {
+        await tick(1);
+      });
+
+      // Act
+      rerender({ id: "u1", isSuperuser: true, includeAgeEligible: true });
+      await act(async () => {
+        await tick(1);
+      });
+
+      // Assert
+      expect(query).toHaveBeenCalledTimes(2);
+    });
+
+    it("oscillating the viewer 20 times stays within the cap, and shows data for a key seen before", async () => {
+      // Arrange
+      const client = okClient();
+      const query = (client as never as { query: jest.Mock }).query;
+      const { result, rerender } = renderHook(props => useCustomerAuditedDetails(props), {
+        wrapper: clientWrapper(client),
+        initialProps: { id: "u1", isSuperuser: false, includeAgeEligible: true },
+      });
+
+      // Act
+      for (let i = 0; i < 20; i++) {
+        const isSuperuser = i % 2 === 0;
+
+        rerender({ id: "u1", isSuperuser, includeAgeEligible: true });
+        await act(async () => {
+          await tick(1);
+        });
+      }
+
+      // Assert
+      expect(query.mock.calls.length).toBeLessThanOrEqual(AUDITED_MAX_SENDS_PER_ID);
+      expect(query).toHaveBeenCalledTimes(2);
+      // returned to an already sent key: data is there, not an eternal loading state
+      expect(result.current.loading).toBe(false);
+      expect(result.current.audited).toBeDefined();
+    });
+  });
+});
