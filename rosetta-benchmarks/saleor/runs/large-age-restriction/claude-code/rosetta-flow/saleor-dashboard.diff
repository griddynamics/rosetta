+import { ShopErrorCode } from "@dashboard/graphql";
+import { ThemeProvider } from "@saleor/macaw-ui-next";
+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import type { ReactNode } from "react";
+import { IntlProvider } from "react-intl";
+
+import { AgeRestrictionCard } from "./AgeRestrictionCard";
+import { getTimeZoneNames, isMinimumAgeValid, isTimeZoneValid } from "./utils";
+
+global.ResizeObserver = jest.fn().mockImplementation(() => ({
+  observe: jest.fn(),
+  unobserve: jest.fn(),
+  disconnect: jest.fn(),
+}));
+
+const wrapper = ({ children }: { children: ReactNode }) => (
+  <IntlProvider locale="en" defaultLocale="en">
+    <ThemeProvider>{children}</ThemeProvider>
+  </IntlProvider>
+);
+
+const renderCard = (props: Partial<Parameters<typeof AgeRestrictionCard>[0]> = {}) =>
+  render(
+    <AgeRestrictionCard
+      data={{ timeZone: "Europe/Warsaw", minimumAge: "18" }}
+      errors={[]}
+      disabled={false}
+      onChange={jest.fn()}
+      {...props}
+    />,
+    { wrapper },
+  );
+
+describe("AgeRestrictionCard", () => {
+  it("renders time zone and minimum age values", () => {
+    // Arrange & Act
+    renderCard();
+
+    // Assert
+    expect(screen.getByDisplayValue("Europe/Warsaw")).toBeInTheDocument();
+    expect(screen.getByDisplayValue("18")).toBeInTheDocument();
+  });
+
+  it("submits minimum age changes through onChange", async () => {
+    // Arrange
+    const onChange = jest.fn();
+
+    renderCard({ data: { timeZone: "UTC", minimumAge: "" }, onChange });
+
+    // Act
+    await userEvent.type(screen.getByTestId("age-restriction-minimum-age"), "2");
+
+    // Assert
+    expect(onChange).toHaveBeenCalledWith(
+      expect.objectContaining({ target: expect.objectContaining({ name: "minimumAge" }) }),
+    );
+  });
+
+  it.each(["0", "121", "", "1.5"])("shows a validation error for %p", value => {
+    // Arrange & Act
+    renderCard({ data: { timeZone: "UTC", minimumAge: value } });
+
+    // Assert
+    expect(screen.getByText("Enter a whole number from 1 to 120.")).toBeInTheDocument();
+  });
+
+  it("shows no validation error for a valid age", () => {
+    // Arrange & Act
+    renderCard({ data: { timeZone: "UTC", minimumAge: "120" } });
+
+    // Assert
+    expect(screen.queryByText("Enter a whole number from 1 to 120.")).not.toBeInTheDocument();
+  });
+
+  it("shows a validation error when no time zone is selected", () => {
+    // Arrange & Act
+    renderCard({ data: { timeZone: "", minimumAge: "18" } });
+
+    // Assert
+    expect(screen.getByText("Select a time zone.")).toBeInTheDocument();
+  });
+
+  it("surfaces API INVALID errors on minimumAge", () => {
+    // Arrange & Act
+    renderCard({
+      errors: [
+        { __typename: "ShopError", code: ShopErrorCode.INVALID, field: "minimumAge", message: "x" },
+      ],
+    });
+
+    // Assert
+    expect(
+      screen.getByText("Invalid minimum age. Use a whole number from 1 to 120."),
+    ).toBeInTheDocument();
+  });
+});
+
+describe("age restriction utils", () => {
+  it.each([
+    ["UTC", true],
+    ["", false],
+    ["   ", false],
+  ])("isTimeZoneValid(%p) is %p", (value, expected) => {
+    // Arrange & Act
+    const result = isTimeZoneValid(value);
+
+    // Assert
+    expect(result).toBe(expected);
+  });
+
+  it.each([
+    ["1", true],
+    ["120", true],
+    ["0", false],
+    ["121", false],
+    ["", false],
+    ["abc", false],
+    ["-5", false],
+  ])("isMinimumAgeValid(%p) is %p", (value, expected) => {
+    // Arrange & Act
+    const result = isMinimumAgeValid(value);
+
+    // Assert
+    expect(result).toBe(expected);
+  });
+
+  it("getTimeZoneNames always includes UTC and the current value, sorted and unique", () => {
+    // Arrange & Act
+    const names = getTimeZoneNames("Custom/Zone");
+
+    // Assert
+    expect(names).toContain("UTC");
+    expect(names).toContain("Custom/Zone");
+    expect(names).toEqual([...new Set(names)].sort());
+  });
+});
