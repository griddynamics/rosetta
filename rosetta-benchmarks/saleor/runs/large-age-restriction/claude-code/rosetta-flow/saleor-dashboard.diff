@@ -0,0 +1,383 @@
+import { ApolloProvider } from "@apollo/client";
+import { act, renderHook, waitFor } from "@testing-library/react";
+import { type ReactNode, StrictMode } from "react";
+
+import {
+  AUDITED_MAX_SENDS_OVERALL,
+  AUDITED_MAX_SENDS_PER_ID,
+  AUDITED_WINDOW_MS,
+  resetAuditedSendBudget,
+  useCustomerAuditedDetails,
+} from "./useCustomerAuditedDetails";
+
+const data = { user: { __typename: "User", id: "u1", dateOfBirth: "2000-01-01" } };
+
+const setup = () => {
+  let resolveQuery: (value: unknown) => void = () => undefined;
+  const query = jest.fn(
+    () =>
+      new Promise(resolve => {
+        resolveQuery = resolve;
+      }),
+  );
+  const client = { query } as never;
+  const wrapper = ({ children }: { children: ReactNode }) => (
+    <StrictMode>
+      <ApolloProvider client={client}>{children}</ApolloProvider>
+    </StrictMode>
+  );
+
+  return { query, wrapper, resolve: () => resolveQuery({ data }) };
+};
+
+// Advances the (faked) clock and lets pending promise callbacks run.
+const tick = async (ms: number) => {
+  jest.advanceTimersByTime(ms);
+  await Promise.resolve();
+};
+const okClient = () =>
+  ({
+    query: jest.fn().mockResolvedValue({ data: { user: { __typename: "User", id: "x" } } }),
+  }) as never;
+const clientWrapper = (client: never) => {
+  const Wrapper = ({ children }: { children: ReactNode }) => (
+    <ApolloProvider client={client}>{children}</ApolloProvider>
+  );
+
+  return Wrapper;
+};
+
+describe("useCustomerAuditedDetails", () => {
+  beforeEach(() => {
+    resetAuditedSendBudget();
+  });
+
+  it("sends the request once per key with no-cache, despite StrictMode effect re-runs and re-renders", async () => {
+    // Arrange
+    const { query, wrapper, resolve } = setup();
+    const { result, rerender } = renderHook(props => useCustomerAuditedDetails(props), {
+      wrapper,
+      initialProps: { id: "u1", isSuperuser: true, includeAgeEligible: true },
+    });
+
+    // Act
+    rerender({ id: "u1", isSuperuser: true, includeAgeEligible: true });
+    rerender({ id: "u1", isSuperuser: true, includeAgeEligible: true });
+    expect(result.current.loading).toBe(true);
+    await act(async () => resolve());
+    rerender({ id: "u1", isSuperuser: true, includeAgeEligible: true });
+
+    // Assert
+    expect(query).toHaveBeenCalledTimes(1);
+    expect(query).toHaveBeenCalledWith(
+      expect.objectContaining({
+        fetchPolicy: "no-cache",
+        variables: { id: "u1", isSuperuser: true, includeAgeEligible: true },
+      }),
+    );
+    expect(result.current.audited).toEqual(data.user);
+    expect(result.current.loading).toBe(false);
+  });
+
+  it("never sends when neither superuser nor allowed to read ageEligible", () => {
+    // Arrange
+    const { query, wrapper } = setup();
+
+    // Act
+    const { result, rerender } = renderHook(
+      () =>
+        useCustomerAuditedDetails({
+          id: "u1",
+          isSuperuser: false,
+          includeAgeEligible: false,
+        }),
+      { wrapper },
+    );
+
+    rerender();
+
+    // Assert
+    expect(query).not.toHaveBeenCalled();
+    expect(result.current).toMatchObject({ audited: undefined, loading: false });
+  });
+
+  it("refetchAudited is single-flight: calls while one is in flight share it", async () => {
+    // Arrange
+    const { query, wrapper, resolve } = setup();
+    const { result } = renderHook(
+      () => useCustomerAuditedDetails({ id: "u1", isSuperuser: true, includeAgeEligible: true }),
+      { wrapper },
+    );
+
+    await act(async () => resolve());
+    await waitFor(() => expect(result.current.loading).toBe(false));
+
+    // Act
+    let first: Promise<void> = Promise.resolve();
+    let second: Promise<void> = Promise.resolve();
+
+    act(() => {
+      first = result.current.refetchAudited();
+      second = result.current.refetchAudited();
+    });
+    await act(async () => resolve());
+    await Promise.all([first, second]);
+
+    // Assert
+    expect(query).toHaveBeenCalledTimes(2);
+    expect(result.current.loading).toBe(false);
+
+    // Act - a later explicit call may send again
+    act(() => {
+      void result.current.refetchAudited();
+    });
+    await act(async () => resolve());
+
+    // Assert
+    expect(query).toHaveBeenCalledTimes(3);
+  });
+
+  it("does not retry after a failure and exposes undefined data", async () => {
+    // Arrange
+    const query = jest.fn().mockRejectedValue(new Error("boom"));
+    const wrapper = ({ children }: { children: ReactNode }) => (
+      <ApolloProvider client={{ query } as never}>{children}</ApolloProvider>
+    );
+
+    // Act
+    const { result, rerender } = renderHook(
+      () => useCustomerAuditedDetails({ id: "u1", isSuperuser: true, includeAgeEligible: true }),
+      { wrapper },
