--- /dev/null
+++ b/src/utils/errors/shop.test.ts
@@ -0,0 +1,62 @@
+import { ShopErrorCode } from "@dashboard/graphql";
+import { type IntlShape } from "react-intl";
+
+import getShopErrorMessage from "./shop";
+
+const intl = {
+  formatMessage: ({ defaultMessage }: { defaultMessage: string }) => defaultMessage,
+} as unknown as IntlShape;
+
+describe("getShopErrorMessage", () => {
+  it("returns a specific message for INVALID minimumAge", () => {
+    // Arrange
+    const error = { code: ShopErrorCode.INVALID, field: "minimumAge", message: "raw" };
+
+    // Act
+    const result = getShopErrorMessage(error, intl);
+
+    // Assert
+    expect(result).toBe("Invalid minimum age. Use a whole number from 1 to 120.");
+  });
+
+  it("returns a specific message for INVALID timeZone", () => {
+    // Arrange
+    const error = { code: ShopErrorCode.INVALID, field: "timeZone", message: "raw" };
+
+    // Act
+    const result = getShopErrorMessage(error, intl);
+
+    // Assert
+    expect(result).toBe("Invalid time zone.");
+  });
+
+  it("falls back to the API message for INVALID on other fields", () => {
+    // Arrange
+    const error = { code: ShopErrorCode.INVALID, field: "name", message: "API says no" };
+
+    // Act
+    const result = getShopErrorMessage(error, intl);
+
+    // Assert
+    expect(result).toBe("API says no");
+  });
+
+  it("keeps the ALREADY_EXISTS message", () => {
+    // Arrange
+    const error = { code: ShopErrorCode.ALREADY_EXISTS, field: null, message: null };
+
+    // Act
+    const result = getShopErrorMessage(error, intl);
+
+    // Assert
+    expect(result).toBe("Authorization key with this type already exists");
+  });
+
+  it("returns undefined without an error", () => {
+    // Arrange & Act
+    const result = getShopErrorMessage(undefined, intl);
+
+    // Assert
+    expect(result).toBeUndefined();
+  });
+});
