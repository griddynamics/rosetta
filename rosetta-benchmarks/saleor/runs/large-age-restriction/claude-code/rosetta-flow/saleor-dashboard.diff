+}));
+
+const mockedQuery = useCustomerDetailsQuery as unknown as jest.Mock;
+const mockedAudited = useCustomerAuditedDetails as unknown as jest.Mock;
+const refetchAudited = jest.fn();
+
+const bootstrap = {
+  user: {
+    id: "u1",
+    kpiOrderChannels: {
+      edges: [{ node: { channel: { id: "c1", name: "C", currencyCode: "USD" } } }],
+    },
+  },
+};
+const scoped = { user: { id: "u1", orders: { totalCount: 3 } } };
+const audited = { id: "u1", dateOfBirth: "2000-01-01", ageEligible: true, events: [{ id: "e1" }] };
+
+const wrapper = ({ children }: { children: ReactNode }) => (
+  <CustomerDetailsProvider id="u1">{children}</CustomerDetailsProvider>
+);
+
+describe("CustomerDetailsProvider age data", () => {
+  beforeEach(() => {
+    mockedQuery.mockReset();
+    mockedAudited.mockReset();
+    mockedAudited.mockReturnValue({ audited, loading: false, refetchAudited });
+    mockedQuery.mockImplementation(((options: {
+      variables: { includeKpiOrderCount: boolean };
