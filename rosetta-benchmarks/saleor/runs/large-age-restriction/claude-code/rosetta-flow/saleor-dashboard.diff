+    expect(variables.length).toBeGreaterThan(0);
+    variables.forEach(v => {
+      expect(v).not.toHaveProperty("isSuperuser");
+      expect(v).not.toHaveProperty("includeAgeEligible");
+    });
+  });
+
+  it("feeds the audited hook with the viewer's superuser flag and eligibility access", () => {
+    // Arrange & Act
+    renderHook(() => useContext(CustomerDetailsContext), { wrapper });
+
+    // Assert
+    expect(mockedAudited).toHaveBeenCalledWith({
+      id: "u1",
+      isSuperuser: true,
+      includeAgeEligible: true,
+    });
+  });
+
+  it("exposes the audited result without merging it into the customer", () => {
+    // Arrange & Act
+    const { result } = renderHook(() => useContext(CustomerDetailsContext), { wrapper });
+
+    // Assert
+    expect(result.current?.audited).toBe(audited);
+    expect(result.current?.refetchAudited).toBe(refetchAudited);
+    expect(result.current?.customer?.user).toMatchObject({ orders: { totalCount: 3 } });
+    expect(result.current?.customer?.user).not.toHaveProperty("dateOfBirth");
+  });
+});
