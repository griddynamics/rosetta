@@ -0,0 +1,243 @@
+import { useApolloClient } from "@apollo/client";
+import {
+  CustomerAuditedDetailsDocument,
+  type CustomerAuditedDetailsQuery,
+  type CustomerAuditedDetailsQueryVariables,
+} from "@dashboard/graphql";
+import { useCallback, useEffect, useRef, useState } from "react";
+
+export type CustomerAuditedDetails = NonNullable<CustomerAuditedDetailsQuery["user"]>;
+
+/**
+ * Hard send budget. Every audited read writes a "date of birth viewed" audit row, so even a bug
+ * elsewhere (a new sender, a dependency churn we did not foresee) must not be able to write rows
+ * without bound. The budget is module level (shared by every mount of the hook in the page session)
+ * and counts explicit refetches too.
+ */
+export const AUDITED_WINDOW_MS = 60_000;
+export const AUDITED_MAX_SENDS_PER_ID = 3;
+export const AUDITED_MAX_SENDS_OVERALL = 10;
+
+const sendsById = new Map<string, number[]>();
+let sendsOverall: number[] = [];
+const warnedAtById = new Map<string, number>();
+let warnedOverallAt: number | null = null;
+
+const recent = (stamps: number[], now: number) => stamps.filter(at => now - at < AUDITED_WINDOW_MS);
+
+/** Test helper: forget every recorded send. */
+export const resetAuditedSendBudget = (): void => {
+  sendsById.clear();
+  sendsOverall = [];
+  warnedAtById.clear();
+  warnedOverallAt = null;
+};
+
+/** Counts only: never a birthday, an event or anything but the customer id the page URL has. */
+const warnOncePerWindow = (
+  customerId: string | null,
+  now: number,
+  perId: number,
+  overall: number,
+) => {
+  if (customerId === null) {
+    if (warnedOverallAt !== null && now - warnedOverallAt < AUDITED_WINDOW_MS) {
+      return;
+    }
+
+    warnedOverallAt = now;
+  } else {
+    const warnedAt = warnedAtById.get(customerId);
+
+    if (warnedAt !== undefined && now - warnedAt < AUDITED_WINDOW_MS) {
+      return;
+    }
+
+    warnedAtById.set(customerId, now);
+  }
+
+  // eslint-disable-next-line no-console
+  console.warn("Customer audited request blocked by the send budget", {
+    customerId,
+    sentForCustomerInWindow: perId,
+    sentOverallInWindow: overall,
+    maxPerCustomer: AUDITED_MAX_SENDS_PER_ID,
+    maxOverall: AUDITED_MAX_SENDS_OVERALL,
+    windowSeconds: AUDITED_WINDOW_MS / 1000,
+  });
+};
+
+/** Reserves one send. False (and one counts-only warning per window) when a cap is reached. */
+const reserveSend = (customerId: string): boolean => {
+  const now = Date.now();
+  const forId = recent(sendsById.get(customerId) ?? [], now);
+
+  sendsOverall = recent(sendsOverall, now);
+
+  if (forId.length >= AUDITED_MAX_SENDS_PER_ID) {
+    sendsById.set(customerId, forId);
+    warnOncePerWindow(customerId, now, forId.length, sendsOverall.length);
+
+    return false;
+  }
+
+  if (sendsOverall.length >= AUDITED_MAX_SENDS_OVERALL) {
+    sendsById.set(customerId, forId);
+    warnOncePerWindow(null, now, forId.length, sendsOverall.length);
+
+    return false;
+  }
+
+  sendsById.set(customerId, [...forId, now]);
+  sendsOverall.push(now);
+
+  return true;
+};
+
+interface UseCustomerAuditedDetailsArgs {
+  id: string;
+  /** Superusers read dateOfBirth and the audit events. */
+  isSuperuser: boolean;
+  /** Superusers and MANAGE_USERS staff read ageEligible. */
+  includeAgeEligible: boolean;
+}
+
+export interface UseCustomerAuditedDetailsResult {
+  /**
+   * undefined while loading, when nothing is readable by the viewer, or when no request ever
+   * succeeded. A failed explicit refetch keeps the last good value.
+   */
+  audited: CustomerAuditedDetails | undefined;
+  loading: boolean;
+  /**
+   * The latest audited attempt for this key failed or was blocked by the send budget, for a viewer
+   * who should have the data. The UI must show "unavailable", not an empty birthday, and must not
+   * let the viewer overwrite a birthday they could not see.
+   */
+  error: boolean;
+  /**
+   * The ONLY way to send the audited request again (e.g. after a birthday was saved).
+   * Single-flight: calls made while a request for the same key is in flight share that request.
+   * Counts against the send budget; never rejects.
+   */
+  refetchAudited: () => Promise<void>;
+}
+
+interface Result {
+  data: CustomerAuditedDetails | undefined;
+  failed: boolean;
+}
+
+/**
+ * Reads the side-effecting fields (dateOfBirth, audit events, ageEligible). Every such read writes
+ * a "date of birth viewed" audit row, so the request must never be re-triggerable by React or Apollo.
+ *
+ * Guarantees, by construction:
+ *  - the request is imperative (`client.query`), not an observer, so cache broadcasts, re-renders,
+ *    `refetchQueries`, entity refresh and polling cannot execute it;
+ *  - `fetchPolicy: "no-cache"`: the result never enters the normalized cache;
+ *  - a ref keyed by customer id + eligibility inputs records every key already sent, so effect
+ *    re-runs (StrictMode, dependency churn, remounted children) cannot send it twice;
+ *  - failures are not retried;
+ *  - hard cap: at most AUDITED_MAX_SENDS_PER_ID sends per customer id and AUDITED_MAX_SENDS_OVERALL
+ *    sends overall per rolling AUDITED_WINDOW_MS, explicit refetches included. Beyond it nothing is
+ *    sent and the call resolves with no data (`error: true`).
+ */
+export const useCustomerAuditedDetails = ({
+  id,
+  isSuperuser,
+  includeAgeEligible,
+}: UseCustomerAuditedDetailsArgs): UseCustomerAuditedDetailsResult => {
+  const client = useApolloClient();
+  const enabled = isSuperuser || includeAgeEligible;
+  const key = enabled ? `${id}|${isSuperuser}|${includeAgeEligible}` : null;
+
+  const sentKeys = useRef<Set<string>>(new Set());
+  const inFlight = useRef<{ key: string; promise: Promise<void> } | null>(null);
+  const mounted = useRef(true);
+  const [results, setResults] = useState<Record<string, Result>>({});
+  const [refetching, setRefetching] = useState(false);
+
+  useEffect(function trackMounted() {
+    mounted.current = true;
+
+    return () => {
+      mounted.current = false;
+    };
+  }, []);
+
+  const send = useCallback(
+    (requestKey: string, variables: CustomerAuditedDetailsQueryVariables): Promise<void> => {
+      const settle = (data: CustomerAuditedDetails | undefined, failed: boolean) => {
+        if (inFlight.current?.key === requestKey) {
+          inFlight.current = null;
+        }
+
+        if (mounted.current) {
+          // A failed attempt keeps the last good data for this key.
+          setResults(previous => ({
+            ...previous,
+            [requestKey]: { data: failed ? previous[requestKey]?.data : data, failed },
+          }));
+          setRefetching(false);
+        }
+      };
+
+      const request: Promise<void> = reserveSend(variables.id)
+        ? client
+            .query<CustomerAuditedDetailsQuery, CustomerAuditedDetailsQueryVariables>({
+              query: CustomerAuditedDetailsDocument,
+              variables,
+              fetchPolicy: "no-cache",
+            })
+            .then(
+              result => ({ data: result.data?.user ?? undefined, failed: !result.data?.user }),
+              () => ({ data: undefined, failed: true }),
+            )
+            .then(({ data, failed }) => settle(data, failed))
+        : Promise.resolve().then(() => settle(undefined, true));
+
+      inFlight.current = { key: requestKey, promise: request };
+
+      return request;
+    },
+    [client],
+  );
+
+  useEffect(
+    function loadAuditedDetailsOncePerKey() {
+      if (!key || sentKeys.current.has(key)) {
+        return;
+      }
+
+      sentKeys.current.add(key);
+      void send(key, { id, isSuperuser, includeAgeEligible });
+    },
+    // `send` is stable per client; the key already encodes every input.
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+    [key],
+  );
+
+  const refetchAudited = useCallback((): Promise<void> => {
+    if (!key) {
+      return Promise.resolve();
+    }
+
+    if (inFlight.current?.key === key) {
+      return inFlight.current.promise;
+    }
+
+    setRefetching(true);
+
+    return send(key, { id, isSuperuser, includeAgeEligible });
+  }, [key, id, isSuperuser, includeAgeEligible, send]);
+
+  const current = key ? results[key] : undefined;
+
+  return {
+    audited: current?.data,
+    loading: Boolean(key) && (current === undefined || refetching),
+    error: Boolean(key) && current?.failed === true && !refetching,
+    refetchAudited,
+  };
+};
