+++ b/src/customers/queries.test.ts
@@ -0,0 +1,83 @@
+import { type DocumentNode, Kind, print, visit } from "graphql";
+
+import * as fragments from "../fragments/customers";
+import * as mutations from "./mutations";
+import { customerAuditedDetails, customerDetails, customerList } from "./queries";
+
+const AGE_FIELDS = ["dateOfBirth", "ageEligible", "events"];
+
+const isDocumentNode = (value: unknown): value is DocumentNode =>
+  typeof value === "object" && value !== null && (value as DocumentNode).kind === Kind.DOCUMENT;
+
+const documentsOf = (module: Record<string, unknown>): Array<[string, DocumentNode]> =>
+  Object.entries(module).filter((entry): entry is [string, DocumentNode] =>
+    isDocumentNode(entry[1]),
+  );
+
+const selectedFieldNames = (document: DocumentNode): string[] => {
+  const names: string[] = [];
+
+  visit(document, {
+    Field(node) {
+      names.push(node.name.value);
+    },
+  });
+
+  return names;
+};
+
+describe("customer GraphQL documents, age fields placement", () => {
+  it("ListCustomers selects none of dateOfBirth/ageEligible/events", () => {
+    // Arrange
+    const names = selectedFieldNames(customerList);
+
+    // Act & Assert
+    AGE_FIELDS.forEach(field => expect(names).not.toContain(field));
+  });
+
+  it.each(documentsOf(fragments))("fragments/customers.ts %s selects none of them", (_, doc) => {
+    // Arrange
+    const names = selectedFieldNames(doc);
+
+    // Act & Assert
+    AGE_FIELDS.forEach(field => expect(names).not.toContain(field));
+  });
+
+  it.each(documentsOf(mutations))("customer mutation %s selects none of them", (_, doc) => {
+    // Arrange
+    const names = selectedFieldNames(doc);
+
+    // Act & Assert
+    AGE_FIELDS.forEach(field => expect(names).not.toContain(field));
+  });
+
+  it("CustomerDetails (the main query) selects none of them and has no audit variables", () => {
+    // Arrange
+    const names = selectedFieldNames(customerDetails);
+    const printed = print(customerDetails);
+
+    // Act & Assert
+    AGE_FIELDS.forEach(field => expect(names).not.toContain(field));
+    expect(printed).not.toContain("$isSuperuser");
+    expect(printed).not.toContain("$includeAgeEligible");
+  });
+
+  it("CustomerAuditedDetails is the only document selecting them, gated and locked to main", () => {
+    // Arrange
+    const printed = print(customerAuditedDetails);
+
+    // Act & Assert
+    expect(printed).toContain("$isSuperuser: Boolean!");
+    expect(printed).toMatch(/\bid @include\(if: \$isSuperuser\)/);
+    expect(printed).toContain('dateOfBirth @include(if: $isSuperuser) @lockSchema(schema: "main")');
+    expect(printed).toMatch(
+      /events @include\(if: \$isSuperuser\) @lockSchema\(schema: "main"\) \{\s+id\s+type\s+date\s+user \{\s+email\s+\}\s+\}/,
+    );
+    expect(printed).toContain("$includeAgeEligible: Boolean!");
+    expect(printed).toContain(
+      'ageEligible @include(if: $includeAgeEligible) @lockSchema(schema: "main")',
+    );
+    // An unlocked field keeps both variables used on the staging schema.
+    expect(printed).toMatch(/__typename @include\(if: \$includeAgeEligible\)/);
+  });
+});
