--- /dev/null
+++ b/src/customers/views/CustomerDetails.requestLoop.test.tsx
@@ -0,0 +1,444 @@
+import { ApolloProvider } from "@apollo/client";
+import { apolloClient } from "@dashboard/graphql/client";
+import Wrapper from "@test/wrapper";
+import { act, fireEvent, render, screen, waitFor } from "@testing-library/react";
+import { StrictMode } from "react";
+import { MemoryRouter } from "react-router-dom";
+
+import { resetAuditedSendBudget } from "../hooks/useCustomerAuditedDetails";
+import { FakeServer, USER_ID } from "../testUtils/FakeCustomerServer";
+import CustomerDetailsView from "./CustomerDetails";
+
+// AC-90. Mounts the REAL customer details view (view + provider + hooks + page + consumers) on the
+// dashboard's real Apollo client and cache. Only environment edges are mocked (auth, permissions,
+// app state, navigation, notifier, analytics, extension registry, reference search, savebar,
+// heavy unrelated cards). The "server" is an in-process counting link that appends a
+// DATE_OF_BIRTH_VIEWED event for every request that selects dateOfBirth/ageEligible.
+const mockUser: {
+  user: { isSuperuser: boolean; userPermissions?: Array<{ code: string }> };
+  logout: jest.Mock;
+} = { user: { isSuperuser: true }, logout: jest.fn() };
