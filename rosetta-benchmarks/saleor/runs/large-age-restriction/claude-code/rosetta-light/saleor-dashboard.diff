+import {
+  getAgeRestrictionShopInput,
+  getTimeZoneOptions,
+  isValidMinimumAge,
+} from "./ageRestriction";
+
+describe("isValidMinimumAge", () => {
+  it.each([
+    ["1", true],
+    ["18", true],
+    ["120", true],
+    [" 21 ", true],
+    ["0", false],
+    ["121", false],
+    ["-1", false],
+    ["1.5", false],
+    ["1e2", false],
+    ["abc", false],
+    ["", false],
+    ["   ", false],
+  ])("treats minimum age %p as valid: %p", (value, valid) => {
+    // Arrange & Act
+    const result = isValidMinimumAge(value);
+
+    // Assert
+    expect(result).toBe(valid);
+  });
+});
+
+describe("getTimeZoneOptions", () => {
+  it("always offers UTC and keeps the options unique and sorted", () => {
+    // Arrange & Act
+    const options = getTimeZoneOptions("Europe/Warsaw");
+    const values = options.map(option => option.value);
+
+    // Assert
+    expect(values).toContain("UTC");
+    expect(values).toContain("Europe/Warsaw");
+    expect(new Set(values).size).toBe(values.length);
+    expect(values).toEqual([...values].sort());
+  });
+
+  it("keeps a current value that the runtime does not list", () => {
+    // Arrange & Act
+    const values = getTimeZoneOptions("Mars/Base").map(option => option.value);
+
+    // Assert
+    expect(values).toContain("Mars/Base");
+  });
+
+  it("falls back to UTC plus the current value when Intl.supportedValuesOf is missing", () => {
+    // Arrange
+    const original = Intl.supportedValuesOf;
+
+    (Intl as { supportedValuesOf?: unknown }).supportedValuesOf = undefined;
+
+    try {
+      // Act
+      const values = getTimeZoneOptions("Europe/Warsaw").map(option => option.value);
+
+      // Assert
+      expect(values).toEqual(["Europe/Warsaw", "UTC"]);
+    } finally {
+      Intl.supportedValuesOf = original;
+    }
+  });
+});
+
+describe("getAgeRestrictionShopInput", () => {
+  const data = { ageRestrictionMinimumAge: " 21 ", timeZone: "Europe/Warsaw" };
+
+  it("maps the form values to the shop settings input on the main schema", () => {
+    // Arrange & Act
+    const input = getAgeRestrictionShopInput(data, true);
+
+    // Assert
+    expect(input).toEqual({ ageRestrictionMinimumAge: 21, timeZone: "Europe/Warsaw" });
+  });
+
+  it("sends nothing when the active schema has no age restriction fields", () => {
+    // Arrange & Act
+    const input = getAgeRestrictionShopInput(data, false);
+
+    // Assert
+    expect(input).toEqual({});
+  });
+});
