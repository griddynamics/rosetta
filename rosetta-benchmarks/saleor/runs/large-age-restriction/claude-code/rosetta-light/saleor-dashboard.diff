index 0000000..249e127
--- /dev/null
+++ b/src/siteSettings/components/SiteSettingsPage/ageRestriction.ts
@@ -0,0 +1,57 @@
+import { type ShopSettingsInput } from "@dashboard/graphql";
+
+export const AGE_RESTRICTION_MIN_AGE = 1;
+export const AGE_RESTRICTION_MAX_AGE = 120;
+
+export interface AgeRestrictionFormData {
+  ageRestrictionMinimumAge: string;
+  timeZone: string;
+}
+
+/** Whole number from 1 to 120, ignoring surrounding spaces. Server remains the source of truth. */
+export const isValidMinimumAge = (value: string): boolean => {
+  const trimmed = value.trim();
+
+  if (!/^\d+$/.test(trimmed)) {
+    return false;
+  }
+
+  const age = Number(trimmed);
+
+  return age >= AGE_RESTRICTION_MIN_AGE && age <= AGE_RESTRICTION_MAX_AGE;
+};
+
+/**
+ * IANA time zones for the select. `UTC` is always offered, and the current value is kept
+ * even when the runtime does not list it. Runtimes without `Intl.supportedValuesOf` only get
+ * `UTC` plus the current value.
+ */
+export const getTimeZoneOptions = (current: string): Array<{ label: string; value: string }> => {
+  const supported: string[] =
+    typeof Intl.supportedValuesOf === "function" ? Intl.supportedValuesOf("timeZone") : [];
+  const zones = new Set<string>(["UTC", ...supported]);
+
+  if (current) {
+    zones.add(current);
+  }
+
+  return [...zones].sort().map(zone => ({ label: zone, value: zone }));
+};
+
+/**
+ * Shop settings fields for the age restriction section. Returns nothing when the active schema
+ * does not know these fields (staging), so the mutation variables stay valid there.
+ */
+export const getAgeRestrictionShopInput = (
+  data: AgeRestrictionFormData,
+  supportsAgeRestriction: boolean,
+): Pick<ShopSettingsInput, "ageRestrictionMinimumAge" | "timeZone"> => {
+  if (!supportsAgeRestriction) {
+    return {};
+  }
+
+  return {
+    ageRestrictionMinimumAge: Number(data.ageRestrictionMinimumAge.trim()),
+    timeZone: data.timeZone,
+  };
+};
