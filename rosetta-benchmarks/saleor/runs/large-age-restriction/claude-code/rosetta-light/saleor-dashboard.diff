+import { type AvailableColumn } from "@dashboard/components/Datagrid/types";
+import { type GridCell } from "@glideapps/glide-data-grid";
+import { type DefaultTheme } from "@saleor/macaw-ui-next";
+import { testIntlInstance } from "@test/intl";
+
+import { createGetCellContent } from "./datagrid";
+
+jest.mock("@dashboard/graphql/schemaVersion", () => ({
+  isMainSchema: (): boolean => false,
+}));
+
+type ListProducts = Parameters<typeof createGetCellContent>[0]["products"];
+
+describe("product list name cell age label on the staging schema", () => {
+  it("shows no age label, because the flag is locked to the main schema", () => {
+    const getContent = createGetCellContent({
+      columns: [{ id: "name" } as AvailableColumn],
+      products: [
+        { id: "product-1", name: "Whisky", isAgeRestricted: true, thumbnail: null },
+      ] as unknown as ListProducts,
+      intl: testIntlInstance,
+      theme: {} as DefaultTheme,
+      locale: "en" as never,
+    });
+
+    const cell = getContent([0, 0], {
+      changes: { current: [] },
+      getChangeIndex: () => -1,
+      added: [],
+      removed: [],
+    } as never) as GridCell & { data: { name: string; badge?: string } };
+
+    expect(cell.data.name).toBe("Whisky");
+    expect(cell.data.badge).toBeUndefined();
+  });
+});
diff --git a/src/products/components/ProductListDatagrid/datagrid.ageRestriction.test.ts b/src/products/components/ProductListDatagrid/datagrid.ageRestriction.test.ts
