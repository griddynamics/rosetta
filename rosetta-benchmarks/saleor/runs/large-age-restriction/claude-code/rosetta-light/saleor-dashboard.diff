+export const AgeRestrictionFields = ({
+  data,
+  disabled,
+  errors,
+  onChange,
+}: AgeRestrictionFieldsProps): React.ReactNode => {
+  const intl = useIntl();
+  const formErrors = getFormErrors(["ageRestrictionMinimumAge", "timeZone"], errors);
+  // Client check mirrors the server rule. Skipped while the shop is loading (disabled).
+  const ageInvalid = !disabled && !isValidMinimumAge(data.ageRestrictionMinimumAge);
+  const ageHelperText = ageInvalid
+    ? intl.formatMessage(messages.ageRestrictionMinimumAgeInvalid)
+    : (getShopErrorMessage(formErrors.ageRestrictionMinimumAge, intl) ??
+      intl.formatMessage(messages.ageRestrictionMinimumAgeHint));
+
+  return (
+    <Box display="flex" flexDirection="column" gap={5}>
+      <Input
+        data-test-id="age-restriction-minimum-age-input"
+        name="ageRestrictionMinimumAge"
+        type="number"
+        inputMode="numeric"
+        min={AGE_RESTRICTION_MIN_AGE}
+        max={AGE_RESTRICTION_MAX_AGE}
+        step={1}
+        label={intl.formatMessage(messages.ageRestrictionMinimumAgeLabel)}
+        value={data.ageRestrictionMinimumAge}
+        disabled={disabled}
+        error={ageInvalid || !!formErrors.ageRestrictionMinimumAge}
+        helperText={ageHelperText}
+        onChange={onChange}
+      />
+      <Select
+        data-test-id="age-restriction-time-zone-select"
+        name="timeZone"
+        label={intl.formatMessage(messages.ageRestrictionTimeZoneLabel)}
+        options={getTimeZoneOptions(data.timeZone)}
+        value={data.timeZone}
+        disabled={disabled}
+        error={!!formErrors.timeZone}
+        helperText={
+          getShopErrorMessage(formErrors.timeZone, intl) ??
+          intl.formatMessage(messages.ageRestrictionTimeZoneHint)
+        }
+        onChange={onChange}
+      />
+    </Box>
+  );
+};
