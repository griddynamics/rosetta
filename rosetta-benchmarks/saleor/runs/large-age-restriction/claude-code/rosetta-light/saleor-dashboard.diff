@@ -0,0 +1,58 @@
+import { OrderErrorCode, type OrderErrorFragment } from "@dashboard/graphql";
+import { createIntl } from "react-intl";
+
+import getOrderErrorMessage from "./order";
+
+const intl = createIntl({ locale: "en", messages: {} });
+
+const orderError = (code: OrderErrorCode, message: string | null = null): OrderErrorFragment => ({
+  __typename: "OrderError",
+  addressType: null,
+  code,
+  field: null,
+  message,
+  orderLines: null,
+});
+
+describe("getOrderErrorMessage", () => {
+  it("maps AGE_RESTRICTION_NOT_ELIGIBLE to the customer eligibility copy", () => {
+    // Arrange // Act
+    const message = getOrderErrorMessage(
+      orderError(OrderErrorCode.AGE_RESTRICTION_NOT_ELIGIBLE),
+      intl,
+    );
+
+    // Assert
+    expect(message).toBe("Customer is not eligible to buy age-restricted products");
+  });
+
+  it("does not echo the API message for AGE_RESTRICTION_NOT_ELIGIBLE", () => {
+    // Arrange // Act
+    const message = getOrderErrorMessage(
+      orderError(
+        OrderErrorCode.AGE_RESTRICTION_NOT_ELIGIBLE,
+        "The customer is not eligible to buy age-restricted products.",
+      ),
+      intl,
+    );
+
+    // Assert
+    expect(message).toBe("Customer is not eligible to buy age-restricted products");
+  });
+
+  it("keeps the existing mapping for other order codes", () => {
+    // Arrange // Act
+    const message = getOrderErrorMessage(orderError(OrderErrorCode.NOT_EDITABLE), intl);
+
+    // Assert
+    expect(message).toBe("Only draft orders can be edited");
+  });
+
+  it("returns undefined when there is no error", () => {
+    // Arrange // Act
+    const message = getOrderErrorMessage(undefined, intl);
+
+    // Assert
+    expect(message).toBeUndefined();
+  });
+});
