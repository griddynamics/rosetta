@@ -0,0 +1,162 @@
+import { AccountErrorCode, type AccountErrorFragment } from "@dashboard/graphql";
+import Wrapper from "@test/wrapper";
+import { fireEvent, render, type RenderResult, screen } from "@testing-library/react";
+import { type ChangeEvent } from "react";
+
+import { CustomerAgeCard } from "./CustomerAgeCard";
+
+type CardChangeHandler = (event: ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => void;
+
+const renderCard = (
+  props: Partial<Parameters<typeof CustomerAgeCard>[0]> = {},
+): RenderResult & { onChange: CardChangeHandler } => {
+  const onChange = props.onChange ?? jest.fn();
+  const utils = render(
+    <Wrapper>
+      <CustomerAgeCard
+        birthday=""
+        canEditBirthday={false}
+        disabled={false}
+        eligible={null}
+        errors={[]}
+        onChange={onChange}
+        {...props}
+      />
+    </Wrapper>,
+  );
+
+  return { ...utils, onChange };
+};
+
+const getBirthdayInput = (): HTMLInputElement =>
+  screen.getByTestId("customer-birthday") as HTMLInputElement;
+
+describe("CustomerAgeCard", () => {
+  describe("superuser (canEditBirthday)", () => {
+    it("shows the date of birth as an editable date input with the saved value", () => {
+      // Arrange & Act
+      renderCard({ birthday: "1990-05-01", canEditBirthday: true, eligible: true });
+
+      // Assert
+      const input = getBirthdayInput();
+
+      expect(input).toHaveAttribute("type", "date");
+      expect(input).toHaveValue("1990-05-01");
+      expect(input).not.toBeDisabled();
+    });
+
+    it("shows the date input even when the eligibility flag is null", () => {
+      // Arrange & Act
+      renderCard({ birthday: "", canEditBirthday: true, eligible: null });
+
+      // Assert
+      expect(getBirthdayInput()).toBeInTheDocument();
+      expect(screen.queryByTestId("customer-age-eligibility")).not.toBeInTheDocument();
+    });
+
+    it("also shows the Yes/No eligibility flag when it is visible", () => {
+      // Arrange & Act
+      renderCard({ birthday: "1990-05-01", canEditBirthday: true, eligible: false });
+
+      // Assert
+      expect(screen.getByTestId("customer-age-eligibility")).toHaveTextContent("No");
+    });
+
+    it("reports a changed value through onChange", () => {
+      // Arrange
+      // Read the value inside the handler: the input is controlled by the parent, so React
+      // resets it once the handler returns.
+      const reported: Array<{ name: string; value: string }> = [];
+      const onChange = jest.fn((event: { target: { name: string; value: string } }) => {
+        reported.push({ name: event.target.name, value: event.target.value });
+      });
+
+      renderCard({ birthday: "", canEditBirthday: true, onChange });
+
+      // Act
+      fireEvent.change(getBirthdayInput(), { target: { value: "1995-03-04" } });
+
+      // Assert
+      expect(onChange).toHaveBeenCalledTimes(1);
+      expect(reported).toEqual([{ name: "birthday", value: "1995-03-04" }]);
+    });
+
+    it("disables the date input while the form is disabled", () => {
+      // Arrange & Act
+      renderCard({ birthday: "1990-05-01", canEditBirthday: true, disabled: true });
+
+      // Assert
+      expect(getBirthdayInput()).toBeDisabled();
+    });
+
+    it("shows the localized copy for an INVALID birthday instead of the token message", () => {
+      // Arrange
+      const errors: AccountErrorFragment[] = [
+        {
+          __typename: "AccountError",
+          code: AccountErrorCode.INVALID,
+          field: "birthday",
+          message: "Invalid birthday.",
+          addressType: null,
+          attributes: null,
+        },
+      ];
+
+      // Act
+      renderCard({ birthday: "2999-01-01", canEditBirthday: true, errors });
+
+      // Assert
+      expect(screen.getByText("Enter a valid date of birth")).toBeInTheDocument();
+      expect(screen.queryByText(/invalid or expired token/i)).not.toBeInTheDocument();
+    });
+  });
+
+  describe("MANAGE_USERS staff (flag only)", () => {
+    it("shows the Yes flag when the customer is eligible", () => {
+      // Arrange & Act
+      renderCard({ eligible: true });
+
+      // Assert
+      expect(screen.getByTestId("customer-age-eligibility")).toHaveTextContent(
+        "Eligible for age-restricted products",
+      );
+      expect(screen.getByTestId("customer-age-eligibility")).toHaveTextContent("Yes");
+    });
+
+    it("shows the No flag when the customer is not eligible", () => {
+      // Arrange & Act
+      renderCard({ eligible: false });
+
+      // Assert
+      expect(screen.getByTestId("customer-age-eligibility")).toHaveTextContent("No");
+    });
+
+    it("never renders the date input", () => {
+      // Arrange & Act
+      renderCard({ birthday: "1990-05-01", canEditBirthday: false, eligible: true });
+
+      // Assert
+      expect(screen.queryByTestId("customer-birthday")).not.toBeInTheDocument();
+      expect(screen.queryByText("1990-05-01")).not.toBeInTheDocument();
+    });
+  });
+
+  describe("no visible value (null)", () => {
+    it("renders no card when the flag is null and the user is not a superuser", () => {
+      // Arrange & Act
+      renderCard({ eligible: null, canEditBirthday: false });
+
+      // Assert
+      expect(screen.queryByTestId("customer-age-card")).not.toBeInTheDocument();
+      expect(screen.queryByTestId("customer-birthday")).not.toBeInTheDocument();
+    });
+
+    it("renders no card when the flag is undefined (staging build) and not a superuser", () => {
+      // Arrange & Act
+      renderCard({ eligible: undefined, canEditBirthday: false });
+
+      // Assert
+      expect(screen.queryByTestId("customer-age-card")).not.toBeInTheDocument();
+    });
+  });
+});
