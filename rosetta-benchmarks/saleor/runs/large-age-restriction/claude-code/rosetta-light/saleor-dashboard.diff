@@ -0,0 +1,94 @@
+import { DetailSettingsCard } from "@dashboard/components/DetailSettingsCard/DetailSettingsCard";
+import { AccountErrorCode, type AccountErrorFragment } from "@dashboard/graphql";
+import { commonMessages } from "@dashboard/intl";
+import { getFormErrors } from "@dashboard/utils/errors";
+import getAccountErrorMessage from "@dashboard/utils/errors/account";
+import { Box, Input, Text } from "@saleor/macaw-ui-next";
+import { type ChangeEvent } from "react";
+import { useIntl } from "react-intl";
+
+import { messages } from "./messages";
+
+interface CustomerAgeCardProps {
+  /** Form value, `YYYY-MM-DD` or empty. Only rendered for superusers. */
+  birthday: string;
+  /** `me.isSuperuser === true` on the current staff user. */
+  canEditBirthday: boolean;
+  disabled: boolean;
+  /** `customer.isAgeEligible`; `null` or `undefined` means the value is not visible to this user. */
+  eligible: boolean | null | undefined;
+  errors: AccountErrorFragment[];
+  onChange: (event: ChangeEvent<HTMLInputElement | HTMLTextAreaElement>) => void;
+}
+
+/** Local calendar day as `YYYY-MM-DD`, used only as the `max` hint. The server validates. */
+const getLocalTodayHint = (): string => {
+  const now = new Date();
+  const pad = (value: number): string => String(value).padStart(2, "0");
+
+  return `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
+};
+
+export const CustomerAgeCard = ({
+  birthday,
+  canEditBirthday,
+  disabled,
+  eligible,
+  errors,
+  onChange,
+}: CustomerAgeCardProps): JSX.Element | null => {
+  const intl = useIntl();
+  const hasEligibility = eligible !== null && eligible !== undefined;
+
+  // Nothing to show: neither the flag nor the date is visible to this user.
+  if (!canEditBirthday && !hasEligibility) {
+    return null;
+  }
+
+  const birthdayError = getFormErrors(["birthday"], errors).birthday;
+  const birthdayHelperText = birthdayError
+    ? birthdayError.code === AccountErrorCode.INVALID
+      ? intl.formatMessage(messages.invalidBirthday)
+      : getAccountErrorMessage(birthdayError, intl)
+    : undefined;
+
+  return (
+    <DetailSettingsCard data-test-id="customer-age-card" title={intl.formatMessage(messages.title)}>
+      <Box display="flex" flexDirection="column" gap={5}>
+        {hasEligibility && (
+          <Box
+            data-test-id="customer-age-eligibility"
+            display="flex"
+            flexDirection="column"
+            gap={1}
+          >
+            <Text size={2} color="default2">
+              {intl.formatMessage(messages.eligibleLabel)}
+            </Text>
+            <Text size={3}>
+              {eligible
+                ? intl.formatMessage(commonMessages.yes)
+                : intl.formatMessage(commonMessages.no)}
+            </Text>
+          </Box>
+        )}
+        {canEditBirthday && (
+          <Input
+            data-test-id="customer-birthday"
+            disabled={disabled}
+            error={!!birthdayError}
+            helperText={birthdayHelperText}
+            label={intl.formatMessage(messages.birthdayLabel)}
+            max={getLocalTodayHint()}
+            name="birthday"
+            type="date"
+            value={birthday}
+            onChange={onChange}
+          />
+        )}
+      </Box>
+    </DetailSettingsCard>
+  );
+};
+
+CustomerAgeCard.displayName = "CustomerAgeCard";
