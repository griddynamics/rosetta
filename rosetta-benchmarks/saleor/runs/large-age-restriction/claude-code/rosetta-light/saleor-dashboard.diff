@@ -0,0 +1,53 @@
+import { type AvailableColumn } from "@dashboard/components/Datagrid/types";
+import { type GridCell } from "@glideapps/glide-data-grid";
+import { type DefaultTheme } from "@saleor/macaw-ui-next";
+import { testIntlInstance } from "@test/intl";
+
+import { createGetCellContent } from "./datagrid";
+
+type ListProducts = Parameters<typeof createGetCellContent>[0]["products"];
+
+function nameCell(product: Record<string, unknown>): GridCell {
+  const getContent = createGetCellContent({
+    columns: [{ id: "name" } as AvailableColumn],
+    products: [product] as unknown as ListProducts,
+    intl: testIntlInstance,
+    theme: {} as DefaultTheme,
+    locale: "en" as never,
+  });
+
+  return getContent([0, 0], {
+    changes: { current: [] },
+    getChangeIndex: () => -1,
+    added: [],
+    removed: [],
+  } as never);
+}
+
+describe("product list name cell age label", () => {
+  it("adds the age restricted label to a restricted product and keeps its name", () => {
+    const cell = nameCell({
+      id: "product-1",
+      name: "Whisky",
+      isAgeRestricted: true,
+      thumbnail: null,
+    });
+
+    expect(cell).toMatchObject({
+      kind: "custom",
+      copyData: "Whisky",
+      data: { kind: "thumbnail-cell", name: "Whisky", badge: "Age restricted" },
+    });
+  });
+
+  it("adds no label to an unrestricted product", () => {
+    const cell = nameCell({
+      id: "product-2",
+      name: "Mug",
+      isAgeRestricted: false,
+      thumbnail: null,
+    });
+
+    expect((cell as { data: { badge?: string } }).data.badge).toBeUndefined();
+  });
+});
