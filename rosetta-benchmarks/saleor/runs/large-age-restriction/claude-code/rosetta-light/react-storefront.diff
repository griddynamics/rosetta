 /**
  * Maps Saleor checkoutComplete errors to shopper-friendly copy.
  *
@@ -15,3 +17,68 @@ export function formatCheckoutCompleteError(error: string): string {
 
 	return error;
 }
+
+/**
+ * Sign-in context line for the contact step. Returns the sign-in-required copy only when the
+ * stashed payment error is exactly that copy (produced by {@link formatCheckoutFailure}).
+ */
+export function pickAgeSignInNotice(
+	stashedError: string | null | undefined,
+	loginRequiredCopy: string,
+): string | null {
+	if (!stashedError || !loginRequiredCopy) {
+		return null;
+	}
+
+	return stashedError === loginRequiredCopy ? loginRequiredCopy : null;
+}
+
+/**
+ * Which follow-up action belongs to an age-restriction error message shown on the payment step.
+ * Matching is by the exact localized copy that {@link formatCheckoutFailure} produced.
+ */
+export function getAgeRestrictionPaymentAction(
+	message: string | null | undefined,
+	copy: { loginRequired: string; birthdayRequired: string },
+): "sign-in" | "set-birthday" | null {
+	if (!message) {
+		return null;
+	}
+	if (message === copy.loginRequired) {
+		return "sign-in";
+	}
+	if (message === copy.birthdayRequired) {
+		return "set-birthday";
+	}
+	return null;
+}
+
+/** A Saleor checkout-side error with its machine code. `message` is server text, never shown for age codes. */
+export type CheckoutFailure = {
+	code?: string | null;
+	message?: string | null;
+};
+
+/**
+ * Age-restriction codes (LR/BR/UA) map to localized copy; any other code falls back to
+ * the server `message`, then to `fallback`. Age values never reach this function.
+ */
+export function formatCheckoutFailure(
+	failure: CheckoutFailure,
+	messages: Pick<
+		CheckoutGatewayMessages,
+		"ageRestrictionLoginRequired" | "ageRestrictionBirthdayRequired" | "ageRestrictionUnderage"
+	>,
+	fallback: string,
+): string {
+	switch (failure.code) {
+		case "AGE_RESTRICTION_LOGIN_REQUIRED":
+			return messages.ageRestrictionLoginRequired;
+		case "AGE_RESTRICTION_BIRTHDAY_REQUIRED":
+			return messages.ageRestrictionBirthdayRequired;
+		case "AGE_RESTRICTION_UNDERAGE":
+			return messages.ageRestrictionUnderage;
+		default:
+			return failure.message || fallback;
+	}
+}
