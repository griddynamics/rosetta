+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("next/cache", () => ({
+	cacheLife: vi.fn(),
+	cacheTag: vi.fn(),
+	io: vi.fn(async () => {}),
+}));
+
+import { AccountUpdateDocument } from "@/gql/graphql";
+import { executeGraphQL } from "@/lib/saleor/client";
+
+// Personal data placed in variables must never reach the shared log line (S§2 NFR-7).
+const BIRTHDAY = "1990-05-12";
+const variables = { input: { birthday: BIRTHDAY, firstName: "Ada" } } as never;
+
+function logged(spy: { mock: { calls: unknown[][] } }): string {
+	return JSON.stringify(spy.mock.calls);
+}
+
+describe("Saleor client log redaction", () => {
+	const originalFetch = globalThis.fetch;
+	const originalUrl = process.env.NEXT_PUBLIC_SALEOR_API_URL;
+
+	beforeEach(() => {
+		process.env.NEXT_PUBLIC_SALEOR_API_URL = "https://saleor.test/graphql/";
+	});
+
+	afterEach(() => {
+		globalThis.fetch = originalFetch;
+		process.env.NEXT_PUBLIC_SALEOR_API_URL = originalUrl;
+		vi.restoreAllMocks();
+	});
+
+	it("does not log the birthday when a transient 503 is retried", async () => {
+		const warn = vi.spyOn(console, "warn").mockImplementation(() => {});
+		const responses = [
+			new Response("unavailable", { status: 503 }),
+			new Response(JSON.stringify({ data: { accountUpdate: { errors: [] } } }), {
+				status: 200,
+				headers: { "Content-Type": "application/json" },
+			}),
+		];
+		globalThis.fetch = vi.fn(async () => responses.shift() as Response) as unknown as typeof fetch;
+
+		const result = await executeGraphQL(AccountUpdateDocument, { auth: "none", variables, maxRetries: 1 });
+
+		expect(result.ok).toBe(true);
+		expect(warn).toHaveBeenCalledTimes(1);
+		expect(logged(warn)).toContain("retrying");
+		expect(logged(warn)).toContain("[redacted]");
+		expect(logged(warn)).not.toContain(BIRTHDAY);
+	});
+
+	it("does not log the birthday when the response is partial data", async () => {
+		const warn = vi.spyOn(console, "warn").mockImplementation(() => {});
+		globalThis.fetch = vi.fn(
+			async () =>
+				new Response(
+					JSON.stringify({
+						data: { accountUpdate: { errors: [] } },
+						errors: [{ message: "Field failed" }],
+					}),
+					{ status: 200, headers: { "Content-Type": "application/json" } },
+				),
+		) as unknown as typeof fetch;
+
+		const result = await executeGraphQL(AccountUpdateDocument, { auth: "none", variables, maxRetries: 0 });
+
+		expect(result.ok).toBe(true);
+		expect(warn).toHaveBeenCalledTimes(1);
+		expect(logged(warn)).toContain("partial data");
+		expect(logged(warn)).not.toContain(BIRTHDAY);
+	});
+});
