+import { describe, expect, it } from "vitest";
+import {
+	BIRTHDAY_MAX_AGE_YEARS,
+	checkBirthdayInput,
+	eligibilityHint,
+	formatIsoDateLocal,
+	isIsoDate,
+	parseBirthdayInput,
+	withOptionalBirthday,
+} from "./birthday-date";
+
+const TODAY = "2026-10-23";
+
+describe("isIsoDate", () => {
+	it("accepts real calendar dates", () => {
+		expect(isIsoDate("2000-05-14")).toBe(true);
+		expect(isIsoDate("2024-02-29")).toBe(true);
+	});
+
+	it("rejects malformed and impossible dates", () => {
+		expect(isIsoDate("2000-5-14")).toBe(false);
+		expect(isIsoDate("14.05.2000")).toBe(false);
+		expect(isIsoDate("2000-13-01")).toBe(false);
+		expect(isIsoDate("2000-00-10")).toBe(false);
+		expect(isIsoDate("2023-02-29")).toBe(false);
+		expect(isIsoDate("2000-04-31")).toBe(false);
+		expect(isIsoDate("2000-05-14T00:00:00Z")).toBe(false);
+	});
+});
+
+describe("parseBirthdayInput", () => {
+	it("treats empty, whitespace and missing values as no birthday (clear)", () => {
+		expect(parseBirthdayInput("")).toEqual({ ok: true, value: null });
+		expect(parseBirthdayInput("   ")).toEqual({ ok: true, value: null });
+		expect(parseBirthdayInput(null)).toEqual({ ok: true, value: null });
+		expect(parseBirthdayInput(undefined)).toEqual({ ok: true, value: null });
+	});
+
+	it("trims and returns a valid date string unchanged", () => {
+		expect(parseBirthdayInput(" 1990-07-01 ")).toEqual({ ok: true, value: "1990-07-01" });
+	});
+
+	it("fails malformed input without echoing it", () => {
+		expect(parseBirthdayInput("not-a-date")).toEqual({ ok: false });
+		expect(parseBirthdayInput("1990-02-30")).toEqual({ ok: false });
+	});
+});
+
+describe("checkBirthdayInput (client hint)", () => {
+	it("accepts today and a date exactly 120 years back", () => {
+		expect(checkBirthdayInput(TODAY, TODAY)).toEqual({ ok: true, value: TODAY });
+		expect(checkBirthdayInput("1906-10-23", TODAY)).toEqual({ ok: true, value: "1906-10-23" });
+	});
+
+	it("rejects a date one day older than 120 years", () => {
+		expect(checkBirthdayInput("1906-10-22", TODAY)).toEqual({ ok: false });
+	});
+
+	it("rejects a future date and accepts a past one", () => {
+		expect(checkBirthdayInput("2026-10-24", TODAY)).toEqual({ ok: false });
+		expect(checkBirthdayInput("2026-10-22", TODAY)).toEqual({ ok: true, value: "2026-10-22" });
+	});
+
+	it("treats empty as clear and malformed as invalid", () => {
+		expect(checkBirthdayInput("", TODAY)).toEqual({ ok: true, value: null });
+		expect(checkBirthdayInput("2026-99-99", TODAY)).toEqual({ ok: false });
+	});
+
+	it("handles a leap-day today against a non-leap 120-years-back year", () => {
+		// Cutoff = same month/day 120 years back; Feb 29 falls back to Feb 28 when that year is not leap.
+		// 2024-02-29 -> 1904 (leap), so Feb 29 is the cutoff. 2025-02-28 -> 1905 (not leap), cutoff Feb 28.
+		expect(checkBirthdayInput("1904-02-29", "2024-02-29")).toEqual({ ok: true, value: "1904-02-29" });
+		expect(checkBirthdayInput("1905-02-28", "2025-02-28")).toEqual({ ok: true, value: "1905-02-28" });
+		expect(checkBirthdayInput("1905-02-27", "2025-02-28")).toEqual({ ok: false });
+	});
+
+	it("keeps the documented maximum age", () => {
+		expect(BIRTHDAY_MAX_AGE_YEARS).toBe(120);
+	});
+});
+
+describe("eligibilityHint", () => {
+	it("asks for a birthday when none is set, whatever the server flag says", () => {
+		expect(eligibilityHint(null, null)).toBe("setBirthday");
+		expect(eligibilityHint(undefined, true)).toBe("setBirthday");
+		expect(eligibilityHint("", false)).toBe("setBirthday");
+	});
+
+	it("maps the server flag when a birthday is set", () => {
+		expect(eligibilityHint("2000-01-01", true)).toBe("eligible");
+		expect(eligibilityHint("2000-01-01", false)).toBe("notEligible");
+	});
+
+	it("returns no hint when a birthday is set but no answer is given", () => {
+		expect(eligibilityHint("2000-01-01", null)).toBeNull();
+		expect(eligibilityHint("2000-01-01", undefined)).toBeNull();
+	});
+});
+
+describe("withOptionalBirthday", () => {
+	const base = { email: "a@example.com", password: "x" };
+
+	it("omits the birthday key entirely when no value is present", () => {
+		expect(withOptionalBirthday(base, null)).toEqual(base);
+		expect(withOptionalBirthday(base, undefined)).toEqual(base);
+		expect(withOptionalBirthday(base, "")).toEqual(base);
+		expect("birthday" in withOptionalBirthday(base, null)).toBe(false);
+	});
+
+	it("adds the birthday key when a value is present", () => {
+		expect(withOptionalBirthday(base, "1990-07-01")).toEqual({ ...base, birthday: "1990-07-01" });
+	});
+});
+
+describe("formatIsoDateLocal", () => {
+	it("formats the local calendar day with zero padding", () => {
+		expect(formatIsoDateLocal(new Date(2026, 0, 5, 23, 59))).toBe("2026-01-05");
+		expect(formatIsoDateLocal(new Date(2026, 9, 23, 0, 0))).toBe("2026-10-23");
+	});
+});
