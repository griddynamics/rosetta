diff --git a/src/lib/catalog/homepage-packshot.ts b/src/lib/catalog/homepage-packshot.ts
new file mode 100644
index 0000000..c5d54ac
--- /dev/null
+++ b/src/lib/catalog/homepage-packshot.ts
@@ -0,0 +1,97 @@
+import type { getFeaturedProducts } from "@/lib/catalog/get-featured-products";
+import { buildSaleorSrcSet } from "@/lib/images";
+import { pickTranslatedSlug } from "@/lib/saleor-translations";
+
+/**
+ * Homepage packshot selection (hero, editorial, category tiles).
+ *
+ * A restricted product stays in the featured grid with its "{N}+" label. Its thumbnail may
+ * still be a hero or editorial packshot (the badge is rendered on the image). It never stands in
+ * for a category tile image: the tile names the category, so an age label there would read as a
+ * rule for the whole category.
+ */
+export type HomepageProduct = Awaited<ReturnType<typeof getFeaturedProducts>>[number];
+type HomepageCategory = NonNullable<HomepageProduct["category"]>;
+
+export type HomepageCategoryTile = {
+	title: string;
+	href: string;
+	image: string | null;
+	imageSrcSet?: string;
+	imageAlt: string;
+};
+
+export type PackshotProduct = {
+	isAgeRestricted?: boolean | null;
+	thumbnail?: { url: string } | null;
+	category?: { slug: string } | null;
+};
+
+/** First product of `categorySlug` that may supply tile art: not restricted, with a thumbnail. */
+export function pickTileFallbackProduct<T extends PackshotProduct>(
+	products: readonly T[],
+	categorySlug: string,
+): T | undefined {
+	return products.find(
+		(product) =>
+			product.category?.slug === categorySlug &&
+			product.isAgeRestricted !== true &&
+			Boolean(product.thumbnail?.url),
+	);
+}
+
+/** True when a packshot of this product is rendered, so its "{N}+" label must sit on the image. */
+export function needsPackshotAgeLabel(product: PackshotProduct | null | undefined): boolean {
+	return product?.isAgeRestricted === true && Boolean(product.thumbnail?.url);
+}
+
+/** Aliased rungs must stay in sync with CATALOG_CARD_RUNGS in src/lib/images.ts. */
+export function productThumbnailSrcSet(product: HomepageProduct) {
+	return buildSaleorSrcSet([
+		{ width: 256, url: product.thumbnail256?.url },
+		{ width: 512, url: product.thumbnail512?.url },
+		{ width: 1024, url: product.thumbnail?.url },
+	]);
+}
+
+export function categoryBackgroundSrcSet(category: HomepageCategory) {
+	return buildSaleorSrcSet([
+		{ width: 256, url: category.backgroundImage256?.url },
+		{ width: 512, url: category.backgroundImage512?.url },
+		{ width: 1024, url: category.backgroundImage?.url },
+	]);
+}
+
+/**
+ * Derive shop-by-category tiles from the catalog: one tile per category. Prefer the
+ * category's own background image (merchandised lifestyle art); fall back to a
+ * non-restricted product thumbnail of that category. Restricted products are never dropped
+ * from the input, and a category whose products are all restricted still gets a tile.
+ */
+export function buildCategoryTiles(products: readonly HomepageProduct[], max = 3): HomepageCategoryTile[] {
+	const seen = new Set<string>();
+	const tiles: HomepageCategoryTile[] = [];
+	for (const product of products) {
+		const category = product.category;
+		if (!category?.slug || seen.has(category.slug)) continue;
+		seen.add(category.slug);
+		const categoryName = category.translation?.name || category.name;
+		const background = category.backgroundImage;
+		const fallback = pickTileFallbackProduct(products, category.slug);
+		const image = background?.url ?? fallback?.thumbnail?.url ?? null;
+		const imageAlt = background?.alt || fallback?.thumbnail?.alt || categoryName;
+		tiles.push({
+			title: categoryName,
+			href: `/categories/${pickTranslatedSlug(category)}`,
+			image,
+			imageSrcSet: background?.url
+				? categoryBackgroundSrcSet(category)
+				: fallback
+					? productThumbnailSrcSet(fallback)
+					: undefined,
+			imageAlt,
+		});
+		if (tiles.length >= max) break;
+	}
+	return tiles;
+}
