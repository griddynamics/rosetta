index 0000000..7e3dbb6
--- /dev/null
+++ b/src/app/(checkout)/actions.test.ts
@@ -0,0 +1,210 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+import type {
+	TransactionInitializeMutationVariables,
+	TransactionProcessMutationVariables,
+} from "@/checkout/graphql/generated/operations";
+
+// External boundaries only: the Saleor client, server translations, cookies/order-view,
+// analytics and the payment-gateway environment guards. The copy builder and the
+// formatter run for real.
+const { mutateMock, enrichMock, setOrderViewCookieMock, signOrderViewTokenMock } = vi.hoisted(() => ({
+	mutateMock: vi.fn(),
+	enrichMock: vi.fn(),
+	setOrderViewCookieMock: vi.fn(),
+	signOrderViewTokenMock: vi.fn(),
+}));
+
+vi.mock("@/lib/saleor", () => ({
+	mutate: mutateMock,
+	liveQuery: vi.fn(),
+	rawMutation: vi.fn(),
+}));
+
+vi.mock("next/server", () => ({ after: vi.fn() }));
+
+vi.mock("@/app/actions", () => ({ saveCheckoutId: vi.fn() }));
+
+vi.mock("@/lib/checkout", () => ({
+	clearCheckoutCookieByValue: vi.fn(),
+	clearCheckoutCookie: vi.fn(),
+	getIdFromCookies: vi.fn(),
+	saveIdToCookie: vi.fn(),
+}));
+
+vi.mock("@/lib/analytics/emit.server", () => ({ emitCommerceEvent: vi.fn() }));
+
+vi.mock("@/lib/order-view", () => ({
+	setOrderViewCookie: setOrderViewCookieMock,
+	signOrderViewToken: signOrderViewTokenMock,
+}));
+
+vi.mock("@/checkout/lib/server/enrich-commerce-context", () => ({
+	enrichCheckoutCommerceContext: enrichMock,
+}));
+
+vi.mock("@/checkout/lib/server/fetch-checkout", () => ({ fetchCheckoutOnServer: vi.fn() }));
+
+vi.mock("@/checkout/lib/payment-gateways", () => ({
+	getDummyPaymentGuardError: () => null,
+	isDummyPaymentAllowed: () => true,
+}));
+
+vi.mock("@/checkout/lib/payment/providers/stripe", () => ({
+	getStripePaymentGuardError: () => null,
+	isStripePaymentEnabled: () => false,
+}));
+
+vi.mock("@/checkout/lib/server/get-checkout-server-translations", async () => {
+	const { buildCheckoutGatewayMessages } = await import("@/checkout/lib/payment/gateway-messages");
+	const server = (key: string) => `server:${key}`;
+	const gateways = (key: string) => `gateway:${key}`;
+	return {
+		getCheckoutServerTranslations: async () => ({
+			server,
+			gatewayMessages: buildCheckoutGatewayMessages(gateways as never),
+		}),
+	};
+});
+
+import {
+	initializeCheckoutTransaction,
+	processCheckoutTransaction,
+	runCheckoutComplete,
+} from "@/app/(checkout)/actions";
+
+// Copy as the gateway translator returns it (see `gateway:` prefix in the mock above).
+const LR_COPY = "gateway:ageRestrictionLoginRequired";
+const BR_COPY = "gateway:ageRestrictionBirthdayRequired";
+const UA_COPY = "gateway:ageRestrictionUnderage";
+
+function completeWithErrors(errors: Array<{ field?: string | null; code: string; message?: string | null }>) {
+	return { ok: true, data: { checkoutComplete: { errors, order: null } } };
+}
+
+describe("runCheckoutComplete age-restriction wiring", () => {
+	beforeEach(() => {
+		vi.clearAllMocks();
+		signOrderViewTokenMock.mockReturnValue("order-view-token");
+		setOrderViewCookieMock.mockResolvedValue(undefined);
+	});
+
+	it.each([
+		["AGE_RESTRICTION_LOGIN_REQUIRED", LR_COPY],
+		["AGE_RESTRICTION_BIRTHDAY_REQUIRED", BR_COPY],
+		["AGE_RESTRICTION_UNDERAGE", UA_COPY],
+	])("returns the copy for %s and keeps the code in fieldErrors", async (code, copy) => {
+		mutateMock.mockResolvedValue(
+			completeWithErrors([{ field: "lines", code, message: "Restricted line for customer 2000-01-01" }]),
+		);
+
+		const result = await runCheckoutComplete("checkout-1");
+
+		expect(result).toEqual({
+			ok: false,
+			error: copy,
+			fieldErrors: [{ field: "lines", message: "Restricted line for customer 2000-01-01", code }],
+		});
+	});
+
+	it("keeps the server message for a non-age code", async () => {
+		mutateMock.mockResolvedValue(
+			completeWithErrors([{ field: "checkout", code: "CHECKOUT_NOT_FULLY_PAID", message: "Not fully paid" }]),
+		);
+
+		const result = await runCheckoutComplete("checkout-1");
+
+		expect(result).toMatchObject({ ok: false, error: "Not fully paid" });
+	});
+
+	it("falls back to the server translation when a non-age error has no message", async () => {
+		mutateMock.mockResolvedValue(completeWithErrors([{ field: null, code: "INVALID", message: null }]));
+
+		const result = await runCheckoutComplete("checkout-1");
+
+		expect(result).toMatchObject({ ok: false, error: "server:completeOrderFailed" });
+	});
+
+	it("returns the order and view token on success", async () => {
+		mutateMock.mockResolvedValue({
+			ok: true,
+			data: {
+				checkoutComplete: {
+					errors: [],
+					order: {
+						id: "order-1",
+						channel: { slug: "default" },
+						total: { gross: { amount: 10, currency: "USD" } },
+					},
+				},
+			},
+		});
+
+		await expect(runCheckoutComplete("checkout-1")).resolves.toEqual({
+			ok: true,
+			orderId: "order-1",
+			orderViewToken: "order-view-token",
+		});
+		expect(setOrderViewCookieMock).toHaveBeenCalledWith("order-view-token");
+	});
+});
+
+describe("initializeCheckoutTransaction age-restriction wiring", () => {
+	beforeEach(() => {
+		vi.clearAllMocks();
+	});
+
+	it.each([
+		["AGE_RESTRICTION_LOGIN_REQUIRED", LR_COPY],
+		["AGE_RESTRICTION_BIRTHDAY_REQUIRED", BR_COPY],
+		["AGE_RESTRICTION_UNDERAGE", UA_COPY],
+	])("maps transactionInitialize %s to its copy", async (code, copy) => {
+		mutateMock.mockResolvedValue({
+			ok: true,
+			data: { transactionInitialize: { errors: [{ code, message: "server text" }] } },
+		});
+
+		const result = await initializeCheckoutTransaction({
+			checkoutId: "checkout-1",
+			paymentGateway: { id: "saleor.io.dummy-payment-app" },
+		} as unknown as TransactionInitializeMutationVariables);
+
+		expect(result).toEqual({ ok: false, error: copy });
+	});
+
+	it("keeps the server message for a non-age transactionInitialize error", async () => {
+		mutateMock.mockResolvedValue({
+			ok: true,
+			data: { transactionInitialize: { errors: [{ code: "GRAPHQL_ERROR", message: "Gateway down" }] } },
+		});
+
+		const result = await initializeCheckoutTransaction({
+			checkoutId: "checkout-1",
+			paymentGateway: { id: "saleor.io.dummy-payment-app" },
+		} as unknown as TransactionInitializeMutationVariables);
+
+		expect(result).toEqual({ ok: false, error: "Gateway down" });
+	});
+});
+
+describe("processCheckoutTransaction age-restriction wiring", () => {
+	beforeEach(() => {
+		vi.clearAllMocks();
+	});
+
+	it("maps a transactionProcess under-age error to the underage copy", async () => {
+		mutateMock.mockResolvedValue({
+			ok: true,
+			data: {
+				transactionProcess: {
+					errors: [{ code: "AGE_RESTRICTION_UNDERAGE", message: "server text" }],
+				},
+			},
+		});
+
+		const result = await processCheckoutTransaction({
+			id: "tx-1",
+		} as unknown as TransactionProcessMutationVariables);
+
+		expect(result).toEqual({ ok: false, error: UA_COPY });
+	});
+});
