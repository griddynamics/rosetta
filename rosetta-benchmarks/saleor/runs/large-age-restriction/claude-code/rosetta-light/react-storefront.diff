+/**
+ * Owner sets, changes or clears (empty value = `null`) their own birthday via `accountUpdate`.
+ * Errors never echo the submitted value or the core message: every failure maps to a localized key
+ * (`invalidBirthday` for format and core `INVALID`, `updateBirthdayFailed` for anything else).
+ */
+export async function updateBirthday(formData: FormData): Promise<AccountActionResult> {
+	// A missing field is invalid input, not a clear. Only an empty string clears.
+	const raw = formData.get("birthday");
+	const parsed = typeof raw === "string" ? parseBirthdayInput(raw) : { ok: false as const };
+	if (!parsed.ok) {
+		return { success: false, errorKey: "invalidBirthday" };
+	}
+
+	const result = await mutate(AccountUpdateDocument, {
+		variables: { input: { birthday: parsed.value } },
+	});
+
+	if (!result.ok) {
+		return { success: false, errorKey: "updateBirthdayFailed" };
+	}
+
+	const errors = result.data.accountUpdate?.errors;
+	if (errors?.length) {
+		const [first] = errors;
+		return first.code === AccountErrorCode.Invalid
+			? { success: false, errorKey: "invalidBirthday" }
+			: { success: false, errorKey: "updateBirthdayFailed" };
+	}
+
+	revalidateAccountLayout();
+	return { success: true };
+}
