+import "server-only";
+
+import { getTranslations } from "next-intl/server";
+import type { AgeRestrictionConfig } from "@/lib/custom/age-restriction-types";
+import { getShopAgeRestrictionMinimumAge } from "@/lib/custom/shop-age-restriction";
+
+/**
+ * Shop age label config for one locale: N from the cached shop loader, copy from `pdp.ageRestriction.*`.
+ * Used by the listing routes, the featured section and the PDP shell. Listings and PDP share the
+ * same config, so the label text cannot drift between them.
+ */
+export async function getAgeRestrictionConfig(locale: string): Promise<AgeRestrictionConfig> {
+	const [minimumAge, t] = await Promise.all([
+		getShopAgeRestrictionMinimumAge(),
+		getTranslations({ locale, namespace: "pdp" }),
+	]);
+	// `t.raw` keeps the `{age}` placeholder unformatted; the badge fills it with N.
+	return {
+		minimumAge,
+		copy: {
+			label: t.raw("ageRestriction.label"),
+			neutral: t.raw("ageRestriction.neutral"),
+			srLabel: t.raw("ageRestriction.srLabel"),
+		},
+	};
+}
