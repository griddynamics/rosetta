+/**
+ * Copy for the age label. The caller translates it (keys registered in HANDOFF, message register)
+ * and passes it in, so this component stays free of next-intl and renders on any surface.
+ * `{age}` is replaced by N.
+ */
+export type AgeRestrictionCopy = {
+	/** Visible label, e.g. "{age}+". */
+	label: string;
+	/** Visible and screen-reader text when N is unknown. No number is shown. */
+	neutral: string;
+	/** Screen-reader sentence, e.g. "Age restricted: {age}+". */
+	srLabel: string;
+};
+
+/**
+ * Shop-level label config, built once per route on the server. Plain data (number and strings),
+ * so it crosses into client components (PLP listing) and the PDP slot unchanged.
+ */
+export type AgeRestrictionConfig = {
+	/** Shop `ageRestrictionMinimumAge`, or null when unknown. */
+	minimumAge: number | null;
+	copy: AgeRestrictionCopy;
+};
