+import { createElement, type ReactNode } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+import type { ProductView } from "@/lib/storefront/contract/product";
+import type { PdpTemplateSlots } from "@/lib/storefront/templates";
+import { PDP_LAYOUT_CLASSES } from "@/ui/components/pdp/gallery-layout";
+import { AgeRestrictionBadge, type AgeRestrictionConfig } from "@/ui/components/age-restriction-badge";
+import { PdpPresetLayout } from "./product-layout";
+
+const AGE_21: AgeRestrictionConfig = {
+	minimumAge: 21,
+	copy: { label: "{age}+", neutral: "Age restricted", srLabel: "Age restricted: {age}+" },
+};
+
+function view(name: string, isAgeRestricted: boolean): ProductView {
+	return {
+		id: "p-1",
+		name,
+		slug: "strong-rum",
+		isBestseller: false,
+		extensions: { isAgeRestricted },
+	} as unknown as ProductView;
+}
+
+function slotsFor(ageRestriction?: ReactNode): PdpTemplateSlots {
+	return {
+		breadcrumbs: null,
+		gallery: null,
+		buyBox: null,
+		attributes: null,
+		ageRestriction,
+	};
+}
+
+function render(product: ProductView, slots: PdpTemplateSlots) {
+	return renderToStaticMarkup(
+		createElement(PdpPresetLayout, { product, slots, layout: PDP_LAYOUT_CLASSES.standard }),
+	);
+}
+
+describe("PDP age label (TC-V-03: restricted product stays on the PDP for guests)", () => {
+	it("renders the restricted product title with no filtering or hiding", () => {
+		const html = render(
+			view("Strong Rum", true),
+			slotsFor(
+				createElement(AgeRestrictionBadge, { isAgeRestricted: true, minimumAge: 21, copy: AGE_21.copy }),
+			),
+		);
+		expect(html).toContain("<h1");
+		expect(html).toContain("Strong Rum");
+	});
+});
+
+describe("PDP age label (TC-V-04 and TC-V-05 on the PDP header)", () => {
+	it("renders the configured label next to the title for a restricted product", () => {
+		const html = render(
+			view("Strong Rum", true),
+			slotsFor(
+				createElement(AgeRestrictionBadge, { isAgeRestricted: true, minimumAge: 21, copy: AGE_21.copy }),
+			),
+		);
+		expect(html).toContain('<span aria-hidden="true">21+</span>');
+	});
+
+	it("renders no label when the route passes no slot (unrestricted product)", () => {
+		const html = render(view("Plain Tee", false), slotsFor(undefined));
+		expect(html).toContain("Plain Tee");
+		expect(html).not.toContain("age-restriction-badge");
+	});
+
