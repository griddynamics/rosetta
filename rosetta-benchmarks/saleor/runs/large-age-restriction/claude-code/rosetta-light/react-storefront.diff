+		stateRef.current = { status: "guest" };
+
+		await getSessionAgeState();
+
+		expect(sessionQueryMock).toHaveBeenCalledWith(CurrentUserProfileDocument, {});
+	});
+
+	it("maps a guest to the guest state", async () => {
+		stateRef.current = { status: "guest" };
+		sessionQueryMock.mockResolvedValue({ ok: true, data: { me: null } });
+
+		await expect(getSessionAgeState()).resolves.toEqual({ status: "guest" });
+	});
