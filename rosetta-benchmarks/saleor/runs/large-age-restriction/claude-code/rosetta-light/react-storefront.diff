+	minimumAge: 18,
+	copy: { label: "{age}+", neutral: "Age restricted", srLabel: "Age restricted: {age}+" },
+};
+
+function render(imageBadge?: ReturnType<typeof createElement>) {
+	return renderToStaticMarkup(
+		createElement(ImageWithText, {
+			heading: "Our story",
