+
+const order = {
+	id: "order-1",
+	number: "1001",
+	lines: [
+		{
+			id: "order-line-restricted",
+			quantity: 1,
+			totalPrice: { gross: money(40) },
+			unitPrice: { gross: money(40) },
+			undiscountedUnitPrice: { gross: money(40) },
+			productName: "Whisky",
+			variantName: "70cl",
+			thumbnail: null,
+			variant: {
+				name: "70cl",
+				translation: null,
+				attributes: [],
+				product: { name: "Whisky", isAgeRestricted: true, translation: null },
+			},
+		},
+		{
+			id: "order-line-plain",
+			quantity: 2,
+			totalPrice: { gross: money(20) },
+			unitPrice: { gross: money(10) },
+			undiscountedUnitPrice: { gross: money(10) },
