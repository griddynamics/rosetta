+	it("maps an unavailable session to unavailable (no CTA decision from it)", async () => {
+		stateRef.current = { status: "unavailable" };
+		sessionQueryMock.mockResolvedValue({ ok: false });
+
+		await expect(getSessionAgeState()).resolves.toEqual({ status: "unavailable" });
+	});
+
+	it("reports only presence of a birthday, never its value", async () => {
+		stateRef.current = {
+			status: "authenticated",
+			user: { birthday: "2000-01-01", isAgeEligible: true },
+		};
+		sessionQueryMock.mockResolvedValue({ ok: true, data: { me: {} } });
+
