+		await expect(addVariantToCart(input)).resolves.toEqual({
+			ok: false,
+			code: "CHECKOUT_UNAVAILABLE",
+			message: "",
+		});
+		expect(mutateMock).not.toHaveBeenCalled();
+	});
+});
