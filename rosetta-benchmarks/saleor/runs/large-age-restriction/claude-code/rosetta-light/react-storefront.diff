+import { describe, expect, it } from "vitest";
+import { getSafeReturnPath } from "@/lib/auth/safe-return-path";
+
+describe("getSafeReturnPath", () => {
+	it.each([
+		["/en/default-channel/products/red-wine", "/en/default-channel/products/red-wine"],
+		["/en/ch/account/settings?tab=profile", "/en/ch/account/settings?tab=profile"],
+		["/en/ch/products/a#reviews", "/en/ch/products/a#reviews"],
+	])("accepts the same-origin path %s", (input, expected) => {
+		expect(getSafeReturnPath(input)).toBe(expected);
+	});
+
+	it.each([
+		["absolute https URL", "https://evil.example/steal"],
+		["absolute http URL", "http://evil.example"],
+		["protocol-relative", "//evil.example/steal"],
+		["backslash after slash", "/\\evil.example"],
+		["backslash inside path", "/en/ch\\..\\x"],
+		["javascript scheme", "javascript:alert(1)"],
+		["no leading slash", "en/ch/products"],
+		["embedded newline", "/en/ch\r\nLocation: https://evil.example"],
+		["control character", "/en/ch\u0007"],
+		["dot segment then protocol-relative", "/..//evil.example"],
+		["single dot then protocol-relative", "/.//evil.example"],
+		["nested dot segments then protocol-relative", "/products/../..//evil.example"],
+		["encoded dot segments then protocol-relative", "/%2e%2e//evil.example"],
+		["empty string", ""],
+		["null", null],
+		["undefined", undefined],
+	])("rejects %s", (_label, input) => {
+		expect(getSafeReturnPath(input)).toBeNull();
+	});
+
+	it("normalises dot segments and stays on the same origin", () => {
+		expect(getSafeReturnPath("/en/ch/../ch/products")).toBe("/en/ch/products");
+		expect(getSafeReturnPath("/../../etc")).toBe("/etc");
+	});
+
+	it.each([
+		["encoded slashes stay inside the path", "/%2F%2Fevil.example", "/%2F%2Fevil.example"],
+		[
+			"encoded slashes after dot segments stay inside the path",
+			"/..%2f%2fevil.example",
+			"/..%2f%2fevil.example",
+		],
+	])("accepts %s (no protocol-relative URL is produced)", (_label, input, expected) => {
+		expect(getSafeReturnPath(input)).toBe(expected);
+	});
+});
