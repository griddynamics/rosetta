--- /dev/null
+++ b/src/lib/birthday/birthday-date.ts
@@ -0,0 +1,111 @@
+/**
+ * Pure helpers for the self-declared birthday (`YYYY-MM-DD`).
+ *
+ * The date stays a string end to end. Never round-trip it through `new Date(...)`:
+ * parsing `YYYY-MM-DD` as a Date shifts the calendar day with the time zone.
+ * Values are never logged and never placed in URLs, cache keys or analytics (S§11).
+ *
+ * Range checks here are client hints only. Core validation is authoritative.
+ */
+
+export const BIRTHDAY_MAX_AGE_YEARS = 120;
+
+const ISO_DATE_PATTERN = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+function isLeapYear(year: number): boolean {
+	return (year % 4 === 0 && year % 100 !== 0) || year % 400 === 0;
+}
+
+function daysInMonth(year: number, month: number): number {
+	if (month === 2) {
+		return isLeapYear(year) ? 29 : 28;
+	}
+	return [4, 6, 9, 11].includes(month) ? 30 : 31;
+}
+
+function padYear(year: number): string {
+	return String(year).padStart(4, "0");
+}
+
+/** True when the value is a real calendar date in `YYYY-MM-DD` form. */
+export function isIsoDate(value: string): boolean {
+	const match = ISO_DATE_PATTERN.exec(value);
+	if (!match) {
+		return false;
+	}
+	const year = Number(match[1]);
+	const month = Number(match[2]);
+	const day = Number(match[3]);
+	return month >= 1 && month <= 12 && day >= 1 && day <= daysInMonth(year, month);
+}
+
+/** Formats the local calendar day of a Date as `YYYY-MM-DD` (reads components only). */
+export function formatIsoDateLocal(date: Date): string {
+	const mm = String(date.getMonth() + 1).padStart(2, "0");
+	const dd = String(date.getDate()).padStart(2, "0");
+	return `${padYear(date.getFullYear())}-${mm}-${dd}`;
+}
+
+export type BirthdayParse = { ok: true; value: string | null } | { ok: false };
+
+/**
+ * Format-only parse of a raw form or request value.
+ * Empty or missing means "no birthday" (`value: null`). Malformed or impossible dates fail.
+ */
+export function parseBirthdayInput(raw: string | null | undefined): BirthdayParse {
+	const trimmed = (raw ?? "").trim();
+	if (trimmed === "") {
+		return { ok: true, value: null };
+	}
+	return isIsoDate(trimmed) ? { ok: true, value: trimmed } : { ok: false };
+}
+
+/** Earliest birthday accepted for `todayIso`: the same month and day, 120 years earlier. */
+function minimumBirthdayIso(todayIso: string): string {
+	const year = Number(todayIso.slice(0, 4)) - BIRTHDAY_MAX_AGE_YEARS;
+	const monthDay = todayIso.slice(5);
+	if (monthDay === "02-29" && !isLeapYear(year)) {
+		return `${padYear(year)}-02-28`;
+	}
+	return `${padYear(year)}-${monthDay}`;
+}
+
+/**
+ * Client hint: format, not in the future, not older than 120 years, judged against `todayIso`.
+ * Core re-validates on submit and stays the authority.
+ */
+export function checkBirthdayInput(raw: string | null | undefined, todayIso: string): BirthdayParse {
+	const parsed = parseBirthdayInput(raw);
+	if (!parsed.ok || parsed.value === null) {
+		return parsed;
+	}
+	const inRange = parsed.value <= todayIso && parsed.value >= minimumBirthdayIso(todayIso);
+	return inRange ? parsed : { ok: false };
+}
+
+export type EligibilityHint = "setBirthday" | "eligible" | "notEligible";
+
+/** Which account hint to show. `null` when the server gave no eligibility answer for a set birthday. */
+export function eligibilityHint(
+	birthday: string | null | undefined,
+	isAgeEligible: boolean | null | undefined,
+): EligibilityHint | null {
+	if (!birthday) {
+		return "setBirthday";
+	}
+	if (isAgeEligible === true) {
+		return "eligible";
+	}
+	if (isAgeEligible === false) {
+		return "notEligible";
+	}
+	return null;
+}
+
+/** Adds `birthday` only when a value is present, so the key is absent for sign-ups without one. */
+export function withOptionalBirthday<T extends object>(
+	input: T,
+	birthday: string | null | undefined,
+): T & { birthday?: string } {
+	return birthday ? { ...input, birthday } : input;
+}
