+});
diff --git a/src/lib/account/get-session-age-state.ts b/src/lib/account/get-session-age-state.ts
new file mode 100644
index 0000000..e06c54d
--- /dev/null
+++ b/src/lib/account/get-session-age-state.ts
@@ -0,0 +1,29 @@
+import "server-only";
+
+import { CurrentUserProfileDocument } from "@/gql/graphql";
+import { sessionQuery } from "@/lib/saleor";
+import { resolveSessionUser } from "@/lib/auth/resolve-session-user";
+import type { PdpSessionState } from "@/lib/account/age-restriction-cta";
+
+/**
+ * Per-request session age state for the PDP purchase CTA. Uses the customer session,
+ * so call it only from dynamic islands, never from a `"use cache"` loader or the
+ * cached product shell. The birthday value is read for presence only and never returned.
+ */
+export async function getSessionAgeState(): Promise<PdpSessionState> {
+	const state = await resolveSessionUser(() => sessionQuery(CurrentUserProfileDocument, {}));
+
+	if (state.status === "guest") {
+		return { status: "guest" };
+	}
+
+	if (state.status === "unavailable") {
+		return { status: "unavailable" };
+	}
+
+	return {
+		status: "authenticated",
+		hasBirthday: state.user.birthday != null,
+		isAgeEligible: state.user.isAgeEligible ?? null,
+	};
+}
