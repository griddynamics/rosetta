+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { NextRequest } from "next/server";
+
+vi.mock("server-only", () => ({}));
+
+const rawMutation = vi.fn();
+
+vi.mock("@/lib/auth/auth-rate-limit", () => ({
+	rejectIfRateLimited: () => undefined,
+}));
+
+vi.mock("@/lib/auth/validate-redirect-url", () => ({
+	isAllowedRedirectUrl: () => true,
+}));
+
+vi.mock("@/lib/saleor", () => ({
+	rawMutation: (...args: unknown[]) => rawMutation(...args),
+	asValidationError: (errors: unknown) => ({ ok: false, error: { validationErrors: errors } }),
+	getUserMessage: () => "Something went wrong",
+}));
+
+import { POST } from "./route";
+
+const BASE_BODY = {
+	email: "new@example.com",
+	password: "correct-horse-battery",
+	firstName: "Ada",
+	lastName: "Lovelace",
+	channel: "default-channel",
+	redirectUrl: "http://localhost:3000/default-channel/en-US/account/confirm",
+};
+
+function registerRequest(body: unknown): NextRequest {
+	return new NextRequest("http://localhost:3000/api/auth/register", {
+		method: "POST",
+		headers: { "content-type": "application/json" },
+		body: JSON.stringify(body),
+	});
+}
+
+function sentInput(): Record<string, unknown> {
+	const [call] = rawMutation.mock.calls;
+	return (call[0] as { variables: { input: Record<string, unknown> } }).variables.input;
+}
+
+describe("POST /api/auth/register birthday", () => {
+	let consoleSpies: Array<ReturnType<typeof vi.spyOn>> = [];
+
+	beforeEach(() => {
+		rawMutation.mockReset();
+		rawMutation.mockResolvedValue({
+			ok: true,
+			data: { accountRegister: { user: { id: "VXNlcjox", email: BASE_BODY.email }, errors: [] } },
+		});
+		consoleSpies = [vi.spyOn(console, "log"), vi.spyOn(console, "warn"), vi.spyOn(console, "error")];
+	});
+
+	afterEach(() => {
+		consoleSpies.forEach((spy) => spy.mockRestore());
+	});
+
+	it("forwards a provided birthday to accountRegister", async () => {
+		const response = await POST(registerRequest({ ...BASE_BODY, birthday: "1990-07-01" }));
+
+		expect(response.status).toBe(200);
+		expect(sentInput()).toMatchObject({ email: BASE_BODY.email, birthday: "1990-07-01" });
+	});
+
+	it("omits the birthday key when the field is absent", async () => {
+		const response = await POST(registerRequest(BASE_BODY));
+
+		expect(response.status).toBe(200);
+		expect("birthday" in sentInput()).toBe(false);
+	});
+
+	it("omits the birthday key when the field is an empty string", async () => {
+		const response = await POST(registerRequest({ ...BASE_BODY, birthday: "" }));
+
+		expect(response.status).toBe(200);
+		expect("birthday" in sentInput()).toBe(false);
+	});
+
+	it("treats an explicit null birthday as absent", async () => {
+		const response = await POST(registerRequest({ ...BASE_BODY, birthday: null }));
+
+		expect(response.status).toBe(200);
+		expect("birthday" in sentInput()).toBe(false);
+	});
+
+	it("rejects a malformed birthday before calling core, without echoing it", async () => {
+		const response = await POST(registerRequest({ ...BASE_BODY, birthday: "1990-02-30" }));
+		const body = (await response.json()) as {
+			errors: Array<{ field: string; code: string; message: string }>;
+		};
+
+		expect(response.status).toBe(400);
+		expect(body.errors[0]).toEqual({ field: "birthday", code: "INVALID", message: "Invalid birthday." });
+		expect(JSON.stringify(body)).not.toContain("1990-02-30");
+		expect(rawMutation).not.toHaveBeenCalled();
+	});
+
+	it("rejects a non-string birthday as invalid", async () => {
+		const response = await POST(registerRequest({ ...BASE_BODY, birthday: 19900701 }));
+
+		expect(response.status).toBe(400);
+		expect(rawMutation).not.toHaveBeenCalled();
+	});
+
+	it("returns core's birthday validation error with its field", async () => {
+		rawMutation.mockResolvedValue({
+			ok: true,
+			data: {
+				accountRegister: {
+					user: null,
+					errors: [{ field: "birthday", message: "Invalid birthday.", code: "INVALID" }],
+				},
+			},
+		});
+
+		const response = await POST(registerRequest({ ...BASE_BODY, birthday: "2999-01-01" }));
+		const body = (await response.json()) as { errors: Array<{ field: string; code: string }> };
+
+		expect(response.status).toBe(400);
+		expect(body.errors[0]).toMatchObject({ field: "birthday", code: "INVALID" });
+	});
+
+	it("never logs the submitted birthday", async () => {
+		await POST(registerRequest({ ...BASE_BODY, birthday: "1990-07-01" }));
+
+		for (const spy of consoleSpies) {
+			expect(spy).not.toHaveBeenCalled();
+		}
+	});
+});
