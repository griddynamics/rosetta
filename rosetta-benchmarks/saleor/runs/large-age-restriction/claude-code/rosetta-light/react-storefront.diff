+	subtotal: { gross: money(60) },
+	shippingPrice: { gross: money(0) },
+	discounts: [],
+} as unknown as OrderFragment;
+
+function renderSummary(
+	source: { checkout: CheckoutFragment } | { order: OrderFragment },
+	config: AgeRestrictionConfig | null,
+) {
+	const summary =
+		"checkout" in source
+			? createElement(OrderSummary, { checkout: source.checkout })
+			: createElement(OrderSummary, { order: source.order, editable: false });
+	return renderToStaticMarkup(
+		config ? createElement(CheckoutAgeRestrictionProvider, { ageRestriction: config }, summary) : summary,
+	);
+}
+
+const BADGE = 'data-testid="age-restriction-badge"';
+
+function countBadges(html: string) {
+	return html.split(BADGE).length - 1;
+}
+
+describe("OrderSummary age label (checkout summary and order confirmation lines)", () => {
+	it("labels only the restricted checkout line with the shop minimum age", () => {
+		const html = renderSummary({ checkout }, AGE_18);
