+import "server-only";
+
+import { ShopAgeRestrictionDocument } from "@/gql/graphql";
+import { cachedQuery } from "@/lib/saleor";
+import { dataExtensions } from "@/config/data-extensions";
+
+/**
+ * Public shop setting `ageRestrictionMinimumAge` (N in the "{N}+" label). Cached on the
+ * fork profile `shopAgeRestriction` (tag `shop:age-restriction`, catalog tier). No webhook
+ * fires for shop settings, so staleness is bounded by the profile TTL (revalidate 1h, expire 1d).
+ *
+ * Returns `null` when the value is missing (partial data or an older API). Callers then show
+ * the neutral label. They never guess a number.
+ */
+export async function getShopAgeRestrictionMinimumAge(): Promise<number | null> {
+	return readShopAgeRestrictionMinimumAge();
+}
+
+async function readShopAgeRestrictionMinimumAge(): Promise<number | null> {
+	"use cache";
+	// Optional read: a failed field is cached as null for the profile TTL (same as channel metadata)
+	// instead of failing the prerender. The neutral label is the degraded result.
+	const data = await cachedQuery(ShopAgeRestrictionDocument, {
+		profile: dataExtensions.profiles.shopAgeRestriction,
+		allowPartialData: true,
+	});
+	return data.shop?.ageRestrictionMinimumAge ?? null;
+}
