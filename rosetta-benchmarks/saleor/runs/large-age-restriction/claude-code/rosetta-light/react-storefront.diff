+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("server-only", () => ({}));
+
+const mutate = vi.fn();
+const refresh = vi.fn();
+
+vi.mock("@/lib/saleor", () => ({
+	mutate: (...args: unknown[]) => mutate(...args),
+}));
+
+vi.mock("next/cache", () => ({
+	refresh: () => refresh(),
+}));
+
+import { updateBirthday } from "./actions";
+
+function birthdayForm(value: string | null): FormData {
+	const formData = new FormData();
+	if (value !== null) {
+		formData.set("birthday", value);
+	}
+	return formData;
+}
+
+function sentBirthday(): unknown {
+	const [, options] = mutate.mock.calls[0] as [unknown, { variables: { input: Record<string, unknown> } }];
+	return options.variables.input.birthday;
+}
+
+describe("updateBirthday", () => {
+	let consoleSpies: Array<ReturnType<typeof vi.spyOn>> = [];
+
+	beforeEach(() => {
+		mutate.mockReset();
+		refresh.mockReset();
+		consoleSpies = [vi.spyOn(console, "log"), vi.spyOn(console, "warn"), vi.spyOn(console, "error")];
+	});
+
+	afterEach(() => {
+		consoleSpies.forEach((spy) => spy.mockRestore());
+	});
+
+	it("sets the owner's birthday through accountUpdate and refreshes the account", async () => {
+		mutate.mockResolvedValue({
+			ok: true,
+			data: { accountUpdate: { user: { id: "1" }, errors: [] } },
+		});
+
+		await expect(updateBirthday(birthdayForm("1990-07-01"))).resolves.toEqual({ success: true });
+
+		expect(mutate).toHaveBeenCalledTimes(1);
+		expect(sentBirthday()).toBe("1990-07-01");
+		expect(refresh).toHaveBeenCalledTimes(1);
+	});
+
+	it("changes an existing birthday to a new value", async () => {
+		mutate.mockResolvedValue({ ok: true, data: { accountUpdate: { user: { id: "1" }, errors: [] } } });
+
+		await expect(updateBirthday(birthdayForm("2001-12-31"))).resolves.toEqual({ success: true });
+		expect(sentBirthday()).toBe("2001-12-31");
+	});
+
+	it("clears the birthday by sending null when the value is empty", async () => {
+		mutate.mockResolvedValue({ ok: true, data: { accountUpdate: { user: { id: "1" }, errors: [] } } });
+
+		await expect(updateBirthday(birthdayForm(""))).resolves.toEqual({ success: true });
+		expect(sentBirthday()).toBeNull();
+	});
+
+	it("maps the core INVALID error to the localized invalidBirthday key and reports no success", async () => {
+		mutate.mockResolvedValue({
+			ok: true,
+			data: {
+				accountUpdate: {
+					user: null,
+					errors: [{ field: "birthday", code: "INVALID", message: "Invalid birthday." }],
+				},
+			},
+		});
+
+		const result = await updateBirthday(birthdayForm("2999-01-01"));
+
+		expect(result).toEqual({ success: false, errorKey: "invalidBirthday" });
+		expect(JSON.stringify(result)).not.toContain("Invalid birthday.");
+		expect(refresh).not.toHaveBeenCalled();
+	});
+
+	it("uses the generic key for other account errors instead of echoing their message", async () => {
+		mutate.mockResolvedValue({
+			ok: true,
+			data: {
+				accountUpdate: {
+					user: null,
+					errors: [{ field: "birthday", code: "PERMISSION_DENIED", message: "1990-07-01 is denied" }],
+				},
+			},
+		});
+
+		const result = await updateBirthday(birthdayForm("1990-07-01"));
+
+		expect(result).toEqual({ success: false, errorKey: "updateBirthdayFailed" });
+		expect(JSON.stringify(result)).not.toContain("1990-07-01");
+	});
+
+	it("uses the generic key on a transport or GraphQL failure without echoing the value", async () => {
+		mutate.mockResolvedValue({
+			ok: false,
+			error: { type: "graphql", message: "Date cannot represent 1990-07-01" },
+		});
+
+		const result = await updateBirthday(birthdayForm("1990-07-01"));
+
+		expect(result).toEqual({ success: false, errorKey: "updateBirthdayFailed" });
+		expect(JSON.stringify(result)).not.toContain("1990-07-01");
+	});
+
+	it("rejects a malformed date before calling Saleor", async () => {
+		await expect(updateBirthday(birthdayForm("1990-02-30"))).resolves.toEqual({
+			success: false,
+			errorKey: "invalidBirthday",
+		});
+		expect(mutate).not.toHaveBeenCalled();
+	});
+
+	it("treats a missing form field as invalid input", async () => {
+		await expect(updateBirthday(birthdayForm(null))).resolves.toEqual({
+			success: false,
+			errorKey: "invalidBirthday",
+		});
+		expect(mutate).not.toHaveBeenCalled();
+	});
+
+	it("never logs the submitted birthday", async () => {
+		mutate.mockResolvedValue({ ok: false, error: { type: "network", message: "down" } });
+
+		await updateBirthday(birthdayForm("1990-07-01"));
+
+		for (const spy of consoleSpies) {
+			expect(spy).not.toHaveBeenCalled();
+		}
+	});
+});
