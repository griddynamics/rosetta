+	// Pass-through: run the fetch the way the real resolver would once a session exists.
+	resolveSessionUser: async (fetch: () => Promise<unknown>) => {
+		const result = await fetch();
+		return stateRef.current ?? result;
+	},
+}));
+
+import { CurrentUserProfileDocument } from "@/gql/graphql";
+import { getSessionAgeState } from "@/lib/account/get-session-age-state";
