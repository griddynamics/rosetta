+	/** Server action run on submit; its result drives the CTA or the error text. */
+	action: (previous: AddToCartResult | null, formData: FormData) => Promise<AddToCartResult>;
+	/** Server-rendered variant selection, placed above the buy box. */
+	buyBox: ReactNode;
+	/** CTA decided on the server from session state (null when none applies). */
+	cta: AgeRestrictionCta | null;
+	productName: string;
