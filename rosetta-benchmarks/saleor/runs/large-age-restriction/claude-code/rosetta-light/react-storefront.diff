index 0000000..a703f1c
--- /dev/null
+++ b/src/lib/auth/safe-return-path.ts
@@ -0,0 +1,37 @@
+/**
+ * Post-login `returnTo` accepted only as a same-origin relative path.
+ * `window.location.assign` follows whatever it gets, so anything that could become an
+ * absolute or protocol-relative URL is rejected. The check runs on the NORMALISED path:
+ * dot segments can turn a safe-looking input into `//host` (e.g. `/..//host`).
+ */
+const PROBE_ORIGIN = "https://storefront.invalid";
+
+// Control characters and backslashes: browsers normalise `\` to `/`, which can turn `/\host` into `//host`.
+const FORBIDDEN_CHARS = /[\u0000-\u001f\u007f\\]/;
+
+/** Returns a normalised same-origin path (`/x?y#z`), or null when the value is not safe. */
+export function getSafeReturnPath(value: string | null | undefined): string | null {
+	if (!value || !value.startsWith("/") || FORBIDDEN_CHARS.test(value)) {
+		return null;
+	}
+
+	let url: URL;
+	try {
+		url = new URL(value, PROBE_ORIGIN);
+	} catch {
+		return null;
+	}
+
+	if (url.origin !== PROBE_ORIGIN) {
+		return null;
+	}
+
+	const path = `${url.pathname}${url.search}${url.hash}`;
+
+	// The normalised path must still be a single-slash path. `//host` would be protocol-relative.
+	if (!path.startsWith("/") || path.startsWith("//") || FORBIDDEN_CHARS.test(path)) {
+		return null;
+	}
+
+	return path;
+}
