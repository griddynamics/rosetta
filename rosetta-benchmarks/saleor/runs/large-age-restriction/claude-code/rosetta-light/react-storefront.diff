+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it, vi } from "vitest";
+
+// Translator echoes the key so assertions read as message keys.
+vi.mock("next-intl", () => ({ useTranslations: () => (key: string) => key }));
+vi.mock("@/lib/chrome-sync", () => ({ bumpChromeVersion: vi.fn() }));
+
+import { AddToCart } from "@/ui/components/pdp/add-to-cart";
+
+const links = {
+	signIn: "/en/ch/login?returnTo=%2Fen%2Fch%2Fproducts%2Fwine",
+	setBirthday: "/en/ch/account/settings",
+};
+
+function render(overrides: Partial<Parameters<typeof AddToCart>[0]> = {}) {
+	return renderToStaticMarkup(
+		createElement(AddToCart, {
+			price: "$10.00",
+			secureCheckoutLabel: "Secure checkout",
+			cta: null,
+			links,
+			...overrides,
+		}),
+	);
+}
+
+describe("AddToCart", () => {
+	it("renders the submit add button for an unrestricted product", () => {
+		const html = render();
+
+		expect(html).toContain('type="submit"');
+		expect(html).toContain("addToBag");
+		expect(html).not.toContain("ageRestriction");
+	});
+
+	it("renders a sign-in link with the return path for a guest on a restricted product", () => {
+		const html = render({ cta: "sign-in" });
+
+		expect(html).toContain("ageRestriction.loginRequired");
+		expect(html).toContain(`href="${links.signIn}"`);
+		expect(html).toContain("ageRestriction.signInCta");
+		expect(html).not.toContain('type="submit"');
+	});
+
+	it("renders a birthday settings link when the signed-in customer has no birthday", () => {
+		const html = render({ cta: "set-birthday" });
+
+		expect(html).toContain("ageRestriction.birthdayRequired");
+		expect(html).toContain(`href="${links.setBirthday}"`);
+		expect(html).not.toContain(links.signIn);
+	});
+
+	it("renders the underage copy with a disabled add button and no link for a minor", () => {
+		const html = render({ cta: "underage" });
+
+		expect(html).toContain("ageRestriction.underage");
+		expect(html).toContain("disabled");
+		expect(html).not.toContain("href=");
+	});
+
+	it("shows the add-to-cart failure text with an alert role", () => {
+		const html = render({ errorText: "Only 1 left" });
+
+		expect(html).toContain('role="alert"');
+		expect(html).toContain("Only 1 left");
+	});
+});
