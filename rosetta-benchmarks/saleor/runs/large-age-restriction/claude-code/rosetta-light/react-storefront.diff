+
+	it("labels only the restricted order line on the order confirmation", () => {
+		const html = renderSummary({ order }, AGE_18);
+
+		expect(countBadges(html)).toBe(1);
+		expect(html).toContain('<span aria-hidden="true">18+</span>');
+	});
+
+	it("renders no label when the checkout tree passes no age config", () => {
+		expect(countBadges(renderSummary({ checkout }, null))).toBe(0);
+		expect(countBadges(renderSummary({ order }, null))).toBe(0);
+	});
+
+	it("keeps the line names and totals next to the label", () => {
+		const html = renderSummary({ order }, AGE_18);
+
+		expect(html).toContain("Whisky");
+		expect(html).toContain("Mug");
+	});
+});
