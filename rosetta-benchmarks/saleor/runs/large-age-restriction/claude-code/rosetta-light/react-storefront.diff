+	showSticky: boolean;
+}
+
+/**
+ * Form shell for the PDP buy box. Keeps the last add-to-cart result so a failure is
+ * shown instead of being silent. An age-restriction code switches to the matching CTA.
+ */
+export function AddToCartForm({
+	action,
+	buyBox,
+	cta,
+	links,
