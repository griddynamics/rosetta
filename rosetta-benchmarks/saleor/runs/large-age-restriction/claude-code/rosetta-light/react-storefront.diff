+	const [result, formAction] = useActionState(action, null);
+
+	const resultCta = result && !result.ok ? getAgeRestrictionCtaFromCode(result.code) : null;
+	const activeCta = resultCta ?? cta;
+	const errorText = result && !result.ok && !resultCta ? result.message || t("addToCartFailed") : null;
+
+	return (
+		<form action={formAction} className="order-3 mt-4 space-y-6">
+			{buyBox}
+
+			<AddToCart {...buttonProps} price={price} cta={activeCta} links={links} errorText={errorText} />
+
+			<StickyBar
+				productName={productName}
+				nameBadge={nameBadge}
+				price={price}
+				show={showSticky && !activeCta}
+				errorText={errorText}
+			/>
+		</form>
+	);
+}
