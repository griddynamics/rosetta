diff --git a/src/ui/sections/editorial-hero/editorial-hero.test.ts b/src/ui/sections/editorial-hero/editorial-hero.test.ts
new file mode 100644
index 0000000..7ea2ab7
--- /dev/null
+++ b/src/ui/sections/editorial-hero/editorial-hero.test.ts
@@ -0,0 +1,40 @@
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+import type { AgeRestrictionConfig } from "@/lib/custom/age-restriction-types";
+import { ProductAgeLabel } from "@/ui/components/age-restriction-badge";
+import { EditorialHero } from "./editorial-hero";
+
+const AGE_18: AgeRestrictionConfig = {
+	minimumAge: 18,
+	copy: { label: "{age}+", neutral: "Age restricted", srLabel: "Age restricted: {age}+" },
+};
+
+function render(imageBadge?: ReturnType<typeof createElement>) {
+	return renderToStaticMarkup(
+		createElement(EditorialHero, {
+			heading: "Spring edit",
+			image: "/packshot.webp",
+			imageAlt: "Bottle",
+			imageBadge,
+		}),
+	);
+}
+
+describe("EditorialHero packshot label (homepage hero of a restricted product)", () => {
+	it("draws the '18+' label on the packshot when the hero product is restricted", () => {
+		const html = render(createElement(ProductAgeLabel, { isAgeRestricted: true, ageRestriction: AGE_18 }));
+		expect(html).toContain('data-testid="age-restriction-badge"');
+		expect(html).toContain("18+");
+	});
+
+	it("draws no label when the hero product is unrestricted", () => {
+		const html = render(createElement(ProductAgeLabel, { isAgeRestricted: false, ageRestriction: AGE_18 }));
+		expect(html).not.toContain("age-restriction-badge");
+		expect(html).toContain("packshot");
+	});
+
+	it("draws no label when no badge slot is passed", () => {
+		expect(render()).not.toContain("age-restriction-badge");
+	});
+});
