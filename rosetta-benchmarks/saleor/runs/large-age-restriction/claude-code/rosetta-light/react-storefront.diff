+import { describe, expect, it } from "vitest";
+import {
+	buildAgeRestrictionLinks,
+	getAgeRestrictionCtaFromCode,
+	getPdpAgeRestrictionCta,
+	type PdpSessionState,
+} from "@/lib/account/age-restriction-cta";
+
+const guest: PdpSessionState = { status: "guest" };
+const noBirthday: PdpSessionState = { status: "authenticated", hasBirthday: false, isAgeEligible: null };
+const adult: PdpSessionState = { status: "authenticated", hasBirthday: true, isAgeEligible: true };
+const minor: PdpSessionState = { status: "authenticated", hasBirthday: true, isAgeEligible: false };
+const unavailable: PdpSessionState = { status: "unavailable" };
+
+describe("getPdpAgeRestrictionCta", () => {
+	it.each<[string, PdpSessionState | null, "sign-in" | "set-birthday" | "underage" | null]>([
+		["guest", guest, "sign-in"],
+		["signed in, no birthday", noBirthday, "set-birthday"],
+		["signed in, under age", minor, "underage"],
+		["signed in, adult", adult, null],
+		["session unavailable", unavailable, null],
+		["session not loaded", null, null],
+	])("restricted product, %s", (_label, session, expected) => {
+		expect(getPdpAgeRestrictionCta({ isAgeRestricted: true, session })).toBe(expected);
+	});
+
+	it.each<[string, PdpSessionState]>([
+		["guest", guest],
+		["no birthday", noBirthday],
+		["minor", minor],
+		["adult", adult],
+	])("unrestricted product never shows a CTA (%s)", (_label, session) => {
+		expect(getPdpAgeRestrictionCta({ isAgeRestricted: false, session })).toBeNull();
+	});
+
+	it("treats unknown eligibility (null) with a birthday as no CTA, so the server decides", () => {
+		const unknown: PdpSessionState = { status: "authenticated", hasBirthday: true, isAgeEligible: null };
+		expect(getPdpAgeRestrictionCta({ isAgeRestricted: true, session: unknown })).toBeNull();
+	});
+});
+
+describe("getAgeRestrictionCtaFromCode", () => {
+	it.each([
+		["AGE_RESTRICTION_LOGIN_REQUIRED", "sign-in"],
+		["AGE_RESTRICTION_BIRTHDAY_REQUIRED", "set-birthday"],
+		["AGE_RESTRICTION_UNDERAGE", "underage"],
+	])("maps %s to %s", (code, expected) => {
+		expect(getAgeRestrictionCtaFromCode(code)).toBe(expected);
+	});
+
+	it.each([["AGE_RESTRICTION_NOT_ELIGIBLE"], ["INSUFFICIENT_STOCK"], [""], [null], [undefined]])(
+		"returns null for non-storefront code %s",
+		(code) => {
+			expect(getAgeRestrictionCtaFromCode(code)).toBeNull();
+		},
+	);
+});
+
+describe("buildAgeRestrictionLinks", () => {
+	it("builds a sign-in link that returns to the product page, and the birthday settings link", () => {
+		const links = buildAgeRestrictionLinks({
+			locale: "en",
+			channel: "default-channel",
+			productSlug: "red-wine",
+		});
+
+		expect(links.signIn).toBe(
+			"/en/default-channel/login?returnTo=" + encodeURIComponent("/en/default-channel/products/red-wine"),
+		);
+		expect(links.setBirthday).toBe("/en/default-channel/account/settings");
+	});
+
+	it("encodes the product slug so it cannot inject extra path or query segments", () => {
+		const links = buildAgeRestrictionLinks({ locale: "en", channel: "ch", productSlug: "a/b?c=d" });
+
+		expect(links.signIn).not.toContain("?c=d&");
+		expect(decodeURIComponent(links.signIn.split("returnTo=")[1])).toBe("/en/ch/products/a%2Fb%3Fc%3Dd");
+	});
+});
diff --git a/src/lib/account/age-restriction-cta.ts b/src/lib/account/age-restriction-cta.ts
new file mode 100644
index 0000000..1baa1ec
--- /dev/null
+++ b/src/lib/account/age-restriction-cta.ts
@@ -0,0 +1,76 @@
+import { buildStorefrontPath } from "@/lib/storefront-path";
+
+/**
+ * Purchase call-to-action for an age-restricted product (PDP add-to-cart and quick-add).
+ * Pure: no Saleor, no cookies. The session input comes from {@link getSessionAgeState}.
+ */
+export type AgeRestrictionCta = "sign-in" | "set-birthday" | "underage";
+
+/** Signed-in state reduced to what the CTA needs. The birthday value itself is never kept. */
+export type PdpSessionState =
+	| { status: "guest" }
+	| { status: "authenticated"; hasBirthday: boolean; isAgeEligible: boolean | null }
+	| { status: "unavailable" };
+
+export type AgeRestrictionLinks = {
+	signIn: string;
+	setBirthday: string;
+};
+
+/**
+ * CTA shown instead of add-to-cart on a restricted product, decided from session state.
+ * `unavailable` shows no CTA: the add attempt still runs and the server result decides.
+ */
+export function getPdpAgeRestrictionCta(input: {
+	isAgeRestricted: boolean;
+	session: PdpSessionState | null;
+}): AgeRestrictionCta | null {
+	const { isAgeRestricted, session } = input;
+	if (!isAgeRestricted || !session) {
+		return null;
+	}
+
+	switch (session.status) {
+		case "guest":
+			return "sign-in";
+		case "authenticated":
+			if (!session.hasBirthday) {
+				return "set-birthday";
+			}
+			return session.isAgeEligible === false ? "underage" : null;
+		case "unavailable":
+			return null;
+	}
+}
+
+/** Maps a core checkout error code (add-to-cart, checkout) to the CTA it should surface. */
+export function getAgeRestrictionCtaFromCode(code: string | null | undefined): AgeRestrictionCta | null {
+	switch (code) {
+		case "AGE_RESTRICTION_LOGIN_REQUIRED":
+			return "sign-in";
+		case "AGE_RESTRICTION_BIRTHDAY_REQUIRED":
+			return "set-birthday";
+		case "AGE_RESTRICTION_UNDERAGE":
+			return "underage";
+		default:
+			return null;
+	}
+}
+
+/**
+ * Sign-in links carry the PDP path as `returnTo`. The path is built here from the
+ * product slug only, never from user input.
+ */
+export function buildAgeRestrictionLinks(input: {
+	locale: string;
+	channel: string;
+	productSlug: string;
+}): AgeRestrictionLinks {
+	const { locale, channel, productSlug } = input;
+	const productPath = buildStorefrontPath(locale, channel, `/products/${encodeURIComponent(productSlug)}`);
+
+	return {
+		signIn: `${buildStorefrontPath(locale, channel, "/login")}?returnTo=${encodeURIComponent(productPath)}`,
+		setBirthday: buildStorefrontPath(locale, channel, "/account/settings"),
+	};
+}
