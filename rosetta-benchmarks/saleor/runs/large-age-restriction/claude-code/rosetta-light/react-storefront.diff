+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+import type { AgeRestrictionConfig } from "@/ui/components/age-restriction-badge";
+import type { ProductCardData } from "./product-card-data";
+import { ProductCardBase } from "./product-card-base";
+
+function card(overrides: Partial<ProductCardData> = {}): ProductCardData {
+	return {
+		id: "p-1",
+		name: "Cabernet Reserve",
+		slug: "cabernet-reserve",
+		price: 42,
+		currency: "USD",
+		localeBcp47: "en-US",
+		image: "/placeholder.svg",
+		href: "/en/default-channel/products/cabernet-reserve",
+		...overrides,
+	};
+}
+
+const AGE_21: AgeRestrictionConfig = {
+	minimumAge: 21,
+	copy: { label: "{age}+", neutral: "Age restricted", srLabel: "Age restricted: {age}+" },
+};
+
+function render(product: ProductCardData, ageRestriction?: AgeRestrictionConfig) {
+	return renderToStaticMarkup(createElement(ProductCardBase, { product, ageRestriction }));
