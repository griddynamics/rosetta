new file mode 100644
index 0000000..0ed546c
--- /dev/null
+++ b/src/ui/components/age-restriction-badge.test.ts
@@ -0,0 +1,103 @@
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+import {
+	AgeRestrictionBadge,
+	fillAgePattern,
+	resolveAgeRestrictionText,
+	validMinimumAge,
+	type AgeRestrictionCopy,
+} from "./age-restriction-badge";
+
+const COPY: AgeRestrictionCopy = {
+	label: "{age}+",
+	neutral: "Age restricted",
+	srLabel: "Age restricted: {age}+",
+};
+
+describe("age restriction badge (TC-V-04: shown only for restricted products)", () => {
+	it("returns no text for unrestricted products (false, undefined, null)", () => {
+		for (const isAgeRestricted of [false, undefined, null]) {
+			expect(resolveAgeRestrictionText({ isAgeRestricted, minimumAge: 18, copy: COPY })).toBeNull();
+		}
+	});
+
+	it("returns label text for isAgeRestricted=true", () => {
+		expect(resolveAgeRestrictionText({ isAgeRestricted: true, minimumAge: 18, copy: COPY })).toEqual({
+			visible: "18+",
+			screenReader: "Age restricted: 18+",
+		});
+	});
+
+	it("renders nothing to markup for unrestricted products", () => {
+		const html = renderToStaticMarkup(
+			createElement(AgeRestrictionBadge, { isAgeRestricted: false, minimumAge: 18, copy: COPY }),
+		);
+		expect(html).toBe("");
+	});
+});
+
+describe("age restriction badge (TC-V-05: label uses the configured shop age)", () => {
+	it("shows the configured age (21 -> 21+), not a hardcoded 18", () => {
+		expect(resolveAgeRestrictionText({ isAgeRestricted: true, minimumAge: 21, copy: COPY })?.visible).toBe(
+			"21+",
+		);
+	});
+
+	it("shows 18+ when the shop setting is the default 18", () => {
+		expect(resolveAgeRestrictionText({ isAgeRestricted: true, minimumAge: 18, copy: COPY })?.visible).toBe(
+			"18+",
+		);
+	});
+
+	it("accepts the shop range edges N=1 and N=120", () => {
+		expect(resolveAgeRestrictionText({ isAgeRestricted: true, minimumAge: 1, copy: COPY })?.visible).toBe(
+			"1+",
+		);
+		expect(resolveAgeRestrictionText({ isAgeRestricted: true, minimumAge: 120, copy: COPY })?.visible).toBe(
+			"120+",
+		);
+	});
+
+	it("falls back to the neutral copy when N is missing or out of range (no silent wrong number)", () => {
+		for (const minimumAge of [null, undefined, 0, 121, -3, 18.5, Number.NaN]) {
+			expect(resolveAgeRestrictionText({ isAgeRestricted: true, minimumAge, copy: COPY })).toEqual({
+				visible: "Age restricted",
+				screenReader: "Age restricted",
+			});
+		}
+	});
+
+	it("renders the visible label and the screen-reader sentence", () => {
+		const html = renderToStaticMarkup(
+			createElement(AgeRestrictionBadge, { isAgeRestricted: true, minimumAge: 21, copy: COPY }),
+		);
+		expect(html).toContain('data-testid="age-restriction-badge"');
+		expect(html).toContain('<span aria-hidden="true">21+</span>');
+		expect(html).toContain('<span class="sr-only">Age restricted: 21+</span>');
+	});
+
+	it("renders neutral copy in markup when N is unknown", () => {
+		const html = renderToStaticMarkup(
+			createElement(AgeRestrictionBadge, { isAgeRestricted: true, minimumAge: null, copy: COPY }),
+		);
+		expect(html).toContain("Age restricted");
+		expect(html).not.toMatch(/\d\+/);
+	});
+});
+
+describe("age restriction helpers", () => {
+	it("validMinimumAge accepts whole numbers 1..120 only", () => {
+		expect(validMinimumAge(1)).toBe(1);
+		expect(validMinimumAge(120)).toBe(120);
+		expect(validMinimumAge(0)).toBeNull();
+		expect(validMinimumAge(121)).toBeNull();
+		expect(validMinimumAge(18.5)).toBeNull();
+		expect(validMinimumAge(null)).toBeNull();
+		expect(validMinimumAge(undefined)).toBeNull();
+	});
+
+	it("fillAgePattern replaces every {age} placeholder", () => {
+		expect(fillAgePattern("{age}+ ({age})", 21)).toBe("21+ (21)");
+	});
+});
diff --git a/src/ui/components/age-restriction-badge.tsx b/src/ui/components/age-restriction-badge.tsx
new file mode 100644
index 0000000..e6b4b7e
--- /dev/null
+++ b/src/ui/components/age-restriction-badge.tsx
@@ -0,0 +1,94 @@
+import { cn } from "@/lib/utils";
+import type { AgeRestrictionConfig, AgeRestrictionCopy } from "@/lib/custom/age-restriction-types";
+
+export type { AgeRestrictionConfig, AgeRestrictionCopy };
+
+export type AgeRestrictionText = {
+	visible: string;
+	screenReader: string;
+};
+
+/** Shop accepts 1..120 (`ageRestrictionMinimumAge`). Anything else is treated as unknown. */
+export function validMinimumAge(value: number | null | undefined): number | null {
+	return typeof value === "number" && Number.isInteger(value) && value >= 1 && value <= 120 ? value : null;
+}
+
+export function fillAgePattern(pattern: string, age: number): string {
+	return pattern.replaceAll("{age}", String(age));
+}
+
+/**
+ * Label text for a product. Null when the product is not age-restricted (no badge).
+ * Restricted products always get text: the number when N is known, the neutral copy otherwise.
+ */
+export function resolveAgeRestrictionText({
+	isAgeRestricted,
+	minimumAge,
+	copy,
+}: {
+	isAgeRestricted: boolean | null | undefined;
+	minimumAge: number | null | undefined;
+	copy: AgeRestrictionCopy;
+}): AgeRestrictionText | null {
+	if (isAgeRestricted !== true) return null;
+	const age = validMinimumAge(minimumAge);
+	if (age === null) return { visible: copy.neutral, screenReader: copy.neutral };
+	return {
+		visible: fillAgePattern(copy.label, age),
+		screenReader: fillAgePattern(copy.srLabel, age),
+	};
+}
+
+export type AgeRestrictionBadgeProps = {
+	isAgeRestricted?: boolean | null;
+	minimumAge?: number | null;
+	copy: AgeRestrictionCopy;
+	className?: string;
+};
+
+export type ProductAgeLabelProps = {
+	isAgeRestricted?: boolean | null;
+	/** Shop config from `getAgeRestrictionConfig`. Absent on a surface means no label. */
+	ageRestriction?: AgeRestrictionConfig | null;
+	className?: string;
+};
+
+/**
+ * "{N}+" label for a product line or packshot. Renders nothing when the product is not
+ * restricted or no config is passed. Every surface that shows a product line uses this one component.
+ */
+export function ProductAgeLabel({ isAgeRestricted, ageRestriction, className }: ProductAgeLabelProps) {
+	if (!ageRestriction) return null;
+	return (
+		<AgeRestrictionBadge
+			isAgeRestricted={isAgeRestricted}
+			minimumAge={ageRestriction.minimumAge}
+			copy={ageRestriction.copy}
+			className={className}
+		/>
+	);
+}
+
+/** Presentational "{N}+" chip. Renders nothing for unrestricted products. */
+export function AgeRestrictionBadge({
+	isAgeRestricted,
+	minimumAge,
+	copy,
+	className,
+}: AgeRestrictionBadgeProps) {
+	const text = resolveAgeRestrictionText({ isAgeRestricted, minimumAge, copy });
+	if (!text) return null;
+
+	return (
+		<span
+			className={cn(
+				"inline-flex items-center rounded-full border border-border bg-background px-2 py-0.5 text-xs font-semibold tabular-nums text-foreground",
+				className,
+			)}
+			data-testid="age-restriction-badge"
+		>
+			<span aria-hidden="true">{text.visible}</span>
+			<span className="sr-only">{text.screenReader}</span>
+		</span>
+	);
+}
