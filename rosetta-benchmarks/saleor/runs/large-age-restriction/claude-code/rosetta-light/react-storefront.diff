+/**
+ * Variable names whose values are personal data or secrets. Their values are replaced
+ * before any log line is built (S§2 NFR-7: birthday never in logs; email and credentials
+ * are treated the same way). Matched case-insensitively on the key name, at any depth.
+ */
+const REDACTED_LOG_KEYS = /^(birthday|password|newPassword|oldPassword|email|token|refreshToken|secret)$/i;
+
+function redactForLog(value: unknown, key?: string): unknown {
+	if (key !== undefined && REDACTED_LOG_KEYS.test(key)) return "[redacted]";
+	if (Array.isArray(value)) return value.map((item) => redactForLog(item));
+	if (value !== null && typeof value === "object") {
+		return Object.fromEntries(Object.entries(value).map(([k, v]) => [k, redactForLog(v, k)]));
+	}
+	return value;
+}
