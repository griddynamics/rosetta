diff --git a/saleor/checkout/tests/test_create_order_voucher_age_restriction.py b/saleor/checkout/tests/test_create_order_voucher_age_restriction.py
new file mode 100644
index 0000000..4e97e82
--- /dev/null
+++ b/saleor/checkout/tests/test_create_order_voucher_age_restriction.py
@@ -0,0 +1,116 @@
+"""Voucher usage and the age restriction on the transaction completion flow.
+
+`create_order_from_checkout` increments the voucher usage in its own block before it
+validates the age restriction. An age failure must release that usage, the same way an
+InsufficientStock failure does, so the customer does not consume a limited voucher on a
+purchase that never happens.
+"""
+
+import pytest
+
+from ...account.age_restriction import AgeRestrictionError
+from ...account.tests.fixtures.age_restriction import set_age_settings
+from ...discount.models import VoucherCode, VoucherCustomer
+from ...plugins.manager import get_plugins_manager
+from ..complete_checkout import create_order_from_checkout
+from ..fetch import fetch_checkout_info, fetch_checkout_lines
+from ..models import Checkout
+
+
+def _checkout_info(checkout):
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+    return checkout_info, manager
+
+
+def _prepare_voucher_checkout(
+    checkout_with_voucher, voucher, user, shipping_address, billing_address
+):
+    voucher.usage_limit = 5
+    voucher.apply_once_per_customer = True
+    voucher.save(update_fields=["usage_limit", "apply_once_per_customer"])
+    checkout_with_voucher.user = user
+    checkout_with_voucher.email = user.email
+    checkout_with_voucher.shipping_address = shipping_address
+    checkout_with_voucher.billing_address = billing_address
+    checkout_with_voucher.tracking_code = "tracking_code"
+    checkout_with_voucher.redirect_url = "https://www.example.com"
+    checkout_with_voucher.save()
+    return checkout_with_voucher
+
+
+def test_age_failure_does_not_consume_voucher_usage(
+    checkout_with_voucher,
+    voucher,
+    restricted_product,
+    minor,
+    site_settings,
+    address,
+    app,
+):
+    """An underage customer's failed completion leaves the voucher usage unchanged."""
+    # given
+    set_age_settings(site_settings, minimum_age=18)
+    checkout = _prepare_voucher_checkout(
+        checkout_with_voucher, voucher, minor, address, address
+    )
+    code = VoucherCode.objects.get(code=checkout.voucher_code)
+    used_before = code.used
+    checkout_info, manager = _checkout_info(checkout)
+
+    # when
+    with pytest.raises(AgeRestrictionError):
+        create_order_from_checkout(
+            checkout_info=checkout_info,
+            manager=manager,
+            user=minor,
+            app=app,
+        )
+
+    # then
+    code.refresh_from_db()
+    assert code.used == used_before
+    checkout.refresh_from_db()
+    assert checkout.is_voucher_usage_increased is False
+    assert checkout.completing_started_at is None
+    assert not VoucherCustomer.objects.filter(
+        voucher_code=code, customer_email=minor.email
+    ).exists()
+    assert Checkout.objects.filter(pk=checkout.pk).exists()
+
+
+def test_eligible_customer_consumes_voucher_usage(
+    checkout_with_voucher,
+    voucher,
+    restricted_product,
+    adult,
+    site_settings,
+    address,
+    app,
+):
+    """Control: a completed order keeps the voucher usage increment."""
+    # given
+    set_age_settings(site_settings, minimum_age=18)
+    checkout = _prepare_voucher_checkout(
+        checkout_with_voucher, voucher, adult, address, address
+    )
+    code = VoucherCode.objects.get(code=checkout.voucher_code)
+    used_before = code.used
+    checkout_info, manager = _checkout_info(checkout)
+
+    # when
+    order = create_order_from_checkout(
+        checkout_info=checkout_info,
+        manager=manager,
+        user=adult,
+        app=app,
+    )
+
+    # then
+    assert order is not None
+    code.refresh_from_db()
+    assert code.used == used_before + 1
+    assert VoucherCustomer.objects.filter(
+        voucher_code=code, customer_email=adult.email
+    ).exists()
