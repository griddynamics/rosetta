+                id
+                name
+                isAgeRestricted
+            }
+            errors {
+                field
+                code
+                message
+            }
+        }
+    }
+"""
+
+
+def _product_id(product):
+    return graphene.Node.to_global_id("Product", product.pk)
+
+
+def test_update_product_sets_is_age_restricted_true(
+    staff_api_client, product, permission_manage_products
+):
+    """TC-H-08 (productUpdate): flag true is stored and returned."""
+    # given
+    assert product.is_age_restricted is False
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_UPDATE_AGE_RESTRICTED_MUTATION,
+        {"id": _product_id(product), "input": {"isAgeRestricted": True}},
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert data["errors"] == []
+    assert data["product"]["isAgeRestricted"] is True
+    product.refresh_from_db()
+    assert product.is_age_restricted is True
+
+
+def test_update_product_without_flag_keeps_is_age_restricted(
+    staff_api_client, restricted_product, permission_manage_products
+):
+    """TC-H-08 negative: an omitted flag is left unchanged by a partial update."""
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_UPDATE_AGE_RESTRICTED_MUTATION,
+        {"id": _product_id(restricted_product), "input": {"name": "Renamed"}},
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert data["errors"] == []
+    assert data["product"]["isAgeRestricted"] is True
+    restricted_product.refresh_from_db()
+    assert restricted_product.is_age_restricted is True
+
+
+def test_update_product_null_is_age_restricted_resets_to_false(
+    staff_api_client, restricted_product, permission_manage_products
+):
