+import graphene
+
+from .....product.models import Product
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+PRODUCT_CREATE_AGE_RESTRICTED_MUTATION = """
+    mutation createProduct($input: ProductCreateInput!) {
+        productCreate(input: $input) {
+            product {
+                id
+                isAgeRestricted
+            }
+            errors {
+                field
+                code
+                message
+            }
+        }
+    }
+"""
+
+
+def _create_input(product_type, **extra):
+    return {
+        "input": {
+            "name": "Age restricted product",
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            **extra,
+        }
+    }
+
+
+def test_create_product_with_is_age_restricted_true_is_stored(
+    staff_api_client, product_type, permission_manage_products
+):
