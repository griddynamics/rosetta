+"""orderCreateFromCheckout age restriction (S§5 #7, S§10 app surface).
+
+Covers TC-H-03 (guest with an adult's email: LOGIN_REQUIRED, no order), the app-facing
+code mapping (BIRTHDAY_REQUIRED and UNDERAGE collapse to NOT_ELIGIBLE), TC-H-02 for the
+app path, and TC-E-06 (generic message, no PII). Completion is the authority; the app
+mutation reaches the same `create_order_from_checkout` check as checkoutComplete.
+"""
+
+import graphene
+
+from .....checkout.models import Checkout
+from .....order.models import Order
+from ....tests.utils import get_graphql_content
+
+MUTATION_ORDER_CREATE_FROM_CHECKOUT = """
+mutation orderCreateFromCheckout($id: ID!) {
+  orderCreateFromCheckout(id: $id) {
+    order { id status }
+    errors { field code message }
+  }
+}
+"""
+
+NOT_ELIGIBLE_MESSAGE = "The customer is not eligible to buy age-restricted products."
+LOGIN_REQUIRED_MESSAGE = "Sign in to buy age-restricted products."
+
+
+def _gid(type_name, pk):
+    return graphene.Node.to_global_id(type_name, pk)
+
+
+def _set_checkout_user(checkout, user, email=None):
+    checkout.user = user
+    if email is not None:
+        checkout.email = email
+    checkout.save(update_fields=["user", "email"])
+    return checkout
+
+
+def _create_order(app_api_client, permission_handle_checkouts, checkout):
+    response = app_api_client.post_graphql(
+        MUTATION_ORDER_CREATE_FROM_CHECKOUT,
+        {"id": _gid("Checkout", checkout.token)},
+        permissions=[permission_handle_checkouts],
+    )
+    return get_graphql_content(response)["data"]["orderCreateFromCheckout"]
+
+
+def test_guest_with_adult_email_login_required_no_order(
+    app_api_client,
+    permission_handle_checkouts,
+    adult,
+    checkout_ready_to_complete,
+    restricted_product,
+):
+    """TC-H-03 / S-2 on the app surface: an adult's email never passes a guest."""
+    # given
+    checkout = _set_checkout_user(checkout_ready_to_complete, None, adult.email)
+    orders_before = Order.objects.count()
+
+    # when
+    payload = _create_order(app_api_client, permission_handle_checkouts, checkout)
+
+    # then
+    assert payload["order"] is None
+    assert payload["errors"][0]["code"] == "AGE_RESTRICTION_LOGIN_REQUIRED"
+    assert payload["errors"][0]["message"] == LOGIN_REQUIRED_MESSAGE
+    assert Order.objects.count() == orders_before
+    assert Checkout.objects.filter(pk=checkout.pk).exists()
+    checkout.refresh_from_db()
+    assert checkout.user is None
+
+
+def test_guest_without_email_login_required(
+    app_api_client,
+    permission_handle_checkouts,
+    checkout_ready_to_complete,
+    restricted_product,
+):
+    """TC-E-01 / S§5 #7: no stored customer maps to LOGIN_REQUIRED."""
+    # given
+    checkout = _set_checkout_user(checkout_ready_to_complete, None, "guest@example.com")
+
+    # when
+    payload = _create_order(app_api_client, permission_handle_checkouts, checkout)
+
+    # then
+    assert payload["order"] is None
+    assert payload["errors"][0]["code"] == "AGE_RESTRICTION_LOGIN_REQUIRED"
+
+
+def test_minor_customer_not_eligible_for_app(
+    app_api_client,
+    permission_handle_checkouts,
+    minor,
+    checkout_ready_to_complete,
+    restricted_product,
+):
+    """S§10: an underage customer maps to NOT_ELIGIBLE for app callers."""
+    # given
+    checkout = _set_checkout_user(checkout_ready_to_complete, minor)
+
+    # when
+    payload = _create_order(app_api_client, permission_handle_checkouts, checkout)
+
+    # then
+    assert payload["order"] is None
+    assert payload["errors"][0]["code"] == "AGE_RESTRICTION_NOT_ELIGIBLE"
+    assert payload["errors"][0]["message"] == NOT_ELIGIBLE_MESSAGE
+    assert "2012" not in repr(payload)
+
+
+def test_no_birthday_customer_not_eligible_for_app(
+    app_api_client,
+    permission_handle_checkouts,
+    no_bday,
+    checkout_ready_to_complete,
+    restricted_product,
+):
+    """S§10: BIRTHDAY_REQUIRED collapses into NOT_ELIGIBLE for app callers (I-2)."""
+    # given
+    checkout = _set_checkout_user(checkout_ready_to_complete, no_bday)
+
+    # when
+    payload = _create_order(app_api_client, permission_handle_checkouts, checkout)
+
+    # then
+    assert payload["order"] is None
+    assert payload["errors"][0]["code"] == "AGE_RESTRICTION_NOT_ELIGIBLE"
+    assert payload["errors"][0]["message"] == NOT_ELIGIBLE_MESSAGE
+
+
+def test_adult_customer_creates_order_for_app(
+    app_api_client,
+    permission_handle_checkouts,
+    adult,
+    checkout_ready_to_complete,
+    restricted_product,
+):
+    """TC-H-01 app path: an eligible customer's checkout becomes an order."""
+    # given
+    checkout = _set_checkout_user(checkout_ready_to_complete, adult, adult.email)
+
+    # when
+    payload = _create_order(app_api_client, permission_handle_checkouts, checkout)
+
+    # then
+    assert payload["errors"] == []
+    assert payload["order"] is not None
+    order = Order.objects.get(
+        pk=graphene.Node.from_global_id(payload["order"]["id"])[1]
+    )
+    assert order.user == adult
+
+
+def test_unrestricted_guest_checkout_creates_order_for_app(
+    app_api_client,
+    permission_handle_checkouts,
+    checkout_ready_to_complete,
+):
+    """TC-H-02 app path: unrestricted products are unchanged for a guest."""
+    # given
+    checkout = _set_checkout_user(checkout_ready_to_complete, None)
+
+    # when
+    payload = _create_order(app_api_client, permission_handle_checkouts, checkout)
+
+    # then
+    assert payload["errors"] == []
+    assert payload["order"] is not None
+    assert Order.objects.filter(checkout_token=str(checkout.token)).exists()
