+"""TC-P-01: query counts for unrestricted checkouts are unchanged by age restriction.
+
+The complete checkout counts are the S00 baseline rows (`bench-base.json`):
+`test_complete_checkout` = 200 and `test_customer_complete_checkout` = 213. Like those
+baseline tests, the capture window starts before the checkout is prepared (the
+`checkout.save()` is counted), so the numbers are comparable (NFR-1: 0 extra queries
+for unrestricted carts).
+
+The `checkoutLinesAdd` counts are pinned to the values measured on this code for an
+unrestricted variant. They are regression guards for the age guard path, not S00
+rows: the S00 `test_add_checkout_lines` row uses a different fixture set.
+"""
+
+import pytest
+from django.db import connection
+from django.test.utils import CaptureQueriesContext
+
+from ....core.utils import to_global_id_or_none
+from ....tests.fixtures import ApiClient
+from ....tests.utils import get_graphql_content
+from .test_checkout_mutations import (
+    COMPLETE_CHECKOUT_MUTATION,
+    MUTATION_CHECKOUT_LINES_ADD,
+)
+
+GUEST_COMPLETE_QUERY_COUNT = 200
+CUSTOMER_COMPLETE_QUERY_COUNT = 213
+GUEST_LINES_ADD_UNRESTRICTED_QUERY_COUNT = 83
+CUSTOMER_LINES_ADD_UNRESTRICTED_QUERY_COUNT = 86
+
+
+@pytest.mark.django_db
+def test_tc_p_01_complete_checkout_unrestricted_query_count(
+    api_client, checkout_with_charged_payment
+):
+    # given: the checkout holds only unrestricted products
+    variables = {"id": to_global_id_or_none(checkout_with_charged_payment)}
+
+    # when
+    with CaptureQueriesContext(connection) as context:
+        response = get_graphql_content(
+            api_client.post_graphql(COMPLETE_CHECKOUT_MUTATION, variables)
+        )
+
+    # then
+    assert not response["data"]["checkoutComplete"]["errors"]
+    assert len(context.captured_queries) == GUEST_COMPLETE_QUERY_COUNT
+
+
+@pytest.mark.django_db
+def test_tc_p_01_customer_complete_checkout_unrestricted_query_count(
+    api_client, checkout_with_charged_payment, customer_user
+):
+    # given: a logged-in customer completes an unrestricted checkout
+    checkout = checkout_with_charged_payment
+    variables = {"id": to_global_id_or_none(checkout)}
+
+    # when
+    with CaptureQueriesContext(connection) as context:
+        checkout.user = customer_user
+        checkout.save()
+        response = get_graphql_content(
+            api_client.post_graphql(COMPLETE_CHECKOUT_MUTATION, variables)
+        )
+
+    # then
+    assert not response["data"]["checkoutComplete"]["errors"]
+    assert len(context.captured_queries) == CUSTOMER_COMPLETE_QUERY_COUNT
+
+
+@pytest.mark.django_db
+def test_tc_p_01_guest_lines_add_unrestricted_query_count(
+    api_client, checkout, product_with_single_variant
+):
+    # given: a guest adds an unrestricted variant
+    variant = product_with_single_variant.variants.first()
+    variables = {
+        "id": to_global_id_or_none(checkout),
+        "lines": [{"quantity": 1, "variantId": to_global_id_or_none(variant)}],
+    }
+
+    # when
+    with CaptureQueriesContext(connection) as context:
+        response = get_graphql_content(
+            api_client.post_graphql(MUTATION_CHECKOUT_LINES_ADD, variables)
+        )
+
+    # then
+    assert not response["data"]["checkoutLinesAdd"]["errors"]
+    assert len(context.captured_queries) == GUEST_LINES_ADD_UNRESTRICTED_QUERY_COUNT
+
+
+@pytest.mark.django_db
+def test_tc_p_01_customer_lines_add_unrestricted_query_count(
+    checkout, customer_user, product_with_single_variant
