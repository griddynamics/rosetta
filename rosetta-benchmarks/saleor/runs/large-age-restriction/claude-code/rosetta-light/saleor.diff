+def prepare_age_restriction_checkout_validation_error(
+    exc: AgeRestrictionError,
+) -> ValidationError:
+    """Map the domain error to a checkout `lines` error with restricted variant ids.
+
+    The message and params carry no birthday, age or minimum age (NFR-7).
+    """
+    variant_ids = [
+        graphene.Node.to_global_id("ProductVariant", pk) for pk in exc.variant_ids
+    ]
+    return ValidationError(
+        {
+            "lines": ValidationError(
+                AGE_RESTRICTION_MESSAGES[exc.reason],
+                code=AGE_RESTRICTION_CHECKOUT_CODES[exc.reason],
+                params={"variants": variant_ids},
+            )
+        }
+    )
+
+
+def validate_checkout_lines_age_restriction(
+    user: "User | None",
+    variants: Iterable["ProductVariant"],
+    site_settings: "SiteSettings",
+) -> None:
+    """Raise a checkout `lines` error if `user` may not buy the restricted variants.
+
+    Callers pass only the variants being bought and must have `variant.product`
+    loaded. `user` is the checkout customer (stored `checkout.user`, or the requestor
+    for `checkoutCreate`). Callers check for restricted variants before evaluating
+    `user`, so unrestricted carts issue no extra queries.
+    """
+    variants_with_products = [(variant, variant.product) for variant in variants]
+    try:
+        validate_age_restriction(user, variants_with_products, site_settings)
+    except AgeRestrictionError as error:
+        raise prepare_age_restriction_checkout_validation_error(error) from error
+
