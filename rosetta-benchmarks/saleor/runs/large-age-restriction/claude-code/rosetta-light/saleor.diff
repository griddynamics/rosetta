@@ -0,0 +1,291 @@
+"""Restricted products stay visible to everyone; the age rule is enforced at checkout.
+
+REQ-VIS, S§5, S§13 TC-V-01 and TC-V-02. Every catalog route that lists or fetches
+products is run as anonymous, as a minor and as a customer without a birthday. The
+restricted product must come back exactly like an unrestricted control product.
+Dashboard-scope staff must also see it, with `isAgeRestricted` true.
+"""
+
+import graphene
+import pytest
+
+from .....product.models import CollectionProduct
+from .....product.search import update_products_search_vector
+from ....tests.fixtures import ApiClient
+from ....tests.utils import get_graphql_content
+
+PRODUCTS_QUERY = """
+query ($channel: String, $search: String, $where: ProductWhereInput) {
+  products(first: 50, channel: $channel, search: $search, where: $where) {
+    edges { node { id name isAgeRestricted } }
+  }
+}
+"""
+
+PRODUCT_BY_SLUG_QUERY = """
+query ($slug: String!, $channel: String) {
+  product(slug: $slug, channel: $channel) { id name isAgeRestricted }
+}
+"""
+
+PRODUCT_BY_ID_QUERY = """
+query ($id: ID!, $channel: String) {
+  product(id: $id, channel: $channel) { id name isAgeRestricted }
+}
+"""
+
+CATEGORY_PRODUCTS_QUERY = """
+query ($slug: String!, $channel: String) {
+  category(slug: $slug) {
+    products(first: 50, channel: $channel) {
+      edges { node { id isAgeRestricted } }
+    }
+  }
+}
+"""
+
+COLLECTION_PRODUCTS_QUERY = """
+query ($slug: String!, $channel: String) {
+  collection(slug: $slug, channel: $channel) {
+    products(first: 50) {
+      edges { node { id isAgeRestricted } }
+    }
+  }
+}
+"""
+
+
+@pytest.fixture
+def restricted_listed(restricted_product, channel_USD):
+    update_products_search_vector([restricted_product.pk])
+    return restricted_product
+
+
+@pytest.fixture
+def control_product(product_list, channel_USD):
+    # an unrestricted product, published in the same channel
+    control = product_list[0]
+    assert not control.is_age_restricted
+    update_products_search_vector([control.pk])
+    return control
+
+
+@pytest.fixture
+def collection_with_restricted(published_collection, restricted_product):
+    CollectionProduct.objects.get_or_create(
+        collection=published_collection, product=restricted_product
+    )
+    return published_collection
+
+
+@pytest.fixture
+def minor_client(minor):
+    return ApiClient(user=minor)
+
+
+@pytest.fixture
+def no_bday_client(no_bday):
+    return ApiClient(user=no_bday)
+
+
+CLIENT_FIXTURES = ["api_client", "minor_client", "no_bday_client"]
+
+
+def _product_id(product) -> str:
+    return graphene.Node.to_global_id("Product", product.pk)
+
+
+def _ids(content: dict, path: list[str]) -> list[str]:
+    node = content["data"]
+    for key in path:
+        node = node[key]
+    return [edge["node"]["id"] for edge in node["edges"]]
+
+
+@pytest.mark.parametrize("client_fixture", CLIENT_FIXTURES)
+def test_tc_v_01_products_list_returns_restricted_product(
+    client_fixture, request, channel_USD, restricted_listed, control_product
+):
+    # given
+    client = request.getfixturevalue(client_fixture)
+
+    # when
+    content = get_graphql_content(
+        client.post_graphql(PRODUCTS_QUERY, {"channel": channel_USD.slug})
+    )
+
+    # then
+    ids = _ids(content, ["products"])
+    assert _product_id(restricted_listed) in ids
+    assert _product_id(control_product) in ids
+    restricted_node = next(
+        edge["node"]
+        for edge in content["data"]["products"]["edges"]
+        if edge["node"]["id"] == _product_id(restricted_listed)
+    )
+    assert restricted_node["isAgeRestricted"] is True
+
+
+@pytest.mark.parametrize("client_fixture", CLIENT_FIXTURES)
+def test_tc_v_01_products_search_returns_restricted_product(
+    client_fixture, request, channel_USD, restricted_listed
+):
+    # given
+    client = request.getfixturevalue(client_fixture)
+
+    # when
+    content = get_graphql_content(
+        client.post_graphql(
+            PRODUCTS_QUERY,
+            {"channel": channel_USD.slug, "search": restricted_listed.name},
+        )
+    )
+
+    # then
+    assert _product_id(restricted_listed) in _ids(content, ["products"])
+
+
+@pytest.mark.parametrize("client_fixture", CLIENT_FIXTURES)
+def test_tc_v_01_product_by_slug_returns_restricted_product(
+    client_fixture, request, channel_USD, restricted_listed
+):
+    # given
+    client = request.getfixturevalue(client_fixture)
+
+    # when
+    content = get_graphql_content(
+        client.post_graphql(
+            PRODUCT_BY_SLUG_QUERY,
+            {"slug": restricted_listed.slug, "channel": channel_USD.slug},
+        )
