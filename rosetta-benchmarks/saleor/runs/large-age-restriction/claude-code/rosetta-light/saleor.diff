+import graphene
+
+from ....tests.utils import get_graphql_content
+
+PRODUCT_AGE_RESTRICTED_QUERY = """
+    query product($id: ID!, $channel: String) {
+        product(id: $id, channel: $channel) {
+            id
+            isAgeRestricted
+        }
+    }
+"""
+
+PRODUCTS_AGE_RESTRICTED_QUERY = """
+    query products($channel: String) {
+        products(first: 10, channel: $channel) {
+            edges {
+                node {
+                    id
+                    isAgeRestricted
+                }
+            }
+        }
+    }
+"""
+
+
+def test_anonymous_product_query_exposes_is_age_restricted(
+    api_client, restricted_product, channel_USD
+):
+    """TC-H-08 (public read): an anonymous customer sees the flag on a product."""
+    # when
+    response = api_client.post_graphql(
+        PRODUCT_AGE_RESTRICTED_QUERY,
+        {
+            "id": graphene.Node.to_global_id("Product", restricted_product.pk),
+            "channel": channel_USD.slug,
+        },
+    )
+
+    # then
+    content = get_graphql_content(response)
+    assert content["data"]["product"]["isAgeRestricted"] is True
+
+
+def test_anonymous_products_list_keeps_restricted_products_visible(
+    api_client, restricted_product, channel_USD
+):
+    """Restricted products stay visible to guests; only buying is restricted (S§1)."""
+    # when
+    response = api_client.post_graphql(
+        PRODUCTS_AGE_RESTRICTED_QUERY, {"channel": channel_USD.slug}
+    )
+
+    # then
+    content = get_graphql_content(response)
+    nodes = [edge["node"] for edge in content["data"]["products"]["edges"]]
+    restricted_id = graphene.Node.to_global_id("Product", restricted_product.pk)
+    assert {"id": restricted_id, "isAgeRestricted": True} in nodes
