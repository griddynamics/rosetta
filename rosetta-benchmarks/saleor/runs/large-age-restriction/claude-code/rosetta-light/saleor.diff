+    # reject every zone, so the tz database must be present for these tests.
+    assert "Europe/Warsaw" in zoneinfo.available_timezones()
diff --git a/saleor/graphql/shop/tests/mutations/test_shop_settings_update_age_restriction.py b/saleor/graphql/shop/tests/mutations/test_shop_settings_update_age_restriction.py
