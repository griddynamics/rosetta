+"""Birthday privacy matrix for read paths (S§7, S§13 TC-SEC-01..04, TC-SEC-06, TC-SEC-11).
+
+Birthdays are test data only: assertions use typed values, never printed or logged.
+"""
+
+from datetime import date
+
+import graphene
+import pytest
+from django.test import override_settings
+
+from .....account import CustomerEvents
+from .....account.events import customer_birthday_changed_event
+from .....account.models import CustomerEvent, Group, User
+from .....account.tests.fixtures.age_restriction import ADULT_BIRTHDAY
+from .....order import OrderStatus
+from ....tests.fixtures import ApiClient
+from ....tests.utils import get_graphql_content
+
+ME_QUERY = """
+query {
+  me { id birthday isAgeEligible isSuperuser }
+}
+"""
+
+USER_QUERY = """
+query ($id: ID!) {
+  user(id: $id) { id birthday isAgeEligible isSuperuser }
+}
+"""
+
+CUSTOMERS_AND_ALIAS_QUERY = """
+query ($id: ID!) {
+  customers(first: 10) {
+    edges { node { id birthday isAgeEligible } }
+  }
+  alias: user(id: $id) { id birthday isAgeEligible }
+  orders(first: 10) {
+    edges { node { user { id birthday isAgeEligible } } }
+  }
+}
+"""
+
+ORDERS_USER_QUERY = """
+query {
+  orders(first: 10) {
+    edges { node { user { id birthday isAgeEligible isSuperuser } } }
+  }
+}
+"""
+
+CHECKOUT_USER_QUERY = """
+query ($id: ID!) {
+  checkout(id: $id) {
+    user { id birthday isAgeEligible isSuperuser }
+  }
+}
+"""
+
+STAFF_USERS_QUERY = """
+query {
+  staffUsers(first: 10) {
+    edges { node { id birthday isAgeEligible isSuperuser } }
+  }
+}
+"""
+
+ACCOUNT_REGISTER_MUTATION = """
+mutation ($input: AccountRegisterInput!) {
+  accountRegister(input: $input) {
+    user { id birthday isAgeEligible isSuperuser }
+    errors { field code }
+  }
+}
+"""
+
+
+def _user_id(user: User) -> str:
+    return graphene.Node.to_global_id("User", user.pk)
+
+
+def _find_node(edges_nodes: list[dict], user: User) -> dict | None:
+    global_id = _user_id(user)
+    return next(
+        (node for node in edges_nodes if node and node["id"] == global_id), None
+    )
+
+
+def _run(client, query, variables=None, perms=(), *, ignore_errors=False):
+    response = client.post_graphql(
+        query,
+        variables,
+        permissions=list(perms),
+        check_no_permissions=False,
+    )
+    return get_graphql_content(response, ignore_errors=ignore_errors)
+
+
+@pytest.fixture
+def adult_order(order, adult):
+    order.user = adult
+    order.user_email = adult.email
+    order.status = OrderStatus.UNFULFILLED
+    order.save(update_fields=["user", "user_email", "status"])
+    return order
+
+
+def _grant_all_channels(user: User, *permissions) -> None:
+    # `orders` is limited to channels the staff user can access through a group.
+    group = Group.objects.create(
+        name=f"birthday privacy {user.pk}", restricted_access_to_channels=False
+    )
+    group.permissions.add(*permissions)
+    group.user_set.add(user)
+
+
+def _assert_birthday_hidden(node: dict | None) -> None:
+    # A missing node (route denied) or a null value both mean nothing leaked.
+    assert node is None or node["birthday"] is None
+
+
+def test_tc_sec_01_anonymous_register_returns_null_birthday(api_client, channel_USD):
+    # given
+    email = "anon-register-birthday@example.com"
+    variables = {
+        "input": {
+            "email": email,
+            "password": "Str0ng-Passw0rd-42",
+            "redirectUrl": "http://localhost:3000",
+            "channel": channel_USD.slug,
+            "birthday": ADULT_BIRTHDAY.isoformat(),
+        }
+    }
+
+    # when
+    with override_settings(
+        ENABLE_ACCOUNT_CONFIRMATION_BY_EMAIL=True, ALLOWED_CLIENT_HOSTS=["localhost"]
+    ):
+        content = _run(api_client, ACCOUNT_REGISTER_MUTATION, variables)
+
+    # then
+    data = content["data"]["accountRegister"]
+    assert not data["errors"]
+    assert data["user"]["birthday"] is None
+    assert data["user"]["isAgeEligible"] is None
+    assert data["user"]["isSuperuser"] is None
+    # control: the value was stored, so null is the gate, not a missing write
+    created = User.objects.get(email=email)
+    assert created.birthday == ADULT_BIRTHDAY
+
+
+def test_tc_sec_01_anonymous_public_queries_return_no_birthday(api_client, adult):
+    # when
+    content = _run(api_client, USER_QUERY, {"id": _user_id(adult)}, ignore_errors=True)
+    me = _run(api_client, ME_QUERY)
+
+    # then
+    assert content["data"] is None or content["data"]["user"] is None
+    assert me["data"]["me"] is None
+
+
+def test_tc_sec_02_orders_staff_gets_null_birthday_and_flag_on_order_user(
+    staff_api_client, adult_order, adult, permission_manage_orders
+):
+    # given
+    _grant_all_channels(staff_api_client.user, permission_manage_orders)
+
+    # when
+    content = _run(staff_api_client, ORDERS_USER_QUERY)
+
+    # then
+    order_user = content["data"]["orders"]["edges"][0]["node"]["user"]
+    assert order_user["id"] == _user_id(adult)
+    assert order_user["birthday"] is None
+    assert order_user["isAgeEligible"] is None
+    assert order_user["isSuperuser"] is None
+
+
+def test_tc_sec_02_orders_staff_gets_null_birthday_on_checkout_user(
+    staff_api_client, checkout_with_item, adult, permission_manage_orders
+):
+    # given
+    checkout_with_item.user = adult
+    checkout_with_item.email = adult.email
+    checkout_with_item.save(update_fields=["user", "email"])
+    checkout_id = graphene.Node.to_global_id("Checkout", checkout_with_item.pk)
+
+    # when
+    content = _run(
+        staff_api_client,
+        CHECKOUT_USER_QUERY,
+        {"id": checkout_id},
+        perms=[permission_manage_orders],
+        ignore_errors=True,
+    )
+
+    # then
+    checkout = (content.get("data") or {}).get("checkout") or {}
+    _assert_birthday_hidden(checkout.get("user"))
+
+
+def test_tc_sec_02_customer_subject_user_hidden_from_orders_staff(
+    staff_api_client, adult, permission_manage_orders
+):
+    # given
+    customer_birthday_changed_event(user=adult, actor=adult)
+
+    # when
+    content = _run(
+        staff_api_client,
+        USER_QUERY,
+        {"id": _user_id(adult)},
+        perms=[permission_manage_orders],
+        ignore_errors=True,
+    )
+
+    # then
+    user = (content.get("data") or {}).get("user")
+    _assert_birthday_hidden(user)
+
+
+def test_tc_sec_03_manage_users_staff_minor_flag_is_false(
+    staff_api_client, minor, permission_manage_users
+):
+    """TC-SEC-03: the flag is False for an underage customer, birthday stays null."""
+    # when
+    content = _run(
+        staff_api_client,
+        USER_QUERY,
+        {"id": _user_id(minor)},
+        perms=[permission_manage_users],
+    )
+
+    # then
+    assert content["data"]["user"]["birthday"] is None
+    assert content["data"]["user"]["isAgeEligible"] is False
+
+
+def test_tc_sec_03_manage_users_staff_birthday_null_flag_value_one_read_event(
+    staff_api_client,
+    adult_order,
+    adult,
+    permission_manage_users,
+    permission_manage_orders,
+):
+    # given
+    _grant_all_channels(staff_api_client.user, permission_manage_orders)
+
+    # when
+    content = _run(
+        staff_api_client,
+        CUSTOMERS_AND_ALIAS_QUERY,
+        {"id": _user_id(adult)},
+        perms=[permission_manage_users],
+    )
+
+    # then
+    data = content["data"]
+    customer_node = _find_node(
+        [edge["node"] for edge in data["customers"]["edges"]], adult
+    )
+    assert customer_node is not None
+    assert customer_node["birthday"] is None
+    assert customer_node["isAgeEligible"] is True
+
+    assert data["alias"]["birthday"] is None
+    assert data["alias"]["isAgeEligible"] is True
+
+    order_user = data["orders"]["edges"][0]["node"]["user"]
+    assert order_user["id"] == _user_id(adult)
+    assert order_user["birthday"] is None
+    assert order_user["isAgeEligible"] is True
+
+    # exactly one BIRTHDAY_READ for the customer for the whole request, despite
+    # two isAgeEligible reads via customers/alias and order.user
+    reads = CustomerEvent.objects.filter(
+        type=CustomerEvents.BIRTHDAY_READ, user_id=adult.pk
+    )
+    assert reads.count() == 1
+    assert reads.get().parameters == {
+        "customer_id": adult.pk,
+        "actor_user_id": staff_api_client.user.pk,
+    }
+
+
+def test_tc_sec_04_manage_users_and_manage_staff_non_superuser_birthday_null(
+    staff_api_client,
+    adult,
+    staff_user,
+    permission_manage_users,
+    permission_manage_staff,
+):
+    # given
+    staff_with_birthday = User.objects.create(
+        email="staff-with-birthday@example.com",
+        is_staff=True,
+        birthday=ADULT_BIRTHDAY,
+    )
+
+    # when
+    customers = _run(
+        staff_api_client,
+        """
+        query {
+          customers(first: 10) {
+            edges { node { id birthday isSuperuser } }
+          }
+        }
+        """,
+        perms=[permission_manage_users, permission_manage_staff],
+    )
+    staff = _run(
+        staff_api_client,
+        STAFF_USERS_QUERY,
+        perms=[permission_manage_staff],
+    )
+
+    # then
+    customer_node = _find_node(
+        [edge["node"] for edge in customers["data"]["customers"]["edges"]], adult
+    )
+    assert customer_node is not None
+    assert customer_node["birthday"] is None
+    assert customer_node["isSuperuser"] is None
+
+    staff_node = _find_node(
+        [edge["node"] for edge in staff["data"]["staffUsers"]["edges"]],
+        staff_with_birthday,
+    )
+    assert staff_node is not None
+    assert staff_node["birthday"] is None
+    assert staff_node["isSuperuser"] is None
+
+
+def test_tc_sec_06_app_with_manage_users_and_impersonate_reads_null(
+    app_api_client,
+    adult,
+    permission_manage_users,
+    permission_impersonate_user,
+):
+    # when
+    content = _run(
+        app_api_client,
+        USER_QUERY,
+        {"id": _user_id(adult)},
+        perms=[permission_manage_users, permission_impersonate_user],
+    )
+
+    # then
+    user = content["data"]["user"]
+    assert user["id"] == _user_id(adult)
+    assert user["birthday"] is None
+    assert user["isAgeEligible"] is None
+    assert user["isSuperuser"] is None
+
+
+def test_tc_sec_11_is_superuser_matrix(
+    superuser_api_client,
+    staff_api_client,
+    user_api_client,
+    app_api_client,
+    api_client,
+    superuser,
+    staff_user,
+    customer_user,
+    adult,
+    permission_manage_users,
+):
+    # when / then: superuser on self reads the flag
+    content = _run(superuser_api_client, ME_QUERY)
+    assert content["data"]["me"]["isSuperuser"] is True
+
+    # staff on self reads false (owner, value of the flag)
+    content = _run(staff_api_client, ME_QUERY)
+    assert content["data"]["me"]["isSuperuser"] is False
+
+    # superuser reading another user: null
+    content = _run(superuser_api_client, USER_QUERY, {"id": _user_id(adult)})
+    assert content["data"]["user"]["isSuperuser"] is None
+
+    # staff with MANAGE_USERS reading another user: null
+    content = _run(
+        staff_api_client,
+        USER_QUERY,
+        {"id": _user_id(customer_user)},
+        perms=[permission_manage_users],
+    )
+    assert content["data"]["user"]["isSuperuser"] is None
+
+    # app reading a user: null
+    content = _run(
+        app_api_client,
+        USER_QUERY,
+        {"id": _user_id(adult)},
+        perms=[permission_manage_users],
+    )
+    assert content["data"]["user"]["isSuperuser"] is None
+
+    # anonymous: no me at all
+    content = _run(api_client, ME_QUERY)
+    assert content["data"]["me"] is None
+
+    # user on self reads false
+    content = _run(user_api_client, ME_QUERY)
+    assert content["data"]["me"]["isSuperuser"] is False
+
+
+def test_tc_sec_11_superuser_owner_read_is_value_not_null(
+    superuser_api_client, superuser
+):
+    # when
+    content = _run(superuser_api_client, USER_QUERY, {"id": _user_id(superuser)})
+
+    # then
+    assert content["data"]["user"]["isSuperuser"] is True
+
+
+def test_owner_reads_own_birthday_value_and_no_flag_leak(adult):
+    # given
+    client = ApiClient(user=adult)
+
+    # when
+    content = _run(client, ME_QUERY)
+
+    # then
+    assert date.fromisoformat(content["data"]["me"]["birthday"]) == ADULT_BIRTHDAY
+    assert content["data"]["me"]["isSuperuser"] is False
