diff --git a/saleor/graphql/payment/tests/mutations/test_transaction_age_restriction.py b/saleor/graphql/payment/tests/mutations/test_transaction_age_restriction.py
new file mode 100644
index 0000000..b4b82f0
--- /dev/null
+++ b/saleor/graphql/payment/tests/mutations/test_transaction_age_restriction.py
@@ -0,0 +1,259 @@
+"""transactionInitialize / transactionProcess age restriction (S§5 #10, #11).
+
+Covers TC-E-05 (transaction surfaces block a restricted line injected past the
+line-time guard), TC-H-03 (guest with an adult's email: no transaction, LOGIN_REQUIRED),
+TC-E-11 (transactionInitialize on a guest checkout with an adult's email), the
+BIRTHDAY_REQUIRED / UNDERAGE mapping, and TC-H-01 (adult passes).
+
+Error payloads for #10/#11 carry the code and `field="lines"` only. The `variants`
+field is not declared on these types (orchestrator decision), so it is not selected.
+The payment app seams are mocked; the age guard itself is real.
+"""
+
+from decimal import Decimal
+from unittest import mock
+
+import graphene
+
+from .....payment import TransactionEventType
+from .....payment.interface import TransactionSessionResult
+from .....payment.models import TransactionEvent, TransactionItem
+from ....tests.fixtures import ApiClient
+from ....tests.utils import get_graphql_content
+
+TRANSACTION_INITIALIZE = """
+mutation TransactionInitialize(
+  $id: ID!, $amount: PositiveDecimal, $paymentGateway: PaymentGatewayToInitialize!
+) {
+  transactionInitialize(id: $id, amount: $amount, paymentGateway: $paymentGateway) {
+    transaction { id }
+    errors { field code message }
+  }
+}
+"""
+
+TRANSACTION_PROCESS = """
+mutation TransactionProcess($id: ID, $data: JSON) {
+  transactionProcess(id: $id, data: $data) {
+    transaction { id }
+    errors { field code message }
+  }
+}
+"""
+
+APP_IDENTIFIER = "webhook.app.identifier"
+
+
+def _gid(type_name, pk):
+    return graphene.Node.to_global_id(type_name, pk)
+
+
+def _set_checkout_user(checkout, user, email=None):
+    checkout.user = user
+    if email is not None:
+        checkout.email = email
+    checkout.save(update_fields=["user", "email"])
+    return checkout
+
+
+def _initialize(client, checkout, amount, transaction_session_response, webhook_app):
+    webhook_app.identifier = APP_IDENTIFIER
+    webhook_app.save(update_fields=["identifier"])
+    response_payload = transaction_session_response.copy()
+    response_payload["result"] = "AUTHORIZATION_SUCCESS"
+    with mock.patch(
+        "saleor.plugins.manager.PluginsManager.transaction_initialize_session"
+    ) as mocked_initialize:
+        mocked_initialize.return_value = TransactionSessionResult(
+            app_identifier=APP_IDENTIFIER, response=response_payload
+        )
+        response = client.post_graphql(
+            TRANSACTION_INITIALIZE,
+            {
+                "id": _gid("Checkout", checkout.token),
+                "amount": amount,
+                "paymentGateway": {"id": APP_IDENTIFIER, "data": None},
+            },
+        )
+    content = get_graphql_content(response)["data"]["transactionInitialize"]
+    return content, mocked_initialize
+
+
+def test_transaction_initialize_guest_with_adult_email_login_required(
+    adult,
+    checkout_with_item,
+    restricted_product,
+    webhook_app,
+    transaction_session_response,
+):
+    """TC-H-03 / TC-E-11: an adult's email never passes a guest at initialize."""
+    # given
+    checkout = _set_checkout_user(checkout_with_item, None, adult.email)
+    transactions_before = TransactionItem.objects.count()
+
+    # when
+    content, mocked_initialize = _initialize(
+        ApiClient(user=None),
+        checkout,
+        Decimal("10.00"),
+        transaction_session_response,
+        webhook_app,
+    )
+
+    # then (S§5 #10: code + field="lines", no payment app call, no transaction)
+    assert content["transaction"] is None
+    assert content["errors"][0]["code"] == "AGE_RESTRICTION_LOGIN_REQUIRED"
+    assert content["errors"][0]["field"] == "lines"
+    assert not mocked_initialize.called
+    assert TransactionItem.objects.count() == transactions_before
+
+
+def test_transaction_initialize_minor_underage(
+    minor,
+    checkout_with_item,
+    restricted_product,
+    webhook_app,
+    transaction_session_response,
+):
+    """TC-E-05: a restricted line for a minor is blocked before the payment app."""
+    # given
+    checkout = _set_checkout_user(checkout_with_item, minor)
+
+    # when
+    content, mocked_initialize = _initialize(
+        ApiClient(user=minor),
+        checkout,
+        Decimal("10.00"),
+        transaction_session_response,
+        webhook_app,
+    )
+
+    # then
+    assert content["errors"][0]["code"] == "AGE_RESTRICTION_UNDERAGE"
+    assert content["errors"][0]["field"] == "lines"
+    assert not mocked_initialize.called
+
+
+def test_transaction_initialize_no_birthday_birthday_required(
+    no_bday,
+    checkout_with_item,
+    restricted_product,
+    webhook_app,
+    transaction_session_response,
+):
+    """S§10: a linked customer without a birthday maps to BIRTHDAY_REQUIRED."""
+    # given
+    checkout = _set_checkout_user(checkout_with_item, no_bday)
+
+    # when
+    content, mocked_initialize = _initialize(
+        ApiClient(user=no_bday),
+        checkout,
+        Decimal("10.00"),
+        transaction_session_response,
+        webhook_app,
+    )
+
+    # then
+    assert content["errors"][0]["code"] == "AGE_RESTRICTION_BIRTHDAY_REQUIRED"
+    assert not mocked_initialize.called
+
+
+def test_transaction_initialize_adult_passes(
+    adult,
+    checkout_with_item,
+    restricted_product,
+    webhook_app,
+    transaction_session_response,
+):
+    """TC-H-01 transaction part: an eligible customer initializes the payment."""
+    # given
+    checkout = _set_checkout_user(checkout_with_item, adult, adult.email)
+
+    # when
+    content, mocked_initialize = _initialize(
+        ApiClient(user=adult),
+        checkout,
+        Decimal("10.00"),
+        transaction_session_response,
+        webhook_app,
+    )
+
+    # then
+    assert content["errors"] == []
+    assert content["transaction"] is not None
+    assert TransactionItem.objects.filter(checkout_id=checkout.pk).exists()
+    assert mocked_initialize.called
+
+
+def _transaction_awaiting_process(checkout, webhook_app, transaction_item_generator):
+    """Checkout transaction with a CHARGE_REQUEST from transactionInitialize."""
+    webhook_app.identifier = APP_IDENTIFIER
+    webhook_app.save(update_fields=["identifier"])
+    transaction = transaction_item_generator(checkout_id=checkout.pk, app=webhook_app)
+    TransactionEvent.objects.create(
+        transaction=transaction,
+        amount_value=Decimal("10.00"),
+        currency=transaction.currency,
+        type=TransactionEventType.CHARGE_REQUEST,
+    )
+    return transaction
+
+
+def test_transaction_process_minor_underage_without_app_call(
+    minor,
+    checkout_with_item,
+    restricted_product,
+    webhook_app,
+    transaction_item_generator,
+):
+    """TC-E-05 / S§5 #11: transactionProcess blocks a minor before the app call."""
+    # given
+    checkout = _set_checkout_user(checkout_with_item, minor)
+    transaction = _transaction_awaiting_process(
+        checkout, webhook_app, transaction_item_generator
+    )
+
+    # when
+    with mock.patch(
+        "saleor.plugins.manager.PluginsManager.transaction_process_session"
+    ) as mocked_process:
+        response = ApiClient(user=minor).post_graphql(
+            TRANSACTION_PROCESS,
+            {"id": _gid("TransactionItem", transaction.token), "data": {}},
+        )
+    content = get_graphql_content(response)["data"]["transactionProcess"]
+
+    # then
+    assert content["errors"][0]["code"] == "AGE_RESTRICTION_UNDERAGE"
+    assert content["errors"][0]["field"] == "lines"
+    assert not mocked_process.called
+
+
+def test_transaction_process_guest_with_adult_email_login_required(
+    adult,
+    checkout_with_item,
+    restricted_product,
+    webhook_app,
+    transaction_item_generator,
+):
+    """S§5 #11: a guest checkout that only shares an adult's email is blocked."""
+    # given
+    checkout = _set_checkout_user(checkout_with_item, None, adult.email)
+    transaction = _transaction_awaiting_process(
+        checkout, webhook_app, transaction_item_generator
+    )
+
+    # when
+    with mock.patch(
+        "saleor.plugins.manager.PluginsManager.transaction_process_session"
+    ) as mocked_process:
+        response = ApiClient(user=None).post_graphql(
+            TRANSACTION_PROCESS,
+            {"id": _gid("TransactionItem", transaction.token), "data": {}},
+        )
+    content = get_graphql_content(response)["data"]["transactionProcess"]
+
+    # then
+    assert content["errors"][0]["code"] == "AGE_RESTRICTION_LOGIN_REQUIRED"
+    assert not mocked_process.called
