+import graphene
+
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+PRODUCT_UPDATE_AGE_RESTRICTED_MUTATION = """
+    mutation updateProduct($id: ID!, $input: ProductInput!) {
+        productUpdate(id: $id, input: $input) {
