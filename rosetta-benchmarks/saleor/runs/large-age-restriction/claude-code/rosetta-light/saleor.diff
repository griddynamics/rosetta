@@ -0,0 +1,242 @@
+"""Checkout completion age restriction on the domain and task paths.
+
+Covers the automatic completion task (S§5 #8: no order, generic warning, checkout kept),
+TC-E-06 (captured logs carry no birthday, age or minimum age), SC-5 (the task has no
+`site_settings`, so the fallback read must see a minimum age changed between two runs in
+one process), and NFR-1 (a checkout without restricted lines never reads SiteSettings).
+"""
+
+import logging
+from datetime import UTC, date, datetime
+from unittest import mock
+
+import pytest
+from django.utils import timezone
+from freezegun import freeze_time
+
+from ...account.models import User
+from ...account.tests.fixtures.age_restriction import set_age_settings
+from ...checkout import calculations
+from ...checkout.fetch import fetch_checkout_info, fetch_checkout_lines
+from ...checkout.tasks import automatic_checkout_completion_task, task_logger
+from ...order.models import Order
+from ...payment.transaction_item_calculations import recalculate_transaction_amounts
+from ...plugins.manager import get_plugins_manager
+from ...site.models import SiteSettings
+from ..models import Checkout
+
+GENERIC_FAILURE_PREFIX = "Automatic checkout completion failed for checkout"
+ISO_DATES = ("2000-01-01", "2012-06-01")
+
+
+def _sc5_birthday(today: date) -> date:
+    """Birthday that makes the customer 17 on `today`.
+
+    The 17th birthday fell on the first day of the current month, so the date is
+    always valid and the customer is underage at minimum age 18, eligible at 17.
+    """
+    return date(today.year - 17, today.month, 1)
+
+
+def _checkout_total(checkout):
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+    return calculations.calculate_checkout_total_with_gift_cards(
+        manager, checkout_info, lines
+    )
+
+
+def _fund_checkout(checkout, transaction_item_generator):
+    total = _checkout_total(checkout)
+    transaction = transaction_item_generator(
+        checkout_id=checkout.pk, charged_value=total.gross.amount
+    )
+    recalculate_transaction_amounts(transaction)
+    checkout.price_expiration = timezone.now()
+    checkout.save(update_fields=["price_expiration"])
+    return transaction
+
+
+def _set_checkout_user(checkout, user, email=None):
+    checkout.user = user
+    if email is not None:
+        checkout.email = email
+    checkout.save(update_fields=["user", "email"])
+    return checkout
+
+
+def _enable_task_logging():
+    """Let caplog see the task logger (same trick as the existing task tests)."""
+    task_logger.parent.propagate = True
+
+
+def _failure_records(caplog):
+    return [
+        r for r in caplog.records if r.getMessage().startswith(GENERIC_FAILURE_PREFIX)
+    ]
+
+
+def _assert_logs_are_generic(caplog):
+    """TC-E-06: captured logs never carry a birthday, age or minimum age value."""
+    for record in caplog.records:
+        message = record.getMessage()
+        for iso_date in ISO_DATES:
+            assert iso_date not in message
+        error = getattr(record, "error", "") or ""
+        assert not any(char.isdigit() for char in str(error))
+
+
+@pytest.fixture
+def restricted_checkout(checkout_ready_to_complete, restricted_product):
+    """Ready to complete, holding a restricted line (injected past the line guard)."""
+    return checkout_ready_to_complete
+
+
+def test_task_guest_with_adult_email_no_order_and_generic_warning(
+    adult,
+    restricted_checkout,
+    transaction_item_generator,
+    caplog,
+    django_capture_on_commit_callbacks,
+):
+    """S§5 #8 / TC-E-05 / TC-E-06: the task keeps the checkout and logs generically."""
+    # given
+    checkout = _set_checkout_user(restricted_checkout, None, adult.email)
+    _fund_checkout(checkout, transaction_item_generator)
+    checkout_pk = checkout.pk
+    orders_before = Order.objects.count()
+    _enable_task_logging()
+
+    # when
+    with django_capture_on_commit_callbacks(execute=True):
+        automatic_checkout_completion_task(checkout_pk)
+
+    # then
+    assert Order.objects.count() == orders_before
+    assert Checkout.objects.filter(pk=checkout_pk).exists()
+    failures = _failure_records(caplog)
+    assert len(failures) == 1
+    assert failures[0].levelno == logging.WARNING
+    assert "Sign in to buy age-restricted products." in failures[0].error
+    _assert_logs_are_generic(caplog)
+
+
+def test_task_minor_customer_underage_logged_without_values(
+    minor,
+    restricted_checkout,
+    transaction_item_generator,
+    caplog,
+    django_capture_on_commit_callbacks,
+):
+    """S§5 #8: an underage stored customer is blocked and logged without values."""
+    # given
+    checkout = _set_checkout_user(restricted_checkout, minor)
+    _fund_checkout(checkout, transaction_item_generator)
+    checkout_pk = checkout.pk
+    _enable_task_logging()
+
+    # when
+    with django_capture_on_commit_callbacks(execute=True):
+        automatic_checkout_completion_task(checkout_pk)
+
+    # then
+    assert not Order.objects.filter(checkout_token=str(checkout.token)).exists()
+    assert Checkout.objects.filter(pk=checkout_pk).exists()
+    failures = _failure_records(caplog)
+    assert len(failures) == 1
+    assert "You do not meet the minimum age for these products." in failures[0].error
+    _assert_logs_are_generic(caplog)
+
+
+def test_task_minimum_age_lowered_between_runs_is_applied(
+    restricted_checkout,
+    transaction_item_generator,
+    site_settings,
+    caplog,
+    django_capture_on_commit_callbacks,
+):
+    """SC-5: the task has no request site, so the fallback read must be fresh.
+
+    The birthday is 17 years before the shop month, first day, so the customer is 17
+    today: underage at minimum age 18 and eligible at 17. The relative date keeps the
+    test independent of the wall clock.
+    """
+    # the clock is frozen at the real current time, so records created before the
+    # test body (fixtures) are never newer than the frozen clock
+    now = datetime.now(tz=UTC)
+    with freeze_time(now):
+        # given
+        user = User.objects.create(email="sc5-task@example.com", is_active=True)
+        user.birthday = _sc5_birthday(now.date())
+        user.save(update_fields=["birthday"])
+        checkout = _set_checkout_user(restricted_checkout, user, user.email)
+        _fund_checkout(checkout, transaction_item_generator)
+        checkout_pk = checkout.pk
+        set_age_settings(site_settings, minimum_age=18, time_zone="UTC")
+        _enable_task_logging()
+
+        # when: first run at minimum age 18
+        with django_capture_on_commit_callbacks(execute=True):
+            automatic_checkout_completion_task(checkout_pk)
+
+        # then
+        assert Checkout.objects.filter(pk=checkout_pk).exists()
+        assert len(_failure_records(caplog)) == 1
+
+        # when: minimum age lowered to 17 between two runs in the same process
+        set_age_settings(site_settings, minimum_age=17, time_zone="UTC")
+        with django_capture_on_commit_callbacks(execute=True):
+            automatic_checkout_completion_task(checkout_pk)
+
+        # then
+        assert not Checkout.objects.filter(pk=checkout_pk).exists()
+        order = Order.objects.get(checkout_token=str(checkout.token))
+        assert order.user == user
+
+
+def test_unrestricted_completion_never_reads_site_settings(
