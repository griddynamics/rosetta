@@ -0,0 +1,83 @@
+from datetime import date
+
+import pytest
+from django.db import connection
+from django.test.utils import CaptureQueriesContext
+
+from .....account.models import User
+from ....tests.utils import get_graphql_content
+
+CUSTOMERS_QUERY = """
+    query customers {
+        customers(first: 100) {
+            edges {
+                node {
+                    id
+                }
+            }
+        }
+    }
+"""
+
+CUSTOMERS_AGE_ELIGIBLE_QUERY = """
+    query customers {
+        customers(first: 100) {
+            edges {
+                node {
+                    id
+                    isAgeEligible
+                }
+            }
+        }
+    }
+"""
+
+CUSTOMER_EVENT_INSERT = 'INSERT INTO "account_customerevent"'
+
+
+def _run_customers_query(client, query):
+    with CaptureQueriesContext(connection) as context:
+        content = get_graphql_content(client.post_graphql(query))
+    assert content["data"]["customers"]["edges"]
+    return context.captured_queries
+
+
+@pytest.mark.django_db
+def test_customers_is_age_eligible_adds_at_most_two_queries_and_one_audit_insert(
+    staff_api_client,
+    permission_manage_users,
+    users_for_customers_benchmarks,
+):
+    """TC-P-02 / NFR-2: `isAgeEligible` costs at most baseline + 2 queries.
+
+    Measured on this code: the baseline `customers(first: 100)` already loads the
+    site and its settings for the requestor (5 queries), so `isAgeEligible` adds only
+    the bulk audit INSERT (6 queries). The audit INSERT covers every customer returned
+    to the MANAGE_USERS requestor.
+    """
+    # given
+    User.objects.filter(
+        pk__in=[user.pk for user in users_for_customers_benchmarks[:5]]
+    ).update(birthday=date(2000, 1, 1))
+    staff_api_client.user.user_permissions.add(permission_manage_users)
+    # Warm-up: both queries run once so that per-process caches do not skew counts.
+    _run_customers_query(staff_api_client, CUSTOMERS_QUERY)
+    _run_customers_query(staff_api_client, CUSTOMERS_AGE_ELIGIBLE_QUERY)
+
+    # when
+    baseline = _run_customers_query(staff_api_client, CUSTOMERS_QUERY)
+    with_age_eligible = _run_customers_query(
+        staff_api_client, CUSTOMERS_AGE_ELIGIBLE_QUERY
+    )
+
+    # then
+    assert len(with_age_eligible) <= len(baseline) + 2, (
+        len(baseline),
+        len(with_age_eligible),
+    )
+    audit_inserts = [
+        query
+        for query in with_age_eligible
+        if query["sql"].startswith(CUSTOMER_EVENT_INSERT)
+    ]
+    assert len(audit_inserts) == 1
