+"""Birthday is not searchable, filterable or sortable (S§6, S§11 I-1; S§13 TC-SEC-08).
+
+Schema checks run on the in-process schema through introspection, the same view a
+client gets. Search checks use a positive control so a negative result cannot come from
+a search that never matches anything.
+"""
+
+import graphene
+
+from .....account.search import update_user_search_vector
+from .....account.tests.fixtures.age_restriction import ADULT_BIRTHDAY
+from ....api import schema
+from ....tests.utils import get_graphql_content
+
+CUSTOMERS_SEARCH_QUERY = """
+query ($search: String) {
+  customers(first: 10, search: $search) {
+    edges { node { id email } }
+  }
+}
+"""
+
+# The only inputs allowed to carry a birthday (S§6): customer write, account write,
+# account registration and the staff user create input.
+ALLOWED_BIRTHDAY_INPUTS = {
+    "CustomerInput",
+    "UserCreateInput",
+    "AccountInput",
+    "AccountRegisterInput",
+}
+
+
+def _named(type_ref: dict) -> str:
+    while type_ref["kind"] in ("NON_NULL", "LIST"):
+        type_ref = type_ref["ofType"]
+    return type_ref["name"]
+
+
+def _introspection_types() -> list[dict]:
+    return schema.introspect()["__schema"]["types"]
+
+
+def test_tc_sec_08_birthday_only_on_user_and_the_four_allowed_inputs():
+    types = [t for t in _introspection_types() if not t["name"].startswith("__")]
+
