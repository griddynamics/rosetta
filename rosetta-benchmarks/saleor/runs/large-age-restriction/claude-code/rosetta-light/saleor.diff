+    )
+
+
+def test_customer_event_user_for_app_is_permission_denied(
+    route_ctx, app_all_perms_client
+):
+    """m-16: an app has no user, so CustomerEvent.user is PermissionDenied.
+
+    Before the fix the resolver raised AttributeError ("Internal Server Error").
+    """
+    # given
+    spec = ROUTES["CustomerEvent.user"]
+
+    # when
+    response = app_all_perms_client.post_graphql(
+        spec["query"], spec["variables"](route_ctx)
+    )
+    content = get_graphql_content(response, ignore_errors=True)
+
+    # then
+    errors = content.get("errors") or []
+    assert errors
+    codes = [
+        error.get("extensions", {}).get("exception", {}).get("code") for error in errors
+    ]
+    assert "AttributeError" not in codes
+    assert "PermissionDenied" in codes
+    assert (
+        _find_user_node(content.get("data"), _gid("User", route_ctx.adult.pk)) is None
+    )
