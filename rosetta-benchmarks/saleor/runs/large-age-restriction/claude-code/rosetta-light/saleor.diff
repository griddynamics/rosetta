+):
+    """TC-H-01: adult lines add -> transactionInitialize -> checkoutComplete."""
+    # given
+    checkout = _set_checkout_user(checkout_ready_to_complete, adult, adult.email)
+    restricted_variant = restricted_product.variants.first()
+    client = ApiClient(user=adult)
+    line_response = client.post_graphql(
+        MUTATION_LINES_ADD,
+        {
+            "id": _gid("Checkout", checkout.token),
+            "lines": [
+                {
+                    "variantId": _gid("ProductVariant", restricted_variant.pk),
+                    "quantity": 1,
+                }
+            ],
+        },
+    )
+    assert (
+        get_graphql_content(line_response)["data"]["checkoutLinesAdd"]["errors"] == []
+    )
+
+    total = _checkout_total(checkout).gross.amount
+    app_identifier = "webhook.app.identifier"
+    webhook_app.identifier = app_identifier
+    webhook_app.save(update_fields=["identifier"])
+    response_payload = transaction_session_response.copy()
+    response_payload["result"] = "CHARGE_SUCCESS"
+    response_payload["amount"] = str(total)
+
+    # when: transactionInitialize with the adult
+    with mock.patch(
+        "saleor.plugins.manager.PluginsManager.transaction_initialize_session"
+    ) as mocked_initialize:
+        mocked_initialize.return_value = TransactionSessionResult(
+            app_identifier=app_identifier, response=response_payload
+        )
+        init_response = client.post_graphql(
+            MUTATION_TRANSACTION_INITIALIZE,
+            {
+                "id": _gid("Checkout", checkout.token),
+                "amount": total,
+                "paymentGateway": {"id": app_identifier, "data": None},
+            },
+        )
+    init_content = get_graphql_content(init_response)["data"]["transactionInitialize"]
+    assert init_content["errors"] == []
+    assert mocked_initialize.called
+
+    # when: checkoutComplete
+    payload = _complete(adult, checkout)
+
+    # then
+    assert payload["errors"] == []
+    assert payload["order"] is not None
+    assert Order.objects.filter(checkout_token=str(checkout.token)).exists()
