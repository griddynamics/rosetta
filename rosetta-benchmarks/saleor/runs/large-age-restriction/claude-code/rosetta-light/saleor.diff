+def test_minimum_age_lowered_between_completions_is_applied_immediately(
+    restricted_checkout, transaction_item_generator, site_settings
+):
+    """SC-5: a changed minimum age is seen by the next completion in one process.
+
+    The birthday is 17 years before the current shop date (first day of a month, so
+    the date is always valid): underage at minimum age 18, eligible at 17. The
+    relative date keeps the test independent of the wall clock.
+    """
+    # the clock is frozen at the real current time, so records created before the
+    # test body (fixtures) are never newer than the frozen clock
+    now = datetime.now(tz=UTC)
+    with freeze_time(now):
+        # given
+        user = User.objects.create(email="sc5-complete@example.com", is_active=True)
+        _set_birthday(user, _sc5_birthday(now.date()))
+        checkout = _set_checkout_user(restricted_checkout, user, user.email)
+        _fund_checkout(checkout, transaction_item_generator)
+        set_age_settings(site_settings, minimum_age=18, time_zone="UTC")
+
+        # when: first completion at minimum age 18
+        first = _complete(user, checkout)
+
+        # when: the minimum age is lowered to 17 between two completions
+        set_age_settings(site_settings, minimum_age=17, time_zone="UTC")
+        second = _complete(user, checkout)
+
+        # then
+        assert first["errors"][0]["code"] == "AGE_RESTRICTION_UNDERAGE"
+        assert first["order"] is None
+        assert second["errors"] == []
+        assert second["order"] is not None
