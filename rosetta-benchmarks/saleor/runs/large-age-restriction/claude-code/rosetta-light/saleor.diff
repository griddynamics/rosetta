@@ -0,0 +1,117 @@
+import graphene
+import pytest
+from django.db import connection, models
+from django.test.utils import CaptureQueriesContext
+
+from .....account import CustomerEvents
+from .....account.models import CustomerEvent
+from .....account.tests.fixtures.user import dangerously_create_test_user
+from ....tests.utils import get_graphql_content
+
+CUSTOMER_BULK_DELETE_MUTATION = """
+    mutation customerBulkDelete($ids: [ID!]!) {
+        customerBulkDelete(ids: $ids) {
+            count
+        }
+    }
+"""
+EVENTS_UPDATE_PREFIX = 'UPDATE "account_customerevent"'
+
+
+def _run_customer_bulk_delete(
+    staff_api_client, permission_manage_users, staff_user, emails
+) -> list[str]:
+    """Delete customers with birthday and other events; return the SQL statements."""
+    customers = [dangerously_create_test_user(email, "password") for email in emails]
+    for customer in customers:
+        for event_type in (
+            CustomerEvents.BIRTHDAY_CHANGED,
+            CustomerEvents.BIRTHDAY_READ,
+            CustomerEvents.PLACED_ORDER,
+        ):
+            CustomerEvent.objects.create(
+                user=customer,
+                type=event_type,
+                parameters={"customer_id": customer.pk, "actor_user_id": staff_user.pk},
+            )
+    variables = {
+        "ids": [
+            graphene.Node.to_global_id("User", customer.pk) for customer in customers
+        ]
+    }
+
+    with CaptureQueriesContext(connection) as context:
+        # The no-permission pre-check is skipped: the second run in one test would
+        # already have the permission, and both runs must do identical work.
+        response = staff_api_client.post_graphql(
+            CUSTOMER_BULK_DELETE_MUTATION,
+            variables,
+            permissions=[permission_manage_users],
+            check_no_permissions=False,
+        )
+
+    content = get_graphql_content(response)
+    assert content["data"]["customerBulkDelete"]["count"] == len(customers)
+    return [query["sql"] for query in context.captured_queries]
+
+
+def test_customer_bulk_delete_adds_one_events_update_per_batch(
+    staff_api_client,
+    staff_user,
+    permission_manage_users,
+    monkeypatch,
+):
+    """TC-R-05: one events UPDATE per batch over the CASCADE baseline."""
+    # TC-R-05: the baseline is plain CASCADE (the pre-change `on_delete`). The hook
+    # adds exactly one UPDATE on `account_customerevent` per delete batch and no
+    # per-event queries.
+    # given
+    retention_field = CustomerEvent._meta.get_field("user").remote_field
+
+    # when: baseline with the pre-change on_delete, restored when the block exits
+    with monkeypatch.context() as patch:
+        patch.setattr(retention_field, "on_delete", models.CASCADE)
+        baseline = _run_customer_bulk_delete(
+            staff_api_client,
+            permission_manage_users,
+            staff_user,
+            ["baseline-a@example.com", "baseline-b@example.com"],
+        )
+
+    hooked = _run_customer_bulk_delete(
+        staff_api_client,
+        permission_manage_users,
+        staff_user,
+        ["hooked-a@example.com", "hooked-b@example.com"],
+    )
+
+    # then
+    baseline_updates = [sql for sql in baseline if sql.startswith(EVENTS_UPDATE_PREFIX)]
+    hooked_updates = [sql for sql in hooked if sql.startswith(EVENTS_UPDATE_PREFIX)]
+    assert baseline_updates == []
+    assert len(hooked_updates) == 1
+    assert len(hooked) == len(baseline) + 1
+
+
+@pytest.mark.parametrize("customer_count", [1, 4])
+def test_customer_bulk_delete_query_count_does_not_scale_with_events(
+    staff_api_client,
+    staff_user,
+    permission_manage_users,
+    customer_count,
+):
+    """TC-R-05: one events UPDATE per batch, any customer count."""
+    # given / when
+    statements = _run_customer_bulk_delete(
+        staff_api_client,
+        permission_manage_users,
+        staff_user,
+        [
+            f"scale-{customer_count}-{index}@example.com"
+            for index in range(customer_count)
+        ],
+    )
+
+    # then: one UPDATE for the whole batch, however many customers and events
+    updates = [sql for sql in statements if sql.startswith(EVENTS_UPDATE_PREFIX)]
+    assert len(updates) == 1
