+
+# Birthday audit events (S§9). The subject customer is stored in `user`, and the
+# parameters hold only ids: never a birthday, an age or a minimum age.
+
+
+def build_customer_birthday_changed_event(*, user: User, actor: User) -> CustomerEvent:
+    """Return an unsaved BIRTHDAY_CHANGED event, for callers that bulk-create."""
+    return CustomerEvent(
+        user=user,
+        type=CustomerEvents.BIRTHDAY_CHANGED,
+        parameters={"customer_id": user.pk, "actor_user_id": actor.pk},
+    )
+
+
+def customer_birthday_changed_event(*, user: User, actor: User) -> CustomerEvent:
+    event = build_customer_birthday_changed_event(user=user, actor=actor)
+    event.save()
+    return event
+
+
+def customer_birthday_read_events(
+    *, user_ids: Iterable[int], actor: User
+) -> list[CustomerEvent]:
+    """Log one BIRTHDAY_READ event per customer id with a single INSERT.
+
+    Writes go to the default (writer) connection even when the request reads from
+    the replica.
+    """
+    events = [
+        CustomerEvent(
+            user_id=user_id,
+            type=CustomerEvents.BIRTHDAY_READ,
+            parameters={"customer_id": user_id, "actor_user_id": actor.pk},
+        )
+        for user_id in user_ids
+    ]
+    with allow_writer():
+        return CustomerEvent.objects.bulk_create(events)
