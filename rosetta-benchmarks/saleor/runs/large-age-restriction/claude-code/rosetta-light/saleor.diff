+import graphene
+
+from .....account import CustomerEvents
+from .....account.models import CustomerEvent, User
+from ....tests.utils import get_graphql_content
+
+CUSTOMER_DELETE_MUTATION = """
+    mutation CustomerDelete($id: ID) {
+        customerDelete(id: $id) {
+            errors {
+                field
+                message
+            }
+        }
+    }
+"""
+
+
+def test_customer_delete_keeps_birthday_events_and_deletes_other_events(
+    staff_api_client,
+    staff_user,
+    adult,
+    permission_manage_users,
+):
+    """TC-R-01 (customerDelete): birthday events kept, others deleted."""
+    # TC-R-01 (customerDelete)
+    # given
+    birthday_changed = CustomerEvent.objects.create(
+        user=adult,
+        type=CustomerEvents.BIRTHDAY_CHANGED,
+        parameters={"customer_id": adult.pk, "actor_user_id": staff_user.pk},
+    )
+    birthday_read = CustomerEvent.objects.create(
+        user=adult,
+        type=CustomerEvents.BIRTHDAY_READ,
+        parameters={"customer_id": adult.pk, "actor_user_id": staff_user.pk},
+    )
+    placed_order = CustomerEvent.objects.create(
+        user=adult, type=CustomerEvents.PLACED_ORDER, parameters={}
+    )
+    email_changed = CustomerEvent.objects.create(
+        user=adult, type=CustomerEvents.EMAIL_CHANGED, parameters={}
+    )
+    variables = {"id": graphene.Node.to_global_id("User", adult.pk)}
+
+    # when
+    response = staff_api_client.post_graphql(
+        CUSTOMER_DELETE_MUTATION, variables, permissions=[permission_manage_users]
+    )
+
+    # then
+    content = get_graphql_content(response)
+    assert content["data"]["customerDelete"]["errors"] == []
+    assert not User.objects.filter(pk=adult.pk).exists()
+
+    for event in (birthday_changed, birthday_read):
+        retained = CustomerEvent.objects.get(pk=event.pk)
+        assert retained.user_id is None
+        assert retained.parameters == event.parameters
+    assert not CustomerEvent.objects.filter(
+        pk__in=[placed_order.pk, email_changed.pk]
+    ).exists()
