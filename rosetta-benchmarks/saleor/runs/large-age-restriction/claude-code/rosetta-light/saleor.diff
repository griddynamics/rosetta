index 0000000..f2afa71
--- /dev/null
+++ b/saleor/csv/tests/test_birthday_privacy_export.py
@@ -0,0 +1,142 @@
+"""Birthday never reaches an export file (S§11 A12, I-1; S§13 export leak test).
+
+The export paths are products (field list from `ProductFieldEnum`), gift card codes and
+voucher codes. Each path runs for real, the written file is captured before the export
+file is saved, and the header and body are checked. The product field enum is checked
+for any age or birthday member, since a column would be a new output path.
+"""
+
+from unittest.mock import patch
+
+from prices import Money
+
+from ...account.tests.fixtures.age_restriction import ADULT_BIRTHDAY
+from ...giftcard.models import GiftCard
+from ...graphql.csv.enums import ProductFieldEnum
+from ...product.models import Product
+from .. import FileTypes
+from ..utils.export import export_gift_cards, export_products, export_voucher_codes
+
+AGE_TOKENS = ("birth", "age_restr", "agerestr", "age restr", "restrict", "min_age")
+
+
+def _capture_export(run_export):
+    """Run an export and return (header_line, body, all_text) of the written file."""
+    captured = {}
+
+    def _save(export_file, temporary_file, file_name):
+        temporary_file.flush()
+        temporary_file.seek(0)
+        data = temporary_file.read()
+        captured["text"] = data.decode() if isinstance(data, bytes) else data
+
+    with (
+        patch(
+            "saleor.csv.utils.export.save_csv_file_in_export_file", side_effect=_save
+        ),
+        patch("saleor.csv.utils.export.send_export_download_link_notification"),
+    ):
+        run_export()
+
+    text = captured["text"]
+    header = text.splitlines()[0] if text else ""
+    return header, text
+
+
+def _assert_no_age_or_birthday(header: str, text: str, adult) -> None:
+    lowered = text.lower()
+    for token in AGE_TOKENS:
+        assert token not in header.lower(), f"age-related header column: {token}"
+    assert adult.email not in text
+    assert ADULT_BIRTHDAY.isoformat() not in text
+    assert ADULT_BIRTHDAY.strftime("%d.%m.%Y") not in text
+    assert "birthday" not in lowered
+
+
+def test_tc_a12_product_field_enum_has_no_age_or_birthday_member():
+    members = [member.name for member in ProductFieldEnum._meta.enum]
+    values = [str(member.value) for member in ProductFieldEnum._meta.enum]
+    for name, value in zip(members, values, strict=True):
+        for token in ("BIRTH", "AGE", "RESTRICT"):
+            assert token not in name.upper(), name
+        assert "birth" not in value.lower()
+        assert "age" not in value.lower().split()
+
+
+def test_tc_a12_product_export_has_no_age_or_birthday_column(
+    user_export_file, product_list, restricted_product, adult
+):
+    # given: every product field, including a restricted product in the scope
+    export_info = {
+        "fields": [member.value for member in ProductFieldEnum._meta.enum],
+        "warehouses": [],
+        "attributes": [],
+        "channels": [],
+    }
+    scope = {
+        "ids": [restricted_product.pk, *[p.pk for p in product_list]],
+    }
+    assert Product.objects.filter(
+        pk=restricted_product.pk, is_age_restricted=True
+    ).exists()
+
+    # when
+    header, text = _capture_export(
+        lambda: export_products(
+            user_export_file,
+            scope,
+            export_info,
+            FileTypes.CSV,
+        )
+    )
+
+    # then
+    assert text, "export produced no content"
+    assert restricted_product.name in text
+    assert "is_age_restricted" not in text.lower()
+    _assert_no_age_or_birthday(header, text, adult=adult)
+
+
+def test_tc_a12_gift_card_export_is_codes_only_for_adult_owned_cards(
+    user_export_file, adult
+):
+    # given: a gift card created by an adult customer with a birthday on the account
+    card = GiftCard.objects.create(
+        code="S10CSVGIFTCODE01",
+        created_by=adult,
+        created_by_email=adult.email,
+        initial_balance=Money(10, "USD"),
+        current_balance=Money(10, "USD"),
+    )
+
+    # when
+    header, text = _capture_export(
+        lambda: export_gift_cards(
+            user_export_file,
+            {"ids": [card.pk]},
+            FileTypes.CSV,
+        )
+    )
+
+    # then: the only column is the code; neither the owner nor the birthday is written
+    assert header.strip() == "code"
+    assert card.code in text
+    _assert_no_age_or_birthday(header, text, adult=adult)
+
+
+def test_tc_a12_voucher_code_export_is_codes_only(
+    user_export_file, voucher_with_many_codes, adult
+):
+    # when
+    header, text = _capture_export(
+        lambda: export_voucher_codes(
+            user_export_file,
+            FileTypes.CSV,
+            voucher_id=voucher_with_many_codes.pk,
+        )
+    )
+
+    # then
+    assert header.strip() == "code"
+    assert text.strip(), "voucher export produced no content"
+    _assert_no_age_or_birthday(header, text, adult=adult)
