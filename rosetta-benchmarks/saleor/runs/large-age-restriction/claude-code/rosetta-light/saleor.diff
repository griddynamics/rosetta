+"""Birthday leak matrix across every route that reaches a customer `User` object.
+
+Covers S§11 I-1 and E-1, S§7, and S§13 TC-SEC-01..04 and TC-SEC-06 (read side). Each
+route is run as anonymous, as a non-superuser staff member holding every relevant
+permission (channel access granted), as an app holding the same permissions plus
+IMPERSONATE_USER, and as a superuser. The superuser run is a control: it proves that the
+route really returns the birthday, so a null for everyone else is the gate.
+
+Birthdays are test data only: assertions use typed values, never printed or logged.
+"""
+
+from dataclasses import dataclass
+from datetime import date
+from decimal import Decimal
+from typing import Any
+
+import graphene
+import pytest
+from prices import Money
+
+from .....account import CustomerEvents
+from .....account.events import customer_birthday_changed_event
+from .....account.models import CustomerEvent, Group, User
+from .....account.tests.fixtures.age_restriction import ADULT_BIRTHDAY
+from .....core import JobStatus
+from .....csv.models import ExportFile
+from .....giftcard.models import GiftCard
+from .....order import OrderStatus
+from ....tests.fixtures import ApiClient
+from ....tests.utils import get_graphql_content
+
+USER_FIELDS = "id birthday isAgeEligible isSuperuser"
+
+
+@dataclass
+class RouteContext:
+    adult: User
+    staff_target: User
+    checkout_id: str
+    group_id: str
+
+
+def _gid(model: str, pk: Any) -> str:
+    return graphene.Node.to_global_id(model, pk)
+
+
+def _find_user_node(data: Any, user_global_id: str) -> dict | None:
+    """Return the first `User` object with this id anywhere in the response data."""
+    if isinstance(data, dict):
+        if data.get("id") == user_global_id and "birthday" in data:
+            return data
+        for value in data.values():
+            found = _find_user_node(value, user_global_id)
+            if found is not None:
+                return found
+    elif isinstance(data, list):
+        for item in data:
+            found = _find_user_node(item, user_global_id)
+            if found is not None:
+                return found
+    return None
+
+
+ROUTES: dict[str, dict[str, Any]] = {
+    "Query.user": {
+        "query": f"query ($id: ID!) {{ user(id: $id) {{ {USER_FIELDS} }} }}",
+        "variables": lambda ctx: {"id": _gid("User", ctx.adult.pk)},
+        "target": lambda ctx: ctx.adult,
+    },
+    "Query.customers": {
+        "query": f"query {{ customers(first: 100) {{ edges {{ node {{ {USER_FIELDS} }} }} }} }}",
+        "variables": lambda ctx: None,
+        "target": lambda ctx: ctx.adult,
+    },
+    "Query.staffUsers": {
+        "query": f"query {{ staffUsers(first: 100) {{ edges {{ node {{ {USER_FIELDS} }} }} }} }}",
+        "variables": lambda ctx: None,
+        "target": lambda ctx: ctx.staff_target,
+    },
+    "Order.user": {
+        "query": (
+            "query { orders(first: 10) { edges { node { "
+            f"user {{ {USER_FIELDS} }} }} }} }} }}"
+        ),
+        "variables": lambda ctx: None,
+        "target": lambda ctx: ctx.adult,
+    },
+    "Checkout.user": {
+        "query": f"query ($id: ID!) {{ checkout(id: $id) {{ user {{ {USER_FIELDS} }} }} }}",
+        "variables": lambda ctx: {"id": ctx.checkout_id},
+        "target": lambda ctx: ctx.adult,
+    },
+    "CustomerEvent.user": {
+        # The resolver returns PermissionDenied for apps (no `info.context.user`).
+        # See `test_customer_event_user_for_app_is_permission_denied`.
+        "reachable_for": {"staff_all_perms", "superuser"},
+        "query": (
+            "query ($id: ID!) { user(id: $id) { events { "
+            f"user {{ {USER_FIELDS} }} }} }} }}"
+        ),
+        "variables": lambda ctx: {"id": _gid("User", ctx.adult.pk)},
+        "target": lambda ctx: ctx.adult,
+    },
+    "GiftCard.createdBy": {
+        "query": (
+            "query { giftCards(first: 10) { edges { node { "
+            f"createdBy {{ {USER_FIELDS} }} }} }} }} }}"
+        ),
+        "variables": lambda ctx: None,
+        "target": lambda ctx: ctx.adult,
+    },
+    "ExportFile.user": {
+        # apps are denied MANAGE_STAFF-gated fields by design
+        # (`permission/utils.py` permission_required), so only staff reach this route
+        "reachable_for": {"staff_all_perms", "superuser"},
+        "query": (
+            "query { exportFiles(first: 10) { edges { node { "
+            f"user {{ {USER_FIELDS} }} }} }} }} }}"
+        ),
+        "variables": lambda ctx: None,
+        "target": lambda ctx: ctx.adult,
+    },
+    "Group.users": {
+        "query": (
+            "query ($id: ID!) { permissionGroup(id: $id) { "
+            f"users {{ {USER_FIELDS} }} }} }}"
+        ),
+        "variables": lambda ctx: {"id": ctx.group_id},
+        "target": lambda ctx: ctx.adult,
+    },
+    "_entities (federation User)": {
+        "query": (
+            "query ($reps: [_Any!]!) { _entities(representations: $reps) { "
+            f"... on User {{ {USER_FIELDS} }} }} }}"
+        ),
+        "variables": lambda ctx: {
+            "reps": [{"__typename": "User", "id": _gid("User", ctx.adult.pk)}]
+        },
+        "target": lambda ctx: ctx.adult,
+    },
+}
+
+REQUESTORS = ["anonymous", "staff_all_perms", "app_all_perms", "superuser"]
+
+
+@pytest.fixture
+def route_ctx(
+    db,
+    adult,
+    superuser,
+    order,
+    checkout_with_item,
+    channel_USD,
+):
+    # One order and one checkout owned by the adult customer.
+    order.user = adult
+    order.user_email = adult.email
+    order.status = OrderStatus.UNFULFILLED
+    order.save(update_fields=["user", "user_email", "status"])
+
+    checkout_with_item.user = adult
+    checkout_with_item.email = adult.email
+    checkout_with_item.save(update_fields=["user", "email"])
+
+    staff_target = User.objects.create(
+        email="route-staff-target@example.com",
+        is_staff=True,
+        birthday=ADULT_BIRTHDAY,
+    )
+
+    # `orders` is filtered by channels reachable through a group, so the superuser
+    # control needs the same channel access the staff requestor gets.
+    group = Group.objects.create(
+        name="route-customer-group", restricted_access_to_channels=False
+    )
+    group.user_set.add(adult, superuser)
+
+    GiftCard.objects.create(
+        code="S10ROUTEGC0001",
+        created_by=adult,
+        created_by_email=adult.email,
+        initial_balance=Money(Decimal(10), "USD"),
+        current_balance=Money(Decimal(10), "USD"),
+    )
+    ExportFile.objects.create(user=adult, status=JobStatus.SUCCESS)
+    customer_birthday_changed_event(user=adult, actor=adult)
+
+    return RouteContext(
+        adult=adult,
+        staff_target=staff_target,
+        checkout_id=_gid("Checkout", checkout_with_item.pk),
+        group_id=_gid("Group", group.pk),
+    )
+
+
+@pytest.fixture
+def staff_all_perms_client(
+    staff_user,
+    permission_manage_users,
+    permission_manage_staff,
+    permission_manage_orders,
+    permission_manage_gift_card,
+    permission_manage_checkouts,
+    permission_manage_products,
+    permission_impersonate_user,
+):
+    # Channel access is granted through a group, which `orders` needs.
+    group = Group.objects.create(
+        name="route-all-perms", restricted_access_to_channels=False
+    )
+    group.permissions.add(
+        permission_manage_users,
+        permission_manage_staff,
+        permission_manage_orders,
+        permission_manage_gift_card,
+        permission_manage_checkouts,
+        permission_manage_products,
+        permission_impersonate_user,
+    )
+    group.user_set.add(staff_user)
+    return ApiClient(user=staff_user)
+
+
+@pytest.fixture
+def app_all_perms_client(
+    app,
+    permission_manage_users,
+    permission_manage_staff,
+    permission_manage_orders,
+    permission_manage_gift_card,
+    permission_manage_checkouts,
+    permission_manage_products,
+    permission_impersonate_user,
+):
+    app.permissions.add(
+        permission_manage_users,
+        permission_manage_staff,
+        permission_manage_orders,
+        permission_manage_gift_card,
+        permission_manage_checkouts,
+        permission_manage_products,
+        permission_impersonate_user,
+    )
+    return ApiClient(app=app)
+
+
+@pytest.mark.parametrize("route", list(ROUTES))
+@pytest.mark.parametrize("requestor", REQUESTORS)
+def test_birthday_route_matrix(
+    route,
+    requestor,
+    request,
+    route_ctx,
+    api_client,
+    superuser_api_client,
+):
+    # given
+    if requestor == "anonymous":
+        client = api_client
+    elif requestor == "staff_all_perms":
+        client = request.getfixturevalue("staff_all_perms_client")
+    elif requestor == "app_all_perms":
+        client = request.getfixturevalue("app_all_perms_client")
+    else:
+        client = superuser_api_client
+    spec = ROUTES[route]
+    target = spec["target"](route_ctx)
+    target_global_id = _gid("User", target.pk)
+
+    # when
+    response = client.post_graphql(spec["query"], spec["variables"](route_ctx))
+    content = get_graphql_content(response, ignore_errors=True)
+
+    # then
+    node = _find_user_node(content.get("data"), target_global_id)
+
+    if requestor == "superuser":
+        # control: the route returns the typed birthday to a superuser
+        assert node is not None, f"control failed for {route}: {content.get('errors')}"
+        assert date.fromisoformat(node["birthday"]) == target.birthday
+        return
+
+    assert node is None or node["birthday"] is None, f"birthday leaked via {route}"
+    reachable_for = spec.get(
+        "reachable_for", {"staff_all_perms", "app_all_perms", "superuser"}
+    )
+    if requestor in reachable_for and requestor != "superuser":
+        # the requestor holds the route's permissions, so the null is the gate
+        # and not a denied route
+        assert node is not None, f"route {route} unreachable for {requestor}"
+    if node is not None:
+        assert node["isSuperuser"] is None
+        if requestor in ("anonymous", "app_all_perms"):
+            assert node["isAgeEligible"] is None
+
+
+def test_control_customer_event_user_is_subject_for_superuser(
+    route_ctx, superuser_api_client
+):
+    # given: the birthday-changed event exists with the adult as its subject
+    assert CustomerEvent.objects.filter(
+        user=route_ctx.adult, type=CustomerEvents.BIRTHDAY_CHANGED
+    ).exists()
+
+    # when
+    spec = ROUTES["CustomerEvent.user"]
+    response = superuser_api_client.post_graphql(
+        spec["query"], spec["variables"](route_ctx)
+    )
+    content = get_graphql_content(response)
+
+    # then
+    node = _find_user_node(content["data"], _gid("User", route_ctx.adult.pk))
+    assert node is not None
+    assert node["birthday"] == ADULT_BIRTHDAY.isoformat()
+
+
+def test_route_inventory_every_user_returning_field_is_reviewed(api_client):
+    """Introspection guard: a new `User`-returning field must be reviewed here.
+
+    Every object field whose named type is `User` is either exercised by the matrix
+    above, or listed with the test module that covers it (mutation and subscription
+    payloads, event and gift card edges that share the same `User.birthday` resolver).
+    """
+    from ....api import schema
+
+    data = schema.introspect()["__schema"]
+
+    def named(type_ref: dict) -> str:
+        while type_ref["kind"] in ("NON_NULL", "LIST"):
+            type_ref = type_ref["ofType"]
+        return type_ref["name"]
+
+    found = set()
+    for type_ in data["types"]:
+        if type_["name"].startswith("__"):
+            continue
+        for field in type_.get("fields") or []:
+            if named(field["type"]) == "User":
+                found.add(f"{type_['name']}.{field['name']}")
+
+    exercised_by_matrix = {
+        "Query.user",
+        "Query.customers",
+        "Query.staffUsers",
+        "Order.user",
+        "Checkout.user",
+        "CustomerEvent.user",
+        "GiftCard.createdBy",
+        "ExportFile.user",
+        "Group.users",
+    }
+    exercised_by_matrix |= {"Query.me"}  # owner-only, see test_birthday_privacy.py
+    covered_by_other_modules = {
+        # account mutation and customer/staff payloads (write and read gates)
+        "AccountAddressCreate.user",
+        "AccountAddressDelete.user",
+        "AccountAddressUpdate.user",
+        "AccountChangeEmailRequested.user",
+        "AccountConfirmationRequested.user",
+        "AccountConfirmed.user",
+        "AccountDelete.user",
+        "AccountDeleteRequested.user",
+        "AccountDeleted.user",
+        "AccountEmailChanged.user",
+        "AccountRegister.user",
+        "AccountSetDefaultAddress.user",
+        "AccountSetPasswordRequested.user",
+        "AccountUpdate.user",
+        "AddressCreate.user",
+        "AddressDelete.user",
+        "AddressSetDefault.user",
+        "AddressUpdate.user",
+        "AppProblemDismissed.user",
+        "ConfirmAccount.user",
+        "ConfirmEmailChange.user",
+        "CreateToken.user",
+        "CustomerBulkResult.customer",
+        "CustomerCreate.user",
+        "CustomerCreated.user",
+        "CustomerDelete.user",
+        "CustomerDeleted.user",
+        "CustomerMetadataUpdated.user",
+        "CustomerUpdate.user",
+        "CustomerUpdated.user",
+        "ExternalObtainAccessTokens.user",
+        "ExternalRefresh.user",
+        "ExternalVerify.user",
+        "PasswordChange.user",
+        "RefreshToken.user",
+        "RequestEmailChange.user",
+        "SetPassword.user",
+        "StaffCreate.user",
+        "StaffCreated.user",
+        "StaffDelete.user",
+        "StaffDeleted.user",
+        "StaffNotificationRecipient.user",
+        "StaffSetPasswordRequested.user",
+        "StaffUpdate.user",
+        "StaffUpdated.user",
+        "UserAvatarDelete.user",
+        "UserAvatarUpdate.user",
+        "VerifyToken.user",
+        # same resolver through other object types
+        "GiftCard.assignedTo",
+        "GiftCard.usedBy",
+        "GiftCard.user",
+        "GiftCardEvent.user",
+        "GiftCardEventAssignment.currentAssignedTo",
+        "GiftCardEventAssignment.oldAssignedTo",
+        "ExportEvent.user",
+        "OrderEvent.user",
+        "OrderGrantedRefund.user",
+        "ListStoredPaymentMethods.user",
+        "StoredPaymentMethodDeleteRequested.user",
+        "PaymentGatewayInitializeTokenizationSession.user",
+        "PaymentMethodInitializeTokenizationSession.user",
+        "PaymentMethodProcessTokenizationSession.user",
+        "UserCountableEdge.node",
+    }
+    unknown = found - exercised_by_matrix - covered_by_other_modules
+    assert not unknown, (
