+import graphene
+
+from .....account import CustomerEvents
+from .....account.models import CustomerEvent, User
+from ....tests.utils import get_graphql_content
+
+CUSTOMER_BULK_DELETE_MUTATION = """
+    mutation customerBulkDelete($ids: [ID!]!) {
+        customerBulkDelete(ids: $ids) {
+            count
+        }
+    }
+"""
+
+
+def test_customer_bulk_delete_keeps_birthday_events_and_deletes_other_events(
+    staff_api_client,
+    staff_user,
+    adult,
+    minor,
+    no_bday,
+    permission_manage_users,
+):
+    """TC-R-01 (customerBulkDelete): birthday events kept, others deleted."""
+    # TC-R-01 (customerBulkDelete). `no_bday` is a bystander whose events must stay.
+    # given
+    events = {}
+    for customer in (adult, minor):
+        events[customer.pk] = {
+            "birthday_changed": CustomerEvent.objects.create(
+                user=customer,
+                type=CustomerEvents.BIRTHDAY_CHANGED,
+                parameters={"customer_id": customer.pk, "actor_user_id": staff_user.pk},
+            ),
+            "birthday_read": CustomerEvent.objects.create(
+                user=customer,
+                type=CustomerEvents.BIRTHDAY_READ,
+                parameters={"customer_id": customer.pk, "actor_user_id": staff_user.pk},
+            ),
+            "placed_order": CustomerEvent.objects.create(
+                user=customer, type=CustomerEvents.PLACED_ORDER, parameters={}
+            ),
+            "email_changed": CustomerEvent.objects.create(
+                user=customer, type=CustomerEvents.EMAIL_CHANGED, parameters={}
+            ),
+        }
+    bystander_event = CustomerEvent.objects.create(
+        user=no_bday, type=CustomerEvents.PLACED_ORDER, parameters={}
+    )
+    variables = {
+        "ids": [
+            graphene.Node.to_global_id("User", adult.pk),
+            graphene.Node.to_global_id("User", minor.pk),
+        ]
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CUSTOMER_BULK_DELETE_MUTATION,
+        variables,
+        permissions=[permission_manage_users],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    assert content["data"]["customerBulkDelete"]["count"] == 2
+    assert not User.objects.filter(pk__in=[adult.pk, minor.pk]).exists()
+
+    for customer_events in events.values():
+        for key in ("birthday_changed", "birthday_read"):
+            retained = CustomerEvent.objects.get(pk=customer_events[key].pk)
+            assert retained.user_id is None
+            assert retained.parameters == customer_events[key].parameters
+        assert not CustomerEvent.objects.filter(
+            pk__in=[
+                customer_events["placed_order"].pk,
+                customer_events["email_changed"].pk,
+            ]
+        ).exists()
+
+    assert CustomerEvent.objects.filter(pk=bystander_event.pk, user=no_bday).exists()
