diff --git a/saleor/webhook/tests/test_birthday_privacy_payloads.py b/saleor/webhook/tests/test_birthday_privacy_payloads.py
new file mode 100644
index 0000000..e199f60
--- /dev/null
+++ b/saleor/webhook/tests/test_birthday_privacy_payloads.py
@@ -0,0 +1,66 @@
+"""Birthday privacy in legacy (non-subscription) webhook payloads (S§11 I-1; S§13 TC-SEC-07).
+
+`generate_customer_payload` is the explicit-field serializer used by legacy customer
+webhooks. The birthday must never appear in it, whoever the requestor is.
+"""
+
+import json
+from typing import Any
+
+from ...account.tests.fixtures.age_restriction import ADULT_BIRTHDAY
+from ..payloads import generate_customer_payload
+
+PRIVACY_KEYS = {
+    "birthday",
+    "isAgeEligible",
+    "is_age_eligible",
+    "isSuperuser",
+    "is_superuser",
+}
+
+
+def _as_data(payload: Any) -> Any:
+    return json.loads(payload) if isinstance(payload, str) else payload
+
+
+def _walk_keys(data: Any) -> set[str]:
+    keys: set[str] = set()
+    if isinstance(data, dict):
+        for key, value in data.items():
+            keys.add(key)
+            keys |= _walk_keys(value)
+    elif isinstance(data, list):
+        for item in data:
+            keys |= _walk_keys(item)
+    return keys
+
+
+def _walk_values(data: Any) -> list[Any]:
+    if isinstance(data, dict):
+        return [v for value in data.values() for v in _walk_values(value)]
+    if isinstance(data, list):
+        return [v for item in data for v in _walk_values(item)]
+    return [data]
+
+
+def test_tc_sec_07_legacy_customer_payload_has_no_birthday_key(adult, superuser):
+    # when
+    data = _as_data(generate_customer_payload(adult, requestor=superuser))
+
+    # then: positive control, the payload really describes the customer
+    assert _walk_keys(data) & {"email"}
+    assert adult.email in _walk_values(data)
+
+    # and no birthday key anywhere, nor the value
+    assert not (_walk_keys(data) & PRIVACY_KEYS)
+    assert ADULT_BIRTHDAY not in _walk_values(data)
+    assert ADULT_BIRTHDAY.isoformat() not in json.dumps(data)
+
+
+def test_tc_sec_07_legacy_customer_payload_without_requestor_has_no_birthday(adult):
+    # when
+    data = _as_data(generate_customer_payload(adult, requestor=None))
+
+    # then
+    assert not (_walk_keys(data) & PRIVACY_KEYS)
+    assert ADULT_BIRTHDAY.isoformat() not in json.dumps(data)
