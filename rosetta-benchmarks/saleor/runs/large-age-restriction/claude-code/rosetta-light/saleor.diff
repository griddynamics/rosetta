+            {k: v for k, v in vars(record).items() if k not in ("args",)}
+        )
+        _assert_no_birthday_text(text, ADULT_BIRTHDAY, NEW_BIRTHDAY)
+
+
+@freeze_time(FROZEN_NOW)
+def test_no_birthday_value_in_error_messages(superuser_api_client, customer_user):
