+
+
+def test_superuser_customer_create_sets_birthday_and_logs_change_with_superuser_actor(
+    superuser_api_client, superuser
+):
+    """TC-H-06 (customerCreate): stored; event actor is the superuser."""
+    # given
+    variables = _create_input("2000-05-17")
+
+    # when
+    response = superuser_api_client.post_graphql(
+        CUSTOMER_CREATE_BIRTHDAY_MUTATION, variables
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["customerCreate"]
+    assert data["errors"] == []
+    new_customer = User.objects.get(email=NEW_CUSTOMER_EMAIL)
+    assert new_customer.birthday == date(2000, 5, 17)
+    [event] = CustomerEvent.objects.filter(
+        user=new_customer, type=CustomerEvents.BIRTHDAY_CHANGED
+    )
+    assert event.parameters == {
+        "customer_id": new_customer.pk,
+        "actor_user_id": superuser.pk,
+    }
+
+
+def test_customer_create_birthday_denied_for_non_superuser_staff(
+    staff_api_client, permission_manage_users
+):
