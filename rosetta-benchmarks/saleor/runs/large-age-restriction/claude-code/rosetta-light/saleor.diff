+    # given
+    variables = _create_input("2000-05-17")
+
+    # when
+    response = staff_api_client.post_graphql(
+        CUSTOMER_CREATE_BIRTHDAY_MUTATION,
+        variables,
+        permissions=[permission_manage_users],
+    )
+
+    # then
+    assert_no_permission(response)
+    assert not User.objects.filter(email=NEW_CUSTOMER_EMAIL).exists()
+    assert not CustomerEvent.objects.filter(
+        type=CustomerEvents.BIRTHDAY_CHANGED
+    ).exists()
+
+
+@freeze_time("2026-10-23 12:00:00")
+@pytest.mark.parametrize("birthday", ["2026-10-24", "1906-10-22"])
+def test_customer_create_rejects_out_of_range_birthday(birthday, superuser_api_client):
+    """TC-E-10 (customerCreate): future or over-120-year birthday is INVALID."""
+    # given
+    variables = _create_input(birthday)
+
+    # when
+    response = superuser_api_client.post_graphql(
+        CUSTOMER_CREATE_BIRTHDAY_MUTATION, variables
