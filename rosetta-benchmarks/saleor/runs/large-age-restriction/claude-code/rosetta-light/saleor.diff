+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_CREATE_AGE_RESTRICTED_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert data["errors"] == []
+    assert data["product"]["isAgeRestricted"] is True
+    assert Product.objects.get(name="Age restricted product").is_age_restricted is True
+
+
+def test_create_product_without_is_age_restricted_defaults_to_false(
