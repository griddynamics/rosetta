+    """TC-R-02 (staffBulkDelete): subject kept, actor-only stays on customer."""
+    # TC-R-02 (staffBulkDelete). `staff_user` is the requestor and is not deleted.
+    # given
+    staff_1 = User.objects.create(email="staff-1-to-delete@example.com", is_staff=True)
+    staff_2 = User.objects.create(email="staff-2-to-delete@example.com", is_staff=True)
+    staff_activated = CustomerEvent.objects.create(
+        user=staff_1, type=CustomerEvents.ACCOUNT_ACTIVATED, parameters={}
+    )
+    staff_1_birthday = CustomerEvent.objects.create(
+        user=staff_1,
+        type=CustomerEvents.BIRTHDAY_CHANGED,
+        parameters={"customer_id": staff_1.pk, "actor_user_id": staff_1.pk},
+    )
+    staff_2_birthday_read = CustomerEvent.objects.create(
+        user=staff_2,
+        type=CustomerEvents.BIRTHDAY_READ,
+        parameters={"customer_id": staff_2.pk, "actor_user_id": staff_2.pk},
+    )
+    # Staff_2 is only the actor here: the event stays on the customer.
+    customer_birthday = CustomerEvent.objects.create(
+        user=adult,
+        type=CustomerEvents.BIRTHDAY_CHANGED,
+        parameters={"customer_id": adult.pk, "actor_user_id": staff_2.pk},
+    )
+    staff_2_note = CustomerEvent.objects.create(
+        user=staff_2,
+        type=CustomerEvents.NOTE_ADDED,
+        parameters={"customer_id": adult.pk},
+    )
+    variables = {
+        "ids": [
+            graphene.Node.to_global_id("User", staff_1.pk),
+            graphene.Node.to_global_id("User", staff_2.pk),
+        ]
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        STAFF_BULK_DELETE_MUTATION,
+        variables,
+        permissions=[permission_manage_staff],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    assert content["data"]["staffBulkDelete"]["count"] == 2
+    assert content["data"]["staffBulkDelete"]["errors"] == []
+    assert not User.objects.filter(pk__in=[staff_1.pk, staff_2.pk]).exists()
+    assert User.objects.filter(pk=staff_user.pk).exists()
+
+    for event in (staff_1_birthday, staff_2_birthday_read):
+        retained = CustomerEvent.objects.get(pk=event.pk)
+        assert retained.user_id is None
+        assert retained.parameters == event.parameters
+
+    assert CustomerEvent.objects.get(pk=customer_birthday.pk).user_id == adult.pk
+    assert not CustomerEvent.objects.filter(
+        pk__in=[staff_activated.pk, staff_2_note.pk]
+    ).exists()
