+++ b/saleor/graphql/account/tests/mutations/test_account_register_birthday.py
@@ -0,0 +1,159 @@
+from datetime import date
+from unittest.mock import patch
+
+import pytest
+from django.test import override_settings
+from freezegun import freeze_time
+
+from .....account import CustomerEvents
+from .....account.error_codes import AccountErrorCode
+from .....account.models import CustomerEvent, User
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+ACCOUNT_REGISTER_BIRTHDAY_MUTATION = """
+    mutation RegisterAccount($input: AccountRegisterInput!) {
+        accountRegister(input: $input) {
+            errors {
+                field
+                code
+                message
+            }
+            user {
+                id
+            }
+        }
+    }
+"""
+
+NEW_EMAIL = "birthday-register@example.com"
+PASSWORD = "Password"  # matches the existing register tests
+
+# Registration needs a redirect host and confirmation enabled; the email backend
+# (PluginsManager.notify) is an external system and is mocked.
+REGISTER_SETTINGS = override_settings(
+    ENABLE_ACCOUNT_CONFIRMATION_BY_EMAIL=True, ALLOWED_CLIENT_HOSTS=["localhost"]
+)
+
+
+def _register_input(email, channel_slug, birthday=None):
+    input_data = {
+        "email": email,
+        "password": PASSWORD,
+        "redirectUrl": "http://localhost:3000",
+        "channel": channel_slug,
+    }
+    if birthday is not None:
+        input_data["birthday"] = birthday
+    return {"input": input_data}
+
+
+def _birthday_changed_events():
+    return CustomerEvent.objects.filter(type=CustomerEvents.BIRTHDAY_CHANGED)
+
+
+@REGISTER_SETTINGS
+@patch("saleor.plugins.manager.PluginsManager.notify")
+def test_account_register_anonymous_birthday_logs_change_for_new_user(
+    mocked_notify, api_client, channel_USD
+):
+    """TC-H-05 (accountRegister): anonymous birthday stored, one change, actor = new user."""
+    # given
+    variables = _register_input(NEW_EMAIL, channel_USD.slug, birthday="2000-05-17")
+
+    # when
+    response = api_client.post_graphql(ACCOUNT_REGISTER_BIRTHDAY_MUTATION, variables)
+
+    # then
+    data = get_graphql_content(response)["data"]["accountRegister"]
+    assert data["errors"] == []
+    new_user = User.objects.get(email=NEW_EMAIL)
+    assert new_user.birthday == date(2000, 5, 17)
+    [event] = CustomerEvent.objects.filter(
+        user=new_user, type=CustomerEvents.BIRTHDAY_CHANGED
+    )
+    assert event.parameters == {
+        "customer_id": new_user.pk,
+        "actor_user_id": new_user.pk,
+    }
+
+
+@REGISTER_SETTINGS
+@patch("saleor.plugins.manager.PluginsManager.notify")
+def test_account_register_without_birthday_logs_no_birthday_event(
+    mocked_notify, api_client, channel_USD
+):
+    """TC-H-05 negative: registration without a birthday logs no birthday event."""
+    # given
+    variables = _register_input(NEW_EMAIL, channel_USD.slug)
+
+    # when
+    response = api_client.post_graphql(ACCOUNT_REGISTER_BIRTHDAY_MUTATION, variables)
+
+    # then
+    assert get_graphql_content(response)["data"]["accountRegister"]["errors"] == []
+    new_user = User.objects.get(email=NEW_EMAIL)
+    assert new_user.birthday is None
+    assert not _birthday_changed_events().exists()
+
+
+@REGISTER_SETTINGS
+@patch("saleor.plugins.manager.PluginsManager.notify")
+def test_account_register_existing_email_does_not_store_birthday_or_log(
+    mocked_notify, api_client, channel_USD, customer_user
+):
+    """TC-H-05 negative: an existing account is not updated and gets no event."""
+    # given
+    variables = _register_input(
+        customer_user.email, channel_USD.slug, birthday="2000-05-17"
+    )
+
+    # when
+    api_client.post_graphql(ACCOUNT_REGISTER_BIRTHDAY_MUTATION, variables)
+
+    # then
+    customer_user.refresh_from_db()
+    assert customer_user.birthday is None
+    assert not _birthday_changed_events().exists()
+
+
+@pytest.mark.parametrize(
+    "client_fixture", ["user_api_client", "staff_api_client", "app_api_client"]
+)
+def test_account_register_birthday_denied_for_authenticated_requestor(
+    client_fixture, request, channel_USD
+):
+    """Orchestrator decision: accountRegister.birthday is anonymous-only (S§7).
+
+    A logged-in customer, a staff member and an app are not the new account's owner.
+    """
+    # given
+    client = request.getfixturevalue(client_fixture)
+    variables = _register_input(NEW_EMAIL, channel_USD.slug, birthday="2000-05-17")
+
+    # when
+    response = client.post_graphql(ACCOUNT_REGISTER_BIRTHDAY_MUTATION, variables)
+
+    # then
+    assert_no_permission(response)
+    assert not User.objects.filter(email=NEW_EMAIL).exists()
+    assert not _birthday_changed_events().exists()
+
+
+@freeze_time("2026-10-23 12:00:00")
+def test_account_register_rejects_future_birthday_and_creates_no_account(
+    api_client, channel_USD
+):
+    """TC-E-10 (accountRegister): future birthday is INVALID on field birthday."""
+    # given
+    variables = _register_input(NEW_EMAIL, channel_USD.slug, birthday="2026-10-24")
+
+    # when
+    response = api_client.post_graphql(ACCOUNT_REGISTER_BIRTHDAY_MUTATION, variables)
+
+    # then
+    data = get_graphql_content(response)["data"]["accountRegister"]
+    assert data["errors"][0]["field"] == "birthday"
+    assert data["errors"][0]["code"] == AccountErrorCode.INVALID.name
+    assert data["errors"][0]["message"] == "Invalid birthday."
+    assert not User.objects.filter(email=NEW_EMAIL).exists()
+    assert not _birthday_changed_events().exists()
diff --git a/saleor/graphql/account/tests/mutations/test_account_update_birthday.py b/saleor/graphql/account/tests/mutations/test_account_update_birthday.py
