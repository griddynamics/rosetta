@@ -0,0 +1,298 @@
+"""Staff draft and order age restriction (S§5 #12-#14).
+
+Covers TC-H-04 (a draft with no customer is accepted and completes), TC-E-07 (a draft
+linked to a customer without a birthday is NOT_ELIGIBLE until the customer is unlinked
+or gets an eligible birthday), TC-E-08 (a draft whose `user_email` is a minor's email
+is blocked), TC-E-06 (generic messages, no PII), and the mapping of BIRTHDAY_REQUIRED
+and UNDERAGE onto OrderErrorCode.AGE_RESTRICTION_NOT_ELIGIBLE on staff surfaces.
+"""
+
+from datetime import date
+
+import graphene
+import pytest
+
+from .....account.models import User
+from .....account.tests.fixtures.age_restriction import ADULT_BIRTHDAY
+from .....order import OrderStatus
+from .....order.models import Order
+from ....tests.utils import get_graphql_content
+
+DRAFT_ORDER_COMPLETE = """
+mutation draftComplete($id: ID!) {
+  draftOrderComplete(id: $id) {
+    errors { field code message variants }
+    order { status }
+  }
+}
+"""
+
+ORDER_LINES_CREATE = """
+mutation orderLinesCreate($id: ID!, $variantId: ID!) {
+  orderLinesCreate(id: $id, input: [{variantId: $variantId, quantity: 1}]) {
+    errors { field code message variants }
+  }
+}
+"""
+
+DRAFT_ORDER_CREATE = """
+mutation draftCreate($input: DraftOrderCreateInput!) {
+  draftOrderCreate(input: $input) {
+    errors { field code message variants }
+    order { id }
+  }
+}
+"""
+
+NOT_ELIGIBLE_MESSAGE = "The customer is not eligible to buy age-restricted products."
+BIRTHDAY_ISO_DATES = ("2012-06-01", "2000-01-01")
+
+
+def _make_user(email, birthday):
+    return User.objects.create(email=email, birthday=birthday, is_active=True)
+
+
+def _variant_gid(order):
+    return graphene.Node.to_global_id("ProductVariant", order.lines.first().variant_id)
+
+
+def _order_gid(order):
+    return graphene.Node.to_global_id("Order", order.pk)
+
+
+def _assert_no_age_data(payload):
+    serialized = repr(payload)
+    for iso_date in BIRTHDAY_ISO_DATES:
+        assert iso_date not in serialized
+    for error in payload.get("errors") or []:
+        assert not any(char.isdigit() for char in error["message"] or "")
+
+
+@pytest.fixture
+def staff_with_orders_permission(staff_api_client, permission_group_manage_orders):
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    return staff_api_client
+
+
+@pytest.fixture
+def restricted_draft(draft_order):
+    line = draft_order.lines.first()
+    product = line.variant.product
+    product.is_age_restricted = True
+    product.save(update_fields=["is_age_restricted"])
+    draft_order.user = None
+    draft_order.user_email = ""
+    draft_order.save(update_fields=["user", "user_email"])
+    return draft_order
+
+
+def _complete(client, order):
+    response = client.post_graphql(DRAFT_ORDER_COMPLETE, {"id": _order_gid(order)})
+    return get_graphql_content(response)["data"]["draftOrderComplete"]
+
+
+def test_draft_without_customer_with_restricted_line_completes(
+    staff_with_orders_permission, restricted_draft
+):
+    """TC-H-04: no linked customer and no matching email is accepted (D4)."""
+    # when
+    payload = _complete(staff_with_orders_permission, restricted_draft)
+
+    # then
+    assert payload["errors"] == []
+    assert payload["order"]["status"] != "DRAFT"
+
+
+def test_draft_order_lines_create_without_customer_passes(
+    staff_with_orders_permission, restricted_draft
+):
+    """TC-H-04: orderLinesCreate on an unlinked draft passes."""
+    # when
+    response = staff_with_orders_permission.post_graphql(
+        ORDER_LINES_CREATE,
+        {
+            "id": _order_gid(restricted_draft),
+            "variantId": _variant_gid(restricted_draft),
+        },
+    )
+    payload = get_graphql_content(response)["data"]["orderLinesCreate"]
+
+    # then
+    assert payload["errors"] == []
+
+
+def test_draft_order_create_without_customer_with_restricted_line_passes(
+    staff_with_orders_permission, channel_USD, product
+):
+    """TC-H-04: draftOrderCreate(lines) without a customer is accepted."""
+    # given
+    product.is_age_restricted = True
+    product.save(update_fields=["is_age_restricted"])
+    variant = product.variants.first()
+    variables = {
+        "input": {
+            "channelId": graphene.Node.to_global_id("Channel", channel_USD.pk),
+            "lines": [
+                {
+                    "variantId": graphene.Node.to_global_id(
+                        "ProductVariant", variant.pk
+                    ),
+                    "quantity": 1,
+                }
+            ],
+        }
+    }
+
+    # when
+    response = staff_with_orders_permission.post_graphql(DRAFT_ORDER_CREATE, variables)
+    payload = get_graphql_content(response)["data"]["draftOrderCreate"]
+
+    # then
+    assert payload["errors"] == []
+    assert payload["order"] is not None
+    _, order_pk = graphene.Node.from_global_id(payload["order"]["id"])
+    assert Order.objects.filter(pk=order_pk).exists()
+
+
+def test_draft_order_create_linked_customer_without_birthday_not_eligible(
+    staff_with_orders_permission, channel_USD, product, no_bday
+):
+    """TC-E-07 / S§5 #14: BIRTHDAY_REQUIRED maps to NOT_ELIGIBLE on draft create."""
+    # given
