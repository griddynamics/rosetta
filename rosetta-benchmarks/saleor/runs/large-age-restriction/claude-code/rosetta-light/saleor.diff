+from datetime import date
+
+import graphene
+from freezegun import freeze_time
+
+from .....account import CustomerEvents
+from .....account.models import CustomerEvent
+from .....account.tests.fixtures.user import dangerously_create_test_user
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+CUSTOMER_BULK_UPDATE_BIRTHDAY_MUTATION = """
+    mutation CustomerBulkUpdate(
+        $customers: [CustomerBulkUpdateInput!]!,
+        $errorPolicy: ErrorPolicyEnum
+    ) {
+        customerBulkUpdate(customers: $customers, errorPolicy: $errorPolicy) {
+            count
+            errors {
+                code
+                message
+            }
+            results {
+                errors {
+                    path
+                    code
+                    message
+                }
+            }
+        }
+    }
+"""
+
+
+def _global_id(customer):
+    return graphene.Node.to_global_id("User", customer.pk)
+
+
+def _changed_events(customer):
+    return list(
+        CustomerEvent.objects.filter(
+            user=customer, type=CustomerEvents.BIRTHDAY_CHANGED
+        )
+    )
+
+
+def test_superuser_bulk_update_logs_one_change_per_changed_row(
+    superuser_api_client, superuser
+):
+    """TC-H-06 (customerBulkUpdate): per-row events; unchanged row logs nothing."""
+    # given
+    set_row = dangerously_create_test_user("bulk-set@example.com", "password")
+    unchanged_row = dangerously_create_test_user(
+        "bulk-same@example.com", "password", birthday=date(1990, 1, 2)
+    )
+    cleared_row = dangerously_create_test_user(
+        "bulk-clear@example.com", "password", birthday=date(1995, 3, 4)
+    )
+    variables = {
+        "customers": [
+            {"id": _global_id(set_row), "input": {"birthday": "2000-05-17"}},
+            {"id": _global_id(unchanged_row), "input": {"birthday": "1990-01-02"}},
+            {"id": _global_id(cleared_row), "input": {"birthday": None}},
+        ]
+    }
+
+    # when
+    response = superuser_api_client.post_graphql(
+        CUSTOMER_BULK_UPDATE_BIRTHDAY_MUTATION, variables
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["customerBulkUpdate"]
+    assert data["errors"] == []
+    assert data["count"] == 3
+    set_row.refresh_from_db()
+    unchanged_row.refresh_from_db()
+    cleared_row.refresh_from_db()
+    assert set_row.birthday == date(2000, 5, 17)
+    assert unchanged_row.birthday == date(1990, 1, 2)
+    assert cleared_row.birthday is None
+
+    [set_event] = _changed_events(set_row)
+    [clear_event] = _changed_events(cleared_row)
+    assert _changed_events(unchanged_row) == []
+    for event, customer in ((set_event, set_row), (clear_event, cleared_row)):
+        assert event.parameters == {
+            "customer_id": customer.pk,
+            "actor_user_id": superuser.pk,
+        }
+    assert (
+        CustomerEvent.objects.filter(type=CustomerEvents.BIRTHDAY_CHANGED).count() == 2
+    )
+
+
+def test_customer_bulk_update_birthday_denied_for_non_superuser_staff(
+    staff_api_client, permission_manage_users
+):
+    """TC-H-06 negative: the whole request is denied for a non-superuser staff."""
+    # given
+    customer = dangerously_create_test_user("bulk-denied@example.com", "password")
+    variables = {
+        "customers": [{"id": _global_id(customer), "input": {"birthday": "2000-05-17"}}]
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CUSTOMER_BULK_UPDATE_BIRTHDAY_MUTATION,
+        variables,
+        permissions=[permission_manage_users],
+    )
+
+    # then
+    assert_no_permission(response)
+    customer.refresh_from_db()
+    assert customer.birthday is None
+    assert _changed_events(customer) == []
+
+
+@freeze_time("2026-10-23 12:00:00")
+def test_superuser_bulk_update_invalid_birthday_rejects_everything(
+    superuser_api_client,
+):
+    """TC-E-10 (bulk): one invalid row rejects the request; no row is written."""
+    # given
+    valid_row = dangerously_create_test_user("bulk-valid@example.com", "password")
+    invalid_row = dangerously_create_test_user("bulk-future@example.com", "password")
+    variables = {
+        "customers": [
+            {"id": _global_id(valid_row), "input": {"birthday": "2000-05-17"}},
+            {"id": _global_id(invalid_row), "input": {"birthday": "2026-10-24"}},
+        ]
+    }
+
+    # when
+    response = superuser_api_client.post_graphql(
+        CUSTOMER_BULK_UPDATE_BIRTHDAY_MUTATION, variables
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["customerBulkUpdate"]
+    assert data["errors"] or any(result["errors"] for result in data["results"])
+    valid_row.refresh_from_db()
+    invalid_row.refresh_from_db()
+    assert valid_row.birthday is None
+    assert invalid_row.birthday is None
+    assert _changed_events(valid_row) == []
+    assert _changed_events(invalid_row) == []
