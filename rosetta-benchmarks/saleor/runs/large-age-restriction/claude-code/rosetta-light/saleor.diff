+"""Shared fixtures for the age restriction feature (S§13 fixtures paragraph).
+
+Single owner: session 06. Sessions 08-10 import these names; keep them stable.
+
+Semantics (defaults assume `min_age=18`, `time_zone="UTC"`):
+- `restricted_product`: the `product` fixture with `is_age_restricted=True`.
+- `adult`: customer born 2000-01-01 (eligible from 2018-01-01).
+- `minor`: customer born 2012-06-01 (eligible from 2030-06-01 at min age 18).
+- `no_bday`: customer without a birthday.
+- `set_age_settings(site_settings, minimum_age=18, time_zone="UTC")`: helper that sets
+  and saves the age restriction fields on a `SiteSettings` instance.
+- `SHOP_NOW` / `frozen_now`: fixed reference instant 2026-10-23T12:00Z. Pass it as an
+  explicit `now`/`today` to domain functions. For API flows use
+  `@freeze_time("2026-10-23 12:00:00")` instead.
+
+Birthdays are test data only. Never print them in test output or logs.
+"""
+
+from datetime import UTC, date, datetime
+
+import pytest
+
+from ....product.models import Product
+from ....site.models import SiteSettings
+from .user import dangerously_create_test_user
+
+SHOP_NOW = datetime(2026, 10, 23, 12, 0, tzinfo=UTC)
+ADULT_BIRTHDAY = date(2000, 1, 1)
+MINOR_BIRTHDAY = date(2012, 6, 1)
+
+
+def set_age_settings(
+    site_settings: SiteSettings,
+    minimum_age: int = 18,
+    time_zone: str = "UTC",
+) -> SiteSettings:
+    """Set the shop's minimum age and time zone, then save them."""
+    site_settings.age_restriction_minimum_age = minimum_age
+    site_settings.time_zone = time_zone
+    site_settings.save(update_fields=["age_restriction_minimum_age", "time_zone"])
+    return site_settings
+
+
+@pytest.fixture
+def frozen_now() -> datetime:
+    return SHOP_NOW
+
+
+@pytest.fixture
+def restricted_product(product) -> Product:
+    product.is_age_restricted = True
+    product.save(update_fields=["is_age_restricted"])
+    return product
+
+
+@pytest.fixture
+def adult(db):
+    return dangerously_create_test_user(
+        "adult@example.com",
+        "password",
+        birthday=ADULT_BIRTHDAY,
+    )
+
+
+@pytest.fixture
+def minor(db):
+    return dangerously_create_test_user(
+        "minor@example.com",
+        "password",
+        birthday=MINOR_BIRTHDAY,
+    )
+
+
+@pytest.fixture
+def no_bday(db):
+    return dangerously_create_test_user(
+        "no-birthday@example.com",
+        "password",
+    )
diff --git a/saleor/account/tests/test_age_restriction.py b/saleor/account/tests/test_age_restriction.py
new file mode 100644
index 0000000..9c312cd
--- /dev/null
+++ b/saleor/account/tests/test_age_restriction.py
@@ -0,0 +1,546 @@
+from datetime import UTC, date, datetime
+
+import pytest
+from django.core.exceptions import ValidationError
+from freezegun import freeze_time
+
+from ...product.models import Product, ProductVariant
+from ...site.models import SiteSettings
+from ..age_restriction import (
+    AgeRestrictionError,
+    AgeRestrictionReason,
+    get_age_ineligibility_reason,
+    get_eligibility_date,
+    get_shop_today,
+    is_user_age_eligible,
+    resolve_order_customer,
+    validate_age_restriction,
+    validate_birthday,
+)
+from ..error_codes import AccountErrorCode
+from ..models import User
+from .fixtures.age_restriction import (
+    ADULT_BIRTHDAY,
+    MINOR_BIRTHDAY,
+    SHOP_NOW,
+    set_age_settings,
+)
+
+GENERIC_MESSAGE = "Age restriction is not satisfied."
+
+
+def _user(birthday: date | None) -> User:
+    """Return an unsaved user; the domain only reads `birthday`."""
+    return User(email="born@example.com", birthday=birthday)
+
+
+def _line(variant_pk: int, *, restricted: bool):
+    """Return an unsaved (variant, product) pair as `validate_age_restriction` expects."""
+    return (
+        ProductVariant(pk=variant_pk),
+        Product(is_age_restricted=restricted),
+    )
+
+
+# Fixture sanity: the shared fixtures document the semantics other sessions rely on.
+
+
+def test_restricted_product_fixture_sets_flag(restricted_product):
+    """Fixture contract: restricted_product sets the flag."""
+    # given / when
+    restricted_product.refresh_from_db()
+
+    # then
+    assert restricted_product.is_age_restricted is True
+
+
+def test_customer_fixtures_have_documented_birthdays(adult, minor, no_bday):
+    """Fixture contract: adult, minor and no_bday birthdays."""
+    # given / when / then
+    assert adult.birthday == ADULT_BIRTHDAY
+    assert minor.birthday == MINOR_BIRTHDAY
+    assert no_bday.birthday is None
+
+
+# get_shop_today (R1, TC-B-05/06/07, DST and +-14 h zones)
+
+
+@pytest.mark.parametrize(
+    ("now", "time_zone", "expected"),
+    [
+        # TC-B-05: UTC+14 is already the 23rd while UTC is still the 22nd.
+        (
+            datetime(2026, 10, 22, 10, 0, tzinfo=UTC),
+            "Pacific/Kiritimati",
+            date(2026, 10, 23),
+        ),
+        (datetime(2026, 10, 22, 10, 0, tzinfo=UTC), "UTC", date(2026, 10, 22)),
+        # TC-B-06: UTC-11 is still the 22nd at 05:00Z on the 23rd.
+        (
+            datetime(2026, 10, 23, 5, 0, tzinfo=UTC),
+            "Pacific/Pago_Pago",
+            date(2026, 10, 22),
+        ),
+        # UTC-12 edge, both sides of local midnight.
+        (datetime(2026, 10, 23, 11, 59, tzinfo=UTC), "Etc/GMT+12", date(2026, 10, 22)),
+        (datetime(2026, 10, 23, 12, 0, tzinfo=UTC), "Etc/GMT+12", date(2026, 10, 23)),
+        # TC-B-07: DST end day in Europe/Warsaw (2026-10-25, 03:00 CEST -> 02:00 CET).
+        (
+            datetime(2026, 10, 24, 21, 59, tzinfo=UTC),
+            "Europe/Warsaw",
+            date(2026, 10, 24),
+        ),
+        (
+            datetime(2026, 10, 24, 22, 30, tzinfo=UTC),
+            "Europe/Warsaw",
+            date(2026, 10, 25),
+        ),
+        (
+            datetime(2026, 10, 25, 1, 30, tzinfo=UTC),
+            "Europe/Warsaw",
+            date(2026, 10, 25),
+        ),
+    ],
+)
+def test_shop_today_uses_shop_time_zone(
+    site_settings: SiteSettings, now, time_zone, expected
+):
+    """R1 shop day per zone. TC-B-05, TC-B-06, TC-B-07, +-14 h edges."""
+    # given
+    set_age_settings(site_settings, time_zone=time_zone)
+
+    # when
+    result = get_shop_today(site_settings, now=now)
+
+    # then
+    assert result == expected
+
+
+def test_shop_today_rejects_naive_datetime(site_settings: SiteSettings):
+    """m-6: a naive `now` would be read as system-local time, so it is refused."""
+    # given
+    set_age_settings(site_settings, time_zone="UTC")
+
+    # when / then
+    with pytest.raises(ValueError, match="timezone-aware"):
+        get_shop_today(
+            site_settings,
+            now=datetime(2026, 10, 23, 5, 0),  # noqa: DTZ001 (naive on purpose)
+        )
+
+
+@freeze_time("2026-10-23 05:00:00")
+def test_shop_today_defaults_to_current_time(site_settings: SiteSettings):
+    """R1 default now path (wall clock frozen)."""
+    # given
+    set_age_settings(site_settings, time_zone="Pacific/Pago_Pago")
+
+    # when
+    result = get_shop_today(site_settings)
+
+    # then: 05:00Z is 18:00 on the 22nd in UTC-11
+    assert result == date(2026, 10, 22)
+
+
+# get_eligibility_date (R2, Feb 29 -> Mar 1 in non-leap target years)
+
+
+@pytest.mark.parametrize(
+    ("birthday", "minimum_age", "expected"),
+    [
+        (date(2008, 10, 23), 18, date(2026, 10, 23)),
+        (date(2008, 2, 29), 18, date(2026, 3, 1)),
+        (date(2004, 2, 29), 20, date(2024, 2, 29)),
+        (date(2000, 2, 29), 21, date(2021, 3, 1)),
+        (date(2000, 2, 29), 24, date(2024, 2, 29)),
+        (date(2000, 1, 1), 1, date(2001, 1, 1)),
+    ],
+)
+def test_eligibility_date(birthday, minimum_age, expected):
+    """R2 target date; Feb 29 maps to Mar 1 in non-leap years. TC-B-03/04."""
+    # given / when
+    result = get_eligibility_date(birthday, minimum_age)
+
+    # then
+    assert result == expected
+
+
+# Eligibility boundaries (TC-B-01/02/03/04)
+
+
+@pytest.mark.parametrize(
+    ("birthday", "minimum_age", "today", "eligible"),
+    [
+        # TC-B-01: turns 18 today, eligible on the day.
+        (date(2008, 10, 23), 18, date(2026, 10, 23), True),
+        # TC-B-02: turns 18 tomorrow.
+        (date(2008, 10, 24), 18, date(2026, 10, 23), False),
+        # Day before the turning-age day.
+        (date(2008, 10, 23), 18, date(2026, 10, 22), False),
+        # TC-B-03: Feb 29 birthday, non-leap target year, 28th vs 1st of March.
+        (date(2008, 2, 29), 18, date(2026, 2, 28), False),
+        (date(2008, 2, 29), 18, date(2026, 3, 1), True),
+        # TC-B-04: target year is leap, eligible on Feb 29 itself.
+        (date(2004, 2, 29), 20, date(2024, 2, 29), True),
+        (date(2004, 2, 29), 20, date(2024, 2, 28), False),
+        # Leap-year birthday with a non-leap target year.
+        (date(2000, 2, 29), 21, date(2021, 2, 28), False),
+        (date(2000, 2, 29), 21, date(2021, 3, 1), True),
+    ],
+)
+def test_eligibility_on_boundary_days(
+    site_settings: SiteSettings, birthday, minimum_age, today, eligible
+):
+    """R3 turning-age boundary. TC-B-01, TC-B-02, TC-B-03, TC-B-04."""
+    # given
+    set_age_settings(site_settings, minimum_age=minimum_age)
+    user = _user(birthday)
+
+    # when
+    reason = get_age_ineligibility_reason(user, site_settings, today=today)
+
+    # then
+    assert (reason is None) is eligible
+    assert is_user_age_eligible(user, site_settings, today=today) is eligible
+    if not eligible:
+        assert reason == AgeRestrictionReason.UNDERAGE
+
+
+@pytest.mark.parametrize(
+    ("now", "time_zone", "eligible"),
+    [
+        # TC-B-05: same instant, shop today differs by time zone.
+        (datetime(2026, 10, 22, 10, 0, tzinfo=UTC), "Pacific/Kiritimati", True),
+        (datetime(2026, 10, 22, 10, 0, tzinfo=UTC), "UTC", False),
+        # TC-B-06: UTC-11 is still the 22nd at 05:00Z, so the 2008-10-23 birthday is
+        # not yet 18 for the shop today.
+        (datetime(2026, 10, 23, 5, 0, tzinfo=UTC), "Pacific/Pago_Pago", False),
+    ],
+)
+def test_eligibility_uses_shop_today_from_time_zone(
+    site_settings: SiteSettings, now, time_zone, eligible
+):
+    """TC-B-05: same instant, zone-dependent result."""
+    # given
+    set_age_settings(site_settings, time_zone=time_zone)
+    user = _user(date(2008, 10, 23))
+    today = get_shop_today(site_settings, now=now)
+
+    # when
+    reason = get_age_ineligibility_reason(user, site_settings, today=today)
+
+    # then
+    assert (reason is None) is eligible
+
+
+@freeze_time("2026-10-23 12:00:00")
+def test_is_user_age_eligible_defaults_to_current_shop_day(
+    site_settings: SiteSettings,
+):
+    """R3 default today path (wall clock frozen)."""
+    # given
+    set_age_settings(site_settings)
+
+    # when / then
+    assert is_user_age_eligible(_user(date(2008, 10, 23)), site_settings) is True
+    assert is_user_age_eligible(_user(date(2008, 10, 24)), site_settings) is False
+
+
+# Reason precedence (TC-B-12)
+
+
+@pytest.mark.parametrize(
+    ("user", "expected"),
+    [
+        (None, AgeRestrictionReason.LOGIN_REQUIRED),
+        (_user(None), AgeRestrictionReason.BIRTHDAY_REQUIRED),
+        (_user(MINOR_BIRTHDAY), AgeRestrictionReason.UNDERAGE),
+    ],
+)
+def test_reason_precedence(site_settings: SiteSettings, user, expected):
+    """R4 reason precedence. TC-B-12."""
+    # given
+    set_age_settings(site_settings)
+
+    # when
+    reason = get_age_ineligibility_reason(user, site_settings, today=SHOP_NOW.date())
+
+    # then
+    assert reason == expected
+    assert is_user_age_eligible(user, site_settings, today=SHOP_NOW.date()) is False
+
+
+def test_adult_is_eligible_without_reason(site_settings: SiteSettings, adult):
+    """R3 eligible adult has no reason."""
+    # given
+    set_age_settings(site_settings)
+
+    # when
+    reason = get_age_ineligibility_reason(adult, site_settings, today=SHOP_NOW.date())
+
+    # then
+    assert reason is None
+
+
+# validate_birthday (R8, TC-B-09). It uses timezone.now, so time is frozen.
+
+
+@pytest.mark.parametrize(
+    ("frozen_at", "time_zone", "birthday", "valid"),
+    [
+        # TC-B-09: today ok, tomorrow not, 120 years back ok, one day further not.
+        ("2026-10-23 12:00:00", "UTC", date(2026, 10, 23), True),
+        ("2026-10-23 12:00:00", "UTC", date(2026, 10, 24), False),
+        ("2026-10-23 12:00:00", "UTC", date(1906, 10, 23), True),
+        ("2026-10-23 12:00:00", "UTC", date(1906, 10, 22), False),
+        # Shop day is used, not the UTC day: 12:00Z on the 22nd is the 23rd in UTC+14.
+        ("2026-10-22 12:00:00", "Pacific/Kiritimati", date(2026, 10, 23), True),
+        ("2026-10-22 12:00:00", "Pacific/Kiritimati", date(2026, 10, 24), False),
+        ("2026-10-22 12:00:00", "UTC", date(2026, 10, 23), False),
+        # 120-year boundary when the reference day is Feb 29 and the target is
+        # not a leap year (1900): the earliest valid birthday is Mar 1.
+        ("2020-02-29 12:00:00", "UTC", date(1900, 3, 1), True),
+        ("2020-02-29 12:00:00", "UTC", date(1900, 2, 28), False),
+        # Leap target year: Feb 29 is valid.
+        ("2028-02-29 12:00:00", "UTC", date(1908, 2, 29), True),
+        ("2028-02-29 12:00:00", "UTC", date(1908, 2, 28), False),
+    ],
+)
+def test_validate_birthday(
+    site_settings: SiteSettings, frozen_at, time_zone, birthday, valid
+):
+    """R8 birthday bounds, shop-day based. TC-B-09, 120-year and Feb 29 edges."""
+    # given
+    set_age_settings(site_settings, time_zone=time_zone)
+
+    with freeze_time(frozen_at):
+        # when / then
+        if valid:
+            validate_birthday(birthday, site_settings)
+            return
+        with pytest.raises(ValidationError) as error:
+            validate_birthday(birthday, site_settings)
+
+    assert error.value.code == AccountErrorCode.INVALID.value
+    assert error.value.messages == ["Invalid birthday."]
+    assert birthday.isoformat() not in str(error.value)
+
+
+# validate_age_restriction (R5, R9, NFR-7)
+
+
+def test_validate_passes_without_restricted_lines(site_settings: SiteSettings):
+    """R5 no-op without restricted lines."""
+    # given
+    set_age_settings(site_settings)
+    lines = [_line(1, restricted=False), _line(2, restricted=False)]
+
+    # when / then: every requestor passes, including a guest and a minor
+    for user in (None, _user(MINOR_BIRTHDAY), _user(None)):
+        validate_age_restriction(user, lines, site_settings)
+
+
+def test_restricted_line_without_customer_raises_login_required(
+    site_settings: SiteSettings,
+):
+    """R4/R5: guest raises LOGIN_REQUIRED. TC-B-12."""
+    # given
+    set_age_settings(site_settings)
+    lines = [_line(1, restricted=False), _line(2, restricted=True)]
+
+    # when
+    with pytest.raises(AgeRestrictionError) as error:
+        validate_age_restriction(None, lines, site_settings)
+
+    # then
+    assert error.value.reason == AgeRestrictionReason.LOGIN_REQUIRED
+    assert error.value.variant_ids == [2]
+
+
+def test_restricted_line_customer_without_birthday_raises_birthday_required(
+    site_settings: SiteSettings,
+):
+    """R4: no birthday raises BIRTHDAY_REQUIRED. TC-B-12."""
+    # given
+    set_age_settings(site_settings)
+    lines = [_line(7, restricted=True)]
+
+    # when
+    with pytest.raises(AgeRestrictionError) as error:
+        validate_age_restriction(_user(None), lines, site_settings)
+
+    # then
+    assert error.value.reason == AgeRestrictionReason.BIRTHDAY_REQUIRED
+    assert error.value.variant_ids == [7]
+
+
+@freeze_time("2026-10-23 12:00:00")
+def test_restricted_line_underage_raises_underage_with_restricted_variants_only(
+    site_settings: SiteSettings,
+):
+    """R5: UNDERAGE with restricted variant ids only. TC-B-12."""
+    # given
+    set_age_settings(site_settings)
+    lines = [
+        _line(11, restricted=True),
+        _line(12, restricted=False),
+        _line(13, restricted=True),
+    ]
+
+    # when
+    with pytest.raises(AgeRestrictionError) as error:
+        validate_age_restriction(_user(MINOR_BIRTHDAY), lines, site_settings)
+
+    # then: only restricted variant ids, in line order
+    assert error.value.reason == AgeRestrictionReason.UNDERAGE
+    assert error.value.variant_ids == [11, 13]
+
+
+@freeze_time("2026-10-23 12:00:00")
+def test_adult_passes_restricted_lines(site_settings: SiteSettings, adult):
+    """R5: eligible adult passes."""
+    # given
+    set_age_settings(site_settings)
+
+    # when / then
+    validate_age_restriction(adult, [_line(1, restricted=True)], site_settings)
+
+
+@freeze_time("2026-10-23 12:00:00")
+def test_error_message_and_str_never_contain_birthday(
+    site_settings: SiteSettings,
+):
+    """NFR-7: generic str(error), no birthday or age."""
+    # given
+    set_age_settings(site_settings)
+
+    # when
+    with pytest.raises(AgeRestrictionError) as error:
+        validate_age_restriction(
+            _user(MINOR_BIRTHDAY), [_line(1, restricted=True)], site_settings
+        )
+
+    # then
+    assert str(error.value) == GENERIC_MESSAGE
+    assert MINOR_BIRTHDAY.isoformat() not in str(error.value)
+    assert "18" not in str(error.value)
+
+
+@pytest.mark.parametrize(
+    ("user_factory", "expected"),
+    [
+        (lambda: None, AgeRestrictionReason.LOGIN_REQUIRED),
+        (lambda: _user(None), AgeRestrictionReason.BIRTHDAY_REQUIRED),
+        (lambda: _user(MINOR_BIRTHDAY), AgeRestrictionReason.UNDERAGE),
+    ],
+)
+@freeze_time("2026-10-23 12:00:00")
+def test_allow_anonymous_passes_only_missing_customer(
+    site_settings: SiteSettings, user_factory, expected
+):
+    """R5 allow_anonymous (D4): missing customer passes, linked customer checked."""
+    # given
+    set_age_settings(site_settings)
+    lines = [_line(1, restricted=True)]
+    user = user_factory()
+
+    # when / then
+    if user is None:
+        # Staff drafts without a linked customer are accepted (D4).
+        validate_age_restriction(None, lines, site_settings, allow_anonymous=True)
+        return
+
+    # A linked customer is still checked.
+    with pytest.raises(AgeRestrictionError) as error:
+        validate_age_restriction(user, lines, site_settings, allow_anonymous=True)
+    assert error.value.reason == expected
+
+
+@freeze_time("2026-10-23 12:00:00")
+def test_allow_anonymous_has_no_effect_on_guest_without_restricted_lines(
+    site_settings: SiteSettings,
+):
+    """R5: no restricted lines is a no-op."""
+    # given
+    set_age_settings(site_settings)
+
+    # when / then
+    validate_age_restriction(
+        None, [_line(1, restricted=False)], site_settings, allow_anonymous=False
+    )
+
+
+@freeze_time("2026-10-23 12:00:00")
+def test_settings_are_read_from_instance_at_call_time(site_settings: SiteSettings):
+    """R9 / NFR-4: settings read from the instance at call time."""
+    # given: a minor is underage at min age 18 ...
+    user = _user(MINOR_BIRTHDAY)
+    lines = [_line(1, restricted=True)]
+    set_age_settings(site_settings, minimum_age=18)
+    with pytest.raises(AgeRestrictionError):
+        validate_age_restriction(user, lines, site_settings)
+
+    # when: ... and eligible after the shop lowers the minimum age (R9, NFR-4)
+    set_age_settings(site_settings, minimum_age=12)
+
+    # then
+    validate_age_restriction(user, lines, site_settings)
+
+
+# resolve_order_customer (R7, A6)
+
+
+def test_resolve_order_customer_returns_linked_user(order, customer_user):
+    """R7: linked order user is returned."""
+    # given
+    order.user = customer_user
+    order.save(update_fields=["user"])
+
+    # when / then
+    assert resolve_order_customer(order) == customer_user
+
+
+def test_resolve_order_customer_prefers_linked_user_over_email(
+    order, customer_user, adult
+):
+    """R7: linked user wins over a matching email."""
+    # given
+    order.user = customer_user
+    order.user_email = adult.email
+    order.save(update_fields=["user", "user_email"])
+
+    # when / then
+    assert resolve_order_customer(order) == customer_user
+
+
+def test_resolve_order_customer_matches_user_by_email(order, adult):
+    """R7: unlinked order matches a user by email."""
+    # given
+    order.user = None
+    order.user_email = adult.email
+    order.save(update_fields=["user", "user_email"])
