diff --git a/saleor/graphql/webhook/tests/test_birthday_privacy_subscriptions.py b/saleor/graphql/webhook/tests/test_birthday_privacy_subscriptions.py
new file mode 100644
index 0000000..afb194c
--- /dev/null
+++ b/saleor/graphql/webhook/tests/test_birthday_privacy_subscriptions.py
@@ -0,0 +1,172 @@
+"""Birthday privacy in subscription webhook payloads (S§11 I-1; S§13 TC-SEC-07).
+
+Payloads are produced by the real subscription machinery
+(`create_deliveries_for_subscriptions`), never by hand-built dicts. The webhook app is
+the requestor of every payload, so `birthday`, `isAgeEligible` and `isSuperuser` must be
+null even when the event was triggered by a superuser (the `requestor` argument only
+feeds the payload meta).
+"""
+
+import json
+
+import pytest
+
+from ....account.tests.fixtures.age_restriction import ADULT_BIRTHDAY
+from ....order import OrderStatus
+from ....webhook.event_types import WebhookEventAsyncType
+from ....webhook.models import Webhook
+from ....webhook.transport.asynchronous.transport import (
+    create_deliveries_for_subscriptions,
+)
+
+CUSTOMER_PRIVACY_FIELDS = "id email birthday isAgeEligible isSuperuser"
+
+CUSTOMER_CREATED_QUERY = f"""
+subscription {{
+  event {{
+    ... on CustomerCreated {{ user {{ {CUSTOMER_PRIVACY_FIELDS} }} }}
+  }}
+}}
+"""
+
+CUSTOMER_UPDATED_QUERY = f"""
+subscription {{
+  event {{
+    ... on CustomerUpdated {{ user {{ {CUSTOMER_PRIVACY_FIELDS} }} }}
+  }}
+}}
+"""
+
+STAFF_UPDATED_QUERY = f"""
+subscription {{
+  event {{
+    ... on StaffUpdated {{ user {{ {CUSTOMER_PRIVACY_FIELDS} }} }}
+  }}
+}}
+"""
+
+ORDER_CREATED_QUERY = f"""
+subscription {{
+  event {{
+    ... on OrderCreated {{
+      order {{ id user {{ {CUSTOMER_PRIVACY_FIELDS} }} }}
+    }}
+  }}
+}}
+"""
+
+
+def _webhook(app, event_type, query) -> Webhook:
+    webhook = Webhook.objects.create(
+        name=f"birthday privacy {event_type}",
+        app=app,
+        target_url="http://www.example.com/any",
+        subscription_query=query,
+    )
+    webhook.events.create(event_type=event_type)
+    return webhook
+
+
+def _payload(event_type, subscribable_object, webhook, requestor) -> dict:
+    deliveries = create_deliveries_for_subscriptions(
+        event_type, subscribable_object, [webhook], requestor=requestor
+    )
+    assert len(deliveries) == 1, "subscription did not produce a delivery"
+    return json.loads(deliveries[0].payload.get_payload())
+
+
+def _assert_user_privacy(node: dict, user):
+    # control: the birthday is stored, so a null in the payload is the gate
+    assert user.birthday is not None
+    # the payload is real: the user resolved and the non-sensitive field is present
+    assert node["email"] == user.email
+    assert node["birthday"] is None
+    assert node["isAgeEligible"] is None
+    assert node["isSuperuser"] is None
+
+
+@pytest.mark.parametrize(
+    ("event_type", "query", "attr"),
+    [
+        (WebhookEventAsyncType.CUSTOMER_CREATED, CUSTOMER_CREATED_QUERY, "user"),
+        (WebhookEventAsyncType.CUSTOMER_UPDATED, CUSTOMER_UPDATED_QUERY, "user"),
+    ],
+)
+def test_tc_sec_07_customer_subscription_payload_has_null_birthday(
+    event_type, query, attr, webhook_app, adult, superuser
+):
+    assert adult.birthday == ADULT_BIRTHDAY
+    # given: the customer has a birthday and a superuser triggered the event
+    webhook = _webhook(webhook_app, event_type, query)
+
+    # when
+    payload = _payload(event_type, adult, webhook, requestor=superuser)
+
+    # then
+    _assert_user_privacy(payload[attr], adult)
+    assert payload[attr]["id"]
+
+
+def test_tc_sec_07_staff_updated_subscription_payload_has_null_birthday(
+    webhook_app, staff_user, superuser
+):
+    # given: a staff user with a birthday (a value must exist for the gate to matter)
+    staff_user.birthday = ADULT_BIRTHDAY
+    staff_user.save(update_fields=["birthday"])
+    webhook = _webhook(
+        webhook_app, WebhookEventAsyncType.STAFF_UPDATED, STAFF_UPDATED_QUERY
+    )
+
+    # when
+    payload = _payload(
+        WebhookEventAsyncType.STAFF_UPDATED, staff_user, webhook, requestor=superuser
+    )
+
+    # then
+    _assert_user_privacy(payload["user"], staff_user)
+
+
+def test_tc_sec_07_order_created_subscription_payload_has_null_user_birthday(
+    webhook_app, order, adult, superuser
+):
+    # given: an order placed by the adult customer
+    order.user = adult
+    order.user_email = adult.email
+    order.status = OrderStatus.UNFULFILLED
+    order.save(update_fields=["user", "user_email", "status"])
+    webhook = _webhook(
+        webhook_app, WebhookEventAsyncType.ORDER_CREATED, ORDER_CREATED_QUERY
+    )
+
+    # when
+    payload = _payload(
+        WebhookEventAsyncType.ORDER_CREATED, order, webhook, requestor=superuser
+    )
+
+    # then
+    _assert_user_privacy(payload["order"]["user"], adult)
+
+
+def test_tc_sec_07_subscription_payload_has_no_birthday_key_anywhere(
+    webhook_app, adult, superuser
+):
+    # given
+    webhook = _webhook(
+        webhook_app, WebhookEventAsyncType.CUSTOMER_CREATED, CUSTOMER_CREATED_QUERY
+    )
+
+    # when
+    payload = _payload(
+        WebhookEventAsyncType.CUSTOMER_CREATED, adult, webhook, requestor=superuser
+    )
+
+    # then: the requested fields are present as keys with null values only
+    assert set(payload["user"]) == {
+        "id",
+        "email",
+        "birthday",
+        "isAgeEligible",
+        "isSuperuser",
+    }
+    serialized = json.dumps(payload)
+    assert ADULT_BIRTHDAY.isoformat() not in serialized
