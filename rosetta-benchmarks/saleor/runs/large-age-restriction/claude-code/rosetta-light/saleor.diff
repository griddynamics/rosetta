+"""Birthday audit trail and no-value checks (S§9 D6, S§11 I-4, R-1; S§13 TC-SEC-10).
+
+Covers READ events (one per customer per request, subject in `user`, parameters ids
+only, owner reads and null resolutions never logged), CHANGE events (parameters ids
+only), and the absence of any birthday value in CustomerEvent rows, application logs
+(INFO and above) and GraphQL error messages.
+
+Birthdays are test data only. Assertions compare typed values or ISO strings built from
+the fixture; nothing is printed to output or written to disk.
+"""
+
+import logging
+from datetime import date
+
+import graphene
+import pytest
+from freezegun import freeze_time
+
+from .....account import CustomerEvents
+from .....account.models import CustomerEvent, User
+from .....account.tests.fixtures.age_restriction import ADULT_BIRTHDAY
+from ....tests.fixtures import ApiClient
+from ....tests.utils import get_graphql_content
+
+FROZEN_NOW = "2026-10-23 12:00:00"
+NEW_BIRTHDAY = date(1971, 8, 23)
+FUTURE_BIRTHDAY = date(2999, 1, 1)
+
+USER_READ_QUERY = """
+query ($id: ID!) {
+  user(id: $id) { id birthday isAgeEligible }
+}
+"""
+
+ME_QUERY = """
+query {
+  me { id birthday isAgeEligible }
+}
+"""
+
+CUSTOMER_UPDATE_MUTATION = """
+mutation ($id: ID!, $input: CustomerInput!) {
+  customerUpdate(id: $id, input: $input) {
+    user { id birthday }
+    errors { field code message }
+  }
+}
+"""
+
+
+def _gid(user: User) -> str:
+    return graphene.Node.to_global_id("User", user.pk)
+
+
+def _read_events_for(user: User):
+    return CustomerEvent.objects.filter(
+        type=CustomerEvents.BIRTHDAY_READ, user_id=user.pk
+    )
+
+
+def _change_events_for(user: User):
+    return CustomerEvent.objects.filter(
+        type=CustomerEvents.BIRTHDAY_CHANGED, user_id=user.pk
+    )
+
+
+def _iso_forms(value: date) -> list[str]:
+    return [value.isoformat(), value.strftime("%d.%m.%Y"), value.strftime("%m/%d/%Y")]
+
+
+def _assert_no_birthday_text(text: str, *values: date) -> None:
+    for value in values:
+        for form in _iso_forms(value):
+            assert form not in text
+
+
+@freeze_time(FROZEN_NOW)
+def test_tc_sec_10_superuser_read_logs_one_event_with_ids_only(
+    superuser_api_client, superuser, adult
+):
+    # when
+    response = superuser_api_client.post_graphql(USER_READ_QUERY, {"id": _gid(adult)})
+    content = get_graphql_content(response)
+
+    # then
+    assert date.fromisoformat(content["data"]["user"]["birthday"]) == ADULT_BIRTHDAY
+    event = _read_events_for(adult).get()
+    assert event.parameters == {
+        "customer_id": adult.pk,
+        "actor_user_id": superuser.pk,
+    }
+    assert event.order_id is None
+    assert event.app_id is None
+
+
+@freeze_time(FROZEN_NOW)
+def test_tc_sec_10_read_events_are_counted_per_request_not_per_field(
+    superuser_api_client, adult
+):
+    # given: two fields on the same customer in one request
+    query = """
+    query ($id: ID!) {
+      user(id: $id) { birthday isAgeEligible }
+      alias: user(id: $id) { birthday }
+    }
+    """
+
+    # when
+    get_graphql_content(superuser_api_client.post_graphql(query, {"id": _gid(adult)}))
+
+    # then: one event for the request, not one per field or alias
+    assert _read_events_for(adult).count() == 1
+
+    # when: a second request
+    get_graphql_content(superuser_api_client.post_graphql(query, {"id": _gid(adult)}))
+
+    # then: each request is logged once
+    assert _read_events_for(adult).count() == 2
+
+
+@freeze_time(FROZEN_NOW)
+def test_tc_sec_10_owner_reads_self_produces_no_event(adult):
+    # when
+    content = get_graphql_content(ApiClient(user=adult).post_graphql(ME_QUERY))
+
+    # then
+    assert date.fromisoformat(content["data"]["me"]["birthday"]) == ADULT_BIRTHDAY
+    assert not CustomerEvent.objects.filter(
+        type__in=[CustomerEvents.BIRTHDAY_READ, CustomerEvents.BIRTHDAY_CHANGED],
+        user_id=adult.pk,
+    ).exists()
+
+
+@freeze_time(FROZEN_NOW)
+def test_tc_sec_10_superuser_owner_read_produces_no_event(
+    superuser_api_client, superuser
+):
+    # given
+    superuser.birthday = ADULT_BIRTHDAY
+    superuser.save(update_fields=["birthday"])
+
+    # when
+    content = get_graphql_content(superuser_api_client.post_graphql(ME_QUERY))
+
+    # then
+    assert content["data"]["me"]["birthday"] == ADULT_BIRTHDAY.isoformat()
+    assert not _read_events_for(superuser).exists()
+
+
+@freeze_time(FROZEN_NOW)
+def test_null_resolution_for_manage_users_staff_produces_no_birthday_read(
+    staff_api_client, adult, permission_manage_users
+):
+    # given: MANAGE_USERS reads only `birthday`, which is null for non-superusers
+    staff_api_client.user.user_permissions.add(permission_manage_users)
+
+    # when
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            "query ($id: ID!) { user(id: $id) { birthday } }",
+            {"id": _gid(adult)},
+        )
+    )
+
+    # then
+    assert content["data"]["user"]["birthday"] is None
+    assert not _read_events_for(adult).exists()
+
+
+@freeze_time(FROZEN_NOW)
+def test_customer_update_change_event_has_ids_only_and_no_message(
+    superuser_api_client, superuser, customer_user
+):
+    # when
+    content = get_graphql_content(
+        superuser_api_client.post_graphql(
+            CUSTOMER_UPDATE_MUTATION,
+            {
+                "id": _gid(customer_user),
+                "input": {"birthday": NEW_BIRTHDAY.isoformat()},
+            },
+        )
+    )
+
+    # then
+    assert not content["data"]["customerUpdate"]["errors"]
+    event = _change_events_for(customer_user).get()
+    assert event.parameters == {
+        "customer_id": customer_user.pk,
+        "actor_user_id": superuser.pk,
+    }
+
+
+@freeze_time(FROZEN_NOW)
+def test_no_birthday_value_in_any_event_row_after_all_operations(
+    superuser_api_client,
+    staff_api_client,
+    adult,
+    customer_user,
+    permission_manage_users,
+):
+    # given: a mix of change, read and denied operations
+    get_graphql_content(
+        superuser_api_client.post_graphql(
+            CUSTOMER_UPDATE_MUTATION,
+            {
+                "id": _gid(customer_user),
+                "input": {"birthday": NEW_BIRTHDAY.isoformat()},
+            },
+        )
+    )
+    get_graphql_content(
+        superuser_api_client.post_graphql(USER_READ_QUERY, {"id": _gid(adult)})
+    )
+    staff_api_client.user.user_permissions.add(permission_manage_users)
+    staff_api_client.post_graphql(
+        CUSTOMER_UPDATE_MUTATION,
+        {"id": _gid(adult), "input": {"birthday": NEW_BIRTHDAY.isoformat()}},
+        check_no_permissions=False,
+    )
+
+    # then: parameters hold only ids; no message; no date text anywhere
+    events = list(
+        CustomerEvent.objects.filter(
+            type__in=[CustomerEvents.BIRTHDAY_CHANGED, CustomerEvents.BIRTHDAY_READ]
+        ).values("type", "parameters")
+    )
+    assert events
+    for event in events:
+        assert set(event["parameters"]) == {"customer_id", "actor_user_id"}
+        _assert_no_birthday_text(
+            repr(event["parameters"]), ADULT_BIRTHDAY, NEW_BIRTHDAY
+        )
+
+    # `CustomerEvent.message` resolves null for birthday events (S§9)
+    content = get_graphql_content(
+        superuser_api_client.post_graphql(
+            "query ($id: ID!) { user(id: $id) { events { type message } } }",
+            {"id": _gid(adult)},
+        )
+    )
+    birthday_events = [
+        event
+        for event in content["data"]["user"]["events"]
+        if event["type"] in ("BIRTHDAY_CHANGED", "BIRTHDAY_READ")
+    ]
+    assert birthday_events
+    assert all(event["message"] is None for event in birthday_events)
+
