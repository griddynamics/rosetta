+def validate_checkout_age_restriction(
+    checkout: checkout_models.Checkout,
+    info,
+    error_code_enum: Any,
+) -> None:
+    """Reject restricted checkout lines when the checkout customer is not eligible.
+
+    The customer is `checkout.user` as stored. Site settings come from the request-fresh
+    site and are loaded only when the checkout has a restricted line.
+    """
+    restricted_lines = list(
+        checkout.lines.filter(variant__product__is_age_restricted=True).select_related(
+            "variant__product"
+        )
+    )
+    if not restricted_lines:
+        return
+    site_settings = get_site_promise(info.context).get().settings
+    variants_with_products = [
+        (line.variant, line.variant.product) for line in restricted_lines
+    ]
+    try:
+        validate_age_restriction(checkout.user, variants_with_products, site_settings)
+    except AgeRestrictionError as error:
+        error_code = {
+            AgeRestrictionReason.LOGIN_REQUIRED: error_code_enum.AGE_RESTRICTION_LOGIN_REQUIRED,
+            AgeRestrictionReason.BIRTHDAY_REQUIRED: error_code_enum.AGE_RESTRICTION_BIRTHDAY_REQUIRED,
+            AgeRestrictionReason.UNDERAGE: error_code_enum.AGE_RESTRICTION_UNDERAGE,
+        }[error.reason]
+        raise ValidationError(
+            {
+                "lines": ValidationError(
+                    AGE_RESTRICTION_MESSAGES[error.reason],
+                    code=error_code.value,
+                    params={
+                        "variants": [
+                            graphene.Node.to_global_id("ProductVariant", variant_id)
+                            for variant_id in error.variant_ids
+                        ]
+                    },
+                )
+            }
+        ) from error
+
