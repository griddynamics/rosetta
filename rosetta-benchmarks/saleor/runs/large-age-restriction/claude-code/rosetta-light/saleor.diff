+def test_guest_lines_add_restricted_requires_login(
+    api_client, checkout, restricted_variant
+):
+    # given
+    variables = {
+        "id": _gid("Checkout", checkout.token),
+        "lines": [_line(restricted_variant)],
+    }
+
+    # when
+    response = api_client.post_graphql(MUTATION_LINES_ADD, variables)
+
+    # then (TC-E-01)
+    errors = get_graphql_content(response)["data"]["checkoutLinesAdd"]["errors"]
+    assert len(errors) == 1
+    assert errors[0]["code"] == "AGE_RESTRICTION_LOGIN_REQUIRED"
+    assert errors[0]["field"] == "lines"
+    assert errors[0]["variants"] == [_gid("ProductVariant", restricted_variant.pk)]
+    _assert_no_age_data(errors)
+    assert not checkout.lines.filter(variant=restricted_variant).exists()
+
