+from django.utils import timezone
+
+from .....account import CustomerEvents
+from .....account.models import CustomerEvent, User
+from .....core.tokens import account_delete_token_generator
+from ....tests.utils import get_graphql_content
+
+ACCOUNT_DELETE_MUTATION = """
+    mutation AccountDelete($token: String!) {
+        accountDelete(token: $token) {
+            errors {
+                field
+                message
+            }
+        }
+    }
+"""
+
+
+def test_account_delete_keeps_birthday_events_and_deletes_other_events(
+    user_api_client,
+):
+    """TC-R-01 (accountDelete): birthday events kept, others deleted."""
+    # TC-R-01 (accountDelete). The customer acts on their own account, so the
+    # birthday events carry the customer as actor.
+    # given
+    user = user_api_client.user
+    user.last_login = timezone.now()
+    user.save(update_fields=["last_login"])
+    birthday_changed = CustomerEvent.objects.create(
+        user=user,
+        type=CustomerEvents.BIRTHDAY_CHANGED,
+        parameters={"customer_id": user.pk, "actor_user_id": user.pk},
+    )
+    birthday_read = CustomerEvent.objects.create(
+        user=user,
+        type=CustomerEvents.BIRTHDAY_READ,
+        parameters={"customer_id": user.pk, "actor_user_id": user.pk},
+    )
+    placed_order = CustomerEvent.objects.create(
+        user=user, type=CustomerEvents.PLACED_ORDER, parameters={}
+    )
+    email_changed = CustomerEvent.objects.create(
+        user=user, type=CustomerEvents.EMAIL_CHANGED, parameters={}
+    )
+    user_id = user.pk
+    token = account_delete_token_generator.make_token(user)
+
+    # when
+    response = user_api_client.post_graphql(ACCOUNT_DELETE_MUTATION, {"token": token})
+
+    # then
+    content = get_graphql_content(response)
+    assert content["data"]["accountDelete"]["errors"] == []
+    assert not User.objects.filter(pk=user_id).exists()
+
+    for event in (birthday_changed, birthday_read):
+        retained = CustomerEvent.objects.get(pk=event.pk)
+        assert retained.user_id is None
+        assert retained.parameters == event.parameters
+    assert not CustomerEvent.objects.filter(
+        pk__in=[placed_order.pk, email_changed.pk]
+    ).exists()
diff --git a/saleor/graphql/account/tests/mutations/test_account_register_birthday.py b/saleor/graphql/account/tests/mutations/test_account_register_birthday.py
