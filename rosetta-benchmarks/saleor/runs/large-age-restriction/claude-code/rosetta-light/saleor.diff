diff --git a/saleor/account/age_restriction.py b/saleor/account/age_restriction.py
new file mode 100644
index 0000000..739f873
--- /dev/null
+++ b/saleor/account/age_restriction.py
@@ -0,0 +1,158 @@
+"""Age restriction domain rules.
+
+Shared by checkout, payment, order and account code. Callers map `AgeRestrictionError`
+to their own GraphQL error codes. Birthdays, ages and minimum ages must never appear in
+messages, params or logs (NFR-7): `AgeRestrictionError` carries only the reason and the
+restricted variant ids.
+
+Time zone and minimum age are read from the `SiteSettings` instance passed in by the
+caller. Callers decide where that instance comes from (SC-5).
+"""
+
+from collections.abc import Iterable
+from datetime import date, datetime
+from enum import StrEnum
+from zoneinfo import ZoneInfo
+
+from django.core.exceptions import ValidationError
+from django.utils import timezone
+
+from ..order.models import Order
+from ..product.models import Product, ProductVariant
+from ..site.models import SiteSettings
+from .error_codes import AccountErrorCode
+from .models import User
+
+MAX_AGE_YEARS = 120
+
+_GENERIC_MESSAGE = "Age restriction is not satisfied."
+
+# Staff and app order surfaces collapse birthday-required and underage into this message.
+NOT_ELIGIBLE_MESSAGE = "The customer is not eligible to buy age-restricted products."
+
+
+class AgeRestrictionReason(StrEnum):
+    LOGIN_REQUIRED = "login_required"
+    BIRTHDAY_REQUIRED = "birthday_required"
+    UNDERAGE = "underage"
+
+
+class AgeRestrictionError(Exception):
+    """Restricted products cannot be bought by the given customer.
+
+    `str()` is generic on purpose. Read `reason` and `variant_ids` for details.
+    """
+
+    def __init__(self, reason: AgeRestrictionReason, variant_ids: list[int]):
+        super().__init__(_GENERIC_MESSAGE)
+        self.reason = reason
+        self.variant_ids = variant_ids
+
+    def __str__(self) -> str:
+        return _GENERIC_MESSAGE
+
+
+def get_shop_today(site_settings: SiteSettings, now: datetime | None = None) -> date:
+    """Return the current date in the shop's time zone.
+
+    `now` must be timezone-aware. A naive value would be read as system-local time.
+    """
+    current = now or timezone.now()
+    if timezone.is_naive(current):
+        raise ValueError("`now` must be timezone-aware.")
+    return current.astimezone(ZoneInfo(site_settings.time_zone)).date()
+
+
+def _same_day_in_year(value: date, year: int) -> date:
+    """Return `value` moved to `year`; Feb 29 becomes Mar 1 in a non-leap year."""
+    try:
+        return value.replace(year=year)
+    except ValueError:
+        return date(year, 3, 1)
+
+
+def get_eligibility_date(birthday: date, minimum_age: int) -> date:
+    """Return the first date on which a person born on `birthday` is `minimum_age`."""
+    return _same_day_in_year(birthday, birthday.year + minimum_age)
+
+
+def get_age_ineligibility_reason(
+    user: User | None,
+    site_settings: SiteSettings,
+    today: date | None = None,
+) -> AgeRestrictionReason | None:
+    """Return why the user is not eligible, or None when eligible.
+
+    Precedence: no user, then no birthday, then underage. A user is eligible on the
+    day they turn the minimum age.
+    """
+    if user is None:
+        return AgeRestrictionReason.LOGIN_REQUIRED
+    if user.birthday is None:
+        return AgeRestrictionReason.BIRTHDAY_REQUIRED
+    if today is None:
+        today = get_shop_today(site_settings)
+    eligibility_date = get_eligibility_date(
+        user.birthday, site_settings.age_restriction_minimum_age
+    )
+    if today < eligibility_date:
+        return AgeRestrictionReason.UNDERAGE
+    return None
+
+
+def is_user_age_eligible(
+    user: User | None,
+    site_settings: SiteSettings,
+    today: date | None = None,
+) -> bool:
+    return get_age_ineligibility_reason(user, site_settings, today) is None
+
+
+def validate_age_restriction(
+    user: User | None,
+    variants_with_products: Iterable[tuple[ProductVariant, Product]],
+    site_settings: SiteSettings,
+    *,
+    allow_anonymous: bool = False,
+) -> None:
+    """Raise `AgeRestrictionError` if the user may not buy the restricted lines.
+
+    No-op when no product is age restricted. `allow_anonymous` is for staff draft and
+    order flows only, where a draft without a linked customer is accepted.
+    """
+    restricted_variant_ids = [
+        variant.pk
+        for variant, product in variants_with_products
+        if product.is_age_restricted
+    ]
+    if not restricted_variant_ids:
+        return
+    if user is None and allow_anonymous:
+        return
+    reason = get_age_ineligibility_reason(user, site_settings)
+    if reason is not None:
+        raise AgeRestrictionError(reason, restricted_variant_ids)
+
+
+def resolve_order_customer(order: Order) -> User | None:
+    """Return the customer linked to an order, mirroring draft order completion.
+
+    Matches `DraftOrderComplete.update_user_fields`: the linked user, otherwise the
+    user whose email equals `order.user_email`, otherwise None.
+    """
+    if order.user:
+        return order.user
+    if order.user_email:
+        return User.objects.filter(email=order.user_email).first()
+    return None
+
+
+def validate_birthday(birthday: date, site_settings: SiteSettings) -> None:
+    """Reject birthdays in the future or more than `MAX_AGE_YEARS` years ago.
+
+    The message is generic and does not echo the value.
+    """
+    today = get_shop_today(site_settings)
+    earliest = _same_day_in_year(today, today.year - MAX_AGE_YEARS)
+    if birthday > today or birthday < earliest:
+        raise ValidationError("Invalid birthday.", code=AccountErrorCode.INVALID.value)
