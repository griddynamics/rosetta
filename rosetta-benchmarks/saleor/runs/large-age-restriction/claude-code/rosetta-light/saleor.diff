diff --git a/saleor/payment/gateways/stripe/tests/test_webhooks_age_restriction.py b/saleor/payment/gateways/stripe/tests/test_webhooks_age_restriction.py
new file mode 100644
index 0000000..99bb642
--- /dev/null
+++ b/saleor/payment/gateways/stripe/tests/test_webhooks_age_restriction.py
@@ -0,0 +1,207 @@
+"""Stripe legacy plugin webhook path and age restriction (S§5 #9).
+
+`handle_successful_payment_intent` calls `complete_checkout` without `site_settings`, so
+the age check uses the fallback read (SC-5). Covers:
+- TC-E-05 (Stripe webhook path): a restricted line for a guest with an adult's email or a
+  minor is blocked, no order is created, the captured payment is refunded (same as other
+  post-capture completion failures), and the failure is logged without values.
+- SC-5: a minimum age changed between two webhook deliveries in one process applies to
+  the second delivery.
+- TC-E-06: captured logs carry no birthday, age or minimum age.
+
+The payment gateway and the PSP objects are external; the age guard is real.
+"""
+
+import logging
+from datetime import date
+from unittest.mock import patch
+
+from freezegun import freeze_time
+from stripe.stripe_object import StripeObject
+
+from .....account.models import User
+from .....account.tests.fixtures.age_restriction import set_age_settings
+from .....checkout.models import Checkout
+from .....order.models import Order
+from .....payment.models import Transaction
+from .... import TransactionKind
+from ....utils import price_to_minor_unit
+from ..consts import SUCCESS_STATUS
+from ..webhooks import handle_successful_payment_intent
+
+SC5_NOW = "2026-10-23 23:00:00"
+SC5_BIRTHDAY = date(2008, 10, 24)
+ISO_DATES = ("2000-01-01", "2012-06-01")
+
+
+def _payment_intent(payment, stripe_payment_intent_id="ABC"):
+    payment_intent = StripeObject(id=stripe_payment_intent_id, last_response={})
+    payment_intent["amount_received"] = price_to_minor_unit(
+        payment.total, payment.currency
+    )
+    payment_intent["setup_future_usage"] = None
+    payment_intent["currency"] = payment.currency
+    payment_intent["status"] = SUCCESS_STATUS
+    payment_intent["payment_method"] = StripeObject()
+    return payment_intent
+
+
+def _prepare_payment_to_confirm(payment):
+    payment.to_confirm = True
+    payment.save(update_fields=["to_confirm"])
+    payment.transactions.create(
+        is_success=True,
+        action_required=True,
+        kind=TransactionKind.ACTION_TO_CONFIRM,
+        amount=payment.total,
+        currency=payment.currency,
+        token="ABC",
+        gateway_response={},
+    )
+    return payment
+
+
+def _set_checkout_user(checkout, user, email=None):
+    checkout.user = user
+    if email is not None:
+        checkout.email = email
+    checkout.save(update_fields=["user", "email"])
+    return checkout
+
+
+def _assert_logs_generic(caplog):
+    for record in caplog.records:
+        message = record.getMessage()
+        for iso_date in ISO_DATES:
+            assert iso_date not in message
+        error = str(getattr(record, "error", "") or "")
+        assert not any(char.isdigit() for char in error)
+
+
+@patch("saleor.payment.gateway.refund")
+def test_stripe_webhook_guest_with_adult_email_blocked_and_refunded(
+    refund_mock,
+    adult,
+    payment_stripe_for_checkout,
+    checkout_with_items,
+    restricted_product,
+    stripe_plugin,
+    channel_USD,
+    caplog,
+):
+    """Adult email on a guest checkout is blocked, creates no order and is refunded.
+
+    TC-E-05 / TC-H-03: the Stripe path does not attach by email. The captured payment is
+    refunded through the existing fail handler.
+    """
+    # given
+    checkout = _set_checkout_user(checkout_with_items, None, adult.email)
+    payment = _prepare_payment_to_confirm(payment_stripe_for_checkout)
+    plugin = stripe_plugin()
+    orders_before = Order.objects.count()
+    caplog.set_level(logging.INFO)
+
+    # when
+    handle_successful_payment_intent(
+        _payment_intent(payment), plugin.config, channel_USD.slug
+    )
+
+    # then
+    payment.refresh_from_db()
+    assert payment.order is None
+    assert Order.objects.count() == orders_before
+    assert Checkout.objects.filter(pk=checkout.pk).exists()
+    refund_mock.assert_called_once()
+    assert refund_mock.call_args.args[0].pk == payment.pk
+    assert refund_mock.call_args.kwargs["channel_slug"] == channel_USD.slug
+    failed = [r for r in caplog.records if r.getMessage().startswith("Failed")]
+    assert len(failed) == 1
+    assert "Sign in to buy age-restricted products." in failed[0].error
+    _assert_logs_generic(caplog)
+
+
+@patch("saleor.payment.gateway.refund")
+def test_stripe_webhook_minor_customer_blocked_and_refunded(
+    refund_mock,
+    minor,
+    payment_stripe_for_checkout,
+    checkout_with_items,
+    restricted_product,
+    stripe_plugin,
+    channel_USD,
+    caplog,
+):
+    """An underage stored customer is blocked on the Stripe path and is refunded.
+
+    TC-E-05: the captured payment is refunded through the existing fail handler.
+    """
+    # given
+    checkout = _set_checkout_user(checkout_with_items, minor)
+    payment = _prepare_payment_to_confirm(payment_stripe_for_checkout)
+    plugin = stripe_plugin()
+    caplog.set_level(logging.INFO)
+
+    # when
+    handle_successful_payment_intent(
+        _payment_intent(payment), plugin.config, channel_USD.slug
+    )
+
+    # then
+    payment.refresh_from_db()
+    assert payment.order is None
+    assert Checkout.objects.filter(pk=checkout.pk).exists()
+    refund_mock.assert_called_once()
+    assert refund_mock.call_args.args[0].pk == payment.pk
+    failed = [r for r in caplog.records if r.getMessage().startswith("Failed")]
+    assert "You do not meet the minimum age for these products." in failed[0].error
+    _assert_logs_generic(caplog)
+
+
+@freeze_time(SC5_NOW)
+@patch("saleor.payment.gateway.refund")
+def test_stripe_webhook_minimum_age_lowered_between_deliveries(
+    refund_mock,
+    payment_stripe_for_checkout,
+    checkout_with_items,
+    restricted_product,
+    stripe_plugin,
+    channel_USD,
+    site_settings,
+    caplog,
+):
+    """SC-5: the fallback read on the webhook path is fresh for the second delivery.
+
+    The customer is 17 today (birthday on the first day of this month, 17 years ago):
+    underage at minimum age 18, eligible at 17.
+    """
+    # given
+    user = User.objects.create(email="sc5-stripe@example.com", is_active=True)
+    user.birthday = SC5_BIRTHDAY
+    user.save(update_fields=["birthday"])
+    checkout = _set_checkout_user(checkout_with_items, user, user.email)
+    payment = _prepare_payment_to_confirm(payment_stripe_for_checkout)
+    plugin = stripe_plugin()
+    caplog.set_level(logging.INFO)
+    set_age_settings(site_settings, minimum_age=18, time_zone="UTC")
+
+    # when: first delivery at minimum age 18
+    handle_successful_payment_intent(
+        _payment_intent(payment), plugin.config, channel_USD.slug
+    )
+    payment.refresh_from_db()
+    assert payment.order is None
+    refund_mock.assert_called_once()
+
+    # when: the minimum age is lowered to 17 and the same payment is delivered again
+    set_age_settings(site_settings, minimum_age=17, time_zone="UTC")
+    handle_successful_payment_intent(
+        _payment_intent(payment), plugin.config, channel_USD.slug
+    )
+
+    # then
+    payment.refresh_from_db()
+    checkout_pk = checkout.pk
+    assert payment.order is not None
+    assert payment.order.checkout_token == str(checkout.token)
+    assert not Checkout.objects.filter(pk=checkout_pk).exists()
+    assert Transaction.objects.filter(payment=payment).exists()
