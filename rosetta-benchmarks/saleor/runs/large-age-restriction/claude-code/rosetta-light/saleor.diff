index 0000000..6c2ce00
--- /dev/null
+++ b/saleor/account/deletion.py
@@ -0,0 +1,62 @@
+"""Deletion hooks for account models.
+
+`CustomerEvent.user` uses `cascade_except_retained_customer_events` instead of plain
+`CASCADE`, so that birthday audit events outlive the customer they describe.
+
+Why an `on_delete` callable and not a `pre_delete` signal or per-mutation code:
+- Django calls `on_delete(collector, field, sub_objs, using)` from `Collector.collect`
+  for every ORM delete (`instance.delete()` and `QuerySet.delete()`), inside the same
+  transaction. One hook covers every delete path (RK-1).
+- A non-`CASCADE` callable disables the collector's fast-delete shortcut, so the hook
+  is always invoked for `CustomerEvent` rows of a deleted user.
+- It calls `CASCADE` and `Collector.add_field_update`, the same calls Django's built-in
+  `CASCADE` and `SET_NULL` make. Collector internals are not public API. `uv.lock` pins
+  Django 5.2.18, but `pyproject.toml` allows any 5.2.x, so every Django upgrade must
+  re-verify this hook (RK-1).
+- RK-4: a raw-SQL or `_raw_delete` delete of users bypasses this hook. The FK is
+  `DEFERRABLE INITIALLY DEFERRED` with no `ON DELETE`, so such a delete fails at COMMIT
+  instead of silently losing events. No such delete exists in the codebase.
+
+Constraints:
+- Migrations serialise `on_delete` by dotted path, so this must stay a module-level
+  function in an importable module.
+- Do not import models at module import time (circular with `account/models.py`).
+"""
+
+from django.db.models import ForeignKey, QuerySet
+from django.db.models.deletion import CASCADE, Collector
+
+from . import RETAINED_CUSTOMER_EVENT_TYPES
+
+
+def cascade_except_retained_customer_events(
+    collector: Collector,
+    field: ForeignKey,
+    sub_objs: QuerySet,
+    using: str,
+) -> None:
+    """Delete customer events on user delete, except retained birthday events.
+
+    Retained events get `user_id = NULL` and keep their `parameters`
+    (`customer_id`, `actor_user_id`), so the audit trail survives the deletion.
+    Both filters run in SQL on the lazy `sub_objs` queryset.
+    """
+    CASCADE(
+        collector,
+        field,
+        sub_objs.exclude(type__in=RETAINED_CUSTOMER_EVENT_TYPES),
+        using,
+    )
+    # The lazy queryset is intentional: Django turns it into one SQL UPDATE. The
+    # django-stubs signature expects an indexable collection, hence the ignore.
+    collector.add_field_update(
+        field,
+        None,
+        sub_objs.filter(type__in=RETAINED_CUSTOMER_EVENT_TYPES),  # type: ignore[arg-type]
+    )
+
+
+# Django skips the SELECT of `sub_objs` when this marker is set. Django sets it on its
+# own `SET`/`SET_NULL` only (`CASCADE` does not carry it), so the hook sets it itself.
+# The hook then costs one UPDATE and no extra SELECT (TC-R-05).
+cascade_except_retained_customer_events.lazy_sub_objs = True  # type: ignore[attr-defined]
