+import graphene
+
+from .....product.models import Product
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+PRODUCT_BULK_CREATE_AGE_RESTRICTED_MUTATION = """
+    mutation ProductBulkCreate($products: [ProductBulkCreateInput!]!) {
+        productBulkCreate(products: $products) {
+            count
+            results {
+                product {
+                    name
+                    isAgeRestricted
+                }
+                errors {
+                    path
+                    code
+                    message
+                }
+            }
+        }
+    }
+"""
+
+
+def _products_input(product_type):
+    product_type_id = graphene.Node.to_global_id("ProductType", product_type.pk)
+    return {
+        "products": [
+            {
+                "name": "Bulk restricted",
+                "productType": product_type_id,
+                "isAgeRestricted": True,
+            },
+            {"name": "Bulk omitted", "productType": product_type_id},
+            {
+                "name": "Bulk null",
+                "productType": product_type_id,
+                "isAgeRestricted": None,
+            },
+        ]
+    }
+
+
+def test_bulk_create_stores_is_age_restricted_per_row(
+    staff_api_client, product_type, permission_manage_products
+):
+    """TC-H-08 (productBulkCreate): true kept; omitted and null give false."""
+    # given
+    variables = _products_input(product_type)
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_BULK_CREATE_AGE_RESTRICTED_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productBulkCreate"]
+    assert data["count"] == 3
+    assert [result["errors"] for result in data["results"]] == [[], [], []]
+    assert [result["product"]["isAgeRestricted"] for result in data["results"]] == [
+        True,
+        False,
+        False,
+    ]
+    assert Product.objects.get(name="Bulk restricted").is_age_restricted is True
+    assert Product.objects.get(name="Bulk omitted").is_age_restricted is False
+    assert Product.objects.get(name="Bulk null").is_age_restricted is False
+
+
+def test_bulk_create_age_restricted_requires_manage_products(
+    staff_api_client, product_type
+):
+    """TC-H-08 negative: missing MANAGE_PRODUCTS denies the bulk write."""
+    # given
+    variables = _products_input(product_type)
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_BULK_CREATE_AGE_RESTRICTED_MUTATION, variables
+    )
+
+    # then
+    assert_no_permission(response)
+    assert not Product.objects.filter(name="Bulk restricted").exists()
