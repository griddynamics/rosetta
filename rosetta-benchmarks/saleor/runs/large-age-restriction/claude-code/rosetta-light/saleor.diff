diff --git a/saleor/account/tests/test_deletion_retention.py b/saleor/account/tests/test_deletion_retention.py
new file mode 100644
index 0000000..214112a
--- /dev/null
+++ b/saleor/account/tests/test_deletion_retention.py
@@ -0,0 +1,140 @@
+"""Model-level retention of birthday audit events on user deletion (S§9.1, TC-R-03).
+
+Real ORM deletes, no mocks: the hook is `CustomerEvent.user`'s `on_delete`, so these
+tests exercise the same collector path as every mutation.
+"""
+
+from .. import CustomerEvents
+from ..models import CustomerEvent, User
+
+
+def _create_customer_events(customer: User, actor: User) -> dict[str, CustomerEvent]:
+    """Create the event mix from TC-R-01 for `customer`, with `actor` as the staff actor."""
+    return {
+        "birthday_changed": CustomerEvent.objects.create(
+            user=customer,
+            type=CustomerEvents.BIRTHDAY_CHANGED,
+            parameters={"customer_id": customer.pk, "actor_user_id": actor.pk},
+        ),
+        "birthday_read": CustomerEvent.objects.create(
+            user=customer,
+            type=CustomerEvents.BIRTHDAY_READ,
+            parameters={"customer_id": customer.pk, "actor_user_id": actor.pk},
+        ),
+        "placed_order": CustomerEvent.objects.create(
+            user=customer, type=CustomerEvents.PLACED_ORDER, parameters={}
+        ),
+        "email_changed": CustomerEvent.objects.create(
+            user=customer, type=CustomerEvents.EMAIL_CHANGED, parameters={}
+        ),
+    }
+
+
+def _assert_birthday_events_retained_and_others_deleted(
+    events: dict[str, CustomerEvent],
+) -> None:
+    for key in ("birthday_changed", "birthday_read"):
+        retained = CustomerEvent.objects.get(pk=events[key].pk)
+        assert retained.user_id is None
+        assert retained.type == events[key].type
+        assert retained.parameters == events[key].parameters
+    for key in ("placed_order", "email_changed"):
+        assert not CustomerEvent.objects.filter(pk=events[key].pk).exists()
+
+
+def test_queryset_delete_keeps_birthday_events_and_deletes_other_events(
+    adult, staff_user
+):
+    """TC-R-03: QuerySet.delete keeps birthday events, deletes others."""
+    # given
+    events = _create_customer_events(adult, staff_user)
+    customer_id = adult.pk
+
+    # when
+    User.objects.filter(pk=customer_id).delete()
+
+    # then
+    assert not User.objects.filter(pk=customer_id).exists()
+    _assert_birthday_events_retained_and_others_deleted(events)
+
+
+def test_instance_delete_keeps_birthday_events_and_deletes_other_events(
+    adult, staff_user
+):
+    """TC-R-03: instance.delete keeps birthday events, deletes others."""
+    # given
+    events = _create_customer_events(adult, staff_user)
+    customer_id = adult.pk
+
+    # when
+    adult.delete()
+
+    # then
+    assert not User.objects.filter(pk=customer_id).exists()
+    _assert_birthday_events_retained_and_others_deleted(events)
+
+
+def test_queryset_delete_of_several_users_is_applied_per_user(adult, minor, staff_user):
+    """TC-R-03: batch delete per user; bystander events untouched."""
+    # given
+    adult_events = _create_customer_events(adult, staff_user)
+    minor_events = _create_customer_events(minor, staff_user)
+    bystander = User.objects.create(email="bystander@example.com")
+    bystander_event = CustomerEvent.objects.create(
+        user=bystander, type=CustomerEvents.PLACED_ORDER, parameters={}
+    )
+
+    # when
+    User.objects.filter(pk__in=[adult.pk, minor.pk]).delete()
+
+    # then
+    _assert_birthday_events_retained_and_others_deleted(adult_events)
+    _assert_birthday_events_retained_and_others_deleted(minor_events)
+    # A user who is not deleted keeps every event, including non-birthday ones.
+    assert CustomerEvent.objects.filter(pk=bystander_event.pk, user=bystander).exists()
+
+
+def test_staff_actor_delete_does_not_touch_customer_birthday_events(adult, staff_user):
+    """S§9.1 non-regression guard: deleting the actor leaves the customer's events.
+
+    The events belong to the customer (`user=adult`), so plain CASCADE also passes
+    this test. The staff-as-subject case, which needs the retention hook, is covered
+    at GraphQL level in `graphql/account/tests/mutations/test_staff_delete_retention.py`.
+    """
+    # given: staff_user is only the actor of the customer's birthday events
+    customer_events = _create_customer_events(adult, staff_user)
+    staff_note = CustomerEvent.objects.create(
+        user=staff_user,
+        type=CustomerEvents.NOTE_ADDED,
+        parameters={"customer_id": adult.pk},
+    )
+
+    # when
+    staff_user.delete()
+
+    # then: the customer's birthday events stay linked to the customer, and the
+    # staff member's own non-birthday event is deleted as before
+    assert CustomerEvent.objects.filter(
+        pk=customer_events["birthday_changed"].pk, user=adult
+    ).exists()
+    assert CustomerEvent.objects.filter(
+        pk=customer_events["birthday_read"].pk, user=adult
+    ).exists()
+    assert not CustomerEvent.objects.filter(pk=staff_note.pk).exists()
+
+
+def test_empty_queryset_delete_leaves_events_untouched(adult, staff_user):
+    """Edge: empty queryset delete is a no-op."""
+    # given
+    _create_customer_events(adult, staff_user)
+    events_before = CustomerEvent.objects.count()
+
+    # when
+    none_deleted = User.objects.none().delete()
+    missing_deleted = User.objects.filter(email="missing@example.com").delete()
+
+    # then
+    assert none_deleted[0] == 0
+    assert missing_deleted[0] == 0
+    assert CustomerEvent.objects.count() == events_before
+    assert CustomerEvent.objects.filter(user__isnull=True).count() == 0
diff --git a/saleor/account/tests/test_migration_0106.py b/saleor/account/tests/test_migration_0106.py
new file mode 100644
index 0000000..4d6ef27
--- /dev/null
+++ b/saleor/account/tests/test_migration_0106.py
@@ -0,0 +1,39 @@
+"""Regression guard for the retention hook and migration 0106 (TC-R-04, RK-1, R-3).
+
+If Django changes how `on_delete` is wired, or the migration starts emitting FK DDL,
+these tests fail. Re-verify the hook on every Django upgrade (see deletion.py).
+"""
+
+from io import StringIO
+
+import pytest
+from django.core.management import call_command
+
+from ..deletion import cascade_except_retained_customer_events
+from ..models import CustomerEvent
+
+
+def test_customer_event_user_fk_uses_retention_hook():
+    """TC-R-04: CustomerEvent.user uses the retention hook."""
+    # given / when
+    field = CustomerEvent._meta.get_field("user")
+
+    # then
+    assert field.remote_field.on_delete is cascade_except_retained_customer_events
+
+
+@pytest.mark.django_db
+def test_sqlmigrate_0106_adds_birthday_column_without_fk_ddl():
+    """TC-R-04: migration 0106 adds birthday, emits no FK DDL."""
+    # given
+    output = StringIO()
+
+    # when
+    call_command("sqlmigrate", "account", "0106", stdout=output)
+    sql = output.getvalue()
+
+    # then: the birthday column is added, and the FK on_delete change is state-only
+    assert 'ADD COLUMN "birthday"' in sql
+    assert "account_customerevent" not in sql
+    assert "FOREIGN KEY" not in sql.upper()
+    assert "REFERENCES" not in sql.upper()
