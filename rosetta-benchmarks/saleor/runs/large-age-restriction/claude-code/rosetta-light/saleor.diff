+++ b/saleor/graphql/shop/tests/mutations/test_shop_settings_update_age_restriction.py
@@ -0,0 +1,161 @@
+from datetime import date
+
+import pytest
+from django.contrib.sites.models import Site
+from freezegun import freeze_time
+
+from .....account.age_restriction import (
+    AgeRestrictionReason,
+    get_age_ineligibility_reason,
+)
+from .....account.tests.fixtures.user import dangerously_create_test_user
+from .....site.models import SiteSettings
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+SHOP_SETTINGS_AGE_RESTRICTION_MUTATION = """
+    mutation ShopSettingsUpdate($input: ShopSettingsInput!) {
+        shopSettingsUpdate(input: $input) {
+            shop {
+                ageRestrictionMinimumAge
+                timeZone
+            }
+            errors {
+                field
+                code
+                message
+            }
+        }
+    }
+"""
+
+
+def _update_settings(client, input_data, **kwargs):
+    response = client.post_graphql(
+        SHOP_SETTINGS_AGE_RESTRICTION_MUTATION, {"input": input_data}, **kwargs
+    )
+    return get_graphql_content(response)["data"]["shopSettingsUpdate"]
+
+
+@pytest.mark.parametrize("minimum_age", [1, 120])
+def test_shop_settings_update_accepts_minimum_age_bounds(
+    minimum_age, staff_api_client, site_settings, permission_manage_settings
+):
+    """TC-B-10: minimum age 1 and 120 are accepted and stored."""
+    # when
+    data = _update_settings(
+        staff_api_client,
+        {"ageRestrictionMinimumAge": minimum_age},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    assert data["errors"] == []
+    assert data["shop"]["ageRestrictionMinimumAge"] == minimum_age
+    site_settings.refresh_from_db()
+    assert site_settings.age_restriction_minimum_age == minimum_age
+
+
+@pytest.mark.parametrize(
+    ("input_data", "field"),
+    [
+        ({"ageRestrictionMinimumAge": 0}, "ageRestrictionMinimumAge"),
+        ({"ageRestrictionMinimumAge": 121}, "ageRestrictionMinimumAge"),
+        ({"timeZone": "Mars/Base"}, "timeZone"),
+    ],
+)
+def test_shop_settings_update_rejects_invalid_age_settings(
+    input_data, field, staff_api_client, site_settings, permission_manage_settings
+):
+    """TC-E-09: out-of-range minimum age or unknown time zone is ShopError INVALID."""
+    # given
+    stored_age = site_settings.age_restriction_minimum_age
+    stored_zone = site_settings.time_zone
+
+    # when
+    data = _update_settings(
+        staff_api_client, input_data, permissions=[permission_manage_settings]
+    )
+
+    # then
+    assert data["errors"][0]["field"] == field
+    assert data["errors"][0]["code"] == "INVALID"
+    site_settings.refresh_from_db()
+    assert site_settings.age_restriction_minimum_age == stored_age
+    assert site_settings.time_zone == stored_zone
+
+
+@freeze_time("2026-10-23 12:00:00")
+def test_shop_settings_update_is_used_by_next_eligibility_check(
+    staff_api_client, site_settings, permission_manage_settings
+):
+    """TC-H-07: after shopSettingsUpdate, the next domain check uses the new values.
+
+    The customer was born 2008-10-23. At minimum age 18 they are eligible today.
+    After the change to 21, the same customer is UNDERAGE.
+    """
+    # given
+    customer = dangerously_create_test_user(
+        "shop-next-check@example.com", "password", birthday=date(2008, 10, 23)
+    )
+    site_settings.refresh_from_db()
+    assert get_age_ineligibility_reason(customer, site_settings) is None
+
+    # when
+    data = _update_settings(
+        staff_api_client,
+        {"ageRestrictionMinimumAge": 21, "timeZone": "Europe/Warsaw"},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    assert data["errors"] == []
+    assert data["shop"]["ageRestrictionMinimumAge"] == 21
+    assert data["shop"]["timeZone"] == "Europe/Warsaw"
+    fresh_settings = SiteSettings.objects.get(pk=site_settings.pk)
+    assert fresh_settings.age_restriction_minimum_age == 21
+    assert fresh_settings.time_zone == "Europe/Warsaw"
+    assert (
+        get_age_ineligibility_reason(customer, fresh_settings)
+        is AgeRestrictionReason.UNDERAGE
+    )
+
+
+def test_shop_settings_update_age_settings_require_manage_settings(
+    staff_api_client, site_settings
+):
+    """TC-H-07 negative: missing MANAGE_SETTINGS denies the age settings write."""
+    # when
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_AGE_RESTRICTION_MUTATION,
+        {"input": {"ageRestrictionMinimumAge": 21}},
+    )
+
+    # then
+    assert_no_permission(response)
+    site_settings.refresh_from_db()
+    assert site_settings.age_restriction_minimum_age == 18
+
+
+def test_shop_settings_update_refreshes_process_site_cache(
+    staff_api_client, site_settings, permission_manage_settings
+):
+    """m-14: after an update, the process-wide Site cache serves the new settings.
+
+    The cache is primed first. Without `Site.objects.clear_cache()` after the save,
+    `get_current().settings` keeps the old minimum age for the process lifetime.
+    """
+    # given
+    Site.objects.clear_cache()
+    cached_site = Site.objects.get_current()
+    assert cached_site.settings.age_restriction_minimum_age != 21
+
+    # when
+    data = _update_settings(
+        staff_api_client,
+        {"ageRestrictionMinimumAge": 21},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    assert data["errors"] == []
+    assert Site.objects.get_current().settings.age_restriction_minimum_age == 21
