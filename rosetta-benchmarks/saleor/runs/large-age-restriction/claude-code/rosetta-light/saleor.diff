+def test_birthday_text_matcher_detects_a_leaked_value(caplog):
+    """Canary: proves the log scan above would fail if a birthday reached a log."""
+    caplog.set_level(logging.INFO)
+    logging.getLogger("saleor.graphql.tests.canary").info(
+        "leaked %s", NEW_BIRTHDAY.isoformat()
+    )
+    texts = [
+        record.getMessage()
+        + repr({k: v for k, v in vars(record).items() if k != "args"})
+        for record in caplog.records
+    ]
+    leaking = [text for text in texts if NEW_BIRTHDAY.isoformat() in text]
+    assert leaking
+    with pytest.raises(AssertionError):
+        _assert_no_birthday_text(leaking[0], NEW_BIRTHDAY)
