+"""checkoutComplete age restriction authority at GraphQL level (S§5 #5, #6).
+
+Covers TC-H-01, TC-H-02 (unrestricted guest unchanged), TC-H-03 (guest with an adult's
+email: no attach-based pass, S-2), TC-E-05 (checkoutComplete transaction and legacy
+flows), TC-E-06 (no PII in errors), TC-E-11 (logged-in adult on a checkout without a
+stored user), TC-B-08 (drift between add and pay) and SC-5 (a minimum age change is
+applied to the next completion in the same process).
+
+The restricted line is injected by fixture or by flipping the product flag after the
+line was added, which bypasses the line-time guard (T-2). Completion must still block.
+"""
+
+import re
+from datetime import UTC, date, datetime
+from unittest import mock
+
+import graphene
+import pytest
+from django.utils import timezone
+from freezegun import freeze_time
+
+from .....account.models import User
+from .....account.tests.fixtures.age_restriction import (
+    ADULT_BIRTHDAY,
+    MINOR_BIRTHDAY,
+    set_age_settings,
+)
+from .....checkout import calculations
+from .....checkout.fetch import fetch_checkout_info, fetch_checkout_lines
+from .....checkout.models import Checkout
+from .....order.models import Order
+from .....payment.interface import TransactionSessionResult
+from .....payment.transaction_item_calculations import recalculate_transaction_amounts
+from .....plugins.manager import get_plugins_manager
+from ....tests.fixtures import ApiClient
+from ....tests.utils import get_graphql_content
+
+MUTATION_CHECKOUT_COMPLETE = """
+mutation checkoutComplete($id: ID) {
+  checkoutComplete(id: $id) {
+    order { id status }
+    errors { field code message variants }
+  }
+}
+"""
+
+MUTATION_LINES_ADD = """
+mutation checkoutLinesAdd($id: ID, $lines: [CheckoutLineInput!]!) {
+  checkoutLinesAdd(id: $id, lines: $lines) {
+    errors { field code message variants }
+  }
+}
+"""
+
+MUTATION_TRANSACTION_INITIALIZE = """
+mutation TransactionInitialize(
+  $id: ID!, $amount: PositiveDecimal, $paymentGateway: PaymentGatewayToInitialize!
+) {
+  transactionInitialize(id: $id, amount: $amount, paymentGateway: $paymentGateway) {
+    transaction { id chargedAmount { amount } }
+    errors { field code message }
+  }
+}
+"""
+
+BIRTHDAY_ISO_DATES = ("2000-01-01", "2012-06-01", "2008-10-24", "2008-10-23")
+
+
+def _sc5_birthday(today: date) -> date:
+    """Birthday that makes the customer 17 on `today`.
+
+    The 17th birthday fell on the first day of the current month, so the date is
+    always valid and the customer is underage at minimum age 18, eligible at 17.
+    """
+    return date(today.year - 17, today.month, 1)
+
+
+def _gid(type_name, pk):
+    return graphene.Node.to_global_id(type_name, pk)
+
+
+def _checkout_total(checkout):
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+    return calculations.calculate_checkout_total_with_gift_cards(
+        manager, checkout_info, lines
+    )
+
+
+def _fund_checkout(checkout, transaction_item_generator):
+    """Cover the checkout total with a charged transaction (transaction flow)."""
+    total = _checkout_total(checkout)
+    transaction = transaction_item_generator(
+        checkout_id=checkout.pk, charged_value=total.gross.amount
+    )
+    recalculate_transaction_amounts(transaction)
+    checkout.price_expiration = timezone.now()
+    checkout.save(update_fields=["price_expiration"])
+    return transaction
+
+
+def _set_checkout_user(checkout, user, email=None):
+    checkout.user = user
+    if email is not None:
+        checkout.email = email
+    checkout.save(update_fields=["user", "email"])
+    return checkout
+
+
+def _set_birthday(user, birthday):
+    user.birthday = birthday
+    user.save(update_fields=["birthday"])
+    return user
+
+
+def _complete(user_or_none, checkout):
+    client = ApiClient(user=user_or_none)
+    response = client.post_graphql(
+        MUTATION_CHECKOUT_COMPLETE, {"id": _gid("Checkout", checkout.token)}
+    )
+    return get_graphql_content(response)["data"]["checkoutComplete"]
+
+
+def _assert_no_age_data(payload):
+    """TC-E-06: generic messages (no digits) and no birthday values in the payload."""
+    serialized = repr(payload)
+    for iso_date in BIRTHDAY_ISO_DATES:
+        assert iso_date not in serialized
+    for error in payload.get("errors") or []:
+        assert not re.search(r"\d", error["message"] or "")
+
