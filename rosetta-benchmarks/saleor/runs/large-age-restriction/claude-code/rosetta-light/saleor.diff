+    variant = product_with_single_variant.variants.first()
+    variables = {
+        "id": to_global_id_or_none(checkout),
+        "lines": [{"quantity": 1, "variantId": to_global_id_or_none(variant)}],
+    }
+
+    # when
+    with CaptureQueriesContext(connection) as context:
+        response = get_graphql_content(
+            client.post_graphql(MUTATION_CHECKOUT_LINES_ADD, variables)
+        )
+
+    # then
+    assert not response["data"]["checkoutLinesAdd"]["errors"]
+    assert len(context.captured_queries) == CUSTOMER_LINES_ADD_UNRESTRICTED_QUERY_COUNT
