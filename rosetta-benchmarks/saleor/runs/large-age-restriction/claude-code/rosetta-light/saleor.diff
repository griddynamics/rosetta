+"""Line-time age restriction guards on checkout mutations (S§5 #1-#4).
+
+Covers TC-E-01..04, TC-B-11, TC-E-06 (no PII in errors), the eligibility boundaries of
+TC-B-03 / TC-B-05 at the API level, and SC-5 (a minimum age change is seen by the next
+request). Line-time guards are UX checks; completion is the authority and is tested in
+`test_checkout_complete_age_restriction.py`.
+"""
+
+import re
+from datetime import date
+
+import graphene
+import pytest
+from freezegun import freeze_time
+
+from .....account.tests.fixtures.age_restriction import (
+    ADULT_BIRTHDAY,
+    MINOR_BIRTHDAY,
+    set_age_settings,
+)
+from .....checkout.fetch import fetch_checkout_info
+from .....checkout.models import Checkout
+from .....checkout.tests.utils import add_variant_to_checkout
+from .....order.models import Order
+from .....plugins.manager import get_plugins_manager
+from ....tests.fixtures import ApiClient
+from ....tests.utils import get_graphql_content
+from ...mutations.checkout_lines_update import CheckoutLinesUpdate
+
+MUTATION_LINES_ADD = """
+mutation checkoutLinesAdd($id: ID, $lines: [CheckoutLineInput!]!) {
+  checkoutLinesAdd(id: $id, lines: $lines) {
+    errors { field code message variants }
+  }
+}
+"""
+
+MUTATION_LINES_UPDATE = """
+mutation checkoutLinesUpdate($id: ID, $lines: [CheckoutLineUpdateInput!]!) {
+  checkoutLinesUpdate(id: $id, lines: $lines) {
+    errors { field code message variants }
+  }
+}
+"""
+
+MUTATION_CHECKOUT_CREATE = """
+mutation checkoutCreate($input: CheckoutCreateInput!) {
+  checkoutCreate(input: $input) {
+    errors { field code message variants }
+    checkout { id }
+  }
+}
+"""
+
+MUTATION_CREATE_FROM_ORDER = """
+mutation checkoutCreateFromOrder($id: ID!) {
+  checkoutCreateFromOrder(id: $id) {
+    errors { field code message }
+    checkout { id lines { variant { id } } }
+    unavailableVariants { code variantId message }
+  }
+}
+"""
+
+BIRTHDAY_ISO_DATES = (ADULT_BIRTHDAY.isoformat(), MINOR_BIRTHDAY.isoformat())
+
+
+def _gid(type_name, pk):
+    return graphene.Node.to_global_id(type_name, pk)
+
+
+def _line(variant, quantity=1):
+    return {"variantId": _gid("ProductVariant", variant.pk), "quantity": quantity}
+
+
+def _assert_no_age_data(payload):
+    """TC-E-06: generic messages (no digits) and no birthday values in the payload."""
+    serialized = repr(payload)
+    for iso_date in BIRTHDAY_ISO_DATES:
+        assert iso_date not in serialized
+    for error in payload:
+        assert not re.search(r"\d", error["message"] or "")
+
+
+def _set_user(checkout, user):
+    checkout.user = user
+    checkout.save(update_fields=["user"])
+    return checkout
+
+
+def _with_birthday(user, birthday):
+    user.birthday = birthday
+    user.save(update_fields=["birthday"])
+    return user
+
+
+@pytest.fixture
+def restricted_variant(restricted_product):
+    return restricted_product.variants.first()
+
+
+@pytest.fixture
+def checkout_with_restricted_line(checkout, restricted_variant):
+    """Restricted line added directly, bypassing the line-time guard."""
+    manager = get_plugins_manager(allow_replica=False)
+    checkout_info = fetch_checkout_info(checkout, [], manager)
+    add_variant_to_checkout(checkout_info, restricted_variant, 1)
+    checkout.save()
+    return checkout
+
