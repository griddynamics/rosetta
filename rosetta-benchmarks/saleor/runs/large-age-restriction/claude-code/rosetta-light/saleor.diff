@@ -0,0 +1,227 @@
+from datetime import date
+
+import pytest
+from freezegun import freeze_time
+
+from .....account import CustomerEvents
+from .....account.error_codes import AccountErrorCode
+from .....account.models import CustomerEvent
+from .....account.tests.fixtures.age_restriction import set_age_settings
+from ....tests.utils import get_graphql_content
+
+ACCOUNT_UPDATE_BIRTHDAY_MUTATION = """
+    mutation AccountUpdate($input: AccountInput!) {
+        accountUpdate(input: $input) {
+            user {
+                id
+                birthday
+            }
+            errors {
+                field
+                code
+                message
+            }
+        }
+    }
+"""
+
+ME_BIRTHDAY_QUERY = """
+    query {
+        me {
+            birthday
+        }
+    }
+"""
+
+
+def _birthday_events(user, event_type=CustomerEvents.BIRTHDAY_CHANGED):
+    return list(CustomerEvent.objects.filter(user=user, type=event_type))
+
+
+def _update_birthday(api_client, birthday, **extra_input):
+    variables = {"input": {"birthday": birthday, **extra_input}}
+    response = api_client.post_graphql(ACCOUNT_UPDATE_BIRTHDAY_MUTATION, variables)
+    return get_graphql_content(response)["data"]["accountUpdate"]
+
+
+def test_account_update_sets_birthday_and_logs_one_self_change(
+    user_api_client, customer_user
+):
+    """TC-H-05 (accountUpdate): birthday stored, read back by owner, one change event."""
+    # given
+    assert customer_user.birthday is None
+
+    # when
+    data = _update_birthday(user_api_client, "2000-05-17")
+
+    # then
+    assert data["errors"] == []
+    customer_user.refresh_from_db()
+    assert customer_user.birthday == date(2000, 5, 17)
+
+    # when
+    me_content = get_graphql_content(user_api_client.post_graphql(ME_BIRTHDAY_QUERY))
+
+    # then
+    assert me_content["data"]["me"]["birthday"] == "2000-05-17"
+    [event] = _birthday_events(customer_user)
+    assert event.parameters == {
+        "customer_id": customer_user.pk,
+        "actor_user_id": customer_user.pk,
+    }
+    # owner reads are not audited (S§9 A5)
+    assert _birthday_events(customer_user, CustomerEvents.BIRTHDAY_READ) == []
+
+
+def test_account_update_unchanged_birthday_logs_no_event(
+    user_api_client, customer_user
+):
+    """TC-H-05 negative: same birthday with another field changed logs no event."""
+    # given
+    customer_user.birthday = date(2000, 5, 17)
+    customer_user.save(update_fields=["birthday"])
+
+    # when
+    data = _update_birthday(user_api_client, "2000-05-17", firstName="Jane")
+
+    # then
+    assert data["errors"] == []
+    customer_user.refresh_from_db()
+    assert customer_user.first_name == "Jane"
+    assert customer_user.birthday == date(2000, 5, 17)
+    assert _birthday_events(customer_user) == []
+
+
+def test_account_update_null_clears_birthday_and_logs_change(
+    user_api_client, customer_user
+):
+    """TC-H-05 (clear): null clears the stored value and is one change event."""
+    # given
+    customer_user.birthday = date(2000, 5, 17)
+    customer_user.save(update_fields=["birthday"])
+
+    # when
+    data = _update_birthday(user_api_client, None)
+
+    # then
+    assert data["errors"] == []
+    customer_user.refresh_from_db()
+    assert customer_user.birthday is None
+    [event] = _birthday_events(customer_user)
+    assert event.parameters == {
+        "customer_id": customer_user.pk,
+        "actor_user_id": customer_user.pk,
+    }
+
+
+def test_account_update_null_on_unset_birthday_logs_no_event(
+    user_api_client, customer_user
+):
+    """TC-H-05 negative: clearing an already empty birthday is not a change."""
+    # given
+    assert customer_user.birthday is None
+
+    # when
+    data = _update_birthday(user_api_client, None)
+
+    # then
+    assert data["errors"] == []
+    customer_user.refresh_from_db()
+    assert customer_user.birthday is None
+    assert _birthday_events(customer_user) == []
+
+
+@freeze_time("2026-10-23 12:00:00")
+@pytest.mark.parametrize(
+    ("birthday", "is_accepted"),
+    [
+        ("2026-10-23", True),  # born today: shop-today boundary, accepted
+        ("2026-10-24", False),  # tomorrow in shop time: future, rejected
+        ("1906-10-23", True),  # exactly 120 years ago: accepted
+        ("1906-10-22", False),  # 120 years and one day ago: rejected
+    ],
+)
+def test_account_update_birthday_shop_today_and_120_year_boundaries(
+    birthday, is_accepted, user_api_client, customer_user
+):
+    """TC-E-10 / TC-B-09 (API): future and over-120-year birthdays are rejected."""
+    # when
+    data = _update_birthday(user_api_client, birthday)
+
+    # then
+    customer_user.refresh_from_db()
+    if is_accepted:
+        assert data["errors"] == []
+        assert customer_user.birthday == date.fromisoformat(birthday)
+        assert len(_birthday_events(customer_user)) == 1
+    else:
+        assert len(data["errors"]) == 1
+        error = data["errors"][0]
+        assert error["field"] == "birthday"
+        assert error["code"] == AccountErrorCode.INVALID.name
+        assert error["message"] == "Invalid birthday."
+        assert birthday not in error["message"]
+        assert customer_user.birthday is None
+        assert _birthday_events(customer_user) == []
+
+
+@freeze_time("2026-10-23 12:00:00")
+@pytest.mark.parametrize(
+    ("time_zone", "accepted", "rejected"),
+    [
+        # 12:00 UTC is already 2026-10-24 in Kiritimati (UTC+14)
+        ("Pacific/Kiritimati", "2026-10-24", "2026-10-25"),
+        # 12:00 UTC is still 2026-10-23 in Pago Pago (UTC-11)
+        ("Pacific/Pago_Pago", "2026-10-23", "2026-10-24"),
+    ],
+)
+def test_account_update_birthday_today_is_shop_local_date(
+    time_zone, accepted, rejected, user_api_client, customer_user, site_settings
+):
+    """TC-E-10 / TC-B-07 (API): "today" is the shop's local date, not UTC."""
+    # given
+    set_age_settings(site_settings, time_zone=time_zone)
+
+    # when
+    rejected_data = _update_birthday(user_api_client, rejected)
+
+    # then
+    assert rejected_data["errors"][0]["field"] == "birthday"
+    customer_user.refresh_from_db()
+    assert customer_user.birthday is None
+
+    # when
+    accepted_data = _update_birthday(user_api_client, accepted)
+
+    # then
+    assert accepted_data["errors"] == []
+    customer_user.refresh_from_db()
+    assert customer_user.birthday == date.fromisoformat(accepted)
+    assert len(_birthday_events(customer_user)) == 1
+
+
+@pytest.mark.parametrize("malformed", ["2000-02-30", 2000, ""])
+def test_account_update_malformed_birthday_is_rejected_and_keeps_value(
+    malformed, user_api_client, customer_user
+):
+    """Wrong type (negative): a malformed date is a GraphQL input error.
+
+    The stored birthday must survive. Checked: the Date scalar rejects these values
+    before the mutation runs, so none of them can be read as a clear.
+    """
+    # given
+    customer_user.birthday = date(2000, 5, 17)
+    customer_user.save(update_fields=["birthday"])
+
+    # when
+    response = user_api_client.post_graphql(
+        ACCOUNT_UPDATE_BIRTHDAY_MUTATION, {"input": {"birthday": malformed}}
+    )
+
+    # then
+    content = response.json()
+    assert content.get("data") is None
+    assert 'Expected type "Date"' in content["errors"][0]["message"]
+    customer_user.refresh_from_db()
+    assert customer_user.birthday == date(2000, 5, 17)
+    assert _birthday_events(customer_user) == []
diff --git a/saleor/graphql/account/tests/mutations/test_birthday_write_permissions.py b/saleor/graphql/account/tests/mutations/test_birthday_write_permissions.py
new file mode 100644
index 0000000..7da76dd
--- /dev/null
+++ b/saleor/graphql/account/tests/mutations/test_birthday_write_permissions.py
@@ -0,0 +1,273 @@
+"""Birthday write gate: who may set `birthday` (S§7 write column, S§11 T-1, S-3).
+
+Covers S§13 TC-SEC-05 and the app side of TC-SEC-06. Every denial asserts three things:
+the error is PermissionDenied, the stored value is unchanged, and no BIRTHDAY_CHANGED
+event exists. Each denial has a control in the same module showing that the same write
+succeeds for the requestor the spec allows, so the denial is the gate and not a broken
+mutation.
+"""
+
+from datetime import date
+
+import graphene
+import pytest
+
+from .....account import CustomerEvents
+from .....account.models import CustomerEvent, User
+from .....account.tests.fixtures.age_restriction import ADULT_BIRTHDAY
+from ....tests.fixtures import ApiClient
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+NEW_BIRTHDAY = date(1971, 8, 23)
+
+CUSTOMER_CREATE_MUTATION = """
+mutation ($input: UserCreateInput!) {
+  customerCreate(input: $input) {
+    user { id birthday }
+    errors { field code }
+  }
+}
+"""
+
+CUSTOMER_UPDATE_MUTATION = """
+mutation ($id: ID!, $input: CustomerInput!) {
+  customerUpdate(id: $id, input: $input) {
+    user { id birthday }
+    errors { field code }
+  }
+}
+"""
+
+CUSTOMER_BULK_UPDATE_MUTATION = """
+mutation ($customers: [CustomerBulkUpdateInput!]!) {
+  customerBulkUpdate(customers: $customers) {
+    count
+    results { customer { id birthday } errors { path code } }
+    errors { path code }
+  }
+}
+"""
+
+ACCOUNT_UPDATE_MUTATION = """
+mutation ($input: AccountInput!, $customerId: ID) {
+  accountUpdate(input: $input, customerId: $customerId) {
+    user { id birthday }
+    errors { field code }
+  }
+}
+"""
+
+
+def _gid(user) -> str:
+    return graphene.Node.to_global_id("User", user.pk)
+
+
+def _birthday_change_events(user):
+    return CustomerEvent.objects.filter(
+        type=CustomerEvents.BIRTHDAY_CHANGED, user_id=user.pk
+    )
+
+
+def _assert_denied_and_unchanged(response, user, before):
+    assert_no_permission(response)
+    user.refresh_from_db()
+    assert user.birthday == before
+    assert not _birthday_change_events(user).exists()
+
+
+@pytest.mark.parametrize(
+    "extra_perms_fixtures",
+    [
+        ["permission_manage_users"],
+        ["permission_manage_users", "permission_manage_staff"],
+        ["permission_manage_users", "permission_manage_orders"],
+    ],
+)
+def test_tc_sec_05_non_superuser_staff_customer_create_birthday_denied(
+    request, staff_api_client, extra_perms_fixtures
+):
+    # given
+    perms = [request.getfixturevalue(name) for name in extra_perms_fixtures]
+    email = "staff-create-birthday@example.com"
+
+    # when
+    response = staff_api_client.post_graphql(
+        CUSTOMER_CREATE_MUTATION,
+        {
+            "input": {
+                "email": email,
+                "birthday": NEW_BIRTHDAY.isoformat(),
+            }
+        },
+        permissions=perms,
+        check_no_permissions=False,
+    )
+
+    # then
+    assert_no_permission(response)
+    assert not User.objects.filter(email=email).exists()
+
+
+def test_tc_sec_05_non_superuser_staff_customer_update_birthday_denied(
+    staff_api_client, customer_user, permission_manage_users
+):
+    # when
+    response = staff_api_client.post_graphql(
+        CUSTOMER_UPDATE_MUTATION,
