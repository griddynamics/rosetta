+def test_tc_sec_08_no_filter_where_or_sort_input_mentions_birthday():
+    types = [t for t in _introspection_types() if not t["name"].startswith("__")]
+    query_side_inputs = [
+        t
+        for t in types
+        if t["kind"] == "INPUT_OBJECT"
+        and any(marker in t["name"] for marker in ("Filter", "Where", "Sort", "Order"))
+    ]
+    assert query_side_inputs, "expected query-side input types to be present"
+
+    for input_type in query_side_inputs:
+        field_names = {f["name"] for f in input_type.get("inputFields") or []}
+        assert "birthday" not in field_names, input_type["name"]
