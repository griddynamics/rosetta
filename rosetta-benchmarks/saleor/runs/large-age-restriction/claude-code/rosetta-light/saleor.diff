+
+    # when
+    response = staff_api_client.post_graphql(
+        CUSTOMER_UPDATE_MUTATION,
+        {"id": _gid(customer_user), "input": {"birthday": NEW_BIRTHDAY.isoformat()}},
+        check_no_permissions=False,
+    )
