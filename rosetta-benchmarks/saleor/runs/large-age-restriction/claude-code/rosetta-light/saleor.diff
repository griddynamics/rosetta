+class BirthdayReadAuditLoader(DataLoader[int, None]):
+    """Log one BIRTHDAY_READ event per customer per request (S§9).
+
+    Keys are customer ids. The per-request cache means repeated reads of the same
+    customer (both fields, aliases, several routes) produce a single event. Callers
