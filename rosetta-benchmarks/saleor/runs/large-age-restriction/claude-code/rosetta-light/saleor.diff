+        user=staff, type=CustomerEvents.ACCOUNT_ACTIVATED, parameters={}
+    )
+    # Birthday event where the staff member is the subject: kept, unlinked.
+    staff_birthday = CustomerEvent.objects.create(
+        user=staff,
+        type=CustomerEvents.BIRTHDAY_CHANGED,
+        parameters={"customer_id": staff.pk, "actor_user_id": staff.pk},
+    )
+    # Birthday event where the staff member is only the actor: stays on the customer.
+    customer_birthday = CustomerEvent.objects.create(
+        user=adult,
+        type=CustomerEvents.BIRTHDAY_CHANGED,
+        parameters={"customer_id": adult.pk, "actor_user_id": staff.pk},
+    )
+    # Non-birthday event where the staff member is the actor: deleted as today.
+    staff_note = CustomerEvent.objects.create(
+        user=staff,
+        type=CustomerEvents.NOTE_ADDED,
+        parameters={"customer_id": adult.pk},
+    )
+    variables = {"id": graphene.Node.to_global_id("User", staff.pk)}
+
+    # when
+    response = staff_api_client.post_graphql(
+        STAFF_DELETE_MUTATION, variables, permissions=[permission_manage_staff]
+    )
+
+    # then
+    content = get_graphql_content(response)
+    assert content["data"]["staffDelete"]["errors"] == []
+    assert not User.objects.filter(pk=staff.pk).exists()
+
+    retained = CustomerEvent.objects.get(pk=staff_birthday.pk)
+    assert retained.user_id is None
+    assert retained.parameters == staff_birthday.parameters
+
+    assert CustomerEvent.objects.get(pk=customer_birthday.pk).user_id == adult.pk
+    assert not CustomerEvent.objects.filter(
+        pk__in=[staff_activated.pk, staff_note.pk]
+    ).exists()
