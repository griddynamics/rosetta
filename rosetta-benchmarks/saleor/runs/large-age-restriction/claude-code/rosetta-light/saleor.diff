+
+CUSTOMER_CREATE_BIRTHDAY_MUTATION = """
+    mutation CreateCustomer($input: UserCreateInput!) {
+        customerCreate(input: $input) {
+            user {
+                id
+            }
+            errors {
+                field
+                code
+                message
+            }
+        }
+    }
+"""
+
+NEW_CUSTOMER_EMAIL = "superuser-created@example.com"
+
+
+def _create_input(birthday):
+    return {
+        "input": {
+            "email": NEW_CUSTOMER_EMAIL,
+            "firstName": "Created",
+            "birthday": birthday,
+        }
