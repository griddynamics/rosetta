diff --git a/src/customers/components/CustomerCreateDetails/CustomerCreateDetails.test.tsx b/src/customers/components/CustomerCreateDetails/CustomerCreateDetails.test.tsx
new file mode 100644
index 000000000..a75ad01d2
--- /dev/null
+++ b/src/customers/components/CustomerCreateDetails/CustomerCreateDetails.test.tsx
@@ -0,0 +1,97 @@
+import { AccountErrorCode, type AccountErrorFragment } from "@dashboard/graphql";
+import Wrapper from "@test/wrapper";
+import { fireEvent, render, screen } from "@testing-library/react";
+import { type ComponentProps } from "react";
+
+import { type CustomerCreatePageFormData } from "../CustomerCreatePage/CustomerCreatePage";
+import CustomerCreateDetails from "./CustomerCreateDetails";
+
+const baseData: CustomerCreatePageFormData = {
+  birthday: "",
+  customerFirstName: "Ada",
+  customerLastName: "Lovelace",
+  email: "ada@example.com",
+  note: "",
+};
+
+const renderDetails = (props?: Partial<ComponentProps<typeof CustomerCreateDetails>>) => {
+  const changes: Array<{ name: string; value: string }> = [];
+  const onChange = jest.fn((event: { target: { name: string; value: string } }) => {
+    changes.push({ name: event.target.name, value: event.target.value });
+  });
+
+  render(
+    <Wrapper>
+      <CustomerCreateDetails
+        data={baseData}
+        disabled={false}
+        errors={[]}
+        onChange={onChange}
+        {...props}
+      />
+    </Wrapper>,
+  );
+
+  return { onChange, changes };
+};
+
+const getBirthdayInput = () => screen.getByTestId("customer-birthday") as HTMLInputElement;
+
+describe("CustomerCreateDetails birthday", () => {
+  it("renders an empty date field by default", () => {
+    // Arrange & Act
+    renderDetails();
+
+    // Assert
+    expect(getBirthdayInput()).toHaveAttribute("type", "date");
+    expect(getBirthdayInput().value).toBe("");
+  });
+
+  it("does not allow picking a date after today", () => {
+    // Arrange & Act
+    renderDetails();
+
+    // Assert
+    expect(getBirthdayInput()).toHaveAttribute("max", new Date().toISOString().slice(0, 10));
+  });
+
+  it("renders the provided birthday", () => {
+    // Arrange & Act
+    renderDetails({ data: { ...baseData, birthday: "1815-12-10" } });
+
+    // Assert
+    expect(getBirthdayInput().value).toBe("1815-12-10");
+  });
+
+  it("reports changes under the birthday field name", () => {
+    // Arrange
+    const { changes } = renderDetails();
+
+    // Act
+    fireEvent.change(getBirthdayInput(), { target: { value: "1815-12-10" } });
+
+    // Assert
+    expect(changes[0]).toMatchObject({
+      name: "birthday",
+      value: "1815-12-10",
+    });
+  });
+
+  it("shows the server error for the birthday field", () => {
+    // Arrange
+    const errors = [
+      {
+        __typename: "AccountError",
+        code: AccountErrorCode.INVALID,
+        field: "birthday",
+        message: "Birthday cannot be in the future.",
+      },
+    ] as AccountErrorFragment[];
+
+    // Act
+    renderDetails({ errors });
+
+    // Assert
+    expect(screen.getByText("Birthday cannot be in the future.")).toBeInTheDocument();
+  });
+});
