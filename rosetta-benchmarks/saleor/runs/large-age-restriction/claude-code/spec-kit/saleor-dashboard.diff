+import { getLatestBirthday } from "./birthday";
+
+describe("getLatestBirthday", () => {
+  it("returns the given day as YYYY-MM-DD in UTC", () => {
+    // Arrange
+    const now = new Date("2026-10-22T23:59:59Z");
+
+    // Act
