@@ -0,0 +1,100 @@
+import { AccountErrorCode, type AccountErrorFragment } from "@dashboard/graphql";
+import Wrapper from "@test/wrapper";
+import { fireEvent, render, screen } from "@testing-library/react";
+import { type ComponentProps } from "react";
+
+import CustomerInfo from "./CustomerInfo";
+
+const baseData = {
+  firstName: "Tom",
+  lastName: "Cooper",
+  email: "tom@example.com",
+  birthday: "",
+  note: "",
+};
+
+const renderInfo = (props?: Partial<ComponentProps<typeof CustomerInfo>>) => {
+  const changes: Array<{ name: string; value: string }> = [];
+  const onChange = jest.fn((event: { target: { name: string; value: string } }) => {
+    changes.push({ name: event.target.name, value: event.target.value });
+  });
+
+  render(
+    <Wrapper>
+      <CustomerInfo data={baseData} disabled={false} errors={[]} onChange={onChange} {...props} />
+    </Wrapper>,
+  );
+
+  return { onChange, changes };
+};
+
+const getBirthdayInput = () => screen.getByTestId("customer-birthday") as HTMLInputElement;
+
+describe("CustomerInfo birthday", () => {
+  it("renders an empty date field when the customer has no birthday", () => {
+    // Arrange & Act
+    renderInfo();
+
+    // Assert
+    expect(getBirthdayInput()).toHaveAttribute("type", "date");
+    expect(getBirthdayInput().value).toBe("");
+  });
+
+  it("does not allow picking a date after today", () => {
+    // Arrange & Act
+    renderInfo();
+
+    // Assert
+    expect(getBirthdayInput()).toHaveAttribute("max", new Date().toISOString().slice(0, 10));
+  });
+
+  it("renders the saved birthday", () => {
+    // Arrange & Act
+    renderInfo({ data: { ...baseData, birthday: "1990-05-17" } });
+
+    // Assert
+    expect(getBirthdayInput().value).toBe("1990-05-17");
+  });
+
+  it("reports changes and clearing under the birthday field name", () => {
+    // Arrange
+    const { changes } = renderInfo({ data: { ...baseData, birthday: "1990-05-17" } });
+
+    // Act
+    fireEvent.change(getBirthdayInput(), { target: { value: "1991-01-02" } });
+    fireEvent.change(getBirthdayInput(), { target: { value: "" } });
+
+    // Assert
+    expect(changes[0]).toMatchObject({
+      name: "birthday",
+      value: "1991-01-02",
+    });
+    expect(changes[1]).toMatchObject({ name: "birthday", value: "" });
+  });
+
+  it("shows the server error for the birthday field", () => {
+    // Arrange
+    const errors = [
+      {
+        __typename: "AccountError",
+        code: AccountErrorCode.INVALID,
+        field: "birthday",
+        message: "Birthday cannot be in the future.",
+      },
+    ] as AccountErrorFragment[];
+
+    // Act
+    renderInfo({ errors });
+
+    // Assert
+    expect(screen.getByText("Birthday cannot be in the future.")).toBeInTheDocument();
+  });
+
+  it("disables the field when the form is disabled", () => {
+    // Arrange & Act
+    renderInfo({ disabled: true });
+
+    // Assert
+    expect(getBirthdayInput()).toBeDisabled();
+  });
+});
