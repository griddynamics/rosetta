+
+  it("should include minimumAge as integer when provided", () => {
+    // Arrange
+    const data = { ...baseData, minimumAge: "18" } as ProductUpdateSubmitData;
+
+    // Act
+    const result = getProductUpdateVariables(baseProduct, data, []);
+
+    // Assert
+    expect(result.input.minimumAge).toBe(18);
+  });
+
+  it("should send null minimumAge when the field was cleared", () => {
+    // Arrange
+    const data = { ...baseData, minimumAge: "" } as ProductUpdateSubmitData;
+
+    // Act
+    const result = getProductUpdateVariables(baseProduct, data, []);
+
+    // Assert
+    expect(result.input.minimumAge).toBeNull();
+  });
+
+  it("should not include minimumAge when the field was not changed", () => {
+    // Arrange
+    const data = { ...baseData } as ProductUpdateSubmitData;
+
+    // Act
+    const result = getProductUpdateVariables(baseProduct, data, []);
+
+    // Assert
+    expect(result.input).not.toHaveProperty("minimumAge");
+  });
 });
