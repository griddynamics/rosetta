diff --git a/src/products/components/ProductDetailsForm/ProductDetailsForm.test.tsx b/src/products/components/ProductDetailsForm/ProductDetailsForm.test.tsx
new file mode 100644
index 000000000..b562df67f
--- /dev/null
+++ b/src/products/components/ProductDetailsForm/ProductDetailsForm.test.tsx
@@ -0,0 +1,118 @@
+import { ProductErrorCode, type ProductErrorFragment } from "@dashboard/graphql";
+import { RichTextContext } from "@dashboard/utils/richText/context";
+import Wrapper from "@test/wrapper";
+import { fireEvent, render, screen } from "@testing-library/react";
+import { type ComponentProps } from "react";
+
+import { ProductDetailsForm } from "./ProductDetailsForm";
+
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditor", () => ({
+  __esModule: true,
+  default: () => <div data-test-id="rich-text-editor-mock" />,
+}));
+
+const richTextContext = {
+  editorRef: { current: null },
+  defaultValue: undefined,
+  isReadyForMount: false,
+  handleChange: jest.fn(),
+} as unknown as React.ContextType<typeof RichTextContext>;
+
+const renderForm = (props?: Partial<ComponentProps<typeof ProductDetailsForm>>) => {
+  const changes: Array<{ name: string; value: string }> = [];
+  const onChange = jest.fn((event: { target: { name: string; value: string } }) => {
+    changes.push({ name: event.target.name, value: event.target.value });
+  });
+
+  render(
+    <Wrapper>
+      <RichTextContext.Provider value={richTextContext}>
+        <ProductDetailsForm
+          data={{ description: { blocks: [] }, name: "Beer", rating: null, minimumAge: "" }}
+          errors={[]}
+          onChange={onChange}
+          {...props}
+        />
+      </RichTextContext.Provider>
+    </Wrapper>,
+  );
+
+  return { onChange, changes };
+};
+
+const getMinimumAgeInput = () => screen.getByTestId("product-minimum-age") as HTMLInputElement;
+
+describe("ProductDetailsForm minimum age", () => {
+  it("renders an empty minimum age field for an unrestricted product", () => {
+    // Arrange & Act
+    renderForm();
+
+    // Assert
+    expect(getMinimumAgeInput().value).toBe("");
+    expect(getMinimumAgeInput()).toHaveAttribute("type", "number");
+    expect(getMinimumAgeInput()).toHaveAttribute("min", "1");
+  });
+
+  it("renders the saved minimum age", () => {
+    // Arrange & Act
+    renderForm({
+      data: { description: { blocks: [] }, name: "Beer", rating: null, minimumAge: "18" },
+    });
+
+    // Assert
+    expect(getMinimumAgeInput().value).toBe("18");
+  });
+
+  it("reports changes under the minimumAge field name", () => {
+    // Arrange
+    const { changes } = renderForm();
+
+    // Act
+    fireEvent.change(getMinimumAgeInput(), { target: { value: "21" } });
+
+    // Assert
+    expect(changes).toHaveLength(1);
+    expect(changes[0]).toMatchObject({ name: "minimumAge", value: "21" });
+  });
+
+  it("reports a cleared value as an empty string", () => {
+    // Arrange
+    const { changes } = renderForm({
+      data: { description: { blocks: [] }, name: "Beer", rating: null, minimumAge: "18" },
+    });
+
+    // Act
+    fireEvent.change(getMinimumAgeInput(), { target: { value: "" } });
+
+    // Assert
+    expect(changes[0]).toMatchObject({ name: "minimumAge", value: "" });
+  });
+
+  it("shows the server error for the minimumAge field", () => {
+    // Arrange
+    const errors = [
+      {
+        __typename: "ProductError",
+        code: ProductErrorCode.INVALID,
+        field: "minimumAge",
+        message: "Must be at least 1",
+      },
+    ] as ProductErrorFragment[];
+
+    // Act
+    renderForm({ errors });
+
+    // Assert
+    expect(
+      screen.getByText("Minimum age must be a whole number of at least 1"),
+    ).toBeInTheDocument();
+  });
+
+  it("does not render the field when the data has no minimum age value", () => {
+    // Arrange & Act
+    renderForm({ data: { description: { blocks: [] }, name: "Beer", rating: null } });
+
+    // Assert
+    expect(screen.queryByTestId("product-minimum-age")).not.toBeInTheDocument();
+  });
+});
