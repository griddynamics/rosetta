+def get_age_in_years(birthday: datetime.date, today: datetime.date) -> int:
+    """Return the number of completed years between birthday and today."""
+    return (
+        today.year
+        - birthday.year
+        - ((today.month, today.day) < (birthday.month, birthday.day))
+    )
+
+
+def validate_age_restriction(
+    user: Optional["User"],
+    variants_with_products: Iterable[tuple["ProductVariant", "Product"]],
+    error_code_class: type[CheckoutErrorCode] | type[OrderCreateFromCheckoutErrorCode],
+):
+    """Raise ValidationError when the user is too young to buy any of the variants.
+
+    A missing user (guest checkout) or a user without a birthday is not allowed
+    to buy products with a minimum age.
+    """
+    restricted = [
+        (variant, product.minimum_age)
+        for variant, product in variants_with_products
+        if product.minimum_age is not None
+    ]
+    if not restricted:
+        return
+    restricted_variants = [variant for variant, _ in restricted]
+
+    def _raise(code, message, variants_to_report):
+        raise ValidationError(
+            {
+                "lines": ValidationError(
+                    message,
+                    code=code.value,
+                    params={
+                        "variants": {
+                            graphene.Node.to_global_id("ProductVariant", v.pk)
+                            for v in variants_to_report
+                        }
+                    },
+                )
+            }
+        )
+
+    birthday = user.birthday if user else None
+    if birthday is None:
+        _raise(
+            error_code_class.BIRTHDAY_REQUIRED,
+            "A birthday is required to buy age-restricted products.",
+            restricted_variants,
+        )
+        return
+
+    age = get_age_in_years(birthday, get_shop_today())
+    too_young = [variant for variant, minimum_age in restricted if age < minimum_age]
+    if too_young:
+        _raise(
+            error_code_class.PRODUCT_AGE_RESTRICTED,
+            "Some of the products are age-restricted and cannot be bought by "
+            "this customer.",
+            too_young,
+        )
+
+
+def validate_checkout_age_restriction(
+    checkout_info: "CheckoutInfo",
+    lines: list["CheckoutLineInfo"],
+    error_code_class: type[CheckoutErrorCode] | type[OrderCreateFromCheckoutErrorCode],
+    user: Optional["User"] = None,
+):
+    """Validate that the buyer can purchase all age-restricted checkout lines.
+
+    The buyer is the given user, falling back to the user assigned to the checkout.
+    """
+    validate_age_restriction(
+        user or checkout_info.user,
+        ((line.variant, line.product) for line in lines),
+        error_code_class,
+    )
+
