+def test_birthday_future_check_uses_shop_time_zone(
+    settings, user_api_client, customer_user
+):
+    # given - the shop's date differs from the UTC date: a birthday on the shop's
+    # current date is accepted and one on the shop's next day is in the future,
+    # whichever way round the two dates are
+    zone = _zone_on_another_day_than_utc()
+    settings.SHOP_TIME_ZONE = zone
+    shop_today = datetime.datetime.now(zoneinfo.ZoneInfo(zone)).date()
+    shop_tomorrow = shop_today + datetime.timedelta(days=1)
+
+    # when
+    today_response = user_api_client.post_graphql(
+        ACCOUNT_UPDATE_BIRTHDAY, {"input": {"birthday": shop_today.isoformat()}}
+    )
+    tomorrow_response = user_api_client.post_graphql(
+        ACCOUNT_UPDATE_BIRTHDAY, {"input": {"birthday": shop_tomorrow.isoformat()}}
+    )
+
+    # then
+    assert not get_graphql_content(today_response)["data"]["accountUpdate"]["errors"]
+    assert get_graphql_content(tomorrow_response)["data"]["accountUpdate"][
+        "errors"
+    ] == [{"field": "birthday", "code": AccountErrorCode.INVALID.name}]
+    customer_user.refresh_from_db()
+    assert customer_user.birthday == shop_today
