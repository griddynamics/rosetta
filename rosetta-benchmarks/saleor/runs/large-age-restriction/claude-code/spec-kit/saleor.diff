+"""
+
+
+def test_product_create_with_minimum_age(
+    staff_api_client, product_type, permission_manage_products
+):
+    # given
+    variables = {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "name": "Whisky",
+            "minimumAge": 18,
+        }
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_CREATE_MINIMUM_AGE,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["minimumAge"] == 18
+
+
+def test_product_create_without_minimum_age_is_unrestricted(
+    staff_api_client, product_type, permission_manage_products
+):
