+import datetime
+
+import pytest
+from django.core.exceptions import ImproperlyConfigured
+from freezegun import freeze_time
+
+from ..shop_time_zone import get_shop_today, validate_shop_time_zone
+
+
+@freeze_time("2026-03-01 23:30:00")
+def test_get_shop_today_defaults_to_utc():
+    assert get_shop_today() == datetime.date(2026, 3, 1)
+
+
+@freeze_time("2026-03-01 23:30:00")
+def test_get_shop_today_ahead_of_utc_is_on_the_next_day(settings):
+    # given - Auckland is UTC+13 in March
+    settings.SHOP_TIME_ZONE = "Pacific/Auckland"
+
+    # when / then
+    assert get_shop_today() == datetime.date(2026, 3, 2)
+
+
+@freeze_time("2026-03-02 05:00:00")
+def test_get_shop_today_behind_utc_is_on_the_previous_day(settings):
+    # given - Honolulu is UTC-10
+    settings.SHOP_TIME_ZONE = "Pacific/Honolulu"
+
+    # when / then
+    assert get_shop_today() == datetime.date(2026, 3, 1)
+
+
+def test_validate_shop_time_zone_accepts_iana_names():
+    assert validate_shop_time_zone("UTC") == "UTC"
+    assert validate_shop_time_zone("Europe/Warsaw") == "Europe/Warsaw"
+
+
+@pytest.mark.parametrize("zone", ["Mars/Olympus", "", "not a zone", "../etc/passwd"])
+def test_validate_shop_time_zone_rejects_invalid_names(zone):
+    with pytest.raises(ImproperlyConfigured):
+        validate_shop_time_zone(zone)
