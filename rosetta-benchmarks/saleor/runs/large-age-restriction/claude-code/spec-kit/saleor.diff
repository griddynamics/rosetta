+from .....account import CustomerEvents
+from .....account.error_codes import AccountErrorCode
+from .....account.models import CustomerEvent, User
+from ....tests.utils import get_graphql_content
+
+CUSTOMER_CREATE_BIRTHDAY = """
+mutation customerCreate($input: UserCreateInput!) {
+  customerCreate(input: $input) {
+    user {
+      email
+    }
+    errors {
+      field
+      code
+    }
+  }
+}
+"""
+
+CUSTOMER_UPDATE_BIRTHDAY = """
+mutation customerUpdate($id: ID!, $input: CustomerInput!) {
+  customerUpdate(id: $id, input: $input) {
+    user {
+      id
+    }
+    errors {
+      field
+      code
+    }
+  }
+}
+"""
+
+ACCOUNT_UPDATE_BIRTHDAY = """
+mutation accountUpdate($input: AccountInput!) {
+  accountUpdate(input: $input) {
+    user {
+      birthday
+    }
+    errors {
+      field
+      code
+    }
+  }
+}
+"""
+
+ME_BIRTHDAY = """
+query {
+  me {
+    birthday
+  }
+}
+"""
+
+USER_BIRTHDAY = """
+query user($id: ID!) {
+  user(id: $id) {
+    birthday
+  }
+}
+"""
+
+BIRTHDAY = datetime.date(1990, 5, 17)
+
+
+def test_customer_create_with_birthday(staff_api_client, permission_manage_users):
+    # given
+    variables = {
+        "input": {"email": "new-customer@example.com", "birthday": BIRTHDAY.isoformat()}
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CUSTOMER_CREATE_BIRTHDAY, variables, permissions=[permission_manage_users]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["customerCreate"]
+    assert not data["errors"]
+    assert User.objects.get(email="new-customer@example.com").birthday == BIRTHDAY
+
+
+def test_customer_create_with_future_birthday(
+    staff_api_client, permission_manage_users
+):
+    # given
+    tomorrow = timezone.now().date() + datetime.timedelta(days=1)
+    variables = {
+        "input": {"email": "new-customer@example.com", "birthday": tomorrow.isoformat()}
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CUSTOMER_CREATE_BIRTHDAY, variables, permissions=[permission_manage_users]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["customerCreate"]
+    assert data["errors"] == [
+        {"field": "birthday", "code": AccountErrorCode.INVALID.name}
+    ]
+    assert not User.objects.filter(email="new-customer@example.com").exists()
+
+
+def test_customer_update_sets_and_clears_birthday(
+    staff_api_client, customer_user, permission_manage_users
+):
+    # given
+    user_id = graphene.Node.to_global_id("User", customer_user.pk)
+
+    # when
+    response = staff_api_client.post_graphql(
+        CUSTOMER_UPDATE_BIRTHDAY,
+        {"id": user_id, "input": {"birthday": BIRTHDAY.isoformat()}},
+        permissions=[permission_manage_users],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["customerUpdate"]
+    assert not data["errors"]
+    customer_user.refresh_from_db()
+    assert customer_user.birthday == BIRTHDAY
+
+    # when
+    response = staff_api_client.post_graphql(
+        CUSTOMER_UPDATE_BIRTHDAY, {"id": user_id, "input": {"birthday": None}}
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["customerUpdate"]
+    assert not data["errors"]
+    customer_user.refresh_from_db()
+    assert customer_user.birthday is None
