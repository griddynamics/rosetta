+def _years_ago(years: int, days_offset: int = 0) -> datetime.date:
+    today = timezone.now().date().replace(day=1)
+    day = timezone.now().date().day - 1
+    return today.replace(year=today.year - years) + datetime.timedelta(
+        days=day + days_offset
+    )
+
+
+def _zone_on_another_day_than_utc() -> str:
+    """Return a time zone whose current date differs from the UTC date.
+
+    The two zones are 26 hours apart, so at any moment at least one of them is on
+    a different calendar day than UTC.
+    """
+    utc_today = datetime.datetime.now(datetime.UTC).date()
+    for zone in ("Pacific/Kiritimati", "Etc/GMT+12"):
+        if datetime.datetime.now(zoneinfo.ZoneInfo(zone)).date() != utc_today:
+            return zone
+    raise AssertionError("No time zone on a different day than UTC")
+
+
+def _birthday_for_shop_age(years: int, days_offset: int = 0) -> datetime.date:
+    today = get_shop_today()
+    return today.replace(year=today.year - years, day=1) + datetime.timedelta(
+        days=today.day - 1 + days_offset
+    )
