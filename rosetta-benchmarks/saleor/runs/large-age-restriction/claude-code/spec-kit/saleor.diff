@@ -0,0 +1,149 @@
+import datetime
+
+import pytest
+from django.core.exceptions import ValidationError
+from django.utils import timezone
+from freezegun import freeze_time
+
+from ..checkout_cleaner import get_age_in_years, validate_age_restriction
+from ..error_codes import CheckoutErrorCode
+
+
+@pytest.mark.parametrize(
+    ("birthday", "today", "expected_age"),
+    [
+        (datetime.date(2000, 6, 15), datetime.date(2018, 6, 14), 17),
+        (datetime.date(2000, 6, 15), datetime.date(2018, 6, 15), 18),
+        (datetime.date(2000, 6, 15), datetime.date(2018, 6, 16), 18),
+        (datetime.date(2000, 2, 29), datetime.date(2018, 2, 28), 17),
+        (datetime.date(2000, 2, 29), datetime.date(2018, 3, 1), 18),
+        (datetime.date(2000, 2, 29), datetime.date(2020, 2, 29), 20),
+        (datetime.date(2018, 6, 15), datetime.date(2018, 6, 15), 0),
+    ],
+)
+def test_get_age_in_years(birthday, today, expected_age):
+    assert get_age_in_years(birthday, today) == expected_age
+
+
+def _years_ago(years: int, days_offset: int = 0) -> datetime.date:
+    today = timezone.now().date()
+    return today.replace(year=today.year - years, day=1) + datetime.timedelta(
+        days=today.day - 1 + days_offset
+    )
+
+
+def test_validate_age_restriction_no_restricted_products(
+    customer_user, product, variant
+):
+    # given
+    assert product.minimum_age is None
+    customer_user.birthday = None
+
+    # when / then
+    validate_age_restriction(customer_user, [(variant, product)], CheckoutErrorCode)
+    validate_age_restriction(None, [(variant, product)], CheckoutErrorCode)
+
+
+def test_validate_age_restriction_guest_is_rejected(product, variant):
+    # given
+    product.minimum_age = 18
+
+    # when
+    with pytest.raises(ValidationError) as error:
+        validate_age_restriction(None, [(variant, product)], CheckoutErrorCode)
+
+    # then
+    lines_error = error.value.error_dict["lines"][0]
+    assert lines_error.code == CheckoutErrorCode.BIRTHDAY_REQUIRED.value
+
+
+def test_validate_age_restriction_user_without_birthday_is_rejected(
+    customer_user, product, variant
+):
+    # given
+    product.minimum_age = 18
+    customer_user.birthday = None
+
+    # when
+    with pytest.raises(ValidationError) as error:
+        validate_age_restriction(customer_user, [(variant, product)], CheckoutErrorCode)
+
+    # then
+    lines_error = error.value.error_dict["lines"][0]
+    assert lines_error.code == CheckoutErrorCode.BIRTHDAY_REQUIRED.value
+
+
+def test_validate_age_restriction_too_young_is_rejected(
+    customer_user, product, variant
+):
+    # given
+    product.minimum_age = 18
+    customer_user.birthday = _years_ago(18, days_offset=1)
+
+    # when
+    with pytest.raises(ValidationError) as error:
+        validate_age_restriction(customer_user, [(variant, product)], CheckoutErrorCode)
+
+    # then
+    lines_error = error.value.error_dict["lines"][0]
+    assert lines_error.code == CheckoutErrorCode.PRODUCT_AGE_RESTRICTED.value
+    assert len(lines_error.params["variants"]) == 1
+
+
+def test_validate_age_restriction_exactly_of_age_is_allowed(
+    customer_user, product, variant
+):
+    # given
+    product.minimum_age = 18
+    customer_user.birthday = _years_ago(18)
+
+    # when / then
+    validate_age_restriction(customer_user, [(variant, product)], CheckoutErrorCode)
+
+
+@freeze_time("2026-03-01 23:30:00")
+def test_validate_age_restriction_uses_shop_date_when_ahead_of_utc(
+    settings, customer_user, product, variant
+):
+    # given - it is still 1 March in UTC but already 2 March in Auckland (UTC+13),
+    # so a customer born on 2 March 2008 turns 18 today for the shop
+    settings.SHOP_TIME_ZONE = "Pacific/Auckland"
+    product.minimum_age = 18
+    customer_user.birthday = datetime.date(2008, 3, 2)
+
+    # when / then
+    validate_age_restriction(customer_user, [(variant, product)], CheckoutErrorCode)
+
+
+@freeze_time("2026-03-02 05:00:00")
+def test_validate_age_restriction_uses_shop_date_when_behind_utc(
+    settings, customer_user, product, variant
+):
+    # given - it is already 2 March in UTC but still 1 March in Honolulu (UTC-10),
+    # so a customer born on 2 March 2008 is not 18 yet for the shop
+    settings.SHOP_TIME_ZONE = "Pacific/Honolulu"
+    product.minimum_age = 18
+    customer_user.birthday = datetime.date(2008, 3, 2)
+
+    # when
+    with pytest.raises(ValidationError) as error:
+        validate_age_restriction(customer_user, [(variant, product)], CheckoutErrorCode)
+
+    # then
+    lines_error = error.value.error_dict["lines"][0]
+    assert lines_error.code == CheckoutErrorCode.PRODUCT_AGE_RESTRICTED.value
+
+
+@freeze_time("2026-03-01 23:30:00")
+def test_validate_age_restriction_defaults_to_utc_date(customer_user, product, variant):
+    # given - without SHOP_TIME_ZONE the UTC date (1 March) applies
+    product.minimum_age = 18
+    customer_user.birthday = datetime.date(2008, 3, 2)
+
+    # when
+    with pytest.raises(ValidationError) as error:
+        validate_age_restriction(customer_user, [(variant, product)], CheckoutErrorCode)
+
+    # then
+    lines_error = error.value.error_dict["lines"][0]
+    assert lines_error.code == CheckoutErrorCode.PRODUCT_AGE_RESTRICTED.value
