+++ b/src/lib/age-restriction-label.ts
@@ -0,0 +1,8 @@
+/**
+ * Age to show in the "Age {age}+" label, or null when the product is unrestricted
+ * (missing, null, non-finite or below 1).
+ */
+export function getAgeRestrictionLabelAge(minimumAge: number | null | undefined): number | null {
+	if (minimumAge == null || !Number.isFinite(minimumAge) || minimumAge < 1) return null;
+	return Math.floor(minimumAge);
+}
