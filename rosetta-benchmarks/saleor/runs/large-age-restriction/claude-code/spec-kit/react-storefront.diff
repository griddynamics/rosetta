+import { describe, expect, it } from "vitest";
+
+import type { ProductListItemFragment } from "@/gql/graphql";
+import { toProductCardData } from "./to-card";
+
+function node(minimumAge?: number | null): ProductListItemFragment {
+	return {
+		__typename: "Product",
+		id: "p1",
+		name: "Beer",
+		slug: "beer",
+		created: "2024-01-01T00:00:00Z",
+		translation: null,
+		pricing: null,
+		category: null,
+		thumbnail: null,
+		thumbnail256: null,
+		thumbnail512: null,
+		bestseller: null,
+		pulseBestseller: null,
+		productVariants: { totalCount: 1, edges: [] },
+		...(minimumAge === undefined ? {} : { minimumAge }),
+	} as unknown as ProductListItemFragment;
+}
+
+describe("toProductCardData minimumAge", () => {
+	it("passes the minimum age through", () => {
+		expect(toProductCardData(node(18), "en-US", "default-channel").minimumAge).toBe(18);
+	});
+
+	it("is null when unrestricted or absent", () => {
+		expect(toProductCardData(node(null), "en-US", "default-channel").minimumAge).toBeNull();
+		expect(toProductCardData(node(), "en-US", "default-channel").minimumAge).toBeNull();
+	});
+});
