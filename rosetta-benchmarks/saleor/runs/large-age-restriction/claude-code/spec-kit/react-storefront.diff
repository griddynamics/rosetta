@@ -0,0 +1,52 @@
+"use client";
+
+import { useActionState } from "react";
+import { useTranslations } from "next-intl";
+import { LinkWithChannel } from "@/ui/atoms/link-with-channel";
+import { accountRoutes } from "@/ui/components/account/routes";
+import type { AgeRestrictionErrorCode } from "@/lib/age-restriction";
+
+export type AddToCartFormState = { errorCode: AgeRestrictionErrorCode | null };
+
+const initialAddToCartFormState: AddToCartFormState = { errorCode: null };
+
+interface AddToCartFormProps {
+	action: (state: AddToCartFormState, formData: FormData) => Promise<AddToCartFormState>;
+	className?: string;
+	children: React.ReactNode;
+}
+
+/** Add-to-cart form that surfaces age-restriction refusals from the server action. */
+export function AddToCartForm({ action, className, children }: AddToCartFormProps) {
+	const [state, formAction] = useActionState(action, initialAddToCartFormState);
+
+	return (
+		<form action={formAction} className={className}>
+			{children}
+			<AgeRestrictionMessage errorCode={state.errorCode} />
+		</form>
+	);
+}
+
+function AgeRestrictionMessage({ errorCode }: { errorCode: AgeRestrictionErrorCode | null }) {
+	const t = useTranslations("pdp.ageRestriction");
+
+	if (!errorCode) {
+		return null;
+	}
+
+	return (
+		<p role="alert" className="text-sm text-destructive">
+			{errorCode === "PRODUCT_AGE_RESTRICTED" ? (
+				t("restricted")
+			) : (
+				<>
+					{t("birthdayRequired")}{" "}
+					<LinkWithChannel href={accountRoutes.settings} className="underline">
+						{t("addBirthdayLink")}
+					</LinkWithChannel>
+				</>
+			)}
+		</p>
+	);
+}
