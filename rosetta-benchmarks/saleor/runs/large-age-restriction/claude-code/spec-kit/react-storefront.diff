+++ b/src/app/(storefront)/[locale]/[channel]/(main)/account/actions.test.ts
@@ -0,0 +1,74 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const { mutate } = vi.hoisted(() => ({ mutate: vi.fn() }));
+
+vi.mock("next/cache", () => ({ refresh: vi.fn() }));
+vi.mock("@/lib/saleor", () => ({ mutate }));
+
+import { updateBirthday } from "./actions";
+
+function form(values: Record<string, string>): FormData {
+	const fd = new FormData();
+	for (const [key, value] of Object.entries(values)) fd.set(key, value);
+	return fd;
+}
+
+describe("updateBirthday", () => {
+	beforeEach(() => {
+		mutate.mockReset();
+	});
+
+	it("sends the birthday through accountUpdate", async () => {
+		mutate.mockResolvedValue({ ok: true, data: { accountUpdate: { errors: [] } } });
+
+		await expect(updateBirthday(form({ birthday: "1990-05-17" }))).resolves.toEqual({ success: true });
+		expect(mutate).toHaveBeenCalledWith(expect.anything(), {
+			variables: { input: { birthday: "1990-05-17" } },
+		});
+	});
+
+	it("clears the birthday with null when the field is empty", async () => {
+		mutate.mockResolvedValue({ ok: true, data: { accountUpdate: { errors: [] } } });
+
+		await updateBirthday(form({ birthday: "" }));
+
+		expect(mutate).toHaveBeenCalledWith(expect.anything(), { variables: { input: { birthday: null } } });
+	});
+
+	it("returns the backend error message for birthday", async () => {
+		mutate.mockResolvedValue({
+			ok: true,
+			data: {
+				accountUpdate: {
+					errors: [{ field: "birthday", code: "INVALID", message: "Birthday cannot be in the future." }],
+				},
+			},
+		});
+
+		await expect(updateBirthday(form({ birthday: "2999-01-01" }))).resolves.toEqual({
+			success: false,
+			error: "Birthday cannot be in the future.",
+		});
+	});
+
+	it("falls back to a translated key when the error has no message", async () => {
+		mutate.mockResolvedValue({
+			ok: true,
+			data: { accountUpdate: { errors: [{ field: "birthday", code: "INVALID", message: null }] } },
+		});
+
+		await expect(updateBirthday(form({ birthday: "2999-01-01" }))).resolves.toEqual({
+			success: false,
+			errorKey: "updateProfileFailed",
+		});
+	});
+
+	it("returns transport errors", async () => {
+		mutate.mockResolvedValue({ ok: false, error: new Error("boom") });
+
+		await expect(updateBirthday(form({ birthday: "1990-05-17" }))).resolves.toEqual({
+			success: false,
+			error: "boom",
+		});
+	});
+});
