diff --git a/src/ui/components/account/edit-birthday-form.tsx b/src/ui/components/account/edit-birthday-form.tsx
new file mode 100644
index 00000000..a1d0f13b
--- /dev/null
+++ b/src/ui/components/account/edit-birthday-form.tsx
@@ -0,0 +1,116 @@
+"use client";
+
+import { useState, useTransition } from "react";
+import { useParams, useRouter } from "next/navigation";
+import { useTranslations } from "next-intl";
+import { Button } from "@/ui/components/ui/button";
+import { Input } from "@/ui/components/ui/input";
+import { Label } from "@/ui/components/ui/label";
+import { resolveLocaleFromSlug } from "@/config/locale";
+import { updateBirthday } from "@/app/(storefront)/[locale]/[channel]/(main)/account/actions";
+import { resolveAccountActionError } from "@/ui/components/account/account-action-result";
+
+type Props = {
+	/** ISO date (YYYY-MM-DD) or empty string when not set. */
+	birthday: string;
+};
+
+function formatBirthday(birthday: string, intlLocale: string): string {
+	// Parse as a calendar date; `new Date("YYYY-MM-DD")` would shift by timezone.
+	const [year, month, day] = birthday.split("-").map(Number);
+	return new Date(year, month - 1, day).toLocaleDateString(intlLocale, { dateStyle: "long" });
+}
+
+function todayIso(): string {
+	const now = new Date();
+	const month = String(now.getMonth() + 1).padStart(2, "0");
+	const day = String(now.getDate()).padStart(2, "0");
+	return `${now.getFullYear()}-${month}-${day}`;
+}
+
+export function EditBirthdayForm({ birthday }: Props) {
+	const t = useTranslations("account");
+	const router = useRouter();
+	const params = useParams<{ locale: string }>();
+	const intlLocale = resolveLocaleFromSlug(params.locale).bcp47;
+	const [isEditing, setIsEditing] = useState(false);
+	const [isPending, startTransition] = useTransition();
+	const [error, setError] = useState("");
+	const [success, setSuccess] = useState(false);
+
+	const handleSubmit = (formData: FormData) => {
+		setError("");
+		setSuccess(false);
+
+		startTransition(async () => {
+			const result = await updateBirthday(formData);
+			if (!result.success) {
+				setError(resolveAccountActionError(t, result));
+			} else {
+				setSuccess(true);
+				setIsEditing(false);
+				router.refresh();
+			}
+		});
+	};
+
+	if (!isEditing) {
+		return (
+			<div className="flex items-center justify-between">
+				<div>
+					<p className="text-sm text-muted-foreground">{t("fields.birthday")}</p>
+					<p className="font-medium">
+						{birthday ? formatBirthday(birthday, intlLocale) : t("common.notSet")}
+					</p>
+				</div>
+				<div className="flex items-center gap-2">
+					{success && (
+						<span aria-live="polite" className="text-sm text-green-600">
+							{t("common.updated")}
+						</span>
+					)}
+					<Button variant="ghost" size="sm" onClick={() => setIsEditing(true)}>
+						{t("common.edit")}
+					</Button>
+				</div>
+			</div>
+		);
+	}
+
+	return (
+		<form action={handleSubmit} className="space-y-4">
+			{error && (
+				<p role="alert" className="text-sm text-destructive">
+					{error}
+				</p>
+			)}
+			<div className="space-y-1.5 sm:max-w-xs">
+				<Label htmlFor="birthday">{t("fields.birthday")}</Label>
+				<Input
+					id="birthday"
+					name="birthday"
+					type="date"
+					autoComplete="bday"
+					defaultValue={birthday}
+					max={todayIso()}
+				/>
+			</div>
+			<div className="flex gap-2">
+				<Button type="submit" size="sm" disabled={isPending}>
+					{isPending ? t("common.saving") : t("common.save")}
+				</Button>
+				<Button
+					type="button"
+					variant="ghost"
+					size="sm"
+					onClick={() => {
+						setIsEditing(false);
+						setError("");
+					}}
+				>
+					{t("common.cancel")}
+				</Button>
+			</div>
+		</form>
+	);
+}
