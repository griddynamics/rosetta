+import { describe, expect, it } from "vitest";
+import type { CheckoutFragment, OrderFragment } from "@/checkout/graphql";
+import { checkoutLineToLineItem, orderLineToLineItem } from "./summary-line-items";
+
+const money = { currency: "USD", amount: 10 };
+
+function checkoutLine(minimumAge: number | null | undefined) {
+	return {
+		id: "line-1",
+		quantity: 2,
+		totalPrice: { gross: money },
+		variant: {
+			id: "var-1",
+			name: "Bottle",
+			attributes: [],
+			translation: null,
+			media: [],
+			product: { name: "Whisky", minimumAge, translation: null, media: [] },
+		},
+	} as unknown as CheckoutFragment["lines"][number];
+}
+
+function orderLine(variant: { minimumAge: number | null } | null) {
+	return {
+		id: "line-1",
+		quantity: 1,
+		productName: "Whisky",
+		variantName: "Bottle",
+		totalPrice: { gross: money },
+		thumbnail: { url: "https://example.invalid/w.webp", alt: "Whisky" },
+		variant: variant && {
+			name: "Bottle",
+			translation: null,
+			attributes: [],
+			product: { name: "Whisky", translation: null, minimumAge: variant.minimumAge },
+		},
+	} as unknown as OrderFragment["lines"][number];
+}
+
+describe("checkoutLineToLineItem", () => {
+	it("carries the product minimum age", () => {
+		expect(checkoutLineToLineItem(checkoutLine(18)).ageRestrictedAge).toBe(18);
+	});
+
+	it("is null for unrestricted products", () => {
+		expect(checkoutLineToLineItem(checkoutLine(null)).ageRestrictedAge).toBeNull();
+		expect(checkoutLineToLineItem(checkoutLine(undefined)).ageRestrictedAge).toBeNull();
+		expect(checkoutLineToLineItem(checkoutLine(0)).ageRestrictedAge).toBeNull();
+	});
+});
+
+describe("orderLineToLineItem", () => {
+	it("carries the product minimum age", () => {
+		const item = orderLineToLineItem(orderLine({ minimumAge: 21 }));
+		expect(item.ageRestrictedAge).toBe(21);
+		expect(item.name).toBe("Whisky");
+	});
+
+	it("is null for unrestricted products", () => {
+		expect(orderLineToLineItem(orderLine({ minimumAge: null })).ageRestrictedAge).toBeNull();
+	});
+
+	it("handles a null (deleted) variant", () => {
+		const item = orderLineToLineItem(orderLine(null));
+		expect(item.ageRestrictedAge).toBeNull();
+		expect(item.name).toBe("Whisky");
+	});
+});
