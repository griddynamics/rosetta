diff --git a/src/lib/age-restriction.ts b/src/lib/age-restriction.ts
new file mode 100644
index 00000000..eafb2f13
--- /dev/null
+++ b/src/lib/age-restriction.ts
@@ -0,0 +1,12 @@
+/** Saleor checkout error codes returned when a line's product has a minimum age. */
+export type AgeRestrictionErrorCode = "PRODUCT_AGE_RESTRICTED" | "BIRTHDAY_REQUIRED";
+
+const AGE_RESTRICTION_CODES: ReadonlyArray<string> = ["PRODUCT_AGE_RESTRICTED", "BIRTHDAY_REQUIRED"];
+
+/** Returns the first age-restriction error code in a checkout mutation's `errors`, if any. */
+export function findAgeRestrictionError(
+	errors: ReadonlyArray<{ code?: string | null }> | null | undefined,
+): AgeRestrictionErrorCode | null {
+	const match = errors?.find((error) => error.code && AGE_RESTRICTION_CODES.includes(error.code));
+	return (match?.code as AgeRestrictionErrorCode | undefined) ?? null;
+}
