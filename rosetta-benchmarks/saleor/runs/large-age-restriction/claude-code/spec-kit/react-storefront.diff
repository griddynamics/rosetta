+import { describe, expect, it } from "vitest";
+import {
+	getAgeRestrictedVariantIds,
+	getAgeRestrictionErrorMessage,
+	getProductNamesForVariants,
+} from "./age-restriction-error-message";
+
+const t = (key: string, values?: { items: string }) => `msg:${key}${values ? `:${values.items}` : ""}`;
+
+describe("getAgeRestrictionErrorMessage", () => {
+	it("maps PRODUCT_AGE_RESTRICTED", () => {
+		expect(getAgeRestrictionErrorMessage([{ code: "PRODUCT_AGE_RESTRICTED" }], t)).toBe(
+			"msg:productAgeRestricted",
+		);
+	});
+
+	it("maps BIRTHDAY_REQUIRED", () => {
+		expect(getAgeRestrictionErrorMessage([{ code: "BIRTHDAY_REQUIRED" }], t)).toBe("msg:birthdayRequired");
+	});
+
+	it("lists the affected items when names are given", () => {
+		expect(getAgeRestrictionErrorMessage([{ code: "PRODUCT_AGE_RESTRICTED" }], t, ["Whisky", "Cigars"])).toBe(
+			"msg:productAgeRestricted msg:ageRestrictedItems:Whisky, Cigars",
+		);
+	});
+
+	it("returns null for other errors", () => {
+		expect(getAgeRestrictionErrorMessage([{ code: "INVALID" }], t)).toBeNull();
+		expect(getAgeRestrictionErrorMessage([], t)).toBeNull();
+	});
+});
+
+describe("getAgeRestrictedVariantIds", () => {
+	it("collects unique variant IDs from age-restriction errors only", () => {
+		expect(
+			getAgeRestrictedVariantIds([
+				{ code: "PRODUCT_AGE_RESTRICTED", variants: ["v1", "v2"] },
+				{ code: "BIRTHDAY_REQUIRED", variants: ["v2", "v3"] },
+				{ code: "INSUFFICIENT_STOCK", variants: ["v4"] },
+			]),
+		).toEqual(["v1", "v2", "v3"]);
+	});
+
+	it("returns an empty list without errors or variants", () => {
+		expect(getAgeRestrictedVariantIds(null)).toEqual([]);
+		expect(getAgeRestrictedVariantIds([{ code: "PRODUCT_AGE_RESTRICTED" }])).toEqual([]);
+	});
+});
+
+describe("getProductNamesForVariants", () => {
+	const line = (variantId: string, name: string) => ({ variant: { id: variantId, product: { name } } });
+
+	it("returns unique product names for the matching variants only", () => {
+		expect(
+			getProductNamesForVariants(
+				[line("v1", "Whisky"), line("v2", "Water"), line("v3", "Whisky"), line("v4", "Cigars")],
+				["v1", "v3", "v4"],
+			),
+		).toEqual(["Whisky", "Cigars"]);
+	});
+
+	it("returns an empty list when nothing matches", () => {
+		expect(getProductNamesForVariants([line("v1", "Water")], ["v9"])).toEqual([]);
+	});
+});
diff --git a/src/checkout/lib/age-restriction-error-message.ts b/src/checkout/lib/age-restriction-error-message.ts
new file mode 100644
index 00000000..facf6f64
--- /dev/null
+++ b/src/checkout/lib/age-restriction-error-message.ts
@@ -0,0 +1,51 @@
+import { findAgeRestrictionError } from "@/lib/age-restriction";
+
+type AgeRestrictionError = { code?: string | null; variants?: ReadonlyArray<string> | null };
+
+type Translate = (
+	key: "productAgeRestricted" | "birthdayRequired" | "ageRestrictedItems",
+	values?: { items: string },
+) => string;
+
+/** Variant IDs that Saleor reported as age-restricted for the customer. */
+export function getAgeRestrictedVariantIds(
+	errors: ReadonlyArray<AgeRestrictionError> | null | undefined,
+): string[] {
+	const ids = new Set<string>();
+	for (const error of errors ?? []) {
+		if (findAgeRestrictionError([error])) {
+			error.variants?.forEach((id) => ids.add(id));
+		}
+	}
+	return [...ids];
+}
+
+/** Unique product names of the checkout lines whose variant is in `variantIds`. */
+export function getProductNamesForVariants(
+	lines: ReadonlyArray<{ variant: { id: string; product: { name: string } } }>,
+	variantIds: ReadonlyArray<string>,
+): string[] {
+	const names = lines
+		.filter((line) => variantIds.includes(line.variant.id))
+		.map((line) => line.variant.product.name);
+	return [...new Set(names)];
+}
+
+/**
+ * Shopper-facing copy for Saleor's age-restriction checkout errors
+ * (`PRODUCT_AGE_RESTRICTED`, `BIRTHDAY_REQUIRED`), or `null` for any other error set.
+ * When `itemNames` is given, the affected products are listed after the message.
+ */
+export function getAgeRestrictionErrorMessage(
+	errors: ReadonlyArray<AgeRestrictionError> | null | undefined,
+	t: Translate,
+	itemNames: ReadonlyArray<string> = [],
+): string | null {
+	const code = findAgeRestrictionError(errors);
+	if (!code) return null;
+
+	const message = code === "PRODUCT_AGE_RESTRICTED" ? t("productAgeRestricted") : t("birthdayRequired");
+	return itemNames.length > 0
+		? `${message} ${t("ageRestrictedItems", { items: itemNames.join(", ") })}`
+		: message;
+}
