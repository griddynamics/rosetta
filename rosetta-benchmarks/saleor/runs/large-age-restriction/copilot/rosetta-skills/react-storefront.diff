diff --git a/src/ui/components/plp/product-card-age-label.test.tsx b/src/ui/components/plp/product-card-age-label.test.tsx
new file mode 100644
index 0000000..49740c4
--- /dev/null
+++ b/src/ui/components/plp/product-card-age-label.test.tsx
@@ -0,0 +1,53 @@
+import { renderToStaticMarkup } from "react-dom/server";
+import { NextIntlClientProvider } from "next-intl";
+import { describe, expect, it, vi } from "vitest";
+import en from "../../../../messages/en.json";
+
+vi.mock("./product-card-link", () => ({
+	ProductCardLink: ({ children, href }: { children: React.ReactNode; href: string }) => (
+		<a href={href}>{children}</a>
+	),
+}));
+vi.mock("@/ui/atoms/saleor-image", () => ({ SaleorImage: () => null }));
+
+const { ProductCardBase } = await import("./product-card-base");
+
+const base = {
+	id: "p1",
+	name: "Whisky",
+	slug: "whisky",
+	price: 10,
+	currency: "USD",
+	image: "/x.png",
+	href: "/en/default/products/whisky",
+};
+
+function render(product: Parameters<typeof ProductCardBase>[0]["product"]) {
+	return renderToStaticMarkup(
+		<NextIntlClientProvider locale="en" messages={en}>
+			<ProductCardBase product={product} />
+		</NextIntlClientProvider>,
+	);
+}
+
+describe("ProductCardBase age label", () => {
+	it.each([16, 18, 21])("shows %i+ on a restricted card", (age) => {
+		const html = render({ ...base, isAgeRestricted: true, ageRestrictionMinimumAge: age });
+		expect(html).toContain('data-testid="age-restriction-badge"');
+		expect(html).toContain(`${age}+`);
+		expect(html).toContain(`aria-label="Age restricted: ${age}+"`);
+	});
+
+	it("shows no label on an unrestricted card", () => {
+		expect(render({ ...base, isAgeRestricted: false, ageRestrictionMinimumAge: 18 })).not.toContain(
+			"age-restriction-badge",
+		);
+		expect(render(base)).not.toContain("age-restriction-badge");
+	});
+
+	it("still renders the restricted card link and name (visibility unchanged)", () => {
+		const html = render({ ...base, isAgeRestricted: true, ageRestrictionMinimumAge: 18 });
+		expect(html).toContain('href="/en/default/products/whisky"');
+		expect(html).toContain("Whisky");
+	});
+});
