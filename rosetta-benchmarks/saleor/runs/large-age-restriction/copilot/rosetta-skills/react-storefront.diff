@@ -0,0 +1,22 @@
+import "server-only";
+
+import { CurrentUserAgeStatusDocument } from "@/gql/graphql";
+import { resolveAgeRestrictionKind, type AgeRestrictionKind } from "@/lib/age-restriction";
+import { hasAuthSession } from "@/lib/auth/has-auth-session";
+import { sessionQuery } from "@/lib/saleor";
+
+/**
+ * Picks the message for a core `AGE_RESTRICTION` rejection. Signed-in customers are asked only for
+ * `birthdayPresent` (owner-only boolean); a failed or null read falls back to the profile message.
+ */
+export async function getAgeRestrictionKind(): Promise<AgeRestrictionKind> {
+	if (!(await hasAuthSession())) {
+		return resolveAgeRestrictionKind({ isAuthenticated: false });
+	}
+
+	const result = await sessionQuery(CurrentUserAgeStatusDocument);
+	return resolveAgeRestrictionKind({
+		isAuthenticated: true,
+		birthdayPresent: result.ok ? result.data.me?.birthdayPresent : null,
+	});
+}
