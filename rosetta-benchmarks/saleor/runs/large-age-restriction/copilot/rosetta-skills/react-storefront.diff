@@ -0,0 +1,60 @@
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+const mutate = vi.fn();
+vi.mock("@/lib/saleor", () => ({ mutate }));
+vi.mock("next/cache", () => ({ refresh: vi.fn() }));
+
+const { updateBirthday } = await import("./actions");
+
+function form(birthday?: string) {
+	const fd = new FormData();
+	if (birthday !== undefined) fd.set("birthday", birthday);
+	return fd;
+}
+
+describe("updateBirthday", () => {
+	beforeEach(() => mutate.mockReset());
+
+	it("sends the date to accountUpdate only (no other fields)", async () => {
+		mutate.mockResolvedValue({ ok: true, data: { accountUpdate: { errors: [] } } });
+
+		await expect(updateBirthday(form("1990-05-17"))).resolves.toEqual({ success: true });
+		expect(mutate.mock.calls[0][1]).toEqual({ variables: { input: { birthday: "1990-05-17" } } });
+	});
+
+	it("clears the birthday with null when the field is empty", async () => {
+		mutate.mockResolvedValue({ ok: true, data: { accountUpdate: { errors: [] } } });
+
+		await updateBirthday(form(""));
+		expect(mutate.mock.calls[0][1]).toEqual({ variables: { input: { birthday: null } } });
+	});
+
+	it("rejects malformed input without calling core", async () => {
+		await expect(updateBirthday(form("1990-02-31"))).resolves.toEqual({
+			success: false,
+			errorKey: "invalidBirthday",
+		});
+		expect(mutate).not.toHaveBeenCalled();
+	});
+
+	it("maps a core birthday field error to a fixed key (future date)", async () => {
+		mutate.mockResolvedValue({
+			ok: true,
+			data: { accountUpdate: { errors: [{ field: "birthday", message: "core text", code: "INVALID" }] } },
+		});
+
+		await expect(updateBirthday(form("2999-01-01"))).resolves.toEqual({
+			success: false,
+			errorKey: "invalidBirthday",
+		});
+	});
+
+	it("does not leak transport error text", async () => {
+		mutate.mockResolvedValue({ ok: false, error: { message: "boom 1990-05-17" } });
+
+		await expect(updateBirthday(form("1990-05-17"))).resolves.toEqual({
+			success: false,
+			errorKey: "updateBirthdayFailed",
+		});
+	});
+});
