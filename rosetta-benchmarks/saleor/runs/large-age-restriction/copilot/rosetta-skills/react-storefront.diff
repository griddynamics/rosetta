+	});
+
+	it("adds the line when core accepts it", async () => {
+		mutate.mockResolvedValue({ ok: true, data: { checkoutLinesAdd: { errors: [] } } });
+
+		await expect(addVariantToCart(input)).resolves.toEqual({ ok: true });
