@@ -0,0 +1,33 @@
+/**
+ * Client-side routing for Saleor's `AGE_RESTRICTION` checkout error.
+ *
+ * Core is authoritative: this module only chooses which generic message and destination to
+ * show once core has rejected a mutation. It never decides eligibility and never handles a
+ * birthday or an age.
+ */
+export const AGE_RESTRICTION_ERROR_CODE = "AGE_RESTRICTION";
+
+export type AgeRestrictionKind = "guest" | "profile" | "ineligible";
+
+export function hasAgeRestrictionError(
+	errors: ReadonlyArray<{ code?: string | null }> | null | undefined,
+): boolean {
+	return Boolean(errors?.some((error) => error.code === AGE_RESTRICTION_ERROR_CODE));
+}
+
+/**
+ * - guest: no session, so sign in.
+ * - profile: signed in and `birthdayPresent` is false (or unknown) — go to account settings.
+ * - ineligible: signed in and `birthdayPresent` is true — a birthday is on file, so the age message.
+ *
+ * `birthdayPresent` is core's owner-only boolean; the birthday itself is never needed here.
+ */
+export function resolveAgeRestrictionKind(input: {
+	isAuthenticated: boolean;
+	birthdayPresent?: boolean | null;
+}): AgeRestrictionKind {
+	if (!input.isAuthenticated) {
+		return "guest";
+	}
+	return input.birthdayPresent === true ? "ineligible" : "profile";
+}
