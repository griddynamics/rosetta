+import { describe, expect, it } from "vitest";
+import { hasAgeRestrictionError, resolveAgeRestrictionKind } from "./age-restriction";
+
+describe("hasAgeRestrictionError", () => {
+	it("detects the core error code", () => {
+		expect(hasAgeRestrictionError([{ code: "INVALID" }, { code: "AGE_RESTRICTION" }])).toBe(true);
+	});
+
+	it("ignores other codes and empty input", () => {
+		expect(hasAgeRestrictionError([{ code: "INVALID" }])).toBe(false);
+		expect(hasAgeRestrictionError([])).toBe(false);
+		expect(hasAgeRestrictionError(null)).toBe(false);
+		expect(hasAgeRestrictionError(undefined)).toBe(false);
+	});
+});
+
+describe("resolveAgeRestrictionKind", () => {
+	it("directs guests to sign in", () => {
+		expect(resolveAgeRestrictionKind({ isAuthenticated: false })).toBe("guest");
+		expect(resolveAgeRestrictionKind({ isAuthenticated: false, birthdayPresent: true })).toBe("guest");
+	});
+
+	it("sends signed-in customers without a birthday to the profile message", () => {
+		expect(resolveAgeRestrictionKind({ isAuthenticated: true, birthdayPresent: false })).toBe("profile");
+	});
+
+	it("falls back to the profile message when presence is unknown", () => {
+		expect(resolveAgeRestrictionKind({ isAuthenticated: true })).toBe("profile");
+		expect(resolveAgeRestrictionKind({ isAuthenticated: true, birthdayPresent: null })).toBe("profile");
+	});
+
+	it("shows the ineligible message when a birthday is on file", () => {
+		expect(resolveAgeRestrictionKind({ isAuthenticated: true, birthdayPresent: true })).toBe("ineligible");
+	});
+});
