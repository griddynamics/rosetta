new file mode 100644
index 0000000..d4ff3ed
--- /dev/null
+++ b/src/ui/components/account/birthday.ts
@@ -0,0 +1,40 @@
+const ISO_DATE = /^(\d{4})-(\d{2})-(\d{2})$/;
+
+export type BirthdayInput = { ok: true; value: string | null } | { ok: false };
+
+/**
+ * Validates a date-only `YYYY-MM-DD` birthday form value. Empty input means "clear" (`null`).
+ * Future-date checks stay with core (Shop-local date) — this only rejects malformed values.
+ */
+export function parseBirthdayInput(raw: string | undefined): BirthdayInput {
+	if (raw === undefined || raw.trim() === "") {
+		return { ok: true, value: null };
+	}
+
+	const match = ISO_DATE.exec(raw);
+	if (!match) {
+		return { ok: false };
+	}
+
+	const [year, month, day] = [Number(match[1]), Number(match[2]), Number(match[3])];
+	const date = new Date(Date.UTC(year, month - 1, day));
+	const isRealDate =
+		date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day;
+
+	return isRealDate && year >= 1900 ? { ok: true, value: raw } : { ok: false };
+}
+
+/** Formats a date-only value without time-zone drift (no local-time `Date` parsing). */
+export function formatBirthday(value: string, intlLocale: string): string {
+	const match = ISO_DATE.exec(value);
+	if (!match) {
+		return value;
+	}
+	const date = new Date(Date.UTC(Number(match[1]), Number(match[2]) - 1, Number(match[3])));
+	return date.toLocaleDateString(intlLocale, {
+		year: "numeric",
+		month: "long",
+		day: "numeric",
+		timeZone: "UTC",
+	});
+}
