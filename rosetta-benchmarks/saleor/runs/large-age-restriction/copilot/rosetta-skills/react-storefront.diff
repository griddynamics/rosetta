+		getAgeRestrictionKind.mockResolvedValue("guest");
+		mutate.mockResolvedValue({
+			ok: true,
+			data: { checkoutLinesAdd: { errors: [{ field: "lines", message: "x", code: "AGE_RESTRICTION" }] } },
