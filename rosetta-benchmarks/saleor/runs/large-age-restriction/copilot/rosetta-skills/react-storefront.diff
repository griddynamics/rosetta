diff --git a/e2e/age-restricted-pdp.spec.ts b/e2e/age-restricted-pdp.spec.ts
new file mode 100644
index 0000000..d275c7b
--- /dev/null
+++ b/e2e/age-restricted-pdp.spec.ts
@@ -0,0 +1,26 @@
+import { expect, test } from "@playwright/test";
+
+/**
+ * Guest routing on an age-restricted product. Needs a product with `isAgeRestricted: true`
+ * in the target catalog; set E2E_AGE_RESTRICTED_PRODUCT_PATH to its PDP path
+ * (for example `/en/default-channel/products/<slug>?variant=<id>`). Skipped otherwise.
+ *
+ * Authenticated eligible/ineligible purchase behavior is decided by core and needs seeded
+ * customers with known birthdays; it is covered by the core API tests, not here.
+ */
+const restrictedProductPath = process.env.E2E_AGE_RESTRICTED_PRODUCT_PATH;
+
+test.describe("age-restricted PDP as guest", () => {
+	test.skip(!restrictedProductPath, "E2E_AGE_RESTRICTED_PRODUCT_PATH is not set");
+
+	test("replaces add-to-bag with a sign-in link", async ({ page }) => {
+		await page.goto(restrictedProductPath as string);
+
+		const signIn = page.getByTestId("age-restricted-sign-in");
+		await expect(signIn).toBeVisible({ timeout: 30_000 });
+		await expect(page.locator("button:not([disabled])", { hasText: /add to (cart|bag)/i })).toHaveCount(0);
+
+		await signIn.click();
+		await expect(page).toHaveURL(/\/login/);
+	});
+});
