@@ -0,0 +1,44 @@
+import "server-only";
+
+import { ShopAgeRestrictionDocument } from "@/gql/graphql";
+import { liveQuery } from "@/lib/saleor";
+
+type AgeRestrictable = { isAgeRestricted?: boolean; ageRestrictionMinimumAge?: number | null };
+
+/**
+ * Shop minimum age, read live (request-memoized) so a policy change shows on the next render and
+ * is never frozen into a cached listing. Called only when a restricted card is present.
+ */
+async function fetchMinimumAge(): Promise<number> {
+	const result = await liveQuery(ShopAgeRestrictionDocument);
+	if (!result.ok) throw new Error(`[age-label] ${result.error.message}`);
+	return result.data.shop.ageRestrictionMinimumAge;
+}
+
+/** `null` when the Shop age cannot be read — cards then render without a label; nothing is hidden. */
+export async function getAgeRestrictionMinimumAge(): Promise<number | null> {
+	try {
+		return await fetchMinimumAge();
+	} catch {
+		return null;
+	}
+}
+
+/** Pure: stamp `N` on restricted items only. Unrestricted items are returned untouched. */
+export function applyAgeRestrictionLabel<T extends AgeRestrictable>(
+	items: readonly T[],
+	minimumAge: number | null,
+): T[] {
+	return items.map((item) =>
+		item.isAgeRestricted && minimumAge != null ? { ...item, ageRestrictionMinimumAge: minimumAge } : item,
+	);
+}
+
+/**
+ * Add the current Shop minimum age to restricted cards. Runs outside cached listing/featured data and
+ * only queries the Shop when at least one card is restricted. Never filters or reorders items.
+ */
+export async function withAgeRestrictionLabel<T extends AgeRestrictable>(items: readonly T[]): Promise<T[]> {
+	if (!items.some((item) => item.isAgeRestricted)) return [...items];
+	return applyAgeRestrictionLabel(items, await getAgeRestrictionMinimumAge());
+}
