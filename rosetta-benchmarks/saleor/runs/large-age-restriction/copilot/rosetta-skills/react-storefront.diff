+/**
+ * Owner-only birthday edit. An empty value clears it. The date is never logged and is
+ * never echoed in the result — failures return fixed translation keys, not core messages.
+ */
+export async function updateBirthday(formData: FormData): Promise<AccountActionResult> {
+	const parsed = parseBirthdayInput(getFormStringOptional(formData, "birthday"));
+	if (!parsed.ok) {
+		return { success: false, errorKey: "invalidBirthday" };
+	}
+
+	const result = await mutate(AccountUpdateDocument, {
+		variables: { input: { birthday: parsed.value } },
+	});
+
+	if (!result.ok) {
+		return { success: false, errorKey: "updateBirthdayFailed" };
+	}
+
+	const errors = result.data.accountUpdate?.errors;
+	if (errors?.length) {
+		return {
+			success: false,
+			errorKey: errors.some((error) => error.field === "birthday")
+				? "invalidBirthday"
+				: "updateBirthdayFailed",
+		};
+	}
+
+	revalidateAccountLayout();
+	return { success: true };
+}
