+mutation update($id: ID, $lines: [CheckoutLineUpdateInput!]!) {
+  checkoutLinesUpdate(id: $id, lines: $lines) {
+    checkout { lines { quantity } }
+    errors { field code message variants lines }
+  }
+}
+"""
+
+CHECKOUT_CREATE = """
+mutation create($input: CheckoutCreateInput!) {
+  checkoutCreate(input: $input) {
+    checkout { token }
+    errors { field code message variants lines }
+  }
+}
+"""
+
+CHECKOUT_COMPLETE = """
+mutation complete($id: ID) {
+  checkoutComplete(id: $id, redirectUrl: "https://www.example.com") {
+    order { id }
+    errors { field code message variants lines }
+  }
+}
+"""
+
+ORDER_CREATE_FROM_CHECKOUT = """
+mutation orderCreate($id: ID!) {
+  orderCreateFromCheckout(id: $id) {
+    order { id }
+    errors { field code message }
+  }
+}
+"""
+
+
+def _restrict(variant_product):
+    variant_product.is_age_restricted = True
+    variant_product.save(update_fields=["is_age_restricted"])
+
+
+def _set_birthday(user, birthday):
+    user.birthday = birthday
+    user.save(update_fields=["birthday"])
+
+
+def _assert_age_error(data):
+    assert len(data["errors"]) == 1
+    error = data["errors"][0]
+    assert error["code"] == AGE_RESTRICTION
+    assert error["field"] == "lines"
+    # generic message: no product, variant, age or birthday details
+    assert error["variants"] is None
+    assert error["lines"] is None
+    assert "restricted" in error["message"]
+
+
