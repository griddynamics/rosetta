diff --git a/saleor/graphql/shop/tests/mutations/test_shop_age_policy.py b/saleor/graphql/shop/tests/mutations/test_shop_age_policy.py
new file mode 100644
index 0000000..249e663
--- /dev/null
+++ b/saleor/graphql/shop/tests/mutations/test_shop_age_policy.py
@@ -0,0 +1,220 @@
+import pytest
+
+from .....core.error_codes import ShopErrorCode
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+UPDATE_AGE_POLICY = """
+    mutation updateSettings($input: ShopSettingsInput!) {
+        shopSettingsUpdate(input: $input) {
+            shop { minimumAge timeZone }
+            errors { field code message }
+        }
+    }
+"""
+
+QUERY_AGE_POLICY = """
+    query { shop { minimumAge timeZone } }
+"""
+
+
+def test_shop_age_policy_defaults(staff_api_client, permission_manage_settings):
+    # when
+    response = staff_api_client.post_graphql(
+        QUERY_AGE_POLICY, permissions=[permission_manage_settings]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shop"]
+    assert data == {"minimumAge": 18, "timeZone": "UTC"}
+
+
+@pytest.mark.parametrize("minimum_age", [1, 18, 21, 120])
+def test_shop_settings_update_accepts_valid_minimum_age(
+    minimum_age, staff_api_client, permission_manage_settings, site_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_AGE_POLICY,
+        {"input": {"minimumAge": minimum_age}},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert not data["errors"]
+    assert data["shop"]["minimumAge"] == minimum_age
+    site_settings.refresh_from_db()
+    assert site_settings.minimum_age == minimum_age
+
+
+@pytest.mark.parametrize("minimum_age", [0, 121, -5])
+def test_shop_settings_update_rejects_invalid_minimum_age(
+    minimum_age, staff_api_client, permission_manage_settings, site_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_AGE_POLICY,
+        {"input": {"minimumAge": minimum_age}},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert len(data["errors"]) == 1
+    assert data["errors"][0]["field"] == "minimumAge"
+    assert data["errors"][0]["code"] == ShopErrorCode.INVALID.name
+    site_settings.refresh_from_db()
+    assert site_settings.minimum_age == 18
+
+
+def test_shop_settings_update_rejects_null_minimum_age(
+    staff_api_client, permission_manage_settings, site_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_AGE_POLICY,
+        {"input": {"minimumAge": None}},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert data["errors"][0]["field"] == "minimumAge"
+    assert data["errors"][0]["code"] == ShopErrorCode.INVALID.name
+
+
+@pytest.mark.parametrize("time_zone", ["UTC", "Europe/Warsaw", "America/New_York"])
+def test_shop_settings_update_accepts_iana_time_zone(
+    time_zone, staff_api_client, permission_manage_settings, site_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_AGE_POLICY,
+        {"input": {"timeZone": time_zone}},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert not data["errors"]
+    assert data["shop"]["timeZone"] == time_zone
+    site_settings.refresh_from_db()
+    assert site_settings.time_zone == time_zone
+
+
+@pytest.mark.parametrize("time_zone", ["", "Mars/Olympus", "../etc/passwd", "EST5EDT "])
+def test_shop_settings_update_rejects_unknown_time_zone(
+    time_zone, staff_api_client, permission_manage_settings, site_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_AGE_POLICY,
+        {"input": {"timeZone": time_zone}},
+        permissions=[permission_manage_settings],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert len(data["errors"]) == 1
+    assert data["errors"][0]["field"] == "timeZone"
+    assert data["errors"][0]["code"] == ShopErrorCode.INVALID.name
+    site_settings.refresh_from_db()
+    assert site_settings.time_zone == "UTC"
+
+
+def test_shop_settings_update_age_policy_requires_manage_settings(
+    staff_api_client, site_settings
+):
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_AGE_POLICY, {"input": {"minimumAge": 21}}
+    )
+
+    # then
+    assert_no_permission(response)
+    site_settings.refresh_from_db()
+    assert site_settings.minimum_age == 18
+
+
+def test_shop_settings_update_age_policy_denied_for_customer(
+    user_api_client, site_settings
+):
+    # when
+    response = user_api_client.post_graphql(
+        UPDATE_AGE_POLICY, {"input": {"timeZone": "Europe/Warsaw"}}
+    )
+
+    # then
+    assert_no_permission(response)
+
+
+@pytest.mark.parametrize("client_name", ["staff", "customer", "anonymous"])
+def test_shop_age_policy_fields_hidden_without_manage_settings(
+    client_name, staff_api_client, user_api_client, api_client
+):
+    # given
+    client = {
+        "staff": staff_api_client,
+        "customer": user_api_client,
+        "anonymous": api_client,
+    }[client_name]
+
+    # when
+    response = client.post_graphql(QUERY_AGE_POLICY)
+
+    # then
+    assert_no_permission(response)
+
+
+QUERY_PUBLIC_MINIMUM_AGE = """
+    query { shop { ageRestrictionMinimumAge } }
+"""
+
+
+@pytest.mark.parametrize("client_name", ["staff", "customer", "anonymous", "app"])
+def test_age_restriction_minimum_age_is_public_and_follows_setting(
+    client_name,
+    staff_api_client,
+    user_api_client,
+    api_client,
+    app_api_client,
+    site_settings,
+):
+    # given
+    client = {
+        "staff": staff_api_client,
+        "customer": user_api_client,
+        "anonymous": api_client,
+        "app": app_api_client,
+    }[client_name]
+    site_settings.minimum_age = 21
+    site_settings.save(update_fields=["minimum_age"])
+
+    # when
+    response = client.post_graphql(QUERY_PUBLIC_MINIMUM_AGE)
+
+    # then
+    data = get_graphql_content(response)["data"]["shop"]
+    assert data == {"ageRestrictionMinimumAge": 21}
+
+
+def test_age_restriction_minimum_age_default_is_18(api_client, site_settings):
+    # when
+    response = api_client.post_graphql(QUERY_PUBLIC_MINIMUM_AGE)
+
+    # then
+    assert get_graphql_content(response)["data"]["shop"] == {
+        "ageRestrictionMinimumAge": 18
+    }
+
+
+def test_public_field_does_not_open_editable_setting_or_time_zone(
+    api_client, site_settings
+):
+    # when: the editable fields keep MANAGE_SETTINGS
+    response = api_client.post_graphql(
+        "query { shop { ageRestrictionMinimumAge minimumAge timeZone } }"
+    )
+
+    # then
+    assert_no_permission(response)
