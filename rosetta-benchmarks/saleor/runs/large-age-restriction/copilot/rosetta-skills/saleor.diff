+def _birthday_audit_event(
+    *, event_type: str, customer_uuid: UUID, actor: User | None
+) -> CustomerEvent:
+    # Privacy: metadata only. `user` stays empty so the record never cascades with
+    # the customer; no birthday, age, name or email is stored.
+    return CustomerEvent.objects.create(
+        user=None,
+        actor=actor,
+        app=None,
+        order=None,
+        type=event_type,
+        customer_uuid=customer_uuid,
+        parameters={},
+    )
+
+
+def customer_birthday_read_event(
+    *, customer_uuid: UUID, actor: User | None
+) -> CustomerEvent:
+    return _birthday_audit_event(
+        event_type=CustomerEvents.BIRTHDAY_READ,
+        customer_uuid=customer_uuid,
+        actor=actor,
+    )
+
+
+def customer_birthday_changed_event(
+    *, customer_uuid: UUID, actor: User | None
+) -> CustomerEvent:
+    return _birthday_audit_event(
+        event_type=CustomerEvents.BIRTHDAY_CHANGED,
+        customer_uuid=customer_uuid,
+        actor=actor,
+    )
