+import datetime
+import json
+
+import graphene
+import pytest
+
+from .....account import CustomerEvents
+from .....account.models import CustomerEvent, User
+from ....tests.utils import assert_no_permission, get_graphql_content
+
+# Reserved synthetic birthday. It must never appear in events, errors or logs.
+BIRTHDAY = datetime.date(1990, 5, 17)
+BIRTHDAY_ISO = BIRTHDAY.isoformat()
+
+QUERY_USER_BIRTHDAY = """
+query user($id: ID!) {
+  user(id: $id) {
+    birthday
+    isAgeEligible
+  }
+}
+"""
+
+QUERY_USER_BIRTHDAY_ALIASED = """
+query user($id: ID!) {
+  first: user(id: $id) { birthday isAgeEligible }
+  second: user(id: $id) { birthday isAgeEligible }
+}
+"""
+
+QUERY_ME_BIRTHDAY = """
+query {
+  me {
+    birthday
+    isAgeEligible
+  }
+}
+"""
+
+QUERY_USER_EVENTS = """
+query user($id: ID!) {
+  user(id: $id) {
+    events {
+      type
+      user { email }
+      message
+      count
+    }
+  }
+}
+"""
+
+
+@pytest.fixture
+def customer_with_birthday(customer_user):
+    customer_user.birthday = BIRTHDAY
+    customer_user.save(update_fields=["birthday"])
+    return customer_user
+
+
+def _user_id(user):
+    return graphene.Node.to_global_id("User", user.pk)
+
+
+def _audit_events():
+    return CustomerEvent.objects.filter(type__in=CustomerEvents.BIRTHDAY_AUDIT_TYPES)
+
+
+def test_owner_reads_own_birthday_and_eligibility_without_audit(
+    user_api_client, customer_with_birthday
+):
+    # when
+    response = user_api_client.post_graphql(QUERY_ME_BIRTHDAY)
+
+    # then
+    data = get_graphql_content(response)["data"]["me"]
+    assert data["birthday"] == BIRTHDAY_ISO
+    assert data["isAgeEligible"] is True
+    assert not _audit_events().exists()
+
+
+def test_owner_without_birthday_is_not_eligible(user_api_client, customer_user):
+    # when
+    response = user_api_client.post_graphql(QUERY_ME_BIRTHDAY)
+
+    # then
+    data = get_graphql_content(response)["data"]["me"]
+    assert data["birthday"] is None
+    assert data["isAgeEligible"] is False
+
+
+def test_owner_underage_is_not_eligible(user_api_client, customer_user):
+    # given
+    customer_user.birthday = datetime.date(2999, 1, 1)
+    customer_user.save(update_fields=["birthday"])
+
+    # when
+    response = user_api_client.post_graphql(QUERY_ME_BIRTHDAY)
+
+    # then
+    assert get_graphql_content(response)["data"]["me"]["isAgeEligible"] is False
+
+
+def test_superuser_reads_birthday_and_audit_is_recorded_once_per_request(
+    superuser_api_client, customer_with_birthday
+):
+    # when: two aliases resolve both fields of the same customer in one request
+    response = superuser_api_client.post_graphql(
+        QUERY_USER_BIRTHDAY_ALIASED, {"id": _user_id(customer_with_birthday)}
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]
+    for alias in ("first", "second"):
+        assert data[alias]["birthday"] == BIRTHDAY_ISO
+        assert data[alias]["isAgeEligible"] is True
+    events = list(_audit_events())
+    assert len(events) == 1
+    event = events[0]
+    assert event.type == CustomerEvents.BIRTHDAY_READ
+    assert event.customer_uuid == customer_with_birthday.uuid
+    assert event.actor == superuser_api_client.user
+    assert event.user is None
+    assert event.app is None
+    assert event.parameters == {}
+
