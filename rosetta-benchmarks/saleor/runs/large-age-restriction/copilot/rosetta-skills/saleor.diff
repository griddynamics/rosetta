+    assert not data[0]["errors"]
+    assert data[0]["product"]["isAgeRestricted"] is True
+    assert Product.objects.get(name="Bulk restricted").is_age_restricted is True
+
+
+def test_age_restricted_flag_is_public_for_storefront(api_client, product, channel_USD):
+    # given
