+import datetime
+
+import graphene
+import pytest
+from django.utils import timezone
+
+from .....order import OrderStatus
+from .....order.error_codes import OrderErrorCode
+from .....order.models import Order
+from ....tests.utils import get_graphql_content
+from ...bulk_mutations.order_bulk_create import StockUpdatePolicyEnum
+from .test_order_bulk_create import (  # noqa: F401
+    ORDER_BULK_CREATE,
+    order_bulk_input,
+)
+
+# Synthetic data only. Draft fixtures depend on the real clock (product
+# availability), so birthdays are computed relative to the Shop-local date (UTC).
+
+
+def _today():
+    return timezone.now().date()
+
+
+def _years_ago(years, extra_days=0):
+    today = _today()
+    try:
+        date = today.replace(year=today.year - years)
+    except ValueError:  # Feb 29
+        date = today.replace(year=today.year - years, day=28)
+    return date + datetime.timedelta(days=extra_days)
+
+
+DRAFT_ORDER_COMPLETE = """
+    mutation draftComplete($id: ID!) {
+        draftOrderComplete(id: $id) {
+            errors { field code message variants orderLines }
+            order { status }
+        }
+    }
+"""
+
+
+def _restrict_order_products(order):
+    for line in order.lines.all():
+        product = line.variant.product
+        product.is_age_restricted = True
+        product.save(update_fields=["is_age_restricted"])
+
+
+def _set_birthday(user, birthday):
+    user.birthday = birthday
+    user.save(update_fields=["birthday"])
+
+
+def _complete(client, order):
+    return client.post_graphql(
+        DRAFT_ORDER_COMPLETE, {"id": graphene.Node.to_global_id("Order", order.pk)}
+    )
+
+
+def _assert_age_error(response, order):
+    data = get_graphql_content(response)["data"]["draftOrderComplete"]
+    assert len(data["errors"]) == 1
+    error = data["errors"][0]
+    assert error["code"] == OrderErrorCode.AGE_RESTRICTION.name
+    assert error["field"] == "lines"
+    assert error["variants"] is None
+    assert error["orderLines"] is None
+    assert data["order"] is None
+    order.refresh_from_db()
+    assert order.status == OrderStatus.DRAFT
+
+
+@pytest.fixture
+def manage_orders_staff(staff_api_client, permission_group_manage_orders):
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    return staff_api_client
+
+
+@pytest.mark.parametrize("birthday_factory", [lambda: None, lambda: _years_ago(18, 1)])
+def test_draft_complete_linked_missing_birthday_or_underage_is_blocked(
+    birthday_factory, manage_orders_staff, draft_order, customer_user
+):
+    # given
+    draft_order.user = customer_user
+    draft_order.save(update_fields=["user"])
+    _set_birthday(customer_user, birthday_factory())
+    _restrict_order_products(draft_order)
+
+    # when
+    response = _complete(manage_orders_staff, draft_order)
+
+    # then
+    _assert_age_error(response, draft_order)
+
+
+@pytest.mark.parametrize(
+    "birthday_factory", [lambda: _years_ago(18), lambda: _years_ago(40)]
+)
+def test_draft_complete_linked_exact_age_and_overage_completes(
+    birthday_factory, manage_orders_staff, draft_order, customer_user
+):
+    # given
+    draft_order.user = customer_user
+    draft_order.save(update_fields=["user"])
+    _set_birthday(customer_user, birthday_factory())
+    _restrict_order_products(draft_order)
+
+    # when
+    response = _complete(manage_orders_staff, draft_order)
+
+    # then
+    data = get_graphql_content(response)["data"]["draftOrderComplete"]
+    assert not data["errors"]
+    draft_order.refresh_from_db()
+    assert draft_order.status != OrderStatus.DRAFT
+
+
+def test_draft_complete_without_linked_customer_is_allowed(
+    manage_orders_staff, draft_order
+):
+    # given
+    draft_order.user = None
+    draft_order.user_email = ""
+    draft_order.save(update_fields=["user", "user_email"])
+    _restrict_order_products(draft_order)
+
+    # when
+    response = _complete(manage_orders_staff, draft_order)
+
+    # then
+    assert not get_graphql_content(response)["data"]["draftOrderComplete"]["errors"]
+    draft_order.refresh_from_db()
+    assert draft_order.status != OrderStatus.DRAFT
+
+
+def test_draft_complete_unrestricted_products_unchanged_for_ineligible_customer(
+    manage_orders_staff, draft_order, customer_user
+):
+    # given
+    draft_order.user = customer_user
+    draft_order.save(update_fields=["user"])
+    assert customer_user.birthday is None
+
+    # when
+    response = _complete(manage_orders_staff, draft_order)
+
+    # then
+    assert not get_graphql_content(response)["data"]["draftOrderComplete"]["errors"]
+
+
+def test_draft_complete_app_has_no_bypass(
+    app_api_client, permission_manage_orders, draft_order, customer_user
+):
+    # given
+    app_api_client.app.permissions.add(permission_manage_orders)
+    draft_order.user = customer_user
+    draft_order.save(update_fields=["user"])
+    _set_birthday(customer_user, _years_ago(18, 1))
+    _restrict_order_products(draft_order)
+
+    # when
+    response = _complete(app_api_client, draft_order)
+
+    # then
+    _assert_age_error(response, draft_order)
+
+
+def test_draft_complete_superuser_has_no_bypass(
+    superuser_api_client, permission_group_manage_orders, draft_order, customer_user
+):
+    # given
+    permission_group_manage_orders.user_set.add(superuser_api_client.user)
+    draft_order.user = customer_user
+    draft_order.save(update_fields=["user"])
+    _restrict_order_products(draft_order)
+
+    # when
+    response = _complete(superuser_api_client, draft_order)
+
+    # then
+    _assert_age_error(response, draft_order)
+
+
+def test_order_bulk_create_is_exempt_for_restricted_products_and_ineligible_customer(
+    staff_api_client,
+    permission_manage_orders,
+    permission_manage_orders_import,
+    permission_manage_users,
+    order_bulk_input,  # noqa: F811
+    variant,
+    customer_user,
+):
+    # given: historical import, customer has no birthday, product is restricted
+    assert customer_user.birthday is None
+    variant.product.is_age_restricted = True
+    variant.product.save(update_fields=["is_age_restricted"])
+    order = order_bulk_input
+    staff_api_client.user.user_permissions.add(
+        permission_manage_orders_import,
+        permission_manage_orders,
+        permission_manage_users,
+    )
+    orders_count = Order.objects.count()
+
+    # when
+    response = staff_api_client.post_graphql(
+        ORDER_BULK_CREATE,
+        {"orders": [order], "stockUpdatePolicy": StockUpdatePolicyEnum.SKIP.name},
+    )
+
+    # then
+    content = get_graphql_content(response)
+    assert content["data"]["orderBulkCreate"]["count"] == 1
+    assert not content["data"]["orderBulkCreate"]["results"][0]["errors"]
+    assert Order.objects.count() == orders_count + 1
