index 0000000..79cac25
--- /dev/null
+++ b/saleor/account/age_restrictions.py
@@ -0,0 +1,176 @@
+"""Single source of truth for the age-restriction policy.
+
+Pure domain logic: no GraphQL or UI dependencies. Every enforcement point
+(checkout lines, checkout completion, draft order completion) and the
+`User.isAgeEligible` resolver must go through this module.
+
+Privacy: the birthday is personal data. Nothing here logs, formats or puts the
+birthday, the calculated age or the failed product into an exception message.
+"""
+
+import datetime
+from collections.abc import Callable, Iterable
+from typing import TYPE_CHECKING
+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+from django.conf import settings
+from django.core.exceptions import ValidationError
+from django.utils import timezone
+
+from ..site import DEFAULT_TIME_ZONE
+
+if TYPE_CHECKING:
+    from ..site.models import SiteSettings
+    from .models import User
+
+AGE_RESTRICTION_MESSAGE = "This purchase is restricted to customers of eligible age."
+
+
+def get_current_site_settings() -> "SiteSettings":
+    """Read the Shop policy from the writer, bypassing the process-wide site cache.
+
+    Completion is authoritative, so it must see a policy change immediately.
+    """
+    from django.contrib.sites.models import Site
+
+    from ..site.models import SiteSettings
+
+    site = Site.objects.get_current()
+    return SiteSettings.objects.using(settings.DATABASE_CONNECTION_DEFAULT_NAME).get(
+        site_id=site.pk
+    )
+
+
+def build_age_restriction_error(error_code: str, field: str = "lines"):
+    """Typed, generic validation error: no birthday, age or product details."""
+    return ValidationError(
+        {field: ValidationError(AGE_RESTRICTION_MESSAGE, code=error_code)}
+    )
+
+
+def get_shop_today(
+    time_zone: str, now: datetime.datetime | None = None
+) -> datetime.date:
+    """Return the current calendar date in the Shop's IANA time zone."""
+    now = now or timezone.now()
+    try:
+        zone = ZoneInfo(time_zone)
+    except (ZoneInfoNotFoundError, ValueError, OSError):
+        # never fail a purchase because of a corrupted setting
+        zone = ZoneInfo(DEFAULT_TIME_ZONE)
+    return now.astimezone(zone).date()
+
+
+def get_anniversary(birthday: datetime.date, year: int) -> datetime.date:
+    """Return the date in `year` on which the birthday is celebrated.
+
+    A Feb 29 birthday is celebrated on Mar 1 in non-leap years.
+    """
+    try:
+        return birthday.replace(year=year)
+    except ValueError:
+        return datetime.date(year, 3, 1)
+
+
+def has_reached_age(
+    birthday: datetime.date, today: datetime.date, minimum_age: int
+) -> bool:
+    """Date-only check that the person has completed `minimum_age` years."""
+    try:
+        reached_on = get_anniversary(birthday, birthday.year + minimum_age)
+    except ValueError:  # year beyond date range, cannot have been reached
+        return False
+    return today >= reached_on
+
+
+def is_birthday_in_future(birthday: datetime.date, site_settings: "SiteSettings"):
+    return birthday > get_shop_today(site_settings.time_zone)
+
+
+def is_age_eligible(
+    birthday: datetime.date | None,
+    site_settings: "SiteSettings",
+    now: datetime.datetime | None = None,
+) -> bool:
+    """Return True only when a birthday exists and the Shop minimum age is reached."""
+    if birthday is None:
+        return False
+    today = get_shop_today(site_settings.time_zone, now)
+    return has_reached_age(birthday, today, site_settings.minimum_age)
+
+
+def is_user_age_eligible(
+    user: "User | None",
+    site_settings: "SiteSettings",
+    now: datetime.datetime | None = None,
+) -> bool:
+    """Eligibility of a customer; a guest (`None`) is never eligible."""
+    if user is None or not getattr(user, "pk", None):
+        return False
+    return is_age_eligible(user.birthday, site_settings, now)
+
+
+def has_age_restricted_variants(
+    variant_ids: Iterable[int],
+    database_connection_name: str = settings.DATABASE_CONNECTION_DEFAULT_NAME,
+) -> bool:
+    from ..product.models import ProductVariant
+
+    variant_ids = list(variant_ids)
+    if not variant_ids:
+        return False
+    return (
+        ProductVariant.objects.using(database_connection_name)
+        .filter(pk__in=variant_ids, product__is_age_restricted=True)
+        .exists()
+    )
+
+
+def has_age_restricted_checkout_lines(
+    checkout_pk,
+    database_connection_name: str = settings.DATABASE_CONNECTION_DEFAULT_NAME,
+) -> bool:
+    from ..checkout.models import CheckoutLine
+
+    return (
+        CheckoutLine.objects.using(database_connection_name)
+        .filter(checkout_id=checkout_pk, variant__product__is_age_restricted=True)
+        .exists()
+    )
+
+
+def ensure_age_eligibility(
+    *,
+    user: "User | None",
+    site_settings: "SiteSettings",
+    has_restricted_products: bool,
+    error_factory: Callable[[], Exception],
+) -> None:
+    """Return only when no restricted product is present or the customer is eligible.
+
+    Raises the exception built by the caller's `error_factory` otherwise, so each
+    API surface keeps its own typed error. The error must stay generic.
+    """
+    if not has_restricted_products:
+        return
+    if is_user_age_eligible(user, site_settings):
+        return
+    raise error_factory()
+
+
+def ensure_variants_age_eligibility(
+    *,
+    user: "User | None",
+    variant_ids: Iterable[int],
+    site_settings: "SiteSettings",
+    error_factory: Callable[[], Exception],
+    database_connection_name: str = settings.DATABASE_CONNECTION_DEFAULT_NAME,
+) -> None:
+    ensure_age_eligibility(
+        user=user,
+        site_settings=site_settings,
+        has_restricted_products=has_age_restricted_variants(
+            variant_ids, database_connection_name
+        ),
+        error_factory=error_factory,
+    )
