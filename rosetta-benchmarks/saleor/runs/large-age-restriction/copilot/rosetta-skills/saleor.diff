+    variables = {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "category": graphene.Node.to_global_id("Category", category.pk),
+            "name": "Plain product",
+        }
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CREATE_PRODUCT, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["isAgeRestricted"] is False
+
+
+def test_product_create_with_age_restriction(
+    staff_api_client, permission_manage_products, product_type, category
+):
+    # given
+    variables = {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "category": graphene.Node.to_global_id("Category", category.pk),
+            "name": "Restricted product",
+            "isAgeRestricted": True,
+        }
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CREATE_PRODUCT, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["isAgeRestricted"] is True
+    assert Product.objects.get(name="Restricted product").is_age_restricted is True
+
+
+def test_product_update_sets_and_clears_age_restriction(
+    staff_api_client, permission_manage_products, product
+):
+    # given
+    product_id = graphene.Node.to_global_id("Product", product.pk)
+
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_PRODUCT,
+        {"id": product_id, "input": {"isAgeRestricted": True}},
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert data["product"]["isAgeRestricted"] is True
+    product.refresh_from_db()
+    assert product.is_age_restricted is True
+
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_PRODUCT, {"id": product_id, "input": {"isAgeRestricted": False}}
+    )
+
+    # then
+    assert (
+        get_graphql_content(response)["data"]["productUpdate"]["product"][
+            "isAgeRestricted"
+        ]
+        is False
+    )
+    product.refresh_from_db()
+    assert product.is_age_restricted is False
+
+
+def test_product_update_without_flag_keeps_restriction(
+    staff_api_client, permission_manage_products, product
+):
