+from freezegun import freeze_time
+
+from ......account import CustomerEvents
+from ......account.error_codes import AccountErrorCode
+from ......account.models import CustomerEvent
+from .....tests.utils import (
+    assert_no_permission,
+    get_graphql_content,
+    get_graphql_content_from_response,
+)
+
+# Reserved synthetic birthdays. They must never appear in events or errors.
+BIRTHDAY = datetime.date(1990, 5, 17)
+OTHER_BIRTHDAY = datetime.date(1985, 11, 3)
+
+ACCOUNT_UPDATE_BIRTHDAY = """
+    mutation accountUpdate($input: AccountInput!, $customerId: ID) {
+        accountUpdate(input: $input, customerId: $customerId) {
+            errors { field code message }
+            user { birthday isAgeEligible }
+        }
+    }
+"""
+
+CUSTOMER_BIRTHDAY_UPDATE = """
+    mutation customerBirthdayUpdate($id: ID!, $birthday: Date) {
+        customerBirthdayUpdate(id: $id, birthday: $birthday) {
+            errors { field code message }
+            user { birthday }
+        }
+    }
+"""
+
+
+def _audit_events():
+    return CustomerEvent.objects.filter(type__in=CustomerEvents.BIRTHDAY_AUDIT_TYPES)
+
+
+def _assert_no_birthday_in_events():
+    serialized = json.dumps(list(CustomerEvent.objects.values()), default=str)
+    assert BIRTHDAY.isoformat() not in serialized
+    assert OTHER_BIRTHDAY.isoformat() not in serialized
+
+
+def test_owner_sets_replaces_and_clears_birthday(user_api_client, customer_user):
+    # when: set
+    response = user_api_client.post_graphql(
+        ACCOUNT_UPDATE_BIRTHDAY, {"input": {"birthday": BIRTHDAY.isoformat()}}
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+    assert not data["errors"]
+    assert data["user"] == {"birthday": BIRTHDAY.isoformat(), "isAgeEligible": True}
+    customer_user.refresh_from_db()
+    assert customer_user.birthday == BIRTHDAY
+
+    # when: replace
+    response = user_api_client.post_graphql(
+        ACCOUNT_UPDATE_BIRTHDAY, {"input": {"birthday": OTHER_BIRTHDAY.isoformat()}}
+    )
+
+    # then
+    assert not get_graphql_content(response)["data"]["accountUpdate"]["errors"]
+    customer_user.refresh_from_db()
+    assert customer_user.birthday == OTHER_BIRTHDAY
+
+    # when: clear
+    response = user_api_client.post_graphql(
+        ACCOUNT_UPDATE_BIRTHDAY, {"input": {"birthday": None}}
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+    assert data["user"] == {"birthday": None, "isAgeEligible": False}
+    customer_user.refresh_from_db()
+    assert customer_user.birthday is None
+
+    events = list(_audit_events())
+    assert [e.type for e in events] == [CustomerEvents.BIRTHDAY_CHANGED] * 3
+    for event in events:
+        assert event.customer_uuid == customer_user.uuid
+        assert event.actor == customer_user
+        assert event.user is None
+        assert event.parameters == {}
+    _assert_no_birthday_in_events()
+
+
