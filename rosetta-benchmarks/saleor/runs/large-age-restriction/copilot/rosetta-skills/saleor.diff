index 0000000..0b2ac14
--- /dev/null
+++ b/saleor/account/tests/test_age_restrictions.py
@@ -0,0 +1,270 @@
+import datetime
+from types import SimpleNamespace
+
+import pytest
+from django.core.exceptions import ValidationError
+
+from ...site.models import SiteSettings
+from ..age_restrictions import (
+    AGE_RESTRICTION_MESSAGE,
+    build_age_restriction_error,
+    ensure_age_eligibility,
+    ensure_variants_age_eligibility,
+    get_shop_today,
+    has_reached_age,
+    is_age_eligible,
+    is_birthday_in_future,
+    is_user_age_eligible,
+)
+
+# Synthetic data only.
+UTC = datetime.UTC
+
+
+def _settings(minimum_age=18, time_zone="UTC"):
+    return SimpleNamespace(minimum_age=minimum_age, time_zone=time_zone)
+
+
+def _utc(year, month, day, hour=12, minute=0):
+    return datetime.datetime(year, month, day, hour, minute, tzinfo=UTC)
+
+
+def test_exact_minimum_age_today_is_eligible():
+    # given
+    today = datetime.date(2024, 6, 15)
+
+    # then
+    assert has_reached_age(datetime.date(2006, 6, 15), today, 18) is True
+
+
+def test_one_day_before_minimum_age_is_not_eligible():
+    assert (
+        has_reached_age(datetime.date(2006, 6, 16), datetime.date(2024, 6, 15), 18)
+        is False
+    )
+
+
+def test_overage_is_eligible():
+    assert (
+        has_reached_age(datetime.date(1980, 1, 1), datetime.date(2024, 6, 15), 18)
+        is True
+    )
+
+
+@pytest.mark.parametrize(
+    ("today", "expected"),
+    [
+        (datetime.date(2018, 2, 28), False),
+        (datetime.date(2018, 3, 1), True),  # non-leap year: reached on Mar 1
+        (datetime.date(2018, 3, 2), True),
+    ],
+)
+def test_feb_29_birthday_reaches_age_on_mar_1_in_non_leap_year(today, expected):
+    # given
+    birthday = datetime.date(2000, 2, 29)
+
+    # then
+    assert has_reached_age(birthday, today, 18) is expected
+
+
+@pytest.mark.parametrize(
+    ("today", "expected"),
+    [
+        (datetime.date(2020, 2, 28), False),
+        (datetime.date(2020, 2, 29), True),  # leap year: reached on Feb 29
+    ],
+)
+def test_feb_29_birthday_reaches_age_on_feb_29_in_leap_year(today, expected):
+    assert has_reached_age(datetime.date(2000, 2, 29), today, 20) is expected
+
+
+@pytest.mark.parametrize("minimum_age", [1, 18, 120])
+def test_boundary_minimum_ages(minimum_age):
+    # given
+    today = datetime.date(2024, 6, 15)
+    exact = datetime.date(2024 - minimum_age, 6, 15)
+    younger = datetime.date(2024 - minimum_age, 6, 16)
+
+    # then
+    assert has_reached_age(exact, today, minimum_age) is True
+    assert has_reached_age(younger, today, minimum_age) is False
+
+
+def test_missing_birthday_is_not_eligible():
+    assert is_age_eligible(None, _settings(), _utc(2024, 6, 15)) is False
+
+
+def test_shop_midnight_in_non_utc_zone_decides_the_date():
+    # given
+    # 2024-06-14 23:30 UTC is already 2024-06-15 in Pacific/Auckland (UTC+12).
+    now = _utc(2024, 6, 14, 23, 30)
+    birthday = datetime.date(2006, 6, 15)
+
+    # then
+    assert get_shop_today("Pacific/Auckland", now) == datetime.date(2024, 6, 15)
+    assert get_shop_today("UTC", now) == datetime.date(2024, 6, 14)
+    assert is_age_eligible(birthday, _settings(time_zone="Pacific/Auckland"), now)
+    assert not is_age_eligible(birthday, _settings(time_zone="UTC"), now)
+
+
+def test_dst_observing_zone_uses_local_date_around_transition():
+    # given
+    # DST starts 2024-03-10 02:00 local in America/New_York.
+    # 03:00 UTC is still 2024-03-09 22:00 (EST) there.
+    now = _utc(2024, 3, 10, 3, 0)
+    birthday = datetime.date(2006, 3, 10)
