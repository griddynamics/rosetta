new file mode 100644
index 0000000..cd33b37
--- /dev/null
+++ b/saleor/graphql/account/mutations/staff/customer_birthday_update.py
@@ -0,0 +1,75 @@
+import graphene
+from django.core.exceptions import ValidationError
+
+from .....account import events as account_events
+from .....account.age_restrictions import is_birthday_in_future
+from .....account.error_codes import AccountErrorCode
+from .....core.exceptions import PermissionDenied
+from .....core.tracing import traced_atomic_transaction
+from .....permission.auth_filters import AuthorizationFilters
+from ....core import ResolveInfo
+from ....core.descriptions import ADDED_IN_323
+from ....core.doc_category import DOC_CATEGORY_USERS
+from ....core.mutations import BaseMutation
+from ....core.scalars import Date
+from ....core.types import AccountError
+from ....site.dataloaders import get_site_promise
+from ...types import User
+
+
+class CustomerBirthdayUpdate(BaseMutation):
+    """Superuser-only path to set or clear another customer's birthday.
+
+    Deliberately not part of `customerUpdate`: `MANAGE_USERS` staff and apps must
+    never be able to change a birthday. No webhook is emitted and the value is
+    never written to events: only the action, actor and target UUID are audited.
+    """
+
+    user = graphene.Field(User, description="An updated user instance.")
+
+    class Arguments:
+        id = graphene.ID(description="ID of a customer to update.", required=True)
+        birthday = Date(
+            description="New self-declared birthday. Pass `null` to clear it."
+        )
+
+    class Meta:
+        description = (
+            "Sets or clears the birthday of a customer. Requires a superuser "
+            "account; apps and staff members without superuser status are rejected."
+            + ADDED_IN_323
+        )
+        auto_permission_message = False
+        doc_category = DOC_CATEGORY_USERS
+        permissions = (AuthorizationFilters.AUTHENTICATED_USER,)
+        error_type_class = AccountError
+        error_type_field = "account_errors"
+
+    @classmethod
+    def perform_mutation(  # type: ignore[override]
+        cls, _root, info: ResolveInfo, /, *, id: str, birthday=None
+    ):
+        requestor = info.context.user
+        if not requestor or not requestor.is_superuser:
+            raise PermissionDenied(
+                message="Only a superuser can change another customer's birthday."
+            )
+        customer = cls.get_node_or_error(info, id, only_type=User, field="id")
+        site = get_site_promise(info.context).get()
+        if birthday is not None and is_birthday_in_future(birthday, site.settings):
+            raise ValidationError(
+                {
+                    "birthday": ValidationError(
+                        "Birthday cannot be in the future.",
+                        code=AccountErrorCode.INVALID.value,
+                    )
+                }
+            )
+        with traced_atomic_transaction():
+            if customer.birthday != birthday:
+                customer.birthday = birthday
+                customer.save(update_fields=["birthday", "updated_at"])
+                account_events.customer_birthday_changed_event(
+                    customer_uuid=customer.uuid, actor=requestor
+                )
+        return CustomerBirthdayUpdate(user=customer)
