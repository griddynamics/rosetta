+from zoneinfo import ZoneInfo, ZoneInfoNotFoundError
+
+from django.core.exceptions import ValidationError
+
+
+def validate_iana_time_zone(value: str) -> None:
+    """Accept only IANA time zone names known to the system tz database."""
+    try:
+        # Absolute/relative paths are not IANA names; ZoneInfo raises ValueError
+        # for malformed keys and ZoneInfoNotFoundError for unknown ones.
+        ZoneInfo(value)
+    except (ZoneInfoNotFoundError, ValueError, OSError, TypeError) as e:
+        raise ValidationError(
+            "Enter a valid IANA time zone name.", code="invalid"
+        ) from e
