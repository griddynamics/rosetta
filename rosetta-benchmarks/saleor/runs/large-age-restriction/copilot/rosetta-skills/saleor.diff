+            "id": graphene.Node.to_global_id("Product", product.pk),
+            "input": {"isAgeRestricted": True},
+        },
+    )
+
+    # then
+    assert_no_permission(response)
+
+
+def test_product_bulk_create_with_age_restriction(
+    staff_api_client, permission_manage_products, product_type, category
+):
+    # given
