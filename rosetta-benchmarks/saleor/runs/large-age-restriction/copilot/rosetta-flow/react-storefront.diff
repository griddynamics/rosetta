@@ -0,0 +1,14 @@
+export function getSafeAuthReturnPath(value: string | null | undefined): string | null {
+	if (!value) {
+		return null;
+	}
+
+	try {
+		const url = new URL(value, "https://paper.invalid");
+		return url.origin === "https://paper.invalid" && url.pathname === "/checkout"
+			? `${url.pathname}${url.search}${url.hash}`
+			: null;
+	} catch {
+		return null;
+	}
+}
