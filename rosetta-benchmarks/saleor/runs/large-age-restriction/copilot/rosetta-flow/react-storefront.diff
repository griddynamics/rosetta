+import "server-only";
+
+import { CurrentUserDocument } from "@/gql/graphql";
+import { fetchAuthenticatedUserIfSession } from "./fetch-authenticated-user";
+
+/**
+ * Reduces the birthday returned for the signed-in customer to a presence flag.
+ * The birthday value is neither logged nor returned to callers.
+ */
+export async function hasBirthdayOnAuthSession(): Promise<boolean> {
+	const result = await fetchAuthenticatedUserIfSession(CurrentUserDocument, {});
+
+	return result.ok && Boolean(result.data.me?.birthday);
+}
