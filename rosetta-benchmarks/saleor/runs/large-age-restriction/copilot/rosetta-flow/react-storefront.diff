@@ -0,0 +1,35 @@
+export type AgeRestrictionRecovery = "sign-in" | "account-settings" | "underage";
+
+export type AddToCartActionResult = {
+	error?: string;
+	ageRestrictionRecovery?: AgeRestrictionRecovery;
+};
+
+type CheckoutAddLineError = {
+	code?: unknown;
+	message?: string | null;
+};
+
+export function isAgeRestrictionError(error: CheckoutAddLineError): boolean {
+	return String(error.code) === "AGE_RESTRICTION" || Boolean(error.message?.toLowerCase().includes("age requirement"));
+}
+
+export function getAddToCartActionResult(
+	error: CheckoutAddLineError,
+	authenticated: boolean,
+	birthdayPresent = false,
+): AddToCartActionResult {
+	if (isAgeRestrictionError(error)) {
+		return {
+			ageRestrictionRecovery: !authenticated
+				? "sign-in"
+				: birthdayPresent
+					? "underage"
+					: "account-settings",
+		};
+	}
+
+	return {
+		error: error.message ?? "Unable to add this item to your cart. Please try again.",
+	};
+}
