@@ -5,6 +5,10 @@
  * amounts cover the total). Capture at fulfillment is separate.
  */
 export function formatCheckoutCompleteError(error: string): string {
+	if (isAgeRestrictionError(error)) {
+		return "You do not meet the age requirement for one or more items in this order.";
+	}
+
 	if (error.includes("CHECKOUT_NOT_FULLY_PAID")) {
 		return "Payment does not fully cover this order total yet. Refresh the page — if funds were authorized, use Complete order. Do not pay again until we confirm the status.";
 	}
@@ -15,3 +19,20 @@ export function formatCheckoutCompleteError(error: string): string {
 
 	return error;
 }
+
+export function isAgeRestrictionError(error: string): boolean {
+	return error.includes("AGE_RESTRICTION") || error.toLowerCase().includes("age requirement");
+}
+
+export function getAgeRestrictionRecovery(
+	error: string | undefined,
+	ageRestricted: boolean,
+	authenticated: boolean,
+	birthdayPresent = false,
+): "account-settings" | "sign-in" | "underage" | null {
+	if (!ageRestricted && !(error && isAgeRestrictionError(error))) {
+		return null;
+	}
+
+	return !authenticated ? "sign-in" : birthdayPresent ? "underage" : "account-settings";
+}
