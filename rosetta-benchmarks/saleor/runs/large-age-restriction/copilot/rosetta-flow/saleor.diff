diff --git a/saleor/checkout/age_restrictions.py b/saleor/checkout/age_restrictions.py
new file mode 100644
index 0000000..e4e48c4
--- /dev/null
+++ b/saleor/checkout/age_restrictions.py
@@ -0,0 +1,70 @@
+from collections.abc import Iterable
+from datetime import date
+from enum import Enum
+from zoneinfo import ZoneInfo
+
+from django.core.exceptions import ValidationError
+from django.utils import timezone
+
+from .error_codes import CheckoutErrorCode
+
+
+def get_shop_today(time_zone: str) -> date:
+    return timezone.now().astimezone(ZoneInfo(time_zone)).date()
+
+
+def validate_birthday(birthday: date, time_zone: str) -> None:
+    if birthday > get_shop_today(time_zone):
+        raise ValidationError("Birthday cannot be in the future.")
+
+
+def is_customer_of_age(birthday: date | None, minimum_age: int, time_zone: str) -> bool:
+    if birthday is None:
+        return False
+
+    today = get_shop_today(time_zone)
+    try:
+        eligible_on = birthday.replace(year=birthday.year + minimum_age)
+    except ValueError:
+        eligible_on = date(birthday.year + minimum_age, 3, 1)
+    return today >= eligible_on
+
+
+def validate_variants_age_restrictions(
+    customer,
+    variants: Iterable,
+    site_settings,
+    error_code: Enum = CheckoutErrorCode.AGE_RESTRICTION,
+) -> None:
+    restricted_products = {
+        variant.product
+        for variant in variants
+        if variant and variant.product.is_age_restricted
+    }
+    if not restricted_products:
+        return
+
+    if not customer or not is_customer_of_age(
+        customer.birthday,
+        site_settings.minimum_age,
+        site_settings.time_zone,
+    ):
+        product_names = ", ".join(
+            sorted(product.name for product in restricted_products)
+        )
+        raise ValidationError(
+            {
+                "lines": ValidationError(
+                    f"Age requirements are not met for: {product_names}.",
+                    code=error_code.value,
+                )
+            }
+        )
+
+
+def validate_checkout_age_restrictions(checkout, lines, site_settings) -> None:
+    validate_variants_age_restrictions(
+        checkout.user,
+        (line.variant for line in lines),
+        site_settings,
+    )
