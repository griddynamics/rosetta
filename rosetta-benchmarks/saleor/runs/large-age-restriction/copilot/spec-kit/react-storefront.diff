+++ b/e2e/age-restrictions.spec.ts
@@ -0,0 +1,102 @@
+import { existsSync } from "node:fs";
+import { expect, test, type Browser, type Page } from "@playwright/test";
+
+const baseURL = process.env.PLAYWRIGHT_BASE_URL ?? "http://127.0.0.1:3020";
+const productPath = process.env.AGE_RESTRICTIONS_E2E_RESTRICTED_PRODUCT_PATH;
+const missingBirthdayStorageState = process.env.AGE_RESTRICTIONS_E2E_MISSING_BIRTHDAY_STORAGE_STATE;
+const underageStorageState = process.env.AGE_RESTRICTIONS_E2E_UNDERAGE_STORAGE_STATE;
+const eligibleStorageState = process.env.AGE_RESTRICTIONS_E2E_ELIGIBLE_STORAGE_STATE;
+
+test.skip(!productPath, "requires AGE_RESTRICTIONS_E2E_RESTRICTED_PRODUCT_PATH");
+
+function isConfigured(storageState?: string): storageState is string {
+	return Boolean(productPath && storageState && existsSync(storageState));
+}
+
+async function addRestrictedProduct(page: Page) {
+	await page.goto(new URL(productPath!, baseURL).toString());
+	const addToCart = page.locator("button:not([disabled])", { hasText: /add to (cart|bag)/i }).first();
+
+	await expect(addToCart).toBeVisible({ timeout: 30_000 });
+	await addToCart.click();
+}
+
+async function withAuthenticatedPage(
+	browser: Browser,
+	storageState: string,
+	assertion: (page: Page) => Promise<void>,
+) {
+	const context = await browser.newContext({ baseURL, storageState });
+	const page = await context.newPage();
+
+	try {
+		await assertion(page);
+	} finally {
+		await context.close();
+	}
+}
+
+test.describe("age-restricted products", () => {
+	test("guides guests to sign in", async ({ page }) => {
+		await addRestrictedProduct(page);
+		await expect(page.getByRole("alert")).toContainText("Sign in to add age-restricted products.");
+		await expect(page.getByRole("link", { name: "Sign in" })).toBeVisible();
+	});
+
+	test("guides customers without a birthday to their profile", async ({ browser }) => {
+		test.skip(
+			!isConfigured(missingBirthdayStorageState),
+			"requires product path and a missing-birthday authenticated storage state",
+		);
+
+		await withAuthenticatedPage(browser, missingBirthdayStorageState, async (page) => {
+			await addRestrictedProduct(page);
+			await expect(page.getByRole("alert")).toContainText(
+				"Add your birthday to buy age-restricted products.",
+			);
+			await expect(page.getByRole("link", { name: "Update profile" })).toBeVisible();
+		});
+	});
+
+	test("rejects underage customers", async ({ browser }) => {
+		test.skip(
+			!isConfigured(underageStorageState),
+			"requires product path and an underage authenticated storage state",
+		);
+
+		await withAuthenticatedPage(browser, underageStorageState, async (page) => {
+			await addRestrictedProduct(page);
+			await expect(page.getByRole("alert")).toContainText(
+				"You do not meet the age requirement for this product.",
+			);
+		});
+	});
+
+	test("lets eligible customers continue to checkout", async ({ browser }) => {
+		test.skip(
+			!isConfigured(eligibleStorageState),
+			"requires product path and an eligible authenticated storage state",
+		);
+
+		await withAuthenticatedPage(browser, eligibleStorageState, async (page) => {
+			await addRestrictedProduct(page);
+			await expect(page.getByRole("alert")).toHaveCount(0);
+			let checkoutId: string | undefined;
+
+			await expect
+				.poll(async () => {
+					checkoutId = (await page.context().cookies()).find((cookie) =>
+						cookie.name.startsWith("checkoutId-"),
+					)?.value;
+					return checkoutId;
+				})
+				.toBeTruthy();
+
+			const checkoutURL = new URL("/checkout", baseURL);
+
+			checkoutURL.searchParams.set("checkout", checkoutId!);
+			await page.goto(checkoutURL.toString());
+			await expect(page).toHaveURL(/\/checkout\?.*checkout=/);
+		});
+	});
+});
