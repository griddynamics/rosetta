new file mode 100644
index 0000000..36147f2
--- /dev/null
+++ b/src/ui/components/pdp/add-to-cart-form.tsx
@@ -0,0 +1,43 @@
+"use client";
+
+import { useActionState } from "react";
+import { LinkWithChannel } from "@/ui/atoms/link-with-channel";
+import { AddToCart } from "./add-to-cart";
+import type { CartMutationResult } from "@/app/actions";
+
+type Props = {
+	action: () => Promise<CartMutationResult>;
+	children: React.ReactNode;
+} & React.ComponentProps<typeof AddToCart>;
+
+export function AddToCartForm({ action, children, ...props }: Props) {
+	const [result, formAction] = useActionState(async () => action(), null as CartMutationResult | null);
+
+	return (
+		<form action={formAction} className="order-3 mt-4 space-y-6">
+			{children}
+			{result && !result.ok ? (
+				<div role="alert" className="rounded-lg border border-destructive/25 bg-destructive/5 p-3 text-sm">
+					{result.eligibility === "guest" ? (
+						<p>
+							Sign in to add age-restricted products.{" "}
+							<LinkWithChannel href="/login" className="underline">
+								Sign in
+							</LinkWithChannel>
+						</p>
+					) : result.eligibility === "birthday" ? (
+						<p>
+							Add your birthday to buy age-restricted products.{" "}
+							<LinkWithChannel href="/account/settings" className="underline">
+								Update profile
+							</LinkWithChannel>
+						</p>
+					) : (
+						<p>You do not meet the age requirement for this product.</p>
+					)}
+				</div>
+			) : null}
+			<AddToCart {...props} />
+		</form>
+	);
+}
