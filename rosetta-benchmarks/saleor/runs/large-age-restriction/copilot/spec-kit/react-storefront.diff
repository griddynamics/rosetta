@@ -0,0 +1,54 @@
+import { describe, expect, it, vi } from "vitest";
+import { AccountUpdateDocument, CurrentUserProfileDocument } from "@/gql/graphql";
+
+const { mutate } = vi.hoisted(() => ({ mutate: vi.fn() }));
+
+vi.mock("@/lib/saleor", () => ({ mutate }));
+vi.mock("next/cache", () => ({ refresh: vi.fn() }));
+
+import { updateProfile } from "./actions";
+
+function profileForm(birthday: string): FormData {
+	const form = new FormData();
+	form.set("firstName", "Ada");
+	form.set("lastName", "Lovelace");
+	form.set("birthday", birthday);
+	return form;
+}
+
+describe("profile birthday", () => {
+	it("saves a valid birthday through the private account mutation", async () => {
+		mutate.mockResolvedValueOnce({
+			ok: true,
+			data: { accountUpdate: { errors: [] } },
+		});
+
+		await expect(updateProfile(profileForm("1990-12-10"))).resolves.toEqual({ success: true });
+		expect(mutate).toHaveBeenCalledWith(AccountUpdateDocument, {
+			variables: {
+				input: { firstName: "Ada", lastName: "Lovelace", birthday: "1990-12-10" },
+			},
+		});
+	});
+
+	it("returns the API validation error for a future birthday", async () => {
+		mutate.mockResolvedValueOnce({
+			ok: true,
+			data: {
+				accountUpdate: {
+					errors: [{ field: "birthday", message: "Must be valid and not after today." }],
+				},
+			},
+		});
+
+		await expect(updateProfile(profileForm("2999-01-01"))).resolves.toEqual({
+			success: false,
+			error: "Must be valid and not after today.",
+		});
+	});
+
+	it("selects birthday only from the authenticated profile query", () => {
+		expect(CurrentUserProfileDocument.toString()).toContain("query CurrentUserProfile");
+		expect(CurrentUserProfileDocument.toString()).toContain("birthday");
+	});
+});
