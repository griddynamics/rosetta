+import datetime
+from zoneinfo import ZoneInfo
+
+from django.utils import timezone
+
+
+def shop_today(shop_timezone: str) -> datetime.date:
+    return timezone.now().astimezone(ZoneInfo(shop_timezone)).date()
+
+
+def is_age_eligible(
+    birthday: datetime.date | None, minimum_age: int, shop_timezone: str
+) -> bool | None:
+    if birthday is None:
+        return None
+    today = shop_today(shop_timezone)
+    try:
+        anniversary = birthday.replace(year=birthday.year + minimum_age)
+    except ValueError:
+        anniversary = datetime.date(birthday.year + minimum_age, 3, 1)
+    return today >= anniversary
