+from django.contrib.sites.models import Site
+from django.core.exceptions import ValidationError
+
+from ..account.age_restrictions import is_age_eligible
+from .error_codes import CheckoutErrorCode
+
+
+def validate_age_restricted_checkout(
+    checkout, lines, error_code=CheckoutErrorCode, variants=()
+) -> None:
+    if not (
+        any(line.variant.product.is_age_restricted for line in lines)
+        or any(variant.product.is_age_restricted for variant in variants)
+    ):
+        return
+    if not checkout.user_id:
+        raise ValidationError(
+            {
+                "lines": ValidationError(
+                    "Sign in to purchase age-restricted products.",
+                    code=error_code.AGE_RESTRICTED_GUEST.value,
+                )
+            }
+        )
+    settings = Site.objects.get_current().settings
+    eligibility = is_age_eligible(
+        checkout.user.birthday, settings.minimum_age, settings.shop_timezone
+    )
+    if eligibility is None:
+        raise ValidationError(
+            {
+                "lines": ValidationError(
+                    "A birthday is required to purchase age-restricted products.",
+                    code=error_code.AGE_RESTRICTED_MISSING_BIRTHDAY.value,
+                )
+            }
+        )
+    if not eligibility:
+        raise ValidationError(
+            {
+                "lines": ValidationError(
+                    "You do not meet the age requirement for this product.",
+                    code=error_code.AGE_RESTRICTED_UNDERAGE.value,
+                )
+            }
+        )
