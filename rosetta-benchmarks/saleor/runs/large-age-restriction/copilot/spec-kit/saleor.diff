+import datetime
+
+import pytest
+from django.utils import timezone
+
+from ..age_restrictions import is_age_eligible
+from ..models import User
+
+
+@pytest.mark.parametrize(
+    ("birthday", "minimum_age", "today", "expected"),
+    [
+        (datetime.date(2008, 10, 27), 18, datetime.date(2026, 10, 27), True),
+        (datetime.date(2008, 2, 29), 18, datetime.date(2026, 3, 1), True),
+        (datetime.date(2008, 2, 29), 18, datetime.date(2026, 2, 28), False),
+        (None, 18, datetime.date(2026, 10, 27), None),
+    ],
+)
+def test_is_age_eligible_uses_calendar_anniversary(
+    monkeypatch, birthday, minimum_age, today, expected
+):
+    monkeypatch.setattr(
+        timezone,
+        "now",
+        lambda: datetime.datetime.combine(today, datetime.time(), datetime.UTC),
+    )
+
+    assert is_age_eligible(birthday, minimum_age, "UTC") is expected
+
+
+def test_user_birthday_is_optional():
+    user = User(email="birthday@example.com", password="password")
+
+    user.full_clean()
+    assert user.birthday is None
+
+
+def test_user_birthday_accepts_a_calendar_date():
+    user = User(
+        email="birthday@example.com",
+        password="password",
+        birthday=datetime.date(2000, 1, 1),
+    )
+
+    user.full_clean()
+    assert user.birthday == datetime.date(2000, 1, 1)
