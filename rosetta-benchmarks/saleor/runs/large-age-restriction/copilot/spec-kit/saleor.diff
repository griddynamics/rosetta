+AGE_RESTRICTION_SETTINGS_MUTATION = """
+mutation updateAgeRestrictionSettings($input: ShopSettingsInput!) {
+  shopSettingsUpdate(input: $input) {
+    shop {
+      minimumAge
+      shopTimezone
+    }
+    errors {
+      field
+      code
+    }
+  }
+}
+"""
+
+
+def test_age_restriction_settings_defaults(site_settings):
+    assert site_settings.minimum_age == 18
+    assert site_settings.shop_timezone == "UTC"
+
+
+def test_shop_settings_update_age_restriction_settings(
+    staff_api_client, site_settings, permission_manage_settings
+):
+    response = staff_api_client.post_graphql(
+        AGE_RESTRICTION_SETTINGS_MUTATION,
+        {"input": {"minimumAge": 21, "shopTimezone": "Europe/Warsaw"}},
+        permissions=[permission_manage_settings],
+    )
+
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+    assert data["errors"] == []
+    assert data["shop"] == {"minimumAge": 21, "shopTimezone": "Europe/Warsaw"}
+    site_settings.refresh_from_db()
+    assert site_settings.minimum_age == 21
+    assert site_settings.shop_timezone == "Europe/Warsaw"
+
+
+@pytest.mark.parametrize(
+    ("input_data", "field"),
+    [
+        ({"minimumAge": -1}, "minimumAge"),
+        ({"shopTimezone": "not/a-timezone"}, "shopTimezone"),
+    ],
+)
+def test_shop_settings_reject_invalid_age_restriction_settings(
+    staff_api_client, permission_manage_settings, input_data, field
+):
+    response = staff_api_client.post_graphql(
+        AGE_RESTRICTION_SETTINGS_MUTATION,
+        {"input": input_data},
+        permissions=[permission_manage_settings],
+    )
+
+    error = get_graphql_content(response)["data"]["shopSettingsUpdate"]["errors"][0]
+    assert error["field"] == field
+    assert error["code"] == ShopErrorCode.INVALID.name
+
 
