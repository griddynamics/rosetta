@@ -0,0 +1,51 @@
+import datetime
+from types import SimpleNamespace
+
+import pytest
+from django.core.exceptions import ValidationError
+
+from ..age_restrictions import validate_age_restricted_checkout
+from ..error_codes import CheckoutErrorCode
+
+
+def _line(*, restricted):
+    return SimpleNamespace(
+        variant=SimpleNamespace(product=SimpleNamespace(is_age_restricted=restricted))
+    )
+
+
+@pytest.mark.parametrize(
+    ("user", "lines", "expected_code"),
+    [
+        (None, [_line(restricted=True)], CheckoutErrorCode.AGE_RESTRICTED_GUEST),
+        (
+            SimpleNamespace(birthday=None),
+            [_line(restricted=True)],
+            CheckoutErrorCode.AGE_RESTRICTED_MISSING_BIRTHDAY,
+        ),
+        (
+            SimpleNamespace(birthday=datetime.date(2010, 1, 1)),
+            [_line(restricted=True)],
+            CheckoutErrorCode.AGE_RESTRICTED_UNDERAGE,
+        ),
+        (None, [_line(restricted=False)], None),
+    ],
+)
+def test_validate_age_restricted_checkout(
+    monkeypatch, user, lines, expected_code
+):
+    settings = SimpleNamespace(minimum_age=18, shop_timezone="UTC")
+    monkeypatch.setattr(
+        "saleor.checkout.age_restrictions.Site.objects.get_current",
+        lambda: SimpleNamespace(settings=settings),
+    )
+    checkout = SimpleNamespace(user_id=1 if user else None, user=user)
+
+    if expected_code is None:
+        validate_age_restricted_checkout(checkout, lines)
+        return
+
+    with pytest.raises(ValidationError) as exc_info:
+        validate_age_restricted_checkout(checkout, lines)
+
+    assert exc_info.value.error_dict["lines"][0].code == expected_code.value
