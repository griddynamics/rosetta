new file mode 100644
index 0000000..5895a34
--- /dev/null
+++ b/saleor/graphql/account/tests/test_age_restrictions.py
@@ -0,0 +1,115 @@
+import datetime
+
+import graphene
+
+from ....account import CustomerEvents
+from ....account.models import CustomerEvent
+from ...tests.utils import get_graphql_content
+
+USER_AGE_RESTRICTION_QUERY = """
+query UserAgeRestriction($id: ID!) {
+  user(id: $id) {
+    birthday
+    ageEligibility
+  }
+}
+"""
+
+ME_AGE_RESTRICTION_QUERY = """
+query MeAgeRestriction {
+  me {
+    birthday
+    ageEligibility
+  }
+}
+"""
+
+ACCOUNT_BIRTHDAY_UPDATE_MUTATION = """
+mutation AccountBirthdayUpdate($input: AccountInput!) {
+  accountUpdate(input: $input) {
+    user {
+      birthday
+    }
+    errors {
+      field
+      code
+    }
+  }
+}
+"""
+
+
+def _query_user_age_restriction(client, user):
+    if client.user == user:
+        response = client.post_graphql(ME_AGE_RESTRICTION_QUERY)
+        return get_graphql_content(response)["data"]["me"]
+    response = client.post_graphql(
+        USER_AGE_RESTRICTION_QUERY,
+        {"id": graphene.Node.to_global_id("User", user.pk)},
+    )
+    return get_graphql_content(response)["data"]["user"]
+
+
+def test_customer_can_update_and_read_own_birthday(user_api_client):
+    response = user_api_client.post_graphql(
+        ACCOUNT_BIRTHDAY_UPDATE_MUTATION,
+        {"input": {"birthday": "2000-01-01"}},
+    )
+
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+    assert data["errors"] == []
+    assert data["user"]["birthday"] == "2000-01-01"
+    user_api_client.user.refresh_from_db()
+    assert user_api_client.user.birthday == datetime.date(2000, 1, 1)
+    assert CustomerEvent.objects.filter(
+        user=user_api_client.user, type=CustomerEvents.BIRTHDAY_CHANGED
+    ).exists()
+
+
+def test_birthday_and_eligibility_are_limited_to_authorized_viewers(
+    user_api_client,
+    staff_api_client,
+    customer_user,
+    permission_manage_orders,
+    permission_manage_users,
+    site_settings,
+):
+    site_settings.minimum_age = 18
+    site_settings.shop_timezone = "UTC"
+    site_settings.save(update_fields=["minimum_age", "shop_timezone"])
+    customer_user.birthday = datetime.date(2000, 1, 1)
+    customer_user.save(update_fields=["birthday"])
+    user_api_client.user.birthday = None
+    user_api_client.user.save(update_fields=["birthday"])
+
+    own_data = _query_user_age_restriction(user_api_client, user_api_client.user)
+    assert own_data == {"birthday": None, "ageEligibility": False}
+
+    staff_api_client.user.user_permissions.add(permission_manage_orders)
+    staff_data = _query_user_age_restriction(staff_api_client, customer_user)
+    assert staff_data["birthday"] is None
+    assert staff_data["ageEligibility"] is None
+
+    staff_api_client.user.user_permissions.add(permission_manage_users)
+    managed_data = _query_user_age_restriction(staff_api_client, customer_user)
+    assert managed_data["birthday"] is None
+    assert managed_data["ageEligibility"] in (True, False)
+    event = CustomerEvent.objects.get(
+        user=customer_user, type=CustomerEvents.AGE_ELIGIBILITY_READ
+    )
+    assert event.parameters == {"actor_id": staff_api_client.user.id}
+
+
+def test_superuser_birthday_reads_are_audited(staff_api_client, customer_user):
+    customer_user.birthday = datetime.date(2000, 1, 1)
+    customer_user.save(update_fields=["birthday"])
+    staff_api_client.user.is_superuser = True
+    staff_api_client.user.save(update_fields=["is_superuser"])
+
+    data = _query_user_age_restriction(staff_api_client, customer_user)
+    assert data["birthday"] == "2000-01-01"
+    event = CustomerEvent.objects.get(
+        user=customer_user, type=CustomerEvents.BIRTHDAY_READ
+    )
+    assert event.parameters == {"actor_id": staff_api_client.user.id}
+    assert event.date is not None
