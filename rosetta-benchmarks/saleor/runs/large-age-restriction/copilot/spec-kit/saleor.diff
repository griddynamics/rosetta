+AGE_RESTRICTION_UPDATE_MUTATION = """
+mutation updateProductAgeRestriction($productId: ID!, $input: ProductInput!) {
+  productUpdate(id: $productId, input: $input) {
+    product {
+      isAgeRestricted
+    }
+    errors {
+      field
+      code
+    }
+  }
+}
+"""
+
+
+def test_product_age_restriction_defaults_to_false(product):
+    assert product.is_age_restricted is False
+
+
+@pytest.mark.parametrize("is_age_restricted", [True, False])
+def test_product_update_age_restriction(
+    staff_api_client, product, permission_manage_products, is_age_restricted
+):
+    response = staff_api_client.post_graphql(
+        AGE_RESTRICTION_UPDATE_MUTATION,
+        {
+            "productId": graphene.Node.to_global_id("Product", product.pk),
+            "input": {"isAgeRestricted": is_age_restricted},
+        },
+        permissions=[permission_manage_products],
+    )
+
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert data["errors"] == []
+    assert data["product"]["isAgeRestricted"] is is_age_restricted
+    product.refresh_from_db()
+    assert product.is_age_restricted is is_age_restricted
+
 
