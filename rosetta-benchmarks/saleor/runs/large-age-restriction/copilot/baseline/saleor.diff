new file mode 100644
index 0000000..42355a7
--- /dev/null
+++ b/saleor/checkout/tests/test_age_restrictions.py
@@ -0,0 +1,29 @@
+import datetime
+from unittest.mock import patch
+
+import pytest
+
+from ...account.models import User
+from ...product.models import Product
+from ..age_restrictions import AgeRestrictionError, validate_age_restrictions
+
+
+@pytest.mark.parametrize(
+    ("birthday", "today", "minimum_age", "is_eligible"),
+    [
+        (datetime.date(2008, 10, 30), datetime.date(2026, 10, 29), 18, False),
+        (datetime.date(2008, 10, 30), datetime.date(2026, 10, 30), 18, True),
+        (datetime.date(2008, 2, 29), datetime.date(2026, 2, 28), 18, False),
+        (datetime.date(2008, 2, 29), datetime.date(2026, 3, 1), 18, True),
+    ],
+)
+def test_validate_age_restrictions(birthday, today, minimum_age, is_eligible):
+    user = User(birthday=birthday)
+    product = Product(id=1, minimum_age=minimum_age)
+
+    with patch("saleor.checkout.age_restrictions.timezone.localdate", return_value=today):
+        if is_eligible:
+            validate_age_restrictions(user, [product])
+        else:
+            with pytest.raises(AgeRestrictionError):
+                validate_age_restrictions(user, [product])
