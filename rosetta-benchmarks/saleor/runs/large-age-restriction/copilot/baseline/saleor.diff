new file mode 100644
index 0000000..061e476
--- /dev/null
+++ b/saleor/checkout/age_restrictions.py
@@ -0,0 +1,44 @@
+import datetime
+from collections.abc import Iterable
+
+from django.utils import timezone
+
+from ..account.models import User
+from ..product.models import Product
+
+
+class AgeRestrictionError(Exception):
+    def __init__(self, product_ids: set[int]):
+        self.product_ids = product_ids
+
+
+def _birthday_in_year(birthday: datetime.date, year: int) -> datetime.date:
+    try:
+        return birthday.replace(year=year)
+    except ValueError:
+        return datetime.date(year, 3, 1)
+
+
+def validate_age_restrictions(
+    user: User | None, products: Iterable[Product]
+) -> None:
+    restricted_products = {
+        product.id: product.minimum_age
+        for product in products
+        if product.minimum_age is not None
+    }
+    if not restricted_products:
+        return
+
+    if not user or not user.birthday:
+        raise AgeRestrictionError(set(restricted_products))
+
+    today = timezone.localdate()
+    ineligible_product_ids = {
+        product_id
+        for product_id, minimum_age in restricted_products.items()
+        if today
+        < _birthday_in_year(user.birthday, user.birthday.year + minimum_age)
+    }
+    if ineligible_product_ids:
+        raise AgeRestrictionError(ineligible_product_ids)
