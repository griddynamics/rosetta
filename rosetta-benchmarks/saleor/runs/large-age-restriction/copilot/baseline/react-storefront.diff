+import { describe, expect, it } from "vitest";
+import { getAgeRestrictionReason } from "./age-restriction";
+
+describe("getAgeRestrictionReason", () => {
+	it("asks a guest to sign in", () => {
+		expect(getAgeRestrictionReason({ hasSession: false })).toBe("sign-in");
+	});
+
+	it("asks an authenticated customer without a birthday to update their account", () => {
+		expect(getAgeRestrictionReason({ hasSession: true, birthday: null })).toBe("birthday");
+	});
+
+	it("explains that an authenticated customer with a birthday is underage", () => {
+		expect(getAgeRestrictionReason({ hasSession: true, birthday: "2008-10-30" })).toBe("underage");
+	});
+});
