--- /dev/null
+++ b/src/lib/age-restriction.ts
@@ -0,0 +1,15 @@
+export type AgeRestrictionReason = "sign-in" | "birthday" | "underage";
+
+export function getAgeRestrictionReason({
+	hasSession,
+	birthday,
+}: {
+	hasSession: boolean;
+	birthday?: string | null;
+}): AgeRestrictionReason {
+	if (!hasSession) {
+		return "sign-in";
+	}
+
+	return birthday ? "underage" : "birthday";
+}
