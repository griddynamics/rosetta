+export async function updateBirthday(formData: FormData): Promise<AccountActionResult> {
+	const birthday = getFormString(formData, "birthday");
+
+	const result = await mutate(AccountUpdateDocument, {
+		variables: { input: { birthday } },
+	});
+
+	if (!result.ok) {
+		return { success: false, error: result.error.message };
+	}
+
+	const errors = result.data.accountUpdate?.errors;
+	if (errors?.length) {
+		return errors[0].message
+			? { success: false, error: errors[0].message }
+			: { success: false, errorKey: "updateProfileFailed" };
+	}
+
+	revalidateAccountLayout();
+	return { success: true };
+}
