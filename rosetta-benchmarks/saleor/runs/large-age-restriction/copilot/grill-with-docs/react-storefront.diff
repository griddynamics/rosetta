+import "server-only";
+
+import { ShopMinimumPurchaseAgeDocument } from "@/gql/graphql";
+import { CACHE_PROFILES, cachedQuery } from "@/lib/saleor";
+
+export async function getMinimumPurchaseAge(): Promise<number> {
+	"use cache";
+
+	const data = await cachedQuery(ShopMinimumPurchaseAgeDocument, {
+		profile: CACHE_PROFILES.channels,
+	});
+
+	return data.shop.minimumPurchaseAge;
+}
