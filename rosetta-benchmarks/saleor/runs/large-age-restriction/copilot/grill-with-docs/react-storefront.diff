+import { describe, expect, it } from "vitest";
+import { validateDateOfBirth } from "./date-of-birth";
+
+describe("validateDateOfBirth", () => {
+	it("accepts a calendar date", () => {
+		expect(validateDateOfBirth("2000-02-29")).toBeNull();
+	});
+
+	it("rejects impossible and future dates", () => {
+		expect(validateDateOfBirth("2023-02-29")).toBe("invalidDateOfBirth");
+		expect(validateDateOfBirth("2999-01-01")).toBe("dateOfBirthInFuture");
+	});
+});
diff --git a/src/ui/components/account/date-of-birth.ts b/src/ui/components/account/date-of-birth.ts
new file mode 100644
index 0000000..e8408b1
--- /dev/null
+++ b/src/ui/components/account/date-of-birth.ts
@@ -0,0 +1,14 @@
+export function validateDateOfBirth(value: string): "invalidDateOfBirth" | "dateOfBirthInFuture" | null {
+	if (!value) return null;
+
+	const date = new Date(`${value}T00:00:00Z`);
+	if (Number.isNaN(date.getTime()) || date.toISOString().slice(0, 10) !== value) {
+		return "invalidDateOfBirth";
+	}
+
+	if (value > new Date().toISOString().slice(0, 10)) {
+		return "dateOfBirthInFuture";
+	}
+
+	return null;
+}
diff --git a/src/ui/components/account/edit-date-of-birth-form.tsx b/src/ui/components/account/edit-date-of-birth-form.tsx
new file mode 100644
index 0000000..670bac1
--- /dev/null
+++ b/src/ui/components/account/edit-date-of-birth-form.tsx
@@ -0,0 +1,67 @@
+"use client";
+
+import { useState, useTransition } from "react";
+import { useRouter } from "next/navigation";
+import { useTranslations } from "next-intl";
+import { Button } from "@/ui/components/ui/button";
+import { Input } from "@/ui/components/ui/input";
+import { Label } from "@/ui/components/ui/label";
+import { updateDateOfBirth } from "@/app/(storefront)/[locale]/[channel]/(main)/account/actions";
+import { resolveAccountActionError } from "@/ui/components/account/account-action-result";
+import { validateDateOfBirth } from "./date-of-birth";
+
+export function EditDateOfBirthForm({ dateOfBirth }: { dateOfBirth?: string | null }) {
+	const t = useTranslations("account");
+	const router = useRouter();
+	const [isEditing, setIsEditing] = useState(false);
+	const [isPending, startTransition] = useTransition();
+	const [error, setError] = useState("");
+
+	const submit = (formData: FormData) => {
+		const value = String(formData.get("dateOfBirth") ?? "");
+		const validationError = validateDateOfBirth(value);
+		if (validationError) {
+			setError(t(`errors.${validationError as "invalidDateOfBirth" | "dateOfBirthInFuture"}`));
+			return;
+		}
+		setError("");
+		startTransition(async () => {
+			const result = await updateDateOfBirth(formData);
+			if (!result.success) {
+				setError(resolveAccountActionError(t, result));
+				return;
+			}
+			setIsEditing(false);
+			router.refresh();
+		});
+	};
+
+	if (!isEditing) {
+		return (
+			<div className="flex items-center justify-between gap-4">
+				<div>
+					<p className="text-sm text-muted-foreground">{t("fields.dateOfBirth")}</p>
+					<p className="font-medium">{dateOfBirth || t("common.notSet")}</p>
+				</div>
+				<Button variant="ghost" size="sm" onClick={() => setIsEditing(true)}>
+					{dateOfBirth ? t("common.change") : t("common.add")}
+				</Button>
+			</div>
+		);
+	}
+
+	return (
+		<form action={submit} className="space-y-4">
+			{error ? <p role="alert" className="text-sm text-destructive">{error}</p> : null}
+			<div className="space-y-1.5">
+				<Label htmlFor="dateOfBirth">{t("fields.dateOfBirth")}</Label>
+				<Input id="dateOfBirth" name="dateOfBirth" type="date" defaultValue={dateOfBirth ?? ""} max={new Date().toISOString().slice(0, 10)} />
+			</div>
+			<div className="flex gap-2">
+				<Button type="submit" size="sm" disabled={isPending}>{isPending ? t("common.saving") : t("common.save")}</Button>
+				<Button type="submit" name="clear" value="true" variant="ghost" size="sm" disabled={isPending}>{t("common.clear")}</Button>
+				<Button type="button" variant="ghost" size="sm" onClick={() => setIsEditing(false)}>{t("common.cancel")}</Button>
+			</div>
+		</form>
+	);
+}
