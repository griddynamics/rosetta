+		expect(formatAgeGateError(code)).toMatch(expected);
+	});
+});
diff --git a/src/lib/checkout-age-gate.ts b/src/lib/checkout-age-gate.ts
new file mode 100644
index 0000000..e1766b4
--- /dev/null
+++ b/src/lib/checkout-age-gate.ts
@@ -0,0 +1,14 @@
+import { CheckoutErrorCode } from "@/gql/graphql";
+
+export function formatAgeGateError(code?: CheckoutErrorCode | null): string | null {
+	switch (code) {
+		case CheckoutErrorCode.AgeRestrictedProductGuest:
+			return "Please sign in before adding age-restricted products to your bag.";
+		case CheckoutErrorCode.AgeRestrictedProductMissingDateOfBirth:
+			return "Add your date of birth in account settings before purchasing age-restricted products.";
+		case CheckoutErrorCode.AgeRestrictedProductUnderage:
+			return "You do not meet the minimum age requirement for this product.";
+		default:
+			return null;
