+export async function updateDateOfBirth(formData: FormData): Promise<AccountActionResult> {
+	const clear = getFormStringOptional(formData, "clear") === "true";
+	const dateOfBirth = getFormStringOptional(formData, "dateOfBirth");
+	const validationError = !clear && dateOfBirth ? validateDateOfBirth(dateOfBirth) : null;
+	if (validationError) return { success: false, errorKey: validationError };
+
+	const result = await mutate(AccountUpdateDocument, {
+		variables: { input: { dateOfBirth: clear ? null : dateOfBirth || null } },
+	});
+	if (!result.ok) return { success: false, error: result.error.message };
+
+	const errors = result.data.accountUpdate?.errors;
+	if (errors?.length) {
+		return errors[0].message
+			? { success: false, error: errors[0].message }
+			: { success: false, errorKey: "updateDateOfBirthFailed" };
+	}
+	revalidateAccountLayout();
+	return { success: true };
