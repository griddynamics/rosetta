@@ -4,7 +4,19 @@
  * Saleor completes checkout when authorizeStatus is FULL (authorized + charged
  * amounts cover the total). Capture at fulfillment is separate.
  */
-export function formatCheckoutCompleteError(error: string): string {
+export function formatCheckoutCompleteError(error: string, code?: string | null): string {
+	// Saleor returns the machine-readable code separately from the human message.
+	// In particular, the missing-DOB and underage messages include the affected
+	// product names, so keep that server detail visible.
+	if (code === "AGE_RESTRICTED_PRODUCT_GUEST") {
+		return "Please sign in before completing an order with age-restricted products.";
+	}
+	if (code === "AGE_RESTRICTED_PRODUCT_MISSING_DATE_OF_BIRTH") {
+		return `${error}\n\nAdd your date of birth in account settings before completing this order.`;
+	}
+	if (code === "AGE_RESTRICTED_PRODUCT_UNDERAGE") {
+		return `${error}\n\nYou do not meet the minimum age requirement for these products.`;
+	}
 	if (error.includes("CHECKOUT_NOT_FULLY_PAID")) {
 		return "Payment does not fully cover this order total yet. Refresh the page — if funds were authorized, use Complete order. Do not pay again until we confirm the status.";
 	}
