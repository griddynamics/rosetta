+import datetime
+from dataclasses import dataclass
+from types import SimpleNamespace
+
+import pytest
+from django.core.exceptions import ValidationError
+from freezegun import freeze_time
+
+from ....checkout.age_gate import validate_age_restricted_products
+from ....checkout.error_codes import CheckoutErrorCode
+
+
+@dataclass(frozen=True)
+class Product:
+    name: str
+    is_age_restricted: bool = True
+
+
+def restricted_variant(name="Restricted"):
+    return SimpleNamespace(product=Product(name))
+
+
+@freeze_time("2026-10-27")
+@pytest.mark.parametrize(
+    ("user", "expected_code"),
+    [
+        (None, CheckoutErrorCode.AGE_RESTRICTED_PRODUCT_GUEST),
+        (
+            SimpleNamespace(date_of_birth=None),
+            CheckoutErrorCode.AGE_RESTRICTED_PRODUCT_MISSING_DATE_OF_BIRTH,
+        ),
+        (
+            SimpleNamespace(date_of_birth=datetime.date(2010, 10, 28)),
+            CheckoutErrorCode.AGE_RESTRICTED_PRODUCT_UNDERAGE,
+        ),
+    ],
+)
+def test_restricted_checkout_requires_authenticated_eligible_customer(
+    user, expected_code
+):
+    checkout = SimpleNamespace(user_id=bool(user), user=user)
+
+    with pytest.raises(ValidationError) as exc_info:
+        validate_age_restricted_products(checkout, [restricted_variant()], 18)
+
+    assert exc_info.value.error_dict["lines"][0].code == expected_code.value
+
+
+@freeze_time("2026-10-27")
+def test_restricted_checkout_allows_customer_on_birthday():
+    user = SimpleNamespace(date_of_birth=datetime.date(2008, 10, 27))
+    checkout = SimpleNamespace(user_id=1, user=user)
+
+    validate_age_restricted_products(checkout, [restricted_variant()], 18)
