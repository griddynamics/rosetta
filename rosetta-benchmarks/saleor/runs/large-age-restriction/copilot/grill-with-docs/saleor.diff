+import datetime
+
+from django.utils import timezone
+
+
+def is_old_enough(date_of_birth: datetime.date | None, minimum_age: int) -> bool:
+    if not date_of_birth:
+        return False
+    today = timezone.localdate()
+    try:
+        eligible_on = date_of_birth.replace(year=date_of_birth.year + minimum_age)
+    except ValueError:
+        eligible_on = datetime.date(date_of_birth.year + minimum_age, 3, 1)
+    return today >= eligible_on
