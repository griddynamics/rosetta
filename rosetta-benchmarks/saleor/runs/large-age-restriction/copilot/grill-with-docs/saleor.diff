@@ -0,0 +1,48 @@
+from collections.abc import Iterable
+
+from django.core.exceptions import ValidationError
+
+from ..account.age_gate import is_old_enough
+from .error_codes import CheckoutErrorCode
+
+
+def validate_age_restricted_products(checkout, variants: Iterable, minimum_age: int):
+    products = {
+        variant.product
+        for variant in variants
+        if variant.product.is_age_restricted is True
+    }
+    if not products:
+        return
+    if not checkout.user_id:
+        raise ValidationError(
+            {
+                "lines": ValidationError(
+                    "Sign in to purchase age-restricted products.",
+                    code=CheckoutErrorCode.AGE_RESTRICTED_PRODUCT_GUEST.value,
+                )
+            }
+        )
+    if not checkout.user.date_of_birth:
+        code = CheckoutErrorCode.AGE_RESTRICTED_PRODUCT_MISSING_DATE_OF_BIRTH
+        message = (
+            "Date of birth is required to purchase age-restricted products: "
+            f"{', '.join(sorted(product.name for product in products))}."
+        )
+    elif not is_old_enough(checkout.user.date_of_birth, minimum_age):
+        code = CheckoutErrorCode.AGE_RESTRICTED_PRODUCT_UNDERAGE
+        message = (
+            "You do not meet the minimum age for age-restricted products: "
+            f"{', '.join(sorted(product.name for product in products))}."
+        )
+    else:
+        return
+    raise ValidationError(
+        {
+            "lines": ValidationError(
+                message,
+                code=code.value,
+                params={"products": sorted(product.name for product in products)},
+            )
+        }
+    )
