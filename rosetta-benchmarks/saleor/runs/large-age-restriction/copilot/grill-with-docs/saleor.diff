@@ -0,0 +1,32 @@
+import datetime
+
+import pytest
+from freezegun import freeze_time
+
+from ....account import CustomerEvents
+from ....account.age_gate import is_old_enough
+from ....account.events import customer_data_read_event
+
+
+@pytest.mark.parametrize(
+    ("today", "date_of_birth", "expected"),
+    [
+        ("2026-10-27", datetime.date(2008, 10, 27), True),
+        ("2026-10-26", datetime.date(2008, 10, 27), False),
+        ("2026-10-27", datetime.date(1990, 12, 15), True),
+        ("2022-03-01", datetime.date(2004, 2, 29), True),
+        ("2022-02-28", datetime.date(2004, 2, 29), False),
+        ("2026-10-27", None, False),
+    ],
+)
+def test_is_old_enough_handles_birthdays_and_leap_days(today, date_of_birth, expected):
+    with freeze_time(today):
+        assert is_old_enough(date_of_birth, 18) is expected
+
+
+def test_customer_data_read_event_records_actor_without_sensitive_parameters(staff_user):
+    event = customer_data_read_event(actor=staff_user)
+
+    assert event.user == staff_user
+    assert event.type == CustomerEvents.CUSTOMER_DATA_READ
+    assert event.parameters == {}
