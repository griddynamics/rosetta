+def test_product_update_persists_age_restriction(
+    staff_api_client, permission_manage_products, product
+):
+    query = """
+        mutation ProductUpdate($id: ID!, $input: ProductInput!) {
+          productUpdate(id: $id, input: $input) {
+            product { isAgeRestricted }
+            productErrors { field message }
+          }
+        }
+    """
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"isAgeRestricted": True},
+    }
+    staff_api_client.user.user_permissions.add(permission_manage_products)
+
+    content = get_graphql_content(staff_api_client.post_graphql(query, variables))
+
+    assert not content["data"]["productUpdate"]["productErrors"]
+    assert content["data"]["productUpdate"]["product"]["isAgeRestricted"] is True
+    product.refresh_from_db()
+    assert product.is_age_restricted is True
+
