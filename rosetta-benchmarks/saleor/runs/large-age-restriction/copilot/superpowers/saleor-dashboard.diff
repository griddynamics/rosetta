diff --git a/src/customers/views/CustomerDetails.test.tsx b/src/customers/views/CustomerDetails.test.tsx
new file mode 100644
index 0000000..802f769
--- /dev/null
+++ b/src/customers/views/CustomerDetails.test.tsx
@@ -0,0 +1,92 @@
+import CustomerInfo from "@dashboard/customers/components/CustomerInfo/CustomerInfo";
+import { PermissionEnum, type UserFragment } from "@dashboard/graphql";
+import Wrapper from "@test/wrapper";
+import { render, screen } from "@testing-library/react";
+
+import { getCanManageBirthday, getCustomerUpdateInput } from "./CustomerDetails";
+
+const customerInfoData = {
+  birthday: "2000-02-29",
+  customerTypeId: "",
+  email: "customer@example.com",
+  firstName: "Jane",
+  lastName: "Doe",
+  note: "",
+};
+
+describe("CustomerDetails birthday control", () => {
+  const allPermissionsStaff: Pick<UserFragment, "canManageBirthday" | "userPermissions"> = {
+    canManageBirthday: false,
+    userPermissions: Object.values(PermissionEnum).map(code => ({
+      __typename: "UserPermission",
+      code,
+      name: code,
+    })),
+  };
+  const ordinaryStaff: Pick<UserFragment, "canManageBirthday"> = {
+    canManageBirthday: false,
+  };
+  const superuser: Pick<UserFragment, "canManageBirthday"> = {
+    canManageBirthday: true,
+  };
+
+  it("does not render a birthday control or include it in the mutation for ordinary staff with all permissions", () => {
+    render(
+      <Wrapper>
+        <CustomerInfo
+          data={customerInfoData}
+          disabled={false}
+          errors={[]}
+          onChange={jest.fn()}
+          showBirthday={getCanManageBirthday(allPermissionsStaff)}
+        />
+      </Wrapper>,
+    );
+
+    expect(screen.queryByTestId("customer-birthday")).not.toBeInTheDocument();
+    expect(screen.queryByDisplayValue("2000-02-29")).not.toBeInTheDocument();
+    expect(
+      getCustomerUpdateInput(customerInfoData, getCanManageBirthday(allPermissionsStaff)),
+    ).not.toHaveProperty("birthday");
+  });
+
+  it("does not render a birthday control or include it in the mutation for ordinary staff", () => {
+    render(
+      <Wrapper>
+        <CustomerInfo
+          data={customerInfoData}
+          disabled={false}
+          errors={[]}
+          onChange={jest.fn()}
+          showBirthday={getCanManageBirthday(ordinaryStaff)}
+        />
+      </Wrapper>,
+    );
+
+    expect(screen.queryByTestId("customer-birthday")).not.toBeInTheDocument();
+    expect(
+      getCustomerUpdateInput(customerInfoData, getCanManageBirthday(ordinaryStaff)),
+    ).not.toHaveProperty("birthday");
+  });
+
+  it("renders a birthday control for superusers and sends its value in customerUpdate input", () => {
+    render(
+      <Wrapper>
+        <CustomerInfo
+          data={customerInfoData}
+          disabled={false}
+          errors={[]}
+          onChange={jest.fn()}
+          showBirthday={getCanManageBirthday(superuser)}
+        />
+      </Wrapper>,
+    );
+
+    expect(screen.getByTestId("customer-birthday")).toHaveValue("2000-02-29");
+    expect(getCustomerUpdateInput(customerInfoData, getCanManageBirthday(superuser))).toMatchObject(
+      {
+        birthday: "2000-02-29",
+      },
+    );
+  });
+});
