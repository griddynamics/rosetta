@@ -0,0 +1,7 @@
+export function getLoginRedirect(returnUrl: string | null, fallback: string): string {
+	if (returnUrl?.startsWith("/checkout?checkout=")) {
+		return returnUrl;
+	}
+
+	return fallback;
+}
