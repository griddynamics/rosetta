+	useTranslations: () => (key: string) => key,
+}));
+vi.mock("next/image", () => ({
+	default: (props: { alt: string }) => h("img", { alt: props.alt }),
+}));
+vi.mock("next/link", () => ({
+	default: ({ children, ...props }: ComponentProps<"a">) => h("a", props, children),
+}));
+vi.mock("lucide-react", () => ({
+	Minus: () => null,
+	Plus: () => null,
+	Trash2: () => null,
+	ShoppingBag: () => null,
+	ArrowRight: () => null,
+	Truck: () => null,
+	RotateCcw: () => null,
+}));
+vi.mock("@/ui/atoms/link-with-channel", () => ({
+	LinkWithChannel: ({ children, ...props }: ComponentProps<"a">) => h("a", props, children),
+}));
+vi.mock("@/ui/components/ui/button", () => ({
+	Button: ({ children, ...props }: ComponentProps<"button">) => h("button", props, children),
+	buttonClassName: () => "",
+}));
+vi.mock("@/ui/components/ui/sheet", () => ({
+	Sheet: ({ children }: { children: ReactNode }) => h("div", null, children),
+	SheetContent: ({ children }: { children: ReactNode }) => h("div", null, children),
+	SheetHeader: ({ children }: { children: ReactNode }) => h("header", null, children),
+	SheetTitle: ({ children }: { children: ReactNode }) => h("h2", null, children),
+	SheetCloseButton: () => null,
+}));
+vi.mock("./cart-context", () => ({
+	useCart: () => ({ isOpen: true, closeCart: vi.fn() }),
+}));
+vi.mock("@paper/session-bridge", () => ({
+	buildCheckoutPath: () => "/checkout",
+}));
+
+import { CartDrawer } from "./cart-drawer";
+
+const cart = {
+	drawer: {
+		title: "Your cart",
+		addForFreeShipping: "Add {amount}",
+		freeShippingQualified: "Free shipping",
+	},
+	empty: { title: "Empty", body: "No items", ctaLabel: "Shop" },
+	trust: { returnsLabel: "Returns" },
+} as never;
+
+const policies = {
+	shipping: { freeShippingThreshold: null },
+	returns: { windowDays: 30 },
+} as never;
+
+function renderDrawer(isAgeRestricted: boolean) {
+	return renderToStaticMarkup(
+		h(CartDrawer, {
+			checkoutId: "checkout-1",
+			lines: [
+				{
+					id: "line-1",
+					quantity: 1,
+					totalPrice: { gross: { amount: 10, currency: "USD" } },
+					variant: {
+						id: "variant-1",
+						name: "Small",
+						product: {
+							id: "product-1",
+							name: "Product",
+							slug: "product",
+							isAgeRestricted,
+							thumbnail: null,
+						},
+					},
+				},
+			],
+			totalPrice: { gross: { amount: 10, currency: "USD" } },
+			localeSlug: "en",
+			cart,
+			policies,
+			minimumAge: 21,
+			deleteCartLine: async () => {},
+			updateCartLineQuantity: async () => {},
+		}),
+	);
+}
+
+describe("CartDrawer", () => {
+	it("renders the configured age restriction label for a restricted line", () => {
+		expect(renderDrawer(true)).toContain("21+");
+	});
+
+	it("does not render an age restriction label for an unrestricted line", () => {
+		expect(renderDrawer(false)).not.toContain("21+");
+	});
+});
