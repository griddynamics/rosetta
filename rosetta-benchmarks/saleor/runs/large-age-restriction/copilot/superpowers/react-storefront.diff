+import { getLoginRedirect } from "./login-redirect";
+
+describe("getLoginRedirect", () => {
+	it("returns the checkout return URL after sign-in", () => {
+		expect(
+			getLoginRedirect("/checkout?checkout=checkout-123&locale=en-US", "/en-US/default-channel"),
+		).toBe("/checkout?checkout=checkout-123&locale=en-US");
+	});
+
+	it("falls back to the storefront when the return URL is not a checkout", () => {
+		expect(getLoginRedirect("https://malicious.example", "/en-US/default-channel")).toBe(
+			"/en-US/default-channel",
+		);
+	});
+});
