index 0000000..535d429
--- /dev/null
+++ b/src/ui/components/account/account-settings-redirect.ts
@@ -0,0 +1,14 @@
+const RETURN_URL_ORIGIN = "https://storefront.invalid";
+
+export function getProfileSaveRedirect(returnUrl: string | null): string | null {
+	if (!returnUrl?.startsWith("/")) {
+		return null;
+	}
+
+	const url = new URL(returnUrl, RETURN_URL_ORIGIN);
+	if (url.origin !== RETURN_URL_ORIGIN || url.pathname !== "/checkout" || !url.searchParams.get("checkout")) {
+		return null;
+	}
+
+	return `${url.pathname}${url.search}`;
+}
