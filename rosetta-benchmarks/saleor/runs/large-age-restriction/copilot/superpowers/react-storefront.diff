@@ -0,0 +1,15 @@
+type AgeRestrictionLabelProps = {
+	isAgeRestricted: boolean;
+	minimumAge: number;
+	className?: string;
+};
+
+export function ageRestrictionLabel(isAgeRestricted: boolean, minimumAge: number): string | null {
+	return isAgeRestricted ? `${minimumAge}+` : null;
+}
+
+export function AgeRestrictionLabel({ isAgeRestricted, minimumAge, className }: AgeRestrictionLabelProps) {
+	const label = ageRestrictionLabel(isAgeRestricted, minimumAge);
+
+	return label ? <span className={className}>{label}</span> : null;
+}
