+import { describe, expect, it } from "vitest";
+
+import { getAgeRestrictionNavigation } from "./age-restriction-navigation";
+
+describe("getAgeRestrictionNavigation", () => {
+	it("sends a guest to sign-in with the checkout return URL", () => {
+		expect(
+			getAgeRestrictionNavigation({
+				authenticated: false,
+				checkoutId: "checkout-123",
+				locale: "en-US",
+				channel: "default-channel",
+			}),
+		).toBe("/en-US/default-channel/login?returnUrl=%2Fcheckout%3Fcheckout%3Dcheckout-123%26locale%3Den-US");
+	});
+
+	it("sends an authenticated shopper to the birthday profile form", () => {
+		expect(
+			getAgeRestrictionNavigation({
+				authenticated: true,
+				checkoutId: "checkout-123",
+				locale: "en-US",
+				channel: "default-channel",
+			}),
+		).toBe(
+			"/en-US/default-channel/account/settings?returnUrl=%2Fcheckout%3Fcheckout%3Dcheckout-123%26locale%3Den-US",
+		);
+	});
+});
diff --git a/src/checkout/lib/payment/age-restriction-navigation.ts b/src/checkout/lib/payment/age-restriction-navigation.ts
new file mode 100644
index 0000000..9ddbd29
--- /dev/null
+++ b/src/checkout/lib/payment/age-restriction-navigation.ts
@@ -0,0 +1,26 @@
+import { buildCheckoutPath } from "@/session-bridge/checkout-url";
+import { buildStorefrontPath } from "@/lib/storefront-path";
+
+type AgeRestrictionNavigationParams = {
+	authenticated: boolean;
+	checkoutId: string;
+	locale: string;
+	channel: string;
+};
+
+export function getAgeRestrictionNavigation({
+	authenticated,
+	checkoutId,
+	locale,
+	channel,
+}: AgeRestrictionNavigationParams): string {
+	if (authenticated) {
+		const returnUrl = buildCheckoutPath({ checkoutId, browseLocale: locale });
+		const settingsPath = buildStorefrontPath(locale, channel, "/account/settings");
+		return `${settingsPath}?returnUrl=${encodeURIComponent(returnUrl)}`;
+	}
+
+	const returnUrl = buildCheckoutPath({ checkoutId, browseLocale: locale });
+	const signInPath = buildStorefrontPath(locale, channel, "/login");
+	return `${signInPath}?returnUrl=${encodeURIComponent(returnUrl)}`;
+}
