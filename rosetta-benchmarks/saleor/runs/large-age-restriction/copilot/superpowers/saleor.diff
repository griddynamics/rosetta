diff --git a/saleor/graphql/order/tests/mutations/test_draft_order_complete.py b/saleor/graphql/order/tests/mutations/test_draft_order_complete.py
index 04b6bb9..af246ac 100644
--- a/saleor/graphql/order/tests/mutations/test_draft_order_complete.py
+++ b/saleor/graphql/order/tests/mutations/test_draft_order_complete.py
@@ -185,6 +185,56 @@ def test_draft_order_complete(
     )
 
 
+@pytest.mark.parametrize(
+    ("birthday", "expected_error"),
+    [
+        (None, False),
+        (None, True),
+        (timezone.localdate() - datetime.timedelta(days=17 * 365), True),
+    ],
+)
+def test_draft_order_complete_enforces_age_restrictions(
+    staff_api_client,
+    permission_group_manage_orders,
+    draft_order,
+    customer_user,
+    site_settings,
+    birthday,
+    expected_error,
+):
+    order = draft_order
+    product = order.lines.first().variant.product
+    product.is_age_restricted = True
+    product.save(update_fields=["is_age_restricted"])
+    site_settings.minimum_age = 18
+    site_settings.save(update_fields=["minimum_age"])
+    if expected_error:
+        order.user = customer_user
+        order.save(update_fields=["user"])
+        customer_user.birthday = birthday
+        customer_user.save(update_fields=["birthday"])
+    else:
+        order.user = None
+        order.save(update_fields=["user"])
+
+    permission_group_manage_orders.user_set.add(staff_api_client.user)
+    response = staff_api_client.post_graphql(
+        DRAFT_ORDER_COMPLETE_MUTATION,
+        {"id": graphene.Node.to_global_id("Order", order.id)},
+    )
+
+    data = get_graphql_content(response)["data"]["draftOrderComplete"]
+    order.refresh_from_db()
+    if expected_error:
+        assert data["errors"][0]["code"] == OrderErrorCode.AGE_RESTRICTION_NOT_MET.name
+        assert data["order"] is None
+        assert order.status == OrderStatus.DRAFT
+        assert not Allocation.objects.filter(order_line__order=order).exists()
+    else:
+        assert not data["errors"]
+        assert order.status != OrderStatus.DRAFT
+
+
