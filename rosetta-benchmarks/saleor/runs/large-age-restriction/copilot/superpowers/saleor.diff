diff --git a/saleor/checkout/age_restrictions.py b/saleor/checkout/age_restrictions.py
new file mode 100644
index 0000000..7fa1587
--- /dev/null
+++ b/saleor/checkout/age_restrictions.py
@@ -0,0 +1,58 @@
+from collections.abc import Iterable
+from datetime import date
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from ..account.models import User
+    from ..order.fetch import OrderLineInfo
+    from .fetch import CheckoutLineInfo
+
+
+class AgeRestrictionNotMet(Exception):
+    """Raised when a customer cannot purchase an age-restricted product."""
+
+    def __init__(self):
+        super().__init__("Customer does not meet the age restriction.")
+
+
+def _has_age_restricted_product(
+    lines: Iterable["CheckoutLineInfo | OrderLineInfo"],
+) -> bool:
+    for line in lines:
+        variant = line.variant
+        if variant and variant.product.is_age_restricted:
+            return True
+    return False
+
+
+def _anniversary(birthday: date, year: int) -> date:
+    if birthday.month == 2 and birthday.day == 29:
+        try:
+            return date(year, 2, 29)
+        except ValueError:
+            return date(year, 3, 1)
+    return birthday.replace(year=year)
+
+
+def validate_age_restrictions(
+    lines: Iterable["CheckoutLineInfo | OrderLineInfo"],
+    customer: "User | None",
+    minimum_age: int,
+    today: date,
+    allow_missing_customer: bool,
+) -> None:
+    if not _has_age_restricted_product(lines):
+        return
+
+    if customer is None:
+        if allow_missing_customer:
+            return
+        raise AgeRestrictionNotMet()
+
+    birthday = customer.birthday
+    if birthday is None or birthday > today:
+        raise AgeRestrictionNotMet()
+
+    eligibility_date = _anniversary(birthday, birthday.year + minimum_age)
+    if eligibility_date > today:
+        raise AgeRestrictionNotMet()
