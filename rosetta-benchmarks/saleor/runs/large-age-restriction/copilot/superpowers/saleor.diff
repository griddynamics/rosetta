diff --git a/saleor/checkout/tests/test_age_restrictions.py b/saleor/checkout/tests/test_age_restrictions.py
new file mode 100644
index 0000000..d07f0bd
--- /dev/null
+++ b/saleor/checkout/tests/test_age_restrictions.py
@@ -0,0 +1,96 @@
+from datetime import date
+from types import SimpleNamespace
+
+import pytest
+
+from ..age_restrictions import AgeRestrictionNotMet, validate_age_restrictions
+
+
+def _line(*, is_age_restricted: bool):
+    return SimpleNamespace(
+        variant=SimpleNamespace(
+            product=SimpleNamespace(is_age_restricted=is_age_restricted)
+        )
+    )
+
+
+def _customer(birthday: date | None):
+    return SimpleNamespace(birthday=birthday)
+
+
+def _validate(
+    lines,
+    customer,
+    minimum_age=18,
+    today=date(2026, 3, 1),
+    allow_missing_customer=False,
+):
+    validate_age_restrictions(
+        lines=lines,
+        customer=customer,
+        minimum_age=minimum_age,
+        today=today,
+        allow_missing_customer=allow_missing_customer,
+    )
+
+
+def test_unrestricted_lines_do_not_require_a_customer():
+    _validate([_line(is_age_restricted=False)], customer=None)
+
+
+def test_guest_customer_is_rejected_for_restricted_product():
+    with pytest.raises(AgeRestrictionNotMet):
+        _validate([_line(is_age_restricted=True)], customer=None)
+
+
+def test_unlinked_draft_is_allowed_for_restricted_product():
+    _validate(
+        [_line(is_age_restricted=True)],
+        customer=None,
+        allow_missing_customer=True,
+    )
+
+
+@pytest.mark.parametrize(
+    "birthday",
+    [None, date(2026, 3, 2), date(2008, 3, 2)],
+    ids=["missing", "future", "underage"],
+)
+def test_invalid_customer_birthday_is_rejected_for_restricted_product(birthday):
+    with pytest.raises(AgeRestrictionNotMet) as exc_info:
+        _validate([_line(is_age_restricted=True)], customer=_customer(birthday))
+
+    if birthday:
+        assert birthday.isoformat() not in str(exc_info.value)
+
+
+def test_customer_is_eligible_on_their_birthday():
+    _validate(
+        [_line(is_age_restricted=True)],
+        customer=_customer(date(2008, 3, 1)),
+    )
+
+
+def test_leap_day_birthday_is_eligible_on_march_first_in_non_leap_year():
+    _validate(
+        [_line(is_age_restricted=True)],
+        customer=_customer(date(2008, 2, 29)),
+    )
+
+
+def test_changed_minimum_age_is_enforced():
+    lines = [_line(is_age_restricted=True)]
+    customer = _customer(date(2006, 3, 1))
+
+    _validate(lines, customer, minimum_age=20)
+
+    with pytest.raises(AgeRestrictionNotMet):
+        _validate(lines, customer, minimum_age=21)
+
+
+def test_restricted_line_after_unrestricted_line_is_checked():
+    with pytest.raises(AgeRestrictionNotMet):
+        _validate(
+            [_line(is_age_restricted=False), _line(is_age_restricted=True)],
+            customer=None,
+        )
