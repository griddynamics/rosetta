diff --git a/src/auth/components/SectionRoute.ageRestrictionPermissions.test.tsx b/src/auth/components/SectionRoute.ageRestrictionPermissions.test.tsx
new file mode 100644
index 0000000..4cd9578
--- /dev/null
+++ b/src/auth/components/SectionRoute.ageRestrictionPermissions.test.tsx
@@ -0,0 +1,69 @@
+import { PermissionEnum, type UserFragment } from "@dashboard/graphql";
+import { render, screen } from "@testing-library/react";
+import type { ReactNode } from "react";
+import { MemoryRouter } from "react-router-dom";
+
+import { useUser } from "../useUser";
+import SectionRoute from "./SectionRoute";
+
+jest.mock("@dashboard/components/Router", () => ({
+  Route: jest.requireActual("react-router-dom").Route,
+}));
+
+jest.mock("../useUser", () => ({
+  useUser: jest.fn(),
+}));
+
+jest.mock("../../NotFound", () => {
+  function MockNotFound(): ReactNode {
+    return <div data-test-id="permission-denied" />;
+  }
+
+  return MockNotFound;
+});
+
+const mockUseUser = useUser as jest.Mock;
+
+const makeUser = (permissions: PermissionEnum[]): UserFragment =>
+  ({
+    userPermissions: permissions.map(code => ({ code })),
+  }) as unknown as UserFragment;
+
+const ProtectedPage = (): ReactNode => <div data-test-id="protected-page" />;
+
+describe.each([
+  ["/products", PermissionEnum.MANAGE_PRODUCTS],
+  ["/site-settings", PermissionEnum.MANAGE_SETTINGS],
+])("age-restriction management route %s", (path, permission) => {
+  it("denies access without its required permission", () => {
+    // Arrange
+    mockUseUser.mockReturnValue({ user: makeUser([]) });
+
+    // Act
+    render(
+      <MemoryRouter initialEntries={[path]}>
+        <SectionRoute path={path} permissions={[permission]} component={ProtectedPage} />
+      </MemoryRouter>,
+    );
+
+    // Assert
+    expect(screen.queryByTestId("protected-page")).not.toBeInTheDocument();
+    expect(screen.getByTestId("permission-denied")).toBeInTheDocument();
+  });
+
+  it("renders the route when its required permission is granted", () => {
+    // Arrange
+    mockUseUser.mockReturnValue({ user: makeUser([permission]) });
+
+    // Act
+    render(
+      <MemoryRouter initialEntries={[path]}>
+        <SectionRoute path={path} permissions={[permission]} component={ProtectedPage} />
+      </MemoryRouter>,
+    );
+
+    // Assert
+    expect(screen.getByTestId("protected-page")).toBeInTheDocument();
+    expect(screen.queryByTestId("permission-denied")).not.toBeInTheDocument();
+  });
+});
