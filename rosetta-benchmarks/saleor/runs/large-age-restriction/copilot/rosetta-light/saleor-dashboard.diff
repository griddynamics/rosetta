@@ -0,0 +1,69 @@
+import { type ShopErrorFragment } from "@dashboard/graphql";
+import { type FormChange } from "@dashboard/hooks/useForm";
+import { getFormErrors } from "@dashboard/utils/errors";
+import getShopErrorMessage from "@dashboard/utils/errors/shop";
+import { Box, Input } from "@saleor/macaw-ui-next";
+import type { ReactNode } from "react";
+import { useIntl } from "react-intl";
+
+import { isValidIanaTimezone, isValidMinimumAge } from "./ageRestrictionValidation";
+import { messages } from "./messages";
+
+interface SiteAgeRestrictionFieldsProps {
+  data: {
+    minimumAge: string;
+    timeZone: string;
+  };
+  errors: ShopErrorFragment[];
+  disabled: boolean;
+  showValidationErrors: boolean;
+  onChange: FormChange;
+}
+
+export const SiteAgeRestrictionFields = ({
+  data,
+  errors,
+  disabled,
+  showValidationErrors,
+  onChange,
+}: SiteAgeRestrictionFieldsProps): ReactNode => {
+  const intl = useIntl();
+  const formErrors = getFormErrors(["minimumAge", "timeZone"], errors);
+  const invalidAge = showValidationErrors && !isValidMinimumAge(data.minimumAge);
+  const invalidTimeZone = showValidationErrors && !isValidIanaTimezone(data.timeZone);
+  const minimumAgeError =
+    (invalidAge && intl.formatMessage(messages.invalidMinimumAge)) ||
+    getShopErrorMessage(formErrors.minimumAge, intl);
+  const timeZoneError =
+    (invalidTimeZone && intl.formatMessage(messages.invalidTimeZone)) ||
+    getShopErrorMessage(formErrors.timeZone, intl);
+
+  return (
+    <Box display="grid" __gridTemplateColumns="1fr 1fr" gap={4}>
+      <Input
+        data-test-id="minimum-age-input"
+        name="minimumAge"
+        type="number"
+        min={0}
+        max={150}
+        step={1}
+        label={intl.formatMessage(messages.minimumAgeLabel)}
+        value={data.minimumAge}
+        disabled={disabled}
+        error={!!minimumAgeError}
+        helperText={minimumAgeError || intl.formatMessage(messages.minimumAgeDescription)}
+        onChange={onChange}
+      />
+      <Input
+        data-test-id="time-zone-input"
+        name="timeZone"
+        label={intl.formatMessage(messages.timeZoneLabel)}
+        value={data.timeZone}
+        disabled={disabled}
+        error={!!timeZoneError}
+        helperText={timeZoneError || intl.formatMessage(messages.timeZoneDescription)}
+        onChange={onChange}
+      />
+    </Box>
+  );
+};
