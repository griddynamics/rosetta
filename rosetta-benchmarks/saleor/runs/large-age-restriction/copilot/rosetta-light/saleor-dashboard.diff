+import { ThemeProvider } from "@saleor/macaw-ui-next";
+import { fireEvent, render, screen, within } from "@testing-library/react";
+import type { ReactNode } from "react";
+import { IntlProvider } from "react-intl";
+
+import { AgeRestrictedSetting } from "./AgeRestrictedSetting";
+
+const Wrapper = ({ children }: { children: ReactNode }): ReactNode => (
+  <IntlProvider defaultLocale="en" locale="en">
+    <ThemeProvider>{children}</ThemeProvider>
+  </IntlProvider>
+);
+
+describe("AgeRestrictedSetting", () => {
+  it("renders the saved value and reports a toggle", () => {
+    // Arrange
+    const onCheckedChange = jest.fn();
+
+    render(<AgeRestrictedSetting checked={false} onCheckedChange={onCheckedChange} />, {
+      wrapper: Wrapper,
+    });
+
+    // Act
+    const checkbox = within(screen.getByTestId("age-restricted-checkbox")).getByRole("checkbox");
+
+    fireEvent.click(checkbox);
+
+    // Assert
+    expect(checkbox).not.toBeChecked();
+    expect(onCheckedChange).toHaveBeenCalledWith(true);
+  });
+
+  it("disables the control while the product form is disabled", () => {
+    // Arrange & Act
+    render(<AgeRestrictedSetting checked disabled onCheckedChange={jest.fn()} />, {
+      wrapper: Wrapper,
+    });
+
+    // Assert
+    expect(
+      within(screen.getByTestId("age-restricted-checkbox")).getByRole("checkbox"),
+    ).toBeDisabled();
+  });
+});
