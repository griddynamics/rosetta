+
+import { messages } from "./messages";
+import { SiteAgeRestrictionFields } from "./SiteAgeRestrictionFields";
+
+interface SiteAgeRestrictionSectionProps {
+  data: {
+    minimumAge: string;
+    timeZone: string;
+  };
+  errors: ShopErrorFragment[];
+  disabled: boolean;
+  showValidationErrors: boolean;
+  onChange: FormChange;
+}
+
+export const SiteAgeRestrictionSection = ({
+  data,
+  errors,
+  disabled,
+  showValidationErrors,
+  onChange,
+}: SiteAgeRestrictionSectionProps): ReactNode => {
+  const intl = useIntl();
+
+  if (isStagingSchema()) {
+    return null;
+  }
+
+  return (
+    <SettingsSection
+      id="age-restrictions"
+      data-test-id="age-restrictions-settings"
+      ownership="shop"
+      title={intl.formatMessage(messages.sectionAgeRestrictionsTitle)}
+      description={intl.formatMessage(messages.sectionAgeRestrictionsDescription)}
+    >
+      <SettingsFieldStack>
+        <SiteAgeRestrictionFields
+          data={data}
+          errors={errors}
+          disabled={disabled}
+          showValidationErrors={showValidationErrors}
+          onChange={onChange}
+        />
+      </SettingsFieldStack>
+    </SettingsSection>
+  );
+};
