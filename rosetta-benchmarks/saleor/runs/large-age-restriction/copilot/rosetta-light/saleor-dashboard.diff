diff --git a/src/siteSettings/components/SiteSettingsPage/ageRestrictionFormHandlers.ts b/src/siteSettings/components/SiteSettingsPage/ageRestrictionFormHandlers.ts
new file mode 100644
index 0000000..0c6bea5
--- /dev/null
+++ b/src/siteSettings/components/SiteSettingsPage/ageRestrictionFormHandlers.ts
@@ -0,0 +1,44 @@
+import { type FormChange } from "@dashboard/hooks/useForm";
+import { type IntlShape } from "react-intl";
+
+import { isValidIanaTimezone, isValidMinimumAge } from "./ageRestrictionValidation";
+import { messages } from "./messages";
+
+type AgeRestrictionField = "minimumAge" | "timeZone";
+
+interface CreateAgeRestrictionChangeHandlerArgs {
+  change: FormChange;
+  clearErrors: (field: AgeRestrictionField) => void;
+  intl: IntlShape;
+  onValidationAttempt: () => void;
+  setError: (field: AgeRestrictionField, error: string) => void;
+}
+
+export const createAgeRestrictionChangeHandler =
+  ({
+    change,
+    clearErrors,
+    intl,
+    onValidationAttempt,
+    setError,
+  }: CreateAgeRestrictionChangeHandlerArgs): FormChange =>
+  event => {
+    const { name, value } = event.target;
+
+    change(event);
+    onValidationAttempt();
+
+    if (name === "minimumAge") {
+      if (isValidMinimumAge(String(value))) {
+        clearErrors("minimumAge");
+      } else {
+        setError("minimumAge", intl.formatMessage(messages.invalidMinimumAge));
+      }
+    } else if (name === "timeZone") {
+      if (isValidIanaTimezone(String(value))) {
+        clearErrors("timeZone");
+      } else {
+        setError("timeZone", intl.formatMessage(messages.invalidTimeZone));
+      }
+    }
+  };
diff --git a/src/siteSettings/components/SiteSettingsPage/ageRestrictionValidation.ts b/src/siteSettings/components/SiteSettingsPage/ageRestrictionValidation.ts
new file mode 100644
index 0000000..1dbe90e
--- /dev/null
+++ b/src/siteSettings/components/SiteSettingsPage/ageRestrictionValidation.ts
@@ -0,0 +1,45 @@
+export const isValidMinimumAge = (value: string): boolean => {
+  if (!/^\d+$/.test(value)) {
+    return false;
+  }
+
+  const minimumAge = Number(value);
+
+  return Number.isInteger(minimumAge) && minimumAge >= 0 && minimumAge <= 150;
+};
+
+export const isValidIanaTimezone = (value: string): boolean => {
+  if (!value || value.trim() !== value) {
+    return false;
+  }
+
+  try {
+    new Intl.DateTimeFormat("en-US", { timeZone: value }).format(0);
+
+    return true;
+  } catch {
+    return false;
+  }
+};
+
+export const isValidAgeRestrictionSettings = (
+  minimumAge: string,
+  timeZone: string,
+  isAvailable: boolean,
+): boolean => !isAvailable || (isValidMinimumAge(minimumAge) && isValidIanaTimezone(timeZone));
+
+export const getInitialAgeRestrictionFormData = (
+  shop?: { minimumAge?: number | null; timeZone?: string | null } | null,
+): { minimumAge: string; timeZone: string } => ({
+  minimumAge: String(shop?.minimumAge ?? 18),
+  timeZone: shop?.timeZone ?? "UTC",
+});
+
+export const isAgeRestrictionSaveDisabled = (
+  isFormSaveDisabled: boolean | undefined,
+  minimumAge: string,
+  timeZone: string,
+  settingsAvailable: boolean,
+): boolean =>
+  Boolean(isFormSaveDisabled) ||
+  !isValidAgeRestrictionSettings(minimumAge, timeZone, settingsAvailable);
