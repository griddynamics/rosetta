+import { describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import {
+	AGE_RESTRICTED_CODE,
+	ageRestrictionGuidanceFor,
+	buildBirthdayAccountInput,
+	hasAgeRestrictedError,
+	isFutureDateInput,
+} from "./age-restrictions";
+
+describe("age restriction UI contracts", () => {
+	it("detects the structured restriction code without inspecting messages", () => {
+		expect(hasAgeRestrictedError([{ code: AGE_RESTRICTED_CODE }])).toBe(true);
+		expect(hasAgeRestrictedError([{ code: "INVALID" }])).toBe(false);
+		expect(hasAgeRestrictedError(undefined)).toBe(false);
+	});
+
+	it("checks future calendar dates without calculating age", () => {
+		expect(isFutureDateInput("2026-11-06", "2026-11-05")).toBe(true);
+		expect(isFutureDateInput("2026-11-05", "2026-11-05")).toBe(false);
+		expect(isFutureDateInput("not-a-date", "2026-11-05")).toBe(false);
+	});
+
+	it("routes generic action guidance from session state only", () => {
+		expect(ageRestrictionGuidanceFor("guest", "/login", "/account/settings")).toEqual({
+			messageKey: "guestGuidance",
+			linkKey: "signIn",
+			href: "/login",
+		});
+		expect(ageRestrictionGuidanceFor("authenticated", "/login", "/account/settings")).toEqual({
+			messageKey: "accountGuidance",
+			linkKey: "accountSettings",
+			href: "/account/settings",
+		});
+		expect(ageRestrictionGuidanceFor("unavailable", "/login", "/account/settings")).toEqual({
+			messageKey: "genericGuidance",
+			linkKey: null,
+			href: null,
+		});
+	});
+
+	it("sends an explicit clear flag and never serializes a null birthday", () => {
+		expect(buildBirthdayAccountInput("", true)).toEqual({ clearBirthday: true });
+		expect(buildBirthdayAccountInput("2000-01-02", false)).toEqual({ birthday: "2000-01-02" });
+		expect(buildBirthdayAccountInput("", false)).toBeNull();
+	});
+
+	it("keeps birthday private to the account profile query", () => {
+		const cartQuery = readFileSync(new URL("../graphql/CheckoutFind.graphql", import.meta.url), "utf8");
+		const checkoutQuery = readFileSync(
+			new URL("../checkout/graphql/checkout.graphql", import.meta.url),
+			"utf8",
+		);
+		const profileQuery = readFileSync(
+			new URL("../graphql/CurrentUserProfile.graphql", import.meta.url),
+			"utf8",
+		);
+
+		expect(profileQuery).toMatch(/\bbirthday\b/);
+		expect(cartQuery).not.toMatch(/\bbirthday\b/i);
+		expect(checkoutQuery).not.toMatch(/\bbirthday\b/i);
+		expect(`${cartQuery}\n${checkoutQuery}`).not.toMatch(/\btimeZone\b/i);
+	});
+
+	it("provides localized labels and guidance in every enabled locale", () => {
+		const locales = ["de", "en", "fi", "fr", "ja", "ko", "nb", "pl"] as const;
+		for (const locale of locales) {
+			const messages = JSON.parse(
+				readFileSync(new URL(`../../messages/${locale}.json`, import.meta.url), "utf8"),
+			) as { ageRestriction: Record<string, string> };
+			expect(messages.ageRestriction.label).toBe("{minimumAge}+");
+			expect(messages.ageRestriction.genericGuidance).toBeTruthy();
+			expect(messages.ageRestriction.birthdayFuture).toBeTruthy();
+			expect(messages.ageRestriction.genericGuidance).not.toMatch(/\d/);
+		}
+	});
+});
diff --git a/src/lib/age-restrictions.ts b/src/lib/age-restrictions.ts
new file mode 100644
index 0000000..d3221c8
--- /dev/null
+++ b/src/lib/age-restrictions.ts
@@ -0,0 +1,44 @@
+import type { AccountInput } from "@/gql/graphql";
+
+export const AGE_RESTRICTED_CODE = "AGE_RESTRICTED" as const;
+
+export type AgeRestrictionSessionState = "guest" | "authenticated" | "unavailable";
+
+export function ageRestrictionGuidanceFor(
+	sessionState: AgeRestrictionSessionState,
+	signInHref: string,
+	accountSettingsHref: string,
+) {
+	if (sessionState === "guest") {
+		return { messageKey: "guestGuidance" as const, linkKey: "signIn" as const, href: signInHref };
+	}
+	if (sessionState === "authenticated") {
+		return {
+			messageKey: "accountGuidance" as const,
+			linkKey: "accountSettings" as const,
+			href: accountSettingsHref,
+		};
+	}
+	return { messageKey: "genericGuidance" as const, linkKey: null, href: null };
+}
+
+export function hasAgeRestrictedError(
+	errors: readonly { code?: string | null }[] | null | undefined,
+): boolean {
+	return errors?.some((error) => error.code === AGE_RESTRICTED_CODE) ?? false;
+}
+
+/** Calendar-date comparison only; this does not calculate age or purchase eligibility. */
+export function isFutureDateInput(value: string, today: string): boolean {
+	return /^\d{4}-\d{2}-\d{2}$/.test(value) && value > today;
+}
+
+/** Preserve the API's explicit-clear contract. Never send birthday:null. */
+export function buildBirthdayAccountInput(value: string, clear: boolean): AccountInput | null {
+	if (clear) {
+		return { clearBirthday: true };
+	}
+
+	const birthday = value.trim();
+	return birthday ? { birthday } : null;
+}
