new file mode 100644
index 0000000..93355bb
--- /dev/null
+++ b/src/ui/components/age-restriction-guidance.tsx
@@ -0,0 +1,33 @@
+"use client";
+
+import Link from "next/link";
+import { useTranslations } from "next-intl";
+import { ageRestrictionGuidanceFor, type AgeRestrictionSessionState } from "@/lib/age-restrictions";
+
+type AgeRestrictionGuidanceProps = {
+	sessionState: AgeRestrictionSessionState;
+	signInHref: string;
+	accountSettingsHref: string;
+};
+
+/** Generic action guidance. It intentionally contains no birthday, age, or threshold. */
+export function AgeRestrictionGuidance({
+	sessionState,
+	signInHref,
+	accountSettingsHref,
+}: AgeRestrictionGuidanceProps) {
+	const t = useTranslations("ageRestriction");
+	const guidance = ageRestrictionGuidanceFor(sessionState, signInHref, accountSettingsHref);
+
+	return (
+		<div role="alert" className="space-y-1 text-sm text-destructive">
+			<p>{t("genericGuidance")}</p>
+			{sessionState !== "unavailable" ? <p>{t(guidance.messageKey)}</p> : null}
+			{guidance.href && guidance.linkKey ? (
+				<Link href={guidance.href} className="font-medium underline underline-offset-2">
+					{t(guidance.linkKey)}
+				</Link>
+			) : null}
+		</div>
+	);
+}
