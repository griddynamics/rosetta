+import { useActionState, type ReactNode } from "react";
+import type { AddVariantToCartResult } from "@/app/actions";
+import { AGE_RESTRICTED_CODE } from "@/lib/age-restrictions";
+import { AgeRestrictionGuidance } from "@/ui/components/age-restriction-guidance";
+import type { AgeRestrictionSessionState } from "@/lib/age-restrictions";
+
+type AddToCartState = AddVariantToCartResult | null;
+type AddToCartAction = (state: AddToCartState, formData: FormData) => Promise<AddVariantToCartResult>;
+
+type AddToCartFormProps = {
+	action: AddToCartAction;
+	sessionState: AgeRestrictionSessionState;
+	signInHref: string;
+	accountSettingsHref: string;
+	children: ReactNode;
+};
+
+/** Keeps the main and sticky purchase buttons in one action/status form. */
+export function AddToCartForm({
+	action,
+	sessionState,
+	signInHref,
+	accountSettingsHref,
+	children,
+}: AddToCartFormProps) {
+	const [result, formAction] = useActionState<AddToCartState, FormData>(action, null);
+
+	return (
+		<form action={formAction} className="order-3 mt-4 space-y-6">
+			{children}
+			{result?.ok === false && result.errorCode === AGE_RESTRICTED_CODE ? (
+				<AgeRestrictionGuidance
+					sessionState={sessionState}
+					signInHref={signInHref}
+					accountSettingsHref={accountSettingsHref}
+				/>
+			) : null}
+		</form>
+	);
+}
