+/** Birthday is written only through this owner-only settings action. */
+export async function updateBirthday(formData: FormData): Promise<BirthdayActionResult> {
+	const clear = formData.get("clearBirthday") === "true";
+	const birthdayValue = formData.get("birthday");
+	const input = buildBirthdayAccountInput(typeof birthdayValue === "string" ? birthdayValue : "", clear);
+	if (!input) {
+		return { success: false, errorCode: "INVALID" };
+	}
+
+	const result = await mutate(AccountUpdateDocument, {
+		variables: { input: input satisfies AccountInput },
+	});
+
+	if (!result.ok) {
+		return { success: false, errorCode: "FAILED" };
+	}
+
+	const errors = result.data.accountUpdate?.errors;
+	if (errors?.length) {
+		const birthdayError = errors.find((error) => error.field === "birthday");
+		return birthdayError?.code === "INVALID"
+			? { success: false, errorCode: "INVALID" }
+			: { success: false, errorCode: "FAILED" };
+	}
+
+	revalidateAccountLayout();
+	return { success: true, cleared: input.clearBirthday === true };
+}
