diff --git a/src/ui/components/account/birthday-form.tsx b/src/ui/components/account/birthday-form.tsx
new file mode 100644
index 0000000..84b8fa6
--- /dev/null
+++ b/src/ui/components/account/birthday-form.tsx
@@ -0,0 +1,110 @@
+"use client";
+
+import { useState, useTransition } from "react";
+import { useRouter } from "next/navigation";
+import { useTranslations } from "next-intl";
+import { Button } from "@/ui/components/ui/button";
+import { Input } from "@/ui/components/ui/input";
+import { Label } from "@/ui/components/ui/label";
+import { updateBirthday } from "@/app/(storefront)/[locale]/[channel]/(main)/account/actions";
+import type { BirthdayActionResult } from "@/ui/components/account/account-action-result";
+import { isFutureDateInput } from "@/lib/age-restrictions";
+
+function todayAsDateInput(): string {
+	return new Date().toISOString().slice(0, 10);
+}
+
+export function BirthdayForm({ birthday }: { birthday: string | null }) {
+	const tAge = useTranslations("ageRestriction");
+	const router = useRouter();
+	const [isPending, startTransition] = useTransition();
+	const [error, setError] = useState("");
+	const [success, setSuccess] = useState("");
+
+	const submit = (formData: FormData) => {
+		const value = formData.get("birthday");
+		if (typeof value !== "string" || !value || isFutureDateInput(value, todayAsDateInput())) {
+			setError(tAge("birthdayFuture"));
+			setSuccess("");
+			return;
+		}
+
+		setError("");
+		setSuccess("");
+		startTransition(async () => {
+			const result = await updateBirthday(formData);
+			applyResult(result);
+		});
+	};
+
+	const clear = (formData: FormData) => {
+		formData.set("clearBirthday", "true");
+		setError("");
+		setSuccess("");
+		startTransition(async () => {
+			const result = await updateBirthday(formData);
+			applyResult(result);
+		});
+	};
+
+	function applyResult(result: BirthdayActionResult) {
+		if (!result.success) {
+			setError(tAge(result.errorCode === "INVALID" ? "birthdayFuture" : "birthdayFailed"));
+			return;
+		}
+		setSuccess(result.cleared ? tAge("birthdayCleared") : tAge("birthdayUpdated"));
+		router.refresh();
+	}
+
+	return (
+		<section className="space-y-3">
+			<div>
+				<h2 className="font-medium">{tAge("birthdayTitle")}</h2>
+				<p className="mt-1 text-sm text-muted-foreground">{tAge("birthdayDescription")}</p>
+			</div>
+			<form action={submit} className="space-y-3">
+				<div className="max-w-sm space-y-1.5">
+					<Label htmlFor="account-birthday">{tAge("birthdayInputLabel")}</Label>
+					<Input
+						id="account-birthday"
+						name="birthday"
+						type="date"
+						defaultValue={birthday ?? ""}
+						max={todayAsDateInput()}
+						required
+						autoComplete="bday"
+						disabled={isPending}
+						aria-invalid={Boolean(error)}
+					/>
+				</div>
+				{error ? (
+					<p role="alert" className="text-sm text-destructive">
+						{error}
+					</p>
+				) : null}
+				{success ? (
+					<p aria-live="polite" className="text-sm text-green-600">
+						{success}
+					</p>
+				) : null}
+				<div className="flex flex-wrap gap-2">
+					<Button type="submit" size="sm" disabled={isPending}>
+						{isPending ? tAge("birthdaySaving") : tAge("birthdaySave")}
+					</Button>
+					{birthday ? (
+						<Button
+							type="submit"
+							formAction={clear}
+							formNoValidate
+							variant="ghost"
+							size="sm"
+							disabled={isPending}
+						>
+							{isPending ? tAge("birthdayClearing") : tAge("birthdayClear")}
+						</Button>
+					) : null}
+				</div>
+			</form>
+		</section>
+	);
+}
