+import graphene
+
+from .....account import CustomerEvents
+from .....account.models import CustomerEvent
+from ....tests.utils import get_graphql_content, get_graphql_content_from_response
+
+ME_BIRTHDAY_QUERY = """
+query { me { birthday } }
+"""
+
+USER_BIRTHDAY_QUERY = """
+query UserBirthday($id: ID!) {
+  user(id: $id) { birthday }
+}
+"""
+
+SUPERUSER_DUPLICATE_BIRTHDAY_QUERY = """
+query UserBirthday($id: ID!) {
+  first: user(id: $id) { birthday }
+  second: user(id: $id) { birthday }
+}
+"""
+
+
+def test_owner_can_read_own_birthday(user_api_client):
+    birthday = "2000-01-01"
+    user_api_client.user.birthday = birthday
+    user_api_client.user.save(update_fields=["birthday"])
+
+    response = user_api_client.post_graphql(ME_BIRTHDAY_QUERY)
+    data = get_graphql_content(response)["data"]["me"]
+
+    assert data["birthday"] == birthday
+    assert not CustomerEvent.objects.filter(
+        user=user_api_client.user, type=CustomerEvents.BIRTHDAY_VIEWED
+    ).exists()
+
+
+def test_staff_without_superuser_status_cannot_read_birthday(
+    staff_api_client, customer_user, permission_manage_users
+):
+    customer_id = graphene.Node.to_global_id("User", customer_user.pk)
+    response = staff_api_client.post_graphql(
+        USER_BIRTHDAY_QUERY,
+        {"id": customer_id},
+        permissions=[permission_manage_users],
+    )
+    content = get_graphql_content_from_response(response)
+
+    assert content["data"]["user"]["birthday"] is None
+    assert content["errors"]
+
+
+def test_app_cannot_read_birthday(
+    app_api_client, customer_user, permission_manage_users
+):
+    customer_id = graphene.Node.to_global_id("User", customer_user.pk)
+    response = app_api_client.post_graphql(
+        USER_BIRTHDAY_QUERY,
+        {"id": customer_id},
+        permissions=[permission_manage_users],
+    )
+    content = get_graphql_content_from_response(response)
+
+    assert content["data"]["user"]["birthday"] is None
+    assert content["errors"]
+
+
+def test_superuser_read_is_audited_once_per_subject_per_request(
+    superuser_api_client, customer_user
+):
+    birthday = "2000-01-01"
+    customer_user.birthday = birthday
+    customer_user.save(update_fields=["birthday"])
+    customer_id = graphene.Node.to_global_id("User", customer_user.pk)
+    superuser = superuser_api_client.user
+
+    response = superuser_api_client.post_graphql(
+        SUPERUSER_DUPLICATE_BIRTHDAY_QUERY,
+        {"id": customer_id},
+    )
+    data = get_graphql_content(response)["data"]
+
+    assert data["first"]["birthday"] == birthday
+    assert data["second"]["birthday"] == birthday
+    event = CustomerEvent.objects.get(
+        user=superuser, type=CustomerEvents.BIRTHDAY_VIEWED
+    )
+    assert event.parameters == {"account_id": customer_user.pk}
+    assert "birthday" not in event.parameters
+    assert (
+        CustomerEvent.objects.filter(
+            user=superuser,
+            type=CustomerEvents.BIRTHDAY_VIEWED,
+            parameters__account_id=customer_user.pk,
+        ).count()
+        == 1
+    )
