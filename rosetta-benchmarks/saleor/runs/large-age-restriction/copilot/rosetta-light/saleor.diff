diff --git a/saleor/graphql/shop/tests/mutations/test_age_restriction_settings.py b/saleor/graphql/shop/tests/mutations/test_age_restriction_settings.py
new file mode 100644
index 0000000..8eeecde
--- /dev/null
+++ b/saleor/graphql/shop/tests/mutations/test_age_restriction_settings.py
@@ -0,0 +1,116 @@
+import pytest
+
+from .....core.error_codes import ShopErrorCode
+from ....tests.utils import get_graphql_content
+
+SHOP_SETTINGS_UPDATE = """
+mutation ShopSettingsUpdate($input: ShopSettingsInput!) {
+  shopSettingsUpdate(input: $input) {
+    shop { minimumAge timeZone }
+    errors { field code message }
+  }
+}
+"""
+
+SHOP_MINIMUM_AGE_QUERY = """
+query { shop { minimumAge } }
+"""
+
+SHOP_TIME_ZONE_QUERY = """
+query { shop { timeZone } }
+"""
+
+
+def test_minimum_age_is_publicly_readable(api_client, site_settings):
+    response = api_client.post_graphql(SHOP_MINIMUM_AGE_QUERY)
+    data = get_graphql_content(response)["data"]["shop"]
+
+    assert data["minimumAge"] == 18
+
+
+@pytest.mark.parametrize("client_fixture", ["api_client", "user_api_client"])
+def test_time_zone_requires_manage_settings(request, client_fixture):
+    client = request.getfixturevalue(client_fixture)
+    response = client.post_graphql(SHOP_TIME_ZONE_QUERY)
+
+    assert response.status_code == 200
+    assert response.json()["errors"]
+
+
+def test_app_without_manage_settings_cannot_read_time_zone(app_api_client):
+    response = app_api_client.post_graphql(SHOP_TIME_ZONE_QUERY)
+
+    assert response.status_code == 200
+    assert response.json()["errors"]
+
+
+def test_manage_settings_user_can_read_time_zone(
+    staff_api_client, permission_manage_settings, site_settings
+):
+    response = staff_api_client.post_graphql(
+        SHOP_TIME_ZONE_QUERY,
+        permissions=[permission_manage_settings],
+    )
+    data = get_graphql_content(response)["data"]["shop"]
+
+    assert data["timeZone"] == "UTC"
+
+
+def test_shop_settings_update_validates_and_persists_age_policy(
+    staff_api_client, permission_manage_settings, site_settings
+):
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_UPDATE,
+        {"input": {"minimumAge": 21, "timeZone": "Europe/Belgrade"}},
+        permissions=[permission_manage_settings],
+    )
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+
+    assert data["errors"] == []
+    assert data["shop"] == {"minimumAge": 21, "timeZone": "Europe/Belgrade"}
+    site_settings.refresh_from_db()
+    assert site_settings.minimum_age == 21
+    assert site_settings.time_zone == "Europe/Belgrade"
+
+
+@pytest.mark.parametrize("minimum_age", [0, 150])
+def test_shop_settings_accepts_minimum_age_range_boundaries(
+    staff_api_client, permission_manage_settings, minimum_age
+):
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_UPDATE,
+        {"input": {"minimumAge": minimum_age}},
+        permissions=[permission_manage_settings],
+    )
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+
+    assert data["errors"] == []
+    assert data["shop"]["minimumAge"] == minimum_age
+
+
+@pytest.mark.parametrize(
+    ("field", "value", "expected_field"),
+    [
+        ("minimumAge", -1, "minimumAge"),
+        ("minimumAge", None, "minimumAge"),
+        ("minimumAge", 151, "minimumAge"),
+        ("timeZone", "../etc", "timeZone"),
+        ("timeZone", "UTC; DROP", "timeZone"),
+    ],
+)
+def test_shop_settings_reject_invalid_age_and_time_zone(
+    staff_api_client,
+    permission_manage_settings,
+    field,
+    value,
+    expected_field,
+):
+    response = staff_api_client.post_graphql(
+        SHOP_SETTINGS_UPDATE,
+        {"input": {field: value}},
+        permissions=[permission_manage_settings],
+    )
+    data = get_graphql_content(response)["data"]["shopSettingsUpdate"]
+
+    assert data["errors"][0]["field"] == expected_field
+    assert data["errors"][0]["code"] == ShopErrorCode.INVALID.name
