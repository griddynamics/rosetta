+ACCOUNT_BIRTHDAY_UPDATE = """
+mutation AccountUpdate($input: AccountInput!, $customerId: ID) {
+  accountUpdate(input: $input, customerId: $customerId) {
+    user { birthday }
+    errors { field code message }
+  }
+}
+"""
+
+CUSTOMER_BIRTHDAY_UPDATE_SET = """
+mutation CustomerBirthdayUpdate($id: ID!, $birthday: Date) {
+  customerBirthdayUpdate(id: $id, birthday: $birthday) {
+    user { id birthday }
+    errors { field code message }
+  }
+}
+"""
+
+CUSTOMER_BIRTHDAY_UPDATE_SET_AND_FLAG = """
+mutation CustomerBirthdayUpdate(
+  $id: ID!, $birthday: Date, $clearBirthday: Boolean
+) {
+  customerBirthdayUpdate(
+    id: $id, birthday: $birthday, clearBirthday: $clearBirthday
+  ) {
+    user { id birthday }
+    errors { field code message }
+  }
+}
+"""
+
+CUSTOMER_BIRTHDAY_UPDATE_CLEAR_FLAG = """
+mutation CustomerBirthdayUpdate($id: ID!, $clearBirthday: Boolean) {
+  customerBirthdayUpdate(id: $id, clearBirthday: $clearBirthday) {
+    user { id birthday }
+    errors { field code message }
+  }
+}
+"""
+
+CUSTOMER_BIRTHDAY_UPDATE_EMPTY = """
+mutation CustomerBirthdayUpdate($id: ID!) {
+  customerBirthdayUpdate(id: $id) {
+    user { id birthday }
+    errors { field code message }
+  }
+}
+"""
+
+STAFF_CUSTOMER_UPDATE_WITH_BIRTHDAY = """
+mutation CustomerUpdate($id: ID!, $input: CustomerInput!) {
+  customerUpdate(id: $id, input: $input) {
+    errors { field code message }
+  }
+}
+"""
+
+
+def test_owner_can_set_and_explicitly_clear_birthday_with_value_free_audit(
+    user_api_client,
+):
+    user = user_api_client.user
+    birthday = "2000-01-01"
+
+    response = user_api_client.post_graphql(
+        ACCOUNT_BIRTHDAY_UPDATE, {"input": {"birthday": birthday}}
+    )
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+
+    assert data["errors"] == []
+    assert data["user"]["birthday"] == birthday
+    user.refresh_from_db()
+    assert user.birthday.isoformat() == birthday
+    assert CustomerEvent.objects.get(
+        user=user, type=CustomerEvents.BIRTHDAY_UPDATED
+    ).parameters == {"actor": "owner", "operation": "set"}
+
+    response = user_api_client.post_graphql(
+        ACCOUNT_BIRTHDAY_UPDATE, {"input": {"clearBirthday": True}}
+    )
+    data = get_graphql_content(response)["data"]["accountUpdate"]
+
+    assert data["errors"] == []
+    user.refresh_from_db()
+    assert user.birthday is None
+    events = CustomerEvent.objects.filter(
+        user=user, type=CustomerEvents.BIRTHDAY_UPDATED
+    )
+    assert list(events.values_list("parameters", flat=True)) == [
+        {"actor": "owner", "operation": "set"},
+        {"actor": "owner", "operation": "clear"},
+    ]
+
+
+def test_account_update_omission_and_false_clear_flag_are_no_op(user_api_client):
+    user = user_api_client.user
+    user.birthday = "2000-01-01"
+    user.save(update_fields=["birthday"])
+    original_first_name = user.first_name
+
+    for input_data in ({"firstName": "Updated"}, {"clearBirthday": False}):
+        response = user_api_client.post_graphql(
+            ACCOUNT_BIRTHDAY_UPDATE, {"input": input_data}
+        )
+        data = get_graphql_content(response)["data"]["accountUpdate"]
+        assert data["errors"] == []
+
+    user.refresh_from_db()
+    assert user.birthday.isoformat() == "2000-01-01"
+    assert user.first_name != original_first_name
+    assert not CustomerEvent.objects.filter(
+        user=user, type=CustomerEvents.BIRTHDAY_UPDATED
+    ).exists()
+
+
+@pytest.mark.parametrize(
