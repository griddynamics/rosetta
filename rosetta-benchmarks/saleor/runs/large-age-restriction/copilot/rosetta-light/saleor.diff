index 0000000..91564fa
--- /dev/null
+++ b/saleor/graphql/account/mutations/account/customer_birthday_update.py
@@ -0,0 +1,171 @@
+from datetime import date
+from typing import Literal
+
+import graphene
+from django.core.exceptions import ValidationError
+
+from .....account import events as account_events
+from .....account import models as account_models
+from .....account.error_codes import AccountErrorCode
+from .....core.exceptions import PermissionDenied
+from .....core.tracing import traced_atomic_transaction
+from ....core import ResolveInfo
+from ....core.context import SaleorContext
+from ....core.descriptions import ADDED_IN_323
+from ....core.doc_category import DOC_CATEGORY_USERS
+from ....core.mutations import BaseMutation
+from ....core.scalars import Date
+from ....core.types import AccountError
+from ....site.dataloaders import get_site_promise
+from ...types import User
+from .utils import validate_birthday
+
+
+def is_active_superuser(context: SaleorContext) -> bool:
+    requestor = context.user
+    return bool(
+        not context.app and requestor and requestor.is_active and requestor.is_superuser
+    )
+
+
+def save_customer_birthday(
+    user: account_models.User,
+    birthday: date | None,
+    actor: account_models.User,
+    operation: Literal["set", "clear"],
+) -> None:
+    user.birthday = birthday
+    user.save(update_fields=["birthday", "updated_at"])
+    account_events.customer_birthday_updated_event(
+        actor=actor,
+        account_id=user.pk,
+        operation=operation,
+    )
+
+
+class CustomerBirthdayUpdate(BaseMutation):
+    user = graphene.Field(User, description="The user with the updated birthday.")
+
+    class Arguments:
+        id = graphene.ID(required=True, description="ID of the customer.")
+        birthday = Date(
+            required=False,
+            description="Birthday to set." + ADDED_IN_323,
+        )
+        clear_birthday = graphene.Boolean(
+            description="Set to true to clear the birthday." + ADDED_IN_323,
+        )
+
+    class Meta:
+        description = (
+            "Sets or clears another user's birthday. Requires an active superuser."
+        )
+        doc_category = DOC_CATEGORY_USERS
+        error_type_class = AccountError
+
+    @classmethod
+    def check_permissions(
+        cls, context, permissions=None, require_all_permissions=False, **_data
+    ):
+        return is_active_superuser(context)
+
+    @staticmethod
+    def argument_was_provided(info: ResolveInfo, name: str) -> bool:
+        for field_node in info.field_asts:
+            for argument in field_node.arguments or []:
+                if argument.name.value == name:
+                    return True
+        return False
+
+    @classmethod
+    @traced_atomic_transaction()
+    def perform_mutation(cls, _root, info: ResolveInfo, /, **data):
+        birthday_present = "birthday" in data
+        clear_birthday_present = "clear_birthday" in data
+        birthday_argument_present = cls.argument_was_provided(info, "birthday")
+        clear_birthday_argument_present = cls.argument_was_provided(
+            info, "clearBirthday"
+        )
+
+        if birthday_argument_present and not birthday_present:
+            raise ValidationError(
+                {
+                    "birthday": ValidationError(
+                        "Birthday cannot be null.",
+                        code=AccountErrorCode.INVALID.value,
+                    )
+                }
+            )
+        if birthday_present and data["birthday"] is None:
+            raise ValidationError(
+                {
+                    "birthday": ValidationError(
+                        "Birthday cannot be null.",
+                        code=AccountErrorCode.INVALID.value,
+                    )
+                }
+            )
+        if clear_birthday_argument_present and not clear_birthday_present:
+            raise ValidationError(
+                {
+                    "clear_birthday": ValidationError(
+                        "clearBirthday cannot be null.",
+                        code=AccountErrorCode.INVALID.value,
+                    )
+                }
+            )
+        if clear_birthday_present and data["clear_birthday"] is None:
+            raise ValidationError(
+                {
+                    "clear_birthday": ValidationError(
+                        "clearBirthday cannot be null.",
+                        code=AccountErrorCode.INVALID.value,
+                    )
+                }
+            )
+
+        birthday = data.get("birthday")
+        clear_birthday = data.get("clear_birthday")
+        if birthday_present and clear_birthday is True:
+            raise ValidationError(
+                {
+                    "clear_birthday": ValidationError(
+                        "Birthday and clearBirthday cannot be provided together.",
+                        code=AccountErrorCode.INVALID.value,
+                    )
+                }
+            )
+        if not birthday_present and clear_birthday is not True:
+            raise ValidationError(
+                {
+                    "birthday": ValidationError(
+                        "Provide a birthday or set clearBirthday to true.",
+                        code=AccountErrorCode.INVALID.value,
+                    )
+                }
+            )
+
+        operation: Literal["set", "clear"] = (
+            "clear" if clear_birthday is True else "set"
+        )
+        if operation == "set":
+            site = get_site_promise(info.context).get()
+            validate_birthday(birthday, site.settings.time_zone)
+
+        user = cls.get_node_or_error(info, data["id"], only_type=User)
+
+        actor = info.context.user
+        if (
+            info.context.app
+            or not actor
+            or not actor.is_active
+            or not actor.is_superuser
+        ):
+            raise PermissionDenied()
+        save_customer_birthday(
+            user=user,
+            birthday=None if operation == "clear" else birthday,
+            actor=actor,
+            operation=operation,
+        )
+        return cls(user=user, errors=[])
