+def test_checkout_payment_create_rejects_restricted_buyer_before_payment_creation(
+    user_api_client,
+    checkout_without_shipping_required,
+    address,
+    customer_user,
+):
+    # Scenario: a missing birthday blocks legacy payment initiation before any payment.
+    # Client -> checkoutPaymentCreate -> policy -> payment creation (must stop).
+    checkout = checkout_without_shipping_required
+    checkout.billing_address = address
+    checkout.email = customer_user.email
+    checkout.user = customer_user
+    checkout.save()
+    customer_user.birthday = None
+    customer_user.save(update_fields=["birthday"])
+    product = checkout.lines.first().variant.product
+    product.age_restricted = True
+    product.save(update_fields=["age_restricted"])
+    payments_count = Payment.objects.count()
+    manager = get_plugins_manager(allow_replica=False)
+    lines, _ = fetch_checkout_lines(checkout)
+    checkout_info = fetch_checkout_info(checkout, lines, manager)
+    total = calculations.calculate_checkout_total(
+        manager=manager, checkout_info=checkout_info, lines=lines
+    )
+
+    response = user_api_client.post_graphql(
+        CREATE_PAYMENT_MUTATION,
+        {
+            "id": to_global_id_or_none(checkout),
+            "input": {
+                "gateway": DUMMY_GATEWAY,
+                "token": "sample-token",
+                "amount": total.gross.amount,
+            },
+        },
+    )
+
+    content = get_graphql_content(response)
+    data = content["data"]["checkoutPaymentCreate"]
+    assert data["payment"] is None
+    assert data["errors"][0]["code"] == PaymentErrorCode.AGE_RESTRICTED.name
+    assert Payment.objects.count() == payments_count
+
