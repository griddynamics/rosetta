diff --git a/saleor/account/age_restriction.py b/saleor/account/age_restriction.py
new file mode 100644
index 0000000..a648e58
--- /dev/null
+++ b/saleor/account/age_restriction.py
@@ -0,0 +1,68 @@
+from __future__ import annotations
+
+from collections.abc import Iterable
+from datetime import UTC, date, datetime
+from typing import TYPE_CHECKING
+from zoneinfo import ZoneInfo
+
+from django.core.exceptions import ValidationError
+from django.utils import timezone as django_timezone
+
+if TYPE_CHECKING:
+    from ..product.models import Product
+    from ..site.models import SiteSettings
+    from .models import User
+
+
+AGE_RESTRICTED_MESSAGE = "Some items can't be purchased by this account."
+
+
+def shop_today(time_zone: str, now: datetime | None = None) -> date:
+    """Return the current date in the shop's IANA time zone."""
+    current_time = now or django_timezone.now()
+    if django_timezone.is_naive(current_time):
+        current_time = current_time.replace(tzinfo=UTC)
+    return current_time.astimezone(ZoneInfo(time_zone)).date()
+
+
+def age_on(birthday: date, today: date) -> int:
+    """Return completed years of age on a given date."""
+    # D3: Calendar-date comparison makes non-leap Feb 29 birthdays qualify Mar 1.
+    return (
+        today.year
+        - birthday.year
+        - ((today.month, today.day) < (birthday.month, birthday.day))
+    )
+
+
+def is_eligible(birthday: date | None, minimum_age: int, today: date) -> bool:
+    return birthday is not None and age_on(birthday, today) >= minimum_age
+
+
+def ensure_buyer_eligible(
+    buyer: User | None,
+    products: Iterable[Product],
+    site_settings: SiteSettings,
+    *,
+    error_code: str,
+    buyer_required: bool,
+) -> None:
+    """Validate a buyer only when an age-restricted product is present."""
+    if not any(product.age_restricted for product in products):
+        return
+
+    if buyer is None:
+        if not buyer_required:
+            return
+        eligible = False
+    else:
+        eligible = is_eligible(
+            buyer.birthday,
+            site_settings.minimum_age,
+            shop_today(site_settings.time_zone),
+        )
+
+    if not eligible:
+        raise ValidationError(
+            {"lines": ValidationError(AGE_RESTRICTED_MESSAGE, code=error_code)}
+        )
