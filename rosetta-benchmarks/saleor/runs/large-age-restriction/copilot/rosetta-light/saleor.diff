+from datetime import UTC, date, datetime
+from types import SimpleNamespace
+
+import pytest
+from django.core.exceptions import ValidationError
+from freezegun import freeze_time
+
+from ..age_restriction import (
+    AGE_RESTRICTED_MESSAGE,
+    age_on,
+    ensure_buyer_eligible,
+    is_eligible,
+    shop_today,
+)
+
+
+def test_shop_today_uses_shop_time_zone():
+    now = datetime(2026, 11, 4, 23, 30, tzinfo=UTC)
+
+    assert shop_today("Europe/Belgrade", now) == date(2026, 11, 5)
+    assert shop_today("UTC", now) == date(2026, 11, 4)
+
+
+def test_shop_today_treats_naive_clock_as_utc():
+    now = datetime(2026, 11, 4, 23, 30, tzinfo=UTC).replace(tzinfo=None)
+
+    assert shop_today("Europe/Belgrade", now) == date(2026, 11, 5)
+
+
+def test_age_on_uses_completed_years():
+    assert age_on(date(2008, 11, 5), date(2026, 11, 5)) == 18
+    assert age_on(date(2008, 11, 6), date(2026, 11, 5)) == 17
+
+
+def test_leap_day_birthday_qualifies_on_march_first_in_non_leap_year():
+    birthday = date(2008, 2, 29)
+
+    assert not is_eligible(birthday, 18, date(2026, 2, 28))
+    assert is_eligible(birthday, 18, date(2026, 3, 1))
+
+
+def test_missing_birthday_is_not_eligible_even_when_minimum_age_is_zero():
+    assert not is_eligible(None, 0, date(2026, 11, 5))
+
+
+def test_unrestricted_products_do_not_require_a_buyer():
+    settings = SimpleNamespace(minimum_age=18, time_zone="UTC")
+
+    ensure_buyer_eligible(
+        None,
+        [SimpleNamespace(age_restricted=False)],
+        settings,
+        error_code="age_restricted",
+        buyer_required=True,
+    )
+
+
+def test_unlinked_draft_buyer_is_allowed_for_restricted_product():
+    settings = SimpleNamespace(minimum_age=18, time_zone="UTC")
+
+    ensure_buyer_eligible(
+        None,
+        [SimpleNamespace(age_restricted=True)],
+        settings,
+        error_code="age_restricted",
+        buyer_required=False,
+    )
+
+
+@pytest.mark.parametrize(
+    ("buyer", "minimum_age"),
+    [
+        (None, 18),
+        (SimpleNamespace(birthday=None), 18),
+        (SimpleNamespace(birthday=date(2008, 11, 6)), 18),
+        (SimpleNamespace(birthday=None), 0),
+    ],
+)
+@freeze_time("2026-11-05")
+def test_ineligible_restricted_buyer_gets_generic_lines_error(buyer, minimum_age):
+    settings = SimpleNamespace(minimum_age=minimum_age, time_zone="UTC")
+
+    with pytest.raises(ValidationError) as error:
+        ensure_buyer_eligible(
+            buyer,
+            [SimpleNamespace(age_restricted=True)],
+            settings,
+            error_code="age_restricted",
+            buyer_required=True,
+        )
+
+    validation_error = error.value.error_dict["lines"][0]
+    assert validation_error.code == "age_restricted"
+    assert validation_error.message == AGE_RESTRICTED_MESSAGE
+
+
+@freeze_time("2026-11-05")
+def test_eligible_restricted_buyer_is_allowed():
+    settings = SimpleNamespace(minimum_age=18, time_zone="UTC")
+
+    ensure_buyer_eligible(
+        SimpleNamespace(birthday=date(2008, 11, 5)),
+        [SimpleNamespace(age_restricted=True)],
+        settings,
+        error_code="age_restricted",
+        buyer_required=True,
+    )
