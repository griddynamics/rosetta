diff --git a/src/ui/components/pdp/product-attributes.test.ts b/src/ui/components/pdp/product-attributes.test.ts
new file mode 100644
index 0000000..d7bac03
--- /dev/null
+++ b/src/ui/components/pdp/product-attributes.test.ts
@@ -0,0 +1,58 @@
+import { type ComponentType, createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { NextIntlClientProvider } from "next-intl";
+import { describe, expect, it } from "vitest";
+
+import messages from "../../../../messages/en.json";
+import { ProductAttributes } from "./product-attributes";
+
+type Props = Parameters<typeof ProductAttributes>[0];
+
+// Loosened so children can be passed as a createElement argument (react/no-children-prop).
+const IntlProvider = NextIntlClientProvider as ComponentType<Record<string, unknown>>;
+
+function render(props: Partial<Props>): string {
+	return renderToStaticMarkup(
+		createElement(
+			IntlProvider,
+			{ locale: "en", messages },
+			createElement(ProductAttributes, {
+				policyLabels: {} as Props["policyLabels"],
+				...props,
+			}),
+		),
+	);
+}
+
+describe("ProductAttributes storage conditions", () => {
+	it("shows storage conditions in the description section", () => {
+		const html = render({
+			descriptionHtml: ["<p>Fresh milk</p>"],
+			storageConditions: "Keep refrigerated at 2–8 °C",
+		});
+
+		expect(html).toContain("Fresh milk");
+		expect(html).toContain("Storage conditions:");
+		expect(html).toContain("Keep refrigerated at 2–8 °C");
+	});
+
+	it("shows storage conditions even when the product has no description", () => {
+		const html = render({ descriptionHtml: null, storageConditions: "Keep dry" });
+
+		expect(html).toContain("Keep dry");
+	});
+
+	it("escapes storage conditions as plain text", () => {
+		const html = render({ storageConditions: "<script>alert(1)</script>" });
+
+		expect(html).not.toContain("<script>");
+		expect(html).toContain("&lt;script&gt;");
+	});
+
+	it("omits the storage conditions line when not set", () => {
+		const html = render({ descriptionHtml: ["<p>Fresh milk</p>"], storageConditions: null });
+
+		expect(html).toContain("Fresh milk");
+		expect(html).not.toContain("Storage conditions");
+	});
+});
