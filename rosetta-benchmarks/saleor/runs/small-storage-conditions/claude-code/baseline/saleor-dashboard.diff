+
+const intl = createIntl({ locale: "en" });
+
+describe("createGeneralNameDescriptionSection", () => {
+  it("does not add a storage conditions field by default", () => {
+    // Arrange / Act
+    const section = createGeneralNameDescriptionSection(intl, { name: "Milk" });
+
+    // Assert
+    expect(section.fields.map(field => field.name)).toEqual([
+      TranslationInputFieldName.name,
+      TranslationInputFieldName.description,
+    ]);
+  });
+
+  it("adds a storage conditions field with original and translated values", () => {
+    // Arrange / Act
+    const section = createGeneralNameDescriptionSection(
+      intl,
+      {
+        name: "Milk",
+        storageConditions: "Keep refrigerated at 2–8 °C",
+        translationStorageConditions: "Przechowywać w lodówce",
+      },
+      { storageConditionsLabel: "Storage conditions" },
+    );
+
+    // Assert
+    const field = section.fields.find(
+      field => field.name === TranslationInputFieldName.storageConditions,
+    );
+
+    expect(field).toMatchObject({
+      displayName: "Storage conditions",
+      value: "Keep refrigerated at 2–8 °C",
+      translation: "Przechowywać w lodówce",
+      type: "short",
+    });
+  });
+
+  it("falls back to empty original and null translation", () => {
+    // Arrange / Act
+    const section = createGeneralNameDescriptionSection(
+      intl,
+      { name: "Milk" },
+      { storageConditionsLabel: "Storage conditions" },
+    );
+
+    // Assert
+    const field = section.fields.find(
+      field => field.name === TranslationInputFieldName.storageConditions,
+    );
+
+    expect(field).toMatchObject({ value: "", translation: null });
+  });
+});
