+    products = [
+        {
+            "productType": product_type_id,
+            "category": category_id,
+            "name": "too long",
+            "storageConditions": "a" * 251,
+        },
+        {
+            "productType": product_type_id,
+            "category": category_id,
+            "name": "just right",
+            "storageConditions": "a" * 250,
+        },
+    ]
+
+    # when
+    staff_api_client.user.user_permissions.add(permission_manage_products)
+    response = staff_api_client.post_graphql(
+        PRODUCT_BULK_CREATE_MUTATION,
+        {"products": products, "errorPolicy": ErrorPolicyEnum.REJECT_FAILED_ROWS.name},
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productBulkCreate"]
+    assert data["count"] == 1
+    assert data["results"][0]["product"] is None
+    errors = data["results"][0]["errors"]
+    assert len(errors) == 1
+    assert errors[0]["path"] == "storageConditions"
+    assert errors[0]["code"] == ProductBulkCreateErrorCode.MAX_LENGTH.name
+    assert data["results"][1]["errors"] == []
+    assert Product.objects.filter(name="just right").exists()
+    assert not Product.objects.filter(name="too long").exists()
