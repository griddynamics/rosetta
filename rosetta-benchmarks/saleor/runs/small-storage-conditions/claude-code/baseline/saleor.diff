+def test_product_translate_storage_conditions_update_keeps_original_untouched(
+    staff_api_client,
+    product,
+    product_translation_fr,
+    permission_manage_translations,
+):
+    # given
+    product.storage_conditions = "Keep refrigerated at 2–8 °C"
+    product.save(update_fields=["storage_conditions"])
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.id),
+        "languageCode": LanguageCodeEnum.FR.name,
+        "input": {"storageConditions": "Conserver au frais entre 2 et 8 °C"},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_TRANSLATE_MUTATION,
+        variables,
+        permissions=[permission_manage_translations],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productTranslate"]
+    assert not data["errors"]
+    product_translation_fr.refresh_from_db()
+    assert product_translation_fr.storage_conditions == (
+        "Conserver au frais entre 2 et 8 °C"
+    )
+    product.refresh_from_db()
+    assert product.storage_conditions == "Keep refrigerated at 2–8 °C"
+
