+import graphene
+import pytest
+
+from .....product.models import Product
+from ....tests.utils import get_graphql_content
+
+STORAGE_CONDITIONS = "Keep refrigerated at 2-8 C. Do not freeze."
+
+CREATE_PRODUCT_STORAGE_CONDITIONS_MUTATION = """
+mutation createProduct($input: ProductCreateInput!) {
+  productCreate(input: $input) {
+    product {
+      id
+      name
+      storageConditions
+    }
+    errors {
+      field
+      code
+    }
+  }
+}
+"""
+
+UPDATE_PRODUCT_STORAGE_CONDITIONS_MUTATION = """
+mutation updateProduct($productId: ID!, $input: ProductInput!) {
+  productUpdate(id: $productId, input: $input) {
+    product {
+      id
+      storageConditions
+    }
+    errors {
+      field
+      code
+    }
+  }
+}
+"""
+
+BULK_CREATE_PRODUCT_STORAGE_CONDITIONS_MUTATION = """
+mutation ProductBulkCreate(
+  $products: [ProductBulkCreateInput!]!,
+  $errorPolicy: ErrorPolicyEnum
+) {
+  productBulkCreate(products: $products, errorPolicy: $errorPolicy) {
+    count
+    results {
+      product {
+        name
+        storageConditions
+      }
+      errors {
+        path
+        code
+      }
+    }
+  }
+}
+"""
+
+QUERY_PRODUCT_STORAGE_CONDITIONS = """
+query product($id: ID!) {
+  product(id: $id) {
+    id
+    storageConditions
+  }
+}
+"""
+
+
+def test_create_product_with_storage_conditions(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    variables = {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "category": graphene.Node.to_global_id("Category", category.pk),
+            "name": "Cheese",
+            "storageConditions": STORAGE_CONDITIONS,
+        }
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CREATE_PRODUCT_STORAGE_CONDITIONS_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == STORAGE_CONDITIONS
+    product = Product.objects.get(name="Cheese")
+    assert product.storage_conditions == STORAGE_CONDITIONS
+
+
+def test_create_product_storage_conditions_with_250_characters(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    value = "a" * 250
+    variables = {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "category": graphene.Node.to_global_id("Category", category.pk),
+            "name": "Cheese",
+            "storageConditions": value,
+        }
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CREATE_PRODUCT_STORAGE_CONDITIONS_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == value
+    assert Product.objects.get(name="Cheese").storage_conditions == value
+
+
+def test_create_product_storage_conditions_over_250_characters(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    variables = {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "category": graphene.Node.to_global_id("Category", category.pk),
+            "name": "Cheese",
+            "storageConditions": "a" * 251,
+        }
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CREATE_PRODUCT_STORAGE_CONDITIONS_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["productCreate"]
+    assert data["product"] is None
+    assert data["errors"]
+    assert {(error["field"], error["code"]) for error in data["errors"]} == {
+        ("storageConditions", "INVALID")
+    }
+    assert not Product.objects.filter(name="Cheese").exists()
+
+
+@pytest.mark.parametrize("value", ["", None, "   ", "<script>alert(1)</script>"])
+def test_create_product_storage_conditions_stored_as_given(
+    value, staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    variables = {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "category": graphene.Node.to_global_id("Category", category.pk),
+            "name": "Cheese",
+            "storageConditions": value,
+        }
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CREATE_PRODUCT_STORAGE_CONDITIONS_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == value
+    assert Product.objects.get(name="Cheese").storage_conditions == value
+
+
+def test_update_product_set_storage_conditions(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    product_id = graphene.Node.to_global_id("Product", product.pk)
+    variables = {
+        "productId": product_id,
+        "input": {"storageConditions": STORAGE_CONDITIONS},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_PRODUCT_STORAGE_CONDITIONS_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["productUpdate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == STORAGE_CONDITIONS
+    product.refresh_from_db()
+    assert product.storage_conditions == STORAGE_CONDITIONS
+
+
+def test_update_product_storage_conditions_keeps_value_when_not_provided(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    product.storage_conditions = STORAGE_CONDITIONS
+    product.save(update_fields=["storage_conditions"])
+    product_id = graphene.Node.to_global_id("Product", product.pk)
+    variables = {
+        "productId": product_id,
+        "input": {"name": "Renamed product"},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_PRODUCT_STORAGE_CONDITIONS_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["productUpdate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == STORAGE_CONDITIONS
+    product.refresh_from_db()
+    assert product.storage_conditions == STORAGE_CONDITIONS
+
+
+def test_update_product_clear_storage_conditions_with_null(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    product.storage_conditions = STORAGE_CONDITIONS
+    product.save(update_fields=["storage_conditions"])
+    product_id = graphene.Node.to_global_id("Product", product.pk)
+    variables = {
+        "productId": product_id,
+        "input": {"storageConditions": None},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_PRODUCT_STORAGE_CONDITIONS_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["productUpdate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] is None
+    product.refresh_from_db()
+    assert product.storage_conditions is None
+
+
+def test_update_product_storage_conditions_over_250_characters(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    product.storage_conditions = STORAGE_CONDITIONS
+    product.save(update_fields=["storage_conditions"])
+    product_id = graphene.Node.to_global_id("Product", product.pk)
+    variables = {
+        "productId": product_id,
+        "input": {"storageConditions": "a" * 251},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        UPDATE_PRODUCT_STORAGE_CONDITIONS_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["productUpdate"]
+    assert data["product"] is None
+    assert data["errors"]
+    assert {(error["field"], error["code"]) for error in data["errors"]} == {
+        ("storageConditions", "INVALID")
+    }
+    product.refresh_from_db()
+    assert product.storage_conditions == STORAGE_CONDITIONS
+
+
+def test_product_bulk_create_with_storage_conditions(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    product_type_id = graphene.Node.to_global_id("ProductType", product_type.pk)
+    category_id = graphene.Node.to_global_id("Category", category.pk)
+    products = [
+        {
+            "productType": product_type_id,
+            "category": category_id,
+            "name": "Valid product",
+            "storageConditions": STORAGE_CONDITIONS,
+        },
+        {
+            "productType": product_type_id,
+            "category": category_id,
+            "name": "Too long product",
+            "storageConditions": "a" * 251,
+        },
+    ]
+
+    # when
+    response = staff_api_client.post_graphql(
+        BULK_CREATE_PRODUCT_STORAGE_CONDITIONS_MUTATION,
+        {"products": products, "errorPolicy": "IGNORE_FAILED"},
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["productBulkCreate"]
+    assert data["count"] == 1
+    valid_result, invalid_result = data["results"]
+    assert not valid_result["errors"]
+    assert valid_result["product"]["storageConditions"] == STORAGE_CONDITIONS
+    assert invalid_result["product"] is None
+    assert len(invalid_result["errors"]) == 1
+    assert invalid_result["errors"][0]["path"] == "storageConditions"
+    assert invalid_result["errors"][0]["code"] == "INVALID"
+
+    assert Product.objects.get(name="Valid product").storage_conditions == (
+        STORAGE_CONDITIONS
+    )
+    assert not Product.objects.filter(name="Too long product").exists()
+
+
+def test_query_product_storage_conditions(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    product.storage_conditions = STORAGE_CONDITIONS
+    product.save(update_fields=["storage_conditions"])
+    product_id = graphene.Node.to_global_id("Product", product.pk)
+
+    # when
+    response = staff_api_client.post_graphql(
+        QUERY_PRODUCT_STORAGE_CONDITIONS,
+        {"id": product_id},
+        permissions=[permission_manage_products],
+        check_no_permissions=False,
+    )
+
+    # then
+    content = get_graphql_content(response)
+    assert content["data"]["product"]["storageConditions"] == STORAGE_CONDITIONS
+
+
+def test_product_bulk_create_storage_conditions_over_250_reports_each_error_once(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    product_type_id = graphene.Node.to_global_id("ProductType", product_type.pk)
+    category_id = graphene.Node.to_global_id("Category", category.pk)
+    products = [
+        {
+            "productType": product_type_id,
+            "category": category_id,
+            "name": "Too long product",
+            "storageConditions": "a" * 251,
+            "weight": -1,
+        },
+    ]
+
+    # when
+    response = staff_api_client.post_graphql(
+        BULK_CREATE_PRODUCT_STORAGE_CONDITIONS_MUTATION,
+        {"products": products, "errorPolicy": "IGNORE_FAILED"},
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["productBulkCreate"]
+    assert data["count"] == 0
+    result = data["results"][0]
+    assert result["product"] is None
+    errors = [(error["path"], error["code"]) for error in result["errors"]]
+    assert sorted(errors) == [
+        ("storageConditions", "INVALID"),
+        ("weight", "INVALID"),
+    ]
+    assert not Product.objects.filter(name="Too long product").exists()
