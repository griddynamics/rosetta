index 0000000..2dfe70d
--- /dev/null
+++ b/saleor/webhook/tests/test_product_storage_conditions_payload.py
@@ -0,0 +1,28 @@
+import json
+
+from ..payloads import generate_product_payload
+
+
+def test_generate_product_payload_contains_storage_conditions(product):
+    # given
+    product.storage_conditions = "Keep refrigerated at 2-8 C."
+    product.save(update_fields=["storage_conditions"])
+
+    # when
+    payload = json.loads(generate_product_payload(product))
+
+    # then
+    assert payload[0]["storage_conditions"] == "Keep refrigerated at 2-8 C."
+
+
+def test_generate_product_payload_storage_conditions_is_null_when_not_set(product):
+    # given
+    product.storage_conditions = None
+    product.save(update_fields=["storage_conditions"])
+
+    # when
+    payload = json.loads(generate_product_payload(product))
+
+    # then
+    assert "storage_conditions" in payload[0]
+    assert payload[0]["storage_conditions"] is None
