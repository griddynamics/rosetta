+    # given
+    id = graphene.Node.to_global_id("Product", product.id)
+    variables = {
+        "id": id,
+        "languageCode": LanguageCodeEnum.PL.name,
+        "input": {"storageConditions": STORAGE_CONDITIONS_PL},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_TRANSLATE_STORAGE_CONDITIONS_MUTATION,
+        variables,
+        permissions=[permission_manage_translations],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["productTranslate"]
+    assert not data["errors"]
+    assert data["product"]["translation"]["storageConditions"] == STORAGE_CONDITIONS_PL
+    translation = ProductTranslation.objects.get(product=product, language_code="pl")
+    assert translation.storage_conditions == STORAGE_CONDITIONS_PL
+
+
+def test_product_translate_storage_conditions_with_250_characters(
