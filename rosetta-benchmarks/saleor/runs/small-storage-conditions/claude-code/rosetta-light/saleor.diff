+from tempfile import NamedTemporaryFile
+
+import graphene
+import petl as etl
+
+from .....graphql.csv.enums import ProductFieldEnum
+from .....product.models import Product
+from .... import FileTypes
+from ....utils import ProductExportFields
+from ....utils.export import export_products_in_batches
+from ....utils.product_headers import get_product_export_fields_and_headers
+from ....utils.products_data import get_products_data
+
+STORAGE_CONDITIONS = "Keep refrigerated at 2-8 C"
+
+
+def test_product_export_fields_map_storage_conditions_column():
+    # given
+    export_info = {"fields": [ProductFieldEnum.STORAGE_CONDITIONS.value]}
+
+    # when
+    export_fields, file_headers = get_product_export_fields_and_headers(export_info)
+
+    # then
+    assert (
+        ProductExportFields.HEADERS_TO_FIELDS_MAPPING["fields"]["storage conditions"]
+        == "storage_conditions"
+    )
+    assert export_fields == ["id", "storage_conditions"]
+    assert file_headers == ["id", "storage conditions"]
+
+
+def test_get_products_data_includes_storage_conditions(product):
+    # given
+    product.storage_conditions = STORAGE_CONDITIONS
+    product.save(update_fields=["storage_conditions"])
+    queryset = Product.objects.filter(pk=product.pk)
+
+    # when
+    products_data = get_products_data(
+        queryset, {"id", "storage_conditions"}, None, None, None
+    )
+
+    # then
+    assert products_data
+    assert all(
+        data["storage_conditions"] == STORAGE_CONDITIONS for data in products_data
+    )
+
+
+def test_export_products_in_batches_writes_storage_conditions_column(product):
+    # given
+    product.storage_conditions = STORAGE_CONDITIONS
+    product.save(update_fields=["storage_conditions"])
+    qs = Product.objects.filter(pk=product.pk).order_by("pk")
+    export_info = {
+        "fields": [ProductFieldEnum.STORAGE_CONDITIONS.value],
+        "warehouses": [],
+        "attributes": [],
+        "channels": [],
+    }
+    export_fields = ["id", "storage_conditions"]
+    expected_headers = ["id", "storage conditions"]
+
+    table = etl.wrap([expected_headers])
+    temp_file = NamedTemporaryFile()
+    etl.tocsv(table, temp_file.name, delimiter=",")
+
+    # when
+    export_products_in_batches(
+        qs,
+        export_info,
+        set(export_fields),
+        export_fields,
+        ",",
+        temp_file,
+        FileTypes.CSV,
+    )
+
+    # then
+    product_id = graphene.Node.to_global_id("Product", product.pk)
+    file_content = temp_file.read().decode().split("\r\n")
+    assert ",".join(expected_headers) in file_content
+    assert f"{product_id},{STORAGE_CONDITIONS}" in file_content
