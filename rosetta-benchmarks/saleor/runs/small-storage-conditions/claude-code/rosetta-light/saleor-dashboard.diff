@@ -0,0 +1,84 @@
+import { type ProductErrorFragment } from "@dashboard/graphql";
+import { RichTextContext, type RichTextContextValues } from "@dashboard/utils/richText/context";
+import Wrapper from "@test/wrapper";
+import { render, type RenderResult, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { createRef } from "react";
+
+import { ProductDetailsForm } from "./ProductDetailsForm";
+
+// The rich text editor is not under test. A context stub that is not ready for mount
+// renders the editor loading placeholder instead of the editor.
+const richTextStub = {
+  editorRef: createRef(),
+  defaultValue: { blocks: [] },
+  isReadyForMount: false,
+  handleChange: jest.fn(),
+} as unknown as RichTextContextValues;
+
+const defaultData = {
+  name: "Olive oil",
+  description: { blocks: [] },
+  rating: null,
+  storageConditions: "Keep cool",
+};
+
+const renderForm = (props: Partial<Parameters<typeof ProductDetailsForm>[0]> = {}): RenderResult =>
+  render(
+    <RichTextContext.Provider value={richTextStub}>
+      <ProductDetailsForm data={defaultData} errors={[]} onChange={jest.fn()} {...props} />
+    </RichTextContext.Provider>,
+    { wrapper: Wrapper },
+  );
+
+describe("ProductDetailsForm storage conditions", () => {
+  it("renders the storage conditions input with the stored value and a 250 character limit", () => {
+    // Arrange & Act
+    renderForm();
+
+    // Assert
+    const input = screen.getByLabelText("Storage conditions");
+
+    expect(input).toHaveValue("Keep cool");
+    expect(input).toHaveAttribute("maxlength", "250");
+    expect(input).toHaveAttribute("name", "storageConditions");
+  });
+
+  it("reports changes through onChange under the storageConditions name", async () => {
+    // Arrange
+    const onChange = jest.fn();
+    const user = userEvent.setup();
+
+    renderForm({ data: { ...defaultData, storageConditions: "" }, onChange });
+
+    // Act
+    await user.type(screen.getByLabelText("Storage conditions"), "A");
+
+    // Assert
+    expect(onChange).toHaveBeenCalledWith(
+      expect.objectContaining({
+        target: expect.objectContaining({ name: "storageConditions" }),
+      }),
+    );
+  });
+
+  it("shows the API error for storageConditions as helper text", () => {
+    // Arrange
+    const errors = [
+      {
+        __typename: "ProductError",
+        code: "INVALID",
+        field: "storageConditions",
+        message: "Ensure this value has at most 250 characters.",
+        attributes: null,
+        values: null,
+      },
+    ] as unknown as ProductErrorFragment[];
+
+    // Act
+    renderForm({ errors });
+
+    // Assert
+    expect(screen.getByText("Invalid value")).toBeInTheDocument();
+  });
+});
