+import { type IntlShape } from "react-intl";
+
+import { createProductStorageConditionsField } from "./translationSectionBuilders";
+import { TranslationFieldType, TranslationInputFieldName } from "./types";
+
+const mockIntl = {
+  formatMessage: ({ defaultMessage }: { defaultMessage?: string }) => defaultMessage ?? "",
+} as unknown as IntlShape;
+
+describe("createProductStorageConditionsField", () => {
+  it("builds a short text row keyed by storageConditions with the source and translated values", () => {
+    // Arrange & Act
+    const field = createProductStorageConditionsField(mockIntl, {
+      storageConditions: "Keep cool",
+      translationStorageConditions: "Chłodzić",
+    });
+
+    // Assert
+    expect(field).toEqual(
+      expect.objectContaining({
+        name: TranslationInputFieldName.storageConditions,
+        displayName: "Storage conditions",
+        type: TranslationFieldType.SHORT,
+        value: "Keep cool",
+        translation: "Chłodzić",
+      }),
+    );
+  });
+
+  it("uses empty string for the source and null for a missing translation", () => {
+    // Arrange & Act
+    const field = createProductStorageConditionsField(mockIntl, {
+      storageConditions: null,
+      translationStorageConditions: undefined,
+    });
+
+    // Assert
+    expect(field.value).toBe("");
+    expect(field.translation).toBeNull();
+  });
+});
