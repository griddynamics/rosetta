+import {
+  LanguageCodeEnum,
+  type LanguageFragment,
+  type ProductTranslationFragment,
+} from "@dashboard/graphql";
+import Wrapper from "@test/wrapper";
+import { render, type RenderResult, screen, within } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+
+import { TranslationsProductsPage } from "./TranslationsProductsPage";
+
+// EditorJS needs layout APIs jsdom does not provide. The rich text fields are not under
+// test here, so the editor wrappers render nothing.
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditor", () => ({
+  __esModule: true,
+  default: (): null => null,
+}));
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditorContent", () => ({
+  __esModule: true,
+  default: (): null => null,
+}));
+
+// Macaw infinite-scroll hooks used by the translation pickers need IntersectionObserver.
+global.IntersectionObserver = jest.fn().mockImplementation(() => ({
+  observe: jest.fn(),
+  unobserve: jest.fn(),
+  disconnect: jest.fn(),
+}));
+
+const productTranslation = {
+  __typename: "ProductTranslatableContent",
+  product: {
+    __typename: "Product",
+    id: "product-1",
+    name: "Olive oil",
+    description: null,
+    slug: "olive-oil",
+    seoDescription: null,
+    seoTitle: null,
+    storageConditions: "Keep cool and dry",
+  },
+  translation: {
+    __typename: "ProductTranslation",
+    id: "translation-1",
+    name: "Oliwa",
+    description: null,
+    slug: null,
+    seoDescription: null,
+    seoTitle: null,
+    storageConditions: "Chronić przed słońcem",
+    language: { __typename: "LanguageDisplay", code: "PL", language: "Polish" },
+  },
+  attributeValues: [],
+} as unknown as ProductTranslationFragment;
+
+const languages = [
+  { __typename: "LanguageDisplay", code: LanguageCodeEnum.EN, language: "English" },
+  { __typename: "LanguageDisplay", code: LanguageCodeEnum.PL, language: "Polish" },
+] as unknown as LanguageFragment[];
+
+const renderPage = (): RenderResult =>
+  render(
+    <TranslationsProductsPage
+      translationId="product-1"
+      productId="product-1"
+      activeField={undefined}
+      bulk={false}
+      disabled={false}
+      languageCode="PL"
+      languages={languages}
+      data={productTranslation}
+      saveButtonState="default"
+      fieldErrors={{}}
+      onBulkChange={jest.fn()}
+      onEdit={jest.fn()}
+      onDiscard={jest.fn()}
+      onSubmit={jest.fn()}
+      onAttributeValueSubmit={jest.fn()}
+      onClearFieldError={jest.fn()}
+      onClearFieldErrors={jest.fn()}
+    />,
+    {
+      wrapper: ({ children }) => (
+        <Wrapper>
+          <MemoryRouter>{children}</MemoryRouter>
+        </Wrapper>
+      ),
+    },
+  );
+
+describe("TranslationsProductsPage storage conditions row", () => {
+  it("renders a storage conditions row with the source and translated value", () => {
+    // Arrange & Act
+    renderPage();
+
+    // Assert
+    const general = screen.getByTestId("translation-section-general");
+
+    expect(within(general).getByText("Storage conditions")).toBeInTheDocument();
+    expect(within(general).getByText("Keep cool and dry")).toBeInTheDocument();
+    expect(within(general).getByText("Chronić przed słońcem")).toBeInTheDocument();
+  });
+});
