@@ -0,0 +1,60 @@
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+
+import type { ProductView } from "@/lib/storefront/contract/product";
+import { PdpPresetLayout } from "@/templates/pdp/product-layout";
+import { PDP_LAYOUT_CLASSES } from "@/ui/components/pdp/gallery-layout";
+
+function product(storageConditions: string | null): ProductView {
+	return {
+		id: "p1",
+		slug: "tee",
+		name: "Tee",
+		category: null,
+		descriptionHtml: ["<p>Soft</p>"],
+		attributes: [],
+		careInstructions: null,
+		images: [],
+		priceRange: null,
+		isAvailable: true,
+		isBestseller: false,
+		variantCount: 1,
+		seoTitle: null,
+		seoDescription: null,
+		extensions: { storageConditions },
+	};
+}
+
+function slot(id: string) {
+	return createElement("div", { id });
+}
+
+function renderLayout(gallery: "standard" | "immersive", storageConditions: string | null): string {
+	return renderToStaticMarkup(
+		createElement(PdpPresetLayout, {
+			product: product(storageConditions),
+			layout: PDP_LAYOUT_CLASSES[gallery],
+			slots: {
+				gallery: slot("pdp-slot-gallery"),
+				buyBox: slot("pdp-slot-buybox"),
+				breadcrumbs: slot("pdp-slot-breadcrumbs"),
+				attributes: slot("pdp-slot-attributes"),
+			},
+		}),
+	);
+}
+
+describe("PdpPresetLayout storage conditions", () => {
+	it.each(["standard", "immersive"] as const)(
+		"leaves storage conditions to the attributes slot (%s preset)",
+		(gallery) => {
+			const html = renderLayout(gallery, "Keep dry, below 25 °C");
+
+			// The layout exposes the attributes slot and does not render the value itself,
+			// so the block lands inside the description area rendered by the slot.
+			expect(html).toContain('id="pdp-slot-attributes"');
+			expect(html).not.toContain("Keep dry, below 25 °C");
+		},
+	);
+});
