+import { describe, expect, it } from "vitest";
+
+import { mapProductExtensions } from "@/config/storefront-view";
+import type { ProductShell } from "@/lib/catalog/get-product-data";
+import { readStorageConditions } from "@/lib/product-storage-conditions";
+import { withTranslatedProductFields } from "@/lib/saleor-translations";
+
+function shell(storageConditions: string | null | undefined): ProductShell {
+	return { id: "p1", slug: "tee", name: "Tee", storageConditions } as unknown as ProductShell;
+}
+
+describe("mapProductExtensions storageConditions", () => {
+	it("maps a stored value", () => {
+		expect(mapProductExtensions(shell("Keep dry, below 25 °C"))).toEqual({
+			storageConditions: "Keep dry, below 25 °C",
+		});
+	});
+
+	it("maps null, empty, and whitespace-only values to null", () => {
+		expect(mapProductExtensions(shell(null))).toEqual({ storageConditions: null });
+		expect(mapProductExtensions(shell(undefined))).toEqual({ storageConditions: null });
+		expect(mapProductExtensions(shell(""))).toEqual({ storageConditions: null });
+		expect(mapProductExtensions(shell(" \n\t "))).toEqual({ storageConditions: null });
+	});
+
+	it("trims surrounding whitespace from the stored value", () => {
+		expect(mapProductExtensions(shell("  Keep dry  "))).toEqual({ storageConditions: "Keep dry" });
+	});
+
+	it("uses the translated value when the product is translated", () => {
+		const translated = withTranslatedProductFields({
+			name: "Tee",
+			storageConditions: "Keep dry",
+			translation: { storageConditions: "Trocken lagern" },
+		});
+
+		expect(mapProductExtensions(translated as unknown as ProductShell)).toEqual({
+			storageConditions: "Trocken lagern",
+		});
+	});
+
+	it("falls back to the primary value when the translation is blank", () => {
+		const translated = withTranslatedProductFields({
+			name: "Tee",
+			storageConditions: "Keep dry",
+			translation: { storageConditions: "  " },
+		});
+
+		expect(mapProductExtensions(translated as unknown as ProductShell)).toEqual({
+			storageConditions: "Keep dry",
+		});
+	});
+});
+
+describe("readStorageConditions", () => {
+	it("reads the value the mapper placed on extensions", () => {
+		expect(readStorageConditions({ storageConditions: "Keep dry" })).toBe("Keep dry");
+	});
+
+	it("returns null when the extension is missing, blank, or not a string", () => {
+		expect(readStorageConditions({})).toBeNull();
+		expect(readStorageConditions({ storageConditions: "   " })).toBeNull();
+		expect(readStorageConditions({ storageConditions: 42 })).toBeNull();
+	});
+});
