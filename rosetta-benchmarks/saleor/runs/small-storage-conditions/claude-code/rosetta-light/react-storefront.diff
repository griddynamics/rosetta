+"use client";
+
+import { useTranslations } from "next-intl";
+
+import { normalizeStorageConditions } from "@/lib/product-storage-conditions";
+
+interface StorageConditionsProps {
+	/** Plain text from the product. Rendered as a text node, never as HTML. */
+	text: string | null | undefined;
+}
+
+/**
+ * Labelled storage-conditions block for the PDP.
+ * Renders nothing when the value is null, empty, or whitespace-only.
+ */
+export function StorageConditions({ text }: StorageConditionsProps) {
+	const t = useTranslations("pdp.attributes");
+	const value = normalizeStorageConditions(text);
+
+	if (value === null) return null;
+
+	return (
+		<section className="mt-6 border-t border-border pt-6">
+			<h3 className="text-sm font-medium">{t("storageConditions")}</h3>
+			<p className="mt-2 text-sm leading-relaxed text-muted-foreground">{value}</p>
+		</section>
+	);
+}
