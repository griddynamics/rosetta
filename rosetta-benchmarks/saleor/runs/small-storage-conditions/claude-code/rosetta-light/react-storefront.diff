+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it, vi } from "vitest";
+
+import type { PolicyLabelValues } from "@/lib/content/policy-format";
+import { ProductAttributes } from "@/ui/components/pdp/product-attributes";
+
+vi.mock("next-intl", async (importOriginal) => ({
+	...(await importOriginal<typeof import("next-intl")>()),
+	useTranslations: () => (key: string) => (key === "storageConditions" ? "Storage conditions" : key),
+}));
+
+const policyLabels = {} as PolicyLabelValues;
+
+function render(
+	storageConditions: string | null | undefined,
+	descriptionHtml: string[] | null = ["<p>Soft cotton</p>"],
+): string {
+	return renderToStaticMarkup(
+		createElement(ProductAttributes, {
+			descriptionHtml,
+			attributes: [{ name: "Material", value: "Cotton" }],
+			careInstructions: null,
+			storageConditions,
+			policyLabels,
+		}),
+	);
+}
+
+describe("ProductAttributes storage conditions", () => {
+	it("renders the block inside the description, after the description and before product details", () => {
+		const html = render("Keep dry, below 25 °C");
+
+		const descriptionAt = html.indexOf("Soft cotton");
+		const blockAt = html.indexOf("Keep dry, below 25 °C");
+		const detailsAt = html.indexOf("productDetails");
+		expect(descriptionAt).toBeGreaterThan(-1);
+		expect(blockAt).toBeGreaterThan(descriptionAt);
+		expect(detailsAt).toBeGreaterThan(blockAt);
+		expect(html).toContain("Storage conditions");
+	});
+
+	it("still renders the block when the product has no description", () => {
+		const html = render("Keep dry", null);
+
+		expect(html).toContain("Storage conditions");
+		expect(html.indexOf("Keep dry")).toBeLessThan(html.indexOf("productDetails"));
+	});
+
+	it("escapes markup in the stored value", () => {
+		const html = render('<script>alert("x")</script>');
+
+		expect(html).toContain("&lt;script&gt;alert(&quot;x&quot;)&lt;/script&gt;");
+		expect(html).not.toContain("<script>alert");
+	});
+
+	it("omits the block when the value is null, undefined, empty, or whitespace-only", () => {
+		for (const value of [null, undefined, "", "   "]) {
+			const html = render(value);
+
+			expect(html).not.toContain("Storage conditions");
+			expect(html).toContain("Soft cotton");
+		}
+	});
+});
