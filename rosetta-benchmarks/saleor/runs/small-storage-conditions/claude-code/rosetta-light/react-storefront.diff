+++ b/src/lib/product-storage-conditions.ts
@@ -0,0 +1,15 @@
+/**
+ * Product storage conditions are plain text (≤250 chars in Saleor).
+ * Null, empty, whitespace-only, and non-string values all mean "no value",
+ * so the PDP block stays hidden.
+ */
+export function normalizeStorageConditions(value: unknown): string | null {
+	if (typeof value !== "string") return null;
+	const trimmed = value.trim();
+	return trimmed.length > 0 ? trimmed : null;
+}
+
+/** Reads the value that `mapProductExtensions` placed on `ProductView.extensions`. */
+export function readStorageConditions(extensions: Record<string, unknown>): string | null {
+	return normalizeStorageConditions(extensions.storageConditions);
+}
