+		const html = render("Keep dry, below 25 °C");
+
+		expect(html).toContain("<h3");
+		expect(html).toContain("Storage conditions");
+		expect(html).toContain("Keep dry, below 25 °C");
+	});
+
+	it("escapes markup so a script tag is shown as text", () => {
+		const html = render('<script>alert("x")</script>');
+
+		expect(html).toContain("&lt;script&gt;alert(&quot;x&quot;)&lt;/script&gt;");
+		expect(html).not.toContain("<script>");
+	});
+
+	it("renders nothing when the value is null, empty, or whitespace-only", () => {
+		expect(render(null)).toBe("");
+		expect(render(undefined)).toBe("");
+		expect(render("")).toBe("");
+		expect(render("   \n\t ")).toBe("");
+	});
+});
