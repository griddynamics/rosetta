+  return {
+    displayName: intl.formatMessage({
+      id: "PBRUO8",
+      defaultMessage: "Storage conditions",
+      description: "product storage conditions translation field",
+    }),
+    hint: intl.formatMessage({
+      id: "rdrfgM",
+      defaultMessage:
+        "Shown to customers in the product description. Leave empty to use the original text.",
+      description: "hint beside the product storage conditions translation field",
+    }),
+    name: TranslationInputFieldName.storageConditions,
+    translation: data.translationStorageConditions ?? null,
+    type: TranslationFieldType.SHORT,
+    value: data.storageConditions ?? "",
+  };
+}
