+import { ProductErrorCode } from "@dashboard/graphql";
+import { fireEvent, render, screen } from "@testing-library/react";
+import { type ReactNode } from "react";
+import { IntlProvider } from "react-intl";
+
+import { ProductDetailsForm } from "./ProductDetailsForm";
+
+jest.mock("@dashboard/utils/richText/context", () => ({
+  useRichTextContext: () => ({
+    editorRef: { current: null },
+    defaultValue: undefined,
+    isReadyForMount: false,
+    handleChange: jest.fn(),
+  }),
+}));
+
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditor", () => ({
+  __esModule: true,
+  default: () => <div />,
+}));
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditorClamp", () => ({
+  RichTextEditorClamp: ({ children }: { children: ReactNode }) => <div>{children}</div>,
+}));
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditorLoading", () => ({
+  RichTextEditorLoading: () => <div />,
+}));
+
+const data = {
+  name: "Milk",
+  description: { blocks: [] },
+  rating: null,
+  storageConditions: "Keep refrigerated at 2–8 °C",
+};
+
+const renderForm = (props: Partial<Parameters<typeof ProductDetailsForm>[0]> = {}) =>
+  render(<ProductDetailsForm data={data} errors={[]} onChange={jest.fn()} {...props} />, {
+    wrapper: ({ children }: { children: ReactNode }) => (
+      <IntlProvider locale="en">{children}</IntlProvider>
+    ),
+  });
+
+describe("ProductDetailsForm storage conditions", () => {
+  it("shows the current storage conditions", () => {
+    // Arrange & Act
+    renderForm();
+
+    // Assert
+    expect(screen.getByLabelText("Storage conditions")).toHaveValue("Keep refrigerated at 2–8 °C");
+  });
+
+  it("passes changes to the form handler", () => {
+    // Arrange
+    const changes: Array<{ name: string; value: string }> = [];
+    const onChange = jest.fn(event => {
+      // Controlled input reverts the DOM value after the event, so read it now.
+      changes.push({ name: event.target.name, value: event.target.value });
+    });
+
+    renderForm({ onChange });
+
+    // Act
+    fireEvent.change(screen.getByLabelText("Storage conditions"), {
+      target: { value: "Store at room temperature" },
+    });
+
+    // Assert
+    expect(onChange).toHaveBeenCalledTimes(1);
+    expect(changes).toEqual([{ name: "storageConditions", value: "Store at room temperature" }]);
+  });
+
+  it("limits input to 250 characters", () => {
+    // Arrange & Act
+    renderForm();
+
+    // Assert
+    expect(screen.getByLabelText("Storage conditions")).toHaveAttribute("maxlength", "250");
+  });
+
+  it("is disabled when the form is disabled", () => {
+    // Arrange & Act
+    renderForm({ disabled: true });
+
+    // Assert
+    expect(screen.getByLabelText("Storage conditions")).toBeDisabled();
+  });
+
+  it("shows the server error for the field", () => {
+    // Arrange & Act
+    renderForm({
+      errors: [
+        {
+          __typename: "ProductError",
+          code: ProductErrorCode.INVALID,
+          field: "storageConditions",
+          message: "too long",
+        },
+      ],
+    });
+
+    // Assert
+    expect(screen.getByText("Invalid value")).toBeInTheDocument();
+  });
+});
