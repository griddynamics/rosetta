+import { TranslationFieldType, TranslationInputFieldName } from "@dashboard/translations/types";
+import { type IntlShape } from "react-intl";
+
+import { createStorageConditionsField } from "./translationSectionBuilders";
+
+const intl = {
+  formatMessage: ({ defaultMessage }: { defaultMessage?: string }) => defaultMessage ?? "",
+} as IntlShape;
+
+describe("createStorageConditionsField", () => {
+  it("builds a short text field with the original value and the translation", () => {
+    // Arrange & Act
+    const field = createStorageConditionsField(intl, {
+      storageConditions: "Keep refrigerated at 2–8 °C",
+      translationStorageConditions: "Przechowywać w lodówce w temp. 2–8 °C",
+    });
+
+    // Assert
+    expect(field).toMatchObject({
+      displayName: "Storage conditions",
+      name: TranslationInputFieldName.storageConditions,
+      type: TranslationFieldType.SHORT,
+      value: "Keep refrigerated at 2–8 °C",
+      translation: "Przechowywać w lodówce w temp. 2–8 °C",
+    });
+  });
+
+  it("falls back to empty values when the product has no storage conditions", () => {
+    // Arrange & Act
+    const field = createStorageConditionsField(intl, {
+      storageConditions: null,
+      translationStorageConditions: undefined,
+    });
+
+    // Assert
+    expect(field.value).toBe("");
+    expect(field.translation).toBeNull();
+  });
+});
