@@ -0,0 +1,62 @@
+import { type ComponentProps, createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { NextIntlClientProvider } from "next-intl";
+import { describe, expect, it } from "vitest";
+
+import messages from "../../../../messages/en.json";
+import { ProductAttributes } from "./product-attributes";
+
+const policyLabels = { freeShippingThreshold: "$50", returnsWindowDays: 30 };
+
+function render(props: Partial<Parameters<typeof ProductAttributes>[0]>): string {
+	return renderToStaticMarkup(
+		createElement(
+			NextIntlClientProvider,
+			{ locale: "en", messages } as ComponentProps<typeof NextIntlClientProvider>,
+			createElement(ProductAttributes, { policyLabels, ...props }),
+		),
+	);
+}
+
+describe("ProductAttributes storage conditions", () => {
+	it("shows labelled storage conditions inside the description section", () => {
+		const html = render({
+			descriptionHtml: ["<p>Fresh milk</p>"],
+			storageConditions: "Keep refrigerated at 2–8 °C",
+		});
+
+		expect(html).toContain("Fresh milk");
+		expect(html).toContain("Storage conditions:");
+		expect(html).toContain("Keep refrigerated at 2–8 °C");
+		expect(html.indexOf("Fresh milk")).toBeLessThan(html.indexOf("Storage conditions:"));
+	});
+
+	it("shows nothing when the product has no storage conditions", () => {
+		const html = render({ descriptionHtml: ["<p>Fresh milk</p>"], storageConditions: null });
+
+		expect(html).not.toContain("Storage conditions");
+		expect(html).not.toContain("storage-conditions");
+	});
+
+	it("shows no description section when both description and storage conditions are empty", () => {
+		const html = render({ descriptionHtml: null, storageConditions: null });
+
+		expect(html).not.toContain(">Description<");
+		expect(html).not.toContain("Storage conditions");
+	});
+
+	it("still shows the description section when only storage conditions are set", () => {
+		const html = render({ descriptionHtml: null, storageConditions: "Store in a cool, dry place" });
+
+		expect(html).toContain(">Description<");
+		expect(html).toContain("Storage conditions:");
+		expect(html).toContain("Store in a cool, dry place");
+	});
+
+	it("renders storage conditions as plain text, not markup", () => {
+		const html = render({ storageConditions: '<b>5 & 8</b> "cold"' });
+
+		expect(html).toContain("&lt;b&gt;5 &amp; 8&lt;/b&gt;");
+		expect(html).not.toContain("<b>5");
+	});
+});
