diff --git a/src/config/storefront-view.test.ts b/src/config/storefront-view.test.ts
new file mode 100644
index 0000000..4a5ee97
--- /dev/null
+++ b/src/config/storefront-view.test.ts
@@ -0,0 +1,66 @@
+import { describe, expect, it } from "vitest";
+
+import type { ProductShell } from "@/lib/catalog/get-product-data";
+import { getStorageConditions, mapProductExtensions } from "./storefront-view";
+
+const shell = (storageConditions: string | null | undefined, translated?: string | null): ProductShell =>
+	({
+		storageConditions,
+		translation: translated === undefined ? null : { storageConditions: translated },
+	}) as unknown as ProductShell;
+
+describe("mapProductExtensions", () => {
+	it("maps storage conditions from the product shell", () => {
+		expect(mapProductExtensions(shell("Keep refrigerated at 2–8 °C"))).toEqual({
+			storageConditions: "Keep refrigerated at 2–8 °C",
+		});
+	});
+
+	it.each([[""], ["   "], [null], [undefined]])("maps %j to null", (value) => {
+		expect(mapProductExtensions(shell(value))).toEqual({ storageConditions: null });
+	});
+
+	it("trims surrounding whitespace", () => {
+		expect(mapProductExtensions(shell("  Store dry  "))).toEqual({ storageConditions: "Store dry" });
+	});
+});
+
+describe("mapProductExtensions storage conditions translation", () => {
+	it("prefers the translation over the base value", () => {
+		expect(mapProductExtensions(shell("Keep cold", "Przechowywać w chłodzie"))).toEqual({
+			storageConditions: "Przechowywać w chłodzie",
+		});
+	});
+
+	it.each([[null], [""], ["   "], [undefined]])(
+		"falls back to the base value when the translation is %j",
+		(translated) => {
+			expect(mapProductExtensions(shell("Keep cold", translated))).toEqual({
+				storageConditions: "Keep cold",
+			});
+		},
+	);
+
+	it("uses the translation even when the base value is empty", () => {
+		expect(mapProductExtensions(shell("", "Przechowywać w chłodzie"))).toEqual({
+			storageConditions: "Przechowywać w chłodzie",
+		});
+	});
+
+	it("is null when neither the base value nor the translation is set", () => {
+		expect(mapProductExtensions(shell(null, null))).toEqual({ storageConditions: null });
+	});
+});
+
+describe("getStorageConditions", () => {
+	it("reads the mapped value", () => {
+		expect(getStorageConditions({ storageConditions: "Store dry" })).toBe("Store dry");
+	});
+
+	it.each([[{}], [{ storageConditions: null }], [{ storageConditions: "" }], [{ storageConditions: 5 }]])(
+		"returns null for %j",
+		(extensions) => {
+			expect(getStorageConditions(extensions)).toBeNull();
+		},
+	);
+});
diff --git a/src/config/storefront-view.ts b/src/config/storefront-view.ts
index 924a8d2..6b9de41 100644
--- a/src/config/storefront-view.ts
+++ b/src/config/storefront-view.ts
@@ -9,6 +9,17 @@ import type { ProductShell } from "@/lib/catalog/get-product-data";
  * run `pnpm generate`, then map the new field here. Do not edit
  * `src/lib/storefront/mappers/product.ts` or the product route.
  */
-export function mapProductExtensions(_product: ProductShell): Record<string, unknown> {
-	return {};
+export function mapProductExtensions(product: ProductShell): Record<string, unknown> {
+	return {
+		// An empty or missing translation falls back to the base value.
+		storageConditions:
+			product.translation?.storageConditions?.trim() || product.storageConditions?.trim() || null,
+	};
+}
+
+/** Storage conditions from `ProductView.extensions`, or null when the product has none. */
+export function getStorageConditions(extensions: Record<string, unknown>): string | null {
+	const { storageConditions } = extensions;
+
+	return typeof storageConditions === "string" && storageConditions ? storageConditions : null;
 }
