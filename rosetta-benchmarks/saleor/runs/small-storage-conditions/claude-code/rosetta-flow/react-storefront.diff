@@ -0,0 +1,64 @@
+import { describe, expect, it } from "vitest";
+
+import type { ProductShell } from "@/lib/catalog/get-product-data";
+import { mapProductExtensions } from "./storefront-view";
+
+type Input = { base?: string | null; translated?: string | null | "absent" };
+
+function shell({ base, translated }: Input): ProductShell {
+	return {
+		storageConditions: base,
+		translation: translated === "absent" ? null : { storageConditions: translated },
+	} as unknown as ProductShell;
+}
+
+describe("mapProductExtensions storageConditions", () => {
+	// TF-01
+	it("maps the base value, trimmed", () => {
+		expect(
+			mapProductExtensions(shell({ base: "  Keep refrigerated at 2–8 °C \n", translated: "absent" })),
+		).toEqual({
+			storageConditions: "Keep refrigerated at 2–8 °C",
+		});
+	});
+
+	// TF-02
+	it.each([
+		["null", null],
+		["empty", ""],
+		["whitespace", "   \n\t"],
+		["undefined", undefined],
+	])("returns null when base is %s and no translation", (_n, base) => {
+		expect(mapProductExtensions(shell({ base, translated: "absent" }))).toEqual({ storageConditions: null });
+	});
+
+	it("returns null when both base and translation are blank", () => {
+		expect(mapProductExtensions(shell({ base: " ", translated: "" }))).toEqual({ storageConditions: null });
+		expect(mapProductExtensions(shell({ base: null, translated: null }))).toEqual({
+			storageConditions: null,
+		});
+	});
+
+	// TF-03
+	it("prefers the translated value over base, trimmed", () => {
+		expect(mapProductExtensions(shell({ base: "Cool place", translated: "  Kühl lagern " }))).toEqual({
+			storageConditions: "Kühl lagern",
+		});
+	});
+
+	it.each([
+		["null", null],
+		["empty", ""],
+		["whitespace-only", "  \n "],
+	])("falls back to base when translation is %s", (_n, translated) => {
+		expect(mapProductExtensions(shell({ base: " Cool place ", translated }))).toEqual({
+			storageConditions: "Cool place",
+		});
+	});
+
+	it("uses the translation when base is empty", () => {
+		expect(mapProductExtensions(shell({ base: null, translated: "Kühl" }))).toEqual({
+			storageConditions: "Kühl",
+		});
+	});
+});
diff --git a/src/config/storefront-view.ts b/src/config/storefront-view.ts
