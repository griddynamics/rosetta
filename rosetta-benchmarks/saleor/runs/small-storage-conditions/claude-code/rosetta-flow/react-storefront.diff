@@ -0,0 +1,35 @@
+import { readdirSync, readFileSync } from "node:fs";
+import path from "node:path";
+import { describe, expect, it } from "vitest";
+
+type Messages = { pdp?: { attributes?: { storageConditions?: unknown } } };
+
+const dir = path.resolve(__dirname, "../../../messages");
+const load = (file: string) => JSON.parse(readFileSync(path.join(dir, file), "utf8")) as Messages;
+const files = readdirSync(dir)
+	.filter((f) => f.endsWith(".json"))
+	.sort();
+
+describe("messages: pdp.attributes.storageConditions", () => {
+	it("covers the 8 locales", () => {
+		expect(files).toEqual(["de", "en", "fi", "fr", "ja", "ko", "nb", "pl"].map((l) => `${l}.json`));
+	});
+
+	it.each(files)("%s has a non-empty string", (file) => {
+		const json = load(file);
+		const value = json?.pdp?.attributes?.storageConditions;
+		expect(typeof value).toBe("string");
+		expect((value as string).trim().length).toBeGreaterThan(0);
+	});
+
+	it("en label is 'Storage conditions'", () => {
+		const json = load("en.json");
+		expect(json.pdp?.attributes?.storageConditions).toBe("Storage conditions");
+	});
+
+	it.each(files.filter((f) => f !== "en.json"))("%s differs from the en value (not untranslated)", (file) => {
+		expect(load(file).pdp?.attributes?.storageConditions).not.toBe(
+			load("en.json").pdp?.attributes?.storageConditions,
+		);
+	});
+});
