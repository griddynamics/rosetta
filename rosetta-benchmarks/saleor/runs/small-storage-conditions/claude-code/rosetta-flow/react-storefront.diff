+++ b/src/config/storefront-view.test.ts
@@ -0,0 +1,75 @@
+import { describe, expect, it } from "vitest";
+
+import type { ProductShell } from "@/lib/catalog/get-product-data";
+import { getStorageConditions, mapProductExtensions } from "./storefront-view";
+
+function shell(storageConditions: string | null, translation: string | null | undefined): ProductShell {
+	return {
+		storageConditions,
+		translation: translation === undefined ? null : { storageConditions: translation },
+	} as unknown as ProductShell;
+}
+
+describe("mapProductExtensions storageConditions", () => {
+	it("returns the base value when there is no translation", () => {
+		expect(mapProductExtensions(shell("Keep dry", undefined))).toEqual({ storageConditions: "Keep dry" });
+	});
+
+	it("prefers a non-blank translation over the base value", () => {
+		expect(mapProductExtensions(shell("Keep dry", "Trocken lagern"))).toEqual({
+			storageConditions: "Trocken lagern",
+		});
+	});
+
+	it.each([null, "", "   "])("falls back to the base value for blank translation %j", (translation) => {
+		expect(mapProductExtensions(shell("Keep dry", translation))).toEqual({ storageConditions: "Keep dry" });
+	});
+
+	it.each([null, "", "  \n\t "])("returns null for blank base %j without translation", (base) => {
+		expect(mapProductExtensions(shell(base, null))).toEqual({ storageConditions: null });
+	});
+
+	it.each([null, "", "   "])("uses the translation when the base is blank %j", (base) => {
+		expect(mapProductExtensions(shell(base, "Trocken"))).toEqual({ storageConditions: "Trocken" });
+	});
+
+	it("returns null when base and translation are both blank", () => {
+		expect(mapProductExtensions(shell("  ", "  "))).toEqual({ storageConditions: null });
+	});
+
+	it("trims surrounding whitespace from base and translation", () => {
+		expect(mapProductExtensions(shell("  Keep dry  ", null))).toEqual({ storageConditions: "Keep dry" });
+		expect(mapProductExtensions(shell("Keep dry", "  Trocken  "))).toEqual({ storageConditions: "Trocken" });
+	});
+
+	it("preserves unicode text", () => {
+		expect(mapProductExtensions(shell("保存方法: 冷蔵 2–8 °C", null))).toEqual({
+			storageConditions: "保存方法: 冷蔵 2–8 °C",
+		});
+	});
+});
+
+describe("getStorageConditions", () => {
+	it("reads a non-empty string", () => {
+		expect(getStorageConditions({ storageConditions: "Keep dry" })).toBe("Keep dry");
+	});
+
+	it.each([[null], [""], [undefined], [42], [{}]])("returns null for %j", (value) => {
+		expect(getStorageConditions({ storageConditions: value })).toBeNull();
+	});
+
+	// Documents current behavior: the reader only checks length, so a whitespace-only string passes.
+	// SF-03 holds because mapProductExtensions trims before the reader sees the value.
+	it("passes a whitespace-only string through (the mapper is responsible for trimming)", () => {
+		expect(getStorageConditions({ storageConditions: "   " })).toBe("   ");
+	});
+
+	it("returns null when the key is absent", () => {
+		expect(getStorageConditions({})).toBeNull();
+	});
+
+	it("round-trips the mapper output", () => {
+		expect(getStorageConditions(mapProductExtensions(shell("  x ", null)))).toBe("x");
+		expect(getStorageConditions(mapProductExtensions(shell(null, null)))).toBeNull();
+	});
+});
