--- a/src/config/storefront-view.ts
+++ b/src/config/storefront-view.ts
@@ -9,6 +9,11 @@ import type { ProductShell } from "@/lib/catalog/get-product-data";
  * run `pnpm generate`, then map the new field here. Do not edit
  * `src/lib/storefront/mappers/product.ts` or the product route.
  */
-export function mapProductExtensions(_product: ProductShell): Record<string, unknown> {
-	return {};
+export function mapProductExtensions(product: ProductShell): { storageConditions: string | null } {
+	const candidates = [product.translation?.storageConditions, product.storageConditions];
+	for (const candidate of candidates) {
+		const trimmed = candidate?.trim();
+		if (trimmed) return { storageConditions: trimmed };
+	}
+	return { storageConditions: null };
 }
