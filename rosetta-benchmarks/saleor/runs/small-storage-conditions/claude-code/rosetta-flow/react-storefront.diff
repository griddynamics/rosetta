diff --git a/src/ui/components/pdp/product-attributes.test.ts b/src/ui/components/pdp/product-attributes.test.ts
new file mode 100644
index 0000000..77002e1
--- /dev/null
+++ b/src/ui/components/pdp/product-attributes.test.ts
@@ -0,0 +1,116 @@
+import { readFileSync, readdirSync } from "node:fs";
+import { join } from "node:path";
+import { createElement, type ComponentProps, type ComponentType } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { NextIntlClientProvider } from "next-intl";
+import { describe, expect, it } from "vitest";
+
+import enMessages from "../../../../messages/en.json";
+import { ProductAttributes } from "./product-attributes";
+
+const MESSAGES_DIR = join(import.meta.dirname, "../../../../messages");
+const LABEL = enMessages.pdp.attributes.storageConditions;
+
+const policyLabels = { shippingDays: "3", returnDays: "30" } as unknown as Parameters<
+	typeof ProductAttributes
+>[0]["policyLabels"];
+
+// Children are passed as createElement arguments (react/no-children-prop), so loosen the prop type.
+const IntlProvider = NextIntlClientProvider as ComponentType<
+	Omit<ComponentProps<typeof NextIntlClientProvider>, "children">
+>;
+
+function render(props: Partial<Parameters<typeof ProductAttributes>[0]> = {}): string {
+	return renderToStaticMarkup(
+		createElement(
+			IntlProvider,
+			{ locale: "en", messages: enMessages, onError: () => undefined },
+			createElement(ProductAttributes, {
+				descriptionHtml: ["<p>Soft cotton</p>"],
+				attributes: [{ name: "Material", value: "Cotton" }],
+				policyLabels,
+				...props,
+			}),
+		),
+	);
+}
+
+describe("ProductAttributes storage conditions", () => {
+	it("uses the label from the messages file", () => {
+		expect(LABEL).toBe("Storage Conditions");
+		expect(render({ storageConditions: "Keep dry" })).toContain(LABEL);
+	});
+
+	it("renders the item directly after Description and before Product Details", () => {
+		const html = render({ storageConditions: "Keep dry" });
+		const triggerIndex = (label: string) =>
+			html.search(new RegExp(`<button[^>]*aria-expanded="(?:true|false)"[^>]*>${label}`));
+		const description = triggerIndex(enMessages.pdp.attributes.description);
+		const storage = triggerIndex(LABEL);
+		const details = triggerIndex(enMessages.pdp.attributes.productDetails);
+		expect(description).toBeGreaterThanOrEqual(0);
+		expect(storage).toBeGreaterThan(description);
+		expect(details).toBeGreaterThan(storage);
+		expect(html).toContain("Keep dry");
+	});
+
+	it("opens the storage item by default", () => {
+		const html = render({ storageConditions: "Keep dry" });
+		const trigger = (label: string) =>
+			html.match(new RegExp(`<button[^>]*aria-expanded="(true|false)"[^>]*>${label}`))?.[1];
+		expect(trigger(LABEL)).toBe("true");
+		// control: items outside defaultValue stay collapsed
+		expect(trigger(enMessages.pdp.attributes.productDetails)).toBe("false");
+	});
+
+	it.each([null, undefined, ""])("hides the item and label when value is %j", (value) => {
+		const html = render({ storageConditions: value });
+		expect(html).not.toContain(LABEL);
+		expect(html).toContain(enMessages.pdp.attributes.description);
+	});
+
+	// Documents current behavior: the component only checks truthiness and does not trim, so a
+	// whitespace-only prop renders an item. SF-03 relies on the mapper trimming first (see storefront-view.test.ts).
+	it("renders an item for a whitespace-only prop (mapper must trim upstream)", () => {
+		expect(render({ storageConditions: "   " })).toContain(LABEL);
+	});
+
+	it("renders HTML in the value as escaped plain text", () => {
+		const html = render({ storageConditions: "<b>x</b>" });
+		expect(html).toContain("&lt;b&gt;x&lt;/b&gt;");
+		expect(html).not.toContain("<b>x</b>");
+	});
+
+	it("escapes script payloads", () => {
+		const html = render({ storageConditions: "<script>alert(1)</script>" });
+		expect(html).toContain("&lt;script&gt;alert(1)&lt;/script&gt;");
+		expect(html).not.toContain("<script>alert(1)");
+	});
+
+	it("keeps the description HTML path separate from the storage text", () => {
+		const html = render({ descriptionHtml: ["<p>Soft cotton</p>"], storageConditions: "<i>y</i>" });
+		expect(html).toContain("<p>Soft cotton</p>");
+		expect(html).toContain("&lt;i&gt;y&lt;/i&gt;");
+		expect(html).not.toContain("<i>y</i>");
+	});
+});
+
+describe("pdp.attributes.storageConditions messages", () => {
+	const files = readdirSync(MESSAGES_DIR).filter((f) => f.endsWith(".json"));
+
+	it("covers all 8 locale files", () => {
+		expect(files.sort()).toEqual(["de", "en", "fi", "fr", "ja", "ko", "nb", "pl"].map((l) => `${l}.json`));
+	});
+
+	it.each(["de", "en", "fi", "fr", "ja", "ko", "nb", "pl"])(
+		"defines a non-empty label in %s.json",
+		(locale) => {
+			const json = JSON.parse(readFileSync(join(MESSAGES_DIR, `${locale}.json`), "utf8")) as {
+				pdp?: { attributes?: { storageConditions?: unknown } };
+			};
+			const value = json?.pdp?.attributes?.storageConditions;
+			expect(typeof value).toBe("string");
+			expect((value as string).trim().length).toBeGreaterThan(0);
+		},
+	);
+});
