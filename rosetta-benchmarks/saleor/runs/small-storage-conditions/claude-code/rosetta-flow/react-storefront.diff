@@ -0,0 +1,39 @@
+import { readFileSync, readdirSync } from "node:fs";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+
+const ROOT = join(import.meta.dirname, "../../..");
+const read = (rel: string) => readFileSync(join(ROOT, rel), "utf8");
+
+describe("ProductDetailsExtension fragment contract", () => {
+	const fragment = read("src/graphql/extensions/ProductDetailsExtension.graphql");
+
+	it("is a fragment on Product that keeps __typename", () => {
+		expect(fragment).toMatch(/fragment\s+ProductDetailsExtension\s+on\s+Product\s*\{/);
+		expect(fragment).toMatch(/^\s*__typename\s*$/m);
+	});
+
+	it("selects the base storageConditions field", () => {
+		expect(fragment).toMatch(/^\s*storageConditions\s*$/m);
+	});
+
+	it("selects the translated storageConditions with $languageCode", () => {
+		expect(fragment).toMatch(/translation\(languageCode:\s*\$languageCode\)\s*\{\s*storageConditions\s*\}/);
+	});
+
+	it("is spread exactly once, by ProductDetails, which declares $languageCode", () => {
+		const spreads: string[] = [];
+		for (const file of readdirSync(join(ROOT, "src/graphql"), { recursive: true })) {
+			if (typeof file !== "string" || !file.endsWith(".graphql")) continue;
+			if (read(join("src/graphql", file)).includes("...ProductDetailsExtension")) spreads.push(file);
+		}
+		expect(spreads).toEqual(["ProductDetails.graphql"]);
+		const details = read("src/graphql/ProductDetails.graphql");
+		expect(details).toMatch(/\$languageCode:\s*LanguageCodeEnum!/);
+		expect(details).toMatch(/translation\(languageCode:\s*\$languageCode\)/);
+	});
+
+	it("leaves ProductDetails.graphql free of the fork field (ADR 0006)", () => {
+		expect(read("src/graphql/ProductDetails.graphql")).not.toContain("storageConditions");
+	});
+});
