@@ -0,0 +1,60 @@
+import { createElement, type ComponentType, type ReactNode } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { NextIntlClientProvider } from "next-intl";
+import { describe, expect, it } from "vitest";
+
+import messages from "../../../../messages/en.json";
+import { ProductStorageConditions, readStorageConditions } from "./product-storage-conditions";
+
+const IntlProvider = NextIntlClientProvider as ComponentType<{
+	locale: string;
+	messages: typeof messages;
+	children?: ReactNode;
+}>;
+
+describe("readStorageConditions", () => {
+	// TF-04
+	it.each([[undefined], [null], [42], [true], [{}], [["x"]], [""], ["   "], ["\n\t "]])(
+		"returns null for %j",
+		(value) => {
+			expect(readStorageConditions({ storageConditions: value })).toBeNull();
+		},
+	);
+
+	it("returns null when the key is missing", () => {
+		expect(readStorageConditions({})).toBeNull();
+	});
+
+	it("returns the trimmed string", () => {
+		expect(readStorageConditions({ storageConditions: "  Keep dry \n" })).toBe("Keep dry");
+	});
+
+	it("keeps internal newlines", () => {
+		expect(readStorageConditions({ storageConditions: "a\nb" })).toBe("a\nb");
+	});
+});
+
+describe("ProductStorageConditions", () => {
+	const render = (value: string) =>
+		renderToStaticMarkup(
+			createElement(
+				IntlProvider,
+				{ locale: "en", messages },
+				createElement(ProductStorageConditions, { value }),
+			),
+		);
+
+	it("renders label, value and whitespace-pre-line", () => {
+		const html = render("Keep refrigerated at 2–8 °C");
+		expect(html).toContain('data-testid="pdp-storage-conditions"');
+		expect(html).toContain("Storage conditions");
+		expect(html).toContain("Keep refrigerated at 2–8 °C");
+		expect(html).toMatch(/<p class="[^"]*whitespace-pre-line[^"]*">/);
+	});
+
+	it("escapes HTML as literal text", () => {
+		const html = render("<b>x</b>");
+		expect(html).toContain("&lt;b&gt;x&lt;/b&gt;");
+		expect(html).not.toContain("<b>");
+	});
+});
