@@ -0,0 +1,20 @@
+import { useTranslations } from "next-intl";
+
+/** Returns a non-empty trimmed string from `extensions.storageConditions`, else null. */
+export function readStorageConditions(extensions: Record<string, unknown>): string | null {
+	const value = extensions.storageConditions;
+	if (typeof value !== "string") return null;
+	const trimmed = value.trim();
+	return trimmed || null;
+}
+
+/** Plain-text storage conditions block. Rendered as escaped text; never as HTML. */
+export function ProductStorageConditions({ value }: { value: string }) {
+	const t = useTranslations("pdp.attributes");
+	return (
+		<section data-testid="pdp-storage-conditions" className="mt-4">
+			<h2 className="text-sm font-medium text-foreground">{t("storageConditions")}</h2>
+			<p className="mt-1 whitespace-pre-line text-sm text-muted-foreground">{value}</p>
+		</section>
+	);
+}
