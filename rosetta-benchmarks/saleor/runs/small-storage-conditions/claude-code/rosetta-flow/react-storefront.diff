+import { createElement, type ComponentType, type ReactNode } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { NextIntlClientProvider } from "next-intl";
+import { describe, expect, it, vi } from "vitest";
+
+import messages from "../../../messages/en.json";
+import type { ProductView } from "@/lib/storefront/contract/product";
+import { PDP_TEMPLATES } from "@/templates/pdp/registry";
+
+const IntlProvider = NextIntlClientProvider as ComponentType<{
+	locale: string;
+	messages: typeof messages;
+	children?: ReactNode;
+}>;
+
+vi.mock("next/dynamic", () => ({
+	default: () => () => null,
+}));
+
+const baseProduct: ProductView = {
+	id: "p1",
+	slug: "tee",
+	name: "Tee",
+	category: null,
+	descriptionHtml: ["<p>Soft</p>"],
+	attributes: [],
+	careInstructions: null,
+	images: [],
+	priceRange: null,
+	isAvailable: true,
+	isBestseller: false,
+	variantCount: 1,
+	seoTitle: null,
+	seoDescription: null,
+	extensions: {},
+};
+
+function slot(id: string) {
+	return createElement("div", { id });
+}
+
+function render(
+	template: (typeof PDP_TEMPLATES)[keyof typeof PDP_TEMPLATES],
+	extensions: Record<string, unknown>,
+	withIntl = true,
+) {
+	const layout = createElement(template.Layout, {
+		product: { ...baseProduct, extensions },
+		slots: {
+			gallery: slot("pdp-slot-gallery"),
+			buyBox: slot("pdp-slot-buybox"),
+			breadcrumbs: slot("pdp-slot-breadcrumbs"),
+			attributes: slot("pdp-slot-attributes"),
+		},
+	});
+	return renderToStaticMarkup(
+		withIntl ? createElement(IntlProvider, { locale: "en", messages }, layout) : layout,
+	);
+}
+
+const templates = Object.values(PDP_TEMPLATES);
+
+describe("PDP layouts: storage conditions", () => {
+	it("covers every registered template", () => {
+		expect(templates.length).toBeGreaterThan(0);
+	});
+
+	// TF-05
+	it.each(templates.map((t) => [t.id, t] as const))(
+		"%s: renders one block after the attributes slot, inside the same wrapper",
+		(_id, template) => {
+			const html = render(template, { storageConditions: "Keep refrigerated at 2–8 °C" });
+			expect(html.match(/data-testid="pdp-storage-conditions"/g)).toHaveLength(1);
+			expect(html).toContain("Storage conditions");
+			expect(html).toContain("Keep refrigerated at 2–8 °C");
+			// the block directly follows the attributes slot and is the last child of that wrapper
+			expect(html).toMatch(
+				/<div id="pdp-slot-attributes"><\/div><section data-testid="pdp-storage-conditions"[^>]*>.*<\/section><\/div>/,
+			);
+		},
+	);
+
+	// TF-06
+	it.each(templates.map((t) => [t.id, t] as const))(
+		"%s: no block when extensions are empty",
+		(_id, template) => {
+			expect(render(template, {})).not.toContain("pdp-storage-conditions");
+		},
+	);
+
+	it.each(templates.map((t) => [t.id, t] as const))(
+		"%s: no block for null/blank and renders without an intl provider",
+		(_id, template) => {
+			for (const value of [null, "", "   ", 5]) {
+				const html = render(template, { storageConditions: value }, false);
+				expect(html).not.toContain("pdp-storage-conditions");
+				expect(html).toContain('id="pdp-slot-attributes"');
+			}
+		},
+	);
+
+	// TF-07
+	it.each(templates.map((t) => [t.id, t] as const))("%s: escapes HTML in the value", (_id, template) => {
+		const html = render(template, { storageConditions: "<b>x</b>" });
+		expect(html).toContain("&lt;b&gt;x&lt;/b&gt;");
+		expect(html).not.toContain("<b>x");
+	});
+});
