+import { MemoryRouter } from "react-router-dom";
+
+import { TranslationsProductsPage } from "./TranslationsProductsPage";
+
+// EditorJS (third-party) cannot run in jsdom; the description field is not under test.
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditor", () => ({
+  __esModule: true,
+  default: (): null => null,
+}));
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditorContent", () => ({
+  __esModule: true,
+  default: (): null => null,
+}));
+
+// DynamicCombobox-style components use IntersectionObserver, which jsdom lacks.
+global.IntersectionObserver = jest.fn().mockImplementation(() => ({
+  observe: jest.fn(),
+  unobserve: jest.fn(),
+  disconnect: jest.fn(),
+}));
+
+const buildData = (
+  storageConditions: string | null,
+  translated: string | null,
+): ProductTranslationFragment =>
+  ({
+    __typename: "ProductTranslatableContent",
+    id: "p1",
+    product: {
+      __typename: "Product",
+      id: "p1",
+      name: "Vaccine",
+      description: null,
+      seoDescription: null,
+      seoTitle: null,
+      slug: "vaccine",
+      storageConditions,
+    },
+    translation: {
+      __typename: "ProductTranslation",
+      id: "t1",
+      description: null,
+      name: null,
+      seoDescription: null,
+      seoTitle: null,
+      slug: null,
+      storageConditions: translated,
+      language: { __typename: "LanguageDisplay", code: LanguageCodeEnum.PL, language: "Polish" },
+    },
+    attributeValues: [],
+  }) as unknown as ProductTranslationFragment;
+
+type PageProps = React.ComponentProps<typeof TranslationsProductsPage>;
+
+const renderPage = (
+  data: ProductTranslationFragment,
+  props: Partial<PageProps> = {},
+): ReturnType<typeof render> =>
+  render(
+    <MemoryRouter>
+      <TranslationsProductsPage
+        translationId="p1"
+        productId="p1"
+        bulk={false}
+        disabled={false}
+        languageCode="PL"
+        languages={languages}
+        data={data}
+        saveButtonState="default"
+        onBulkChange={jest.fn()}
+        onEdit={jest.fn()}
+        onDiscard={jest.fn()}
+        onSubmit={jest.fn().mockResolvedValue([])}
+        onAttributeValueSubmit={jest.fn()}
+        {...props}
+      />
+    </MemoryRouter>,
+    { wrapper: Wrapper },
+  );
+
+describe("TranslationsProductsPage storage conditions section", () => {
+  it("renders the storage conditions section with the base and translated values", () => {
+    // Arrange / Act
+    renderPage(buildData("Keep refrigerated", "Przechowywać w lodówce"));
+
+    // Assert
+    expect(screen.getAllByText("Storage conditions").length).toBeGreaterThan(0);
+    expect(screen.getByText("Keep refrigerated")).toBeInTheDocument();
+    expect(screen.getByText("Przechowywać w lodówce")).toBeInTheDocument();
+  });
+
+  it("places the section after the general section and before SEO", () => {
+    // Arrange / Act
+    renderPage(buildData("Keep refrigerated", null));
+
+    // Assert - DOM order of the field rows, independent of copy
+    const general = screen.getByTestId(`translation-field-${TranslationInputFieldName.name}`);
+    const storage = screen.getByTestId(
+      `translation-field-${TranslationInputFieldName.storageConditions}`,
+    );
+    const seo = screen.getByTestId(`translation-field-${TranslationInputFieldName.seoTitle}`);
+
+    expect(
+      general.compareDocumentPosition(storage) & Node.DOCUMENT_POSITION_FOLLOWING,
+    ).toBeTruthy();
+    expect(storage.compareDocumentPosition(seo) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
+  });
+
+  it("calls onEdit with the storageConditions field name when edit is clicked", async () => {
+    // Arrange
+    const onEdit = jest.fn();
+    const user = userEvent.setup();
+
+    renderPage(buildData("Keep refrigerated", null), { onEdit });
+
+    // Act
+    await user.click(screen.getByTestId(`edit-${TranslationInputFieldName.storageConditions}`));
+
+    // Assert
+    expect(onEdit).toHaveBeenCalledTimes(1);
+    expect(onEdit).toHaveBeenCalledWith(TranslationInputFieldName.storageConditions);
+  });
+
+  it("submits the storageConditions field with the typed translation", async () => {
+    // Arrange
+    const onSubmit = jest.fn().mockResolvedValue([]);
+    const user = userEvent.setup();
+
+    renderPage(buildData("Keep refrigerated", null), {
+      onSubmit,
+      activeField: TranslationInputFieldName.storageConditions,
+    });
+
+    // Act
+    await user.type(screen.getByTestId("translation-field"), "Przechowywać w lodówce");
+    await user.click(screen.getByTestId("button-bar-confirm"));
+
+    // Assert
+    await waitFor(() => expect(onSubmit).toHaveBeenCalledTimes(1));
+    expect(onSubmit.mock.calls[0][0]).toMatchObject({
+      name: TranslationInputFieldName.storageConditions,
+    });
+    expect(onSubmit.mock.calls[0][1]).toBe("Przechowywać w lodówce");
+  });
+});
