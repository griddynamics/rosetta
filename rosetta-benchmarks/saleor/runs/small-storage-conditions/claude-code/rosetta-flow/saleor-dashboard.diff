+// @ts-strict-ignore
+import {
+  LanguageCodeEnum,
+  type LanguageFragment,
+  type ProductTranslationFragment,
+} from "@dashboard/graphql";
+import {
+  type TranslationField,
+  TranslationFieldType,
+  TranslationInputFieldName,
+  type TranslationSectionConfig,
+} from "@dashboard/translations/types";
+import { render } from "@testing-library/react";
+
+import { TranslationsProductsPage } from "./TranslationsProductsPage";
+
+let mockCapturedLayoutProps: {
+  sections: TranslationSectionConfig[];
+  onSubmit: (field: TranslationField, data: string) => unknown;
+};
+
+jest.mock("@dashboard/graphql/schemaVersion", () => ({
+  isMainSchema: () => true,
+  isStagingSchema: () => false,
+}));
+jest.mock(
+  "@dashboard/translations/components/TranslationsDetailLayout/TranslationsDetailLayout",
+  () => ({
+    TranslationsDetailLayout: (props: typeof mockCapturedLayoutProps) => {
+      mockCapturedLayoutProps = props;
+
+      return null;
+    },
+  }),
+);
+jest.mock("@dashboard/components/AppLayout/TopNav", () => ({
+  TopNav: () => null,
+  TopNavDestinationIcon: { translations: () => null },
+  topNavDestinationMessages: { translations: { id: "x", defaultMessage: "Translations" } },
+}));
+jest.mock("@dashboard/components/LanguageSwitch/LanguageSwitch", () => ({
+  LanguageSwitchWithCaching: () => null,
+}));
+jest.mock("@dashboard/components/Layouts/Detail", () => {
+  const Passthrough = function Passthrough({ children }: { children: React.ReactNode }) {
+    return <div>{children}</div>;
+  };
+  const DetailPageLayout = Object.assign(Passthrough, { Content: Passthrough });
+
+  return { DetailPageLayout };
+});
+jest.mock(
+  "@dashboard/extensions/components/ExtensionsButtonSelector/ExtensionsButtonSelector",
+  () => ({
+    ExtensionsButtonSelector: () => null,
+  }),
+);
+jest.mock("@dashboard/extensions/getExtensionsItems", () => ({
+  getExtensionsItemsForTranslationDetails: () => [],
+}));
+jest.mock("@dashboard/extensions/hooks/useExtensions", () => ({
+  useExtensions: () => ({ TRANSLATIONS_MORE_ACTIONS: [] }),
+}));
+jest.mock(
+  "@dashboard/extensions/components/AppExtensionContext/AppExtensionContextProvider",
+  () => ({
+    useActiveAppExtension: () => ({
+      attachFormState: jest.fn(),
+      active: false,
+      framesByFormType: {},
+    }),
+  }),
+);
+jest.mock("@dashboard/hooks/useNavigator", () => ({
+  __esModule: true,
+  default: () => jest.fn(),
+}));
+jest.mock("../ProductContextSwitcher/ProductContextSwitcher", () => ({
+  ProductContextSwitcher: () => null,
+}));
+
+const language: LanguageFragment = {
+  __typename: "LanguageDisplay",
+  code: LanguageCodeEnum.DE,
+  language: "German",
+};
+
+const buildData = (overrides: {
+  storageConditions?: string | null;
+  translationStorageConditions?: string | null;
+}): ProductTranslationFragment =>
+  ({
+    __typename: "ProductTranslatableContent",
+    product: {
+      __typename: "Product",
+      id: "p-1",
+      name: "Juice",
+      description: null,
+      seoDescription: null,
+      seoTitle: null,
+      slug: "juice",
+      storageConditions: overrides.storageConditions ?? null,
+    },
+    translation: {
+      __typename: "ProductTranslation",
+      id: "t-1",
+      name: null,
+      description: null,
+      seoDescription: null,
+      seoTitle: null,
+      slug: null,
+      storageConditions: overrides.translationStorageConditions ?? null,
+      language,
+    },
+    attributeValues: [],
+  }) as unknown as ProductTranslationFragment;
+
+const renderPage = (data: ProductTranslationFragment, onSubmit = jest.fn()) => {
+  render(
+    <TranslationsProductsPage
+      translationId="p-1"
+      productId="p-1"
+      activeField={undefined}
+      bulk={false}
+      disabled={false}
+      languageCode="DE"
+      languages={[language]}
+      data={data}
+      saveButtonState="default"
+      onBulkChange={jest.fn()}
+      onEdit={jest.fn()}
+      onDiscard={jest.fn()}
+      onSubmit={onSubmit}
+      onAttributeValueSubmit={jest.fn()}
+    />,
+  );
+
+  return { onSubmit };
+};
+
+describe("TranslationsProductsPage storage conditions (main schema)", () => {
+  it("appends a LONG storageConditions field after description in the general section", () => {
+    // Arrange & Act
+    renderPage(
+      buildData({
+        storageConditions: "Keep dry",
+        translationStorageConditions: "Trocken lagern",
+      }),
+    );
+
+    // Assert
+    const general = mockCapturedLayoutProps.sections.find(section => section.id === "general");
+    const names = general.fields.map(field => field.name);
+
+    expect(names).toEqual([
+      TranslationInputFieldName.name,
+      TranslationInputFieldName.description,
+      TranslationInputFieldName.storageConditions,
+    ]);
+    expect(general.fields[2]).toEqual(
+      expect.objectContaining({
+        displayName: "Storage conditions",
+        type: TranslationFieldType.LONG,
+        value: "Keep dry",
+        translation: "Trocken lagern",
+      }),
+    );
+  });
+
+  it("falls back to empty source value and null translation", () => {
+    // Arrange & Act
+    renderPage(buildData({}));
+
+    // Assert
+    const general = mockCapturedLayoutProps.sections.find(section => section.id === "general");
+    const field = general.fields.find(f => f.name === TranslationInputFieldName.storageConditions);
+
+    expect(field.value).toBe("");
+    expect(field.translation).toBeNull();
+  });
+
+  it("submits the storageConditions field through onSubmit", () => {
+    // Arrange
+    const { onSubmit } = renderPage(buildData({ storageConditions: "Keep dry" }));
+    const general = mockCapturedLayoutProps.sections.find(section => section.id === "general");
+    const field = general.fields.find(f => f.name === TranslationInputFieldName.storageConditions);
+
+    // Act
+    mockCapturedLayoutProps.onSubmit(field, "Trocken lagern");
+
+    // Assert
+    expect(onSubmit).toHaveBeenCalledWith(field, "Trocken lagern");
+  });
+});
