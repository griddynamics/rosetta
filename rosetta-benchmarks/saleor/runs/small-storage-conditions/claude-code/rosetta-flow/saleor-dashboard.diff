+  it("builds an entity-scoped section with one SHORT field", () => {
+    // Arrange / Act
+    const section = createStorageConditionsTranslationSection(mockIntl, {
+      storageConditions: "Keep refrigerated",
+      translationStorageConditions: "Gekühlt lagern",
+    });
+
+    // Assert
+    expect(section.id).toBe("storageConditions");
+    expect(section.submitScope).toBe(TranslationSubmitScope.entity);
+    expect(section.title).toBe("Storage conditions");
