@@ -0,0 +1,133 @@
+import { ProductErrorCode, type ProductErrorFragment } from "@dashboard/graphql";
+import { RichTextContext, type RichTextContextValues } from "@dashboard/utils/richText/context";
+import Wrapper from "@test/wrapper";
+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+import { useState } from "react";
+
+import { ProductDetailsForm } from "./ProductDetailsForm";
+
+// isReadyForMount=false keeps the EditorJS editor out of jsdom; only the context shape is needed.
+const richTextValue = {
+  editorRef: { current: null },
+  defaultValue: undefined,
+  isReadyForMount: false,
+  handleChange: jest.fn(),
+} as unknown as RichTextContextValues;
+
+const baseData = {
+  name: "Vaccine",
+  description: { blocks: [] },
+  rating: null,
+  storageConditions: "Keep refrigerated at 2–8 °C",
+};
+
+const renderForm = (
+  props: Partial<React.ComponentProps<typeof ProductDetailsForm>> = {},
+  data = baseData,
+): ReturnType<typeof render> =>
+  render(
+    <RichTextContext.Provider value={richTextValue}>
+      <ProductDetailsForm data={data} errors={[]} onChange={jest.fn()} {...props} />
+    </RichTextContext.Provider>,
+    { wrapper: Wrapper },
+  );
+
+describe("ProductDetailsForm storage conditions", () => {
+  it("renders a single-line input carrying the current value", () => {
+    // Arrange / Act
+    renderForm();
+
+    // Assert
+    const input = screen.getByTestId("product-storage-conditions");
+
+    expect(input.tagName).toBe("INPUT");
+    expect(input).toHaveValue("Keep refrigerated at 2–8 °C");
+    expect(input).toHaveAttribute("name", "storageConditions");
+  });
+
+  it("fires onChange with the storageConditions field name when typing", async () => {
+    // Arrange
+    const onChange = jest.fn();
+    const user = userEvent.setup();
+
+    renderForm({ onChange }, { ...baseData, storageConditions: "" });
+
+    // Act
+    await user.type(screen.getByTestId("product-storage-conditions"), "x");
+
+    // Assert
+    expect(onChange).toHaveBeenCalled();
+    expect(onChange.mock.calls[0][0].target.name).toBe("storageConditions");
+  });
+
+  it("shows the storefront and length helper hint when there is no error", () => {
+    // Arrange / Act
+    renderForm();
+
+    // Assert
+    expect(
+      screen.getByText("Shown to customers on the product page. Up to 250 characters, plain text."),
+    ).toBeInTheDocument();
+  });
+
+  it("shows the server error text instead of the hint for a storageConditions error", () => {
+    // Arrange
+    const errors: ProductErrorFragment[] = [
+      {
+        __typename: "ProductError",
+        code: ProductErrorCode.INVALID,
+        field: "storageConditions",
+        message: "Ensure this value has at most 250 characters.",
+      },
+    ];
+
+    // Act
+    renderForm({ errors });
+
+    // Assert
+    expect(screen.getByText("Invalid value")).toBeInTheDocument();
+    expect(
+      screen.queryByText(
+        "Shown to customers on the product page. Up to 250 characters, plain text.",
+      ),
+    ).not.toBeInTheDocument();
+  });
+
+  it("keeps a 251-character value on the client so the server error stays reachable", async () => {
+    // Arrange
+    const longValue = "a".repeat(251);
+
+    renderForm({}, { ...baseData, storageConditions: longValue });
+
+    // Assert - the controlled input shows the full value, nothing is truncated client-side
+    expect(screen.getByTestId("product-storage-conditions")).toHaveValue(longValue);
+  });
+
+  it("does not truncate typed input beyond 250 characters", async () => {
+    // Arrange - uncontrolled-style harness so typing accumulates in the field
+    const Harness = (): React.ReactElement => {
+      const [value, setValue] = useState("");
+
+      return (
+        <RichTextContext.Provider value={richTextValue}>
+          <ProductDetailsForm
+            data={{ ...baseData, storageConditions: value }}
+            errors={[]}
+            onChange={event => setValue(event.target.value)}
+          />
+        </RichTextContext.Provider>
+      );
+    };
+    const user = userEvent.setup();
+
+    render(<Harness />, { wrapper: Wrapper });
+
+    // Act
+    await user.click(screen.getByTestId("product-storage-conditions"));
+    await user.paste("b".repeat(251));
+
+    // Assert
+    expect(screen.getByTestId("product-storage-conditions")).toHaveValue("b".repeat(251));
+  });
+});
