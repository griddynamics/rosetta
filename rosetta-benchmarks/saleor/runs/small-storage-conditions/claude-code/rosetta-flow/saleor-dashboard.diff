@@ -0,0 +1,132 @@
+import { ProductErrorCode, type ProductErrorFragment } from "@dashboard/graphql";
+import { RichTextContext, type RichTextContextValues } from "@dashboard/utils/richText/context";
+import { fireEvent, render, screen } from "@testing-library/react";
+
+import { ProductDetailsForm } from "./ProductDetailsForm";
+
+jest.mock("@dashboard/graphql/schemaVersion", () => ({
+  isMainSchema: () => true,
+  isStagingSchema: () => false,
+}));
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditor", () => ({
+  __esModule: true,
+  default: () => null,
+}));
+
+const richTextContext = {
+  editorRef: { current: null },
+  defaultValue: undefined,
+  isReadyForMount: false,
+  handleChange: jest.fn(),
+} as unknown as RichTextContextValues;
+
+const baseData = { description: { blocks: [] }, name: "Juice", rating: null };
+
+const setup = (
+  data: { storageConditions?: string } = {},
+  errors: ProductErrorFragment[] = [],
+  onChange = jest.fn(),
+) => {
+  const { unmount } = render(
+    <RichTextContext.Provider value={richTextContext}>
+      <ProductDetailsForm data={{ ...baseData, ...data }} errors={errors} onChange={onChange} />
+    </RichTextContext.Provider>,
+  );
+
+  return { onChange, unmount };
+};
+
+describe("ProductDetailsForm storage conditions (main schema)", () => {
+  it("renders the textarea with the current value and maxLength 250", () => {
+    // Arrange & Act
+    setup({ storageConditions: "Keep dry" });
+
+    // Assert
+    const field = screen.getByDisplayValue("Keep dry");
+
+    expect(field.tagName).toBe("TEXTAREA");
+    expect(field).toHaveAttribute("name", "storageConditions");
+    expect(field).toHaveAttribute("maxlength", "250");
+    expect(screen.getByText("Shown to customers on the product page.")).toBeInTheDocument();
+  });
+
+  it("shows the character counter when the value is non-empty", () => {
+    // Arrange & Act
+    setup({ storageConditions: "Keep dry" });
+
+    // Assert
+    expect(screen.getByText("(8 of 250 characters)")).toBeInTheDocument();
+  });
+
+  it("hides the counter when the value is empty", () => {
+    // Arrange & Act
+    setup({ storageConditions: "" });
+
+    // Assert
+    expect(screen.queryByText(/of 250 characters/)).not.toBeInTheDocument();
+  });
+
+  it("calls onChange when the user types", () => {
+    // Arrange
+    const { onChange } = setup({ storageConditions: "" });
+
+    // Act
+    fireEvent.change(screen.getByRole("textbox", { name: /storage conditions/i }), {
+      target: { value: "Cold" },
+    });
+
+    // Assert
+    expect(onChange).toHaveBeenCalledTimes(1);
+    expect(onChange.mock.calls[0][0].target.name).toBe("storageConditions");
+  });
+
+  it("renders a server error under the field", () => {
+    // Arrange
+    const errors = [
+      {
+        __typename: "ProductError",
+        code: ProductErrorCode.INVALID,
+        field: "storageConditions",
+        message: "Storage conditions are too long",
+      },
+    ] as ProductErrorFragment[];
+
+    // Act
+    setup({ storageConditions: "x" }, errors);
+
+    // Assert
+    expect(screen.getByText("Invalid value")).toBeInTheDocument();
+    expect(screen.queryByText("Shown to customers on the product page.")).not.toBeInTheDocument();
+  });
+
+  it("puts the field in the error state above 250 characters but not at exactly 250", () => {
+    // Arrange - reference classes for the normal and server-error states
+    const getTextarea = (): string =>
+      screen.getByRole("textbox", { name: /storage conditions/i }).className;
+    const normal = setup({ storageConditions: "a" });
+    const normalClass = getTextarea();
+
+    normal.unmount();
+
+    const serverError = setup({ storageConditions: "a" }, [
+      { __typename: "ProductError", code: ProductErrorCode.INVALID, field: "storageConditions" },
+    ] as ProductErrorFragment[]);
+    const errorClass = getTextarea();
+
+    serverError.unmount();
+
+    // Act & Assert - 250 characters is not an error
+    const atLimit = setup({ storageConditions: "a".repeat(250) });
+
+    expect(screen.getByText("(250 of 250 characters)")).toBeInTheDocument();
+    expect(getTextarea()).toBe(normalClass);
+    atLimit.unmount();
+
+    // Act & Assert - 251 characters renders the same error styling as a server error
+    setup({ storageConditions: "a".repeat(251) });
+
+    expect(screen.getByText("(251 of 250 characters)")).toBeInTheDocument();
+    expect(errorClass).not.toBe(normalClass);
+    expect(getTextarea()).toBe(errorClass);
+  });
+});
