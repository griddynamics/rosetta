+        name: TranslationInputFieldName.storageConditions,
+        translation: "Gekühlt lagern",
+        type: TranslationFieldType.SHORT,
+        value: "Keep refrigerated",
+      },
+    ]);
+  });
+
+  it("is null-safe: missing base becomes empty string, missing translation becomes null", () => {
+    // Arrange / Act
+    const section = createStorageConditionsTranslationSection(mockIntl, {
+      storageConditions: null,
+      translationStorageConditions: undefined,
+    });
+
+    // Assert
+    expect(section.fields[0]).toMatchObject({ value: "", translation: null });
+  });
+
+  it("handles fully empty data", () => {
+    // Arrange / Act
+    const section = createStorageConditionsTranslationSection(mockIntl, {});
+
+    // Assert
+    expect(section.fields[0]).toMatchObject({ value: "", translation: null });
+  });
+});
