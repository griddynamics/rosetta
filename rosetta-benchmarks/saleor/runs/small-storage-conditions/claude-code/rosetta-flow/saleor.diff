+def reject_storage_conditions_for_non_products(input_data: dict) -> None:
+    """Drop empty `storage_conditions` from the input, reject non-empty ones.
+
+    `TranslationInput` is shared with products, but only products have the field.
+    """
+    if "storage_conditions" not in input_data:
+        return
+    if input_data["storage_conditions"]:
+        raise ValidationError(
+            {
+                "storage_conditions": ValidationError(
+                    "Storage conditions can only be translated for products.",
+                    code=TranslationErrorCode.INVALID.value,
+                )
+            }
+        )
+    del input_data["storage_conditions"]
+
