+def test_product_bulk_translate_storage_conditions_too_long(
+    staff_api_client,
+    product_with_translations,
+    permission_manage_translations,
+):
+    # given
+    product = product_with_translations
+    product_id = graphene.Node.to_global_id("Product", product.id)
+    translations = [
+        {
+            "id": product_id,
+            "languageCode": LanguageCodeEnum.FR.name,
+            "translationFields": {"storageConditions": "a" * 251},
+        },
+        {
+            "id": product_id,
+            "languageCode": LanguageCodeEnum.PL.name,
+            "translationFields": {"storageConditions": "a" * 251},
+        },
+    ]
+
+    # when
+    staff_api_client.user.user_permissions.add(permission_manage_translations)
+    response = staff_api_client.post_graphql(
+        PRODUCT_BULK_TRANSLATE_MUTATION, {"translations": translations}
+    )
+
+    # then
+    # The row error code `max_length` is not part of the ProductTranslateErrorCode
+    # enum, the same as for any other too long translation field (e.g. name), so
+    # the API reports a protocol-level error; the rows must not be saved.
+    content = get_graphql_content(response, ignore_errors=True)
+    assert content["data"]["productBulkTranslate"]["count"] == 0
+    assert len(content["errors"]) == 2
+    assert all("max_length" in error["message"] for error in content["errors"])
+    assert product.translations.count() == 2
+    assert not product.translations.filter(storage_conditions__isnull=False).exists()
