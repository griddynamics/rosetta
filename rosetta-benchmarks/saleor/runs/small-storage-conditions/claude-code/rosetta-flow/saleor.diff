+PRODUCT_BULK_CREATE_STORAGE_CONDITIONS_MUTATION = """
+mutation ProductBulkCreate($products: [ProductBulkCreateInput!]!) {
+  productBulkCreate(products: $products) {
+    count
+    results {
+      errors {
+        path
+        code
+        message
+      }
+      product {
+        id
+        storageConditions
+      }
+    }
+  }
+}
+"""
+
+
+def test_product_bulk_create_with_storage_conditions(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    product_type_id = graphene.Node.to_global_id("ProductType", product_type.pk)
+    category_id = graphene.Node.to_global_id("Category", category.pk)
+    products = [
+        {
+            "productType": product_type_id,
+            "category": category_id,
+            "name": "sc product 1",
+            "storageConditions": "Keep refrigerated at 2–8 °C",
+        },
+        {
+            "productType": product_type_id,
+            "category": category_id,
+            "name": "sc product 2",
+            "storageConditions": "  x  ",
+        },
+        {
+            "productType": product_type_id,
+            "category": category_id,
+            "name": "sc product 3",
+            "storageConditions": "   ",
+        },
+        {
+            "productType": product_type_id,
+            "category": category_id,
+            "name": "sc product 4",
+        },
+    ]
+
+    # when
+    staff_api_client.user.user_permissions.add(permission_manage_products)
+    response = staff_api_client.post_graphql(
+        PRODUCT_BULK_CREATE_STORAGE_CONDITIONS_MUTATION, {"products": products}
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productBulkCreate"]
+    assert data["count"] == 4
+    assert all(not result["errors"] for result in data["results"])
+    returned = [r["product"]["storageConditions"] for r in data["results"]]
+    assert returned == ["Keep refrigerated at 2–8 °C", "x", None, None]
+    stored = dict(Product.objects.values_list("name", "storage_conditions"))
+    assert stored == {
+        "sc product 1": "Keep refrigerated at 2–8 °C",
+        "sc product 2": "x",
+        "sc product 3": None,
+        "sc product 4": None,
+    }
+
+
