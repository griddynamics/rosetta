+def test_product_bulk_create_with_storage_conditions(
+    staff_api_client,
+    product_type,
+    category,
+    permission_manage_products,
+):
+    # given
+    product_type_id = graphene.Node.to_global_id("ProductType", product_type.pk)
+    category_id = graphene.Node.to_global_id("Category", category.pk)
+    base = {"productType": product_type_id, "category": category_id}
+    products = [
+        {**base, "name": "p1", "storageConditions": "  Keep dry  "},
+        {**base, "name": "p2", "storageConditions": "   "},
+        {**base, "name": "p3", "storageConditions": "a" * 250},
+        {**base, "name": "p4"},
+        {**base, "name": "p5", "storageConditions": " " + "a" * 250 + " "},
+    ]
+
+    # when
+    staff_api_client.user.user_permissions.add(permission_manage_products)
+    response = staff_api_client.post_graphql(
+        PRODUCT_BULK_CREATE_MUTATION, {"products": products}
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productBulkCreate"]
+    assert data["count"] == 5
+    assert all(not result["errors"] for result in data["results"])
+    values = dict(Product.objects.values_list("name", "storage_conditions"))
+    assert values == {
+        "p1": "Keep dry",
+        "p2": None,
+        "p3": "a" * 250,
+        "p4": None,
+        "p5": "a" * 250,
+    }
+
+
