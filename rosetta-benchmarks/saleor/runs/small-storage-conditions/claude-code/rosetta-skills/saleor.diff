diff --git a/saleor/graphql/product/tests/mutations/test_product_storage_conditions.py b/saleor/graphql/product/tests/mutations/test_product_storage_conditions.py
new file mode 100644
index 0000000000..aa7bf3390d
--- /dev/null
+++ b/saleor/graphql/product/tests/mutations/test_product_storage_conditions.py
@@ -0,0 +1,357 @@
+import graphene
+import pytest
+
+from .....product.error_codes import ProductErrorCode
+from ....tests.utils import get_graphql_content
+
+PRODUCT_CREATE_MUTATION = """
+mutation createProduct($input: ProductCreateInput!) {
+  productCreate(input: $input) {
+    product {
+      id
+      storageConditions
+    }
+    errors {
+      field
+      code
+      message
+    }
+  }
+}
+"""
+
+PRODUCT_UPDATE_MUTATION = """
+mutation updateProduct($id: ID!, $input: ProductInput!) {
+  productUpdate(id: $id, input: $input) {
+    product {
+      storageConditions
+    }
+    errors {
+      field
+      code
+      message
+    }
+  }
+}
+"""
+
+PRODUCT_BULK_CREATE_MUTATION = """
+mutation ProductBulkCreate($products: [ProductBulkCreateInput!]!) {
+  productBulkCreate(products: $products) {
+    count
+    results {
+      errors {
+        path
+        code
+      }
+      product {
+        storageConditions
+      }
+    }
+  }
+}
+"""
+
+PRODUCT_QUERY = """
+query Product($id: ID!, $channel: String) {
+  product(id: $id, channel: $channel) {
+    storageConditions
+  }
+}
+"""
+
+STORAGE_CONDITIONS = "Keep refrigerated at 2–8 °C"
+
+
+def _create_input(product_type, category, **kwargs):
+    return {
+        "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+        "category": graphene.Node.to_global_id("Category", category.pk),
+        "name": "Storage product",
+        **kwargs,
+    }
+
+
+def test_product_storage_conditions_defaults_to_empty_string(product):
+    assert product.storage_conditions == ""
+
+
+def test_product_create_with_storage_conditions(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    variables = {
+        "input": _create_input(
+            product_type, category, storageConditions=STORAGE_CONDITIONS
+        )
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_CREATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == STORAGE_CONDITIONS
+
+
+def test_product_create_without_storage_conditions(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    variables = {"input": _create_input(product_type, category)}
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_CREATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == ""
+
+
+@pytest.mark.parametrize(
+    "value",
+    [
+        "x" * 250,
+        "Store < 8 °C",
+        "<img src=x onerror=alert(1)>",
+        "  padded  ",
+    ],
+)
+def test_product_create_storage_conditions_is_stored_as_submitted(
+    value, staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    variables = {
+        "input": _create_input(product_type, category, storageConditions=value)
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_CREATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == value
+
+
+def test_product_create_storage_conditions_too_long(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    variables = {
+        "input": _create_input(product_type, category, storageConditions="x" * 251)
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_CREATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert data["product"] is None
+    assert len(data["errors"]) == 1
+    assert data["errors"][0]["field"] == "storageConditions"
+    assert data["errors"][0]["code"] == ProductErrorCode.INVALID.name
+
+
+def test_product_create_storage_conditions_null_is_empty_string(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    variables = {"input": _create_input(product_type, category, storageConditions=None)}
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_CREATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == ""
+
+
+def test_product_update_storage_conditions(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"storageConditions": STORAGE_CONDITIONS},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_UPDATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == STORAGE_CONDITIONS
+    product.refresh_from_db()
+    assert product.storage_conditions == STORAGE_CONDITIONS
+
+
+@pytest.mark.parametrize("cleared_value", [None, ""])
+def test_product_update_clears_storage_conditions(
+    cleared_value, staff_api_client, product, permission_manage_products
+):
+    # given
+    product.storage_conditions = STORAGE_CONDITIONS
+    product.save(update_fields=["storage_conditions"])
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"storageConditions": cleared_value},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_UPDATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert not data["errors"]
+    product.refresh_from_db()
+    assert product.storage_conditions == ""
+
+
+def test_product_update_without_storage_conditions_keeps_value(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    product.storage_conditions = STORAGE_CONDITIONS
+    product.save(update_fields=["storage_conditions"])
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"name": "Renamed"},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_UPDATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == STORAGE_CONDITIONS
+
+
+def test_product_update_storage_conditions_too_long(
+    staff_api_client, product, permission_manage_products
+):
+    # given
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"storageConditions": "x" * 251},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_UPDATE_MUTATION, variables, permissions=[permission_manage_products]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert len(data["errors"]) == 1
+    assert data["errors"][0]["field"] == "storageConditions"
+    assert data["errors"][0]["code"] == ProductErrorCode.INVALID.name
+    product.refresh_from_db()
+    assert product.storage_conditions == ""
+
+
+def test_product_update_storage_conditions_no_permission(staff_api_client, product):
+    # given
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"storageConditions": STORAGE_CONDITIONS},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(PRODUCT_UPDATE_MUTATION, variables)
+
+    # then
+    assert response.status_code == 200
+    assert "errors" in response.json()
+    product.refresh_from_db()
+    assert product.storage_conditions == ""
+
+
+def test_product_bulk_create_with_storage_conditions(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    products = [
+        _create_input(product_type, category, storageConditions=STORAGE_CONDITIONS),
+        _create_input(product_type, category, name="No storage"),
+        _create_input(
+            product_type, category, name="Null storage", storageConditions=None
+        ),
+    ]
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_BULK_CREATE_MUTATION,
+        {"products": products},
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productBulkCreate"]
+    assert data["count"] == 3
+    assert [r["product"]["storageConditions"] for r in data["results"]] == [
+        STORAGE_CONDITIONS,
+        "",
+        "",
+    ]
+
+
+def test_product_bulk_create_storage_conditions_too_long(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    products = [_create_input(product_type, category, storageConditions="x" * 251)]
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_BULK_CREATE_MUTATION,
+        {"products": products},
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productBulkCreate"]
+    assert data["count"] == 0
+    assert data["results"][0]["errors"][0]["path"] == "storageConditions"
+    # bulk mutations report model length errors with their own `MAX_LENGTH` code
+    assert data["results"][0]["errors"][0]["code"] == "MAX_LENGTH"
+
+
+def test_product_query_returns_storage_conditions_to_anonymous_user(
+    api_client, product, channel_USD
+):
+    # given
+    product.storage_conditions = STORAGE_CONDITIONS
+    product.save(update_fields=["storage_conditions"])
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "channel": channel_USD.slug,
+    }
+
+    # when
+    response = api_client.post_graphql(PRODUCT_QUERY, variables)
+
+    # then
+    content = get_graphql_content(response)
+    assert content["data"]["product"]["storageConditions"] == STORAGE_CONDITIONS
