--- /dev/null
+++ b/saleor/graphql/translations/tests/mutations/test_product_storage_conditions_translate.py
@@ -0,0 +1,345 @@
+import graphene
+import pytest
+
+from .....product.models import ProductTranslation
+from ....core.enums import LanguageCodeEnum
+from ....tests.utils import get_graphql_content
+
+PRODUCT_TRANSLATE_MUTATION = """
+    mutation (
+        $id: ID!,
+        $languageCode: LanguageCodeEnum!,
+        $input: TranslationInput!
+    ) {
+       productTranslate(id: $id, languageCode: $languageCode, input: $input) {
+            product {
+                storageConditions
+                translation(languageCode: $languageCode) {
+                    storageConditions
+                }
+            }
+            errors {
+                message
+                code
+                field
+            }
+        }
+    }
+"""
+
+CATEGORY_TRANSLATE_MUTATION = """
+    mutation (
+        $id: ID!,
+        $languageCode: LanguageCodeEnum!,
+        $input: TranslationInput!
+    ) {
+       categoryTranslate(id: $id, languageCode: $languageCode, input: $input) {
+            errors {
+                code
+                field
+            }
+        }
+    }
+"""
+
+COLLECTION_TRANSLATE_MUTATION = """
+    mutation (
+        $id: ID!,
+        $languageCode: LanguageCodeEnum!,
+        $input: TranslationInput!
+    ) {
+       collectionTranslate(id: $id, languageCode: $languageCode, input: $input) {
+            errors {
+                code
+                field
+            }
+        }
+    }
+"""
+
+PRODUCT_BULK_TRANSLATE_MUTATION = """
+    mutation (
+        $translations: [ProductBulkTranslateInput!]!,
+        $errorPolicy: ErrorPolicyEnum
+    ) {
+        productBulkTranslate(translations: $translations, errorPolicy: $errorPolicy) {
+            count
+            results {
+                errors {
+                    path
+                    code
+                }
+                translation {
+                    storageConditions
+                }
+            }
+        }
+    }
+"""
+
+TRANSLATABLE_CONTENT_QUERY = """
+    query ($id: ID!) {
+        translation(kind: PRODUCT, id: $id) {
+            ... on ProductTranslatableContent {
+                storageConditions
+                translation(languageCode: PL) {
+                    storageConditions
+                }
+            }
+        }
+    }
+"""
+
+STORAGE_CONDITIONS_PL = "Przechowywać w lodówce w temp. 2–8 °C"
+
+
+def _translate(client, permission, product, storage_conditions, language=None):
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.id),
+        "languageCode": (language or LanguageCodeEnum.PL).name,
+        "input": {"storageConditions": storage_conditions},
+    }
+    response = client.post_graphql(
+        PRODUCT_TRANSLATE_MUTATION, variables, permissions=[permission]
+    )
+    return get_graphql_content(response)["data"]["productTranslate"]
+
+
+def test_product_translate_storage_conditions_creates_translation(
+    staff_api_client, product, permission_manage_translations
+):
+    # given
+    product.storage_conditions = "Keep refrigerated"
+    product.save(update_fields=["storage_conditions"])
+
+    # when
+    data = _translate(
+        staff_api_client,
+        permission_manage_translations,
+        product,
+        STORAGE_CONDITIONS_PL,
+    )
+
+    # then
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == "Keep refrigerated"
+    assert data["product"]["translation"]["storageConditions"] == STORAGE_CONDITIONS_PL
+    translation = ProductTranslation.objects.get(product=product, language_code="pl")
+    assert translation.storage_conditions == STORAGE_CONDITIONS_PL
+
+
+def test_product_translate_storage_conditions_updates_translation(
+    staff_api_client, product, permission_manage_translations
+):
+    # given
+    ProductTranslation.objects.create(
+        product=product, language_code="pl", storage_conditions="old"
+    )
+
+    # when
+    data = _translate(
+        staff_api_client,
+        permission_manage_translations,
+        product,
+        STORAGE_CONDITIONS_PL,
+    )
+
+    # then
+    assert not data["errors"]
+    assert ProductTranslation.objects.filter(product=product).count() == 1
+    assert data["product"]["translation"]["storageConditions"] == STORAGE_CONDITIONS_PL
+
+
+def test_product_translate_storage_conditions_can_be_cleared(
+    staff_api_client, product, permission_manage_translations
+):
+    # given
+    ProductTranslation.objects.create(
+        product=product, language_code="pl", storage_conditions="old"
+    )
+
+    # when
+    data = _translate(staff_api_client, permission_manage_translations, product, None)
+
+    # then
+    assert not data["errors"]
+    assert data["product"]["translation"]["storageConditions"] is None
+
+
+def test_product_translate_without_storage_conditions_keeps_value(
+    staff_api_client, product, permission_manage_translations
+):
+    # given
+    ProductTranslation.objects.create(
+        product=product, language_code="pl", storage_conditions="kept"
+    )
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.id),
+        "languageCode": LanguageCodeEnum.PL.name,
+        "input": {"name": "Nazwa"},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_TRANSLATE_MUTATION,
+        variables,
+        permissions=[permission_manage_translations],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productTranslate"]
+    assert not data["errors"]
+    assert data["product"]["translation"]["storageConditions"] == "kept"
+
+
+def test_product_translate_storage_conditions_too_long(
+    staff_api_client, product, permission_manage_translations
+):
+    # when
+    data = _translate(
+        staff_api_client, permission_manage_translations, product, "x" * 251
+    )
+
+    # then
+    assert len(data["errors"]) == 1
+    assert data["errors"][0]["field"] == "storageConditions"
+    assert data["errors"][0]["code"] == "INVALID"
+    assert not ProductTranslation.objects.filter(product=product).exists()
+
+
+def test_product_translate_storage_conditions_keeps_special_characters(
+    staff_api_client, product, permission_manage_translations
+):
+    # when
+    data = _translate(
+        staff_api_client, permission_manage_translations, product, "Store < 8 °C"
+    )
+
+    # then
+    assert not data["errors"]
+    assert data["product"]["translation"]["storageConditions"] == "Store < 8 °C"
+
+
+def test_product_translate_storage_conditions_requires_permission(
+    staff_api_client, product
+):
+    # given
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.id),
+        "languageCode": LanguageCodeEnum.PL.name,
+        "input": {"storageConditions": STORAGE_CONDITIONS_PL},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(PRODUCT_TRANSLATE_MUTATION, variables)
+
+    # then
+    assert "errors" in response.json()
+    assert not ProductTranslation.objects.filter(product=product).exists()
+
+
+@pytest.mark.parametrize("value", ["Keep cool", "", None])
+def test_category_translate_rejects_storage_conditions(
+    value, staff_api_client, category, permission_manage_translations
+):
+    # given
+    variables = {
+        "id": graphene.Node.to_global_id("Category", category.id),
+        "languageCode": LanguageCodeEnum.PL.name,
+        "input": {"name": "Kategoria", "storageConditions": value},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CATEGORY_TRANSLATE_MUTATION,
+        variables,
+        permissions=[permission_manage_translations],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["categoryTranslate"]
+    assert data["errors"] == [{"code": "INVALID", "field": "storageConditions"}]
+    assert not category.translations.exists()
+
+
+@pytest.mark.parametrize("value", ["Keep cool", "", None])
+def test_collection_translate_rejects_storage_conditions(
+    value, staff_api_client, collection, permission_manage_translations
+):
+    # given
+    variables = {
+        "id": graphene.Node.to_global_id("Collection", collection.id),
+        "languageCode": LanguageCodeEnum.PL.name,
+        "input": {"name": "Kolekcja", "storageConditions": value},
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        COLLECTION_TRANSLATE_MUTATION,
+        variables,
+        permissions=[permission_manage_translations],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["collectionTranslate"]
+    assert data["errors"] == [{"code": "INVALID", "field": "storageConditions"}]
+    assert not collection.translations.exists()
+
+
+def test_product_translatable_content_exposes_storage_conditions(
+    staff_api_client, product, permission_manage_translations
+):
+    # given
+    product.storage_conditions = "Keep refrigerated"
+    product.save(update_fields=["storage_conditions"])
+    ProductTranslation.objects.create(
+        product=product, language_code="pl", storage_conditions=STORAGE_CONDITIONS_PL
+    )
+    variables = {"id": graphene.Node.to_global_id("Product", product.id)}
+
+    # when
+    response = staff_api_client.post_graphql(
+        TRANSLATABLE_CONTENT_QUERY,
+        variables,
+        permissions=[permission_manage_translations],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["translation"]
+    assert data["storageConditions"] == "Keep refrigerated"
+    assert data["translation"]["storageConditions"] == STORAGE_CONDITIONS_PL
+
+
+def test_product_bulk_translate_storage_conditions(
+    staff_api_client, product_list, permission_manage_translations
+):
+    # given
+    first, second = product_list[0], product_list[1]
+    translations = [
+        {
+            "id": graphene.Node.to_global_id("Product", first.id),
+            "languageCode": LanguageCodeEnum.PL.name,
+            "translationFields": {"storageConditions": STORAGE_CONDITIONS_PL},
+        },
+        {
+            "id": graphene.Node.to_global_id("Product", second.id),
+            "languageCode": LanguageCodeEnum.PL.name,
+            "translationFields": {"storageConditions": "x" * 251},
+        },
+    ]
+
+    # when
+    response = staff_api_client.post_graphql(
+        PRODUCT_BULK_TRANSLATE_MUTATION,
+        {"translations": translations, "errorPolicy": "REJECT_FAILED_ROWS"},
+        permissions=[permission_manage_translations],
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productBulkTranslate"]
+    assert data["count"] == 1
+    assert (
+        data["results"][0]["translation"]["storageConditions"] == STORAGE_CONDITIONS_PL
+    )
+    assert data["results"][1]["errors"][0]["path"] == "storageConditions"
+    assert data["results"][1]["errors"][0]["code"] == "INVALID"
