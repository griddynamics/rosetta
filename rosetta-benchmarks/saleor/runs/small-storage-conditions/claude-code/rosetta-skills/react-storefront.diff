@@ -0,0 +1,28 @@
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+
+import { ProductStorageConditions } from "./product-storage-conditions";
+
+const render = (value: string | null | undefined) =>
+	renderToStaticMarkup(createElement(ProductStorageConditions, { label: "Storage conditions", value }));
+
+describe("ProductStorageConditions", () => {
+	it("renders the label and the value", () => {
+		const html = render("Keep refrigerated at 2–8 °C");
+
+		expect(html).toContain("Storage conditions:");
+		expect(html).toContain("Keep refrigerated at 2–8 °C");
+	});
+
+	it.each([null, undefined, ""])("renders nothing for %j", (value) => {
+		expect(render(value)).toBe("");
+	});
+
+	it("escapes markup in the value", () => {
+		const html = render("<img src=x onerror=alert(1)>");
+
+		expect(html).not.toContain("<img");
+		expect(html).toContain("&lt;img src=x onerror=alert(1)&gt;");
+	});
+});
