 /**
  * Fork-owned extras on `ProductView.extensions`.
@@ -9,6 +10,21 @@ import type { ProductShell } from "@/lib/catalog/get-product-data";
  * run `pnpm generate`, then map the new field here. Do not edit
  * `src/lib/storefront/mappers/product.ts` or the product route.
  */
-export function mapProductExtensions(_product: ProductShell): Record<string, unknown> {
-	return {};
+export function mapProductExtensions(product: ProductShell): Record<string, unknown> {
+	return {
+		storageConditions: resolveStorageConditions(product),
+	};
+}
+
+/** Translated value, falling back to the base one. Blank counts as not set. */
+function resolveStorageConditions(product: ProductShell): string | null {
+	const value = pickTranslatedField(product.translation, "storageConditions", product.storageConditions);
+	const trimmed = typeof value === "string" ? value.trim() : "";
+	return trimmed.length > 0 ? trimmed : null;
+}
+
+/** Typed read of the storage conditions put on `ProductView.extensions` by `mapProductExtensions`. */
+export function readStorageConditions(extensions: Record<string, unknown>): string | null {
+	const value = extensions.storageConditions;
+	return typeof value === "string" && value.length > 0 ? value : null;
 }
