+++ b/src/config/storefront-view.test.ts
@@ -0,0 +1,68 @@
+import { describe, expect, it } from "vitest";
+
+import type { ProductShell } from "@/lib/catalog/get-product-data";
+
+import { mapProductExtensions, readStorageConditions } from "./storefront-view";
+
+function shell(overrides: {
+	storageConditions?: string | null;
+	translation?: { storageConditions?: string | null } | null;
+}): ProductShell {
+	return { storageConditions: null, translation: null, ...overrides } as unknown as ProductShell;
+}
+
+describe("mapProductExtensions storage conditions", () => {
+	it("uses the base value when there is no translation", () => {
+		expect(mapProductExtensions(shell({ storageConditions: "Keep refrigerated at 2–8 °C" }))).toEqual({
+			storageConditions: "Keep refrigerated at 2–8 °C",
+		});
+	});
+
+	it("prefers the translated value", () => {
+		const result = mapProductExtensions(
+			shell({
+				storageConditions: "Keep refrigerated",
+				translation: { storageConditions: "Przechowywać w lodówce" },
+			}),
+		);
+
+		expect(result.storageConditions).toBe("Przechowywać w lodówce");
+	});
+
+	it.each([null, "", "   "])("falls back to the base value when the translation is %j", (translated) => {
+		const result = mapProductExtensions(
+			shell({ storageConditions: "Keep refrigerated", translation: { storageConditions: translated } }),
+		);
+
+		expect(result.storageConditions).toBe("Keep refrigerated");
+	});
+
+	it("trims the value", () => {
+		expect(
+			mapProductExtensions(shell({ storageConditions: "  Store below 25 °C \n" })).storageConditions,
+		).toBe("Store below 25 °C");
+	});
+
+	it.each([null, undefined, "", "   "])("returns null when nothing is set (%j)", (value) => {
+		expect(mapProductExtensions(shell({ storageConditions: value })).storageConditions).toBeNull();
+	});
+
+	it("keeps markup-like text untouched so it is escaped on render", () => {
+		expect(
+			mapProductExtensions(shell({ storageConditions: "Store < 8 °C <b>x</b>" })).storageConditions,
+		).toBe("Store < 8 °C <b>x</b>");
+	});
+});
+
+describe("readStorageConditions", () => {
+	it("reads the mapped value", () => {
+		expect(readStorageConditions({ storageConditions: "Keep cool" })).toBe("Keep cool");
+	});
+
+	it.each([{}, { storageConditions: null }, { storageConditions: "" }, { storageConditions: 42 }])(
+		"returns null for %j",
+		(extensions) => {
+			expect(readStorageConditions(extensions as Record<string, unknown>)).toBeNull();
+		},
+	);
+});
