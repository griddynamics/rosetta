@@ -0,0 +1,16 @@
+interface ProductStorageConditionsProps {
+	/** Localized label, e.g. "Storage conditions". */
+	label: string;
+	/** Plain text from the product; rendered as text, never as HTML. */
+	value: string | null | undefined;
+}
+
+export function ProductStorageConditions({ label, value }: ProductStorageConditionsProps) {
+	if (!value) return null;
+
+	return (
+		<p className="mt-3 text-sm text-muted-foreground" data-testid="product-storage-conditions">
+			<span className="font-medium text-foreground">{label}:</span> {value}
+		</p>
+	);
+}
