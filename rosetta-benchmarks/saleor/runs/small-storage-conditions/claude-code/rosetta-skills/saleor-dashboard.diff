@@ -0,0 +1,106 @@
+import Wrapper from "@test/wrapper";
+import { fireEvent, render, screen } from "@testing-library/react";
+
+import { ProductDetailsForm, STORAGE_CONDITIONS_MAX_LENGTH } from "./ProductDetailsForm";
+
+jest.mock("@dashboard/utils/richText/context", () => ({
+  useRichTextContext: () => ({
+    editorRef: { current: null },
+    defaultValue: undefined,
+    isReadyForMount: false,
+    handleChange: jest.fn(),
+  }),
+}));
+
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditor", () => ({
+  __esModule: true,
+  default: () => null,
+}));
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditorClamp", () => ({
+  RichTextEditorClamp: ({ children }: { children: React.ReactNode }) => children,
+}));
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditorLoading", () => ({
+  RichTextEditorLoading: () => null,
+}));
+
+jest.mock("@dashboard/graphql/schemaVersion", () => ({
+  isMainSchema: jest.fn(() => true),
+  isStagingSchema: jest.fn(() => false),
+}));
+
+const { isMainSchema: mockIsMainSchema } = jest.requireMock("@dashboard/graphql/schemaVersion");
+
+const renderForm = (
+  props: Partial<React.ComponentProps<typeof ProductDetailsForm>> & {
+    storageConditions?: string;
+  } = {},
+) => {
+  const { storageConditions, ...rest } = props;
+  // Capture name/value synchronously: the controlled input resets its DOM value after the event
+  const changes: Array<{ name: string; value: string }> = [];
+  const onChange = jest.fn((event: { target: { name: string; value: string } }) => {
+    changes.push({ name: event.target.name, value: event.target.value });
+  });
+
+  render(
+    <Wrapper>
+      <ProductDetailsForm
+        data={{ description: null, name: "Milk", rating: null, storageConditions }}
+        errors={[]}
+        onChange={onChange}
+        {...rest}
+      />
+    </Wrapper>,
+  );
+
+  return { onChange, changes };
+};
+
+describe("ProductDetailsForm storage conditions", () => {
+  beforeEach(() => {
+    mockIsMainSchema.mockReturnValue(true);
+  });
+
+  it("renders the stored value limited to 250 characters", () => {
+    // Arrange / Act
+    renderForm({ storageConditions: "Keep refrigerated at 2–8 °C" });
+
+    // Assert
+    const input = screen.getByTestId("product-storage-conditions");
+
+    expect(input).toHaveValue("Keep refrigerated at 2–8 °C");
+    expect(input).toHaveAttribute("maxlength", String(STORAGE_CONDITIONS_MAX_LENGTH));
+  });
+
+  it("reports changes using the storageConditions field name", () => {
+    // Arrange
+    const { onChange, changes } = renderForm({ storageConditions: "" });
+    const input = screen.getByTestId("product-storage-conditions");
+
+    // Act
+    fireEvent.change(input, { target: { value: "Store below 25 °C" } });
+
