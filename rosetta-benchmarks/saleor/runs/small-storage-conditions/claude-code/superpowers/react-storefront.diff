+import { describe, expect, it } from "vitest";
+
+import type { ProductShell } from "@/lib/catalog/get-product-data";
+import { mapProductExtensions } from "@/config/storefront-view";
+
+const shell = (overrides: Record<string, unknown>) => overrides as unknown as ProductShell;
+
+describe("mapProductExtensions", () => {
+	it("exposes the translated storage conditions", () => {
+		expect(
+			mapProductExtensions(
+				shell({
+					storageConditions: "Keep refrigerated at 2–8 °C",
+					translation: { storageConditions: "Réfrigérer entre 2–8 °C" },
+				}),
+			),
+		).toEqual({ storageConditions: "Réfrigérer entre 2–8 °C" });
+	});
+
+	it("falls back to the base storage conditions without a translation", () => {
+		expect(
+			mapProductExtensions(shell({ storageConditions: "Keep refrigerated at 2–8 °C", translation: null })),
+		).toEqual({ storageConditions: "Keep refrigerated at 2–8 °C" });
+	});
+
+	it("maps blank storage conditions to null", () => {
+		expect(mapProductExtensions(shell({ storageConditions: "  ", translation: null }))).toEqual({
+			storageConditions: null,
+		});
+	});
+});
