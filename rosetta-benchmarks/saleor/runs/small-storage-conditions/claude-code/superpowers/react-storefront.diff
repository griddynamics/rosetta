+/**
+ * Translated storage conditions with fallback to the base value.
+ * Blank values count as unset so the PDP never renders an empty block.
+ */
+export function pickTranslatedStorageConditions(entity: {
+	storageConditions?: string | null;
+	translation?: { storageConditions?: string | null } | null;
+}): string | null {
+	const value = pickTranslatedField(entity.translation, "storageConditions", entity.storageConditions);
+	return value?.trim() || null;
+}
