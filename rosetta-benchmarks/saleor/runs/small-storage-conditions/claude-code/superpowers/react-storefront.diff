@@ -0,0 +1,58 @@
+import { type ComponentType, createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { NextIntlClientProvider } from "next-intl";
+import { describe, expect, it } from "vitest";
+
+import messages from "../../../../messages/en.json";
+import { ProductAttributes } from "./product-attributes";
+
+const policyLabels = { freeShippingThreshold: "$50", returnsWindowDays: "30" } as never;
+
+// Loose typing: the provider's typings demand `children` in props, which the
+// react/no-children-prop rule forbids; the .ts test file has no JSX to sidestep it.
+const IntlProvider = NextIntlClientProvider as ComponentType<Record<string, unknown>>;
+
+function render(props: Record<string, unknown>) {
+	return renderToStaticMarkup(
+		createElement(
+			IntlProvider,
+			{ locale: "en", messages, timeZone: "UTC" },
+			createElement(ProductAttributes, { policyLabels, ...props }),
+		),
+	);
+}
+
+describe("ProductAttributes storage conditions", () => {
+	it("shows the label and text under the description", () => {
+		const html = render({
+			descriptionHtml: ["<p>Fresh milk</p>"],
+			storageConditions: "Keep refrigerated at 2–8 °C",
+		});
+
+		expect(html).toContain("Fresh milk");
+		expect(html).toContain("Storage conditions");
+		expect(html).toContain("Keep refrigerated at 2–8 °C");
+		expect(html.indexOf("Fresh milk")).toBeLessThan(html.indexOf("Keep refrigerated at 2–8 °C"));
+	});
+
+	it("shows the description section when only storage conditions exist", () => {
+		const html = render({ descriptionHtml: null, storageConditions: "Keep dry" });
+
+		expect(html).toContain("Keep dry");
+		expect(html).toContain("Storage conditions");
+	});
+
+	it.each([null, undefined, ""])("renders no storage block when the value is %j", (value) => {
+		const html = render({ descriptionHtml: ["<p>Fresh milk</p>"], storageConditions: value });
+
+		expect(html).toContain("Fresh milk");
+		expect(html).not.toContain("Storage conditions");
+	});
+
+	it("escapes markup in the storage text", () => {
+		const html = render({ descriptionHtml: null, storageConditions: "<img src=x onerror=alert(1)>" });
+
+		expect(html).not.toContain("<img src=x");
+		expect(html).toContain("&lt;img");
+	});
+});
