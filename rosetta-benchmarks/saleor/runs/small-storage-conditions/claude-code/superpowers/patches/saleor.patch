+"""
+
+
+def test_create_product_with_storage_conditions(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    storage_conditions = "Keep refrigerated at 2–8 °C"
+    variables = {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "category": graphene.Node.to_global_id("Category", category.pk),
+            "name": "Storage product",
+            "slug": "storage-product",
+            "storageConditions": storage_conditions,
+        }
+    }
+
+    # when
+    response = staff_api_client.post_graphql(
+        CREATE_PRODUCT_STORAGE_CONDITIONS_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["productCreate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == storage_conditions
+    assert (
+        Product.objects.get(slug="storage-product").storage_conditions
+        == storage_conditions
+    )
+
+
+def test_create_product_with_too_long_storage_conditions(
