+PRODUCT_BULK_CREATE_STORAGE_CONDITIONS_MUTATION = """
+mutation ProductBulkCreate($products: [ProductBulkCreateInput!]!) {
+  productBulkCreate(products: $products) {
+    results {
+      errors {
+        path
+        code
+        message
+      }
+      product {
+        storageConditions
+      }
+    }
+    count
+  }
+}
+"""
+
+
+def test_product_bulk_create_with_storage_conditions(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    product_type_id = graphene.Node.to_global_id("ProductType", product_type.pk)
+    category_id = graphene.Node.to_global_id("Category", category.pk)
+    products = [
+        {
+            "productType": product_type_id,
+            "category": category_id,
+            "name": "name 1",
+            "storageConditions": "  Keep refrigerated at 2–8 °C  ",
+        },
+        {
+            "productType": product_type_id,
+            "category": category_id,
+            "name": "name 2",
+            "storageConditions": "   ",
+        },
+    ]
+
+    # when
+    staff_api_client.user.user_permissions.add(permission_manage_products)
+    response = staff_api_client.post_graphql(
+        PRODUCT_BULK_CREATE_STORAGE_CONDITIONS_MUTATION, {"products": products}
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["productBulkCreate"]
+    assert data["count"] == 2
+    assert not data["results"][0]["errors"]
+    assert not data["results"][1]["errors"]
+    assert (
+        data["results"][0]["product"]["storageConditions"]
+        == "Keep refrigerated at 2–8 °C"
+    )
+    assert data["results"][1]["product"]["storageConditions"] is None
+    assert Product.objects.get(name="name 1").storage_conditions == (
+        "Keep refrigerated at 2–8 °C"
+    )
+    assert Product.objects.get(name="name 2").storage_conditions is None
+
+
+def test_product_bulk_create_storage_conditions_too_long(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    products = [
+        {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "category": graphene.Node.to_global_id("Category", category.pk),
+            "name": "name 1",
+            "storageConditions": "a" * 251,
+        },
+    ]
+
+    # when
+    staff_api_client.user.user_permissions.add(permission_manage_products)
+    response = staff_api_client.post_graphql(
+        PRODUCT_BULK_CREATE_STORAGE_CONDITIONS_MUTATION, {"products": products}
+    )
+
+    # then
+    content = get_graphql_content(response)
+    data = content["data"]["productBulkCreate"]
+    assert data["count"] == 0
+    assert data["results"][0]["errors"][0]["path"] == "storageConditions"
+    assert data["results"][0]["errors"][0]["code"] == "INVALID"
+    assert not Product.objects.exists()
