+def clean_storage_conditions(cleaned_input: dict):
+    """Trim storage conditions, store blank values as empty and enforce the limit."""
+    if "storage_conditions" not in cleaned_input:
+        return
+
+    storage_conditions = (cleaned_input["storage_conditions"] or "").strip() or None
