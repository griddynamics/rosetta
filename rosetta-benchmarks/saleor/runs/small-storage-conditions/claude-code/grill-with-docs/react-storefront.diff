+import { describe, expect, it } from "vitest";
+
+import type { ProductShell } from "@/lib/catalog/get-product-data";
+import { mapProductExtensions } from "@/config/storefront-view";
+
+function shell(overrides: Partial<ProductShell>): ProductShell {
+	return { storageConditions: null, translation: null, ...overrides } as ProductShell;
+}
+
+describe("mapProductExtensions", () => {
+	it("exposes the product's storage conditions", () => {
+		const extensions = mapProductExtensions(shell({ storageConditions: "Keep refrigerated at 2–8 °C" }));
+
+		expect(extensions.storageConditions).toBe("Keep refrigerated at 2–8 °C");
+	});
+
+	it("prefers the translated storage conditions", () => {
+		const extensions = mapProductExtensions(
+			shell({
+				storageConditions: "Keep refrigerated at 2–8 °C",
+				translation: {
+					storageConditions: "Przechowywać w lodówce w temp. 2–8 °C",
+				} as ProductShell["translation"],
+			}),
+		);
+
+		expect(extensions.storageConditions).toBe("Przechowywać w lodówce w temp. 2–8 °C");
+	});
+
+	it.each([null, "", "   "])("falls back to the original when the translation is %j", (translated) => {
+		const extensions = mapProductExtensions(
+			shell({
+				storageConditions: "Keep refrigerated at 2–8 °C",
+				translation: { storageConditions: translated } as ProductShell["translation"],
+			}),
+		);
+
+		expect(extensions.storageConditions).toBe("Keep refrigerated at 2–8 °C");
+	});
+
+	it("is null when neither the product nor its translation has a value", () => {
+		expect(mapProductExtensions(shell({})).storageConditions).toBeNull();
+	});
+});
