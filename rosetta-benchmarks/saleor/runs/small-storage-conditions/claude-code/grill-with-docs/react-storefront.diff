+++ b/src/ui/components/pdp/storage-conditions.test.ts
@@ -0,0 +1,134 @@
+import { createElement, type ComponentType, type ReactNode } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { NextIntlClientProvider } from "next-intl";
+import { describe, expect, it, vi } from "vitest";
+
+import en from "../../../../messages/en.json";
+import pl from "../../../../messages/pl.json";
+import { PDP_TEMPLATES } from "@/templates/pdp/registry";
+import type { ProductView } from "@/lib/storefront/contract/product";
+import { ProductAttributes } from "./product-attributes";
+import { readStorageConditions, StorageConditions } from "./storage-conditions";
+
+vi.mock("next/dynamic", () => ({
+	default: () => () => null,
+}));
+
+type IntlProviderProps = { locale: string; messages: typeof en; children?: ReactNode };
+const IntlProvider = NextIntlClientProvider as ComponentType<IntlProviderProps>;
+
+function withIntl(child: ReactNode, locale: "en" | "pl" = "en") {
+	return createElement(IntlProvider, { locale, messages: locale === "en" ? en : pl }, child);
+}
+
+describe("readStorageConditions", () => {
+	it("returns the trimmed text", () => {
+		expect(readStorageConditions({ storageConditions: "  Keep dry  " })).toBe("Keep dry");
+	});
+
+	it.each([undefined, null, "", "   ", 42, {}, ["Keep dry"]])("ignores %j", (value) => {
+		expect(readStorageConditions({ storageConditions: value })).toBeNull();
+	});
+});
+
+describe("StorageConditions", () => {
+	const render = (value: string | null, locale: "en" | "pl" = "en") =>
+		renderToStaticMarkup(withIntl(createElement(StorageConditions, { value }), locale));
+
+	it("renders a labelled block with the value", () => {
+		const html = render("Keep refrigerated at 2–8 °C");
+
+		expect(html).toContain("Storage conditions");
+		expect(html).toContain("Keep refrigerated at 2–8 °C");
+		expect(html).toContain('data-testid="pdp-storage-conditions"');
+	});
+
+	it("uses the translated label for the locale", () => {
+		expect(render("Przechowywać w lodówce", "pl")).toContain("Warunki przechowywania");
+	});
+
+	it("renders nothing when the value is empty", () => {
+		expect(render(null)).toBe("");
+	});
+
+	it("never renders the value as HTML", () => {
+		const html = render("<img src=x onerror=alert(1)>");
+
+		expect(html).not.toContain("<img");
+		expect(html).toContain("&lt;img");
+	});
+});
+
+describe("PDP templates with storage conditions", () => {
+	const baseProduct: ProductView = {
+		id: "p1",
+		slug: "milk",
+		name: "Milk",
+		category: null,
+		descriptionHtml: ["<p>Fresh milk</p>"],
+		attributes: [],
+		careInstructions: null,
+		images: [],
+		priceRange: null,
+		isAvailable: true,
+		isBestseller: false,
+		variantCount: 1,
+		seoTitle: null,
+		seoDescription: null,
+		extensions: { storageConditions: "Keep refrigerated at 2–8 °C" },
+	};
+	const policyLabels = { freeShippingThreshold: "$75", returnsWindowDays: 30 };
+
+	function renderTemplate(
+		template: (typeof PDP_TEMPLATES)[keyof typeof PDP_TEMPLATES],
+		product: ProductView,
+	): string {
+		const slots = {
+			gallery: createElement("div"),
+			buyBox: createElement("div"),
+			breadcrumbs: createElement("div"),
+			attributes: createElement(ProductAttributes, {
+				descriptionHtml: product.descriptionHtml,
+				attributes: product.attributes,
+				policyLabels,
+			}),
+		};
+
+		return renderToStaticMarkup(withIntl(createElement(template.Layout, { product, slots })));
+	}
+
+	it.each(Object.entries(PDP_TEMPLATES))(
+		"shows the block once, after the description, in the %s template",
+		(_id, template) => {
+			const html = renderTemplate(template, baseProduct);
+
+			expect(html.match(/data-testid="pdp-storage-conditions"/g)).toHaveLength(1);
+			expect(html.indexOf("Fresh milk")).toBeGreaterThan(-1);
+			expect(html.indexOf("Fresh milk")).toBeLessThan(html.indexOf("Keep refrigerated at 2–8 °C"));
+			// Inside the Description section, before the next accordion item.
+			expect(html.indexOf("Keep refrigerated at 2–8 °C")).toBeLessThan(
+				html.indexOf("Shipping &amp; Returns"),
+			);
+		},
+	);
+
+	it.each(Object.entries(PDP_TEMPLATES))(
+		"shows no block in the %s template when the value is empty",
+		(_id, template) => {
+			const html = renderTemplate(template, { ...baseProduct, extensions: {} });
+
+			expect(html).not.toContain("pdp-storage-conditions");
+			expect(html).toContain("Fresh milk");
+		},
+	);
+
+	it.each(Object.entries(PDP_TEMPLATES))(
+		"still shows the block in the %s template when the product has no description",
+		(_id, template) => {
+			const html = renderTemplate(template, { ...baseProduct, descriptionHtml: null });
+
+			expect(html.match(/data-testid="pdp-storage-conditions"/g)).toHaveLength(1);
+			expect(html).toContain("Description");
+		},
+	);
+});
