@@ -0,0 +1,62 @@
+"use client";
+
+import { createContext, useContext, type ReactNode } from "react";
+import { useTranslations } from "next-intl";
+
+/** Plain text from `ProductView.extensions.storageConditions`. Anything else is ignored. */
+export function readStorageConditions(extensions: Record<string, unknown>): string | null {
+	const value = extensions.storageConditions;
+	if (typeof value !== "string") return null;
+	const trimmed = value.trim();
+	return trimmed.length > 0 ? trimmed : null;
+}
+
+const StorageConditionsContext = createContext<string | null>(null);
+
+/**
+ * Hands the product's storage conditions to `ProductAttributes`, which the route builds
+ * without them. A PDP template wraps its layout in this provider; a template that does not
+ * simply shows no storage conditions.
+ */
+export function StorageConditionsProvider({
+	extensions,
+	children,
+}: {
+	extensions: Record<string, unknown>;
+	children: ReactNode;
+}) {
+	return (
+		<StorageConditionsContext.Provider value={readStorageConditions(extensions)}>
+			{children}
+		</StorageConditionsContext.Provider>
+	);
+}
+
+export function useStorageConditions(): string | null {
+	return useContext(StorageConditionsContext);
+}
+
+/** Labelled "Storage conditions" block shown after the description. Renders nothing when empty. */
+export function StorageConditions({ value }: { value: string | null }) {
+	if (!value) return null;
+
+	return <StorageConditionsBlock value={value} />;
+}
+
+function StorageConditionsBlock({ value }: { value: string }) {
+	const t = useTranslations("pdp.attributes");
+
+	return (
+		<section
+			aria-labelledby="pdp-storage-conditions-label"
+			data-testid="pdp-storage-conditions"
+			className="mt-4"
+		>
+			<h3 id="pdp-storage-conditions-label" className="text-sm font-medium text-foreground">
+				{t("storageConditions")}
+			</h3>
+			{/* Rendered as a text node: the value is plain text, never HTML. */}
+			<p className="mt-1 text-sm leading-relaxed text-muted-foreground">{value}</p>
+		</section>
+	);
+}
