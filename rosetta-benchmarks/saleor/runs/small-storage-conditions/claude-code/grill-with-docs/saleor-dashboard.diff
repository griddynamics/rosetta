+import { ProductErrorCode } from "@dashboard/graphql";
+import { RichTextContext } from "@dashboard/utils/richText/context";
+import Wrapper from "@test/wrapper";
+import { render, screen } from "@testing-library/react";
+import userEvent from "@testing-library/user-event";
+
+import { ProductDetailsForm, STORAGE_CONDITIONS_MAX_LENGTH } from "./ProductDetailsForm";
+
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditorClamp", () => ({
+  RichTextEditorClamp: ({ children }: { children: React.ReactNode }) => <div>{children}</div>,
+}));
+
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditor", () => ({
+  __esModule: true,
+  default: () => <div data-test-id="rich-text-editor" />,
+}));
+
+const richTextContext = {
+  editorRef: { current: null },
+  defaultValue: undefined,
+  isReadyForMount: true,
+  handleChange: jest.fn(),
+} as unknown as React.ContextType<typeof RichTextContext>;
+
+const renderForm = (
+  props: Partial<React.ComponentProps<typeof ProductDetailsForm>> = {},
+): { onChange: jest.Mock } => {
+  const onChange = jest.fn();
+
+  render(
+    <Wrapper>
+      <RichTextContext.Provider value={richTextContext}>
+        <ProductDetailsForm
+          data={{
+            name: "Milk",
+            description: { blocks: [] },
+            rating: null,
+            storageConditions: "Keep refrigerated at 2–8 °C",
+          }}
+          errors={[]}
+          onChange={onChange}
+          {...props}
+        />
+      </RichTextContext.Provider>
+    </Wrapper>,
+  );
+
+  return { onChange };
+};
+
+describe("ProductDetailsForm storage conditions", () => {
+  it("shows the current value with a character counter", () => {
+    // Arrange / Act
+    renderForm();
+
+    // Assert
+    const input = screen.getByTestId("product-storage-conditions");
+
+    expect(input).toHaveValue("Keep refrigerated at 2–8 °C");
+    expect(screen.getByText(/27\/250/)).toBeInTheDocument();
+  });
+
+  it("limits the input to the API maximum length", () => {
+    // Arrange / Act
+    renderForm();
+
+    // Assert
+    expect(STORAGE_CONDITIONS_MAX_LENGTH).toBe(250);
+    expect(screen.getByTestId("product-storage-conditions")).toHaveAttribute("maxlength", "250");
+  });
+
+  it("reports changes through onChange", async () => {
+    // Arrange
+    const { onChange } = renderForm({
+      data: {
+        name: "Milk",
+        description: { blocks: [] } as never,
+        rating: null,
+        storageConditions: "",
+      },
+    });
+
+    // Act
+    await userEvent.type(screen.getByTestId("product-storage-conditions"), "a");
+
+    // Assert
+    expect(onChange).toHaveBeenCalled();
+    expect(onChange.mock.calls[0][0].target.name).toBe("storageConditions");
+  });
+
+  it("can be disabled", () => {
+    // Arrange / Act
+    renderForm({ disabled: true });
+
+    // Assert
+    expect(screen.getByTestId("product-storage-conditions")).toBeDisabled();
+  });
+
+  it("shows API errors for the field", () => {
+    // Arrange / Act
+    renderForm({
+      errors: [
+        {
+          __typename: "ProductError",
+          code: ProductErrorCode.REQUIRED,
+          field: "storageConditions",
+          message: "required",
+          attributes: null,
+        },
+      ],
+    });
+
+    // Assert
+    expect(screen.getByText(/this field is required/i)).toBeInTheDocument();
+  });
+});
