+def test_update_product_storage_conditions(
+    staff_api_client,
+    product,
+    permission_manage_products,
+):
+    product_id = graphene.Node.to_global_id("Product", product.pk)
+    storage_conditions = "Keep refrigerated at 2-8 C."
+
+    response = staff_api_client.post_graphql(
+        MUTATION_UPDATE_PRODUCT,
+        {
+            "productId": product_id,
+            "input": {"storageConditions": storage_conditions},
+        },
+        permissions=[permission_manage_products],
+    )
+
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    product.refresh_from_db()
+
+    assert data["errors"] == []
+    assert data["product"]["storageConditions"] == storage_conditions
+    assert product.storage_conditions == storage_conditions
+
+
+def test_update_product_clear_storage_conditions(
+    staff_api_client,
+    product,
+    permission_manage_products,
+):
+    product.storage_conditions = "Keep refrigerated at 2-8 C."
+    product.save(update_fields=["storage_conditions"])
+
+    response = staff_api_client.post_graphql(
+        MUTATION_UPDATE_PRODUCT,
+        {
+            "productId": graphene.Node.to_global_id("Product", product.pk),
+            "input": {"storageConditions": None},
+        },
+        permissions=[permission_manage_products],
+    )
+
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    product.refresh_from_db()
+
+    assert data["errors"] == []
+    assert data["product"]["storageConditions"] is None
+    assert product.storage_conditions is None
+
+
+def test_update_product_storage_conditions_exceed_max_length(
+    staff_api_client,
+    product,
+    permission_manage_products,
+):
+    response = staff_api_client.post_graphql(
+        MUTATION_UPDATE_PRODUCT,
+        {
+            "productId": graphene.Node.to_global_id("Product", product.pk),
+            "input": {"storageConditions": "a" * 251},
+        },
+        permissions=[permission_manage_products],
+    )
+
+    data = get_graphql_content(response)["data"]["productUpdate"]
+
+    assert data["product"] is None
+    assert len(data["errors"]) == 1
+
