+    assert results[0]["product"]["storageConditions"] == "ok"
+    assert results[1]["errors"][0]["path"] == "storageConditions"
+    assert results[1]["errors"][0]["code"] == "INVALID"
+
+
+def test_product_translate_storage_conditions(
+    staff_api_client, product, permission_manage_translations
+):
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "lang": LanguageCodeEnum.PL.name,
+        "input": {"storageConditions": "  Przechowywać w chłodzie "},
+    }
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
