@@ -0,0 +1,500 @@
+import json
+from unittest.mock import patch
+
+import graphene
+import pytest
+
+from .....csv.utils.products_data import get_products_data
+from .....graphql.csv.enums import ProductFieldEnum
+from .....product.models import Product
+from .....webhook.payloads import generate_product_payload
+from ....core.enums import LanguageCodeEnum
+from ....tests.utils import get_graphql_content
+
+PRODUCT_CREATE = """
+mutation ($input: ProductCreateInput!) {
+  productCreate(input: $input) {
+    product { id storageConditions }
+    errors { field code message }
+  }
+}
+"""
+
+PRODUCT_UPDATE = """
+mutation ($id: ID!, $input: ProductInput!) {
+  productUpdate(id: $id, input: $input) {
+    product { storageConditions }
+    errors { field code message }
+  }
+}
+"""
+
+PRODUCT_TRANSLATE = """
+mutation ($id: ID!, $lang: LanguageCodeEnum!, $input: TranslationInput!) {
+  productTranslate(id: $id, languageCode: $lang, input: $input) {
+    product { translation(languageCode: $lang) { storageConditions } }
+    errors { field code message }
+  }
+}
+"""
+
+CATEGORY_TRANSLATE = """
+mutation ($id: ID!, $lang: LanguageCodeEnum!, $input: TranslationInput!) {
+  categoryTranslate(id: $id, languageCode: $lang, input: $input) {
+    errors { field code message }
+  }
+}
+"""
+
+COLLECTION_TRANSLATE = CATEGORY_TRANSLATE.replace(
+    "categoryTranslate", "collectionTranslate"
+)
+
+BULK_TRANSLATE = """
+mutation ($translations: [ProductBulkTranslateInput!]!) {
+  productBulkTranslate(translations: $translations, errorPolicy: IGNORE_FAILED) {
+    count
+    results { errors { path code message } translation { storageConditions } }
+  }
+}
+"""
+
+BULK_CREATE = """
+mutation ($products: [ProductBulkCreateInput!]!) {
+  productBulkCreate(products: $products, errorPolicy: IGNORE_FAILED) {
+    count
+    results { errors { path code message } product { storageConditions } }
+  }
+}
+"""
+
+
+def test_product_update_trims_and_persists(
+    staff_api_client, product, permission_manage_products
+):
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"storageConditions": "  Keep in a cool place \n"},
+    }
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            PRODUCT_UPDATE, variables, permissions=[permission_manage_products]
+        )
+    )
+    data = content["data"]["productUpdate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == "Keep in a cool place"
+    product.refresh_from_db()
+    assert product.storage_conditions == "Keep in a cool place"
+
+
+@pytest.mark.parametrize("blank", ["", "   ", None])
+def test_product_update_blank_clears_to_null(
+    blank, staff_api_client, product, permission_manage_products
+):
+    product.storage_conditions = "x"
+    product.save(update_fields=["storage_conditions"])
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"storageConditions": blank},
+    }
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            PRODUCT_UPDATE, variables, permissions=[permission_manage_products]
+        )
+    )
+    assert not content["data"]["productUpdate"]["errors"]
+    product.refresh_from_db()
+    assert product.storage_conditions is None
+
+
+def test_product_update_omitted_keeps_value(
+    staff_api_client, product, permission_manage_products
+):
+    product.storage_conditions = "keep"
+    product.save(update_fields=["storage_conditions"])
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"name": "new name"},
+    }
+    get_graphql_content(
+        staff_api_client.post_graphql(
+            PRODUCT_UPDATE, variables, permissions=[permission_manage_products]
+        )
+    )
+    product.refresh_from_db()
+    assert product.storage_conditions == "keep"
+
+
+@pytest.mark.parametrize(
+    ("value", "valid"),
+    [
+        ("a" * 250, True),
+        ("a" * 251, False),
+        ("😀" * 250, True),
+        ("😀" * 251, False),
+        (" " + "a" * 250 + " ", True),
+        ("abc\x00", False),
+    ],
+)
+def test_product_update_length_and_nul(
+    value, valid, staff_api_client, product, permission_manage_products
+):
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"storageConditions": value},
+    }
+    content = get_graphql_content(
+        staff_api_client.post_graphql(
+            PRODUCT_UPDATE, variables, permissions=[permission_manage_products]
+        )
+    )
+    errors = content["data"]["productUpdate"]["errors"]
+    product.refresh_from_db()
+    if valid:
+        assert not errors
+        assert product.storage_conditions == value.strip()
+    else:
+        assert errors[0]["field"] == "storageConditions"
+        assert errors[0]["code"] == "INVALID"
+        assert product.storage_conditions is None
+
+
