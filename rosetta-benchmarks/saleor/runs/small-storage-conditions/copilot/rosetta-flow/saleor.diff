+PRODUCT_TRANSLATE_STORAGE_CONDITIONS_MUTATION = """
+    mutation ($id: ID!, $languageCode: LanguageCodeEnum!, $input: TranslationInput!) {
+       productTranslate(id: $id, languageCode: $languageCode, input: $input) {
+            product {
+                storageConditions
+                translation(languageCode: $languageCode) {
+                    storageConditions
+                }
+            }
+            errors {
+                message
+                code
+                field
+            }
+        }
+    }
+"""
+
+
+def _translate_storage_conditions(api_client, product, permission, value):
+    return api_client.post_graphql(
+        PRODUCT_TRANSLATE_STORAGE_CONDITIONS_MUTATION,
+        {
+            "id": graphene.Node.to_global_id("Product", product.id),
+            "languageCode": LanguageCodeEnum.PL.name,
+            "input": {"storageConditions": value},
+        },
+        permissions=[permission],
+        check_no_permissions=False,
+    )
+
+
+def test_product_translate_storage_conditions(
+    staff_api_client, product, permission_manage_translations
+):
+    # given
+    product.storage_conditions = "Keep refrigerated"
+    product.save(update_fields=["storage_conditions"])
+
+    # when
+    response = _translate_storage_conditions(
+        staff_api_client,
+        product,
+        permission_manage_translations,
+        "  Trzymać w lodówce ",
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productTranslate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == "Keep refrigerated"
+    assert data["product"]["translation"]["storageConditions"] == "Trzymać w lodówce"
+    assert product.translations.get().storage_conditions == "Trzymać w lodówce"
+
+
