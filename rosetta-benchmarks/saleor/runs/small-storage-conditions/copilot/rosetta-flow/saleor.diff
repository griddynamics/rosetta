--- /dev/null
+++ b/saleor/product/storage_conditions.py
@@ -0,0 +1,30 @@
+from django.core.exceptions import ValidationError
+
+# Limit is measured in Unicode code points (Python `len`) after trimming.
+STORAGE_CONDITIONS_MAX_LENGTH = 250
+
+
+def clean_storage_conditions(value: str | None) -> str | None:
+    """Normalize a product storage conditions value.
+
+    `None`, empty and whitespace-only values are normalized to `None`. Surrounding
+    whitespace is trimmed. Values containing NUL characters or longer than
+    `STORAGE_CONDITIONS_MAX_LENGTH` code points are rejected.
+    """
+    if value is None:
+        return None
+    if "\x00" in value:
+        raise ValidationError(
+            "Null characters are not allowed.",
+            code="invalid",
+        )
+    value = value.strip()
+    if not value:
+        return None
+    if len(value) > STORAGE_CONDITIONS_MAX_LENGTH:
+        raise ValidationError(
+            f"Storage conditions cannot be longer than "
+            f"{STORAGE_CONDITIONS_MAX_LENGTH} characters.",
+            code="invalid",
+        )
+    return value
diff --git a/saleor/product/tests/test_storage_conditions.py b/saleor/product/tests/test_storage_conditions.py
