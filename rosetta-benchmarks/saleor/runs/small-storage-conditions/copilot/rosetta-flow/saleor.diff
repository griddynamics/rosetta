+
+def test_product_bulk_create_validation(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    pt = graphene.Node.to_global_id("ProductType", product_type.pk)
+    cat = graphene.Node.to_global_id("Category", category.pk)
+    products = [
+        {
+            "productType": pt,
+            "category": cat,
+            "name": "bulk ok",
+            "storageConditions": " ok ",
+        },
+        {
+            "productType": pt,
+            "category": cat,
+            "name": "bulk bad",
+            "storageConditions": "😀" * 251,
+        },
+    ]
+    content = get_graphql_content(
