+    storage_conditions = graphene.String(
+        description=(
+            "Translated storage conditions. Products only. Plain text, up to 250 "
+            "characters. A blank value clears the translation." + ADDED_IN_323
+        )
+    )
+
+
+STORAGE_CONDITIONS_MAX_LENGTH = 250
+
+
+def clean_storage_conditions_translation(translation_fields: dict):
+    """Trim the value, store blank as null and reject values that are too long."""
+    if "storage_conditions" not in translation_fields:
+        return
+    value = (translation_fields["storage_conditions"] or "").strip()
+    if len(value) > STORAGE_CONDITIONS_MAX_LENGTH:
+        raise ValidationError(
+            {
+                "storage_conditions": ValidationError(
+                    "Storage conditions can't be longer than "
+                    f"{STORAGE_CONDITIONS_MAX_LENGTH} characters.",
+                    code=TranslationErrorCode.INVALID.value,
+                )
+            }
+        )
+    translation_fields["storage_conditions"] = value or None
+
+
+def reject_storage_conditions(input_data: dict):
+    """Storage conditions can be translated only for products.
+
+    An explicit null is dropped, as the translation model has no such field.
+    """
+    if input_data.get("storage_conditions") is None:
+        input_data.pop("storage_conditions", None)
+    else:
+        raise ValidationError(
+            {
+                "storage_conditions": ValidationError(
+                    "Storage conditions can be translated only for products.",
+                    code=TranslationErrorCode.INVALID.value,
+                )
+            }
+        )
 
 
