+++ b/saleor/product/tests/test_storage_conditions.py
@@ -0,0 +1,85 @@
+import pytest
+from django.core.exceptions import ValidationError
+
+from ..models import Product, ProductTranslation
+from ..storage_conditions import (
+    STORAGE_CONDITIONS_MAX_LENGTH,
+    clean_storage_conditions,
+)
+
+
+@pytest.mark.parametrize("value", [None, "", " ", "\t\n  ", "\u2003", "\u00a0"])
+def test_clean_storage_conditions_blank_becomes_none(value):
+    assert clean_storage_conditions(value) is None
+
+
+def test_clean_storage_conditions_trims():
+    assert clean_storage_conditions("  Keep cool \n") == "Keep cool"
+
+
+def test_clean_storage_conditions_keeps_inner_whitespace():
+    assert clean_storage_conditions("a  b\nc") == "a  b\nc"
+
+
+def test_clean_storage_conditions_limit_is_250():
+    assert STORAGE_CONDITIONS_MAX_LENGTH == 250
+
+
+@pytest.mark.parametrize("char", ["a", "ł", "😀", "你"])
+def test_clean_storage_conditions_boundary_code_points(char):
+    ok = char * 250
+    assert clean_storage_conditions(ok) == ok
+    with pytest.raises(ValidationError) as exc:
+        clean_storage_conditions(char * 251)
+    assert exc.value.code == "invalid"
+
+
+def test_clean_storage_conditions_counts_after_trim():
+    value = "a" * 250
+    assert clean_storage_conditions(f"   {value}   ") == value
+    with pytest.raises(ValidationError):
+        clean_storage_conditions(f"   {value}a   ")
+
+
+def test_clean_storage_conditions_astral_counts_as_one_code_point():
+    # 250 astral chars = 500 UTF-16 units but only 250 code points
+    value = "😀" * 250
+    assert len(value.encode("utf-16-le")) // 2 == 500
+    assert clean_storage_conditions(value) == value
+
+
+def test_clean_storage_conditions_rejects_nul():
+    with pytest.raises(ValidationError) as exc:
+        clean_storage_conditions("abc\x00def")
+    assert exc.value.code == "invalid"
+
+
+def test_clean_storage_conditions_rejects_nul_even_if_only_nul():
+    with pytest.raises(ValidationError):
+        clean_storage_conditions("\x00")
+
+
+def test_product_storage_conditions_defaults_to_null(product):
+    assert product.storage_conditions is None
+
+
+def test_product_storage_conditions_roundtrip_and_max_length(product):
+    value = "😀" * 250
+    product.storage_conditions = value
+    product.save(update_fields=["storage_conditions"])
+    assert Product.objects.get(pk=product.pk).storage_conditions == value
+    assert Product._meta.get_field("storage_conditions").max_length == 250
+    assert Product._meta.get_field("storage_conditions").null is True
+
+
+def test_product_translation_storage_conditions_field_and_keys(product):
+    field = ProductTranslation._meta.get_field("storage_conditions")
+    assert field.max_length == 250
+    assert field.null is True
+    translation = product.translations.create(
+        language_code="pl", storage_conditions="Chronić przed słońcem"
+    )
+    assert (
+        translation.get_translated_keys()["storage_conditions"]
+        == "Chronić przed słońcem"
+    )
