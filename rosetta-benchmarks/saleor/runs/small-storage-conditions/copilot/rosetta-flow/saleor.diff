+def test_product_translate_storage_conditions_max_length_boundary(
+    staff_api_client, product, permission_manage_translations
+):
+    # when
+    ok_response = _translate_storage_conditions(
+        staff_api_client, product, permission_manage_translations, "a" * 250
+    )
+    too_long_response = _translate_storage_conditions(
+        staff_api_client, product, permission_manage_translations, "b" * 251
+    )
+
+    # then
+    assert not get_graphql_content(ok_response)["data"]["productTranslate"]["errors"]
+    data = get_graphql_content(too_long_response)["data"]["productTranslate"]
+    assert data["product"] is None
+    assert len(data["errors"]) == 1
+    assert data["errors"][0]["field"] == "storageConditions"
+    assert data["errors"][0]["code"] == "INVALID"
+    assert product.translations.get().storage_conditions == "a" * 250
+
