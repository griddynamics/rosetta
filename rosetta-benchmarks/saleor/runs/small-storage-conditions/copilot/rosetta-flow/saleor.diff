+def test_product_bulk_create_with_storage_conditions(
+    staff_api_client, product_type, category, permission_manage_products
+):
+    # given
+    product_type_id = graphene.Node.to_global_id("ProductType", product_type.pk)
+    category_id = graphene.Node.to_global_id("Category", category.pk)
+    products = [
+        {
+            "productType": product_type_id,
+            "category": category_id,
+            "name": "Storage 1",
+            "storageConditions": "  Keep refrigerated  ",
+        },
+        {
+            "productType": product_type_id,
+            "category": category_id,
+            "name": "Storage 2",
+            "storageConditions": "   ",
+        },
+        {"productType": product_type_id, "category": category_id, "name": "Storage 3"},
+    ]
+
+    # when
+    staff_api_client.user.user_permissions.add(permission_manage_products)
+    response = staff_api_client.post_graphql(
+        PRODUCT_BULK_CREATE_MUTATION, {"products": products}
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["productBulkCreate"]
+    assert data["count"] == 3
+    assert [r["errors"] for r in data["results"]] == [[], [], []]
+    assert Product.objects.get(name="Storage 1").storage_conditions == (
+        "Keep refrigerated"
+    )
+    assert Product.objects.get(name="Storage 2").storage_conditions is None
+    assert Product.objects.get(name="Storage 3").storage_conditions is None
+
+
