+def test_product_translatable_content_storage_conditions_base_and_translation(
+    staff_api_client, product, permission_manage_translations
+):
+    # given
+    product.storage_conditions = "Keep refrigerated"
+    product.save(update_fields=["storage_conditions"])
+    product.translations.create(
+        language_code="pl", storage_conditions="Trzymać w lodówce"
+    )
+    query = """
+        query ($id: ID!) {
+            translation(id: $id, kind: PRODUCT) {
+                ... on ProductTranslatableContent {
+                    storageConditions
+                    translation(languageCode: PL) {
+                        storageConditions
+                    }
+                }
+            }
+        }
+    """
+    content_id = graphene.Node.to_global_id("Product", product.id)
+
+    # when
+    response = staff_api_client.post_graphql(
+        query, {"id": content_id}, permissions=[permission_manage_translations]
+    )
+
+    # then
+    data = get_graphql_content(response)["data"]["translation"]
+    assert data["storageConditions"] == "Keep refrigerated"
+    assert data["translation"]["storageConditions"] == "Trzymać w lodówce"
