diff --git a/src/config/storefront-view.test.ts b/src/config/storefront-view.test.ts
new file mode 100644
index 0000000..c9bb584
--- /dev/null
+++ b/src/config/storefront-view.test.ts
@@ -0,0 +1,49 @@
+import { describe, expect, it } from "vitest";
+
+import type { ProductShell } from "@/lib/catalog/get-product-data";
+import { mapProductExtensions } from "@/config/storefront-view";
+
+function shell(base: unknown, translated?: unknown): ProductShell {
+	return {
+		id: "p1",
+		storageConditions: base,
+		translation: translated === undefined ? null : { storageConditions: translated },
+	} as unknown as ProductShell;
+}
+
+describe("mapProductExtensions storageConditions", () => {
+	it("prefers the translation over the base value", () => {
+		expect(mapProductExtensions(shell("Keep cold", "Gardez au frais"))).toEqual({
+			storageConditions: "Gardez au frais",
+		});
+	});
+
+	it("falls back to base when translation is null, blank or absent", () => {
+		for (const translated of [null, "", "   ", undefined]) {
+			expect(mapProductExtensions(shell("Keep cold", translated))).toEqual({
+				storageConditions: "Keep cold",
+			});
+		}
+	});
+
+	it("trims the resolved value", () => {
+		expect(mapProductExtensions(shell("  Keep cold  "))).toEqual({ storageConditions: "Keep cold" });
+	});
+
+	it("returns {} when base is null and no translation", () => {
+		expect(mapProductExtensions(shell(null))).toEqual({});
+	});
+
+	it("returns {} when both are empty or whitespace", () => {
+		expect(mapProductExtensions(shell("", " "))).toEqual({});
+		expect(mapProductExtensions(shell("  ", ""))).toEqual({});
+	});
+
+	it("uses the translation when base is absent", () => {
+		expect(mapProductExtensions(shell(null, "Frio"))).toEqual({ storageConditions: "Frio" });
+	});
+
+	it("ignores non-string values", () => {
+		expect(mapProductExtensions(shell(42, { a: 1 }))).toEqual({});
+	});
+});
diff --git a/src/config/storefront-view.ts b/src/config/storefront-view.ts
