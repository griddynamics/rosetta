@@ -1,14 +1,36 @@
 import "server-only";
 
 import type { ProductShell } from "@/lib/catalog/get-product-data";
+import { pickTranslatedField } from "@/lib/saleor-translations";
+
+type StorageConditionsSource = {
+	storageConditions?: unknown;
+	translation?: { storageConditions?: unknown } | null;
+};
+
+function asString(value: unknown): string | null {
+	return typeof value === "string" ? value : null;
+}
+
+/** Translation wins when non-blank, else base value; trimmed; null when blank or absent. */
+function resolveStorageConditions(product: StorageConditionsSource): string | null {
+	const resolved = pickTranslatedField(
+		{ storageConditions: asString(product.translation?.storageConditions) },
+		"storageConditions",
+		asString(product.storageConditions),
+	);
+	const trimmed = resolved?.trim();
+	return trimmed ? trimmed : null;
+}
 
 /**
  * Fork-owned extras on `ProductView.extensions`.
  *
  * Add the selection in `src/graphql/extensions/ProductDetailsExtension.graphql`,
  * run `pnpm generate`, then map the new field here. Do not edit
- * `src/lib/storefront/mappers/product.ts` or the product route.
+ * `src/lib/storefront/mappers/product.ts`.
  */
-export function mapProductExtensions(_product: ProductShell): Record<string, unknown> {
-	return {};
+export function mapProductExtensions(product: ProductShell): Record<string, unknown> {
+	const storageConditions = resolveStorageConditions(product);
+	return storageConditions ? { storageConditions } : {};
 }
