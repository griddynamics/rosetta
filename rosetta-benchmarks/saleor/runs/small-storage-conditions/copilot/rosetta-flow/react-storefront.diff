diff --git a/src/lib/storage-conditions.test.ts b/src/lib/storage-conditions.test.ts
new file mode 100644
index 0000000..9f38d3d
--- /dev/null
+++ b/src/lib/storage-conditions.test.ts
@@ -0,0 +1,58 @@
+import { describe, expect, it } from "vitest";
+
+import type { ProductShell } from "@/lib/catalog/get-product-data";
+import { withTranslatedProductFields } from "@/lib/saleor-translations";
+import { toProductView } from "@/lib/storefront/mappers/product";
+
+describe("storageConditions translation fallback", () => {
+	const base = { name: "Tea", storageConditions: "Keep dry" };
+
+	it("uses the translation when non-blank", () => {
+		expect(
+			withTranslatedProductFields({
+				...base,
+				translation: { storageConditions: "Przechowywać w suchym miejscu" },
+			}).storageConditions,
+		).toBe("Przechowywać w suchym miejscu");
+	});
+
+	it.each([null, undefined, "", "   ", "\n"])("falls back to source for translation %p", (value) => {
+		expect(
+			withTranslatedProductFields({ ...base, translation: { storageConditions: value } }).storageConditions,
+		).toBe("Keep dry");
+	});
+
+	it("falls back to source when there is no translation object", () => {
+		expect(withTranslatedProductFields({ ...base, translation: null }).storageConditions).toBe("Keep dry");
+	});
+
+	it("stays null/undefined when neither source nor translation exist", () => {
+		expect(
+			withTranslatedProductFields({ name: "Tea", storageConditions: null }).storageConditions,
+		).toBeNull();
+		expect(
+			(withTranslatedProductFields({ name: "Tea" }) as { storageConditions?: string }).storageConditions,
+		).toBeUndefined();
+	});
+});
+
+describe("toProductView storageConditions", () => {
+	const view = (storageConditions: string | null | undefined) =>
+		toProductView({
+			id: "p1",
+			slug: "tea",
+			name: "Tea",
+			description: null,
+			assignedAttributes: [],
+			media: [],
+			storageConditions,
+		} as unknown as ProductShell);
+
+	it("trims the value", () => {
+		expect(view("  Keep dry \n").storageConditions).toBe("Keep dry");
+	});
+
+	it.each([null, undefined, "", "   "])("maps blank %p to null", (value) => {
+		expect(view(value).storageConditions).toBeNull();
+	});
+});
