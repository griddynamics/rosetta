diff --git a/src/ui/components/pdp/product-attributes-storage.test.ts b/src/ui/components/pdp/product-attributes-storage.test.ts
new file mode 100644
index 0000000..6d0f1a8
--- /dev/null
+++ b/src/ui/components/pdp/product-attributes-storage.test.ts
@@ -0,0 +1,38 @@
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it, vi } from "vitest";
+
+vi.mock("next-intl", () => ({
+	useTranslations: () => (key: string) => (key === "storageConditions" ? "Storage conditions" : key),
+}));
+
+import { ProductAttributes } from "./product-attributes";
+
+const policyLabels = { freeShippingThreshold: "", returnsWindowDays: 30 };
+
+const render = (storageConditions: string | null | undefined) =>
+	renderToStaticMarkup(createElement(ProductAttributes, { storageConditions, policyLabels }));
+
+describe("ProductAttributes storage conditions", () => {
+	it("renders heading and text, preserving line breaks via whitespace-pre-line", () => {
+		const html = render("Keep cool\nAvoid sunlight");
+
+		expect(html).toContain("Storage conditions");
+		expect(html).toContain("whitespace-pre-line");
+		expect(html).toContain("Keep cool\nAvoid sunlight");
+	});
+
+	it("escapes HTML (rendered as text, not markup)", () => {
+		const html = render("<script>alert(1)</script>");
+
+		expect(html).not.toContain("<script>");
+		expect(html).toContain("&lt;script&gt;");
+	});
+
+	it.each([null, undefined, "", "  \n "])("renders nothing for blank %p", (value) => {
+		const html = render(value);
+
+		expect(html).not.toContain("Storage conditions");
+		expect(html).not.toContain("storage-conditions");
+	});
+});
