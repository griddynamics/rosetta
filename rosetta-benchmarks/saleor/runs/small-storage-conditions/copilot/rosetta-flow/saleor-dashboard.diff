index 0000000..b8d7cdd
--- /dev/null
+++ b/src/translations/storageConditions.test.ts
@@ -0,0 +1,157 @@
+import { LanguageCodeEnum } from "@dashboard/graphql";
+import { type IntlShape } from "react-intl";
+
+import { hasOverLimitBulkFields, isBulkFieldOverLimit } from "./bulkFieldDirty";
+import { createStorageConditionsField } from "./translationSectionBuilders";
+import { TranslationFieldType, TranslationInputFieldName } from "./types";
+import { getParsedTranslationInputData } from "./utils";
+import { getProductTranslationCompletion } from "./views/EntityLists/utils";
+
+const intl = {
+  formatMessage: ({ defaultMessage }: { defaultMessage?: string }) => defaultMessage ?? "",
+} as IntlShape;
+
+const translation = (storageConditions: string | null) => ({
+  __typename: "ProductTranslation" as const,
+  id: "t-1",
+  name: null,
+  description: null,
+  seoDescription: null,
+  seoTitle: null,
+  slug: null,
+  storageConditions,
+  language: {
+    __typename: "LanguageDisplay" as const,
+    code: LanguageCodeEnum.PL,
+    language: "Polish",
+  },
+});
+
+describe("createStorageConditionsField", () => {
+  it("returns null when source and translation are blank", () => {
+    expect(
+      createStorageConditionsField(intl, {
+        storageConditions: "  ",
+        translationStorageConditions: null,
+      }),
+    ).toBeNull();
+  });
+
+  it("is a long field with 250 limit that counts toward progress when source exists", () => {
+    const field = createStorageConditionsField(intl, {
+      storageConditions: "Keep cool",
+      translationStorageConditions: null,
+    });
+
+    expect(field).toMatchObject({
+      name: TranslationInputFieldName.storageConditions,
+      type: TranslationFieldType.LONG,
+      maxLength: 250,
+      excludeFromProgress: false,
+      value: "Keep cool",
+    });
+  });
+
+  it("keeps orphan translation editable but excluded from progress", () => {
+    const field = createStorageConditionsField(intl, {
+      storageConditions: null,
+      translationStorageConditions: "Chłodno",
+    });
+
+    expect(field).toMatchObject({ excludeFromProgress: true, translation: "Chłodno", value: "" });
+  });
+});
+
+describe("storage conditions translation input", () => {
+  it("sends null for blank translation", () => {
+    expect(
+      getParsedTranslationInputData({
+        fieldName: TranslationInputFieldName.storageConditions,
+        data: "   ",
+      }),
+    ).toEqual({ storageConditions: null });
+  });
+
+  it("sends the value untouched otherwise", () => {
+    expect(
+      getParsedTranslationInputData({
+        fieldName: TranslationInputFieldName.storageConditions,
+        data: " Chłodno ",
+      }),
+    ).toEqual({ storageConditions: " Chłodno " });
+  });
+});
+
+describe("bulk over-limit (trimmed code points)", () => {
+  const field = createStorageConditionsField(intl, {
+    storageConditions: "x",
+    translationStorageConditions: null,
+  })!;
+
+  it.each([
+    ["a".repeat(250), false],
+    ["a".repeat(251), true],
+    ["😀".repeat(250), false],
+    ["😀".repeat(251), true],
+    [`  ${"a".repeat(250)}  `, false],
+  ])("%#", (value, expected) => {
+    expect(isBulkFieldOverLimit(field, value)).toBe(expected);
+    expect(hasOverLimitBulkFields([{ fields: [field] } as never], { [field.name]: value })).toBe(
+      expected,
+    );
+  });
+
+  it("is false when untouched", () => {
+    expect(isBulkFieldOverLimit(field, undefined)).toBe(false);
+  });
+});
+
+describe("product translation progress with storage conditions", () => {
+  const base = { attributeValues: [] };
+
+  it("does not count when product source is blank/absent", () => {
+    const without = getProductTranslationCompletion({ ...base, translation: translation("x") });
+    const blank = getProductTranslationCompletion({
+      ...base,
+      translation: translation("x"),
+      product: { storageConditions: "  " } as never,
+    });
+
+    expect(blank).toEqual(without);
+  });
+
+  it("adds to max when source exists, and to current when translated", () => {
+    const product = { storageConditions: "Keep cool" } as never;
+    const missing = getProductTranslationCompletion({
+      ...base,
+      translation: translation(null),
+      product,
+    });
+    const done = getProductTranslationCompletion({
+      ...base,
+      translation: translation("Chłodno"),
+      product,
+    });
+    const absent = getProductTranslationCompletion({ ...base, translation: translation(null) });
+
+    expect(missing.max).toBe(absent.max + 1);
+    expect(missing.current).toBe(absent.current);
+    expect(done).toEqual({ current: missing.current + 1, max: missing.max });
+  });
+
+  it("whitespace-only translation does not count as complete", () => {
+    const product = { storageConditions: "Keep cool" } as never;
+    const blank = getProductTranslationCompletion({
+      ...base,
+      translation: translation("   "),
+      product,
+    });
+    const missing = getProductTranslationCompletion({
+      ...base,
+      translation: translation(null),
+      product,
+    });
+
+    expect(blank).toEqual(missing);
+  });
+});
