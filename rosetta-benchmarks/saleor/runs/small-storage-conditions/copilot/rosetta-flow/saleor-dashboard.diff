new file mode 100644
index 0000000..d6d087b
--- /dev/null
+++ b/src/products/utils/storageConditions.ts
@@ -0,0 +1,11 @@
+export const STORAGE_CONDITIONS_MAX_LENGTH = 250;
+
+/**
+ * Mirrors the server's `len(value.strip())`: code points of the trimmed value.
+ * Do not use `.length` (UTF-16 units) or the untrimmed value.
+ */
+export const countStorageConditions = (value: string | null | undefined): number =>
+  Array.from((value ?? "").trim()).length;
+
+export const isStorageConditionsTooLong = (value: string | null | undefined): boolean =>
+  countStorageConditions(value) > STORAGE_CONDITIONS_MAX_LENGTH;
