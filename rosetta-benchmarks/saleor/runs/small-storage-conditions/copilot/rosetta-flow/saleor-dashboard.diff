@@ -0,0 +1,36 @@
+import {
+  countStorageConditions,
+  isStorageConditionsTooLong,
+  STORAGE_CONDITIONS_MAX_LENGTH,
+} from "./storageConditions";
+
+describe("storageConditions", () => {
+  it("limit is 250", () => {
+    expect(STORAGE_CONDITIONS_MAX_LENGTH).toBe(250);
+  });
+
+  it.each([null, undefined, "", "   ", "\n\t"])("counts blank %p as 0", value => {
+    expect(countStorageConditions(value)).toBe(0);
+    expect(isStorageConditionsTooLong(value)).toBe(false);
+  });
+
+  it("counts the trimmed value", () => {
+    expect(countStorageConditions("  abc \n")).toBe(3);
+    expect(isStorageConditionsTooLong(`  ${"a".repeat(250)}  `)).toBe(false);
+    expect(isStorageConditionsTooLong(`  ${"a".repeat(251)}  `)).toBe(true);
+  });
+
+  it("counts astral characters as one code point (not UTF-16 units)", () => {
+    const value = "😀".repeat(250);
+
+    expect(value.length).toBe(500);
+    expect(countStorageConditions(value)).toBe(250);
