@@ -0,0 +1,111 @@
+import { ProductErrorCode, type ProductErrorFragment } from "@dashboard/graphql";
+import { ThemeProvider } from "@saleor/macaw-ui-next";
+import { fireEvent, render, screen } from "@testing-library/react";
+
+import { ProductDetailsForm } from "./ProductDetailsForm";
+
+jest.mock("@dashboard/utils/richText/context", () => ({
+  useRichTextContext: (): Record<string, unknown> => ({
+    editorRef: { current: null },
+    defaultValue: undefined,
+    isReadyForMount: false,
+    handleChange: jest.fn(),
+  }),
+}));
+
+jest.mock("@dashboard/components/RichTextEditor/RichTextEditorLoading", () => ({
+  RichTextEditorLoading: (): JSX.Element => <div data-test-id="rich-text-loading" />,
+}));
+
+const baseData = {
+  description: { blocks: [] } as any,
+  name: "Test product",
+  rating: null,
+  storageConditions: "Keep refrigerated at 2-8 C",
+};
+
+const renderForm = (
+  props: Partial<React.ComponentProps<typeof ProductDetailsForm>> = {},
+  onChange = jest.fn(),
+): { onChange: jest.Mock; field: HTMLElement } => {
+  render(
+    <ThemeProvider>
+      <ProductDetailsForm data={baseData} errors={[]} onChange={onChange} {...props} />
+    </ThemeProvider>,
+  );
+
+  return { onChange, field: screen.getByTestId("product-storage-conditions") };
+};
+
+describe("ProductDetailsForm storage conditions", () => {
+  it("renders the existing value with the 250 character limit", () => {
+    // Arrange & Act
+    const { field } = renderForm();
+
+    // Assert
+    expect(field).toHaveValue("Keep refrigerated at 2-8 C");
+    expect(field).toHaveAttribute("name", "storageConditions");
+    expect(field).toHaveAttribute("maxlength", "250");
+  });
+
+  it("renders an empty field when the value is empty", () => {
+    // Arrange & Act
+    const { field } = renderForm({ data: { ...baseData, storageConditions: "" } });
+
+    // Assert
+    expect(field).toHaveValue("");
+  });
+
+  it("forwards the typed value to onChange with the field name", () => {
+    // Arrange
+    // The input is controlled, so read the target while the handler runs.
+    const received: Array<{ name: string; value: string }> = [];
+    const onChange = jest.fn(event =>
+      received.push({ name: event.target.name, value: event.target.value }),
+    );
+    const { field } = renderForm({}, onChange);
+
+    // Act
+    fireEvent.change(field, { target: { value: "Store dry" } });
+
+    // Assert
+    expect(onChange).toHaveBeenCalledTimes(1);
+    expect(received).toEqual([{ name: "storageConditions", value: "Store dry" }]);
+  });
+
+  it("shows the API error as helper text", () => {
+    // Arrange
+    const errors = [
+      {
+        __typename: "ProductError",
+        code: ProductErrorCode.INVALID,
+        field: "storageConditions",
+        message: null,
+      },
+    ] as ProductErrorFragment[];
+
+    // Act
+    renderForm({ errors });
+
+    // Assert
+    expect(screen.getByText("Invalid value")).toBeInTheDocument();
+  });
+
+  it("shows no helper text when the error targets another field", () => {
+    // Arrange
+    const errors = [
+      {
+        __typename: "ProductError",
+        code: ProductErrorCode.INVALID,
+        field: "name",
+        message: null,
+      },
+    ] as ProductErrorFragment[];
+
+    // Act
+    renderForm({ errors });
+
+    // Assert: the single "Invalid value" belongs to the name field only
+    expect(screen.getAllByText("Invalid value")).toHaveLength(1);
+  });
+});
