+import { createGeneralNameDescriptionSection } from "@dashboard/translations/translationSectionBuilders";
+import { TranslationFieldType, TranslationInputFieldName } from "@dashboard/translations/types";
+import { createIntl } from "react-intl";
+
+const intl = createIntl({ locale: "en" });
+
+describe("createGeneralNameDescriptionSection", () => {
+  it("adds a storage conditions field for products when a label is provided", () => {
+    // Arrange & Act
+    const section = createGeneralNameDescriptionSection(
+      intl,
+      {
+        name: "Milk",
+        storageConditions: "Keep refrigerated",
+        translationStorageConditions: "Przechowywać w lodówce",
+      },
+      { storageConditionsLabel: "Storage conditions" },
+    );
+
+    // Assert
+    expect(section.fields.map(field => field.name)).toEqual([
+      TranslationInputFieldName.name,
+      TranslationInputFieldName.description,
+      TranslationInputFieldName.storageConditions,
+    ]);
+    expect(section.fields[2]).toMatchObject({
+      displayName: "Storage conditions",
+      type: TranslationFieldType.LONG,
+      value: "Keep refrigerated",
+      translation: "Przechowywać w lodówce",
+    });
+  });
+
+  it("does not add the field for other entities (category, collection) by default", () => {
+    // Arrange & Act
+    const section = createGeneralNameDescriptionSection(intl, { name: "Dairy" });
+
+    // Assert
+    expect(section.fields.map(field => field.name)).toEqual([
+      TranslationInputFieldName.name,
+      TranslationInputFieldName.description,
+    ]);
+  });
+});
