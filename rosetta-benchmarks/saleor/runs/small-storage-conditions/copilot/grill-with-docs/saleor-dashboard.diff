+import { normalizeStorageConditions, STORAGE_CONDITIONS_MAX_LENGTH } from "./storageConditions";
+
+describe("normalizeStorageConditions", () => {
+  it("replaces line breaks with spaces and trims the result", () => {
+    expect(normalizeStorageConditions(" \nKeep refrigerated\r\nbelow 5°C \n")).toBe(
+      "Keep refrigerated below 5°C",
+    );
+  });
+
+  it("returns an empty string for blank input", () => {
+    expect(normalizeStorageConditions(" \r\n ")).toBe("");
+  });
+
+  it("exports the API maximum length", () => {
+    expect(STORAGE_CONDITIONS_MAX_LENGTH).toBe(250);
+  });
+});
