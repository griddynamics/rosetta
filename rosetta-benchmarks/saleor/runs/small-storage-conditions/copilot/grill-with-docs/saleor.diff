+    ],
+)
+def test_create_product_storage_conditions(
+    staff_api_client,
+    product_type,
+    permission_manage_products,
+    storage_conditions,
+    expected_value,
+    error,
+):
+    variables = {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "name": "Product with storage conditions",
+            "storageConditions": storage_conditions,
+        }
+    }
+
+    response = staff_api_client.post_graphql(
+        CREATE_PRODUCT_MUTATION, variables, permissions=[permission_manage_products]
+    )
+    data = get_graphql_content(response)["data"]["productCreate"]
+
+    if error:
+        assert data["errors"][0]["field"] == "storageConditions"
+        assert data["errors"][0]["code"] == ProductErrorCode.INVALID.name
+        return
+
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == expected_value
+    product = Product.objects.get(pk=graphene.Node.from_global_id(data["product"]["id"])[1])
+    assert product.storage_conditions == expected_value
+
