new file mode 100644
index 0000000..8f06c72
--- /dev/null
+++ b/src/products/storageConditions.test.ts
@@ -0,0 +1,22 @@
+import {
+  isStorageConditionsValid,
+  normalizeStorageConditions,
+  STORAGE_CONDITIONS_MAX_LENGTH,
+} from "./storageConditions";
+
+describe("storage conditions", () => {
+  it("normalizes whitespace and accepts exactly 250 characters", () => {
+    const value = `\n ${"a".repeat(STORAGE_CONDITIONS_MAX_LENGTH)} \r\n`;
+
+    expect(normalizeStorageConditions(value)).toHaveLength(STORAGE_CONDITIONS_MAX_LENGTH);
+    expect(isStorageConditionsValid(value)).toBe(true);
+  });
+
+  it("rejects normalized values longer than 250 characters", () => {
+    expect(isStorageConditionsValid("a".repeat(STORAGE_CONDITIONS_MAX_LENGTH + 1))).toBe(false);
+  });
+
+  it("maps whitespace-only values to null", () => {
+    expect(normalizeStorageConditions(" \n\t ")).toBeNull();
+  });
+});
diff --git a/src/products/storageConditions.ts b/src/products/storageConditions.ts
new file mode 100644
index 0000000..479f369
--- /dev/null
+++ b/src/products/storageConditions.ts
@@ -0,0 +1,10 @@
+export const STORAGE_CONDITIONS_MAX_LENGTH = 250;
+
+export const normalizeStorageConditions = (value: string): string | null => {
+  const normalized = value.replace(/\s+/g, " ").trim();
+
+  return normalized || null;
+};
+
+export const isStorageConditionsValid = (value: string): boolean =>
+  (normalizeStorageConditions(value)?.length ?? 0) <= STORAGE_CONDITIONS_MAX_LENGTH;
