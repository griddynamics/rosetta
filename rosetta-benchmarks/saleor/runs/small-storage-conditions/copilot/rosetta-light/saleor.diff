--- /dev/null
+++ b/saleor/graphql/translations/tests/mutations/test_product_translate_storage_conditions.py
@@ -0,0 +1,102 @@
+import graphene
+
+from .....product.models import ProductTranslation
+from ....core.enums import LanguageCodeEnum
+from ....tests.utils import get_graphql_content
+
+PRODUCT_TRANSLATE_MUTATION = """
+mutation TranslateProduct(
+  $id: ID!,
+  $languageCode: LanguageCodeEnum!,
+  $input: TranslationInput!
+) {
+  productTranslate(
+    id: $id,
+    languageCode: $languageCode,
+    input: $input
+  ) {
+    product {
+      storageConditions
+      translation(languageCode: $languageCode) {
+        storageConditions
+      }
+    }
+    errors {
+      field
+      code
+      message
+    }
+  }
+}
+"""
+
+
+def test_product_translate_storage_conditions_and_clear(
+    staff_api_client, product, permission_manage_translations
+):
+    default_value = "Keep refrigerated at 2–8 °C"
+    translated_value = "Przechowywać w temperaturze 2–8 °C"
+    product.storage_conditions = default_value
+    product.save(update_fields=["storage_conditions"])
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "languageCode": LanguageCodeEnum.PL.name,
+        "input": {"storageConditions": translated_value},
+    }
+
+    response = staff_api_client.post_graphql(
+        PRODUCT_TRANSLATE_MUTATION,
+        variables,
+        permissions=[permission_manage_translations],
+    )
+    data = get_graphql_content(response)["data"]["productTranslate"]
+    assert data["errors"] == []
+    assert data["product"]["storageConditions"] == default_value
+    assert data["product"]["translation"]["storageConditions"] == translated_value
+    translation = ProductTranslation.objects.get(
+        product=product, language_code=LanguageCodeEnum.PL.value
+    )
+    assert translation.storage_conditions == translated_value
+
+    variables["input"]["storageConditions"] = ""
+    response = staff_api_client.post_graphql(
+        PRODUCT_TRANSLATE_MUTATION,
+        variables,
+        permissions=[permission_manage_translations],
+        check_no_permissions=False,
+    )
+    data = get_graphql_content(response)["data"]["productTranslate"]
+    assert data["errors"] == []
+    assert data["product"]["storageConditions"] == default_value
+    assert data["product"]["translation"]["storageConditions"] == ""
+    translation.refresh_from_db()
+    assert translation.storage_conditions == ""
+
+
+def test_product_translate_rejects_storage_conditions_over_max_length(
+    staff_api_client, product, permission_manage_translations
+):
+    value = "x" * 256
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.pk),
+        "languageCode": LanguageCodeEnum.PL.name,
+        "input": {"storageConditions": value},
+    }
+
+    response = staff_api_client.post_graphql(
+        PRODUCT_TRANSLATE_MUTATION,
+        variables,
+        permissions=[permission_manage_translations],
+    )
+
+    data = get_graphql_content(response)["data"]["productTranslate"]
+    assert data["errors"] == [
+        {
+            "field": "storageConditions",
+            "code": "INVALID",
+            "message": ("Ensure this value has at most 255 characters (it has 256)."),
+        }
+    ]
+    assert not product.translations.filter(
+        language_code=LanguageCodeEnum.PL.value
+    ).exists()
