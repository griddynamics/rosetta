--- /dev/null
+++ b/saleor/graphql/product/tests/mutations/test_product_storage_conditions.py
@@ -0,0 +1,171 @@
+import graphene
+
+from .....graphql.tests.utils import get_graphql_content
+from .....product.error_codes import ProductErrorCode
+from .....product.models import Product
+
+CREATE_PRODUCT_MUTATION = """
+mutation CreateProduct($input: ProductCreateInput!) {
+  productCreate(input: $input) {
+    product {
+      id
+      storageConditions
+    }
+    errors {
+      field
+      code
+      message
+    }
+  }
+}
+"""
+
+UPDATE_PRODUCT_MUTATION = """
+mutation UpdateProduct($id: ID!, $input: ProductInput!) {
+  productUpdate(id: $id, input: $input) {
+    product {
+      storageConditions
+    }
+    errors {
+      field
+      code
+      message
+    }
+  }
+}
+"""
+
+
+def test_create_product_storage_conditions_defaults_to_empty(
+    staff_api_client, product_type, permission_manage_products
+):
+    variables = {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "name": "Product with default storage conditions",
+            "slug": "product-with-default-storage-conditions",
+        }
+    }
+
+    response = staff_api_client.post_graphql(
+        CREATE_PRODUCT_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert data["errors"] == []
+    assert data["product"]["storageConditions"] == ""
+    product = Product.objects.get(slug="product-with-default-storage-conditions")
+    assert product.storage_conditions == ""
+
+
+def test_create_product_storage_conditions_at_max_length(
+    staff_api_client, product_type, permission_manage_products
+):
+    value = "x" * 255
+    variables = {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "name": "Product with storage conditions",
+            "slug": "product-with-storage-conditions",
+            "storageConditions": value,
+        }
+    }
+
+    response = staff_api_client.post_graphql(
+        CREATE_PRODUCT_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert data["errors"] == []
+    assert data["product"]["storageConditions"] == value
+    product = Product.objects.get(slug="product-with-storage-conditions")
+    assert product.storage_conditions == value
+
+
+def test_update_product_storage_conditions_and_clear(
+    staff_api_client, product, permission_manage_products
+):
+    product_id = graphene.Node.to_global_id("Product", product.pk)
+    value = "Keep refrigerated at 2–8 °C"
+
+    response = staff_api_client.post_graphql(
+        UPDATE_PRODUCT_MUTATION,
+        {"id": product_id, "input": {"storageConditions": value}},
+        permissions=[permission_manage_products],
+    )
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert data["errors"] == []
+    assert data["product"]["storageConditions"] == value
+    product.refresh_from_db()
+    assert product.storage_conditions == value
+
+    response = staff_api_client.post_graphql(
+        UPDATE_PRODUCT_MUTATION,
+        {"id": product_id, "input": {"storageConditions": ""}},
+        permissions=[permission_manage_products],
+        check_no_permissions=False,
+    )
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert data["errors"] == []
+    assert data["product"]["storageConditions"] == ""
+    product.refresh_from_db()
+    assert product.storage_conditions == ""
+
+
+def test_create_product_rejects_storage_conditions_over_max_length(
+    staff_api_client, product_type, permission_manage_products
+):
+    value = "x" * 256
+    variables = {
+        "input": {
+            "productType": graphene.Node.to_global_id("ProductType", product_type.pk),
+            "name": "Product with long storage conditions",
+            "slug": "product-with-long-storage-conditions",
+            "storageConditions": value,
+        }
+    }
+
+    response = staff_api_client.post_graphql(
+        CREATE_PRODUCT_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    data = get_graphql_content(response)["data"]["productCreate"]
+    assert data["product"] is None
+    assert data["errors"] == [
+        {
+            "field": "storageConditions",
+            "code": ProductErrorCode.INVALID.name,
+            "message": ("Ensure this value has at most 255 characters (it has 256)."),
+        }
+    ]
+
+
+def test_update_product_rejects_storage_conditions_over_max_length(
+    staff_api_client, product, permission_manage_products
+):
+    product_id = graphene.Node.to_global_id("Product", product.pk)
+    value = "x" * 256
+
+    response = staff_api_client.post_graphql(
+        UPDATE_PRODUCT_MUTATION,
+        {"id": product_id, "input": {"storageConditions": value}},
+        permissions=[permission_manage_products],
+    )
+
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert data["product"] is None
+    assert data["errors"] == [
+        {
+            "field": "storageConditions",
+            "code": ProductErrorCode.INVALID.name,
+            "message": ("Ensure this value has at most 255 characters (it has 256)."),
+        }
+    ]
+    product.refresh_from_db()
+    assert product.storage_conditions == ""
