+def test_product_subscription_storage_conditions_are_query_defined(
+    product, subscription_product_created_webhook, subscription_webhook
+):
+    # given
+    product.storage_conditions = "Keep refrigerated"
+    product.save(update_fields=["storage_conditions"])
+    selected_webhook = subscription_webhook(
+        """
+        subscription {
+          event {
+            ... on ProductCreated {
+              product {
+                id
+                storageConditions
+              }
+            }
+          }
+        }
+        """,
+        WebhookEventAsyncType.PRODUCT_CREATED,
+    )
+
+    # when
+    deliveries = create_deliveries_for_subscriptions(
+        WebhookEventAsyncType.PRODUCT_CREATED,
+        product,
+        [subscription_product_created_webhook, selected_webhook],
+    )
+
+    # then
+    omitted_payload, selected_payload = (
+        json.loads(delivery.payload.get_payload()) for delivery in deliveries
+    )
+    assert omitted_payload["product"] == {
+        "id": graphene.Node.to_global_id("Product", product.id)
+    }
+    assert selected_payload["product"] == {
+        "id": graphene.Node.to_global_id("Product", product.id),
+        "storageConditions": product.storage_conditions,
+    }
