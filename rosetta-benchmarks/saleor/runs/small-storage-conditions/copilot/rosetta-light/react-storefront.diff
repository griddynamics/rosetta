diff --git a/src/ui/components/pdp/product-attributes.test.ts b/src/ui/components/pdp/product-attributes.test.ts
new file mode 100644
index 0000000..b590c08
--- /dev/null
+++ b/src/ui/components/pdp/product-attributes.test.ts
@@ -0,0 +1,50 @@
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it, vi } from "vitest";
+
+import type { PolicyLabelValues } from "@/lib/content/policy-format";
+import { ProductAttributes } from "./product-attributes";
+
+vi.mock("next-intl", () => ({
+	useTranslations: () => (key: string) => `label:${key}`,
+}));
+
+const policyLabels: PolicyLabelValues = {
+	freeShippingThreshold: "$50",
+	returnsWindowDays: 30,
+};
+
+describe("ProductAttributes storage conditions", () => {
+	it("hides the block when the resolved value is empty", () => {
+		const markup = renderToStaticMarkup(
+			createElement(ProductAttributes, {
+				descriptionHtml: ["<p>Product description</p>"],
+				storageConditions: " \t ",
+				policyLabels,
+			}),
+		);
+
+		expect(markup).not.toContain("label:storageConditions");
+	}, 1000);
+
+	it("renders a labeled plain-text block after description and before product details", () => {
+		const markup = renderToStaticMarkup(
+			createElement(ProductAttributes, {
+				descriptionHtml: ["<p>Product description</p>"],
+				storageConditions: "<em>Store below 25°C</em>",
+				attributes: [{ name: "Material", value: "Cotton" }],
+				policyLabels,
+			}),
+		);
+
+		expect(markup).toContain("label:storageConditions");
+		expect(markup).toContain("&lt;em&gt;Store below 25°C&lt;/em&gt;");
+		expect(markup).not.toContain("<em>Store below 25°C</em>");
+		expect(markup.indexOf('data-value="description"')).toBeLessThan(
+			markup.indexOf('data-value="storageConditions"'),
+		);
+		expect(markup.indexOf('data-value="storageConditions"')).toBeLessThan(
+			markup.indexOf('data-value="details"'),
+		);
+	}, 1000);
+});
