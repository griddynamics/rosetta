diff --git a/src/ui/components/pdp/product-attributes.test.ts b/src/ui/components/pdp/product-attributes.test.ts
new file mode 100644
index 0000000..6fb8a07
--- /dev/null
+++ b/src/ui/components/pdp/product-attributes.test.ts
@@ -0,0 +1,58 @@
+import { createElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { NextIntlClientProvider } from "next-intl";
+import { describe, expect, it } from "vitest";
+
+import { ProductAttributes } from "@/ui/components/pdp/product-attributes";
+
+const messages = {
+	pdp: {
+		attributes: {
+			description: "Description",
+			storageConditions: "Storage conditions",
+			productDetails: "Product Details",
+			careInstructions: "Care Instructions",
+			shippingReturns: "Shipping & Returns",
+			shippingBody: "Free shipping over {freeShippingThreshold}.",
+			returnsBody: "Free returns within {returnsWindowDays} days.",
+			yes: "Yes",
+			no: "No",
+		},
+	},
+};
+
+function renderProductAttributes(storageConditions: string | null) {
+	return renderToStaticMarkup(
+		// eslint-disable-next-line react/no-children-prop -- NextIntlClientProvider requires children in typed props.
+		createElement(
+			NextIntlClientProvider,
+			{
+				locale: "en",
+				messages,
+				timeZone: "UTC",
+				children: createElement(ProductAttributes, {
+					descriptionHtml: ["<p>Product description</p>"],
+					storageConditions,
+					attributes: [{ name: "Material", value: "Cotton" }],
+					careInstructions: null,
+					policyLabels: { freeShippingThreshold: "$50", returnsWindowDays: 30 },
+				}),
+			},
+		),
+	);
+}
+
+describe("ProductAttributes storage conditions", () => {
+	it("renders plain text immediately after the Description block", () => {
+		const html = renderProductAttributes("Store below <strong>25°C</strong>.");
+
+		expect(html).toContain("Storage conditions");
+		expect(html).toContain("Store below &lt;strong&gt;25°C&lt;/strong&gt;.");
+		expect(html.indexOf("Description")).toBeLessThan(html.indexOf("Storage conditions"));
+		expect(html.indexOf("Storage conditions")).toBeLessThan(html.indexOf("Product Details"));
+	});
+
+	it("hides the block when no resolved storage conditions are provided", () => {
+		expect(renderProductAttributes(null)).not.toContain("Storage conditions");
+	});
+});
