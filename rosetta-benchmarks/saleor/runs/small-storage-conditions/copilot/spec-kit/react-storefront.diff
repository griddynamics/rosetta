diff --git a/src/ui/components/pdp/product-attributes.test.ts b/src/ui/components/pdp/product-attributes.test.ts
new file mode 100644
index 0000000..af843ce
--- /dev/null
+++ b/src/ui/components/pdp/product-attributes.test.ts
@@ -0,0 +1,42 @@
+import { NextIntlClientProvider } from "next-intl";
+import { createElement, type ComponentProps, type ReactElement } from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it } from "vitest";
+
+import { ProductAttributes } from "@/ui/components/pdp/product-attributes";
+import messages from "../../../../messages/en.json";
+
+const policyLabels = { freeShippingThreshold: "$75", returnsWindowDays: 30 };
+const IntlProvider = NextIntlClientProvider as (
+	props: Omit<ComponentProps<typeof NextIntlClientProvider>, "children">,
+) => ReactElement;
+
+function render(storageConditions?: string | null) {
+	return renderToStaticMarkup(
+		createElement(
+			IntlProvider,
+			{ locale: "en", messages, timeZone: "UTC" },
+			createElement(ProductAttributes, {
+				descriptionHtml: ["<p>Product description</p>"],
+				storageConditions,
+				policyLabels,
+			}),
+		),
+	);
+}
+
+describe("ProductAttributes", () => {
+	it("renders a labeled plain-text storage conditions block after the description", () => {
+		const html = render("Store below 25°C.");
+
+		expect(html).toContain("Product description");
+		expect(html).toContain("Storage conditions");
+		expect(html).toContain("Store below 25°C.");
+		expect(html.indexOf("Product description")).toBeLessThan(html.indexOf("Storage conditions"));
+	});
+
+	it("omits storage conditions when the API data is absent or empty", () => {
+		expect(render()).not.toContain("Storage conditions");
+		expect(render("   ")).not.toContain("Storage conditions");
+	});
+});
