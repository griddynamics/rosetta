+def test_update_product_storage_conditions(
+    staff_api_client, product, permission_manage_products
+):
+    storage_conditions = "Keep refrigerated.\nDo not freeze."
+    variables = {
+        "productId": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"storageConditions": storage_conditions},
+    }
+
+    response = staff_api_client.post_graphql(
+        MUTATION_UPDATE_PRODUCT,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == "Keep refrigerated. Do not freeze."
+    product.refresh_from_db()
+    assert product.storage_conditions == "Keep refrigerated. Do not freeze."
+
+
+def test_update_product_storage_conditions_max_length(
+    staff_api_client, product, permission_manage_products
+):
+    variables = {
+        "productId": graphene.Node.to_global_id("Product", product.pk),
+        "input": {"storageConditions": "a" * 251},
+    }
+
+    response = staff_api_client.post_graphql(
+        MUTATION_UPDATE_PRODUCT,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    data = get_graphql_content(response)["data"]["productUpdate"]
+    assert data["errors"][0]["field"] == "storageConditions"
+    product.refresh_from_db()
+    assert product.storage_conditions is None
+
+
