+def test_product_translate_storage_conditions(
+    staff_api_client,
+    product,
+    permission_manage_products,
+):
+    storage_conditions = "Keep refrigerated.\nDo not freeze."
+    variables = {
+        "id": graphene.Node.to_global_id("Product", product.id),
+        "languageCode": LanguageCodeEnum.PL.name,
+        "input": {"storageConditions": storage_conditions},
+    }
+
+    response = staff_api_client.post_graphql(
+        PRODUCT_TRANSLATE_MUTATION,
+        variables,
+        permissions=[permission_manage_products],
+    )
+
+    data = get_graphql_content(response)["data"]["productTranslate"]
+    assert not data["errors"]
+    assert data["product"]["storageConditions"] == "Keep refrigerated. Do not freeze."
+    assert (
+        data["product"]["translation"]["storageConditions"]
+        == "Keep refrigerated. Do not freeze."
+    )
+    translation = product.translations.get(language_code=LanguageCodeEnum.PL.value)
+    assert translation.storage_conditions == "Keep refrigerated. Do not freeze."
+
+
