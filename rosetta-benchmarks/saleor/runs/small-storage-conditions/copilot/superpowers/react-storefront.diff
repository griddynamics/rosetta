diff --git a/src/ui/components/pdp/product-attributes.test.tsx b/src/ui/components/pdp/product-attributes.test.tsx
new file mode 100644
index 0000000..21b7ea6
--- /dev/null
+++ b/src/ui/components/pdp/product-attributes.test.tsx
@@ -0,0 +1,57 @@
+import { renderToStaticMarkup } from "react-dom/server";
+import { describe, expect, it, vi } from "vitest";
+
+import { ProductAttributes } from "@/ui/components/pdp/product-attributes";
+
+vi.mock("next-intl", () => ({
+	useTranslations: () => (key: string, values?: Record<string, string | number>) => {
+		if (key === "description") return "Description";
+		if (key === "storageConditions") return "Storage conditions";
+		if (key === "shippingReturns") return "Shipping & Returns";
+		if (key === "shippingBody")
+			return `Free shipping on orders over ${values?.freeShippingThreshold}. Standard delivery.`;
+		if (key === "returnsBody") return `Free returns within ${values?.returnsWindowDays} days of purchase.`;
+		if (key === "yes") return "Yes";
+		if (key === "no") return "No";
+		return key;
+	},
+}));
+
+const policyLabels = {
+	freeShippingThreshold: "$75.00",
+	returnsWindowDays: 30,
+};
+
+describe("ProductAttributes", () => {
+	it("renders storage conditions block after description", () => {
+		const html = renderToStaticMarkup(
+			<ProductAttributes
+				descriptionHtml={["<p>Soft cotton</p>"]}
+				storageConditions="Keep refrigerated at 2–8 °C"
+				policyLabels={policyLabels}
+			/>,
+		);
+
+		expect(html).toContain("Description");
+		expect(html).toContain("Storage conditions");
+		expect(html).toContain("Keep refrigerated at 2–8 °C");
+		expect(html.indexOf("Soft cotton")).toBeLessThan(html.indexOf("Storage conditions"));
+	});
+
+	it("renders storage conditions even when description is absent", () => {
+		const html = renderToStaticMarkup(
+			<ProductAttributes storageConditions="Keep frozen" policyLabels={policyLabels} />,
+		);
+
+		expect(html).toContain("Storage conditions");
+		expect(html).toContain("Keep frozen");
+	});
+
+	it("hides storage conditions when effective value is empty", () => {
+		const html = renderToStaticMarkup(
+			<ProductAttributes descriptionHtml={["<p>Soft cotton</p>"]} storageConditions="   " policyLabels={policyLabels} />,
+		);
+
+		expect(html).not.toContain("Storage conditions");
+	});
+});
