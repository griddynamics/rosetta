      {"id": "C1-web-search", "path": "docs/web/docs/architecture.md", "template": "| `search` | {set:search:skills} | {set:search:workflows} | {set:search:workflow_files} | {set:search:rules} | {set:search:agents} |", "count": 1},
      {"id": "C1-web-modernization", "path": "docs/web/docs/architecture.md", "template": "| `modernization` | {set:modernization:skills} | {set:modernization:workflows} | {set:modernization:workflow_files} | {set:modernization:rules} | {set:modernization:agents} |", "count": 1},
      {"id": "C1-web-total", "path": "docs/web/docs/architecture.md", "template": "| **total (`rosetta`)** | **{skills}** | **{workflows}** | **{workflow_files}** | **{rules}** | **{agents}** |", "count": 1},
      {"id": "C1-web-note", "path": "docs/web/docs/architecture.md", "template": "{request_types} of them are distinct request types. \"Workflow files\" = every workflow and phase file.", "count": 1},
      {"id": "C2", "path": "docs/ARCHITECTURE.md", "template": "({skills} skills, {workflows} workflows, {agents} agents, {rules} rules)", "count": 1},
