{
  "schema": 1,
  "scope": {
    "root_globs": ["*.md", "llms-full.txt"],
    "dirs": ["docs", "user-guide", ".github"],
    "extensions": ["md", "txt", "yml", "yaml", "json", "jsonl", "html", "sh", "py", "js", "css", "toml"],
    "exclude_prefixes": [
      "CHANGELOG.md",
      "docs/stories/",
      "docs/reviews/",
      "docs/web/llms-full.txt",
      "docs/github-stats.json",
      "docs/definitions/live_counts.json",
      "docs/web/_site/",
      "docs/web/vendor/",
      "docs/web/.jekyll-cache/"
    ],
    "exclude_basenames": ["CHANGES.md"],
    "exclude_dir_names": ["node_modules"]
  },
  "links": {
    "release": "r3",
    "allowlist": [
      {"prefix": "instructions/r3/core/rules/bootstrap-", "reason": "prefix glob"},
      {"prefix": "instructions/r3/core/rules/example.md", "reason": "sample, .github/prompts/prompt-comparison.md"},
      {"prefix": "instructions/r3/core/skills/example.md", "reason": "sample, .github/prompts/prompt-comparison.md"},
      {"prefix": "instructions/r3/core/rules/deleted-rule.md", "reason": "sample, .github/prompts/prompt-comparison.md"},
      {"prefix": "instructions/r3/core/skills/my-skill/", "reason": "sample, docs/definitions/folder-structure.md:15"},
      {"prefix": "instructions/r3/aqa/", "reason": "example, docs/REQUIREMENTS/plugin-generator/FR-SET.md:80"}
    ],
    "plugin_relative": {
      "root": "instructions/r3",
      "forbidden": "instructions/r3/",
      "allow_files": ["instructions/r3/core/rules/local-files-mode.md"]
    }
  },
  "counts": {
    "sets": ["core", "workflows", "qe", "search", "modernization"],
    "request_type_exclusions": {"aqa-flow": "router", "coding-light-flow": "variant of coding-flow"},
    "banned": [
      "~[0-9]+ (SDLC )?workflow",
      "WORKFLOWS \\(~",
      "[0-9]+\\+ (structured )?workflows",
      "[0-9]+ workflow types",
      "30 skills",
      "(thirteen|Seventeen|fifteen) workflow types"
    ],
    "sites": [
      {"id": "CODEMAP-1", "path": "docs/CODEMAP.md", "template": "{skills} skills, {workflow_files} workflow files, {rules} rules, {agents} agents ({agent_files} files)", "count": 1},
      {"id": "CODEMAP-2", "path": "docs/CODEMAP.md", "template": "{workflows} of the workflow files are entry points", "count": 1},
      {"id": "CODEMAP-3", "path": "docs/CODEMAP.md", "template": "{request_types} of those", "count": 1},
      {"id": "C1-head", "path": "docs/ARCHITECTURE.md", "template": "| Set | Skills | Workflows | Workflow files | Rules | Agents |", "count": 1},
      {"id": "C1-core", "path": "docs/ARCHITECTURE.md", "template": "| `core` | {set:core:skills} | {set:core:workflows} | {set:core:workflow_files} | {set:core:rules} | {set:core:agents} |", "count": 1},
      {"id": "C1-workflows", "path": "docs/ARCHITECTURE.md", "template": "| `workflows` | {set:workflows:skills} | {set:workflows:workflows} | {set:workflows:workflow_files} | {set:workflows:rules} | {set:workflows:agents} |", "count": 1},
      {"id": "C1-qe", "path": "docs/ARCHITECTURE.md", "template": "| `qe` | {set:qe:skills} | {set:qe:workflows} | {set:qe:workflow_files} | {set:qe:rules} | {set:qe:agents} |", "count": 1},
      {"id": "C1-search", "path": "docs/ARCHITECTURE.md", "template": "| `search` | {set:search:skills} | {set:search:workflows} | {set:search:workflow_files} | {set:search:rules} | {set:search:agents} |", "count": 1},
      {"id": "C1-modernization", "path": "docs/ARCHITECTURE.md", "template": "| `modernization` | {set:modernization:skills} | {set:modernization:workflows} | {set:modernization:workflow_files} | {set:modernization:rules} | {set:modernization:agents} |", "count": 1},
      {"id": "C1-total", "path": "docs/ARCHITECTURE.md", "template": "| **total (`rosetta`)** | **{skills}** | **{workflows}** | **{workflow_files}** | **{rules}** | **{agents}** |", "count": 1},
      {"id": "C1-note", "path": "docs/ARCHITECTURE.md", "template": "{request_types} of them are distinct request types. \"Workflow files\" = every workflow and phase file.", "count": 1},
      {"id": "C1-web-head", "path": "docs/web/docs/architecture.md", "template": "| Set | Skills | Workflows | Workflow files | Rules | Agents |", "count": 1},
      {"id": "C1-web-core", "path": "docs/web/docs/architecture.md", "template": "| `core` | {set:core:skills} | {set:core:workflows} | {set:core:workflow_files} | {set:core:rules} | {set:core:agents} |", "count": 1},
      {"id": "C1-web-workflows", "path": "docs/web/docs/architecture.md", "template": "| `workflows` | {set:workflows:skills} | {set:workflows:workflows} | {set:workflows:workflow_files} | {set:workflows:rules} | {set:workflows:agents} |", "count": 1},
