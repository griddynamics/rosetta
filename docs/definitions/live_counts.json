      {"id": "C18-root", "path": "OVERVIEW.md", "template": "{Word:workflows} workflows cover the SDLC", "count": 1},
      {"id": "C18-web", "path": "docs/web/docs/overview.md", "template": "{Word:workflows} workflows cover the SDLC", "count": 1}
    ]
  }
