{
  "$schema-note": "Declarative plugin-set catalog for the Rosetta plugin generator. ONE invocation expands sets x variants x targets into every output folder. Loaded and fully validated at pre-flight by src/spec/plugin-sets.ts BEFORE any output is written; an unknown field or a structural violation aborts the run naming this file. Override the location with --config <path>.",

  "targets": [
    "claude",
    "cursor",
    "copilot",
    "codex",
    "cursor-standalone",
    "copilot-standalone",
    "antigravity"
  ],

  "hookSupportModules": {
    "read-once": ["read-once-reset", "read-once-shared"]
  },

