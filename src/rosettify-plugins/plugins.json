      "hooks": [
        "dangerous-actions",
        "read-once",
        "loose-files",
        "md-file-advisory",
        "codemap-refresh",
        "lint-format-advisory"
      ],
      "manifest": {
        "name": "rosetta",
        "description": "Rosetta - Software Engineering Accelerator instruction set, workflows, agents, skills, and guardrails."
      },
      "variants": [
