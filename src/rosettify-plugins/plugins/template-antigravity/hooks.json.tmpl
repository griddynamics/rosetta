{
  "rosetta": {
    "enabled": true,
    "PreInvocation": []{{#if deterministic_hooks}},{{/if}}
{{#if deterministic_hooks}}
    "PreToolUse": [
      {
        "matcher": "run_command|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/dangerous-actions.js",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "view_file|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node hooks/read-once.js",
            "timeout": 30
          }
        ]
      }
    ]
{{/if}}
  }
}
