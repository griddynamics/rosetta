{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [{{BOOTSTRAP_HOOKS_CODEX}}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|apply_patch|functions.apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/loose-files.js"
          }
        ]
      },
      {
        "matcher": "Write|Edit|apply_patch|functions.apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/gitnexus-refresh.js"
          }
        ]
      }
    ]
  }
}
