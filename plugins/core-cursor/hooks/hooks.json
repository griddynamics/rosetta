{
  "version": 1,
  "hooks": {
    "postToolUse": [
      {
        "matcher": "Write",
        "command": "node .cursor/hooks/loose-files.js"
      },
      {
        "matcher": "Write|Edit",
        "command": "node .cursor/hooks/md-file-advisory.js"
      },
      {
        "matcher": "Write|Edit",
        "command": "node .cursor/hooks/gitnexus-refresh.js"
      },
      {
        "matcher": "Write|Edit",
        "command": "node .cursor/hooks/lint-format-advisory.js"
      }
    ]
  }
}