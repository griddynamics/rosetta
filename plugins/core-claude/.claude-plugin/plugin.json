{
  "name": "core",
  "description": "Rosetta Core 2.0 - OSS foundation for AI agent instructions, workflows, and guardrails.",
  "version": "2.0.27",
  "author": {
    "name": "Grid Dynamics",
    "email": "rosetta-support@griddynamics.com"
  },
  "homepage": "https://griddynamics.github.io/rosetta/",
  "repository": "https://github.com/griddynamics/rosetta",
  "license": "Apache-2.0",
  "keywords": [
    "rosetta",
    "ai-agents",
    "workflows",
    "instructions",
    "guardrails",
    "planning",
    "coding",
    "knowledge-base"
  ],
  "commands": "./workflows/",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/rosetta-bootstrap.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/loose-files.js\""
          }
        ]
      }
    ]
  }
}
